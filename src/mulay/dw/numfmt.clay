(defn- ascii-lower Str [s: &Str]
  (loop [i 0 out ""]
    (if (>= i (count s)) out
      (let [c (nth s i)] (recur (+ i 1) (str out (chr (if (and (>= c 65) (<= c 90)) (+ c 32) c))))))))

(defn- alpha? Bool [s: &Str]
  (loop [i 0] (if (>= i (count s)) true
                (let [c (nth s i)] (if (or (and (>= c 65) (<= c 90)) (and (>= c 97) (<= c 122))) (recur (+ i 1)) false)))))

(defn- norm-tag Str [locale: &Str]
  (let [t (ascii-lower locale)
        parts: Vec(Str) (str/split t "-")
        l (nth parts 0)]
    (if (and (>= (count l) 2) (<= (count l) 8) (alpha? l)) t "und")))

(defn- table-find Str [tab: &Vec(Str) tag: &Str]
  (let [key (str tag "|")]
    (loop [i 0]
      (if (>= i (count tab)) ""
        (let [e (nth tab i)] (if (str/starts-with? e key) (subs e (count key) (count e)) (recur (+ i 1))))))))

(defn- lookup Vec(Str) [tab: &Vec(Str) tag: &Str]
  (loop [t (str tag)]
    (let [hit (table-find tab t)]
      (if (not= hit "") (str/split hit "|")
        (let [k (str/last-index-of t "-")]
          (if (> k 0) (recur (subs t 0 k))
            (str/split (table-find tab "und") "|")))))))

(defn- cp0 Int [s: &Str] (if (= (count s) 0) 0 (uni/cp-at s 0)))

(def NU-ZEROS ["latn|48" "arab|1632" "arabext|1776" "deva|2406" "beng|2534" "guru|2662" "gujr|2790" "orya|2918"
               "tamldec|3046" "telu|3174" "knda|3302" "mlym|3430" "thai|3664" "laoo|3792" "tibt|3872" "mymr|4160"
               "khmr|6112" "mong|6160" "fullwide|65296"])

(defn- nu-zero Int [tag: &Str]
  (let [u (str/index-of tag "-u-")]
    (if (< u 0) -1
      (let [ext (subs tag u (count tag)) k (str/index-of ext "-nu-")]
        (if (< k 0) -1
          (let [rest (subs ext (+ k 4) (count ext))
                e (str/index-of rest "-")
                name (if (< e 0) rest (subs rest 0 e))
                hit (table-find NU-ZEROS name)]
            (if (= hit "") -1 (npz/int-or hit 0))))))))

(defn- base-tag Str [tag: &Str]
  (let [u (str/index-of tag "-u-")] (if (< u 0) (str tag) (subs tag 0 u))))

(defn symbols Syms [locale: &Str]
  (let [tag0 (if (= locale "") "en-us" (norm-tag locale))
        tag (if (not= (table-find SYMS tag0) "") tag0 (base-tag tag0))
        nz (nu-zero tag0)
        s (lookup SYMS tag)
        c (lookup CURS tag)]
    (->Syms (if (>= nz 0) nz (cp0 (nth s 0))) (cp0 (nth s 1)) (cp0 (nth s 2)) (nth s 3) (nth s 4) (nth s 5) (nth s 6)
            (cp0 (nth s 7)) (cp0 (nth s 8)) (nth s 9) (nth s 10) (nth c 0) (nth c 1))))

(def CH-QUOTE 39)
(def CH-CURRENCY 164)
(def CH-DIGIT 35)
(def CH-ZERO 48)
(def CH-GROUP 44)
(def CH-DEC 46)
(def CH-PERCENT 37)
(def CH-PERMILL 8240)
(def CH-SEP 59)
(def CH-MINUS 45)
(def CH-EXP 69)

(defn- aff+ Vec(Aff) [v: Vec(Aff) kind: Int text: Str]
  (let [n (count v)]
    (if (and (= kind 0) (> n 0) (= (:kind (nth v (- n 1))) 0))
      (let [last (nth v (- n 1)) t (:text last)]
        (assoc v (- n 1) (->Aff 0 (str t text))))
      (conj v (->Aff kind text)))))

(defn- aff-eq? Bool [a: &Vec(Aff) b: &Vec(Aff)]
  (and (= (count a) (count b))
       (loop [i 0] (if (>= i (count a)) true
                     (let [x (nth a i) y (nth b i)]
                       (if (and (= (:kind x) (:kind y)) (= (:text x) (:text y))) (recur (+ i 1)) false))))))

(defrecord PS [phase: Int quote: Bool pre: Vec(Aff) suf: Vec(Aff) dpos: Int mult: Int
               dl: Int zc: Int dr: Int gc: Int use-exp: Bool min-exp: Int currency: Bool next: Int err: Str])

(defn- ps-aff PS [s: PS kind: Int text: Str]
  (if (= (:phase s) 0) (assoc s :pre (aff+ (:pre s) kind text)) (assoc s :suf (aff+ (:suf s) kind text))))

(defn- qpat Str [pattern: &Str] (str "\"" pattern "\""))

(defn- parse-sub PS [cs: &Vec(Int) pattern: &Str start: Int j: Int use-exp0: Bool currency0: Bool]
  (let [n (count cs)]
    (loop [pos start
           s (->PS 0 false [] [] -1 1 0 0 0 -1 use-exp0 0 currency0 start "")]
      (if (or (>= pos n) (not= (:err s) "")) s
        (let [ch (nth cs pos) ph (:phase s)]
          (if (or (= ph 0) (= ph 2))
            (if (:quote s)
              (if (= ch CH-QUOTE)
                (if (and (< (+ pos 1) n) (= (nth cs (+ pos 1)) CH-QUOTE))
                  (recur (+ pos 2) (ps-aff s 0 "'"))
                  (recur (+ pos 1) (assoc s :quote false)))
                (recur (+ pos 1) (ps-aff s 0 (uni/encode ch))))
              (cond
                (or (= ch CH-DIGIT) (= ch CH-ZERO) (= ch CH-GROUP) (= ch CH-DEC))
                (recur pos (assoc s :phase 1))
                (= ch CH-CURRENCY)
                (let [doubled (and (< (+ pos 1) n) (= (nth cs (+ pos 1)) CH-CURRENCY))]
                  (recur (+ pos (if doubled 2 1)) (assoc (ps-aff s (if doubled 5 4) "") :currency true)))
                (= ch CH-QUOTE)
                (if (and (< (+ pos 1) n) (= (nth cs (+ pos 1)) CH-QUOTE))
                  (recur (+ pos 2) (ps-aff s 0 "'"))
                  (recur (+ pos 1) (assoc s :quote true)))
                (= ch CH-SEP)
                (if (or (= ph 0) (= j 0))
                  (assoc s :err (str "Unquoted special character ';' in pattern " (qpat pattern)))
                  (assoc s :next (+ pos 1)))
                (= ch CH-PERCENT)
                (if (not= (:mult s) 1)
                  (assoc s :err (str "Too many percent/per mille characters in pattern " (qpat pattern)))
                  (recur (+ pos 1) (assoc (ps-aff s 1 "") :mult 100)))
                (= ch CH-PERMILL)
                (if (not= (:mult s) 1)
                  (assoc s :err (str "Too many percent/per mille characters in pattern " (qpat pattern)))
                  (recur (+ pos 1) (assoc (ps-aff s 2 "") :mult 1000)))
                (= ch CH-MINUS) (recur (+ pos 1) (ps-aff s 3 ""))
                :else (recur (+ pos 1) (ps-aff s 0 (uni/encode ch)))))
            (if (= j 0)
              (let [p2 (loop [p pos]
                         (if (>= p n) p
                           (let [c (nth cs p)]
                             (if (or (= c CH-DIGIT) (= c CH-ZERO) (= c CH-GROUP) (= c CH-DEC) (= c CH-EXP)) (recur (+ p 1)) p))))]
                (recur p2 (assoc s :phase 2)))
              (cond
                (= ch CH-DIGIT)
                (let [gc (:gc s)
                      grp (and (>= gc 0) (< (:dpos s) 0))
                      s2 (if (> (:zc s) 0) (assoc s :dr (+ (:dr s) 1)) (assoc s :dl (+ (:dl s) 1)))]
                  (recur (+ pos 1) (if grp (assoc s2 :gc (byte-inc gc)) s2)))
                (= ch CH-ZERO)
                (if (> (:dr s) 0) (assoc s :err (str "Unexpected '0' in pattern " (qpat pattern)))
                  (let [gc (:gc s)
                        grp (and (>= gc 0) (< (:dpos s) 0))
                        s2 (assoc s :zc (+ (:zc s) 1))]
                    (recur (+ pos 1) (if grp (assoc s2 :gc (byte-inc gc)) s2))))
                (= ch CH-GROUP) (recur (+ pos 1) (assoc s :gc 0))
                (= ch CH-DEC)
                (if (>= (:dpos s) 0) (assoc s :err (str "Multiple decimal separators in pattern " (qpat pattern)))
                  (recur (+ pos 1) (assoc s :dpos (+ (+ (:dl s) (:zc s)) (:dr s)))))
                (= ch CH-EXP)
                (if (:use-exp s) (assoc s :err (str "Multiple exponential symbols in pattern " (qpat pattern)))
                  (let [p2 (loop [p (+ pos 1)] (if (and (< p n) (= (nth cs p) CH-ZERO)) (recur (+ p 1)) p))
                        me (- p2 (+ pos 1))]
                    (if (or (< (+ (:dl s) (:zc s)) 1) (< me 1))
                      (assoc s :err (str "Malformed exponential pattern " (qpat pattern)))
                      (recur p2 (assoc (assoc (assoc s :use-exp true) :min-exp me) :phase 2)))))
                :else (recur pos (assoc s :phase 2))))))))))

(defn- byte-inc Int [x: Int] (if (= x 127) -128 (+ x 1)))

(defn compile-pattern Values(Pat Str) [pattern: &Str]
  (let [cs (uni/cps pattern)
        n (count cs)
        empty-pat (->Pat [] [] [(->Aff 3 "")] [] 1 INT-MAX32 0 3 true 3 1 false false 0 false)]
    (if (= n 0)
      (values (->Pat [] [] [(->Aff 3 "")] [] 0 INT-MAX32 0 INT-MAX32 true 3 1 false false 0 false) "")
      (loop [j 1 start 0 pat empty-pat got-neg false use-exp false currency false]
        (if (or (< j 0) (>= start n))
          (let [p2 (if (or (not got-neg) (and (aff-eq? (:neg-pre pat) (:pos-pre pat)) (aff-eq? (:neg-suf pat) (:pos-suf pat))))
                     (assoc (assoc pat :neg-suf (:pos-suf pat)) :neg-pre (aff-prepend-minus (:pos-pre pat)))
                     pat)]
            (values (assoc (assoc p2 :use-exp use-exp) :currency currency) ""))
          (let [s0 (parse-sub cs pattern start j use-exp currency)]
            (if (not= (:err s0) "") (values pat (:err s0))
              (let [
                    fix (and (= (:zc s0) 0) (> (:dl s0) 0) (>= (:dpos s0) 0))
                    nn (if (= (:dpos s0) 0) 1 (:dpos s0))
                    dr (if fix (- (:dl s0) nn) (:dr s0))
                    dl (if fix (- nn 1) (:dl s0))
                    zc (if fix 1 (:zc s0))
                    dpos (:dpos s0)]
                (if (or (and (< dpos 0) (> dr 0))
                        (and (>= dpos 0) (or (< dpos dl) (> dpos (+ dl zc))))
                        (= (:gc s0) 0) (:quote s0))
                  (values pat (str "Malformed pattern " (qpat pattern)))
                  (if (= j 1)
                    (let [total (+ (+ dl zc) dr)
                          eff (if (>= dpos 0) dpos total)
                          min-int (- eff dl)
                          max-int (if (:use-exp s0) (+ dl min-int) INT-MAX32)
                          max-frac (if (>= dpos 0) (- total dpos) 0)
                          min-frac (if (>= dpos 0) (- (+ dl zc) dpos) 0)
                          gc (:gc s0)]
                      (recur 0 (:next s0)
                             (->Pat (:pre s0) (:suf s0) (:pre s0) (:suf s0)
                                    min-int max-int min-frac max-frac (> gc 0) (if (> gc 0) gc 0) (:mult s0)
                                    (or (= dpos 0) (= dpos total)) (:use-exp s0) (:min-exp s0) false)
                             false (:use-exp s0) (:currency s0)))
                    (recur -1 (:next s0) (assoc (assoc pat :neg-pre (:pre s0)) :neg-suf (:suf s0))
                           true use-exp (:currency s0))))))))))))

(defn- aff-prepend-minus Vec(Aff) [v: &Vec(Aff)]
  (loop [i 0 acc: Vec(Aff) [(->Aff 3 "")]]
    (if (>= i (count v)) acc (recur (+ i 1) (conj acc (nth v i))))))

(defn- expand Str [v: &Vec(Aff) sy: &Syms]
  (loop [i 0 out ""]
    (if (>= i (count v)) out
      (let [a (nth v i) k (:kind a)]
        (recur (+ i 1)
               (str out (cond
                          (= k 0) (:text a)
                          (= k 1) (:pct sy)
                          (= k 2) (:permill sy)
                          (= k 3) (:minus sy)
                          (= k 4) (:cur sy)
                          :else (:intl sy))))))))

(defrecord DL [digits: Vec(Int) decimal-at: Int])

(defn- digits-of DL [x: &d/Dec]
  (if (d/is-zero? x) (->DL [] 0)
    (let [s (bi/to-string (bi/abs-big (d/unscaled x)))
          n (count s)
          nz (loop [k n] (if (and (> k 1) (= (nth s (- k 1)) 48)) (recur (- k 1)) k))
          ds (loop [i 0 acc: Vec(Int) []] (if (>= i nz) acc (recur (+ i 1) (conj acc (- (nth s i) 48)))))]
      (->DL ds (- n (d/scale x))))))

(defn- nonzero-after? Bool [ds: &Vec(Int) i: Int]
  (loop [k i] (if (>= k (count ds)) false (if (not= (nth ds k) 0) true (recur (+ k 1))))))

(defn- round-up? Values(Bool Str) [ds: &Vec(Int) m: Int mode: Int neg: Bool]
  (if (>= m (count ds)) (values false "")
    (cond
      (= mode d/UP) (values (nonzero-after? ds m) "")
      (= mode d/DOWN) (values false "")
      (= mode d/CEILING) (values (and (nonzero-after? ds m) (not neg)) "")
      (= mode d/FLOOR) (values (and (nonzero-after? ds m) neg) "")
      (= mode d/UNNECESSARY) (if (nonzero-after? ds m) (values false "Rounding needed with the rounding mode being set to RoundingMode.UNNECESSARY") (values false ""))
      :else
      (let [dg (nth ds m)]
        (cond
          (> dg 5) (values true "")
          (= dg 5) (if (= m (- (count ds) 1))
                     (values (or (= mode d/HALF-UP) (and (= mode d/HALF-EVEN) (> m 0) (not= (mod (nth ds (- m 1)) 2) 0))) "")
                     (values (nonzero-after? ds (+ m 1)) ""))
          :else (values false ""))))))

(defn- trim-zeros Vec(Int) [ds: Vec(Int)]
  (loop [v ds] (if (and (> (count v) 1) (= (nth v (- (count v) 1)) 0)) (recur (pop v)) v)))

(defn- take-n Vec(Int) [ds: &Vec(Int) n: Int]
  (loop [i 0 acc: Vec(Int) []] (if (>= i n) acc (recur (+ i 1) (conj acc (nth ds i))))))

(defn- round-dl Values(DL Str) [dl: DL m: Int mode: Int neg: Bool]
  (let [ds (:digits dl)]
    (if (or (< m 0) (>= m (count ds))) (values dl "")
      (let [[up e] (round-up? ds m mode neg)]
        (if (not= e "") (values dl e)
          (if (not up) (values (->DL (trim-zeros (take-n ds m)) (:decimal-at dl)) "")
            (let [[v2 at2] (loop [k (- m 1) v (take-n ds m)]
                             (if (< k 0) (values [1] (+ (:decimal-at dl) 1))
                               (let [x (+ (nth v k) 1)]
                                 (if (<= x 9) (values (take-n (assoc v k x) (+ k 1)) (:decimal-at dl))
                                   (recur (- k 1) v)))))]
              (values (->DL (trim-zeros v2) at2) ""))))))))

(defn- set-dl Values(DL Str) [x: &d/Dec m: Int fixed: Bool mode: Int neg: Bool]
  (let [dl (digits-of x) at (:decimal-at dl) ds (:digits dl)]
    (if (and fixed (> (count ds) 0) (> (- 0 at) m)) (values (->DL [] 0) "")
      (if (and fixed (> (count ds) 0) (= (- 0 at) m))
        (let [[up e] (round-up? ds 0 mode neg)]
          (if (not= e "") (values dl e)
            (if up (values (->DL [1] (+ at 1)) "") (values (->DL [] at) ""))))
        (round-dl dl (if fixed (+ m at) m) mode neg)))))

(defn- digit-str Str [sy: &Syms k: Int] (uni/encode (+ (:zero sy) k)))

(defn- subformat Str [dl0: &DL p: &Pat sy: &Syms]
  (let [dl (if (= (count (:digits dl0)) 0) (->DL [] 0) (->DL (:digits dl0) (:decimal-at dl0)))
        ds (:digits dl) cnt (count ds) at (:decimal-at dl)
        zero (digit-str sy 0)
        grp (uni/encode (if (:currency p) (:mgroup sy) (:group sy)))
        decs (uni/encode (if (:currency p) (:mdec sy) (:dec sy)))
        min-int (:min-int p) max-int (:max-int p) min-frac (:min-frac p) max-frac (:max-frac p)]
    (if (:use-exp p)
      (let [repeat max-int
            [expo mid] (if (and (> repeat 1) (> repeat min-int))
                         (values (if (>= at 1) (* (quot (- at 1) repeat) repeat) (* (quot (- at repeat) repeat) repeat)) 1)
                         (values (- at min-int) min-int))
            md0 (+ min-int min-frac)
            md1 (if (< md0 0) INT-MAX32 md0)
            int-digits (if (= cnt 0) mid (- at expo))
            md (if (< md1 int-digits) int-digits md1)
            total (if (> md cnt) md cnt)
            body (loop [i 0 out ""]
                   (if (>= i total) out
                     (let [o2 (if (= i int-digits) (str out decs) out)]
                       (recur (+ i 1) (str o2 (if (< i cnt) (digit-str sy (nth ds i)) zero))))))
            body2 (if (and (:dec-always p) (= total int-digits)) (str body decs) body)
            e (if (= cnt 0) 0 expo)
            eneg (< e 0)
            ea (if eneg (- 0 e) e)
            es (if (= ea 0) "" (str ea))
            epad (loop [i (count es) out ""] (if (>= i (:min-exp p)) out (recur (+ i 1) (str out zero))))
            edig (loop [i 0 out ""] (if (>= i (count es)) out (recur (+ i 1) (str out (digit-str sy (- (nth es i) 48))))))]
        (str body2 (:exp sy) (if eneg (:minus sy) "") epad edig))
      (let [c0 (if (and (> at 0) (< min-int at)) at min-int)
            [icount di0] (if (> c0 max-int) (values max-int (- at max-int)) (values c0 0))
            [ipart di] (loop [i (- icount 1) out "" di di0]
                         (if (< i 0) (values out di)
                           (let [[o2 d2] (if (and (< i at) (< di cnt)) (values (str out (digit-str sy (nth ds di))) (+ di 1)) (values (str out zero) di))
                                 o3 (if (and (:grouping p) (> i 0) (not= (:group-size p) 0) (= (mod i (:group-size p)) 0)) (str o2 grp) o2)]
                             (recur (- i 1) o3 d2))))
            frac-present (or (> min-frac 0) (< di cnt))
            ipart2 (if (and (not frac-present) (= (count ipart) 0)) zero ipart)
            withdec (if (or (:dec-always p) frac-present) (str ipart2 decs) ipart2)]
        (loop [i 0 out withdec di di]
          (if (or (>= i max-frac) (and (>= i min-frac) (>= di cnt))) out
            (if (> (- -1 i) (- at 1)) (recur (+ i 1) (str out zero) di)
              (if (< di cnt) (recur (+ i 1) (str out (digit-str sy (nth ds di))) (+ di 1))
                (recur (+ i 1) (str out zero) di)))))))))

(defn format-with Values(Str Str Str) [x: &d/Dec p: &Pat sy: &Syms mode: Int]
  (let [xm (if (= (:multiplier p) 1) x (d/mul x (d/from-int (:multiplier p))))
        neg (< (d/signum xm) 0)
        ax (d/abs-dec xm)
        maxd0 (+ (:max-int p) (:max-frac p))
        maxd (if (or (< maxd0 0) (> maxd0 INT-MAX32)) INT-MAX32 maxd0)
        [dl e] (set-dl ax (if (:use-exp p) maxd (:max-frac p)) (not (:use-exp p)) mode neg)]
    (cond
      (not= e "") (values "" "" e)
      (and (not (:use-exp p)) (> (:decimal-at dl) d/MAX-DIGITS)) (values "" "" d/TOO-BIG)
      :else
      (let [body (subformat dl p sy)]
        (if neg
          (values (str (expand (:neg-pre p) sy) body (expand (:neg-suf p) sy)) "" "")
          (values (str (expand (:pos-pre p) sy) body (expand (:pos-suf p) sy)) "" ""))))))

(defn format-dec Values(Str Str Str) [x: &d/Dec pattern: &Str locale: &Str mode: Int]
  (let [[p pe] (compile-pattern pattern)]
    (if (not= pe "") (values "" pe "")
      (format-with x p (symbols locale) mode))))

(defn- region? Bool [text: &Str pos: Int s: &Str]
  (and (<= (+ pos (count s)) (count text))
       (loop [i 0] (if (>= i (count s)) true (if (= (nth text (+ pos i)) (nth s i)) (recur (+ i 1)) false)))))

(defn- unicode-digit Int [cp: Int]
  (if (and (>= cp 48) (<= cp 57)) (- cp 48)
    (if (not (uni/java-digit? cp)) -1
      (let [start (loop [z cp] (if (uni/java-digit? (- z 1)) (recur (- z 1)) z))]
        (mod (- cp start) 10)))))

(defrecord NumRes [pos: Int digits: Vec(Int) decimal-at: Int infinite: Bool])

(defn- subparse-number NumRes [text: &Str pos0: Int p: &Pat sy: &Syms is-exp: Bool int-only: Bool]
  (if (and (not is-exp) (region? text pos0 (:inf sy)))
    (->NumRes (+ pos0 (count (:inf sy))) [] 0 true)
    (let [n (count text)
          zero (:zero sy)
          decc (if (:currency p) (:mdec sy) (:dec sy))
          grpc (if (:currency p) (:mgroup sy) (:group sy))
          [pos ds at saw-dec saw-digit dcount backup expo]
          (loop [pos pos0 ds: Vec(Int) [] at 0 saw-dec false saw-digit false dcount 0 backup -1]
            (if (>= pos n) (values pos ds at saw-dec saw-digit dcount backup 0)
              (let [[ch nxt] (uni/decode-at text pos)
                    dg0 (- ch zero)
                    dg (if (or (< dg0 0) (> dg0 9)) (unicode-digit ch) dg0)]
                (cond
                  (= dg 0)
                  (if (= (count ds) 0)
                    (if (not saw-dec) (recur nxt ds at saw-dec true dcount -1)
                      (recur nxt ds (- at 1) saw-dec true dcount -1))
                    (recur nxt (conj ds 0) at saw-dec true (+ dcount 1) -1))
                  (and (> dg 0) (<= dg 9)) (recur nxt (conj ds dg) at saw-dec true (+ dcount 1) -1)
                  (and (not is-exp) (= ch decc))
                  (if (or saw-dec int-only) (values pos ds at saw-dec saw-digit dcount backup 0)
                    (recur nxt ds dcount true saw-digit dcount backup))
                  (and (not is-exp) (= ch grpc) (:grouping p))
                  (if saw-dec (values pos ds at saw-dec saw-digit dcount backup 0)
                    (recur nxt ds at saw-dec saw-digit dcount pos))
                  (and (not is-exp) (region? text pos (:exp sy)))
                  (let [ep (+ pos (count (:exp sy)))
                        eneg (region? text ep (:minus sy))
                        ep2 (if eneg (+ ep (count (:minus sy))) ep)
                        r (subparse-number text ep2 p sy true false)]
                    (if (or (< (:pos r) 0) (not (fits-long? (:digits r) (:decimal-at r) eneg)))
                      (values pos ds at saw-dec saw-digit dcount backup 0)
                      (let [ev (loop [i 0 acc 0] (if (>= i (count (:digits r))) acc (recur (+ i 1) (+ (* acc 10) (nth (:digits r) i)))))
                            ev2 (loop [k (count (:digits r)) acc ev] (if (>= k (:decimal-at r)) acc (recur (+ k 1) (* acc 10))))
                            ev3 (int32 (if eneg (- 0 ev2) ev2))]
                        (values (:pos r) ds at saw-dec saw-digit dcount backup ev3))))
                  :else (values pos ds at saw-dec saw-digit dcount backup 0)))))
          pos2 (if (not= backup -1) backup pos)
          at2 (if saw-dec at dcount)]
      (if (and (not saw-digit) (= dcount 0)) (->NumRes -1 [] 0 false)
        (->NumRes pos2 ds (+ at2 expo) false)))))

(defn- fits-long? Bool [ds: &Vec(Int) at: Int neg: Bool]
  (if (or (= (count ds) 0) (<= at 0)) true
    (if (< at 19) true
      (if (> at 19) false
        (let [lim (if neg "9223372036854775808" "9223372036854775807")
              v (loop [i 0 out ""] (if (>= i 19) out (recur (+ i 1) (str out (if (< i (count ds)) (nth ds i) 0)))))]
          (<= (str-cmp v lim) 0))))))

(defn- str-cmp Int [a: &Str b: &Str]
  (loop [i 0] (if (>= i (count a)) 0
                (let [x (nth a i) y (nth b i)] (if (< x y) -1 (if (> x y) 1 (recur (+ i 1))))))))

(defn- int32 Int [x: Int]
  (let [u (bit-and x 4294967295)] (if (>= u 2147483648) (- u 4294967296) u)))

(defn- dl-dec d/Dec [ds: &Vec(Int) at: Int]
  (if (= (count ds) 0)
    (d/of (bi/zero) (- 0 at))
    (let [u (loop [i 0 acc (bi/zero)] (if (>= i (count ds)) acc (recur (+ i 1) (bi/add-int (bi/mul-int acc 10) (nth ds i)))))]
      (d/of u (- (count ds) at)))))

(defn parse-with Values(d/Dec Bool) [text: &Str p: &Pat sy: &Syms]
  (if (region? text 0 (:nan sy)) (values (d/zero) false)
    (let [pp (expand (:pos-pre p) sy) np (expand (:neg-pre p) sy)
          ps (expand (:pos-suf p) sy) ns (expand (:neg-suf p) sy)
          gp0 (region? text 0 pp) gn0 (region? text 0 np)
          gp1 (if (and gp0 gn0 (< (count pp) (count np))) false gp0)
          gn1 (if (and gp0 gn0 (> (count pp) (count np))) false gn0)]
      (if (and (not gp1) (not gn1)) (values (d/zero) false)
        (let [start (if gp1 (count pp) (count np))
              r (subparse-number text start p sy false false)
              pos (:pos r)]
          (if (or (< pos 0) (:infinite r)) (values (d/zero) false)
            (let [gp2 (and gp1 (region? text pos ps))
                  gn2 (and gn1 (region? text pos ns))
                  gp3 (if (and gp2 gn2 (< (count ps) (count ns))) false gp2)
                  gn3 (if (and gp2 gn2 (> (count ps) (count ns))) false gn2)]
              (if (= gp3 gn3) (values (d/zero) false)
                (let [x0 (dl-dec (:digits r) (:decimal-at r))
                      m (:multiplier p)
                      x1 (if (= m 1) x0
                           (let [[q e] (d/div-exact x0 (d/from-int m))]
                             (if (= e "") q (let [[q2 e2] (d/div-scale x0 (d/from-int m) (d/scale x0) d/HALF-EVEN)] q2))))]
                  (values (if gp3 x1 (d/neg x1)) true))))))))))

(defrecord PRes [kind: Int value: d/Dec positive: Bool end: Int])

(defn parse-at PRes [text: &Str p: &Pat sy: &Syms int-only: Bool]
  (let [fail (->PRes 0 (d/zero) true -1)]
    (if (and (> (count (:nan sy)) 0) (region? text 0 (:nan sy))) (->PRes 2 (d/zero) true (count (:nan sy)))
      (let [pp (expand (:pos-pre p) sy) np (expand (:neg-pre p) sy)
            ps (expand (:pos-suf p) sy) ns (expand (:neg-suf p) sy)
            gp0 (region? text 0 pp) gn0 (region? text 0 np)
            gp1 (if (and gp0 gn0 (< (count pp) (count np))) false gp0)
            gn1 (if (and gp0 gn0 (> (count pp) (count np))) false gn0)]
        (if (and (not gp1) (not gn1)) fail
          (let [start (if gp1 (count pp) (count np))
                r (subparse-number text start p sy false int-only)
                pos (:pos r)]
            (if (< pos 0) fail
              (let [gp2 (and gp1 (region? text pos ps))
                    gn2 (and gn1 (region? text pos ns))
                    gp3 (if (and gp2 gn2 (< (count ps) (count ns))) false gp2)
                    gn3 (if (and gp2 gn2 (> (count ps) (count ns))) false gn2)]
                (if (= gp3 gn3) fail
                  (let [end (+ pos (count (if gp3 ps ns)))]
                    (if (:infinite r) (->PRes 3 (d/zero) gp3 end)
                      (let [x0 (dl-dec (:digits r) (:decimal-at r))
                            m (:multiplier p)
                            x1 (if (= m 1) x0
                                 (let [[q e] (d/div-exact x0 (d/from-int m))]
                                   (if (= e "") q (let [[q2 e2] (d/div-scale x0 (d/from-int m) (d/scale x0) d/HALF-EVEN)] q2))))]
                        (->PRes 1 x1 gp3 end)))))))))))))

(defn parse-dec Values(d/Dec Str Bool) [text: &Str pattern: &Str locale: &Str]
  (let [[p pe] (compile-pattern pattern)]
    (if (not= pe "") (values (d/zero) pe false)
      (let [[x ok] (parse-with text p (symbols locale))] (values x "" ok)))))

(defn normalize d/Dec [x: &d/Dec]
  (if (<= (d/scale x) 0) (d/of (d/unscaled x) (d/scale x))
    (let [s (d/strip-trailing-zeros x)]
      (if (< (d/scale s) 0) (let [[r e] (d/set-scale s 0 d/UNNECESSARY)] r) s))))
