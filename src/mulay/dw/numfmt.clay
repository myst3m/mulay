(ns mulay.dw.numfmt
  (:require [mulay.lib.numparse :as npz] [mulay.lib.dec :as d] [mulay.lib.bigint :as bi] [mulay.lib.uni :as uni] [clay.string :as str]))

(defrecord Syms [zero: Int group: Int dec: Int minus: Str pct: Str permill: Str exp: Str
                 mdec: Int mgroup: Int inf: Str nan: Str cur: Str intl: Str])

(defrecord Aff [kind: Int text: Str])

(defrecord Pat
  [pos-pre: Vec(Aff) pos-suf: Vec(Aff) neg-pre: Vec(Aff) neg-suf: Vec(Aff)
   min-int: Int max-int: Int min-frac: Int max-frac: Int
   grouping: Bool group-size: Int multiplier: Int dec-always: Bool
   use-exp: Bool min-exp: Int currency: Bool])

