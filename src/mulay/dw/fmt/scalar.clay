(ns mulay.dw.fmt.scalar
  (:require [mulay.dw.val :as v] [mulay.dw.num :as num] [mulay.dw.rt :as rt] [mulay.dw.err :as dwe]
            [mulay.dw.coerce_time :as ct] [mulay.dw.coerce_num :as cn]))

(defn temporal-text Values(Str Bool Str) [x0: &v/Val use-fmt: Bool]
  (let [[s ok] (v/temporal-str (v/unmeta x0))]
    (if (not ok) (values "" false "")
      (if (not use-fmt) (values s true "")
        (let [[fs found e] (ct/meta-format-str x0)]
          (if found (values fs true e) (values s true "")))))))

(defn number-text Values(Str Bool Str) [x0: &v/Val]
  (match x0
    (v/VMeta y m)
    (if (= (count (v/obj-get m "format")) 0) (values "" false "")
      (let [n (match (v/unmeta y) (v/VNum a) [a] (v/VInt a-i) [(num/from-int a-i)] _ [])]
        (if (= (count n) 0) (values "" false "")
          (let [[r e] (cn/num-to-str (nth n 0) m)]
            (if (not (dwe/ok? e)) (values "" true (:msg e))
              (match r (v/VStr s) (values s true "") _ (values "" false "")))))))
    _ (values "" false "")))
