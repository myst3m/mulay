(ns mulay.dw.fmt.out (:require [mulay.dw.err :as dwe]))

(defrecord Sink [emit: Fn(Str dwe/DwErr) limit: Int])

(def FLUSH-AT 65536)

(defn- keep-all dwe/DwErr [s: Str] (dwe/err "WriterException" "the writer has nowhere to send its output"))

(defn whole Sink [] (->Sink keep-all 9223372036854775807))

(defn to Sink [emit: Fn(Str dwe/DwErr)] (->Sink emit FLUSH-AT))

(defn flush Values(Str dwe/DwErr) [out: Str snk: &Sink]
  (if (< (count out) (:limit snk)) (values out (dwe/ok))
    (let [e ((:emit snk) out)] (values "" e))))

(defn writer-err dwe/DwErr [msg: Str] (dwe/err "WriterException" msg))
