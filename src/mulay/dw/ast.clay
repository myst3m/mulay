(ns mulay.dw.ast)

(defrecord Span [start: Int end: Int])

(defvariant TyE
  (TName name: Str args: Vec(Ty))
  (TObj fields: Vec(TField) closed: Bool ordered: Bool)
  (TUnion alts: Vec(Ty))
  (TInter parts: Vec(Ty))
  (TLit value: Node)
  (TFn params: Vec(Ty) ret: Ty)
  (TMeta base: Ty schema: Node)
  (TSel base: Ty ns: Str name: Str))
(defrecord Ty [t: TyE sp: Span])
(defrecord TField [key: Str ns: Str optional: Bool repeated: Bool ty: Ty attrs: Vec(TField)])

(defvariant StrPart
  (SPText text: Str)
  (SPExpr e: Node))

(defvariant Key
  (KName ns: Str name: Str)
  (KStr parts: Vec(StrPart))
  (KExpr ns: Str e: Node))
(defrecord Attr [ns: Str name: Str value: Node cond: Vec(Node)
                 spread: Bool])

(defvariant Entry
  (EKV key: Key attrs: Vec(Attr) value: Node cond: Vec(Node))
  (ESpread e: Node cond: Vec(Node)))

(defrecord Elem [value: Node cond: Vec(Node)])

(defvariant Sel
  (SelKey ns: Str name: Str)
  (SelMulti ns: Str name: Str)
  (SelDesc ns: Str name: Str)
  (SelDescMulti ns: Str name: Str)
  (SelAttr name: Str)
  (SelAllAttrs)
  (SelKV name: Str)
  (SelDescKV name: Str)
  (SelAllKV)
  (SelNs)
  (SelMeta name: Str)
  (SelDyn e: Node)
  (SelQDyn ns: Str e: Node)
  (SelMultiDyn e: Node)
  (SelRange from: Node to: Node)
  (SelFilter pred: Node)
  (SelAttrDyn e: Node)
  (SelAttrQ ns: Str name: Str multi: Bool))

(defvariant Pat
  (PLit value: Node)
  (PGuard cond: Node)
  (PType ty: Ty)
  (PRegex re: Node)
  (PArrDestr head: Str tail: Str)
  (PObjDestr key: Str value: Str tail: Str)
  (PElse))
(defrecord Case [bind: Str pat: Pat body: Node sp: Span])

(defrecord UpdCase [bind: Str path: Vec(Sel) cond: Vec(Node) body: Node sp: Span
                    index: Str
                    upsert: Bool])

(defrecord Param [name: Str ty: Vec(Ty) default: Vec(Node)])
(defrecord Annotation [name: Str args: Vec(Node)])

(defvariant Decl
  (DVar name: Str ty: Vec(Ty) value: Node)
  (DFun name: Str params: Vec(Param) ret: Vec(Ty) body: Node annots: Vec(Annotation) generics: Vec(Str))
  (DType name: Str generics: Vec(Str) ty: Ty)
  (DNs prefix: Str uri: Str)
  (DImport module: Str names: Vec(ImportName) star: Bool alias: Str)
  (DAnnotationDef name: Str params: Vec(Param)))
(defrecord ImportName [name: Str alias: Str])
(defrecord DeclAt [d: Decl sp: Span])

(defvariant Ex
  (ENull)
  (EBool b: Bool)
  (ENum text: Str)
  (EStr parts: Vec(StrPart))
  (ERegex pattern: Str flags: Str)
  (ETemporal kind: Str text: Str)
  (ERef name: Str)
  (EArr elems: Vec(Elem))
  (EObj entries: Vec(Entry))
  (EUnary op: Str e: Node)
  (EBin op: Str l: Node r: Node osp: Span)
  (ECall f: Node args: Vec(Node))
  (ELambda params: Vec(Param) ret: Vec(Ty) body: Node)
  (ESelect target: Node sel: Sel)
  (EExists target: Node)
  (EAssert target: Node)
  (EIf cond: Node then: Node else: Node)
  (EMatch target: Node cases: Vec(Case))
  (EAs e: Node ty: Ty)
  (EIs e: Node ty: Ty)
  (EMetaSet e: Node schema: Node)
  (EDo decls: Vec(DeclAt) body: Node)
  (EUsing binds: Vec(DeclAt) body: Node)
  (EUpdate target: Node cases: Vec(UpdCase))
  (ETypeRef ty: Ty)
  (EErr msg: Str))

(defrecord Node [e: Ex sp: Span])

(defrecord Directive [kind: Str name: Str mime: Str props: Node sp: Span
                      fmt: Str
                      ty: Vec(Ty)])
(defrecord Script
  [version: Str
   directives: Vec(Directive)
   decls: Vec(DeclAt)
   body: Node])

(defrecord Diag [msg: Str sp: Span])
