(ns mulay.dw.lib.dtd (:require [mulay.dw.val :as v] [mulay.dw.num :as num] [mulay.dw.rt :as rt] [mulay.dw.err :as dwe] [mulay.dw.lib.core :as core]))

(def M "dw::xml::Dtd")

(defn- field-str Values(Str Bool) [fs: &Vec(v/Field) k: &Str]
  (let [r (v/obj-get fs k)]
    (if (= (count r) 0) (values "" false)
      (match (v/unmeta (nth r 0))
        (v/VNull) (values "" false)
        _ (let [[s e] (rt/to-text (nth r 0))] (values s (dwe/ok? e)))))))

(defn- doc-type-as-string Values(v/Val dwe/DwErr) [env: rt/Env a: Vec(v/Val)]
  (match (v/unmeta (nth a 0))
    (v/VObj fs) (let [[root rok] (field-str fs "rootName")
                      [pub pok] (field-str fs "publicId")
                      [sys sok] (field-str fs "systemId")
                      [sub bok] (field-str fs "internalSubset")
                      s1 (if sok (if pok (str root " PUBLIC " pub " " sys) (str root " SYSTEM " sys)) (str root))]
                  (rt/ret (v/->VStr (if bok (str s1 " [" sub "]") s1))))
    _ (rt/failure "InvalidArgs" "docTypeAsString expects a DocType")))

(defn builtins Vec(rt/Builtin) []
  [(rt/builtin "docTypeAsString" M [(rt/b1 "Object" doc-type-as-string)])])
