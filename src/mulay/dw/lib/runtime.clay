(defn- ok Values(v/Val dwe/DwErr) [x: v/Val] (rt/ret x))
(defn- sv v/Val [s: &Str] (v/->VStr (str s)))
(defn- user-fail Values(v/Val dwe/DwErr) [msg: &Str] (rt/failure "UserException" (str msg)))

(defn- fn-arg Vec(v/FnV) [a: &Vec(v/Val) i: Int]
  (match (v/unmeta (nth a i)) (v/VFn f) [f] _ []))

(defn- success-v v/Val [x: v/Val]
  (v/->VObj [(v/field "success" (v/bool-v true)) (v/field "result" x)]))

(defn- failure-v v/Val [env: &rt/Env e: &dwe/DwErr]
  (let [srcs (rt/env-srcs env)
        base [(v/field "kind" (sv (loc/dw-kind (:kind e)))) (v/field "message" (sv (:msg e)))]
        fields (if (= (:main srcs) "") base
                 (conj (conj base (v/field "location" (sv (loc/err-excerpt e srcs))))
                       (v/field "stack" (loc/stack-v e srcs))))]
    (v/->VObj [(v/field "success" (v/bool-v false)) (v/field "error" (v/->VObj fields))])))

(defn- force Values(v/Val dwe/DwErr) [env: &rt/Env x: &v/Val]
  (match (v/unmeta x)
    (v/VFn f) (rt/env-call env f [])
    _ (rt/ret x)))

(defn- forced Values(v/Val dwe/DwErr) [env: &rt/Env x: &v/Val]
  (let [[y e] (force env x)]
    (if (and (dwe/ok? e) (:lazy env) (v/has-seq? y)) (v/whole-deep y) (values y e))))

(defn- try-val Values(v/Val dwe/DwErr) [env: &rt/Env x: &v/Val]
  (let [[y e] (forced env x)]
    (cond (dwe/ok? e) (ok (success-v y))
          (dwe/input? e) (values (v/null-v) e)
          :else (ok (failure-v env e)))))

(defn- success? Bool [x: &v/Val]
  (match (v/unmeta x)
    (v/VObj fs) (let [s (v/obj-get fs "success")]
                  (and (> (count s) 0) (match (v/unmeta (nth s 0)) (v/VBool b) b _ false)))
    _ false))

(defn- fail0 Values(v/Val dwe/DwErr) [env: rt/Env a: Vec(v/Val)] (user-fail ""))
(defn- fail1 Values(v/Val dwe/DwErr) [env: rt/Env a: Vec(v/Val)] (user-fail (core/arg-str a 0)))

(defn- fail-if Values(v/Val dwe/DwErr) [env: rt/Env a: Vec(v/Val)]
  (let [x (nth a 0) msg (if (> (count a) 2) (core/arg-str a 2) "Failed")
        [b e] (match (v/unmeta (nth a 1)) (v/VFn f) (rt/env-call env f [x]) _ (rt/ret (nth a 1)))]
    (if (not (dwe/ok? e)) (values b e)
      (match (v/unmeta b)
        (v/VBool t) (if t (user-fail msg) (ok x))
        _ (rt/failure "CoercionException" (str "Cannot coerce " (v/type-name (v/unmeta b)) " to Boolean"))))))

(defn- try-fn Values(v/Val dwe/DwErr) [env: rt/Env a: Vec(v/Val)] (try-val env (nth a 0)))

(defn- or-else-try Values(v/Val dwe/DwErr) [env: rt/Env a: Vec(v/Val)]
  (if (success? (nth a 0)) (ok (nth a 0)) (try-val env (nth a 1))))

(defn- or-else Values(v/Val dwe/DwErr) [env: rt/Env a: Vec(v/Val)]
  (if (success? (nth a 0))
    (let [r (match (v/unmeta (nth a 0)) (v/VObj fs) (v/obj-get fs "result") _ [])]
      (if (= (count r) 0) (rt/failure "KeyNotFoundException" "There is no key named 'result'") (ok (nth r 0))))
    (force env (nth a 1))))

(defn- wait-fn Values(v/Val dwe/DwErr) [env: rt/Env a: Vec(v/Val)]
  (let [[ms e] (num/to-int (core/arg-num a 1))
        z (if (and (= e "") (> ms 0)) (host/pause-ms ms) 0)]
    (ok (nth a 0))))

(defn- version-fn Values(v/Val dwe/DwErr) [env: rt/Env a: Vec(v/Val)] (ok (v/->VStr "2.11")))

(defn- origin-loc v/Val [env: &rt/Env o: &v/Val]
  (match (v/unmeta o)
    (v/VObj fs)
    (let [sv0 (v/obj-get fs "s") mv (v/obj-get fs "m")]
      (cond
        (> (count sv0) 0) (let [[s e1] (num/to-int (core/arg-num [(nth sv0 0)] 0))
                                [e e2] (num/to-int (core/arg-num (v/obj-get fs "e") 0))]
                            (loc/script-loc-in (rt/env-srcs env) s e))
        (> (count mv) 0) (loc/stdlib-loc (core/arg-str mv 0) (core/arg-str (v/obj-get fs "n") 0))
        :else (loc/unknown-loc)))
    _ (loc/unknown-loc)))

(defn- known-origin? Bool [o: &v/Val]
  (match (v/unmeta o) (v/VObj fs) (or (> (count (v/obj-get fs "s")) 0) (> (count (v/obj-get fs "m")) 0)) _ false))

(defn- value-loc v/Val [env: &rt/Env a: &Vec(v/Val)]
  (cond
    (< (count a) 2) (loc/unknown-loc)
    (known-origin? (nth a 1)) (origin-loc env (nth a 1))
    :else
    (match (v/unmeta (nth a 0))
      (v/VFn f) (let [sp (rt/env-fn-span env f)]
                  (if (= (count sp) 0) (loc/unknown-loc)
                    (let [srcs (rt/env-srcs env)
                          [text id base] (rt/seg-of srcs (nth sp 0))
                          [s e] (rt/strip-parens text (- (nth sp 0) base) (- (nth sp 1) base))]
                      (loc/script-loc-in srcs (+ s base) (+ e base)))))
      _ (origin-loc env (nth a 1)))))

(defn- location-fn Values(v/Val dwe/DwErr) [env: rt/Env a: Vec(v/Val)]
  (ok (value-loc env a)))

(defn- location-string Values(v/Val dwe/DwErr) [env: rt/Env a: Vec(v/Val)]
  (let [l (value-loc env a)
        t (match l (v/VObj fs) (core/arg-str (v/obj-get fs "text") 0) _ "")]
    (ok (sv t))))

(defn- env1 Str [name: &Str default: Str]
  (let [r (sys/env-lookup name)] (if (= (count r) 0) default (nth r 0))))

(defn- cwd Str []
  (let [[d e] (host/work-dir)] d))

(defn- locale-parts Values(Str Str) []
  (let [l (env1 "LANG" "") d (str/index-of l ".") base (if (< d 0) l (subs l 0 d)) u (str/index-of base "_")]
    (if (or (= base "") (= base "C") (= base "POSIX")) (values "en" "")
      (if (< u 0) (values base "") (values (subs base 0 u) (subs base (+ u 1) (count base)))))))

(def SYS-PROPS (atom (let [z: Vec(v/Field) []] z)))

(defn set-sys-props! Int [fs: Vec(v/Field)] (let [z (reset! SYS-PROPS fs)] 0))

(defn- with-sys Vec(v/Field) [base: Vec(v/Field)]
  (let [extra: Vec(v/Field) (deref SYS-PROPS)]
    (loop [i 0 acc base]
      (if (>= i (count extra)) acc
        (let [f (nth extra i) n (:name (:key f))
              k (loop [j 0] (if (>= j (count acc)) -1 (if (= (:name (:key (nth acc j))) n) j (recur (+ j 1)))))]
          (recur (+ i 1) (if (< k 0) (conj acc f) (assoc acc k f))))))))

(defn props-fields Vec(v/Field) []
  (let [[lang country] (locale-parts)
        f: Vec(v/Field) [(v/field "file.encoding" (sv "UTF-8"))
                         (v/field "file.separator" (sv "/"))
                         (v/field "line.separator" (sv "\n"))
                         (v/field "path.separator" (sv ":"))
                         (v/field "java.io.tmpdir" (sv "/tmp"))
                         (v/field "os.arch" (sv (osi/java-arch)))
                         (v/field "os.name" (sv "Linux"))
                         (v/field "os.version" (sv (osi/uname-release)))
                         (v/field "user.dir" (sv (cwd)))
                         (v/field "user.home" (sv (osi/user-home)))
                         (v/field "user.language" (sv lang))]
        f2 (if (= country "") f (conj f (v/field "user.country" (sv country))))]
    (with-sys (conj (conj f2 (v/field "user.name" (sv (osi/user-name))))
                    (v/field "user.timezone" (sv (tt/zone-id (tz/system-zone))))))))

(defn- props-fn Values(v/Val dwe/DwErr) [env: rt/Env a: Vec(v/Val)] (ok (v/->VObj (props-fields))))

(defn- prop-fn Values(v/Val dwe/DwErr) [env: rt/Env a: Vec(v/Val)]
  (let [r (v/obj-get (props-fields) (core/arg-str a 0))]
    (ok (if (= (count r) 0) (v/null-v) (nth r 0)))))

(defn descriptors Vec(v/Val) []
  (let [[x e] (json/read DATA-FORMATS)] (v/items x)))

(defn- descriptors-fn Values(v/Val dwe/DwErr) [env: rt/Env a: Vec(v/Val)] (ok (v/->VArr (descriptors))))

(defn- lower-ascii Str [s: &Str]
  (loop [i 0 out ""]
    (if (>= i (count s)) out
      (let [c (nth s i)] (recur (+ i 1) (str out (chr (if (and (>= c 65) (<= c 90)) (+ c 32) c))))))))

(defn- mime-matches? Bool [pat: &Str qt: &Str qs: &Str]
  (let [k (str/index-of pat "/")]
    (if (< k 0) false
      (let [pt (lower-ascii (subs pat 0 k)) ps (lower-ascii (subs pat (+ k 1) (count pat)))]
        (and (or (= pt "*") (= pt qt))
             (or (= ps "*") (= ps qs)
                 (and (str/starts-with? ps "*+") (str/ends-with? qs (subs ps 1 (count ps))) (not= qs "*"))))))))

(defn- str-field Str [fs: &Vec(v/Field) k: &Str]
  (let [r (v/obj-get fs k)] (if (= (count r) 0) "" (match (v/unmeta (nth r 0)) (v/VStr s) s _ ""))))

(defn- find-descriptor Values(v/Val dwe/DwErr) [env: rt/Env a: Vec(v/Val)]
  (let [q (core/arg-fields a 0) qt (lower-ascii (str-field q "type")) qs (lower-ascii (str-field q "subtype"))
        ds (descriptors)]
    (loop [i 0]
      (if (>= i (count ds)) (ok (v/null-v))
        (let [d (nth ds i)
              pats (match (v/unmeta d) (v/VObj fs) (let [r (v/obj-get fs "acceptedMimeTypes")] (if (= (count r) 0) [] (v/items (nth r 0)))) _ [])
              hit (loop [k 0] (if (>= k (count pats)) false
                                (if (match (v/unmeta (nth pats k)) (v/VStr p) (mime-matches? p qt qs) _ false) true (recur (+ k 1)))))]
          (if hit (ok d) (recur (+ i 1))))))))

(defn- unsupported-run Values(v/Val dwe/DwErr) [name: &Str]
  (rt/failure "Unsupported" (str "dw::Runtime::" name " is not supported by mulay yet")))

(defn- opt-obj v/Val [a: &Vec(v/Val) i: Int] (if (< i (count a)) (nth a i) (v/->VObj [])))

(defn- eval-fn Values(v/Val dwe/DwErr) [env: rt/Env a: Vec(v/Val)]
  (rt/env-run env (core/arg-str a 0) (nth a 1) (opt-obj a 2) (opt-obj a 3) false))
(defn- run-fn Values(v/Val dwe/DwErr) [env: rt/Env a: Vec(v/Val)]
  (rt/env-run env (core/arg-str a 0) (nth a 1) (opt-obj a 2) (opt-obj a 3) true))

(defn- url-fn Fn(rt/Env Vec(v/Val) Values(v/Val dwe/DwErr)) [name: Str]
  (fn Values(v/Val dwe/DwErr) [env: rt/Env a: Vec(v/Val)]
    (let [u (core/arg-str a 0)]
      (if (str/starts-with? u "classpath://")
        (let [[t e] (urls/load-url u)]
          (if (not= e "") (rt/failure "ResourceNotFound" e) (unsupported-run name)))
        (unsupported-run name)))))

(defn- B rt/Builtin [name: Str os: Vec(rt/Overload)] (rt/builtin name M os))
(defn- b0 rt/Overload [f: Fn(rt/Env Vec(v/Val) Values(v/Val dwe/DwErr))] (rt/overload [] f))
(defn- b3 rt/Overload [t: Str u: Str w: Str f: Fn(rt/Env Vec(v/Val) Values(v/Val dwe/DwErr))] (rt/overload [t u w] f))
(defn- b4 rt/Overload [t: Str u: Str w: Str x: Str f: Fn(rt/Env Vec(v/Val) Values(v/Val dwe/DwErr))] (rt/overload [t u w x] f))
(defn- b5 rt/Overload [t: Str u: Str w: Str x: Str y: Str f: Fn(rt/Env Vec(v/Val) Values(v/Val dwe/DwErr))] (rt/overload [t u w x y] f))

(defn builtins Vec(rt/Builtin) []
  [(B "fail" [(rt/b1 "String" fail1) (b0 fail0)])
   (B "failIf" [(b3 "Any" "Function" "String" fail-if) (rt/b2 "Any" "Function" fail-if)
                (b3 "Any" "Any" "String" fail-if) (rt/b2 "Any" "Any" fail-if)])
   (B "run" [(b5 "String" "Object" "Object" "Object" "Object" run-fn) (b4 "String" "Object" "Object" "Object" run-fn)
             (b3 "String" "Object" "Object" run-fn) (rt/b2 "String" "Object" run-fn)])
   (B "eval" [(b5 "String" "Object" "Object" "Object" "Object" eval-fn) (b4 "String" "Object" "Object" "Object" eval-fn)
              (b3 "String" "Object" "Object" eval-fn) (rt/b2 "String" "Object" eval-fn)])
   (B "runUrl" [(b4 "String" "Object" "Object" "Object" (url-fn "run")) (b3 "String" "Object" "Object" (url-fn "run"))
                (rt/b2 "String" "Object" (url-fn "run")) (rt/b1 "String" (url-fn "run"))])
   (B "evalUrl" [(b4 "String" "Object" "Object" "Object" (url-fn "eval")) (b3 "String" "Object" "Object" (url-fn "eval"))
                 (rt/b2 "String" "Object" (url-fn "eval")) (rt/b1 "String" (url-fn "eval"))])
   (B "dataFormatsDescriptor" [(b0 descriptors-fn)])
   (B "wait" [(rt/b2 "Any" "Number" wait-fn)])
   (B "try" [(rt/b1 "Function" try-fn)])
   (B "orElseTry" [(rt/b2 "Object" "Any" or-else-try)])
   (B "orElse" [(rt/b2 "Object" "Any" or-else)])
   (B "locationString" [(rt/b1 "Any" location-string) (rt/b2 "Any" "Object" location-string)])
   (B "location" [(rt/b1 "Any" location-fn) (rt/b2 "Any" "Object" location-fn)])
   (B "props" [(b0 props-fn)])
   (B "prop" [(rt/b1 "String" prop-fn)])
   (B "version" [(b0 version-fn)])
   (B "findDataFormatDescriptorByMime" [(rt/b1 "Object" find-descriptor)])])
