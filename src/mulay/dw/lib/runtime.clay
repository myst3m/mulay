l\":true,\"defaultValue\":8192,\"description\":\"Size of the buffer writer, in bytes. The value must be greater than `8`.\\n\",\"possibleValues\":[]},{\"name\":\"deferred\",\"optional\":true,\"defaultValue\":false,\"description\":\"Generates the output as a data stream when set to `true`, and defers the script's execution until the generated content is consumed.\\n\",\"possibleValues\":[true,false]}]},{\"name\":\"properties\",\"binary\":false,\"extensions\":[\".properties\"],\"defaultMimeType\":\"text/x-java-properties\",\"acceptedMimeTypes\":[\"*/x-java-properties\",\"*/properties\"],\"readerProperties\":[],\"writerProperties\":[{\"name\":\"encoding\",\"optional\":true,\"defaultValue\":\"None\",\"description\":\"The encoding to use for the output, such as UTF-8.\\n\",\"possibleValues\":[]},{\"name\":\"bufferSize\",\"optional\":true,\"defaultValue\":8192,\"description\":\"Size of the buffer writer, in bytes. The value must be greater than `8`.\\n\",\"possibleValues\":[]},{\"name\":\"deferred\",\"optional\":true,\"defaultValue\":false,\"description\":\"Generates the output as a data stream when set to `true`, and defers the script's execution until the generated content is consumed.\\n\",\"possibleValues\":[true,false]}]},{\"name\":\"dwb\",\"binary\":false,\"extensions\":[\".dwb\"],\"defaultMimeType\":\"application/dwb\",\"acceptedMimeTypes\":[\"application/dwb\"],\"readerProperties\":[{\"name\":\"indexedReader\",\"optional\":true,\"defaultValue\":true,\"description\":\"Uses the indexed reader by default when reaching the threshold. Supports US-ASCII, UTF-8 and ISO-8859-1 encodings only. For other encodings, DataWeave uses the in-memory reader.\",\"possibleValues\":[true,false]}],\"writerProperties\":[{\"name\":\"bufferSize\",\"optional\":true,\"defaultValue\":8192,\"description\":\"Size of the buffer writer, in bytes. The value must be greater than `8`.\\n\",\"possibleValues\":[]},{\"name\":\"deferred\",\"optional\":true,\"defaultValue\":false,\"description\":\"Generates the output as a data stream when set to `true`, and defers the script's execution until the generated content is consumed.\\n\",\"possibleValues\":[true,false]},{\"name\":\"writeIndex\",\"optional\":true,\"defaultValue\":false,\"description\":\"If it should add the token and hierarchical index at the end to avoid parsing again when this is read\",\"possibleValues\":[true,false]}]},{\"name\":\"excel\",\"binary\":true,\"extensions\":[\".xlsx\"],\"defaultMimeType\":\"application/xlsx\",\"acceptedMimeTypes\":[\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\",\"application/xlsx\"],\"readerProperties\":[{\"name\":\"zipBombCheck\",\"optional\":true,\"defaultValue\":true,\"description\":\"Turns off the zip bomb (decompression bomb) check when set to `false`.\",\"possibleValues\":[true,false]},{\"name\":\"streaming\",\"optional\":true,\"defaultValue\":false,\"description\":\"Streams input when set to `true`. Use only if entries are accessed sequentially. The input must be a top-level array. See the <<example2, streaming example>>, and see https://docs.mulesoft.com/dataweave/latest/dataweave-formats#dw_readers_writers[DataWeave Readers].\\n\",\"possibleValues\":[true,false]},{\"name\":\"tableLimit\",\"optional\":true,\"defaultValue\":\"Unbounded\",\"description\":\"Position of the last column in each row. Accepts a pattern `<Column>` (for example, `'A'` or `'AB'`), the value `'HeaderSize'`, which uses the location of the last header, or 'Unbounded', which consumes each row.\",\"possibleValues\":[]},{\"name\":\"maxEntrySize\",\"optional\":true,\"defaultValue\":\"None\",\"description\":\"Sets the maximum number of bytes a single entry in a ZIP file can have.\",\"possibleValues\":[]},{\"name\":\"minInflateRatio\",\"optional\":true,\"defaultValue\":\"None\",\"description\":\"Sets the ratio between de- and inflated bytes to detect zip bomb. For example, if you set the value to 1 percent (= 0.01d) when the compression is better than 1 percent for any given read package part, the parsing fails to indicate a zip bomb.\",\"possibleValues\":[]},{\"name\":\"ignoreEmptyLine\",\"optional\":true,\"defaultValue\":true,\"description\":\"Ignores an empty line by default.\",\"possibleValues\":[true,false]},{\"name\":\"header\",\"optional\":true,\"defaultValue\":true,\"description\":\"Indicates whether the first line of the output contains header field names.\",\"possibleValues\":[true,false]},{\"name\":\"tableOffset\",\"optional\":true,\"defaultValue\":\"None\",\"description\":\"Sets the position of the first cell. Accepts the pattern `<Column><Row>`, for example, `A1` or `B3`.\",\"possibleValues\":[]}],\"writerProperties\":[{\"name\":\"zipBombCheck\",\"optional\":true,\"defaultValue\":true,\"description\":\"Turns off the zip bomb (decompression bomb) check when set to `false`.\",\"possibleValues\":[true,false]},{\"name\":\"maxEntrySize\",\"optional\":true,\"defaultValue\":\"None\",\"description\":\"Sets the maximum number of bytes a single entry in a ZIP file can have.\",\"possibleValues\":[]},{\"name\":\"minInflateRatio\",\"optional\":true,\"defaultValue\":\"None\",\"description\":\"Sets the ratio between de- and inflated bytes to detect zip bomb. For example, if you set the value to 1 percent (= 0.01d) when the compression is better than 1 percent for any given read package part, the parsing fails to indicate a zip bomb.\",\"possibleValues\":[]},{\"name\":\"bufferSize\",\"optional\":true,\"defaultValue\":8192,\"description\":\"Size of the buffer writer, in bytes. The value must be greater than `8`.\\n\",\"possibleValues\":[]},{\"name\":\"ignoreEmptyLine\",\"optional\":true,\"defaultValue\":true,\"description\":\"Ignores an empty line by default.\",\"possibleValues\":[true,false]},{\"name\":\"header\",\"optional\":true,\"defaultValue\":true,\"description\":\"Indicates whether the first line of the output contains header field names.\",\"possibleValues\":[true,false]},{\"name\":\"tableOffset\",\"optional\":true,\"defaultValue\":\"None\",\"description\":\"Sets the position of the first cell. Accepts the pattern `<Column><Row>`, for example, `A1` or `B3`.\",\"possibleValues\":[]},{\"name\":\"deferred\",\"optional\":true,\"defaultValue\":false,\"description\":\"Generates the output as a data stream when set to `true`, and defers the script's execution until the generated content is consumed.\\n\",\"possibleValues\":[true,false]}]},{\"name\":\"flatfile\",\"binary\":false,\"extensions\":[\".flatfile\",\".copybook\"],\"defaultMimeType\":\"application/flatfile\",\"acceptedMimeTypes\":[\"*/flatfile\"],\"readerProperties\":[{\"name\":\"allowLenientWithBinaryNotEndElement\",\"optional\":true,\"defaultValue\":false,\"description\":\"When the schema contains elements of type Binary or Packed, the `lenient` option does not allow short records, regardless of the last element's\\nformat type. When you set this property to `true`, the validation applies only to cases in which the record ends with type Binary or Packed.\",\"possibleValues\":[true,false]},{\"name\":\"zonedDecimalStrict\",\"optional\":true,\"defaultValue\":false,\"description\":\"For COBOL copybook, uses the 'strict' ASCII form of sign encoding for zoned decimal values.\",\"possibleValues\":[true,false]},{\"name\":\"structureIdent\",\"optional\":true,\"defaultValue\":\"None\",\"description\":\"Structure identifier in the schema for flat file schemas. Required when parsing a structure definition if the schema includes multiple structure definitions.\",\"possibleValues\":[]},{\"name\":\"schemaPath\",\"optional\":false,\"defaultValue\":\"None\",\"description\":\"Path to the schema definition. Specifies the location in your local disk of the schema file that parses your input.\",\"possibleValues\":[]},{\"name\":\"missingValues\",\"optional\":true,\"defaultValue\":\"None\",\"description\":\"Fill character used to represent missing values. To activate a non-default setting, set the `useMissCharAsDefaultForFill` property to `true`, and use one of the following values to `missingValues`:\\n\\n* `none` (for the reader) or `NONE` (for the writer): Treats all data as values.\\n* `spaces` (for the reader) or `SPACES` (for the writer): Interprets a field consisting of only spaces as a missing value. Default for flat file and fixed-width formats.\\n* `zeroes` (for the reader) or `ZEROES` (for the writer): Interprets numeric fields consisting of only `0` characters _and_ character fields consisting of only spaces as missing values.\\n* `nulls` (for the reader) or `NULLS` (for the writer): Interprets a field consisting only of `0` bytes as a missing value. Default for COBOL copybook schema.\",\"possibleValues\":[\"none\",\"spaces\",\"zeroes\",\"nulls\"]},{\"name\":\"segmentIdent\",\"optional\":true,\"defaultValue\":\"None\",\"description\":\"Segment identifier in the schema for fixed-width or COBOL copybook schemas. Required when parsing a single segment or record definition if the schema includes multiple segment definitions.\",\"possibleValues\":[]},{\"name\":\"recordParsing\",\"optional\":true,\"defaultValue\":\"strict\",\"description\":\"Specifies the expected type of separation between lines or records:\\n\\n* `strict`: Line break is expected at exact end of each record. `strict` is the default.\\n* `lenient`: Line break is used, but records can be shorter or longer than the schema specifies. Don't use `lenient` if your payload lacks line breaks. The other options to `recordParsing` support records that lack line breaks.\\n* `noTerminator`: Records follow one another with no separation. This option is preferred for fixed-length records that lack a line break.\\n* `singleRecord`: The entire input is a single record.\\n\\nNote that schemas with type `Binary` or `Packed` don't allow for line break detection, so setting `recordParsing` to `lenient` only allows long records to be handled, not short ones. These schemas also currently only work with certain single-byte character encodings (so not with UTF-8 or any multibyte format).\",\"possibleValues\":[\"strict\",\"lenient\",\"noTerminator\",\"singleRecord\"]},{\"name\":\"enforceRequires\",\"optional\":true,\"defaultValue\":false,\"description\":\"Produces an error when set to `true` if a required value is missing.\",\"possibleValues\":[true,false]},{\"name\":\"notTruncateDependingOnSubjectNotPresent\",\"optional\":true,\"defaultValue\":false,\"description\":\"Fills the entire group when the DEPENDING ON subject is not present.\",\"possibleValues\":[true,false]},{\"name\":\"useMissCharAsDefaultForFill\",\"optional\":true,\"defaultValue\":false,\"description\":\"By default, the flat file reader and writer use spaces for missing characters and ignore the setting of the `missingValues` property. When you set this property to `true`, DataWeave honors the `missingValues property` setting. Introduced in DataWeave 2.3 (2.3.0-20210823) for the September 2021 release of Mule 4.3.0-20210823.\",\"possibleValues\":[true,false]},{\"name\":\"substituteCharacterAsMissingValue\",\"optional\":true,\"defaultValue\":false,\"description\":\"If set to `true` and if the `missingValues` property is set to `none`, with `useMissCharAsDefaultForFill` is set to `true`, the flat file parser handles the `0x1A` (SUB) character as the missing value. +\\nOtherwise, the flat file parser doesn't handle the `0x1A` character as the missing value.\",\"possibleValues\":[true,false]},{\"name\":\"truncateDependingOn\",\"optional\":true,\"defaultValue\":false,\"description\":\"For COBOL copybook, truncates DEPENDING ON values to the length used.\",\"possibleValues\":[true,false]},{\"name\":\"retainEmptyStringFieldsOnParsing\",\"optional\":true,\"defaultValue\":false,\"description\":\"Allow parsing behavior to keep missing string value fields with a default value in the output map\",\"possibleValues\":[true,false]}],\"writerProperties\":[{\"name\":\"zonedDecimalStrict\",\"optional\":true,\"defaultValue\":false,\"description\":\"For COBOL copybook, uses the 'strict' ASC