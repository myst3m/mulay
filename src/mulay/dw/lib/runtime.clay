alse,\"description\":\"Enables Java module functions to load.\",\"possibleValues\":[true,false]}],\"writerProperties\":[{\"name\":\"indent\",\"optional\":true,\"defaultValue\":\"  \",\"description\":\"String to use for indenting.\",\"possibleValues\":[]},{\"name\":\"ignoreSchema\",\"optional\":true,\"defaultValue\":false,\"description\":\"Ignores the schema when set to `true`.\",\"possibleValues\":[true,false]},{\"name\":\"onlyData\",\"optional\":true,\"defaultValue\":true,\"description\":\"Handles only data and not other types of content, such as functions, when set to `true`. The DataWeave parser runs faster in the `onlyData` mode.\",\"possibleValues\":[true,false]},{\"name\":\"maxCollectionSize\",\"optional\":true,\"defaultValue\":-1,\"description\":\"Maximum number of elements allowed in an array or an object. `-1` indicates no limitation.\",\"possibleValues\":[]},{\"name\":\"bufferSize\",\"optional\":true,\"defaultValue\":8192,\"description\":\"Size of the buffer writer, in bytes. The value must be greater than `8`.\\n\",\"possibleValues\":[]},{\"name\":\"deferred\",\"optional\":true,\"defaultValue\":false,\"description\":\"Generates the output as a data stream when set to `true`, and defers the script's execution until the generated content is consumed.\\n\",\"possibleValues\":[true,false]}]},{\"name\":\"yaml\",\"binary\":false,\"defaultEncoding\":\"UTF-8\",\"extensions\":[\".yml\",\".yaml\"],\"defaultMimeType\":\"application/yaml\",\"acceptedMimeTypes\":[\"application/yaml\",\"text/yaml\",\"application/x-yaml\",\"text/x-yaml\"],\"readerProperties\":[{\"name\":\"maxEntityCount\",\"optional\":true,\"defaultValue\":1,\"description\":\"Sets the maximum number of entity expansions. The limit helps avoid Billion Laughs attacks.\",\"possibleValues\":[]}],\"writerProperties\":[{\"name\":\"writeDeclaration\",\"optional\":true,\"defaultValue\":true,\"description\":\"Indicates whether to write the header declaration or not.\",\"possibleValues\":[true,false]},{\"name\":\"encoding\",\"optional\":true,\"defaultValue\":\"UTF-8\",\"description\":\"The encoding to use for the output, such as UTF-8.\\n\",\"possibleValues\":[]},{\"name\":\"bufferSize\",\"optional\":true,\"defaultValue\":8192,\"description\":\"Size of the buffer writer, in bytes. The value must be greater than `8`.\\n\",\"possibleValues\":[]},{\"name\":\"skipNullOn\",\"optional\":true,\"defaultValue\":\"None\",\"description\":\"Skips `null` values in the specified data structure. By default, DataWeave does not skip the values.\\n\\n* `arrays` + Ignore and omit `null` values inside arrays from the YAML output, for example, with `output application/yaml skipNullOn=\\\"arrays\\\"`.\\n* `objects` + Ignore key-value pairs that have `null` as the value, for example, with `output application/yaml skipNullOn=\\\"objects\\\"`.\\n* `everywhere` + Apply `skipNullOn` to arrays and objects, for example, `output application/yaml skipNullOn=\\\"everywhere\\\"`.\\n\",\"possibleValues\":[\"arrays\",\"objects\",\"everywhere\"]},{\"name\":\"deferred\",\"optional\":true,\"defaultValue\":false,\"description\":\"Generates the output as a data stream when set to `true`, and defers the script's execution until the generated content is consumed.\\n\",\"possibleValues\":[true,false]}]},{\"name\":\"eventstream\",\"binary\":false,\"extensions\":[\".sse\",\".eventstream\"],\"defaultMimeType\":\"text/event-stream\",\"acceptedMimeTypes\":[\"text/event-stream\"],\"readerProperties\":[],\"writerProperties\":[{\"name\":\"bufferSize\",\"optional\":true,\"defaultValue\":8192,\"description\":\"Size of the buffer writer, in bytes. The value must be greater than `8`.\\n\",\"possibleValues\":[]},{\"name\":\"deferred\",\"optional\":true,\"defaultValue\":false,\"description\":\"Generates the output as a data stream when set to `true`, and defers the script's execution until the generated content is consumed.\\n\",\"possibleValues\":[true,false]}]},{\"name\":\"ndjson\",\"binary\":false,\"extensions\":[\".ndjson\",\