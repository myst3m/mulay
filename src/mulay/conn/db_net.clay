(ns mulay.conn.db_net
  (:require [mulay.db.sql :as sql] [mulay.db.pg :as pgd] [mulay.db.oracle :as orad] [mulay.db.mysql :as myd] [clay.postgres :as pg]))

(defn- no-net sql/DbErr [] (sql/->DbErr "The PostgreSQL, Oracle and MySQL drivers need sockets, which the wasm target does not have" "08001" 0 "java.sql.SQLException"))
(defn- no-outcome sql/Outcome [] (sql/->Outcome (sql/no-rows) 0 (sql/no-rows)))
(defn- no-counts Vec(Int) [] (let [z: Vec(Int) []] z))

(target-when "wasm"
(do
(defn pg-open Values(Vec(pg/Conn) sql/DbErr) [url: &Str user: &Str password: &Str] (let [z: Vec(pg/Conn) []] (values z (no-net))))
(defn pg-run Values(sql/Outcome sql/DbErr) [c: &pg/Conn text: &Str ps: &Vec(sql/Cell) keys: Bool key-cols: &Vec(Str)] (values (no-outcome) (no-net)))
(defn pg-run-batch Values(Vec(Int) sql/DbErr) [c: &pg/Conn text: &Str rows: &Vec(Vec(sql/Cell))] (values (no-counts) (no-net)))
(defn pg-run-script Values(Vec(Int) sql/DbErr) [c: &pg/Conn sqls: &Vec(Str) texts: &Vec(Str)] (values (no-counts) (no-net)))
(defn pg-close Int [c: &pg/Conn] 0)
(defn pg-call-proc Values(sql/SpResult sql/DbErr) [c: &pg/Conn text: &Str ps: &Vec(sql/SpParam)] (values (sql/no-sp) (no-net)))
(defn pg-cancel Str [c: &pg/Conn] "")
(defn ora-open Values(Vec(orad/Conn) sql/DbErr) [host: &Str port: Int service: &Str sid: &Str user: &Str password: &Str] (let [z: Vec(orad/Conn) []] (values z (no-net))))
(defn ora-run Values(sql/Outcome sql/DbErr orad/Conn) [c: &orad/Conn text: &Str ps: &Vec(sql/Cell) keys: Bool key-cols: &Vec(Str)] (values (no-outcome) (no-net) c))
(defn ora-run-batch Values(Vec(Int) sql/DbErr orad/Conn) [c: &orad/Conn text: &Str rows: &Vec(Vec(sql/Cell))] (values (no-counts) (no-net) c))
(defn ora-close Int [c: &orad/Conn] 0)
(defn ora-call-proc Values(sql/SpResult sql/DbErr orad/Conn) [c: &orad/Conn text: &Str ps: &Vec(sql/SpParam)] (values (sql/no-sp) (no-net) c))
(defn ora-open-query Values(orad/Query sql/DbErr orad/Conn) [c: &orad/Conn text: &Str ps: &Vec(sql/Cell)]
  (let [z: Vec(Str) [] y: Vec(Vec(sql/Cell)) []] (values (orad/->Query z [] 0 y true) (no-net) c)))
(defn ora-fetch-more Values(Vec(Vec(sql/Cell)) Bool sql/DbErr orad/Conn) [c: &orad/Conn q: &orad/Query prev: &Vec(sql/Cell) n: Int]
  (let [y: Vec(Vec(sql/Cell)) []] (values y true (no-net) c)))
(defn ora-finish Values(orad/Conn sql/DbErr) [c: &orad/Conn commit: Bool] (values c (no-net)))
(defn ora-cancel Str [c: &orad/Conn] "")
(defn my-open Values(Vec(myd/Conn) sql/DbErr) [host: &Str port: Int db: &Str user: &Str password: &Str kvs: &Vec(Str)] (let [z: Vec(myd/Conn) []] (values z (no-net))))
(defn my-run Values(sql/Outcome sql/DbErr) [c: &myd/Conn text: &Str ps: &Vec(sql/Cell) keys: Bool] (values (no-outcome) (no-net)))
(defn my-run-batch Values(Vec(Int) sql/DbErr) [c: &myd/Conn text: &Str rows: &Vec(Vec(sql/Cell))] (values (no-counts) (no-net)))
(defn my-run-script Values(Vec(Int) sql/DbErr) [c: &myd/Conn parts: &Vec(Str)] (values (no-counts) (no-net)))
(defn my-close Int [c: &myd/Conn] 0)
(defn my-call-proc Values(sql/SpResult sql/DbErr) [c: &myd/Conn text: &Str ps: &Vec(sql/SpParam)] (values (sql/no-sp) (no-net)))
(defn my-finish sql/DbErr [c: &myd/Conn commit: Bool] (no-net))
(defn my-begin sql/DbErr [c: &myd/Conn] (no-net)))
(do
(defn pg-open Values(Vec(pg/Conn) sql/DbErr) [url: &Str user: &Str password: &Str] (pgd/open url user password))
(defn pg-run Values(sql/Outcome sql/DbErr) [c: &pg/Conn text: &Str ps: &Vec(sql/Cell) keys: Bool key-cols: &Vec(Str)] (pgd/run c text ps keys key-cols))
(defn pg-run-batch Values(Vec(Int) sql/DbErr) [c: &pg/Conn text: &Str rows: &Vec(Vec(sql/Cell))] (pgd/run-batch c text rows))
(defn pg-run-script Values(Vec(Int) sql/DbErr) [c: &pg/Conn sqls: &Vec(Str) texts: &Vec(Str)] (pgd/run-script c sqls texts))
(defn pg-close Int [c: &pg/Conn] (pgd/close c))
(defn pg-call-proc Values(sql/SpResult sql/DbErr) [c: &pg/Conn text: &Str ps: &Vec(sql/SpParam)] (pgd/call-proc c text ps))
(defn pg-cancel Str [c: &pg/Conn] (pg/cancel c))
(defn ora-open Values(Vec(orad/Conn) sql/DbErr) [host: &Str port: Int service: &Str sid: &Str user: &Str password: &Str] (orad/open host port service sid user password))
(defn ora-run Values(sql/Outcome sql/DbErr orad/Conn) [c: &orad/Conn text: &Str ps: &Vec(sql/Cell) keys: Bool key-cols: &Vec(Str)] (orad/run c text ps keys key-cols))
(defn ora-run-batch Values(Vec(Int) sql/DbErr orad/Conn) [c: &orad/Conn text: &Str rows: &Vec(Vec(sql/Cell))] (orad/run-batch c text rows))
(defn ora-close Int [c: &orad/Conn] (orad/close c))
(defn ora-call-proc Values(sql/SpResult sql/DbErr orad/Conn) [c: &orad/Conn text: &Str ps: &Vec(sql/SpParam)] (orad/call-proc c text ps))
(defn ora-open-query Values(orad/Query sql/DbErr orad/Conn) [c: &orad/Conn text: &Str ps: &Vec(sql/Cell)] (orad/open-query c text ps))
(defn ora-fetch-more Values(Vec(Vec(sql/Cell)) Bool sql/DbErr orad/Conn) [c: &orad/Conn q: &orad/Query prev: &Vec(sql/Cell) n: Int] (orad/fetch-more c q prev n))
(defn ora-finish Values(orad/Conn sql/DbErr) [c: &orad/Conn commit: Bool] (orad/finish c commit))
(defn ora-cancel Str [c: &orad/Conn] (orad/cancel c))
(defn my-open Values(Vec(myd/Conn) sql/DbErr) [host: &Str port: Int db: &Str user: &Str password: &Str kvs: &Vec(Str)] (myd/open host port db user password kvs))
(defn my-run Values(sql/Outcome sql/DbErr) [c: &myd/Conn text: &Str ps: &Vec(sql/Cell) keys: Bool] (myd/run c text ps keys))
(defn my-run-batch Values(Vec(Int) sql/DbErr) [c: &myd/Conn text: &Str rows: &Vec(Vec(sql/Cell))] (myd/run-batch c text rows))
(defn my-run-script Values(Vec(Int) sql/DbErr) [c: &myd/Conn parts: &Vec(Str)] (myd/run-script c parts))
(defn my-close Int [c: &myd/Conn] (myd/close c))
(defn my-call-proc Values(sql/SpResult sql/DbErr) [c: &myd/Conn text: &Str ps: &Vec(sql/SpParam)] (myd/call-proc c text ps))
(defn my-finish sql/DbErr [c: &myd/Conn commit: Bool] (myd/finish c commit))
(defn my-begin sql/DbErr [c: &myd/Conn] (myd/begin c))))
