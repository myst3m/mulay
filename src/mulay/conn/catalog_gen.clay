"MS-VECTORS:STORE_NOT_FOUND" "MULE:VALIDATION" "MS-VECTORS:INVALID_FILE_FORMAT" "MULE:VALIDATION" "MS-VECTORS:SECURITY" "MULE:SECURITY" "WSC:EMPTY_RESPONSE" "WSC:BAD_RESPONSE" "WSC:CONNECTIVITY" "MULE:CONNECTIVITY" "WSC:RETRY_EXHAUSTED" "MULE:RETRY_EXHAUSTED" "SALESFORCE-COMPOSITE:CONNECTIVITY" "MULE:CONNECTIVITY" "SALESFORCE-COMPOSITE:INVALID_SESSION" "MULE:CONNECTIVITY" "SALESFORCE-COMPOSITE:TRANSFORMATION" "MULE:TRANSFORMATION" "SALESFORCE-COMPOSITE:VALIDATION" "MULE:VALIDATION" "SALESFORCE-COMPOSITE:RETRY_EXHAUSTED" "MULE:RETRY_EXHAUSTED" "SALESFORCE-PUB-SUB:CONNECTIVITY" "MULE:CONNECTIVITY" "SALESFORCE-PUB-SUB:INVALID_INPUT" "MULE:VALIDATION" "SALESFORCE-PUB-SUB:SECURITY" "MULE:SECURITY" "SALESFORCE-PUB-SUB:SERVER_ERROR" "MULE:CRITICAL" "SALESFORCE-PUB-SUB:FAULTY_RESPONSE" "MULE:ANY" "SALESFORCE-PUB-SUB:NOT_FOUND" "MULE:CONNECTIVITY" "SALESFORCE-PUB-SUB:TIMEOUT" "MULE:CONNECTIVITY" "SALESFORCE-PUB-SUB:LIMIT_EXCEEDED" "MULE:ANY" "SALESFORCE-PUB-SUB:MUTUAL_AUTHENTICATION_FAILED" "MULE:CONNECTIVITY" "SALESFORCE-PUB-SUB:RETRY_EXHAUSTED" "MULE:RETRY_EXHAUSTED" "ANYPOINT-MQ:ILLEGAL_MESSAGE_GROUP_ID" "ANYPOINT-MQ:PUBLISHING" "ANYPOINT-MQ:ILLEGAL_BODY" "ANYPOINT-MQ:PUBLISHING" "ANYPOINT-MQ:ILLEGAL_DELAY" "ANYPOINT-MQ:PUBLISHING" "ANYPOINT-MQ:TIMEOUT" "ANYPOINT-MQ:CONSUMING" "ANYPOINT-MQ:CONNECTIVITY" "MULE:CONNECTIVITY" "ANYPOINT-MQ:RETRY_EXHAUSTED" "MULE:RETRY_EXHAUSTED" "MUNIT-TOOLS:ASSERTION_ERROR" "MULE:ANY"])

