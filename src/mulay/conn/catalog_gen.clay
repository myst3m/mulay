(ns mulay.conn.catalog_gen (:require [mulay.mule.model :as m]))

(def CONNS [["http" "http://www.mulesoft.org/schema/mule/http"]
            ["grpc" "http://www.mulesoft.org/schema/mule/grpc"]
            ["os" "http://www.mulesoft.org/schema/mule/os"]
            ["file" "http://www.mulesoft.org/schema/mule/file"]
            ["mule-apikit" "http://www.mulesoft.org/schema/mule/mule-apikit"]
            ["salesforce" "http://www.mulesoft.org/schema/mule/salesforce"]
            ["db" "http://www.mulesoft.org/schema/mule/db"]
            ["vm" "http://www.mulesoft.org/schema/mule/vm"]
            ["a2a" "http://www.mulesoft.org/schema/mule/a2a"]
            ["sftp" "http://www.mulesoft.org/schema/mule/sftp"]
            ["mcp" "http://www.mulesoft.org/schema/mule/mcp"]
            ["jmx" "http://www.mulesoft.org/schema/mule/jmx"]
            ["ms-inference" "http://www.mulesoft.org/schema/mule/ms-inference"]
            ["validation" "http://www.mulesoft.org/schema/mule/validation"]
            ["ms-vectors" "http://www.mulesoft.org/schema/mule/ms-vectors"]
            ["wsc" "http://www.mulesoft.org/schema/mule/wsc"]
            ["salesforce-composite" "http://www.mulesoft.org/schema/mule/salesforce-composite"]
            ["salesforce-pub-sub" "http://www.mulesoft.org/schema/mule/salesforce-pub-sub"]
            ["anypoint-mq" "http://www.mulesoft.org/schema/mule/anypoint-mq"]
            ["munit" "http://www.mulesoft.org/schema/mule/munit"]
            ["munit-tools" "http://www.mulesoft.org/schema/mule/munit-tools"]])

(defn hints m/Hints []
  (m/->Hints ["http://www.mulesoft.org/schema/mule/grpc"]
             ["http://www.mulesoft.org/schema/mule/grpc unary-method" "http://www.mulesoft.org/schema/mule/grpc server-streaming-method" "http://www.mulesoft.org/schema/mule/grpc client-streaming-method" "http://www.mulesoft.org/schema/mule/grpc bidirectional-streaming-method" "http://www.mulesoft.org/schema/mule/grpc bidi-streaming-listener" "http://www.mulesoft.org/schema/mule/grpc server-streaming-delegated-listener" "http://www.mulesoft.org/schema/mule/grpc server-streaming-subscriber-source"]
             [(m/->OpChains "http://www.mulesoft.org/schema/mule/a2a send-stream-message" ["on-task-status-update" "on-task-artifact-update"]) (m/->OpChains "http://www.mulesoft.org/schema/mule/a2a task-resubscribe" ["on-task-status-update" "on-task-artifact-update"])]
             ["http://www.mulesoft.org/schema/mule/validation all" "http://www.mulesoft.org/schema/mule/validation any"]
             ["http://www.mulesoft.org/schema/mule/http polling-source"]
             ["MunitTools" "%dw 2.0\n\nfun matcherOf(kind: String, xs: Array) = {\"type\": kind, expected: xs, munitMatcher: true}\nfun isMatcher(x) = (x is Object) and ((x.munitMatcher default false) == true)\nfun asMatcher(x) = if (isMatcher(x)) x else equalTo(x)\n\nfun equalTo(value, config = {}) = matcherOf(\"equalTo\", [value, config])\nfun not(m) = matcherOf(\"not\", [asMatcher(m)])\nfun notNullValue() = matcherOf(\"notNullValue\", [])\nfun nullValue() = matcherOf(\"nullValue\", [])\nfun both(m1, m2) = matcherOf(\"both\", [m1, m2])\nfun either(m1, m2) = matcherOf(\"either\", [m1, m2])\nfun withEncoding(encoding = null) = matcherOf(\"withEncoding\", [encoding])\nfun withMediaType(mediaType) = matcherOf(\"withMediaType\", [mediaType])\nfun allOf(ms) = matcherOf(\"allOf\", ms)\nfun anyOf(ms) = matcherOf(\"anyOf\", ms)\nfun matches(regex) = matcherOf(\"matches\", [regex])\nfun containsString(value) = matcherOf(\"containsString\", [value])\nfun startsWith(prefix) = matcherOf(\"startsWith\", [prefix])\nfun endsWith(suffix) = matcherOf(\"endsWith\", [suffix])\nfun isEmptyString() = matcherOf(\"isEmptyString\", [])\nfun isEmptyOrNullString() = matcherOf(\"isEmptyOrNullString\", [])\nfun equalToIgnoringCase(value) = matcherOf(\"equalToIgnoringCase\", [value])\nfun equalToIgnoringWhiteSpace(value) = matcherOf(\"equalToIgnoringWhiteSpace\", [value])\nfun stringContainsInOrder(values) = matcherOf(\"stringContainsInOrder\", [values])\nfun greaterThan(value) = matcherOf(\"greaterThan\", [value])\nfun greaterThanOrEqualTo(value) = matcherOf(\"greaterThanOrEqualTo\", [value])\nfun lessThan(value) = matcherOf(\"lessThan\", [value])\nfun lessThanOrEqualTo(value) = matcherOf(\"lessThanOrEqualTo\", [value])\nfun closeTo(value, error) = matcherOf(\"closeTo\", [value, error])\nfun everyItem(m) = matcherOf(\"everyItem\", [m])\nfun hasItem(m) = matcherOf(\"hasItem\", [asMatcher(m)])\nfun hasSize(m) = matcherOf(\"hasSize\", [asMatcher(m)])\nfun isEmpty() = matcherOf(\"isEmpty\", [])\nfun hasKey(m) = matcherOf(\"hasKey\", [asMatcher(m)])\nfun hasValue(m) = matcherOf(\"hasValue\", [asMatcher(m)])\nfun getResourceAsString(path, encoding = null) = readUrl(\"classpath://\" ++ path, \"text/plain\") as String\n"]))

