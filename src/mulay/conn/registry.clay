(ns mulay.conn.registry
  (:require [mulay.rt.conn :as conn] [mulay.mule.model :as m] [mulay.conn.grpc :as grpc] [mulay.conn.http :as http] [mulay.conn.os :as os] [mulay.conn.file :as file]
            [mulay.conn.apikit :as apikit] [mulay.conn.salesforce :as salesforce] [mulay.conn.db :as db] [mulay.conn.vm :as vm] [mulay.conn.a2a :as a2a] [mulay.conn.sftp :as sftp] [mulay.conn.mcp_client :as mcpc] [mulay.conn.jmx :as jmx] [mulay.conn.inference :as inf] [mulay.conn.validation :as val] [mulay.conn.vectors :as vectors] [mulay.conn.wsc :as wsc] [mulay.conn.sf_composite :as sfc] [mulay.conn.sf_pubsub :as sfps] [mulay.conn.anypoint_mq :as amq] [mulay.conn.munit :as munit]))

(defn all Vec(conn/Connector) []
  [(http/connector) (grpc/connector) (os/connector) (file/connector) (apikit/connector) (salesforce/connector) (db/connector) (vm/connector) (a2a/connector) (sftp/connector) (mcpc/connector) (jmx/connector) (inf/connector) (val/connector) (vectors/connector) (wsc/connector) (sfc/connector) (sfps/connector) (amq/connector) (munit/munit-connector) (munit/tools-connector)])

(defn hints m/Hints [] (conn/parse-hints (all)))

