(ns mulay.db.sql)

(defvariant Cell
  (CNull)
  (CInt i: Int)
  (CLong i: Int)
  (CDouble f: Float)
  (CFloat s: Str)
  (CDecimal s: Str)
  (CStr s: Str)
  (CBytes b: Str)
  (CBool b: Bool)
  (CDate s: Str)
  (CTimestamp s: Str)
  (CBigInt s: Str)
  (CLdt s: Str)
  (CTime s: Str)
  (CZoned s: Str)
  (CDatum cls: Str bytes: Str zone: Str)
  (CClob s: Str))

(defrecord Rows [cols: Vec(Str) rows: Vec(Vec(Cell))])

(defn no-rows Rows [] (->Rows [] []))

(defrecord Outcome [rows: Rows count: Int keys: Rows])

(defrecord DbErr [msg: Str state: Str code: Int exc: Str])

(defn ok-err DbErr [] (->DbErr "" "" 0 ""))
(defn ok? Bool [e: &DbErr] (= (:msg e) ""))

(def IN 0)
(def OUT 1)
(def INOUT 2)

(defrecord SpParam [name: Str dir: Int value: Cell type: Str])

(defvariant SpVal (SpCell c: Cell) (SpRows r: Rows))

(defrecord SpResult [rsets: Vec(Rows) counts: Vec(Int) names: Vec(Str) vals: Vec(SpVal)])

(defn no-sp SpResult [] (->SpResult [] [] [] []))
