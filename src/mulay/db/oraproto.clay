(defn- wvec Str [out: Str xs: &Vec(Int)] (loop [i 0 o out] (if (>= i (count xs)) o (recur (+ i 1) (w/w8 o (nth xs i))))))

(defn- zeros Str [out: Str n: Int] (loop [i 0 o out] (if (>= i n) o (recur (+ i 1) (w/w8 o 0)))))

(defn connect-packets Str [desc: &Str]
  (let [n (count desc)
        o1 (w/w16 (w/w16 "" 319) 300)
        o2 (w/w16 (w/w16 (w/w16 o1 3073) 8192) 8192)
        o3 (w/w16 (w/w16 (w/w16 o2 20376) 0) 1)
        o4 (w/w32 (w/w16 (w/w16 o3 n) 74) 0)
        o5 (zeros (w/w8 (w/w8 o4 132) 132) 24)
        o6 (w/w32 (w/w32 (w/w32 (w/w32 o5 8192) 8192) 0) 1)]
    (if (<= n 230) (w/packet w/T-CONNECT 0 (str o6 desc) false)
      (let [cp (w/packet w/T-CONNECT 0 o6 false)
            dp (w/packet w/T-DATA 0 (str (w/w16 "" 0) desc) false)]
        (str cp dp)))))

(defn- fn-head Str [code: Int seq: Int fv: Int]
  (let [o (w/w8 (w/w8 (w/w8 "" 3) code) seq)] (if (>= fv 19) (w/wub o 0) o)))

(defn- protocol-req Str [out: Str] (let [o (w/w8 (w/w8 (w/w8 out 1) 6) 0)] (w/w8 (str o "mulay") 0)))

(defn- data-types-req Str [out: Str eor: Bool]
  (let [o1 (w/w16le (w/w16le (w/w8 out 2) CHARSET-UTF8) CHARSET-UTF8)
        o2 (w/w8 o1 3)
        caps (if eor (assoc CCAPS 40 (bit-or (nth CCAPS 40) 32)) CCAPS)
        o3 (wvec (w/w8 o2 (count caps)) caps)
        o4 (wvec (w/w8 o3 (count RCAPS)) RCAPS)
        o5 (loop [i 0 o o4]
             (if (>= i (count DATA-TYPES)) o
               (let [dt (nth DATA-TYPES i) conv (nth DATA-TYPES (+ i 1)) rep (nth DATA-TYPES (+ i 2))]
                 (recur (+ i 3) (w/w16 (w/w16 (w/w16 (w/w16 o dt) conv) rep) 0)))))]
    (w/w16 o5 0)))

(defn- auth-body Str [out: Str user: &Str mode: Int pairs: &Vec(Vec(Str))]
  (let [o1 (w/wub (w/w8 out (if (> (count user) 0) 1 0)) (count user))
        o2 (w/wub (w/w8 (w/wub o1 mode) 1) (count pairs))
        o3 (w/w8 (w/w8 o2 1) 1)
        o4 (if (> (count user) 0) (w/wbytes o3 user) o3)]
    (loop [i 0 o o4]
      (if (>= i (count pairs)) o
        (let [p (nth pairs i)
              [fl fe] (parse-long (nth p 2))]
          (recur (+ i 1) (w/wub (w/wbytes2 (w/wbytes2 o (nth p 0)) (nth p 1)) fl)))))))

(defn fast-auth Str [user: &Str program: &Str machine: &Str pid: &Str os-user: &Str eor: Bool]
  (let [o1 (w/w8 (w/w8 (w/w8 (w/w8 "" 34) 1) 1) 0)
        o2 (protocol-req o1)
        o3 (w/w8 (w/w16 (w/w8 (w/w16 o2 0) 0) 0) 13)
        o4 (data-types-req o3 eor)
        o5 (fn-head FN-AUTH1 1 13)]
    (auth-body (str o4 o5) user 1
               [["AUTH_TERMINAL" "unknown" "0"] ["AUTH_PROGRAM_NM" (str program) "0"] ["AUTH_MACHINE" (str machine) "0"]
                ["AUTH_PID" (str pid) "0"] ["AUTH_SID" (str os-user) "0"]])))

(defn auth2 Str [seq: Int fv: Int user: &Str pairs: &Vec(Vec(Str))]
  (auth-body (fn-head FN-AUTH2 seq fv) user 257 pairs))

(defn fetch Str [seq: Int fv: Int cursor: Int n: Int] (w/wub (w/wub (fn-head FN-FETCH seq fv) cursor) n))

(defn simple Str [seq: Int fv: Int code: Int] (fn-head code seq fv))

(defn close-cursors Str [seq: Int fv: Int ids: &Vec(Int)]
  (let [o1 (w/w8 (w/w8 (w/w8 "" 17) FN-CLOSE-CURSORS) seq)
        o2 (if (>= fv 19) (w/wub o1 0) o1)
        o3 (w/wub (w/w8 o2 1) (count ids))]
    (loop [i 0 o o3] (if (>= i (count ids)) o (recur (+ i 1) (w/wub o (nth ids i)))))))

(defn lob-read Str [seq: Int fv: Int locator: &Str offset: Int amount: Int]
  (let [o1 (w/wub (w/w8 (fn-head FN-LOB-OP seq fv) 1) (count locator))
        o2 (w/wub (w/w8 o1 0) 0)
        o3 (w/wub (w/wub o2 0) 0)
        o4 (w/w8 (w/w8 (w/w8 o3 0) 0) 0)
        o5 (w/w8 (w/w8 (w/wub o4 2) 0) 0)
        o6 (w/w8 (w/wub (w/wub o5 offset) 0) 1)
        o7 (w/w16 (w/w16 (w/w16 o6 0) 0) 0)]
    (w/wub (str o7 locator) amount)))

(defrecord Bind [typ: Int csfrm: Int size: Int])
(defrecord Exec [options: Int cursor: Int sql: Str query: Bool iters: Int
                 binds: Vec(Bind) rows: Vec(Str) defs: Vec(Bind) dml: Int])

(defn- meta Str [out: Str b: &Bind cont: Int]
  (let [o1 (w/w8 (w/w8 (w/w8 (w/w8 out (:typ b)) 1) 0) 0)
        o2 (w/wub (w/wub (w/wub o1 (:size b)) 0) cont)
        o3 (w/wub (w/wub (w/wub o2 0) 0) (if (= (:csfrm b) 0) 0 CHARSET-UTF8))
        o4 (w/wub (w/w8 o3 (:csfrm b)) 0)]
    (w/wub o4 0)))

(defn execute Str [seq: Int fv: Int ex: &Exec]
  (let [cursor (:cursor ex)
        with-sql (> (count (:sql ex)) 0)
        nb (count (:binds ex))
        nd (count (:defs ex))
        o1 (w/wub (w/wub (fn-head FN-EXECUTE seq fv) (:options ex)) cursor)
        o2 (if with-sql (w/wub (w/w8 o1 1) (count (:sql ex))) (w/wub (w/w8 o1 0) 0))
        o3 (w/w8 (w/w8 (w/wub (w/w8 o2 1) 13) 0) 0)
        o4 (w/wub (w/wub (w/wub o3 0) (if (:query ex) (:iters ex) 1)) 2147483647)
        o5 (if (> nb 0) (w/wub (w/w8 o4 1) nb) (w/wub (w/w8 o4 0) 0))
        o6 (zeros o5 5)
        o7 (if (> nd 0) (w/wub (w/w8 o6 1) nd) (w/wub (w/w8 o6 0) 0))
        o8 (w/wub (w/w8 (w/w8 (w/w8 (w/wub o7 0) 0) 1) 0) 0)
        o9 (w/wub (w/wub (w/w8 o8 0) 0) 0)
        rc (= (bit-and (:dml ex) DML-ROWCOUNTS) DML-ROWCOUNTS)
        o10 (if rc (w/w8 (w/wub (w/w8 o9 1) (:iters ex)) 1) (w/w8 (w/wub (w/w8 o9 0) 0) 0))
        o11 (if (>= fv 8) (w/w8 (w/wub (w/w8 (w/wub (w/w8 o10 0) 0) 0) 0) 0) o10)
        o12 (if (>= fv 9) (w/wub (w/w8 o11 0) 0) o11)
        o13 (if with-sql (w/wub (w/wbytes o12 (:sql ex)) 1) (w/wub o12 0))
        o14 (w/wub o13 (if (:query ex) (if (= cursor 0) 0 (:iters ex)) (:iters ex)))
        o15 (zeros o14 5)
        o16 (w/wub (w/wub (w/wub o15 (if (:query ex) 1 0)) 0) (cond (not= (:dml ex) 0) (:dml ex) with-sql 32768 :else 0))
        o17 (zeros o16 3)]
    (cond
      (> nd 0) (loop [i 0 o o17] (if (>= i nd) o (recur (+ i 1) (meta o (nth (:defs ex) i) (if (or (= (:typ (nth (:defs ex) i)) T-CLOB) (= (:typ (nth (:defs ex) i)) T-BLOB)) 33554432 0)))))
      (> nb 0) (let [om (loop [i 0 o o17] (if (>= i nb) o (recur (+ i 1) (meta o (nth (:binds ex) i) 0))))]
                 (loop [r 0 o om] (if (>= r (count (:rows ex))) o (recur (+ r 1) (str (w/w8 o 7) (nth (:rows ex) r))))))
      :else o17)))

(defn parse-accept Values(Int Int Int Str) [pk: &Str]
  (let [[ver p1] (w/r16 pk 8)
        [fl1 p2] (w/r8 pk 22)
        [sdu p3] (w/r32 pk 32)
        [fl2 p4] (if (>= ver 318) (w/r32 pk 41) (values 0 p3))]
    (cond
      (< p4 0) (values 0 0 0 "short ACCEPT packet")
      (< ver 315) (values ver sdu fl2 (str "server protocol version " ver " is not supported"))
      (not= (bit-and fl1 16) 0) (values ver sdu fl2 "the server requires native network encryption")
      :else (values ver sdu fl2 ""))))

(defn accept-options Int [pk: &Str] (let [[o p] (w/r16 pk 10)] (if (< p 0) 0 o)))

(defn refuse-text Str [pk: &Str]
  (let [[n p] (w/r16 pk 10)]
    (if (or (< p 0) (> (+ 12 n) (count pk))) "" (subs pk 12 (+ 12 n)))))

(defrecord Col [name: Str typ: Int csfrm: Int prec: Int scale: Int size: Int nullable: Bool])

(defrecord Lob [row: Int col: Int locator: Str size: Int blob: Bool])

(defrecord Cur [index: Int cursor: Int cols: Vec(Col)])

(defrecord Resp [fv: Int params: Vec(Str) vfr: Int
                 cols: Vec(Col) rows: Vec(Vec(sql/Cell)) lobs: Vec(Lob) bitvec: Str
                 errnum: Int errmsg: Str errpos: Int cursor: Int rowcount: Int rowid: Str
                 lobdata: Str done: Bool flush: Bool
                 dirs: Vec(Int) outs: Vec(sql/Cell) curs: Vec(Cur) counts: Vec(Int)])

(defrecord Ctx [fv: Int eor: Bool mode: Int cols: Vec(Col) prev: Vec(sql/Cell) loclen: Int binds: Vec(Bind) counts: Bool])

(defn new-resp Resp [fv: Int cols: Vec(Col)]
  (->Resp fv [] 0 cols [] [] "" 0 "" 0 0 0 "" "" false false [] [] [] []))

(defn- with-done Resp [r: &Resp done: Bool flush: Bool]
  (->Resp (:fv r) (:params r) (:vfr r) (:cols r) (:rows r) (:lobs r) (:bitvec r)
          (:errnum r) (:errmsg r) (:errpos r) (:cursor r) (:rowcount r) (:rowid r)
          (:lobdata r) done flush (:dirs r) (:outs r) (:curs r) (:counts r)))

(defn- read-protocol Values(Int Int) [b: &Str p0: Int]
  (let [[v p1] (w/r8 b p0)
        [z p2] (w/r8 b p1)
        [banner p3] (w/rcstr b p2)
        [cs p4] (w/r16le b p3)
        [fl p5] (w/r8 b p4)
        [n p6] (w/r16le b p5)
        p7 (if (< p6 0) p6 (let [[x q] (w/rraw b p6 (* n 5))] q))
        [fdo p8] (w/r16 b p7)
        p9 (if (< p8 0) p8 (let [[x q] (w/rraw b p8 fdo)] q))
        [ccaps p10 cn] (w/rbytes b p9)
        [rcaps p11 rn] (w/rbytes b p10)]
    (if (< p11 0) (values 0 p11)
      (values (if (> (count ccaps) 7) (if (< (nth ccaps 7) 24) (nth ccaps 7) 24) 24) p11))))

(defn- read-data-types Int [b: &Str p0: Int]
  (loop [p p0]
    (let [[dt p1] (w/r16 b p)]
      (cond (< p1 0) p1
            (= dt 0) p1
            :else (let [[conv p2] (w/r16 b p1)]
                    (cond (< p2 0) p2
                          (= conv 0) (recur p2)
                          :else (let [[x p3] (w/rraw b p2 4)] (recur p3))))))))

(defn- read-auth-params Values(Vec(Str) Int Int) [b: &Str p0: Int acc0: Vec(Str) vfr0: Int]
  (let [[n p1] (w/rub2 b p0)]
    (loop [i 0 p p1 acc acc0 vfr vfr0]
      (if (or (< p 0) (>= i n)) (values acc vfr p)
        (let [[k pk] (w/rbytes2 b p)
              [v pv] (w/rbytes2 b pk)
              [fl pf] (w/rub4 b pv)]
          (recur (+ i 1) pf (conj (conj acc k) v) (if (= k "AUTH_VFR_DATA") fl vfr)))))))

(defn- skip-exec-params Int [b: &Str p0: Int]
  (let [[n1 p1] (w/rub2 b p0)
        p2 (loop [i 0 p p1] (if (or (< p 0) (>= i n1)) p (let [[x q] (w/rub4 b p)] (recur (+ i 1) q))))
        [n2 p3] (w/rub2 b p2)
        p4 (if (< p3 0) p3 (let [[x q] (w/rraw b p3 n2)] q))
        [n3 p5] (w/rub2 b p4)
        p6 (loop [i 0 p p5]
             (if (or (< p 0) (>= i n3)) p
               (let [[l1 q1] (w/rub2 b p)
                     q2 (if (> l1 0) (w/skip-bytes b q1) q1)
                     [l2 q3] (w/rub2 b q2)
                     q4 (if (> l2 0) (w/skip-bytes b q3) q3)
                     [kw q5] (w/rub2 b q4)]
                 (recur (+ i 1) q5))))
        [n4 p7] (w/rub2 b p6)]
    (if (< p7 0) p7 (let [[x q] (w/rraw b p7 n4)] q))))

(defn- read-exec-params Values(Vec(Int) Int) [b: &Str p0: Int counts: Bool]
  (let [p (skip-exec-params b p0)]
    (if (or (< p 0) (not counts)) (values [] p)
      (let [[n p1] (w/rub4 b p)]
        (loop [i 0 q p1 acc: Vec(Int) []]
          (if (or (< q 0) (>= i n)) (values acc q)
            (let [[x q2] (w/rub8 b q)] (recur (+ i 1) q2 (conj acc x)))))))))

(def B64 "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")

(defn- b64-digits Str [out: Str x: Int n: Int]
  (loop [i (- n 1) o out] (if (< i 0) o (let [d (bit-and (bit-shift-right x (* 6 i)) 63)] (recur (- i 1) (str o (subs B64 d (+ d 1))))))))

(defn rowid-str Str [rba: Int part: Int block: Int slot: Int]
  (if (and (= rba 0) (= part 0) (= block 0) (= slot 0)) ""
    (let [o1 (b64-digits "" rba 6) o2 (b64-digits o1 part 3) o3 (b64-digits o2 block 6)] (b64-digits o3 slot 3))))

(defn- read-rowid Values(Str Int) [b: &Str p0: Int]
  (let [[rba p1] (w/rub4 b p0)
        [part p2] (w/rub2 b p1)
        [z p3] (w/r8 b p2)
        [block p4] (w/rub4 b p3)
        [slot p5] (w/rub2 b p4)]
    (values (rowid-str rba part block slot) p5)))

(defn- skip-batch Int [b: &Str p0: Int w4: Bool]
  (let [[n p1] (if w4 (w/rub4 b p0) (w/rub2 b p0))]
    (if (or (< p1 0) (= n 0)) p1
      (let [[first p2] (w/r8 b p1)
            p3 (loop [i 0 p p2]
                 (if (or (< p 0) (>= i n)) p
                   (let [q (if (= first 254) (let [[x q0] (w/rub4 b p)] q0) p)
                         [y q1] (if w4 (w/rub4 b q) (w/rub2 b q))]
                     (recur (+ i 1) q1))))]
        (if (= first 254) (let [[x q] (w/r8 b p3)] q) p3)))))

(defn- read-error Values(Resp Int) [b: &Str p0: Int r: &Resp fv: Int]
  (let [[cs p1] (w/rub4 b p0)
        [x1 p2] (w/rub2 b p1)
        [x2 p3] (w/rub4 b p2)
        [x3 p4] (w/rub2 b p3)
        [x4 p5] (w/rub2 b p4)
        [x5 p6] (w/rub2 b p5)
        [cursor p7] (w/rub2 b p6)
        [pos p8] (w/rsb b p7 2)
        [x6 p9] (w/rraw b p8 5)
        [x7 p10] (w/r8 b p9)
        [rowid p11] (read-rowid b p10)
        [x8 p12] (w/rub4 b p11)
        [x9 p13] (w/rraw b p12 2)
        [x10 p14] (w/rub2 b p13)
        [x11 p15] (w/rub4 b p14)
        p16 (let [[s q] (w/rbytes2 b p15)] q)
        p17 (skip-batch b p16 false)
        p18 (skip-batch b p17 true)
        [nm p19] (w/rub2 b p18)
        p20 (if (or (< p19 0) (= nm 0)) p19
              (let [[z q0] (w/r8 b p19)]
                (loop [i 0 q q0]
                  (if (or (< q 0) (>= i nm)) q
                    (let [[y q1] (w/rub2 b q) q2 (w/skip-bytes b q1) [z2 q3] (w/rraw b q2 2)] (recur (+ i 1) q3))))))
        [num p21] (w/rub4 b p20)
        [rows p22] (w/rub8 b p21)
        p23 (if (>= fv 14) (let [[a q1] (w/rub4 b p22) [c q2] (w/rub4 b q1)] q2) p22)
        [msg p24 mnull] (if (and (>= p23 0) (not= num 0)) (w/rbytes b p23) (values "" p23 true))]
    (values (->Resp (:fv r) (:params r) (:vfr r) (:cols r) (:rows r) (:lobs r) (:bitvec r)
                    num msg pos (if (> cursor 0) cursor (:cursor r)) rows rowid
                    (:lobdata r) (:done r) (:flush r) (:dirs r) (:outs r) (:curs r) (:counts r))
            p24)))

(defn- read-col Values(Col Int) [b: &Str p0: Int fv: Int]
  (let [[typ p1] (w/r8 b p0)
        [fl p2] (w/r8 b p1)
        [prec0 p3] (w/r8 b p2)
        [scale0 p4] (w/r8 b p3)
        [size p5] (w/rub4 b p4)
        [x1 p6] (w/rub4 b p5)
        [x2 p7] (w/rub8 b p6)
        [oid p8] (w/rbytes2 b p7)
        [x3 p9] (w/rub2 b p8)
        [x4 p10] (w/rub2 b p9)
        [csfrm p11] (w/r8 b p10)
        [maxsz p12] (w/rub4 b p11)
        p13 (if (>= fv 8) (let [[x q] (w/rub4 b p12)] q) p12)
        [nulls p14] (w/r8 b p13)
        [x5 p15] (w/r8 b p14)
        [name p16] (w/rbytes2 b p15)
        [schema p17] (w/rbytes2 b p16)
        [tname p18] (w/rbytes2 b p17)
        [x6 p19] (w/rub2 b p18)
        [uds p20] (w/rub4 b p19)
        p21 (if (>= fv 17) (let [[a q1] (w/rbytes2 b p20) [c q2] (w/rbytes2 b q1)] q2) p20)
        p22 (if (>= fv 20)
              (let [[n q1] (w/rub4 b p21)]
                (if (or (< q1 0) (= n 0)) q1
                  (let [[z q2] (w/r8 b q1)
                        [n2 q3] (w/rub4 b q2)
                        [z2 q4] (w/r8 b q3)
                        q5 (loop [i 0 q q4]
                             (if (or (< q 0) (>= i n2)) q
                               (let [[k qa] (w/rbytes2 b q) [v qb] (w/rbytes2 b qa) [f qc] (w/rub4 b qb)] (recur (+ i 1) qc))))
                        [f2 q6] (w/rub4 b q5)]
                    q6)))
              p21)
        p23 (if (>= fv 24) (let [[a q1] (w/rub4 b p22) [c q2] (w/r8 b q1) [d q3] (w/r8 b q2)] q3) p22)]
    (values (->Col name typ csfrm (if (> prec0 127) (- prec0 256) prec0) (if (> scale0 127) (- scale0 256) scale0) size (not= nulls 0))
            p23)))

(defn- read-describe Values(Vec(Col) Int) [b: &Str p0: Int fv: Int]
  (read-describe-body b (w/skip-bytes b p0) fv))

(defn- read-describe-body Values(Vec(Col) Int) [b: &Str p1: Int fv: Int]
  (let [[x1 p2] (w/rub4 b p1)
        [n p3] (w/rub4 b p2)
        p4 (if (and (>= p3 0) (> n 0)) (let [[z q] (w/r8 b p3)] q) p3)
        [cols p5] (loop [i 0 p p4 acc: Vec(Col) []]
                    (if (or (< p 0) (>= i n)) (values acc p)
                      (let [[c q] (read-col b p fv)] (recur (+ i 1) q (conj acc c)))))
        [d1 p6] (w/rbytes2 b p5)
        [x2 p7] (w/rub4 b p6)
        [x3 p8] (w/rub4 b p7)
        [x4 p9] (w/rub4 b p8)
        [x5 p10] (w/rub4 b p9)
        [d2 p11] (w/rbytes2 b p10)]
    (values cols p11)))

(defn- pad2 Str [n: Int] (if (< n 10) (str "0" n) (str n)))
(defn- pad4 Str [n: Int] (cond (< n 10) (str "000" n) (< n 100) (str "00" n) (< n 1000) (str "0" n) :else (str n)))

(defn- frac-str Str [nanos: Int]
  (if (= nanos 0) ""
    (let [s (str nanos)
          s9 (str (loop [i (count s) o ""] (if (>= i 9) o (recur (+ i 1) (str o "0")))) s)
          e (loop [k 9] (if (and (> k 0) (= (nth s9 (- k 1)) 48)) (recur (- k 1)) k))]
      (str "." (subs s9 0 e)))))

(defn date-str Str [v: &Str]
  (if (< (count v) 7) ""
    (let [year (+ (* (- (nth v 0) 100) 100) (- (nth v 1) 100))
          nanos (if (>= (count v) 11) (let [[n p] (w/r32 v 7)] n) 0)]
      (str (pad4 year) "-" (pad2 (nth v 2)) "-" (pad2 (nth v 3)) "T"
           (pad2 (- (nth v 4) 1)) ":" (pad2 (- (nth v 5) 1)) ":" (pad2 (- (nth v 6) 1)) (frac-str nanos)))))

(defn- num-at Int [s: &Str a: Int b: Int] (if (> b (count s)) 0 (let [[n e] (parse-long (subs s a b))] n)))

(defn date-bytes Str [s: &Str with-frac: Bool]
  (let [year (num-at s 0 4)
        o1 (w/w8 (w/w8 "" (+ (/ year 100) 100)) (+ (mod year 100) 100))
        o2 (w/w8 (w/w8 o1 (num-at s 5 7)) (num-at s 8 10))
        o3 (w/w8 (w/w8 (w/w8 o2 (+ (num-at s 11 13) 1)) (+ (num-at s 14 16) 1)) (+ (num-at s 17 19) 1))
        frac (if (and (> (count s) 20) (= (nth s 19) 46)) (subs s 20 (count s)) "")
        f9 (loop [f frac] (if (>= (count f) 9) (subs f 0 9) (recur (str f "0"))))
        [nanos ne] (parse-long f9)]
    (if (and with-frac (> nanos 0)) (w/w32 o3 nanos) o3)))

(defn- ieee-bytes Str [v: &Str]
  (if (= (count v) 0) ""
    (if (>= (nth v 0) 128)
      (str (chr (bit-and (nth v 0) 127)) (subs v 1 (count v)))
      (loop [i 0 o ""] (if (>= i (count v)) o (recur (+ i 1) (str o (chr (bit-xor (nth v i) 255)))))))))

(defn- bits Int [v: &Str] (loop [i 0 acc 0] (if (>= i (count v)) acc (recur (+ i 1) (+ (* acc 256) (nth v i))))))

(defn double-of Float [v: &Str] (ie/bits->double (bits (ieee-bytes v))))

(defn float-of Float [v: &Str] (ie/bits->float32 (bits (ieee-bytes v))))

(defn- text-of Str [v: &Str csfrm: Int]
  (if (= csfrm 2) (let [[t e] (ccs/decode v "UTF-16BE" false)] t) (str v)))

(defn tz-name Str [v: &Str]
  (cond
    (< (count v) 13) ""
    (not= (bit-and (nth v 11) 128) 0)
    (let [id (bit-or (bit-shift-left (bit-and (nth v 11) 127) 6) (bit-shift-right (nth v 12) 2))]
      (let [k (str id)] (if (contains? oz/ZONES k) (get! oz/ZONES k) "")))
    :else
    (let [h (- (nth v 11) 20) m (- (nth v 12) 60)
          neg (or (< h 0) (< m 0))
          ah (if (< h 0) (- 0 h) h) am (if (< m 0) (- 0 m) m)]
      (if (and (= h 0) (= m 0)) "GMT" (str "GMT" (if neg "-" "+") (pad2 ah) ":" (pad2 am))))))

(defn- cell-of sql/Cell [c: &Col v: &Str]
  (let [t (:typ c)]
    (cond
      (or (= t T-VARCHAR) (= t T-CHAR) (= t T-LONG)) (sql/->CStr (text-of v (:csfrm c)))
      (or (= t T-NUMBER) (= t T-BINARY-INTEGER)) (let [[d e] (on/decode v)] (sql/->CDecimal d))
      (= t T-DATE) (sql/->CTimestamp (date-str v))
      (or (= t T-TIMESTAMP) (= t T-TIMESTAMP-LTZ)) (sql/->CDatum "oracle.sql.TIMESTAMP" v "")
      (= t T-TIMESTAMP-TZ) (sql/->CDatum "oracle.sql.TIMESTAMPTZ" v (tz-name v))
      (or (= t T-RAW) (= t T-LONG-RAW)) (sql/->CBytes v)
      (= t T-BINARY-DOUBLE) (sql/->CDouble (double-of v))
      (= t T-BINARY-FLOAT) (sql/->CFloat (dec/float32->shortest-str (float-of v)))
      (= t T-BOOLEAN) (sql/->CBool (and (> (count v) 0) (= (nth v (- (count v) 1)) 1)))
      :else (sql/->CStr v))))

(defn- bit-set? Bool [bv: &Str i: Int]
  (if (= (count bv) 0) true
    (let [k (/ i 8)] (if (>= k (count bv)) true (not= (bit-and (nth bv k) (bit-shift-left 1 (mod i 8))) 0)))))

(defn- read-row Values(Vec(sql/Cell) Vec(Lob) Int) [b: &Str p0: Int cols: &Vec(Col) bv: &Str prev: &Vec(sql/Cell) rowno: Int lobs0: Vec(Lob)]
  (loop [i 0 p p0 row: Vec(sql/Cell) [] lobs lobs0]
    (if (or (< p 0) (>= i (count cols))) (values row lobs p)
      (let [c (nth cols i) t (:typ c)]
        (cond
          (not (bit-set? bv i)) (recur (+ i 1) p (conj row (if (< i (count prev)) (nth prev i) (sql/->CNull))) lobs)
          (and (= (:size c) 0) (not= t T-LONG) (not= t T-LONG-RAW) (not= t T-UROWID) (not= t T-CLOB) (not= t T-BLOB))
          (recur (+ i 1) p (conj row (sql/->CNull)) lobs)
          (= t T-ROWID)
          (let [[n p1] (w/r8 b p)]
            (if (or (= n 0) (= n 255)) (recur (+ i 1) p1 (conj row (sql/->CNull)) lobs)
              (let [[rid p2] (read-rowid b p1)] (recur (+ i 1) p2 (conj row (sql/->CDatum "oracle.sql.ROWID" rid "")) lobs))))
          (or (= t T-CLOB) (= t T-BLOB))
          (let [[n p1] (w/rub4 b p)]
            (if (or (< p1 0) (= n 0)) (recur (+ i 1) p1 (conj row (sql/->CNull)) lobs)
              (let [[size p2] (w/rub8 b p1)
                    [chunk p3] (w/rub4 b p2)
                    [loc p4 z] (w/rbytes b p3)]
                (recur (+ i 1) p4 (conj row (if (= t T-CLOB) (sql/->CClob "") (sql/->CBytes "")))
                       (if (= size 0) lobs (conj lobs (->Lob rowno i loc size (= t T-BLOB))))))))
          :else
          (let [[v p1 null] (w/rbytes b p)
                p2 (if (or (= t T-LONG) (= t T-LONG-RAW)) (let [[a q1] (w/rsb b p1 4) [d q2] (w/rub4 b q1)] q2) p1)]
            (recur (+ i 1) p2 (conj row (if null (sql/->CNull) (cell-of c v))) lobs)))))))

(defn- read-row-header Values(Str Int) [b: &Str p0: Int]
  (let [[fl p1] (w/r8 b p0)
        [x1 p2] (w/rub2 b p1)
        [x2 p3] (w/rub4 b p2)
        [x3 p4] (w/rub4 b p3)
        [x4 p5] (w/rub2 b p4)
        [n p6] (w/rub4 b p5)
        [bv p7] (if (and (>= p6 0) (> n 0)) (let [[z q] (w/r8 b p6)] (w/rraw b q n)) (values "" p6))
        [x5 p8] (w/rbytes2 b p7)]
    (values bv p8)))

(defn- skip-piggyback Int [b: &Str p0: Int]
  (let [[op p1] (w/r8 b p0)]
    (cond
      (< p1 0) p1
      (or (= op 1) (= op 3)) p1
      (= op 2) (let [[x q] (w/rub2 b p1)] (w/skip-bytes b q))
      (= op 4) (let [[a q1] (w/rub2 b p1) [c q2] (w/r8 b q1) [n q3] (w/rub2 b q2)
                     q4 (if (and (>= q3 0) (> n 0))
                          (let [[z qz] (w/r8 b q3)]
                            (loop [i 0 q qz]
                              (if (or (< q 0) (>= i n)) q
                                (let [[l1 r1] (w/rub2 b q) [x1 r2] (if (> l1 0) (w/rraw b r1 l1) (values "" r1))
                                      [l2 r3] (w/rub2 b r2) [x2 r4] (if (> l2 0) (w/rraw b r3 l2) (values "" r3))
                                      [f r5] (w/rub2 b r4)]
                                  (recur (+ i 1) r5)))))
                          q3)
                     [f1 q5] (w/rub4 b q4) [sid q6] (w/rub4 b q5) [ser q7] (w/rub2 b q6)]
                 q7)
      (= op 5) (let [[a q1] (w/rub2 b p1) [c q2] (w/r8 b q1) [n q3] (w/rub2 b q2) [z q4] (w/r8 b q3)
                     q5 (loop [i 0 q q4]
                          (if (or (< q 0) (>= i n)) q
                            (let [[l1 r1] (w/rub2 b q) r2 (if (> l1 0) (w/skip-bytes b r1) r1)
                                  [l2 r3] (w/rub2 b r2) r4 (if (> l2 0) (w/skip-bytes b r3) r3)
                                  [kw r5] (w/rub2 b r4)]
                              (recur (+ i 1) r5))))
                     [f q6] (w/rub4 b q5)]
                 q6)
      (= op 7) (let [[x q] (w/rbytes2 b p1)] q)
      (= op 8) (let [[a q1] (w/rub2 b p1) [c q2] (w/r8 b q1) [d q3] (w/rub4 b q2) [e q4] (w/rub4 b q3) [f q5] (w/r8 b q4) [g q6] (w/rbytes2 b q5)] q6)
      (= op 9) (let [[a q1] (w/rub2 b p1) [c q2] (w/r8 b q1)] q2)
      (= op 10) (let [[a q1] (w/rub2 b p1) [c q2] (w/r8 b q1) [d q3] (w/rub8 b q2) [e q4] (w/rub8 b q3) [f q5] (w/rub8 b q4)] q5)
      :else w/BAD)))

(defn- read-io-vector Values(Vec(Int) Int) [b: &Str p0: Int]
  (let [[fl p1] (w/r8 b p0)
        [nreq p2] (w/rub2 b p1)
        [iters p3] (w/rub4 b p2)
        nb (+ (* iters 256) nreq)
        [x1 p4] (w/rub4 b p3)
        [x2 p5] (w/rub2 b p4)
        [n1 p6] (w/rub2 b p5)
        p7 (if (< p6 0) p6 (let [[x q] (w/rraw b p6 n1)] q))
        [n2 p8] (w/rub2 b p7)
        p9 (if (< p8 0) p8 (let [[x q] (w/rraw b p8 n2)] q))]
    (loop [i 0 p p9 acc: Vec(Int) []]
      (if (or (< p 0) (>= i nb)) (values acc p)
        (let [[d q] (w/r8 b p)] (recur (+ i 1) q (conj acc d)))))))

(defn- read-out-row Values(Vec(sql/Cell) Vec(Cur) Int) [b: &Str p0: Int binds: &Vec(Bind) dirs: &Vec(Int) fv: Int]
  (loop [i 0 p p0 outs: Vec(sql/Cell) [] curs: Vec(Cur) []]
    (if (or (< p 0) (>= i (count binds))) (values outs curs p)
      (let [d (if (< i (count dirs)) (nth dirs i) 32)
            bd (nth binds i)
            t (:typ bd)]
        (cond
          (= d 32) (recur (+ i 1) p outs curs)
          (= t T-CURSOR)
          (let [[z p1] (w/r8 b p)
                [cols p2] (read-describe-body b p1 fv)
                [cid p3] (w/rub2 b p2)
                [alen p4] (w/rsb b p3 4)]
            (recur (+ i 1) p4 (conj outs (sql/->CNull)) (conj curs (->Cur (count outs) cid cols))))
          :else
          (let [[v p1 null] (w/rbytes b p)
                [alen p2] (w/rsb b p1 4)
                c (->Col "" t (:csfrm bd) 0 0 (:size bd) true)]
            (recur (+ i 1) p2 (conj outs (if (or null (and (= t T-BOOLEAN) (< alen 0))) (sql/->CNull) (cell-of c v))) curs)))))))

(defn- skip-io-vector Int [b: &Str p0: Int]
  (let [[fl p1] (w/r8 b p0)
        [nreq p2] (w/rub2 b p1)
        [iters p3] (w/rub4 b p2)
        nb (+ (* iters 256) nreq)
        [x1 p4] (w/rub4 b p3)
        [x2 p5] (w/rub2 b p4)
        [n1 p6] (w/rub2 b p5)
        p7 (if (< p6 0) p6 (let [[x q] (w/rraw b p6 n1)] q))
        [n2 p8] (w/rub2 b p7)
        p9 (if (< p8 0) p8 (let [[x q] (w/rraw b p8 n2)] q))]
    (if (< p9 0) p9 (let [[x q] (w/rraw b p9 nb)] q))))

(defn- resp-with Resp [r: &Resp fv: Int params: Vec(Str) vfr: Int cols: Vec(Col) rows: Vec(Vec(sql/Cell)) lobs: Vec(Lob) bv: Str lobdata: Str]
  (->Resp fv params vfr cols rows lobs bv (:errnum r) (:errmsg r) (:errpos r) (:cursor r)
          (:rowcount r) (:rowid r) lobdata (:done r) (:flush r) (:dirs r) (:outs r) (:curs r) (:counts r)))

(defn- with-outs Resp [r: &Resp dirs: Vec(Int) outs: Vec(sql/Cell) curs: Vec(Cur)]
  (->Resp (:fv r) (:params r) (:vfr r) (:cols r) (:rows r) (:lobs r) (:bitvec r)
          (:errnum r) (:errmsg r) (:errpos r) (:cursor r) (:rowcount r) (:rowid r)
          (:lobdata r) (:done r) (:flush r) dirs outs curs (:counts r)))

(defn parse Values(Resp Int) [b: &Str ctx: &Ctx]
  (let [[r rows p] (parse-loop b ctx)] (values (assoc r :rows rows) p)))

(defn- parse-loop Values(Resp Vec(Vec(sql/Cell)) Int) [b: &Str ctx: &Ctx]
  (loop [p 0 r (new-resp (:fv ctx) (:cols ctx)) rows: Vec(Vec(sql/Cell)) []]
    (if (< p 0) (values r rows p)
      (let [[mt p1] (w/r8 b p)
            eor (:eor ctx)]
        (cond
          (< p1 0) (values r rows p1)
          (= mt 29) (values (with-done r true false) rows p1)
          (= mt 1) (let [[fv q] (read-protocol b p1)]
                     (recur q (resp-with r fv (:params r) (:vfr r) (:cols r) (:rows r) (:lobs r) (:bitvec r) (:lobdata r)) rows))
          (= mt 2) (recur (read-data-types b p1) r rows)
          (= mt 4) (let [[r2 q] (read-error b p1 r (:fv r))]
                     (if eor (recur q r2 rows) (values (with-done r2 true false) rows q)))
          (= mt 9) (let [[x q1] (w/rub4 b p1) [y q2] (w/rub2 b q1)]
                     (if eor (recur q2 r rows) (values (with-done r true false) rows q2)))
          (= mt 8) (if (= (:mode ctx) 0)
                     (let [[ps vfr q] (read-auth-params b p1 (:params r) (:vfr r))]
                       (recur q (resp-with r (:fv r) ps vfr (:cols r) (:rows r) (:lobs r) (:bitvec r) (:lobdata r)) rows))
                     (if (= (:mode ctx) 2)
                       (let [[loc q1] (w/rraw b p1 (:loclen ctx)) [amt q2] (w/rsb b q1 8)] (recur q2 r rows))
                       (let [[cs q] (read-exec-params b p1 (:counts ctx))]
                         (recur q (if (:counts ctx) (assoc r :counts cs) r) rows))))
          (= mt 16) (let [[cols q] (read-describe b p1 (:fv r))]
                      (recur q (resp-with r (:fv r) (:params r) (:vfr r) cols [] [] "" (:lobdata r)) []))
          (= mt 6) (let [[bv q] (read-row-header b p1)]
                     (recur q (resp-with r (:fv r) (:params r) (:vfr r) (:cols r) (:rows r) (:lobs r) bv (:lobdata r)) rows))
          (= mt 21) (let [[n q1] (w/rub2 b p1)
                          nc (count (:cols r))
                          [bv q2] (w/rraw b q1 (+ (/ nc 8) (if (= (mod nc 8) 0) 0 1)))]
                      (recur q2 (resp-with r (:fv r) (:params r) (:vfr r) (:cols r) (:rows r) (:lobs r) bv (:lobdata r)) rows))
          (and (= mt 7) (= (:mode ctx) 3))
          (let [[outs curs q] (read-out-row b p1 (:binds ctx) (:dirs r) (:fv r))]
            (recur q (with-outs r (:dirs r) outs curs) rows))
          (= mt 7) (let [prev (if (> (count rows) 0) (nth rows (- (count rows) 1)) (:prev ctx))
                         [row lobs q] (read-row b p1 (:cols r) (:bitvec r) prev (count rows) (:lobs r))]
                     (recur q (resp-with r (:fv r) (:params r) (:vfr r) (:cols r) (:rows r) lobs "" (:lobdata r)) (conj rows row)))
          (= mt 14) (let [[d q z] (w/rbytes b p1)]
                      (recur q (resp-with r (:fv r) (:params r) (:vfr r) (:cols r) (:rows r) (:lobs r) (:bitvec r) (str (:lobdata r) d)) rows))
          (= mt 15) (let [[num q1] (w/rub2 b p1) [len q2] (w/rub2 b q1) [fl q3] (w/rub2 b q2)
                          q4 (if (and (>= q3 0) (not= num 0) (> len 0)) (w/skip-bytes b q3) q3)]
                      (recur q4 r rows))
          (= mt 11) (let [[dirs q] (read-io-vector b p1)] (recur q (with-outs r dirs (:outs r) (:curs r)) rows))
          (= mt 19) (values (with-done r true true) rows p1)
          (= mt 23) (recur (skip-piggyback b p1) r rows)
          (= mt 33) (let [[x q] (w/rub8 b p1)] (recur q r rows))
          :else (values r rows w/BAD))))))
