(ns mulay.db.oraproto
  (:require [mulay.db.orawire :as w] [mulay.db.oranum :as on] [mulay.db.sql :as sql]
            [clay.string :as str] [clay.charset :as ccs] [mulay.lib.ieee :as ie] [mulay.lib.dec :as dec] [mulay.db.ora_zones :as oz]))

(def FN-AUTH1 118)
(def FN-AUTH2 115)
(def FN-EXECUTE 94)
(def FN-FETCH 5)
(def FN-COMMIT 14)
(def FN-ROLLBACK 15)
(def FN-LOGOFF 9)
(def FN-LOB-OP 96)
(def FN-CLOSE-CURSORS 105)

(def OPT-PARSE 1)
(def OPT-BIND 8)
(def OPT-DEFINE 16)
(def OPT-EXECUTE 32)
(def OPT-FETCH 64)
(def OPT-COMMIT 256)
(def OPT-PLSQL-BIND 1024)
(def OPT-NOT-PLSQL 32768)
(def DML-ROWCOUNTS 16384)

(def T-VARCHAR 1)
(def T-NUMBER 2)
(def T-BINARY-INTEGER 3)
(def T-LONG 8)
(def T-ROWID 11)
(def T-DATE 12)
(def T-RAW 23)
(def T-LONG-RAW 24)
(def T-CHAR 96)
(def T-BINARY-FLOAT 100)
(def T-BINARY-DOUBLE 101)
(def T-CURSOR 102)
(def T-CLOB 112)
(def T-BLOB 113)
(def T-BFILE 114)
(def T-TIMESTAMP 180)
(def T-TIMESTAMP-TZ 181)
(def T-UROWID 208)
(def T-TIMESTAMP-LTZ 231)
(def T-BOOLEAN 252)

(def CHARSET-UTF8 873)

