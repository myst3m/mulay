(ns mulay.lib.time.types)

(defrecord LocalDate [year: Int month: Int day: Int])
(defrecord LocalTime [hour: Int minute: Int second: Int nano: Int])
(defrecord LocalDateTime [date: LocalDate time: LocalTime])

(defvariant TimeZone
  (TzOffset secs: Int)
  (TzRegion id: Str))

(defrecord OffsetTime [time: LocalTime offset: Int])
(defrecord ZonedDateTime [dt: LocalDateTime offset: Int zone: TimeZone])

(defrecord Period [years: Int months: Int days: Int])
(defrecord Duration [seconds: Int nanos: Int])
(defrecord Instant [seconds: Int nanos: Int])

(defvariant DwPeriod
  (PerDate p: Period)
  (PerTime d: Duration))

(def NANOS-PER-SECOND 1000000000)
(def SECONDS-PER-DAY 86400)
(def NANOS-PER-DAY 86400000000000)

(defn utc TimeZone [] (->TzOffset 0))

(defn- pad2 Str [n: Int] (if (< n 10) (str "0" n) (str n)))

(defn offset-id Str [secs: Int]
  (if (= secs 0) "Z"
    (let [a (if (< secs 0) (- 0 secs) secs)
          h (/ a 3600) m (/ (mod a 3600) 60) s (mod a 60)]
      (str (if (< secs 0) "-" "+") (pad2 h) ":" (pad2 m) (if (= s 0) "" (str ":" (pad2 s)))))))

(defn zone-id Str [z: &TimeZone]
  (match z
    (TzOffset s) (offset-id s)
    (TzRegion id) id))
