(ns mulay.lib.time.num)

(def LMAX 9223372036854775807)
(def LMIN (- -9223372036854775807 1))
(def IMAX 2147483647)
(def IMIN -2147483648)

(defn add-exact Values(Int Bool) [a: Int b: Int]
  (let [r (+ a b)]
    (values r (not (and (= (< a 0) (< b 0)) (not= (< r 0) (< a 0)))))))

(defn mul-exact Values(Int Bool) [a: Int b: Int]
  (if (or (= a 0) (= b 0)) (values 0 true)
    (let [r (* a b)
          bad (or (and (= a -1) (= b LMIN)) (and (= b -1) (= a LMIN)))]
      (values r (and (not bad) (= (/ r b) a))))))

(defn int32? Bool [n: Int] (and (>= n IMIN) (<= n IMAX)))

(defn byte-at Int [s: &Str i: Int]
  (if (and (>= i 0) (< i (count s))) (nth s i) -1))

(defn scan-digits Values(Int Int Bool) [s: &Str pos: Int maxn: Int]
  (let [n (count s)]
    (loop [i pos acc 0 ovf false]
      (if (and (< i n) (< (- i pos) maxn) (digit? (nth s i)))
        (let [d (- (nth s i) 48)
              o (or ovf (> acc (/ (- LMAX d) 10)))]
          (recur (+ i 1) (+ (* acc 10) d) o))
        (values acc i ovf)))))

(defn pad-num Str [n: Int width: Int]
  (let [neg (< n 0)
        a (if neg (str (- 0 n)) (str n))
        a2 (if (= n LMIN) "9223372036854775808" a)
        z (loop [acc "" k (count a2)] (if (>= k width) acc (recur (str acc "0") (+ k 1))))]
    (str (if neg "-" "") z a2)))

(defn ascii-lower Int [c: Int] (if (and (>= c 65) (<= c 90)) (+ c 32) c))
(defn ascii-upper Int [c: Int] (if (and (>= c 97) (<= c 122)) (- c 32) c))

(defn region-eq? Bool [s: &Str pos: Int lit: &Str ci: Bool]
  (let [m (count lit)]
    (if (> (+ pos m) (count s)) false
      (loop [i 0]
        (if (>= i m) true
          (let [a (nth s (+ pos i)) b (nth lit i)]
            (if (if ci (= (ascii-lower a) (ascii-lower b)) (= a b)) (recur (+ i 1)) false)))))))

(defn str-eq-ci? Bool [a: &Str b: &Str]
  (and (= (count a) (count b)) (region-eq? a 0 b true)))
