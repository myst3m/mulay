(ns mulay.lib.time.unit)

(defn nanos-per Int [unit: &Str]
  (case unit
    "NANOSECONDS" 1
    "MICROSECONDS" 1000
    "MILLISECONDS" 1000000
    "SECONDS" 1000000000
    "MINUTES" 60000000000
    "HOURS" 3600000000000
    "DAYS" 86400000000000
    0))

(defn- int32 Values(Int Str) [s: Int]
  (if (or (> s 2147483647) (< s -2147483648)) (values 0 "integer overflow") (values s "")))

(defn ceil-seconds Values(Int Str) [n: Int unit: &Str]
  (let [per (nanos-per unit)]
    (cond
      (= per 0) (values 0 (str "unknown time unit '" unit "'"))
      (<= per 1000000000)
      (let [k (quot 1000000000 per)
            s (quot n k)]
        (int32 (if (< (* s k) n) (+ s 1) s)))
      :else
      (let [r (quot per 1000000000)
            lim (quot 9223372036854775807 r)]
        (if (or (> n lim) (< n (- 0 lim))) (values 0 "integer overflow") (int32 (* n r)))))))
