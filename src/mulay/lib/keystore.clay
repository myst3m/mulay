(ns mulay.lib.keystore (:require [clay.base64 :as b64] [mulay.lib.hash :as hash]))

(defrecord KeyEntry [alias: Str key-pem: Str chain-pem: Vec(Str)])
(defrecord CertEntry [alias: Str pem: Str])
(defrecord KeyStore [keys: Vec(KeyEntry) certs: Vec(CertEntry)])

(def TAMPERED "Keystore was tampered with, or password was incorrect")

(defn- sha1 Str [data: &Str] (hash/sha1 data))

(defn- u32 Int [b: &Str i: Int]
  (if (or (< i 0) (> i (- (count b) 4))) -1
    (+ (* (nth b i) 16777216) (* (nth b (+ i 1)) 65536) (* (nth b (+ i 2)) 256) (nth b (+ i 3)))))

(defn- u16 Int [b: &Str i: Int] (if (or (< i 0) (> i (- (count b) 2))) -1 (+ (* (nth b i) 256) (nth b (+ i 1)))))

(defn- part Values(Str Int) [b: &Str i: Int n: Int]
  (if (or (< i 0) (< n 0) (> n (- (count b) i))) (values "" -1) (values (subs b i (+ i n)) (+ i n))))

(defn- byte-at Int [s: &Str i: Int] (if (< i (count s)) (nth s i) 128))

(defn- utf16be Str [s: &Str]
  (loop [i 0 out ""]
    (if (>= i (count s)) out
      (let [c (nth s i)
            [cp n] (cond (< c 128) (values c 1)
                         (< c 224) (values (+ (* (bit-and c 31) 64) (bit-and (byte-at s (+ i 1)) 63)) 2)
                         (< c 240) (values (+ (* (bit-and c 15) 4096) (* (bit-and (byte-at s (+ i 1)) 63) 64) (bit-and (byte-at s (+ i 2)) 63)) 3)
                         :else (values (+ (* (bit-and c 7) 262144) (* (bit-and (byte-at s (+ i 1)) 63) 4096) (* (bit-and (byte-at s (+ i 2)) 63) 64) (bit-and (byte-at s (+ i 3)) 63)) 4))]
        (if (< cp 65536)
          (recur (+ i n) (str out (chr (bit-shift-right cp 8)) (chr (bit-and cp 255))))
          (let [d (- cp 65536) hi (+ 55296 (bit-shift-right d 10)) lo (+ 56320 (bit-and d 1023))]
            (recur (+ i n) (str out (chr (bit-shift-right hi 8)) (chr (bit-and hi 255)) (chr (bit-shift-right lo 8)) (chr (bit-and lo 255))))))))))

(defn pem Str [kind: &Str der: &Str]
  (let [b (b64/encode (str der))]
    (loop [i 0 out (str "-----BEGIN " kind "-----\n")]
      (if (>= i (count b)) (str out "-----END " kind "-----\n")
        (let [e (if (> (+ i 64) (count b)) (count b) (+ i 64))]
          (recur e (str out (subs b i e) "\n")))))))

(defn jks? Bool [b: &Str]
  (and (>= (count b) 4) (= (nth b 0) 254) (= (nth b 1) 237) (= (nth b 2) 254) (= (nth b 3) 237)))

(defn- tlv Values(Int Int Int) [b: &Str i: Int]
  (if (>= (+ i 1) (count b)) (values 0 -1 0)
    (let [l0 (nth b (+ i 1))]
      (if (< l0 128) (values (+ i 2) l0 (+ i 2 l0))
        (let [n (bit-and l0 127)
              s (+ i 2 n)]
          (if (or (= n 0) (> n 4) (> s (count b))) (values 0 -1 0)
            (let [len (loop [k 0 acc 0] (if (>= k n) acc (recur (+ k 1) (+ (* acc 256) (nth b (+ i 2 k))))))]
              (if (> len (- (count b) s)) (values 0 -1 0) (values s len (+ s len))))))))))

(defn- epki-data Values(Str Bool) [b: &Str]
  (let [[s0 l0 e0] (tlv b 0)]
    (if (< l0 0) (values "" false)
      (let [[s1 l1 e1] (tlv b s0)]
        (if (< l1 0) (values "" false)
          (let [[s2 l2 e2] (tlv b e1)]
            (if (or (< l2 0) (not= (nth b e1) 4)) (values "" false) (values (subs b s2 (+ s2 l2)) true))))))))

(defn- recover-key Values(Str Bool) [enc: &Str pw16: &Str]
  (let [n (count enc)]
    (if (< n 40) (values "" false)
      (let [salt (subs enc 0 20)
            body (subs enc 20 (- n 20))
            check (subs enc (- n 20) n)
            stream (loop [d salt out ""]
                     (if (>= (count out) (count body)) out
                       (let [d2 (sha1 (str pw16 d))] (recur d2 (str out d2)))))
            plain (loop [i 0 out ""]
                    (if (>= i (count body)) out
                      (recur (+ i 1) (str out (chr (bit-xor (nth body i) (nth stream i)))))))]
        (values plain (= (sha1 (str pw16 plain)) check))))))

(defn- read-utf Values(Str Int) [b: &Str i: Int]
  (let [n (u16 b i)] (if (< n 0) (values "" -1) (part b (+ i 2) n))))

(defn- read-cert Values(Str Int) [b: &Str i0: Int version: Int]
  (let [i (if (= version 2) (let [[t j] (read-utf b i0)] j) i0)
        n (u32 b i)]
    (if (or (< i 0) (< n 0)) (values "" -1) (part b (+ i 4) n))))

(defn read-jks Values(KeyStore Str) [b: &Str store-pw: &Str key-pw: &Str] (parse-jks b store-pw key-pw false))

(defn read-jks-certs Values(KeyStore Str) [b: &Str store-pw: &Str] (parse-jks b store-pw "" true))

(defn- parse-jks Values(KeyStore Str) [b: &Str store-pw: &Str key-pw: &Str certs-only: Bool]
  (let [empty (->KeyStore [] [])]
    (if (or (not (jks? b)) (< (count b) 32)) (values empty "Invalid keystore format")
      (let [n (count b)
            pw16 (utf16be store-pw)
            digest (sha1 (str pw16 "Mighty Aphrodite" (subs b 0 (- n 20))))]
        (if (and (not (and certs-only (= store-pw ""))) (not= digest (subs b (- n 20) n))) (values empty TAMPERED)
          (let [version (u32 b 4)
                cnt (u32 b 8)
                kpw16 (utf16be (if (= key-pw "") store-pw key-pw))]
            (loop [k 0 i 12 keys: Vec(KeyEntry) [] certs: Vec(CertEntry) []]
              (if (>= k cnt) (values (->KeyStore keys certs) "")
                (let [tag (u32 b i)
                      [alias j] (read-utf b (+ i 4))
                      j2 (if (< j 0) -1 (+ j 8))]
                  (cond
                    (< j2 0) (values empty "Invalid keystore format")
                    (= tag 1)
                    (let [len (u32 b j2)
                          [epki j3] (if (< len 0) (values "" -1) (part b (+ j2 4) len))
                          nc (u32 b j3)
                          [chain j4] (loop [c 0 at (+ j3 4) acc: Vec(Str) []]
                                       (if (or (>= c nc) (< at 0)) (values acc at)
                                         (let [[der nx] (read-cert b at version)] (recur (+ c 1) nx (conj acc (pem "CERTIFICATE" der))))))
                          [enc ok] (if (or (< j3 0) (< nc 0) (< j4 0)) (values "" false) (epki-data epki))
                          [plain good] (if ok (recover-key enc kpw16) (values "" false))]
                      (cond
                        (or (< j3 0) (< nc 0) (< j4 0)) (values empty "Invalid keystore format")
                        certs-only (recur (+ k 1) j4 keys certs)
                        (not good) (values empty "Cannot recover key")
                        :else (recur (+ k 1) j4 (conj keys (->KeyEntry alias (pem "PRIVATE KEY" plain) chain)) certs)))
                    (= tag 2)
                    (let [[der nx] (read-cert b j2 version)]
                      (if (< nx 0) (values empty "Invalid keystore format")
                        (recur (+ k 1) nx keys (conj certs (->CertEntry alias (pem "CERTIFICATE" der))))))
                    :else (values empty "Invalid keystore format")))))))))))
