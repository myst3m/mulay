(ns mulay.lib.libm)

(target-when "wasm"
(do
(defn sin* Float [x: Float] (sin x))
(defn cos* Float [x: Float] (cos x))
(defn tan* Float [x: Float] (tan x))
(defn exp* Float [x: Float] (exp x))
(defn log* Float [x: Float] (log x))
(defn log10* Float [x: Float] (log10 x)))
(do
(defextern c-sin sin)
(defextern c-cos cos)
(defextern c-tan tan)
(defextern c-exp exp)
(defextern c-log log)
(defextern c-log10 log10)
(c-include "<math.h>")
(defn sin* Float [x: Float] (unsafe (c-sin x)))
(defn cos* Float [x: Float] (unsafe (c-cos x)))
(defn tan* Float [x: Float] (unsafe (c-tan x)))
(defn exp* Float [x: Float] (unsafe (c-exp x)))
(defn log* Float [x: Float] (unsafe (c-log x)))
(defn log10* Float [x: Float] (unsafe (c-log10 x)))))
