(ns mulay.lib.yaml
  (:require [mulay.lib.numparse :as npz] [clay.core]
            [clay.string :as str]))

(defvariant YVal
  (YNull)
  (YBool b: Bool)
  (YInt text: Str)
  (YFloat text: Str)
  (YStr s: Str)
  (YSeq items: Vec(YVal))
  (YMap keys: Vec(YVal) vals: Vec(YVal))
  (YTagged tag: Str x: YVal))

(defrecord YOpts [max-depth: Int max-alias-nodes: Int keep-tags: Bool max-aliases: Int])

(defn default-opts YOpts [] (->YOpts 400 1000000 false -1))

(defrecord- YS [anchors: Map(Str YVal) sizes: Map(Str Int) nodes: Int depth: Int opts: YOpts aliases: Int])

(defn- at Int [s: &Str i: Int] (if (and (>= i 0) (< i (count s))) (nth s i) -1))
(defn- sp? Bool [c: Int] (or (= c 32) (= c 9)))
(defn- eol? Bool [s: &Str p: Int] (let [c (at s p)] (or (< c 0) (= c 10) (= c 13))))
(defn- ws-or-eol? Bool [s: &Str p: Int] (or (eol? s p) (sp? (at s p))))
(defn- flow-ind? Bool [c: Int] (or (= c 44) (= c 91) (= c 93) (= c 123) (= c 125)))

(defn- skip-sp Int [s: &Str p: Int]
  (loop [i p] (if (sp? (at s i)) (recur (+ i 1)) i)))

(defn- line-end Int [s: &Str p: Int]
  (let [e (str/index-of-byte s p 10)] e))

(defn- line-start Int [s: &Str p: Int]
  (loop [i (- p 1)] (if (< i 0) 0 (if (= (nth s i) 10) (+ i 1) (recur (- i 1))))))

(defn- col Int [s: &Str p: Int] (- p (line-start s p)))

(defn- starts-at? Bool [s: &Str i: Int lit: &Str]
  (let [m (count lit)]
    (if (> (+ i m) (count s)) false
      (loop [k 0] (if (>= k m) true (if (= (nth s (+ i k)) (nth lit k)) (recur (+ k 1)) false))))))

(defn- doc-marker? Bool [s: &Str p: Int]
  (and (= (col s p) 0)
       (or (starts-at? s p "---") (starts-at? s p "..."))
       (ws-or-eol? s (+ p 3))))

(defn- rest-empty? Bool [s: &Str p: Int]
  (let [q (skip-sp s p)] (or (eol? s q) (= (at s q) 35))))

(defn- next-content Int [s: &Str p: Int]
  (let [n (count s)]
    (loop [i p]
      (let [q (skip-sp s i)
            c (at s q)]
        (cond (< c 0) n
              (= c 35) (let [e (line-end s q)] (if (>= e n) n (recur (+ e 1))))
              (or (= c 10) (= c 13)) (recur (+ q 1))
              :else q)))))

(defn- line-col Str [s: &Str pos: Int]
  (let [p (if (> pos (count s)) (count s) pos)
        line (loop [i 0 line 1] (if (>= i p) line (recur (+ i 1) (if (= (nth s i) 10) (+ line 1) line))))
        ls (line-start s p)
        c (loop [i ls c 1]
            (if (>= i p) c (recur (+ i 1) (if (= (bit-and (nth s i) 192) 128) c (+ c 1)))))]
    (str "line " line ", column " c)))

(defn- utf8 Str [cp: Int]
  (cond
    (< cp 128) (chr cp)
    (< cp 2048) (str (chr (bit-or 192 (bit-shift-right cp 6))) (chr (bit-or 128 (bit-and cp 63))))
    (< cp 65536) (str (chr (bit-or 224 (bit-shift-right cp 12)))
                      (chr (bit-or 128 (bit-and (bit-shift-right cp 6) 63)))
                      (chr (bit-or 128 (bit-and cp 63))))
    :else (str (chr (bit-or 240 (bit-shift-right cp 18)))
               (chr (bit-or 128 (bit-and (bit-shift-right cp 12) 63)))
               (chr (bit-or 128 (bit-and (bit-shift-right cp 6) 63)))
               (chr (bit-or 128 (bit-and cp 63))))))

(defn- trim-sp-right Str [s: Str keep: Int]
  (let [e (loop [e (count s)] (if (and (> e keep) (sp? (nth s (- e 1)))) (recur (- e 1)) e))]
    (if (= e (count s)) s (subs s 0 e))))

(defn- hex-digit? Bool [c: Int] (or (digit? c) (and (>= c 97) (<= c 102)) (and (>= c 65) (<= c 70))))
(defn- oct-digit? Bool [c: Int] (and (>= c 48) (<= c 55)))

(defn- all-digits Bool [s: &Str i: Int kind: Int]
  (loop [k i]
    (if (>= k (count s)) true
      (let [c (nth s k)
            ok (cond (= kind 1) (hex-digit? c) (= kind 2) (oct-digit? c) :else (digit? c))]
        (if ok (recur (+ k 1)) false)))))

(defn- int-text? Bool [s: &Str]
  (let [n (count s)]
    (cond
      (= n 0) false
      (starts-at? s 0 "0x") (and (> n 2) (all-digits s 2 1))
      (starts-at? s 0 "0o") (and (> n 2) (all-digits s 2 2))
      :else (let [i (if (or (= (nth s 0) 45) (= (nth s 0) 43)) 1 0)]
              (and (> n i) (all-digits s i 0))))))

(defn- float-text? Bool [s: &Str]
  (let [n (count s)
        i (if (and (> n 0) (or (= (nth s 0) 45) (= (nth s 0) 43))) 1 0)]
    (cond
      (= n 0) false
      (or (= s ".nan") (= s ".NaN") (= s ".NAN")) true
      (let [r (subs s i n)] (or (= r ".inf") (= r ".Inf") (= r ".INF"))) true
      :else
      (let [a (loop [k i] (if (and (< k n) (digit? (nth s k))) (recur (+ k 1)) k))
            has-int (> a i)
            [b has-frac] (if (= (at s a) 46)
                           (let [b (loop [k (+ a 1)] (if (and (< k n) (digit? (nth s k))) (recur (+ k 1)) k))]
                             (values b (> b (+ a 1))))
                           (values a false))
            dot (= (at s a) 46)]
        (cond
          (not (or has-int has-frac)) false
          (= b n) (or dot false)
          (or (= (nth s b) 101) (= (nth s b) 69))
          (let [e0 (+ b 1)
                e1 (if (or (= (at s e0) 45) (= (at s e0) 43)) (+ e0 1) e0)]
            (and (< e1 n) (all-digits s e1 0)))
          :else false)))))

(defn resolve-plain YVal [s: &Str]
  (cond
    (or (= s "") (= s "~") (= s "null") (= s "Null") (= s "NULL")) (->YNull)
    (or (= s "true") (= s "True") (= s "TRUE")) (->YBool true)
    (or (= s "false") (= s "False") (= s "FALSE")) (->YBool false)
    (int-text? s) (->YInt (str s))
    (float-text? s) (->YFloat (str s))
    :else (->YStr (str s))))

(defn scalar-text Str [v: &YVal]
  (match v
    (YNull) ""
    (YBool b) (if b "true" "false")
    (YInt t) (str t)
    (YFloat t) (str t)
    (YStr s) (str s)
    _ ""))

(defn int-value Values(Int Bool) [v: &YVal]
  (match v
    (YInt t)
    (let [n (count t)
          neg (= (at t 0) 45)
          i0 (if (or neg (= (at t 0) 43)) 1 0)
          [base i] (cond (starts-at? t 0 "0x") (values 16 2) (starts-at? t 0 "0o") (values 8 2) :else (values 10 i0))]
      (loop [k i acc 0]
        (if (>= k n) (values (if neg (- 0 acc) acc) true)
          (let [c (nth t k)
                d (cond (digit? c) (- c 48) (and (>= c 97) (<= c 102)) (+ 10 (- c 97)) (and (>= c 65) (<= c 70)) (+ 10 (- c 65)) :else 0)
                nx (+ (* acc base) d)]
            (if (< nx acc) (values 0 false) (recur (+ k 1) nx))))))
    _ (values 0 false)))

(defn- inf Float [] (exp 1000.0))

(defn float-value Values(Float Bool) [v: &YVal]
  (match v
    (YFloat t)
    (let [neg (= (at t 0) 45)
          r (if (or neg (= (at t 0) 43)) (subs t 1 (count t)) (str t))]
      (cond
        (or (= r ".inf") (= r ".Inf") (= r ".INF")) (values (if neg (- 0.0 (inf)) (inf)) true)
        (or (= r ".nan") (= r ".NaN") (= r ".NAN")) (values (- (inf) (inf)) true)
        :else (values (npz/flt t) true)))
    (YInt t) (let [[i ok] (int-value v)] (values (float i) ok))
    _ (values 0.0 false)))

(defn get-key Values(YVal Bool) [m: &YVal k: &Str]
  (match m
    (YMap ks vs)
    (loop [i (- (count ks) 1)]
      (if (< i 0) (values (->YNull) false)
        (let [kk (nth ks i)]
          (match kk
            (YStr s) (if (= s k) (values (nth vs i) true) (recur (- i 1)))
            _ (if (= (scalar-text kk) k) (values (nth vs i) true) (recur (- i 1)))))))
    _ (values (->YNull) false)))

(defn- parse-props Values(Str Str Int Str) [s: &Str p: Int]
  (loop [i p anchor "" tag ""]
    (let [c (at s i)]
      (cond
        (and (= c 38) (= anchor ""))
        (let [e (loop [k (+ i 1)] (let [d (at s k)] (if (or (< d 0) (sp? d) (= d 10) (= d 13) (flow-ind? d)) k (recur (+ k 1)))))]
          (if (= e (+ i 1)) (values anchor tag i "anchor without a name")
            (recur (skip-sp s e) (subs s (+ i 1) e) tag)))
        (and (= c 33) (= tag ""))
        (if (= (at s (+ i 1)) 60)
          (let [e (str/index-of-byte s i 62)]
            (if (>= e (line-end s i)) (values anchor tag i "unterminated verbatim tag")
              (recur (skip-sp s (+ e 1)) (subs s i (+ e 1)) tag)))
          (let [e (loop [k (+ i 1)] (let [d (at s k)] (if (or (< d 0) (sp? d) (= d 10) (= d 13) (flow-ind? d)) k (recur (+ k 1)))))]
            (recur (skip-sp s e) anchor (subs s i e))))
        :else (values anchor tag i "")))))

(defn- core-tag Str [tag: &Str]
  (cond (starts-at? tag 0 "!!") (subs tag 2 (count tag))
        (starts-at? tag 0 "!<tag:yaml.org,2002:") (subs tag 20 (- (count tag) 1))
        :else ""))

(defn- make-scalar YVal [raw: Str quoted: Bool tag: &Str keep: Bool]
  (let [ct (core-tag tag)]
    (cond
      (and keep (> (count tag) 1) (= ct "") (not (starts-at? tag 0 "!<"))) (->YTagged (str tag) (make-scalar raw quoted "" false))
      (= ct "str") (->YStr raw)
      (= ct "int") (->YInt raw)
      (= ct "float") (->YFloat raw)
      (= ct "bool") (->YBool (or (= raw "true") (= raw "True") (= raw "TRUE")))
      (= ct "null") (->YNull)
      (= tag "!") (->YStr raw)
      quoted (->YStr raw)
      :else (resolve-plain raw))))

(defn- plain-line Values(Int Int) [s: &Str p: Int flow: Bool]
  (loop [i p last p]
    (let [c (at s i)]
      (cond
        (or (< c 0) (= c 10) (= c 13)) (values last i)
        (and (= c 58) (let [d (at s (+ i 1))] (or (< d 0) (sp? d) (= d 10) (= d 13) (and flow (flow-ind? d))))) (values last i)
        (and (= c 35) (> i p) (sp? (nth s (- i 1)))) (values last i)
        (and flow (flow-ind? c)) (values last i)
        (sp? c) (recur (+ i 1) last)
        :else (recur (+ i 1) (+ i 1))))))

(defn- plain-scalar Values(Str Int) [s: &Str p: Int n: Int flow: Bool]
  (let [[e0 stop0] (plain-line s p flow)]
    (loop [out (subs s p e0) stop stop0]
      (if (not (eol? s stop)) (values out stop)
        (let [[blanks q] (loop [k stop b 0]
                           (if (>= k (count s)) (values b k)
                             (let [ls (+ k 1)
                                   q (skip-sp s ls)]
                               (if (and (eol? s q) (< q (count s))) (recur q (+ b 1))
                                 (values b q)))))
              c (at s q)]
          (cond
            (< c 0) (values out stop)
            (and (not flow) (<= (col s q) n)) (values out stop)
            (= c 35) (values out stop)
            (doc-marker? s (line-start s q)) (values out stop)
            (and flow (flow-ind? c)) (values out stop)
            (and (= c 58) (ws-or-eol? s (+ q 1))) (values out stop)
            :else
            (let [[e1 stop1] (plain-line s q flow)]
              (if (and (not flow) (= (at s stop1) 58)) (values out stop)
                (let [sep (if (= blanks 0) " " (loop [k 0 o ""] (if (>= k blanks) o (recur (+ k 1) (str o "\n")))))]
                  (recur (str out sep (subs s q e1)) stop1))))))))))

(defn- fold-break Values(Str Int) [s: &Str p: Int]
  (loop [k p b 0]
    (let [q (skip-sp s (+ k 1))]
      (if (and (< q (count s)) (= (at s q) 10)) (recur q (+ b 1))
        (values (if (= b 0) " " (loop [i 0 o ""] (if (>= i b) o (recur (+ i 1) (str o "\n"))))) q)))))

(defn- hexval Int [c: Int]
  (cond (digit? c) (- c 48) (and (>= c 97) (<= c 102)) (+ 10 (- c 97)) (and (>= c 65) (<= c 70)) (+ 10 (- c 65)) :else -1))

(defn- dq-scalar Values(Str Int Str Int) [s: &Str p: Int]
  (loop [i (+ p 1) out "" keep 0]
    (let [c (at s i)]
      (cond
        (< c 0) (values "" i "unterminated double-quoted scalar" p)
        (= c 34) (values out (+ i 1) "" 0)
        (= c 10) (let [o (trim-sp-right out keep) [f q] (fold-break s i)] (recur q (str o f) (count o)))
        (= c 92)
        (let [e (at s (+ i 1))]
          (cond
            (< e 0) (values "" i "unterminated double-quoted scalar" (+ i 1))
            (= e 10) (let [q (skip-sp s (+ i 2))] (recur q out (count out)))
            (or (= e 120) (= e 117) (= e 85))
            (let [w (cond (= e 120) 2 (= e 117) 4 :else 8)
                  v (loop [k 0 v 0] (if (>= k w) v (let [h (hexval (at s (+ i (+ 2 k))))] (if (< h 0) -1 (recur (+ k 1) (+ (* v 16) h))))))]
              (if (< v 0) (values "" i "invalid hexadecimal escape" i)
                (let [o (str out (utf8 v))] (recur (+ i (+ 2 w)) o (count o)))))
            :else
            (let [t (cond (= e 48) (chr 0) (= e 97) (chr 7) (= e 98) (chr 8) (= e 116) (chr 9) (= e 9) (chr 9)
                          (= e 110) "\n" (= e 118) (chr 11) (= e 102) (chr 12) (= e 114) (chr 13) (= e 101) (chr 27)
                          (= e 32) " " (= e 34) (chr 34) (= e 47) "/" (= e 92) "\\"
                          (= e 78) (utf8 133) (= e 95) (utf8 160) (= e 76) (utf8 8232) (= e 80) (utf8 8233)
                          :else "")]
              (if (= t "") (values "" i (str "invalid escape sequence '\\" (chr e) "'") i)
                (let [o (str out t)] (recur (+ i 2) o (count o)))))))
        :else
        (let [j (loop [j (+ i 1)] (let [d (at s j)] (if (or (< d 0) (= d 34) (= d 92) (= d 10)) j (recur (+ j 1)))))]
          (recur j (str out (subs s i j)) keep))))))

(defn- sq-scalar Values(Str Int Str Int) [s: &Str p: Int]
  (loop [i (+ p 1) out "" keep 0]
    (let [c (at s i)]
      (cond
        (< c 0) (values "" i "unterminated single-quoted scalar" p)
        (= c 39) (if (= (at s (+ i 1)) 39) (let [o (str out "'")] (recur (+ i 2) o (count o))) (values out (+ i 1) "" 0))
        (= c 10) (let [o (trim-sp-right out keep) [f q] (fold-break s i)] (recur q (str o f) (count o)))
        :else
        (let [j (loop [j (+ i 1)] (let [d (at s j)] (if (or (< d 0) (= d 39) (= d 10)) j (recur (+ j 1)))))]
          (recur j (str out (subs s i j)) keep))))))

(defn- nl Str [k: Int] (loop [i 0 o ""] (if (>= i k) o (recur (+ i 1) (str o "\n")))))

(defn- block-scalar Values(Str Int Str Int) [s: &Str p: Int n: Int]
  (let [folded (= (at s p) 62)
        [chomp ind hend] (loop [i (+ p 1) chomp 0 ind 0]
                           (let [c (at s i)]
                             (cond (and (= c 45) (= chomp 0)) (recur (+ i 1) -1 ind)
                                   (and (= c 43) (= chomp 0)) (recur (+ i 1) 1 ind)
                                   (and (>= c 49) (<= c 57) (= ind 0)) (recur (+ i 1) chomp (- c 48))
                                   :else (values chomp ind i))))
        he (skip-sp s hend)]
    (if (not (or (eol? s he) (and (= (at s he) 35) (> he hend))))
      (values "" p "invalid block scalar header" hend)
      (let [base (if (< n 0) 0 n)
            first-line (+ (line-end s he) 1)
            indent (if (> ind 0) (+ base ind)
                     (loop [ls first-line]
                       (if (>= ls (count s)) (+ base 1)
                         (let [q (loop [k ls] (if (= (at s k) 32) (recur (+ k 1)) k))]
                           (if (and (eol? s q) (< q (count s))) (recur (+ q 1))
                             (let [c (- q ls)] (if (> c n) c (+ base 1))))))))]
        (loop [ls first-line lines: Vec(Str) [] end (- first-line 1)]
          (let [q (loop [k ls] (if (and (= (at s k) 32) (< (- k ls) indent)) (recur (+ k 1)) k))
                le (line-end s ls)]
            (cond
              (>= ls (count s)) (finish-block lines folded chomp (if (> end (count s)) (count s) end))
              (and (= (col s ls) 0) (doc-marker? s ls)) (finish-block lines folded chomp end)
              (and (eol? s q) (< (- q ls) indent)) (recur (+ le 1) (conj lines "") le)
              (< (- q ls) indent) (finish-block lines folded chomp end)
              :else (recur (+ le 1) (conj lines (subs s q le)) le))))))))

(defn- finish-block Values(Str Int Str Int) [lines: Vec(Str) folded: Bool chomp: Int end: Int]
  (let [m (count lines)
        last (loop [k (- m 1)] (if (and (>= k 0) (= (count (nth lines k)) 0)) (recur (- k 1)) k))
        trailing (- (- m 1) last)
        body (if folded
               (loop [i 0 out "" pend 0 prev-more false first true]
                 (if (> i last) out
                   (let [ln (nth lines i)]
                     (if (= (count ln) 0) (recur (+ i 1) out (+ pend 1) prev-more first)
                       (let [more (sp? (nth ln 0))
                             sep (cond first (nl pend)
                                       (or more prev-more) (nl (+ pend 1))
                                       (= pend 0) " "
                                       :else (nl pend))]
                         (recur (+ i 1) (str out sep ln) 0 more false))))))
               (loop [i 0 out ""]
                 (if (> i last) out (recur (+ i 1) (if (= i 0) (str (nth lines 0)) (str out "\n" (nth lines i)))))))
        text (cond
               (< last 0) (if (= chomp 1) (nl m) "")
               (= chomp -1) body
               (= chomp 1) (str body "\n" (nl trailing))
               :else (str body "\n"))]
    (values text end "" 0)))

(defn- yfail Values(YVal Int Int YS Str) [s: &Str st: YS pos: Int msg: &Str]
  (values (->YNull) pos 0 st (str (line-col s pos) ": " msg)))

(defn- with-anchor Values(YVal Int Int YS Str) [v: YVal end: Int size: Int st: YS anchor: &Str]
  (if (= anchor "") (values v end size st "")
    (let [st2 (assoc st :anchors (assoc (:anchors st) anchor v) :sizes (assoc (:sizes st) anchor size))]
      (values v end size st2 ""))))

(defn- enter Values(YS Bool) [st: YS]
  (let [d (+ (:depth st) 1)] (values (assoc st :depth d) (<= d (:max-depth (:opts st))))))

(defn- leave YS [st: YS] (assoc st :depth (- (:depth st) 1)))

(defn- skip-flow-ws Int [s: &Str p: Int]
  (loop [i p]
    (let [c (at s i)]
      (cond (or (sp? c) (= c 10) (= c 13)) (recur (+ i 1))
            (and (= c 35) (or (= i 0) (let [d (at s (- i 1))] (or (sp? d) (= d 10))))) (recur (line-end s i))
            :else i))))

(defn- alias-node Values(YVal Int Int YS Str) [s: &Str p: Int st: YS]
  (let [e (loop [k (+ p 1)] (let [d (at s k)] (if (or (< d 0) (sp? d) (= d 10) (= d 13) (flow-ind? d)) k (recur (+ k 1)))))
        name (subs s (+ p 1) e)]
    (if (not (contains? (:anchors st) name)) (yfail s st p (str "undefined alias '" name "'"))
      (let [v: YVal (get (:anchors st) name (->YNull))
            sz: Int (get (:sizes st) name 1)
            total (+ (:nodes st) sz)
            used (+ (:aliases st) 1)
            limit (:max-aliases (:opts st))]
        (cond
          (and (>= limit 0) (> used limit))
          (yfail s st p (str "Max number of anchor expansion `maxEntityCount=" limit "` has been exceeded"))
          (> total (:max-alias-nodes (:opts st))) (yfail s st p "alias expansion exceeds the node limit")
          :else (values v e sz (assoc (assoc st :nodes total) :aliases used) ""))))))

(defn- parse-token Values(YVal Int Int YS Str) [s: &Str p: Int n: Int st: YS flow: Bool multi: Bool]
  (let [[anchor tag pe perr] (parse-props s p)
        c (at s pe)]
    (cond
      (not (= perr "")) (yfail s st pe perr)
      (= c 42) (alias-node s pe st)
      (= c 34) (let [[t e err errpos] (dq-scalar s pe)]
                 (if (= err "") (with-anchor (make-scalar t true tag (:keep-tags (:opts st))) e 1 st anchor) (yfail s st errpos err)))
      (= c 39) (let [[t e err errpos] (sq-scalar s pe)]
                 (if (= err "") (with-anchor (make-scalar t true tag (:keep-tags (:opts st))) e 1 st anchor) (yfail s st errpos err)))
      (= c 91) (let [[v e sz st2 err] (flow-seq s pe st)]
                 (if (= err "") (with-anchor v e sz st2 anchor) (values v e sz st2 err)))
      (= c 123) (let [[v e sz st2 err] (flow-map s pe st)]
                  (if (= err "") (with-anchor v e sz st2 anchor) (values v e sz st2 err)))
      (and (not flow) (or (= c 124) (= c 62)))
      (let [[t e err errpos] (block-scalar s pe n)]
        (if (= err "") (with-anchor (make-scalar t true tag (:keep-tags (:opts st))) e 1 st anchor) (yfail s st errpos err)))
      (or (< c 0) (= c 10) (= c 13) (and (= c 35) (> pe p)) (and flow (or (= c 44) (= c 93) (= c 125))))
      (with-anchor (make-scalar "" (not (= tag "")) tag (:keep-tags (:opts st))) pe 1 st anchor)
      (or (= c 93) (= c 125) (= c 44) (= c 35) (= c 64) (= c 96) (= c 37))
      (yfail s st pe (str "unexpected character '" (chr c) "'"))
      :else
      (let [[t e] (if (or flow multi) (plain-scalar s pe n flow)
                    (let [[e1 stop] (plain-line s pe false)] (values (subs s pe e1) stop)))]
        (with-anchor (make-scalar t false tag (:keep-tags (:opts st))) e 1 st anchor)))))

(defn- flow-node Values(YVal Int Int YS Str) [s: &Str p: Int st: YS]
  (let [c (at s p)]
    (if (and (= c 63) (ws-or-eol? s (+ p 1)))
      (flow-node s (skip-flow-ws s (+ p 1)) st)
      (parse-token s p -1 st true true))))

(defn- flow-colon? Bool [s: &Str j: Int adjacent-ok: Bool]
  (and (= (at s j) 58)
       (or adjacent-ok (ws-or-eol? s (+ j 1)) (flow-ind? (at s (+ j 1))))))

(defn- flow-seq Values(YVal Int Int YS Str) [s: &Str p: Int st0: YS]
  (let [[st1 ok] (enter st0)]
    (if (not ok) (yfail s st1 p "nesting exceeds the maximum depth")
      (loop [i (skip-flow-ws s (+ p 1)) items: Vec(YVal) [] size 1 st st1]
        (let [c (at s i)]
          (cond
            (< c 0) (yfail s st p "unterminated flow sequence")
            (= c 93) (values (->YSeq items) (+ i 1) size (leave st) "")
            :else
            (let [kc (at s i)
                  [k ke ksz st2 err] (flow-node s i st)]
              (if (not (= err "")) (values k ke ksz st2 err)
                (let [j (skip-flow-ws s ke)
                      [item ie isz st3 err2]
                      (if (flow-colon? s j (or (= kc 34) (= kc 39) (= kc 91) (= kc 123)))
                        (let [vp (skip-flow-ws s (+ j 1))
                              vc (at s vp)
                              [v ve vsz st4 verr] (if (or (= vc 44) (= vc 93)) (values (->YNull) vp 1 st2 "") (flow-node s vp st2))]
                          (values (->YMap [k] [v]) ve (+ 1 (+ ksz vsz)) st4 verr))
                        (values k ke ksz st2 ""))]
                  (if (not (= err2 "")) (values item ie isz st3 err2)
                    (let [j2 (skip-flow-ws s ie)
                          d (at s j2)]
                      (cond
                        (= d 44) (recur (skip-flow-ws s (+ j2 1)) (conj items item) (+ size isz) st3)
                        (= d 93) (values (->YSeq (conj items item)) (+ j2 1) (+ size isz) (leave st3) "")
                        (< d 0) (yfail s st3 p "unterminated flow sequence")
                        :else (yfail s st3 j2 "expected ',' or ']' in flow sequence")))))))))))))

(defn- flow-map Values(YVal Int Int YS Str) [s: &Str p: Int st0: YS]
  (let [[st1 ok] (enter st0)]
    (if (not ok) (yfail s st1 p "nesting exceeds the maximum depth")
      (loop [i (skip-flow-ws s (+ p 1)) ks: Vec(YVal) [] vs: Vec(YVal) [] size 1 st st1]
        (let [c (at s i)]
          (cond
            (< c 0) (yfail s st p "unterminated flow mapping")
            (= c 125) (values (->YMap ks vs) (+ i 1) size (leave st) "")
            :else
            (let [kc (at s i)
                  [k ke ksz st2 err] (flow-node s i st)]
              (if (not (= err "")) (values k ke ksz st2 err)
                (let [j (skip-flow-ws s ke)
                      [v ve vsz st3 err2]
                      (if (flow-colon? s j (or (= kc 34) (= kc 39) (= kc 91) (= kc 123)))
                        (let [vp (skip-flow-ws s (+ j 1))
                              vc (at s vp)]
                          (if (or (= vc 44) (= vc 125)) (values (->YNull) vp 1 st2 "") (flow-node s vp st2)))
                        (values (->YNull) ke 1 st2 ""))]
                  (if (not (= err2 "")) (values v ve vsz st3 err2)
                    (let [j2 (skip-flow-ws s ve)
                          d (at s j2)]
                      (cond
                        (= d 44) (recur (skip-flow-ws s (+ j2 1)) (conj ks k) (conj vs v) (+ size (+ ksz vsz)) st3)
                        (= d 125) (values (->YMap (conj ks k) (conj vs v)) (+ j2 1) (+ size (+ ksz vsz)) (leave st3) "")
                        (< d 0) (yfail s st3 p "unterminated flow mapping")
                        :else (yfail s st3 j2 "expected ',' or '}' in flow mapping")))))))))))))

(defn- flow-end-on-line Int [s: &Str p: Int]
  (let [le (line-end s p)]
    (loop [i p depth 0 q 0]
      (if (>= i le) -1
        (let [c (nth s i)]
          (cond
            (> q 0) (recur (+ i 1) depth (if (= c q) 0 q))
            (or (= c 34) (= c 39)) (recur (+ i 1) depth c)
            (or (= c 91) (= c 123)) (recur (+ i 1) (+ depth 1) 0)
            (or (= c 93) (= c 125)) (if (= depth 1) (+ i 1) (recur (+ i 1) (- depth 1) 0))
            :else (recur (+ i 1) depth 0)))))))

(defn- key-ahead? Bool [s: &Str q: Int]
  (let [[anchor tag pe perr] (parse-props s q)
        c (at s pe)
        e (cond
            (= c 42) (loop [k (+ pe 1)] (let [d (at s k)] (if (or (< d 0) (sp? d) (= d 10) (flow-ind? d)) k (recur (+ k 1)))))
            (= c 34) (let [[t e err errpos] (dq-scalar s pe)] (if (and (= err "") (<= e (line-end s pe))) e -1))
            (= c 39) (let [[t e err errpos] (sq-scalar s pe)] (if (and (= err "") (<= e (line-end s pe))) e -1))
            (or (= c 91) (= c 123)) (flow-end-on-line s pe)
            (or (< c 0) (= c 10)) -1
            :else (let [[e1 stop] (plain-line s pe false)] stop))]
    (if (< e 0) false
      (let [k (skip-sp s e)] (and (= (at s k) 58) (ws-or-eol? s (+ k 1)))))))

(defn- parse-node Values(YVal Int Int YS Str) [s: &Str p: Int n: Int st: YS ctx: Int]
  (let [q (skip-sp s p)
        c (at s q)
        [anchor tag pe perr] (if (or (= c 38) (= c 33)) (parse-props s q) (values "" "" q ""))
        own (and (= perr "") (> pe q) (rest-empty? s pe))]
    (cond
      (not (= perr "")) (yfail s st pe perr)
      (or own (rest-empty? s q))
      (let [here (if own pe q)
            here-end (let [k (skip-sp s here)] (if (= (at s k) 35) (line-end s k) k))
            c2 (next-content s here)
            k2 (col s c2)]
        (cond
          (or (>= c2 (count s)) (doc-marker? s c2) (and (< k2 n) (not (= k2 n))) (and (<= k2 n) (not (and (= k2 n) (= ctx 0) (= (at s c2) 45) (ws-or-eol? s (+ c2 1))))))
          (with-anchor (make-scalar "" (not (= tag "")) tag (:keep-tags (:opts st))) here-end 1 st anchor)
          (> k2 n)
          (let [[v e sz st2 err] (parse-content s c2 n st 1 tag)]
            (if (= err "") (with-anchor v e sz st2 anchor) (values v e sz st2 err)))
          :else
          (let [[v e sz st2 err] (parse-bseq s c2 st)]
            (if (= err "") (with-anchor v e sz st2 anchor) (values v e sz st2 err)))))
      :else (parse-content s q n st ctx ""))))

(defn- parse-content Values(YVal Int Int YS Str) [s: &Str q: Int n: Int st: YS ctx: Int tag0: &Str]
  (let [c (at s q)]
    (cond
      (and (= c 45) (ws-or-eol? s (+ q 1)))
      (if (= ctx 0) (yfail s st q "block sequence entries are not allowed here") (parse-bseq s q st))
      (and (= c 63) (ws-or-eol? s (+ q 1)))
      (if (= ctx 0) (yfail s st q "mapping keys are not allowed here") (parse-bmap s q st))
      (key-ahead? s q)
      (if (= ctx 0) (yfail s st q "mapping values are not allowed here") (parse-bmap s q st))
      (and (> (count tag0) 0) (not (or (= c 38) (= c 33) (= c 42) (= c 91) (= c 123))))
      (let [[v e sz st2 err] (parse-token s q n st false true)]
        (if (not (= err "")) (values v e sz st2 err)
          (values (make-scalar (scalar-text v) (match v (YStr x) true _ false) tag0 (:keep-tags (:opts st2))) e sz st2 "")))
      :else (parse-token s q n st false true))))

(defn- bad-tail Bool [s: &Str e: Int] (not (rest-empty? s e)))

(defn- parse-bmap Values(YVal Int Int YS Str) [s: &Str c0: Int st0: YS]
  (let [col0 (col s c0)
        [st1 ok] (enter st0)]
    (if (not ok) (yfail s st1 c0 "nesting exceeds the maximum depth")
      (loop [p c0 ks: Vec(YVal) [] vs: Vec(YVal) [] size 1 st st1]
        (let [explicit (and (= (at s p) 63) (ws-or-eol? s (+ p 1)))
              [k ke ksz st2 kerr] (if explicit (parse-node s (+ p 1) col0 st 1) (parse-token s p col0 st false false))]
          (if (not (= kerr "")) (values k ke ksz st2 kerr)
            (let [colon (if explicit
                          (let [nx (next-content s ke)]
                            (if (and (< nx (count s)) (= (col s nx) col0) (= (at s nx) 58) (ws-or-eol? s (+ nx 1))) nx -1))
                          (let [k1 (skip-sp s ke)] (if (and (= (at s k1) 58) (ws-or-eol? s (+ k1 1))) k1 -2)))]
              (if (= colon -2) (yfail s st2 (skip-sp s ke) "could not find expected ':'")
                (let [[v ve vsz st3 verr] (if (< colon 0) (values (->YNull) ke 1 st2 "") (parse-node s (+ colon 1) col0 st2 0))]
                  (cond
                    (not (= verr "")) (values v ve vsz st3 verr)
                    (bad-tail s ve) (yfail s st3 (skip-sp s ve) "unexpected content after a mapping value")
                    :else
                    (let [ks2 (conj ks k) vs2 (conj vs v) size2 (+ size (+ ksz vsz))
                          nx (next-content s ve)]
                      (cond
                        (or (>= nx (count s)) (doc-marker? s nx) (< (col s nx) col0))
                        (values (->YMap ks2 vs2) ve size2 (leave st3) "")
                        (> (col s nx) col0) (yfail s st3 nx "bad indentation of a mapping entry")
                        (and (= (at s nx) 45) (ws-or-eol? s (+ nx 1))) (values (->YMap ks2 vs2) ve size2 (leave st3) "")
                        :else (recur nx ks2 vs2 size2 st3)))))))))))))

(defn- parse-bseq Values(YVal Int Int YS Str) [s: &Str c0: Int st0: YS]
  (let [col0 (col s c0)
        [st1 ok] (enter st0)]
    (if (not ok) (yfail s st1 c0 "nesting exceeds the maximum depth")
      (loop [p c0 items: Vec(YVal) [] size 1 st st1]
        (let [[v ve vsz st2 err] (parse-node s (+ p 1) col0 st 1)]
          (cond
            (not (= err "")) (values v ve vsz st2 err)
            (bad-tail s ve) (yfail s st2 (skip-sp s ve) "unexpected content after a sequence entry")
            :else
            (let [items2 (conj items v) size2 (+ size vsz)
                  nx (next-content s ve)]
              (cond
                (or (>= nx (count s)) (doc-marker? s nx) (< (col s nx) col0))
                (values (->YSeq items2) ve size2 (leave st2) "")
                (> (col s nx) col0) (yfail s st2 nx "bad indentation of a sequence entry")
                (and (= (at s nx) 45) (ws-or-eol? s (+ nx 1))) (recur nx items2 size2 st2)
                :else (values (->YSeq items2) ve size2 (leave st2) "")))))))))

(defn- normalize Str [text: &Str]
  (let [t (if (and (= (at text 0) 239) (= (at text 1) 187) (= (at text 2) 191)) (subs text 3 (count text)) (str text))]
    (if (>= (str/index-of-byte t 0 13) (count t)) t
      (loop [i 0 out ""]
        (if (>= i (count t)) out
          (let [j (str/index-of-byte t i 13)
                out2 (if (> j i) (str out (subs t i j)) out)]
            (if (>= j (count t)) out2
              (recur (if (= (at t (+ j 1)) 10) (+ j 2) (+ j 1)) (str out2 "\n")))))))))

(defn- fresh YS [o: &YOpts] (let [a: Map(Str YVal) {} z: Map(Str Int) {}] (->YS a z 0 0 o 0)))

(defn parse-all-with Values(Vec(YVal) Str) [text: &Str opts: YOpts]
  (let [s (normalize text)
        n (count s)]
    (loop [p 0 docs: Vec(YVal) [] st (fresh opts) open false]
      (let [c (next-content s p)]
        (cond
          (>= c n) (values (if open (conj docs (->YNull)) docs) "")
          (and (= (col s c) 0) (= (at s c) 37))
          (if open (values docs (str (line-col s c) ": directive inside a document"))
            (recur (line-end s c) docs st false))
          (and (doc-marker? s c) (= (at s c) 46)) (recur (line-end s c) (if open (conj docs (->YNull)) docs) (fresh opts) false)
          :else
          (let [explicit (and (doc-marker? s c) (= (at s c) 45))
                [v e sz st2 err] (if explicit (parse-node s (+ c 3) -1 st 2) (parse-node s c -1 st 2))]
            (cond
              (not (= err "")) (values docs err)
              (bad-tail s e) (values docs (str (line-col s (skip-sp s e)) ": unexpected content after the document root"))
              :else
              (let [nx (next-content s e)]
                (cond
                  (>= nx n) (values (conj docs v) "")
                  (and (doc-marker? s nx) (= (at s nx) 46)) (recur (line-end s nx) (conj docs v) (fresh opts) false)
                  (doc-marker? s nx)
                  (if (rest-empty? s (+ nx 3))
                    (recur (line-end s nx) (conj docs v) (fresh opts) true)
                    (recur nx (conj docs v) (fresh opts) false))
                  :else (values docs (str (line-col s nx) ": expected the end of the document (bad indentation?)")))))))))))

(defn parse-all Values(Vec(YVal) Str) [text: &Str] (parse-all-with text (default-opts)))

(defn parse Values(YVal Str) [text: &Str]
  (let [[docs err] (parse-all text)]
    (if (not (= err "")) (values (->YNull) err)
      (if (= (count docs) 0) (values (->YNull) "") (values (nth docs 0) "")))))

(defrecord YDumpOpts [indent: Int seq-indent: Bool])

(defn default-dump-opts YDumpOpts [] (->YDumpOpts 2 true))

(defn- indicator? Bool [c: Int]
  (or (= c 45) (= c 63) (= c 58) (= c 44) (= c 91) (= c 93) (= c 123) (= c 125) (= c 35) (= c 38)
      (= c 42) (= c 33) (= c 124) (= c 62) (= c 39) (= c 34) (= c 37) (= c 64) (= c 96)))

(defn quote-needed? Bool [s: &Str]
  (let [n (count s)
        c0 (at s 0)]
    (cond
      (= n 0) true
      (match (resolve-plain s) (YStr x) false _ true) true
      (or (sp? c0) (sp? (nth s (- n 1)))) true
      (and (indicator? c0) (not (and (or (= c0 45) (= c0 63) (= c0 58)) (> n 1) (not (sp? (nth s 1)))))) true
      (or (starts-at? s 0 "---") (starts-at? s 0 "...")) true
      (= (nth s (- n 1)) 58) true
      :else
      (loop [i 0]
        (if (>= i n) false
          (let [c (nth s i)]
            (cond
              (or (< c 32) (= c 127)) true
              (and (= c 58) (sp? (at s (+ i 1)))) true
              (and (= c 35) (> i 0) (sp? (nth s (- i 1)))) true
              (and (= c 194) (= (at s (+ i 1)) 133)) true
              (and (= c 226) (= (at s (+ i 1)) 128) (or (= (at s (+ i 2)) 168) (= (at s (+ i 2)) 169))) true
              (and (= c 239) (= (at s (+ i 1)) 187) (= (at s (+ i 2)) 191)) true
              :else (recur (+ i 1)))))))))

(defn- hex2 Str [c: Int]
  (let [d "0123456789ABCDEF"] (str (subs d (bit-shift-right c 4) (+ (bit-shift-right c 4) 1)) (subs d (bit-and c 15) (+ (bit-and c 15) 1)))))

(defn quote-str Str [s: &Str]
  (let [n (count s)]
    (loop [i 0 out "\""]
      (if (>= i n) (str out "\"")
        (let [c (nth s i)]
          (recur (+ i 1)
                 (cond (= c 34) (str out "\\\"") (= c 92) (str out "\\\\") (= c 10) (str out "\\n")
                       (= c 9) (str out "\\t") (= c 13) (str out "\\r") (= c 0) (str out "\\0")
                       (or (< c 32) (= c 127)) (str out "\\x" (hex2 c))
                       :else (str out (chr c)))))))))

(defn- scalar-out Str [v: &YVal]
  (match v
    (YNull) "null"
    (YBool b) (if b "true" "false")
    (YInt t) (str t)
    (YFloat t) (str t)
    (YStr s) (if (quote-needed? s) (quote-str s) (str s))
    (YSeq xs) "[]"
    (YMap ks vs) "{}"
    (YTagged t x) (str t " " (scalar-out x))))

(defn- collection? Bool [v: &YVal]
  (match v (YSeq xs) (> (count xs) 0) (YMap ks vs) (> (count ks) 0) _ false))

(defn- spaces Str [n: Int] (loop [i 0 o ""] (if (>= i n) o (recur (+ i 1) (str o " ")))))

(defn- dump-block Str [out: Str v: &YVal ind: Int o: &YDumpOpts]
  (match v
    (YSeq xs)
    (loop [i 0 out out]
      (if (>= i (count xs)) out
        (let [x (nth xs i)
              pre (if (= i 0) out (str out "\n" (spaces ind)))
              body (if (collection? x) (dump-block (str pre "- ") x (+ ind 2) o) (str pre "- " (scalar-out x)))]
          (recur (+ i 1) body))))
    (YMap ks vs)
    (loop [i 0 out out]
      (if (>= i (count ks)) out
        (let [k (nth ks i)
              x (nth vs i)
              pre (if (= i 0) out (str out "\n" (spaces ind)))
              keyed (if (collection? k)
                      (str (dump-block (str pre "? ") k (+ ind 2) o) "\n" (spaces ind) ":")
                      (str pre (scalar-out k) ":"))
              body (match x
                     (YSeq xs)
                     (if (= (count xs) 0) (str keyed " []")
                       (let [si (if (:seq-indent o) (+ ind (:indent o)) ind)]
                         (dump-block (str keyed "\n" (spaces si)) x si o)))
                     (YMap mk mv)
                     (if (= (count mk) 0) (str keyed " {}")
                       (dump-block (str keyed "\n" (spaces (+ ind (:indent o)))) x (+ ind (:indent o)) o))
                     _ (str keyed " " (scalar-out x)))]
          (recur (+ i 1) body))))
    _ (str out (scalar-out v))))

(defn dump Str [v: &YVal o: &YDumpOpts]
  (str (dump-block "" v 0 o) "\n"))

(defn dump-all Str [docs: &Vec(YVal) o: &YDumpOpts]
  (loop [i 0 out ""]
    (if (>= i (count docs)) out
      (recur (+ i 1) (str out "---\n" (dump (nth docs i) o))))))
