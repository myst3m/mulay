(ns mulay.lib.bigint (:require [clay.bigint :as big]))

(def INT-MAX 9223372036854775807)
(def INT-MIN (- -9223372036854775807 1))

(defn add-ov? Bool [a: Int b: Int]
  (if (> b 0) (> a (- INT-MAX b)) (if (< b 0) (< a (- INT-MIN b)) false)))

(defn sub-ov? Bool [a: Int b: Int]
  (if (> b 0) (< a (+ INT-MIN b)) (if (< b 0) (> a (+ INT-MAX b)) false)))

(defn mul-ov? Bool [a: Int b: Int]
  (if (> a 0)
    (if (> b 0) (> a (quot INT-MAX b)) (< b (quot INT-MIN a)))
    (if (> b 0)
      (< a (quot INT-MIN b))
      (if (= a 0) false (< b (quot INT-MAX a))))))

(defn zero big/BigInt [] (big/int->bigint 0))

(defn one big/BigInt [] (big/int->bigint 1))

(defn is-zero? Bool [a: &big/BigInt] (= (big/sign a) 0))

(defn sign Int [a: &big/BigInt] (big/sign a))

(defn from-int big/BigInt [n: Int] (big/int->bigint n))

(defn fits-int? Bool [a: &big/BigInt] (let [[n e] (big/bigint->int a)] (= e "")))

(defn to-int Values(Int Str) [a: &big/BigInt]
  (let [[n e] (big/bigint->int a)] (if (= e "") (values n "") (values 0 "BigInteger out of long range"))))

(defn to-string Str [a: &big/BigInt] (str a))

(defn- digits? Bool [s: &Str from: Int to: Int]
  (and (< from to) (loop [i from] (if (>= i to) true (let [c (nth s i)] (if (and (>= c 48) (<= c 57)) (recur (+ i 1)) false))))))

(defn of-digits big/BigInt [s: &Str from: Int to: Int neg: Bool]
  (if (not (digits? s from to)) (zero)
    (let [[x e] (big/parse (subs s from to))] (if neg (- x) x))))

(defn parse Values(big/BigInt Str) [s: &Str]
  (let [n (count s)
        c0 (if (> n 0) (nth s 0) 0)
        start (if (or (= c0 45) (= c0 43)) 1 0)]
    (if (digits? s start n)
      (values (of-digits s start n (= c0 45)) "")
      (values (zero) (str "invalid integer: \"" s "\"")))))

(defn num-digits Int [a: &big/BigInt] (big/num-digits a))

(defn neg big/BigInt [a: big/BigInt] (- a))

(defn abs-big big/BigInt [a: big/BigInt] (if (< (big/sign a) 0) (- a) a))

(defn cmp Int [a: &big/BigInt b: &big/BigInt] (cond (< a b) -1 (> a b) 1 :else 0))

(defn cmp-abs Int [a: &big/BigInt b: &big/BigInt] (cmp (abs-big a) (abs-big b)))

(defn add big/BigInt [a: &big/BigInt b: &big/BigInt] (+ a b))

(defn sub big/BigInt [a: &big/BigInt b: &big/BigInt] (- a b))

(defn mul big/BigInt [a: &big/BigInt b: &big/BigInt] (* a b))

(defn mul-int big/BigInt [a: &big/BigInt k: Int] (* a (big/int->bigint k)))

(defn add-int big/BigInt [a: &big/BigInt k: Int] (+ a (big/int->bigint k)))

(defn divmod Values(big/BigInt big/BigInt Str) [a: &big/BigInt b: &big/BigInt]
  (let [[q r e] (big/divmod a b)] (if (= e "") (values q r "") (values (zero) (zero) "BigInteger divide by zero"))))

(defn quot-big Values(big/BigInt Str) [a: &big/BigInt b: &big/BigInt]
  (let [[q r e] (divmod a b)] (values q e)))

(defn rem-big Values(big/BigInt Str) [a: &big/BigInt b: &big/BigInt]
  (let [[q r e] (divmod a b)] (values r e)))

(defn divmod-small Values(big/BigInt Int) [a: &big/BigInt k: Int]
  (let [[q r e] (big/divmod a (big/int->bigint k))
        [ri re] (big/bigint->int r)]
    (values q ri)))

(defn pow10 big/BigInt [n: Int] (let [[p e] (big/pow10 n)] p))

(defn mul-pow10 big/BigInt [a: &big/BigInt n: Int]
  (if (or (= n 0) (is-zero? a)) (+ a (zero)) (* a (pow10 n))))

(defn divmod-pow10 Values(big/BigInt big/BigInt) [a: &big/BigInt n: Int]
  (if (= n 0) (values (+ a (zero)) (zero))
    (let [[q r e] (big/divmod a (pow10 n))] (values q r))))

(defn pow-big Values(big/BigInt Str) [a: &big/BigInt e: Int]
  (let [[r err] (big/pow a e)] (if (= err "") (values r "") (values (zero) "Negative exponent"))))

(defn gcd big/BigInt [a: &big/BigInt b: &big/BigInt] (big/gcd a b))

(defn even-big? Bool [a: &big/BigInt] (big/even? a))

(defn trailing-zeros Int [a: &big/BigInt] (big/trailing-zeros a))

(defn eq? Bool [a: &big/BigInt b: &big/BigInt] (= a b))
