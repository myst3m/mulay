(ns mulay.cli.help (:require [clay.string :as str]))

(defn overview Str [version: &Str]
  (str "mulay " version " - a lightweight Mule 4 runtime\n"
       "\n"
       "Usage: mulay <command> [arguments]\n"
       "\n"
       "Commands:\n"
       "  run       Run a Mule application\n"
       "  validate  Load and compile an application, report problems\n"
       "  inspect   Print the flows, processors and configs of an application\n"
       "  test      Run the application's MUnit test suites (src/test/munit)\n"
       "  dw        Evaluate a DataWeave script once and print the result\n"
       "  build     Build a single executable for one application\n"
       "  version   Print the version\n"
       "  help      Show help for a command\n"
       "\n"
       "<app> is a project directory, a deployable .jar, or a single .xml file. Leave it out\n"
       "(run, validate, inspect, build) to use the current directory.\n"
       "\n"
       "Options (run, validate, build):\n"
       "  key=value  Set a configuration property (overrides the app's own value); -p key=value works too\n"
       "  -P FILE    Read key=value properties from FILE, one per entry, separated by NUL bytes\n"
       "             (keeps secrets out of the command line)\n"
       "  -l LEVEL   Log level: TRACE, DEBUG, INFO (default), WARN, ERROR (run only)\n"
       "\n"
       "Run 'mulay help <command>' for details and examples."))

(defn usage-line Str [cmd: &Str]
  (cond
    (= cmd "run") "Usage: mulay run [<app>] [key=value ...] [-l LEVEL]"
    (= cmd "validate") "Usage: mulay validate [<app>] [key=value ...]"
    (= cmd "inspect") "Usage: mulay inspect [<app>] [key=value ...] [--props | --json]"
    (= cmd "test") "Usage: mulay test [<app>] [key=value ...] [--golden FILE]"
    (= cmd "dw") "Usage: mulay dw [--path <dir>]... <script.dwl> [name=mime:file ...]\n       mulay dw test [--path <dir>]... [-D name=value]... [<file-or-dir> ...]"
    (= cmd "build") "Usage: mulay build [<app>] -o <out> [key=value ...] [--encrypt -k <key>]"
    (= cmd "version") "Usage: mulay version"
    (= cmd "help") "Usage: mulay help [command]"
    :else "Usage: mulay <command> [arguments]"))

(defn- body Str [cmd: &Str]
  (cond
    (= cmd "run")
    (str "Runs the application until interrupted: HTTP listeners, schedulers and other sources start,\n"
         "and the flows they trigger run. <app> is a project directory (src/main/mule/*.xml and\n"
         "src/main/resources), a deployable .jar, or a single .xml file; without it, the current\n"
         "directory.\n"
         "\n"
         "Options:\n"
         "  key=value  Set a configuration property (overrides the app's own value); -p key=value works too\n"
         "  -P FILE    Read key=value properties from FILE, one per entry, separated by NUL bytes\n"
         "             (keeps secrets out of the command line)\n"
       "  -P FILE    Read key=value properties from FILE, one per entry, separated by NUL bytes\n"
       "             (keeps secrets out of the command line)\n"
         "  -l LEVEL   Log level: TRACE, DEBUG, INFO (default), WARN, ERROR\n"
         "\n"
         "Examples:\n"
         "  mulay run ./my-project\n"
         "  mulay run app-1.0.0-mule-application.jar\n"
         "  mulay run ./my-project http.port=8081\n"
         "  mulay run flows.xml -l DEBUG")
    (= cmd "validate")
    (str "Loads the application and compiles every DataWeave script without starting it.\n"
         "Prints a summary; problems go to stderr and the exit code is 1.\n"
         "\n"
         "Examples:\n"
         "  mulay validate ./my-project\n"
         "  mulay validate ./my-project env=dev")
    (= cmd "test")
    (str "Runs the MUnit test suites in <app>/src/test/munit (each suite with the application's configuration).\n"
         "Flow sources (listeners, schedulers) are not started. Prints SUCCESS, FAILURE, ERROR or SKIPPED for each test\n"
         "and a summary; the exit code is 1 when a test failed or had an error.\n"
         "--golden FILE writes the results in the form tools/munit-oracle compares.\n"
         "\n"
         "Examples:\n"
         "  mulay test ./my-project\n"
         "  mulay test ./my-project env=test")
    (= cmd "inspect")
    (str "Prints the loaded application: its flows, their processors, the global configs and the properties.\n"
         "Each property shows its resolved value and where it came from (command line, the file,\n"
         "environment, global-property, built-in). Values whose names look secret are shown as ****.\n"
         "key=value overrides properties as in run. --props prints only the properties.\n"
         "--json prints the application model as JSON (elements with their byte positions in the files,\n"
         "routes, error handlers, globals and diagnostics) for tools such as editors.\n"
         "\n"
         "Examples:\n"
         "  mulay inspect ./my-project\n"
         "  mulay inspect app.jar env=prod --props")
    (= cmd "dw")
    (str "Evaluates a DataWeave script once and prints the result. Each input is name=mime:file,\n"
         "for example payload=application/json:in.json (the name is the variable the script reads).\n"
         "\n"
         "Modules (import * from a::b::C reads a/b/C.dwl) are searched in this order: each --path\n"
         "directory, the script's directory, the src/main/resources of the Mule project that holds\n"
         "the script, and the src/main/resources of the project of the current directory.\n"
         "\n"
         "Examples:\n"
         "  mulay dw script.dwl\n"
         "  mulay dw script.dwl payload=application/json:in.json\n"
         "  mulay dw --path src/main/resources test/twice.dwl\n"
         "\n"
         "mulay dw test runs dw::test suites (import * from dw::test::Tests): every .dwl script under\n"
         "the given files and directories (default src/test/dw, or the current directory) whose result is\n"
         "a TestResult. It prints one line per test and the failures, and exits with 1 when a test\n"
         "FAILs or ERRORs. -D sets a system property, for example -D testToRun=create,update.\n"
         "\n"
         "  mulay dw test src/test/dw\n"
         "  mulay dw test -D testToRun=customer --path src/main/resources src/test/dw\n"
         "  mulay dw script.dwl payload=application/xml:in.xml")
    (= cmd "build")
    (str "Builds one executable that embeds the application (configuration files and resources) and\n"
         "compiles its DataWeave scripts to native code. The executable runs without the project,\n"
         "the .jar or a JVM. Needs clay and clang, and the mulay source (MULAY_SRC, or ../src next\n"
         "to the mulay executable). See docs/aot.md.\n"
         "\n"
         "Options:\n"
         "  -o <out>   Path of the executable to write (required)\n"
         "  key=value  Set a configuration property (-p key=value works too). It checks the application,\n"
         "             precompiles its DataWeave scripts and is embedded in the executable, which\n"
         "             still takes its own key=value options when it runs (they win)\n"
         "  --encrypt  Encrypt the embedded properties (AES-256, key from -k or MULAY_KEY). The executable\n"
         "             then needs the same key when it runs; without --encrypt they are only encoded\n"
         "  -k <key>   The key for --encrypt (--key also works; or set the environment variable MULAY_KEY)\n"
         "\n"
         "Examples:\n"
         "  mulay build ./my-project -o my-app\n"
         "  mulay build ./my-project -o my-app http.port=8081\n"
         "  mulay build ./my-project -o my-app db.password=s3cret --encrypt -k <key>\n"
         "  ./my-app http.port=8081 -l DEBUG\n"
         "  ./my-app -k <key>")
    (= cmd "version")
    "Prints the mulay version (and the number of precompiled DataWeave scripts in a built executable)."
    (= cmd "help")
    (str "Shows the list of commands, or the details of one command.\n"
         "\n"
         "Examples:\n"
         "  mulay help\n"
         "  mulay help run\n"
         "  mulay run --help")
    :else ""))

(defn command-help Str [cmd: &Str]
  (let [b (body cmd)]
    (if (= b "") "" (let [u (usage-line cmd)] (str u "\n\n" b)))))

(defn embedded-help Str [exe: &Str]
  (str "Usage: " exe " [key=value ...] [-k <key>] [-l LEVEL]\n"
       "\n"
       "Runs the Mule application embedded in this executable (built with mulay build).\n"
       "\n"
       "Options:\n"
       "  key=value  Set a configuration property (overrides the app's own value); -p key=value works too\n"
       "  -P FILE    Read key=value properties from FILE, one per entry, separated by NUL bytes\n"
       "             (keeps secrets out of the command line)\n"
       "  -k <key>   The key for the encrypted properties embedded at build time (or set MULAY_KEY)\n"
       "  -l LEVEL   Log level: TRACE, DEBUG, INFO (default), WARN, ERROR\n"
       "  version    Print the version\n"
       "  --help     Show this help"))
