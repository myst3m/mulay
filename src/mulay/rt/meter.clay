(ns mulay.rt.meter)

(defrecord FlowCount [received: Int dispatched: Int errors: Int])

(def ON (atom false))
(def STATS (atom false))
(def FLOWS (atom (let [m: Map(Str FlowCount) {}] m)))
(def ERRORS (atom (let [m: Map(Str Int) {}] m)))

(defn enable! Int [on: Bool stats: Bool]
  (let [a (reset! ON on) b (reset! STATS (and on stats))] 0))

(defn clear! Int []
  (let [a (reset! FLOWS (let [m: Map(Str FlowCount) {}] m))
        b (reset! ERRORS (let [m: Map(Str Int) {}] m))]
    0))

(defn- zero FlowCount [] (->FlowCount 0 0 0))

(defn- bump Map(Str FlowCount) [m: Map(Str FlowCount) name: Str what: Int]
  (let [c (if (contains? m name) (get! m name) (zero))
        c2 (cond (= what 0) (assoc c :received (+ (:received c) 1))
                 (= what 1) (assoc c :dispatched (+ (:dispatched c) 1))
                 :else (assoc c :errors (+ (:errors c) 1)))]
    (assoc m name c2)))

(defn- count-flow Int [name: &Str what: Int]
  (if (deref STATS) (let [z (swap! FLOWS bump (str name) what)] 0) 0))

(defn flow-received Int [name: &Str] (count-flow name 0))
(defn flow-dispatched Int [name: &Str] (count-flow name 1))
(defn flow-error Int [name: &Str] (count-flow name 2))

(defn- inc-type Map(Str Int) [m: Map(Str Int) t: Str]
  (assoc m t (+ (if (contains? m t) (get! m t) 0) 1)))

(defn error-raised Int [t: &Str]
  (if (deref ON) (let [z (swap! ERRORS inc-type (str t))] 0) 0))

(defn flow-count FlowCount [name: &Str]
  (let [m (deref FLOWS)] (if (contains? m name) (get! m name) (zero))))

(defn flow-names Vec(Str) [] (sort (keys (deref FLOWS))))

(defn error-count Int [t: &Str]
  (let [m (deref ERRORS)] (if (contains? m t) (get! m t) 0)))

(defn error-types Vec(Str) [] (sort (keys (deref ERRORS))))
