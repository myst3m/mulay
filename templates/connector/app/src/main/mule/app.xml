<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:toy="http://www.mulesoft.org/schema/mule/toy">
  <http:listener-config name="L"><http:listener-connection host="127.0.0.1" port="18391"/></http:listener-config>
  <toy:config name="T" listenerConfig="L" path="/ping"/>
  <flow name="f">
    <http:listener config-ref="L" path="/shout"/>
    <toy:shout text="#[attributes.queryParams.w]"/>
  </flow>
  <flow name="p">
    <toy:ping-listener config-ref="T"/>
    <set-payload value="#['pong ' ++ payload]"/>
  </flow>
</mule>
