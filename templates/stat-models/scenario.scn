%%% note
stat-models (統計的なモデルの API。embed.hash512.stat と llm.tfidf.stat)。stat/*.dwl は agent-harness のものを共有する。
埋め込み (OpenAI、Azure、Ollama の旧式と新式、/k/<鍵> の前置き、dimensions の誤り)、鍵の誤り、
統計的な LLM (agent-harness の Inference コネクタの形でツールを選ぶ・結果から答える、普通の会話の tool のメッセージ、
ツールなし、ストリーミングは断る)。
%%% jvm -Dhttp.port=18474 -Dapi.key=test-key
%%% port 18474
%%% mask
chatcmpl-stat-([0-9a-f-]+)
"created": ?(\d+)
%%% request GET /
%%% response 200
content-type: application/json; charset=UTF-8

{
  "name": "stat-models",
  "what": "Statistical models without any neural network, served by a Mule app (mulay templates/stat-models).",
  "endpoints": [
    "POST /v1/embeddings",
    "POST /openai/deployments/{deployment}/embeddings",
    "POST /api/embeddings",
    "POST /api/embed",
    "GET /api/tags",
    "POST /v1/chat/completions",
    "GET /v1/models"
  ],
  "auth": "Authorization: Bearer <key>, api-key: <key>, ?api-key=<key>, or the base URL https://<host>/k/<key>",
  "source": "mulay templates/stat-models (stat/*.dwl shared with templates/agent-harness)"
}
%%% request GET /health
%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": "ok"
}
%%% request POST /v1/embeddings
content-type: application/json

{"input":"x"}
%%% response 401
content-type: application/json; charset=UTF-8

{
  "error": {
    "message": "Incorrect API key provided.",
    "type": "invalid_request_error",
    "param": null,
    "code": null
  }
}
%%% request POST /openai/deployments/emb/embeddings?api-version=2024-02-01
api-key: wrong
content-type: application/json

{"input":["x"]}
%%% response 401
content-type: application/json; charset=UTF-8

{
  "error": {
    "code": "401",
    "message": "Access denied due to invalid subscription key or wrong API endpoint."
  }
}
%%% request GET /api/tags
%%% response 401
content-type: application/json; charset=UTF-8

{
  "error": "unauthorized"
}
