%%% request GET /mock-llm/last
%%% response 200
content-type: application/json; charset=UTF-8

{
  "authorization": "Bearer sk-mock",
  "body": {
    "model": "mock-model",
    "messages": [
      {
        "role": "system",
        "content": "You are a helpful agent. Use the tools when they help. - The data is JSON: question, history (earlier turns, oldest first; an item with role summary sums up the turns before them) and toolResults (tools already called in this turn). Answer the question; call a tool only when the answer needs it."
      },
      {
        "role": "user",
        "content": "{\"question\": \"fourth\",\"history\": [{\"role\": \"user\",\"content\": \"again\"},{\"role\": \"assistant\",\"content\": \"You said: again (history: 2 messages, tools: lookup_order,search_docs,ask_agent,add)\"},{\"role\": \"user\",\"content\": \"third\"},{\"role\": \"assistant\",\"content\": \"You said: third (history: 4 messages, tools: lookup_order,search_docs,ask_agent,add)\"}],\"toolResults\": []}"
      }
    ],
    "max_tokens": 500,
    "temperature": 0.9,
    "top_p": 0.9,
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "lookup_order",
          "description": "Looks up an order by its id and returns its status.",
          "parameters": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Order id: one capital letter and three digits, e.g. A100"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "search_docs",
          "description": "Searches the knowledge base (documents added through the admin MCP server) and returns the passages closest to the query.",
          "parameters": {
            "type": "object",
            "properties": {
              "query": {
                "type": "string",
                "description": "What to look for"
              }
            },
            "required": [
              "query"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "ask_agent",
          "description": "Asks another agent (over A2A) and returns its answer.",
          "parameters": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "description": "What to ask the other agent"
              }
            },
            "required": [
              "text"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "add",
          "description": "Adds two numbers",
          "parameters": {
            "type": "object",
            "properties": {
              "a": {
                "type": "number"
              },
              "b": {
                "type": "number"
              }
            },
            "required": [
              "a",
              "b"
            ]
          }
        }
      }
    ]
  }
}
