(ns host-test (:require [mulay.lib.host :as h] [clay.string :as str]))
(deftest norm
  (is (= (h/norm-path "a/b") "/a/b"))
  (is (= (h/norm-path "/a//./b/") "/a/b"))
  (is (= (h/norm-path "/a/../../b") "/b"))
  (is (= (h/norm-path "") "/")))
(deftest mem-files
  (let [z (h/mount! ["/app/src/main/mule/a.xml" "app/src/main/resources/c.yaml" "/app/pom.xml"] ["<a/>" "x: 1" "<project/>"])
        [t e] (h/mem-read "/app/./src/main/mule/a.xml")
        [t2 e2] (h/mem-read "/app/nope")
        [ls le] (h/mem-list "/app")
        [ls2 le2] (h/mem-list "/app/src/main")
        [ls3 le3] (h/mem-list "/app/missing")
        w (h/mem-write "/app/out.txt" "hi")
        [t4 e4] (h/mem-read "app/out.txt")]
    (is (= z 3))
    (is (= t "<a/>"))
    (is (= e ""))
    (is (= e2 "/app/nope: No such file or directory"))
    (is (= (str/join "," ls) "pom.xml,src"))
    (is (= le ""))
    (is (= (str/join "," ls2) "mule,resources"))
    (is (= (count ls3) 0))
    (is (not= le3 ""))
    (is (h/mem-dir? "/app/src"))
    (is (h/mem-dir? "/"))
    (is (not (h/mem-dir? "/app/pom.xml")))
    (is (h/mem-exists? "/app/pom.xml"))
    (is (h/mem-exists? "/app/src/main"))
    (is (not (h/mem-exists? "/app/src/mainx")))
    (is (= w ""))
    (is (= t4 "hi"))))
(deftest native-files
  (let [[t e] (h/file-read "test/host/host_test.clay")]
    (is (= e ""))
    (is (str/starts-with? t "(ns host-test"))
    (is (h/file-dir? "test/host"))
    (is (h/file-exists? "test/host/host_test.clay"))
    (is (= (h/file-read-or "test/host/none" "d") "d"))))
(deftest frozen-clock
  (let [a (h/set-clock! 1792832400123)
        [s ns] (h/now-ns)
        [s2 ns2] (h/now-ns)
        m (h/now-ms)
        b (h/set-clock! -1500)
        [s3 ns3] (h/now-ns)
        c (h/clear-clock!)
        [s4 ns4] (h/now-ns)]
    (is (= s 1792832400))
    (is (= ns 123000000))
    (is (= s2 s))
    (is (= m 1792832400123))
    (is (= s3 -2))
    (is (= ns3 500000000))
    (is (> s4 1700000000))))
(deftest seeded-random
  (let [a (h/set-seed! 1)
        [x ok] (h/random-bytes 20)
        [y ok2] (h/random-bytes 20)
        b (h/set-seed! 1)
        [x2 ok3] (h/random-bytes 20)
        [y2 ok4] (h/random-bytes 20)
        c (h/set-seed! 2)
        [z ok5] (h/random-bytes 20)
        d (h/clear-seed!)
        [r ok6] (h/random-bytes 20)
        e (h/set-seed! 1)
        [w ok7] (h/random-bytes 8)]
    (is (and ok ok2 ok3 ok4 ok5 ok6 ok7))
    (is (= (count x) 20))
    (is (= x x2))
    (is (= y y2))
    (is (not= x y))
    (is (not= x z))
    (is (= (count r) 20))
    (is (= w (subs x 0 8)))
    (is (= (nth w 0) 0x91))
    (is (= (nth w 7) 0xc1))))
