(ns random-test (:require [mulay.lib.host :as h] [mulay.lib.random :as rnd] [mulay.lib.crypto :as cr]))

;; 暗号に使う乱数 (rnd/random-bytes、cr/random-bytes) は、note が種を決めても OS の乱数のまま。
;; 種で決まるのは rnd/seeded-bytes (DW の random・uuid、SQL の random) だけ
(deftest crypto-random-ignores-the-seed
  (let [a (h/set-seed! 1)
        [x ok] (rnd/random-bytes 16)
        [c ok2] (cr/random-bytes 16)
        b (h/set-seed! 1)
        [y ok3] (rnd/random-bytes 16)
        [d ok4] (cr/random-bytes 16)
        e (h/set-seed! 1)
        [s1 ok5] (rnd/seeded-bytes 16)
        f (h/set-seed! 1)
        [s2 ok6] (rnd/seeded-bytes 16)
        z (h/clear-seed!)]
    (is (and ok ok2 ok3 ok4 ok5 ok6))
    (is (not= x y))
    (is (not= c d))
    (is (= s1 s2))))

(deftest real-random-bytes-sizes
  (let [[a ok1] (h/real-random-bytes 0)
        [b ok2] (h/real-random-bytes 2097152)
        [c ok3] (h/real-random-bytes -1)]
    (is (and ok1 ok2 (not ok3)))
    (is (= (count a) 0))
    (is (= (count b) 2097152))
    (is (not= (subs b 0 16) (subs b 2097136 2097152)))))

(deftest rand-below-without-seed-leaves-rand-int-alone
  (let [z0 (h/clear-seed!)
        s1 (rand-seed 42)
        a (rand-int 1000000000)
        s2 (rand-seed 42)
        r (h/rand-below 1000000000)
        b (rand-int 1000000000)]
    (is (= a b))
    (is (and (>= r 0) (< r 1000000000)))))
