%%% note
由来: mulay の数値担当の調査 (df.txt)
%%% script
%dw 2.0
import * from dw::util::Diff
output application/json
---
diff({x: {y: "a"}}, {x: {y: true}}, {}, "root")
%%% output application/json
{
  "matches": false,
  "diffs": [
    {
      "expected": "true",
      "actual": "\"a\"",
      "path": "root.x.y"
    }
  ]
}
