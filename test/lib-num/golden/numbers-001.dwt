%%% note
由来: mulay の数値担当の調査 (n1.txt)
%%% script
%dw 2.0
import * from dw::core::Numbers
output application/json
---
[toHex(255), toHex(-255), toHex(0), toHex(1e30), toBinary(5), toBinary(-5), toBinary(0)]
%%% output application/json
[
  "ff",
  "-ff",
  "0",
  "c9f2c9cd04674edea40000000",
  "101",
  "-101",
  "0"
]
