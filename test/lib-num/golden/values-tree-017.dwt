---
{a: 1, p: {password: "x", q: [{password: "y"}]}} mask "password" with "***"
%%% output application/json
{
  "a": 1,
  "p": {
    "password": "***",
    "q": [
      {
        "password": "***"
      }
    ]
  }
}
