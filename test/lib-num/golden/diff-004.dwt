%%% note
由来: mulay の数値担当の調査 (df.txt)
%%% script
%dw 2.0
import * from dw::util::Diff
output application/json
---
diff({a: 1, b: 2}, {b: 2, a: 1})
%%% output application/json
{
  "matches": false,
  "diffs": [
    {
      "expected": "Entry (root).a with type Number",
      "actual": "was not present in object.",
      "path": "(root).a"
    },
    {
      "expected": "Entry (root).b with type Number",
      "actual": "was not present in object.",
      "path": "(root).b"
    }
  ]
}
