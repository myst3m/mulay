%%% note
由来: mulay の数値担当の調査 (df.txt)
%%% script
%dw 2.0
import * from dw::util::Diff
output application/json
---
diff({a @(x: 1): 1}, {a @(x: 2): 1})
%%% output application/json
{
  "matches": false,
  "diffs": [
    {
      "expected": "2",
      "actual": "1",
      "path": "(root).a.@.x"
    }
  ]
}
