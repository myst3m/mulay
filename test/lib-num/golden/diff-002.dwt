%%% note
由来: mulay の数値担当の調査 (df.txt)
%%% script
%dw 2.0
import * from dw::util::Diff
output application/json
---
diff({a: 1, b: 2, c: [1, 2]}, {a: 2, b: 3, c: [1, 3]})
%%% output application/json
{
  "matches": false,
  "diffs": [
    {
      "expected": "3",
      "actual": "2",
      "path": "(root).c[1]"
    },
    {
      "expected": "3",
      "actual": "2",
      "path": "(root).b"
    },
    {
      "expected": "2",
      "actual": "1",
      "path": "(root).a"
    }
  ]
}
