%%% note
由来: mulay の数値担当の調査 (df.txt)
%%% script
%dw 2.0
import * from dw::util::Diff
output application/json
---
diff({a: {b: 1}}, {a: "s"})
%%% output application/json
{
  "matches": false,
  "diffs": [
    {
      "expected": "\"s\"",
      "actual": "{\n  b: 1\n}",
      "path": "(root).a"
    }
  ]
}
