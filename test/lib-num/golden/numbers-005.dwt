%%% note
由来: mulay の数値担当の調査 (n1.txt)
%%% script
%dw 2.0
import * from dw::core::Numbers
output application/json
---
[fromHex("ff"), fromHex("FF"), fromHex("-ff"), fromHex("7fffffffffffffffffff"), fromBinary("101"), fromBinary("-101")]
%%% output application/json
[
  255,
  255,
  -255,
  604462909807314587353087,
  5,
  -5
]
