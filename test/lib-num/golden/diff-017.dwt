%%% note
由来: mulay の数値担当の調査 (df.txt)
%%% script
%dw 2.0
import * from dw::util::Diff
output application/json
---
diff({a: 1, b: 2}, {c: 1, a: 2})
%%% output application/json
{
  "matches": false,
  "diffs": [
    {
      "expected": "Entry (root).a with type Number",
      "actual": "was not present in object.",
      "path": "(root).a"
    },
    {
      "expected": "Entry (root).c with type Number",
      "actual": "was not present in object.",
      "path": "(root).c"
    }
  ]
}
