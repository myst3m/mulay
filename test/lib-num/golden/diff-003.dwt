%%% note
由来: mulay の数値担当の調査 (df.txt)
%%% script
%dw 2.0
import * from dw::util::Diff
output application/json
---
diff({a: 1}, {a: 1, b: 2})
%%% output application/json
{
  "matches": false,
  "diffs": [
    {
      "expected": "Object size is 2",
      "actual": "1",
      "path": "(root)"
    }
  ]
}
