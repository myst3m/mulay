%%% note
由来: mulay の数値担当の調査 (df.txt)
%%% script
%dw 2.0
import * from dw::util::Diff
output application/json
---
diff([{a: 1}, {a: 2}], [{a: 3}, {a: 4}])
%%% output application/json
{
  "matches": false,
  "diffs": [
    {
      "expected": "4",
      "actual": "2",
      "path": "(root)[1].a"
    },
    {
      "expected": "3",
      "actual": "1",
      "path": "(root)[0].a"
    }
  ]
}
