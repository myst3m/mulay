%%% note
由来: mulay の数値担当の調査 (df.txt)
%%% script
%dw 2.0
import * from dw::util::Diff
output application/json
---
diff([1, 2], [1, 2, 3])
%%% output application/json
{
  "matches": false,
  "diffs": [
    {
      "expected": "Array size is 3",
      "actual": "was 2",
      "path": "(root)"
    }
  ]
}
