%%% note
由来: mulay の数値担当の調査 (df.txt)
%%% script
%dw 2.0
import * from dw::util::Diff
output application/json
---
diff({a: 1}, {a @(x: 2): 1})
%%% output application/json
{
  "matches": false,
  "diffs": [
    {
      "expected": "Attributes {\n  x: 2\n}",
      "actual": "Empty attributes.",
      "path": "(root).a.@"
    }
  ]
}
