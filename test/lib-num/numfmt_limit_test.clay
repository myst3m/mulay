(ns numfmt-limit-test (:require [mulay.dw.numfmt :as nf] [mulay.lib.dec :as d]))

(defn- dp d/Dec [s: &Str] (let [[x e] (d/parse s)] x))
(defn- fmt Str [x: Str pat: Str] (let [[s pe e] (nf/format-dec (dp x) pat "" d/HALF-EVEN)] (if (= pe "") (if (= e "") s e) pe)))

;; 整数部が 1 千万桁を超える数は書かずに失敗する (1e999999999 で約 2.6 GB を確保してプロセスごと落ちていた)
(deftest huge-integer-part
  (is (= (fmt "1e999999999" "#,##0.00") d/TOO-BIG))
  (is (= (fmt "1e999999999" "0") d/TOO-BIG))
  (is (= (fmt "1e999999999" "#%") d/TOO-BIG))
  (is (= (fmt "1e999999999" "0.###E0") "1E999999999"))
  (is (= (fmt "1e-999999999" "0.0#####") "0.0"))
  (is (= (fmt "12345.678" "#,##0.00") "12,345.68")))
