(ns math-test (:require [mulay.lib.numparse :as npz] [mulay.dw.lib.math :as m] [mulay.dw.lib.numbers :as nb] [mulay.lib.dec :as d] [mulay.lib.bigint :as bi]
                        [mulay.dw.num :as num] [mulay.dw.val :as v] [clay.string :as str] [math-sqrt-data :as g]))

;; decimalSqrt の核 (BigDecimal.sqrt(MathContext) 互換) を Java 17 の結果と照合する。

(defn- dp d/Dec [s: &Str] (let [[x e] (d/parse s)] x))

(defn- run-sqrt Int []
  (let [lines: Vec(Str) (str/split (g/cases) "\n")]
    (loop [i 0 bad 0]
      (if (>= i (count lines)) bad
        (if (= (nth lines i) "") (recur (+ i 1) bad)
          (let [f: Vec(Str) (str/split (nth lines i) "\t")
                [r e] (m/dec-sqrt (dp (nth f 0)) (npz/int-or (nth f 1) 0) (npz/int-or (nth f 2) 0))
                got (if (= e "") (d/to-string r) (str "ERR:" e))]
            (if (= got (nth f 3)) (recur (+ i 1) bad)
              (let [z (println (str "MISMATCH " (nth lines i) " got " got))] (recur (+ i 1) (+ bad 1))))))))))

(deftest sqrt-golden
  (let [bad (run-sqrt)] (is (= bad 0))))

(deftest isqrt-small
  (let [r (m/isqrt (bi/from-int 99))] (is (= (bi/to-string r) "9"))))

(deftest int-value-java
  (let [[n e] (num/parse-lit "1e10")] (is (= (m/int-value n) 1410065408))))

(deftest radix
  (let [[x e] (nb/to-radix (num/from-int -255) 16)]
    (is (v/equal? x (v/->VStr "-ff")))))
