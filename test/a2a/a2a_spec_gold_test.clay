         "{\"name\":\"n\",\"description\":\"d\",\"url\":\"u\",\"version\":\"1\",\"capabilities\":{\"streaming\":true,\"pushNotifications\":false,\"stateTransitionHistory\":false,\"extensions\":[{\"description\":null,\"params\":null,\"required\":true,\"uri\":\"x\"}]},\"defaultInputModes\":[],\"defaultOutputModes\":[],\"skills\":[],\"supportsAuthenticatedExtendedCard\":false,\"preferredTransport\":\"JSONRPC\",\"protocolVersion\":\"0.3.0\"}")))
