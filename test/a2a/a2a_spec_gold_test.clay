(ns a2a-spec-gold-test (:require [mulay.conn.a2a_spec :as spec]))

;; 生成物: tools/gen-a2a-golden.java (手で編集しない)。期待値は a2a-java-sdk 0.3.3 と Jackson 2.17.0 が
;; 読んで書き直した JSON、または読めないときの例外の文言 ("ERR " を前に付ける)。

(defn- run Str [t: Str j: Str] (let [[o e] (spec/canon t j "<ts>")] (if (= e "") o (str "ERR " e))))

(deftest sdk-canonical
  (is (= (run "EventKind" "{\"kind\":\"message\",\"role\":\"agent\",\"messageId\":\"m1\",\"parts\":[{\"kind\":\"text\",\"text\":\"hi\"}]}")
         "{\"role\":\"agent\",\"parts\":[{\"text\":\"hi\",\"kind\":\"text\"}],\"messageId\":\"m1\",\"kind\":\"message\"}"))
  (is (= (run "EventKind" "{\"messageId\":\"m1\",\"role\":\"user\",\"parts\":[{\"text\":\"a\",\"kind\":\"text\",\"metadata\":{\"k\":1}}],\"kind\":\"message\",\"contextId\":\"c\",\"taskId\":\"t\",\"referenceTaskIds\":[\"r1\"],\"extensions\":[],\"metadata\":{\"z\":true,\"a\":[1,2.5,\"x\",null]}}")
         "{\"role\":\"user\",\"parts\":[{\"text\":\"a\",\"metadata\":{\"k\":1},\"kind\":\"text\"}],\"messageId\":\"m1\",\"contextId\":\"c\",\"taskId\":\"t\",\"referenceTaskIds\":[\"r1\"],\"metadata\":{\"z\":true,\"a\":[1,2.5,\"x\",null]},\"extensions\":[],\"kind\":\"message\"}"))
  (is (= (run "EventKind" "{\"kind\":\"task\",\"id\":\"t1\",\"contextId\":\"c1\",\"status\":{\"state\":\"completed\"}}")
         "{\"id\":\"t1\",\"contextId\":\"c1\",\"status\":{\"state\":\"completed\",\"timestamp\":\"<ts>\"},\"artifacts\":[],\"history\":[],\"kind\":\"task\"}"))
  (is (= (run "EventKind" "{\"kind\":\"task\",\"id\":\"t1\",\"contextId\":\"c1\",\"status\":{\"state\":\"working\",\"timestamp\":\"2026-01-02T03:04:05Z\"},\"artifacts\":[{\"artifactId\":\"a\",\"parts\":[{\"kind\":\"data\",\"data\":{\"x\":1}}]}],\"history\":[{\"kind\":\"message\",\"role\":\"user\",\"messageId\":\"m\",\"parts\":[{\"kind\":\"file\",\"file\":{\"uri\":\"http://x/y\",\"mimeType\":\"text/plain\"}}]}],\"metadata\":{}}")
         "{\"id\":\"t1\",\"contextId\":\"c1\",\"status\":{\"state\":\"working\",\"timestamp\":\"2026-01-02T03:04:05Z\"},\"artifacts\":[{\"artifactId\":\"a\",\"parts\":[{\"data\":{\"x\":1},\"kind\":\"data\"}]}],\"history\":[{\"role\":\"user\",\"parts\":[{\"file\":{\"mimeType\":\"text/plain\",\"uri\":\"http://x/y\"},\"kind\":\"file\"}],\"messageId\":\"m\",\"kind\":\"message\"}],\"metadata\":{},\"kind\":\"task\"}"))
  (is (= (run "EventKind" "{\"kind\":\"task\",\"id\":\"t1\",\"contextId\":\"c1\",\"status\":{\"state\":\"failed\",\"timestamp\":\"2026-01-02T03:04:05.120+09:00\"}}")
         "{\"id\":\"t1\",\"contextId\":\"c1\",\"status\":{\"state\":\"failed\",\"timestamp\":\"2026-01-01T18:04:05.12Z\"},\"artifacts\":[],\"history\":[],\"kind\":\"task\"}"))
  (is (= (run "EventKind" "{\"kind\":\"task\",\"id\":\"t1\",\"contextId\":\"c1\",\"status\":{\"state\":\"input-required\",\"timestamp\":\"2026-01-02T03:04:00.000Z\"}}")
         "{\"id\":\"t1\",\"contextId\":\"c1\",\"status\":{\"state\":\"input-required\",\"timestamp\":\"2026-01-02T03:04:00Z\"},\"artifacts\":[],\"history\":[],\"kind\":\"task\"}"))
  (is (= (run "EventKind" "{\"kind\":\"message\",\"role\":\"agent\",\"messageId\":\"m\",\"parts\":[{\"kind\":\"file\",\"file\":{\"bytes\":\"aGk=\",\"name\":\"f.txt\"}}]}")
         "{\"role\":\"agent\",\"parts\":[{\"file\":{\"name\":\"f.txt\",\"bytes\":\"aGk=\"},\"kind\":\"file\"}],\"messageId\":\"m\",\"kind\":\"message\"}"))
  (is (= (run "EventKind" "plain text, not an event")
         "ERR Unrecognized token 'plain': was expecting (JSON String, Number, Array, Object or token 'null', 'true' or 'false')\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 6]"))
  (is (= (run "EventKind" "{\"kind\":\"other\"}")
         "ERR Could not resolve type id 'other' as a subtype of `io.a2a.spec.EventKind`: known type ids = [message, task]\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 9]"))
  (is (= (run "EventKind" "{\"role\":\"agent\"}")
         "ERR Could not resolve subtype of [simple type, class io.a2a.spec.EventKind]: missing type id property 'kind'\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 16]"))
  (is (= (run "EventKind" "{\"kind\":\"message\",\"role\":\"agent\",\"parts\":[{\"kind\":\"text\",\"text\":\"x\"}]}")
         "ERR Cannot construct instance of `io.a2a.spec.Message`, problem: Parameter 'messageId' may not be null\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 70]"))
  (is (= (run "EventKind" "{\"kind\":\"message\",\"role\":\"agent\",\"messageId\":\"m\",\"parts\":[]}")
         "ERR Cannot construct instance of `io.a2a.spec.Message`, problem: Parts cannot be empty\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 60]"))
  (is (= (run "EventKind" "{\"kind\":\"message\",\"role\":\"robot\",\"messageId\":\"m\",\"parts\":[{\"kind\":\"text\",\"text\":\"x\"}]}")
         "ERR Cannot deserialize value of type `io.a2a.spec.Message$Role` from String \"robot\": not one of the values accepted for Enum class: [user, agent]\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 26] (through reference chain: io.a2a.spec.Message[\"role\"])"))
  (is (= (run "EventKind" "{\"kind\":\"message\",\"role\":\"agent\",\"messageId\":\"m\",\"parts\":[{\"kind\":\"text\"}]}")
         "ERR Cannot construct instance of `io.a2a.spec.TextPart`, problem: Parameter 'text' may not be null\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 73] (through reference chain: io.a2a.spec.Message[\"parts\"]->java.util.ArrayList[0])"))
  (is (= (run "EventKind" "{\"kind\":\"task\",\"id\":\"t\",\"status\":{\"state\":\"completed\"}}")
         "ERR Cannot construct instance of `io.a2a.spec.Task`, problem: Parameter 'contextId' may not be null\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 55]"))
  (is (= (run "EventKind" "{\"kind\":\"task\",\"id\":\"t\",\"contextId\":\"c\",\"status\":{\"state\":\"bogus\"}}")
         "ERR Cannot construct instance of `io.a2a.spec.TaskState`, problem: Invalid TaskState: bogus\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 59] (through reference chain: io.a2a.spec.Task[\"status\"]->io.a2a.spec.TaskStatus[\"state\"])"))
  (is (= (run "EventKind" "{\"kind\":\"task\",\"id\":\"t\",\"contextId\":\"c\",\"status\":{}}")
         "ERR Cannot construct instance of `io.a2a.spec.TaskStatus`, problem: Parameter 'state' may not be null\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 51] (through reference chain: io.a2a.spec.Task[\"status\"])"))
  (is (= (run "EventKind" "{\"kind\":\"message\",\"role\":\"agent\",\"messageId\":\"m\",\"parts\":[{\"kind\":\"text\",\"text\":\"\\\"q\\\" \\\\ \\n\\t/ é 日本\"}]}")
         "{\"role\":\"agent\",\"parts\":[{\"text\":\"\\\"q\\\" \\\\ \\n\\t/ é 日本\",\"kind\":\"text\"}],\"messageId\":\"m\",\"kind\":\"message\"}"))
  (is (= (run "EventKind" "{\"kind\":\"message\",\"role\":\"agent\",\"messageId\":\"m\",\"parts\":[{\"kind\":\"text\",\"text\":\"x\"}],\"unknown\":1}")
         "{\"role\":\"agent\",\"parts\":[{\"text\":\"x\",\"kind\":\"text\"}],\"messageId\":\"m\",\"kind\":\"message\"}"))
  (is (= (run "EventKind" "[1,2]")
         "ERR Could not resolve type id '1' as a subtype of `io.a2a.spec.EventKind`: known type ids = [message, task]\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 4]"))
  (is (= (run "EventKind" "{\"kind\":\"message\"")
         "ERR Unexpected end-of-input: expected close marker for Object (start marker at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 1])\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 18]"))
  (is (= (run "EventKind" "")
         "ERR No content to map due to end-of-input\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1]"))
  (is (= (run "Message" "{\"role\":\"user\",\"messageId\":\"m\",\"parts\":[{\"kind\":\"text\",\"text\":\"x\"}]}")
         "ERR Could not resolve subtype of [simple type, class io.a2a.spec.Message]: missing type id property 'kind'\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 68]"))
  (is (= (run "MessageSendParams" "{\"message\":{\"kind\":\"message\",\"role\":\"user\",\"messageId\":\"u-1\",\"parts\":[{\"kind\":\"text\",\"text\":\"hi\"}]}}")
         "{\"message\":{\"role\":\"user\",\"parts\":[{\"text\":\"hi\",\"kind\":\"text\"}],\"messageId\":\"u-1\",\"kind\":\"message\"}}"))
  (is (= (run "MessageSendParams" "{\"message\":{\"role\":\"user\",\"messageId\":\"u\",\"parts\":[{\"text\":\"a\",\"kind\":\"text\"}]},\"configuration\":{\"acceptedOutputModes\":[\"text\"],\"historyLength\":3,\"blocking\":true,\"pushNotificationConfig\":{\"url\":\"http://h/p\",\"token\":\"tk\",\"authentication\":{\"schemes\":[\"Bearer\"],\"credentials\":\"c\"}}},\"metadata\":{\"m\":1}}")
         "ERR Could not resolve subtype of [simple type, class io.a2a.spec.Message]: missing type id property 'kind' (for POJO property 'message')\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 79] (through reference chain: io.a2a.spec.MessageSendParams[\"message\"])"))
  (is (= (run "MessageSendParams" "{}")
         "ERR Cannot construct instance of `io.a2a.spec.MessageSendParams`, problem: Parameter 'message' may not be null\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 2]"))
  (is (= (run "TaskStatus" "{\"state\":\"canceled\",\"message\":{\"kind\":\"message\",\"role\":\"agent\",\"messageId\":\"m\",\"parts\":[{\"kind\":\"text\",\"text\":\"x\"}]},\"timestamp\":\"2026-03-04T05:06:07.890123Z\"}")
         "{\"state\":\"canceled\",\"message\":{\"role\":\"agent\",\"parts\":[{\"text\":\"x\",\"kind\":\"text\"}],\"messageId\":\"m\",\"kind\":\"message\"},\"timestamp\":\"2026-03-04T05:06:07.890123Z\"}"))
  (is (= (run "TaskQueryParams" "{\"id\":\"t\"}")
         "{\"id\":\"t\",\"historyLength\":0}"))
  (is (= (run "TaskQueryParams" "{\"id\":\"t\",\"historyLength\":2,\"metadata\":{\"a\":1}}")
         "{\"id\":\"t\",\"historyLength\":2,\"metadata\":{\"a\":1}}"))
  (is (= (run "TaskIdParams" "{\"id\":\"t\"}")
         "{\"id\":\"t\"}"))
  (is (= (run "TaskIdParams" "{}")
         "ERR Cannot construct instance of `io.a2a.spec.TaskIdParams`, problem: Parameter 'id' may not be null\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 2]"))
  (is (= (run "GetTaskPushNotificationConfigParams" "{\"x\":1,\"pushNotificationConfigId\":\"p\",\"metadata\":{\"k\":[1]},\"id\":\"t\"}")
         "{\"id\":\"t\",\"pushNotificationConfigId\":\"p\",\"metadata\":{\"k\":[1]}}"))
  (is (= (run "GetTaskPushNotificationConfigParams" "{\"id\":\"t\"}")
         "{\"id\":\"t\"}"))
  (is (= (run "GetTaskPushNotificationConfigParams" "{\"pushNotificationConfigId\":\"p\"}")
         "ERR Cannot construct instance of `io.a2a.spec.GetTaskPushNotificationConfigParams`, problem: Parameter 'id' may not be null\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 32]"))
  (is (= (run "ListTaskPushNotificationConfigParams" "{\"metadata\":{},\"id\":\"t\"}")
         "{\"id\":\"t\",\"metadata\":{}}"))
  (is (= (run "ListTaskPushNotificationConfigParams" "{}")
         "ERR Cannot construct instance of `io.a2a.spec.ListTaskPushNotificationConfigParams`, problem: Parameter 'id' may not be null\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 2]"))
  (is (= (run "DeleteTaskPushNotificationConfigParams" "{\"pushNotificationConfigId\":\"p\",\"id\":\"t\"}")
         "{\"id\":\"t\",\"pushNotificationConfigId\":\"p\"}"))
  (is (= (run "DeleteTaskPushNotificationConfigParams" "{\"id\":\"t\"}")
         "ERR Cannot construct instance of `io.a2a.spec.DeleteTaskPushNotificationConfigParams`, problem: Parameter 'pushNotificationConfigId' may not be null\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 10]"))
  (is (= (run "TaskPushNotificationConfig" "{\"pushNotificationConfig\":{\"id\":\"i\",\"token\":\"k\",\"url\":\"u\"},\"taskId\":\"t\"}")
         "{\"taskId\":\"t\",\"pushNotificationConfig\":{\"url\":\"u\",\"token\":\"k\",\"id\":\"i\"}}"))
  (is (= (run "StreamingEventKind" "{\"kind\":\"status-update\",\"taskId\":\"t\",\"contextId\":\"c\",\"status\":{\"state\":\"working\",\"timestamp\":\"2026-01-01T00:00:00Z\"},\"final\":false}")
         "{\"taskId\":\"t\",\"status\":{\"state\":\"working\",\"timestamp\":\"2026-01-01T00:00:00Z\"},\"contextId\":\"c\",\"final\":false,\"kind\":\"status-update\"}"))
  (is (= (run "StreamingEventKind" "{\"kind\":\"status-update\",\"taskId\":\"t\",\"contextId\":\"c\",\"status\":{\"state\":\"completed\",\"timestamp\":\"2026-01-01T00:00:00Z\"},\"final\":true,\"metadata\":{}}")
         "{\"taskId\":\"t\",\"status\":{\"state\":\"completed\",\"timestamp\":\"2026-01-01T00:00:00Z\"},\"contextId\":\"c\",\"final\":true,\"metadata\":{},\"kind\":\"status-update\"}"))
  (is (= (run "StreamingEventKind" "{\"kind\":\"artifact-update\",\"taskId\":\"t\",\"contextId\":\"c\",\"artifact\":{\"artifactId\":\"a\",\"name\":\"n\",\"description\":\"d\",\"parts\":[{\"kind\":\"text\",\"text\":\"x\"}]},\"append\":true,\"lastChunk\":false}")
         "{\"taskId\":\"t\",\"artifact\":{\"artifactId\":\"a\",\"name\":\"n\",\"description\":\"d\",\"parts\":[{\"text\":\"x\",\"kind\":\"text\"}]},\"contextId\":\"c\",\"append\":true,\"lastChunk\":false,\"kind\":\"artifact-update\"}"))
  (is (= (run "StreamingEventKind" "{\"kind\":\"artifact-update\",\"taskId\":\"t\",\"contextId\":\"c\",\"artifact\":{\"artifactId\":\"a\",\"parts\":[{\"kind\":\"text\",\"text\":\"x\"}]}}")
         "{\"taskId\":\"t\",\"artifact\":{\"artifactId\":\"a\",\"parts\":[{\"text\":\"x\",\"kind\":\"text\"}]},\"contextId\":\"c\",\"kind\":\"artifact-update\"}"))
  (is (= (run "TaskPushNotificationConfig" "{\"taskId\":\"t\",\"pushNotificationConfig\":{\"url\":\"http://h/p\",\"id\":\"i\"}}")
         "{\"taskId\":\"t\",\"pushNotificationConfig\":{\"url\":\"http://h/p\",\"id\":\"i\"}}"))
  (is (= (run "AgentCard" "{\"name\":\"Mulay Echo Agent\",\"description\":\"Echoes the text it receives.\",\"url\":\"http://localhost:18162/agent\",\"version\":\"1.0.0\",\"protocolVersion\":\"0.3.0\",\"capabilities\":{\"streaming\":false,\"pushNotifications\":false,\"stateTransitionHistory\":false},\"defaultInputModes\":[\"text/plain\"],\"defaultOutputModes\":[\"text/plain\"],\"skills\":[{\"id\":\"echo\",\"name\":\"Echo\",\"description\":\"Echoes text\",\"tags\":[\"echo\"]}],\"provider\":{\"organization\":\"mulay\",\"url\":\"https://example.com\"}}")
         "{\"name\":\"Mulay Echo Agent\",\"description\":\"Echoes the text it receives.\",\"url\":\"http://localhost:18162/agent\",\"provider\":{\"organization\":\"mulay\",\"url\":\"https://example.com\"},\"version\":\"1.0.0\",\"capabilities\":{\"streaming\":false,\"pushNotifications\":false,\"stateTransitionHistory\":false},\"defaultInputModes\":[\"text/plain\"],\"defaultOutputModes\":[\"text/plain\"],\"skills\":[{\"id\":\"echo\",\"name\":\"Echo\",\"description\":\"Echoes text\",\"tags\":[\"echo\"]}],\"supportsAuthenticatedExtendedCard\":false,\"preferredTransport\":\"JSONRPC\",\"protocolVersion\":\"0.3.0\"}"))
  (is (= (run "AgentCard" "{\"name\":\"n\",\"description\":\"d\",\"url\":\"u\",\"version\":\"1\",\"capabilities\":{},\"defaultInputModes\":[],\"defaultOutputModes\":[],\"skills\":[{\"id\":\"s\",\"name\":\"S\",\"description\":\"x\",\"tags\":[],\"examples\":[\"e\"],\"inputModes\":[\"a\"],\"outputModes\":[\"b\"]}],\"documentationUrl\":\"http://d\",\"iconUrl\":\"http://i\",\"additionalInterfaces\":[{\"transport\":\"JSONRPC\",\"url\":\"u\"}],\"supportsAuthenticatedExtendedCard\":true,\"preferredTransport\":\"HTTP+JSON\"}")
         "{\"name\":\"n\",\"description\":\"d\",\"url\":\"u\",\"version\":\"1\",\"documentationUrl\":\"http://d\",\"capabilities\":{\"streaming\":false,\"pushNotifications\":false,\"stateTransitionHistory\":false},\"defaultInputModes\":[],\"defaultOutputModes\":[],\"skills\":[{\"id\":\"s\",\"name\":\"S\",\"description\":\"x\",\"tags\":[],\"examples\":[\"e\"],\"inputModes\":[\"a\"],\"outputModes\":[\"b\"]}],\"supportsAuthenticatedExtendedCard\":true,\"iconUrl\":\"http://i\",\"additionalInterfaces\":[{\"transport\":\"JSONRPC\",\"url\":\"u\"}],\"preferredTransport\":\"HTTP+JSON\",\"protocolVersion\":\"0.3.0\"}"))
  (is (= (run "AgentCard" "{\"name\":\"n\",\"description\":\"d\",\"url\":\"u\",\"version\":\"1\",\"defaultInputModes\":[],\"defaultOutputModes\":[],\"skills\":[]}")
