(ns a2a-tasks-test (:require [mulay.conn.a2a :as a]))

(defn- it a/Item [state: Str] (a/->Item "c" state "" [] [] ""))

(defn- items Map(Str a/Item) []
  (let [m: Map(Str a/Item) {}]
    (assoc (assoc (assoc (assoc m "s/old-done" (it "completed")) "s/old-work" (it "working")) "s/new-done" (it "failed")) "s/new-work" (it "submitted"))))

(defn- at Map(Str Int) []
  (let [m: Map(Str Int) {}]
    (assoc (assoc (assoc (assoc m "s/old-done" 100) "s/old-work" 200) "s/new-done" 900) "s/new-work" 1000)))

(deftest tasks-older-than-the-ttl-go
  (is (= (a/evict-keys (items) (at) 1100 850 100) ["s/old-done" "s/old-work"])))

(deftest nothing-goes-under-the-cap-and-ttl
  (is (= (count (a/evict-keys (items) (at) 1100 100000 100)) 0)))

(deftest over-the-cap-finished-tasks-go-first-oldest-first
  (is (= (a/evict-keys (items) (at) 1100 100000 3) ["s/old-done"]))
  (is (= (a/evict-keys (items) (at) 1100 100000 2) ["s/old-done" "s/new-done"])))

(deftest over-the-cap-unfinished-tasks-go-when-no-finished-one-is-left
  (is (= (a/evict-keys (items) (at) 1100 100000 1) ["s/old-done" "s/new-done" "s/old-work"])))
