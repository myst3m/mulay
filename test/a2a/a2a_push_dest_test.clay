(ns a2a-push-dest-test (:require [mulay.conn.a2a :as a] [clay.string :as str]))

(defn- push a/Push [url: Str] (a/->Push "id" url "" 1000))

(deftest internal-push-destinations-are-refused-without-sending
  (is (= (a/post-push (push "http://127.0.0.1:1/hook") "{}" false)
         "Push notification refused: 'http://127.0.0.1:1/hook' resolves to the internal address 127.0.0.1 (set mulay.a2a.allowPrivatePushUrls=true to allow)"))
  (is (= (a/post-push (push "http://169.254.169.254/latest/meta-data/") "{}" false)
         "Push notification refused: 'http://169.254.169.254/latest/meta-data/' resolves to the internal address 169.254.169.254 (set mulay.a2a.allowPrivatePushUrls=true to allow)"))
  (is (str/starts-with? (a/post-push (push "http://localhost:1/") "{}" false) "Push notification refused: 'http://localhost:1/' resolves to the internal address "))
  (is (str/starts-with? (a/post-push (push "http://[::1]:1/") "{}" false) "Push notification refused: 'http://[::1]:1/' resolves to the internal address "))
  (is (str/starts-with? (a/post-push (push "http://2130706433:1/") "{}" false) "Push notification refused: ")))

(deftest unresolvable-destinations-are-an-error
  (is (str/starts-with? (a/post-push (push "http://no-such-host.invalid/") "{}" false) "Push notification failed: resolve no-such-host.invalid: ")))

(deftest the-opt-in-sends-to-internal-addresses
  (let [e (a/post-push (push "http://127.0.0.1:1/hook") "{}" true)]
    (is (not= e ""))
    (is (not (str/starts-with? e "Push notification refused")))))
