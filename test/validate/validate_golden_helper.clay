(ns validate-golden-helper (:require [mulay.lib.validate :as va]))

;; golden の 1 件 (tools/gen-validation-golden.java)。入力は UTF-8 の 16 進。

(defn- hexd Int [c: Int] (if (<= c 57) (- c 48) (- c 87)))

(defn unhex Str [h: &Str]
  (loop [i 0 out ""]
    (if (>= i (count h)) out
      (recur (+ i 2) (str out (chr (+ (* 16 (hexd (nth h i))) (hexd (nth h (+ i 1))))))))))

(defn check Str [kind: Str h: Str]
  (let [s (unhex h)
        r (cond (= kind "email") (va/email? s) (= kind "inet") (va/inet-address? s) :else (va/url? s))]
    (if r "t" "f")))
