(ns dates-test (:require [mulay.dw.engine :as eng]))

;; 日時の as 変換 (coerce_time)、dw::core::Dates、dw::core::Periods、Core の日時の関数、日時のセレクタ。
;; 期待値は実 DW 2.11.2 (tools/dw-oracle) の結果を compact な JSON で書いたもの。

(defn- run Str [header: Str expr: Str]
  (let [ins: Vec(eng/Input) []
        [mime out err] (eng/run-text (str "%dw 2.0\n" header "output application/json indent=false\n---\n" expr) ins)]
    (if (= err "") out (str "ERR:" err))))

(defn- dw Str [expr: Str] (run "" expr))
(defn- dwd Str [expr: Str] (run "import * from dw::core::Dates\n" expr))
(defn- dwp Str [expr: Str] (run "import * from dw::core::Periods\n" expr))

(deftest string-to-temporal
  (is (= (dw "\"2020-01-02\" as Date") "\"2020-01-02\""))
  (is (= (dw "\"2020-13-02\" as Date") "ERR:Cannot coerce String (2020-13-02) to Date"))
  (is (= (dw "\"2020-01-02T10:00:00\" as DateTime") "\"2020-01-02T10:00:00Z\""))
  (is (= (dw "\"2020-01-02T10:00:00+09:00[Asia/Tokyo]\" as DateTime") "\"2020-01-02T10:00:00+09:00\""))
  (is (= (dw "\"2020-01-02T10:00:00[Asia/Tokyo]\" as DateTime") "ERR:Cannot coerce String (2020-01-02T10:00:00[Asia/Tokyo]) to DateTime"))
  (is (= (dw "\"2020-01-02\" as DateTime") "ERR:Cannot coerce String (2020-01-02) to DateTime"))
  (is (= (dw "\"2020-01-02T10:00:00Z\" as LocalDateTime") "\"2020-01-02T10:00:00\""))
  (is (= (dw "\"2020-01-02T10:00:00+09:00\" as Date") "\"2020-01-02\""))
  (is (= (dw "\"10:00\" as Time") "\"10:00:00Z\""))
  (is (= (dw "\"10:00:00Z\" as LocalTime") "\"10:00:00\""))
  (is (= (dw "\"JST\" as TimeZone") "\"Asia/Tokyo\""))
  (is (= (dw "\"EST\" as TimeZone") "\"-05:00\""))
  (is (= (dw "\"Foo/Bar\" as TimeZone") "ERR:Cannot coerce String (\"Foo/Bar\") to TimeZone"))
  (is (= (dw "\"P1DT2H\" as Period") "\"PT26H\""))
  (is (= (dw "\"X\" as Period") "ERR:Cannot coerce String (\"X\") to Period, caused by: Text cannot be parsed to a Period"))
  (is (= (dw "\"P1Y2M3DT4H\" as Period") "ERR:Cannot coerce String (\"P1Y2M3DT4H\") to Period, caused by: Text cannot be parsed to a Duration")))

(deftest string-to-temporal-format
  (is (= (dw "\"01/02/2020\" as Date {format: \"MM/dd/yyyy\"} as String") "\"2020-01-02\""))
  (is (= (dw "\"01-02-2020\" as Date {format: \"MM/dd/yyyy\"}") "ERR:Cannot coerce String (01-02-2020) to Date, caused by: Text '01-02-2020' could not be parsed at index 2"))
  (is (= (dw "\"2020\" as Date {format: \"yyyy\"}") "ERR:Cannot coerce String (2020) to Date, caused by: Text '2020' could not be parsed: Unable to convert `2020` to Date."))
  (is (= (dw "\"01/02/2020 10:11\" as DateTime {format: \"MM/dd/yyyy HH:mm\"}")
         "ERR:Cannot coerce String (01/02/2020 10:11) to DateTime, caused by: Text '01/02/2020 10:11' could not be parsed: Unable to obtain ZonedDateTime from TemporalAccessor: {},ISO resolved to 2020-01-02T10:11 of type java.time.format.Parsed"))
  (is (= (dw "\"x\" as Date {format: \"yy{\"}") "ERR:Cannot coerce String (x) to Date, caused by: Pattern includes reserved character: '{'"))
  (is (= (dw "\"x\" as Date {format: \"yy\", mode: \"foo\"}") "ERR:Invalid unit: foo expecting 'LENIENT' or 'SMART' or 'STRICT'")))

(deftest temporal-to-string
  (is (= (dw "|2020-03-04T05:06:07.123456789-03:00| as String {format: \"yyyy/MM/dd HH:mm:ss.SSS xxx\"}") "\"2020/03/04 05:06:07.123 -03:00\""))
  (is (= (dw "|2020-03-04| as String {format: \"dd MMM yyyy\"}") "\"04 Mar 2020\""))
  (is (= (dw "|2020-03-04| as String {format: \"HH:mm\"}") "ERR:Cannot coerce Date (|2020-03-04|) to String, caused by: Unsupported field: HourOfDay"))
  (is (= (dw "|05:06| as String") "\"05:06:00\""))
  (is (= (dw "|P1D| as String {format: \"x\"}") "\"P1D\"")))

(deftest number-and-temporal
  (is (= (dw "|2020-03-04T05:06:07.123456789-03:00| as Number") "1583309167"))
  (is (= (dw "|2020-03-04T05:06:07.123456789-03:00| as Number {unit: \"milliseconds\"}") "1583309167123"))
  (is (= (dw "|1969-12-31T23:59:59.5Z| as Number") "-1"))
  (is (= (dw "|2020-01-01T00:00:00Z| as Number {unit: \"hours\"}") "ERR:Invalid unit: hours expecting 'milliseconds' or 'seconds'"))
  (is (= (dw "1583298367 as DateTime") "\"2020-03-04T05:06:07Z\""))
  (is (= (dw "1.5e3 as DateTime {unit: \"milliseconds\"}") "\"1970-01-01T00:00:01.5Z\""))
  (is (= (dw "1583298367 as Date") "ERR:Cannot coerce Number (1583298367) to Date"))
  (is (= (dw "|2020-03-04T05:06:07.5| as Number") "ERR:Cannot coerce LocalDateTime (|2020-03-04T05:06:07.5|) to Number"))
  (is (= (dw "[|P1Y2M| as Number, |P1Y12M| as Number {unit: \"years\"}, |P3D| as Number, |PT-1.5S| as Number, |PT1H1.5S| as Number {unit: \"milliseconds\"}]") "[14,2,0,-2,3601500]"))
  (is (= (dw "|P1Y| as Number {unit: \"days\"}") "ERR:Invalid unit: days expecting 'years' or 'months'")))

(deftest temporal-to-temporal
  (is (= (dw "|2020-03-04T05:06:07.5-03:00| as Time") "\"05:06:07.5-03:00\""))
  (is (= (dw "|2020-03-04T05:06:07.5-03:00| as TimeZone") "\"-03:00\""))
  (is (= (dw "|2020-03-04T05:06:07.5| as DateTime") "\"2020-03-04T05:06:07.5Z\""))
  (is (= (dw "|05:06:07| as Time") "\"05:06:07Z\""))
  (is (= (dw "|2020-03-04| as DateTime") "ERR:Cannot coerce Date (|2020-03-04|) to DateTime"))
  (is (= (dw "|05:06:07| as DateTime") "ERR:Cannot coerce LocalTime (|05:06:07|) to DateTime")))

(deftest selectors
  (is (= (dw "do { var dt = |2020-03-04T05:06:07.123456789-03:00| --- [dt.year, dt.month, dt.day, dt.hour, dt.minutes, dt.seconds, dt.nanoseconds, dt.milliseconds, dt.dayOfWeek, dt.dayOfYear, dt.quarter, dt.offsetSeconds, dt.timezone] }")
         "[2020,3,4,5,6,7,123456789,123,3,64,1,-10800,\"-03:00\"]"))
  (is (= (dw "(|2020-03-04T05:06:07Z| >> \"Asia/Tokyo\").timezone") "\"+09:00\""))
  (is (= (dw "[|PT26H3M4.5S|.hours, |PT26H3M4.5S|.minutes, |PT26H3M4.5S|.seconds, |PT26H3M4.5S|.days, |PT26H3M4.5S|.secs]") "[2,3,93784,1,4]"))
  (is (= (dw "[|PT-26H-3M-4.5S|.hours, |PT-26H-3M-4.5S|.minutes, |PT-26H-3M-4.5S|.secs, |PT-26H-3M-4.5S|.seconds, |PT-26H-3M-4.5S|.days]") "[-2,-3,-5,-93785,-1]"))
  (is (= (dw "[|P1Y2M3D|.hours, |2020-01-01|.hour, |PT1H|.years]") "[null,null,null]")))

(deftest core-functions
  (is (= (dw "|2020-03-04T05:06:07.123456789-03:00| >> \"Asia/Tokyo\"") "\"2020-03-04T17:06:07.123456789+09:00\""))
  (is (= (dw "|2020-03-04T05:06:07-03:00| >> |+01:00|") "\"2020-03-04T09:06:07+01:00\""))
  (is (= (dw "|2020-03-04T05:06:07-03:00| >> \"Foo/Bar\"") "ERR:You called the function '>>' with these arguments: \n  1: DateTime (|2020-03-04T05:06:07-03:00|)\n  2: String (Foo/Bar)"))
  (is (= (dw "[|2017-10-01| ++ |-03:00|, |-03:00| ++ |2003-10-01T23:57:59|, |23:57| ++ |-03:00|]")
         "[\"2017-10-01T00:00:00-03:00\",\"2003-10-01T23:57:59-03:00\",\"23:57:00-03:00\"]"))
  (is (= (dw "[isLeapYear(|2020-01-01|), isLeapYear(|1900-01-01T00:00:00|), isLeapYear(|2000-01-01T00:00:00Z|)]") "[true,false,true]"))
  (is (= (dw "[daysBetween(|2020-01-01|, |2021-01-01|), daysBetween(|2020-01-01T23:00:00Z|, |2020-01-02T01:00:00Z|), daysBetween(\"2020-01-01\", \"2020-01-05\")]") "[366,1,4]"))
  (is (= (dw "[sizeOf(|P1Y2M|), sizeOf(|2020-01-01T00:00:00+09:00|)]") "[5,25]"))
  (is (= (dw "[|P1Y| - |2019-10-01|, |PT9M| - |23:59:56|]") "[\"2018-10-01\",\"23:50:56\"]"))
  (is (= (dw "now() is DateTime") "true")))

(deftest dates-module
  (is (= (dwd "date({year: 2012, month: 10, day: 11})") "\"2012-10-11\""))
  (is (= (dwd "date({year: 2020, month: 2, day: 30})") "ERR:Cannot coerce String (2020-02-30) to Date"))
  (is (= (dwd "date({year: 2020, month: 13, day: 1})") "ERR:Field 'month': `13` must be between 1 and 12."))
  (is (= (dwd "date({year: 2020.5, month: 1.4, day: 2.5})") "ERR:Cannot coerce String (2020.5-01-03) to Date"))
  (is (= (dwd "dateTime({year: 2012, month: 10, day: 11, hour: 12, minutes: 30, seconds: 40, timeZone: |-03:00|})") "\"2012-10-11T12:30:40-03:00\""))
  (is (= (dwd "time({hour: 1, minutes: 2, seconds: 3, timeZone: |+01:00|})") "\"01:02:03+01:00\""))
  (is (= (dwd "localTime({hour: 1, minutes: 2, seconds: 3, extra: 1})") "\"01:02:03\""))
  (is (= (dwd "atBeginningOfWeek(|2020-10-10T10:00:00Z|)") "\"2020-10-04T00:00:00Z\""))
  (is (= (dwd "atBeginningOfHour(|2020-10-10T10:20:00.5Z| >> \"America/New_York\")") "\"2020-10-10T06:00:00-04:00\""))
  (is (= (dwd "atBeginningOfDay(\"2020-03-08T12:00:00-04:00[America/New_York]\" as DateTime)") "\"2020-03-08T00:00:00-04:00\""))
  (is (= (dwd "[atBeginningOfMonth(|2020-10-06|), atBeginningOfYear(|2020-10-06T18:23:20.351|), atBeginningOfHour(|18:23:20.351-03:00|)]")
         "[\"2020-10-01\",\"2020-01-01T00:00:00\",\"18:00:00-03:00\"]"))
  (is (= (dwd "today() is Date") "true")))

(deftest periods-module
  (is (= (dwp "[between(|2010-12-12|,|2010-12-10|), between(|2020-02-29|,|2020-03-30|)]") "[\"P2D\",\"P-1M-1D\"]"))
  (is (= (dwp "[duration({days: 1.5, hours: 1}), duration({days: -1.5}), duration({hours: 1.25, minutes: 1}), duration({days:4, hours:11, minutes:28}), duration({})]")
         "[\"PT25H\",\"PT-36H\",\"PT1H1M\",\"PT107H28M\",\"PT0S\"]"))
  (is (= (dwp "duration({seconds: 1e3})") "ERR:Cannot coerce String (\"P0DT0H0M1E+3S\") to Period, caused by: Text cannot be parsed to a Duration"))
  (is (= (dwp "[period({years: -1, months: 14, days: 40}), period({})]") "[\"P-1Y14M40D\",\"P0D\"]"))
  (is (= (dwp "period({years: 1.5})") "ERR:Field years: `1.5`, can not be decimal."))
  (is (= (dwp "[days(4.555), days(4), hours(4.555), minutes(4.555), seconds(4.555), years(0)]")
         "[\"PT109H19M12S\",\"P4D\",\"PT4H33M18S\",\"PT4M33.3S\",\"PT4.555S\",\"P0D\"]"))
  (is (= (dwp "[hours(-1) + hours(2), years(-1) + years(2), duration({ minutes : 1 }) + duration({ seconds : -1 })]") "[3600,12,59]")))
