(ns frozen-test (:require [mulay.dw.engine :as eng] [mulay.lib.host :as host]))

(defn- run Str [s: Str] (let [z: Vec(eng/Input) [] [mime out err] (eng/run-text s z)] (if (= err "") out (str "ERR " err))))

(deftest frozen-now-and-uuid
  (let [a (host/set-clock! 1792832400000)
        b (host/set-seed! 1)
        t1 (run "%dw 2.0\noutput application/json\n---\n{n: (now() >> \"UTC\") as String {format: \"yyyy-MM-dd'T'HH:mm:ssXXX\"} , u: uuid(), r: random()}")
        c (host/set-seed! 1)
        t2 (run "%dw 2.0\noutput application/json\n---\n{n: (now() >> \"UTC\") as String {format: \"yyyy-MM-dd'T'HH:mm:ssXXX\"} , u: uuid(), r: random()}")
        m (run "%dw 2.0\nimport * from dw::util::Timer\noutput application/json\n---\ncurrentMilliseconds()")
        z (host/clear-clock!)
        y (host/clear-seed!)]
    (is (= t1 t2))
    (is (= m "1792832400000"))
    (is (= (subs t1 0 31) "{\n  \"n\": \"2026-10-24T09:00:00Z\""))))
