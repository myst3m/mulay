(ns module-ns-test (:require [mulay.dw.engine :as eng] [clay.string :as str]))

(defn- loader Values(Str Bool) [m: Str]
  (cond (= m "a::A") (values "%dw 2.0\nns p urn:a\ntype TA = {p#x: Number}\nfun objA() = {p#x: 1}\n" true)
        :else (values "" false)))

(deftest namespace-prefixes-belong-to-their-module
  (let [script "%dw 2.0\nimport * from a::A\nns p urn:main\nns q urn:a\noutput application/json\n---\n{own: {p#x: 1} is TA, theirs: objA() is TA, same: {q#x: 1} is TA}"
        [mime out err c de] (eng/run-text-with script [] loader)]
    (is (= err ""))
    (is (= (str/replace out " " "") "{\n\"own\":false,\n\"theirs\":true,\n\"same\":true\n}"))))
