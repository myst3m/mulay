(ns range-test (:require [mulay.dw.engine :as eng]))

(defn- run Str [e: Str] (let [z: Vec(eng/Input) [] [mime out err] (eng/run-text (str "%dw 2.0\noutput application/json\n---\n" e) z)] (if (= err "") out (str "ERR " err))))

(deftest size-of-a-range-past-64-bits-is-exact
  (is (= (run "sizeOf(0 to 9223372036854775807)") "9223372036854775808"))
  (is (= (run "sizeOf(-1 to 9223372036854775806)") "9223372036854775808"))
  (is (= (run "sizeOf(1 to -9223372036854775808)") "9223372036854775810"))
  (is (= (run "sizeOf(-9223372036854775808 to 9223372036854775807)") "18446744073709551616"))
  (is (= (run "sizeOf(9223372036854775807 to -9223372036854775808)") "18446744073709551616"))
  (is (= (run "sizeOf(0 to 9223372036854775806)") "9223372036854775807"))
  (is (= (run "sizeOf(3 to 1)") "3")))
