(ns schematype-test (:require [mulay.dw.schematype :as st]))

(deftest json-schema-becomes-dataweave-types
  (let [[a ae] (st/json-schema-module "{\"type\": \"object\", \"properties\": {\"event-type\": {\"const\": \"a$b\"}, \"n\": {\"type\": [\"integer\", \"null\"]}}, \"required\": [\"n\"], \"additionalProperties\": false}")
        [b be] (st/json-schema-module "{\"$defs\": {\"k\": {\"enum\": [\"X\", 1, true]}}, \"type\": \"array\"}")
        [c ce] (st/json-schema-module "{\"allOf\": [{\"type\": \"string\"}, {\"$ref\": \"#/definitions/x\"}]}")
        [d de] (st/json-schema-module "{")]
    (is (= ae ""))
    (is (= a "%dw 2.0\ntype Root = {| \"event-type\"?: \"a\\$b\", n: (Number | Null) |}\n"))
    (is (= b "%dw 2.0\ntype k = (\"X\" | 1 | true)\ntype Root = Array\n"))
    (is (= c "%dw 2.0\ntype Root = (String & x)\n"))
    (is (not= de ""))))
