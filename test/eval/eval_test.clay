(ns eval-test (:require [mulay.dw.eval :as ev] [mulay.dw.rir :as r] [mulay.dw.val :as v] [mulay.dw.ast :as ast] [mulay.dw.rt :as rt] [mulay.dw.err :as dwe]))

(defn- sp ast/Span [] (ast/->Span 0 0))
(defn- k r/R [x: v/Val] (r/->R (r/->RConst x) (sp)))

;; fact(n) = if (n <= 1) 1 else n * fact(n-1) を手で組んだ IR (組み込み関数なしでも動く部分だけ確認)
(deftest const-and-if
  (let [p (r/->Prog [] [] [] (r/->R (r/->RIf (k (v/->VBool false)) (k (v/int-v 1)) (k (v/str-v "x"))) (sp)) 0 [] [])
        [x e] (ev/run-prog p [] [])]
    (is (dwe/ok? e))
    (is (v/equal? x (v/str-v "x")))))
