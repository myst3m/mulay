(ns sf-bulk1-err-test (:require [mulay.conn.sf_core :as sc]))

(deftest known-codes-describe-with-the-code
  (let [a (sc/bulk1-fault "ClientInputError" "Chunk size is not valid.")
        b (sc/bulk1-fault "ExceededQuota" "x")
        c (sc/bulk1-fault "Timeout" "x")
        d (sc/bulk1-fault "InvalidJob" "Unable to find object: Nope")]
    (is (= [(:ns a) (:id a) (:description a)] ["SALESFORCE" "INVALID_INPUT" "ClientInputError"]))
    (is (= [(:id b) (:description b)] ["LIMIT_EXCEEDED" "ExceededQuota"]))
    (is (= [(:id c) (:description c)] ["TIMEOUT" "Timeout"]))
    (is (= [(:id d) (:description d)] ["INVALID_INPUT" "InvalidJob"]))))

(deftest session-and-unknown-codes
  (let [a (sc/bulk1-fault "InvalidSessionId" "Invalid session id")
        b (sc/bulk1-fault "FeatureNotEnabled" "x")
        c (sc/bulk1-fault "clientinputerror" "x")]
    (is (= [(:ns a) (:id a) (:description a)] ["SALESFORCE" "CONNECTIVITY" "Invalid session id"]))
    (is (= [(:ns b) (:id b) (:description b)] ["MULE" "UNKNOWN" "No enum constant org.mule.extension.salesforce.internal.model.exception.handling.BulkApiV1ErrorMappingType.FeatureNotEnabled"]))
    (is (= [(:ns c) (:id c)] ["MULE" "UNKNOWN"]))))
