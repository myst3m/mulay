(ns timeunit-test (:require [mulay.lib.time.unit :as tu]))

(def CASES: Vec(Vec(Str)) [
  ["500" "MILLISECONDS" "1"]
  ["1500" "MILLISECONDS" "2"]
  ["1000" "MILLISECONDS" "1"]
  ["999" "MILLISECONDS" "1"]
  ["1" "MINUTES" "60"]
  ["-1" "SECONDS" "-1"]
  ["-500" "MILLISECONDS" "0"]
  ["-1500" "MILLISECONDS" "-1"]
  ["0" "SECONDS" "0"]
  ["1500000" "MICROSECONDS" "2"]
  ["1" "NANOSECONDS" "1"]
  ["2147483647" "DAYS" "ERR:integer overflow"]
  ["2147483647" "HOURS" "ERR:integer overflow"]
  ["35791394" "MINUTES" "2147483640"]
  ["35791395" "MINUTES" "ERR:integer overflow"]
  ["-1" "MINUTES" "-60"]
  ["2147483647" "SECONDS" "2147483647"]
  ["-2147483648" "SECONDS" "-2147483648"]
  ["2147483647" "NANOSECONDS" "3"]
  ["-35791395" "MINUTES" "ERR:integer overflow"]
  ["24855" "DAYS" "2147472000"]
  ["24856" "DAYS" "ERR:integer overflow"]
])

(defn- run-case Str [c: &Vec(Str)]
  (let [[n ne] (parse-long (nth c 0))
        [s e] (tu/ceil-seconds n (nth c 1))]
    (if (= e "") (str s) (str "ERR:" e))))

(deftest ceil-seconds-like-mule
  (let [bad (loop [i 0 acc: Vec(Str) []]
              (if (>= i (count CASES)) acc
                (let [c (nth CASES i) got (run-case c)]
                  (recur (+ i 1) (if (= got (nth c 2)) acc (conj acc (str (nth c 0) " " (nth c 1) ": want " (nth c 2) ", got " got)))))))]
    (is (= bad []))))

(deftest ceil-seconds-big-and-unknown
  (let [[a ae] (tu/ceil-seconds 9223372036854775807 "DAYS")
        [b be] (tu/ceil-seconds -9223372036854775807 "MINUTES")
        [c ce] (tu/ceil-seconds 9223372036854775807 "NANOSECONDS")
        [d de] (tu/ceil-seconds 1 "FORTNIGHTS")]
    (is (= ae "integer overflow"))
    (is (= be "integer overflow"))
    (is (= ce "integer overflow"))
    (is (not= de ""))))
