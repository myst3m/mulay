(ns golden-parse-test
  (:require [golden-parse-data :as g]
            [mulay.lib.time.types :as t]
            [mulay.lib.time.iso :as iso]
            [mulay.lib.time.fmt :as fmt]
            [clay.string :as str]))

;; DateTimeFormatter.ofPattern(p, Locale.US).parse(text) (SMART) の golden (tools/gen-time-golden.java)。
;; 結果は D=LocalDate;T=LocalTime;Z=ZonedDateTime.from;ZONE=TemporalQueries.zone() か ERR:メッセージ。

(defn- one Str [p: &Str text: &Str]
  (let [[f ce] (fmt/compile p)]
    (if (not= ce "") (str "ERR:" ce)
      (let [[r e] (fmt/parse f text)]
        (if (not= e "") (str "ERR:" e)
          (let [[d okd] (fmt/parsed-date r)
                [x okt] (fmt/parsed-time r)
                [z okz] (fmt/parsed-zdt r)
                [zn okn] (fmt/parsed-zone r)]
            (str "D=" (if okd (iso/date-str d) "-") ";T=" (if okt (iso/time-str x) "-")
                 ";Z=" (if okz (iso/zdt-str z) "-") ";ZONE=" (if okn (t/zone-id zn) "-"))))))))

(defn- run Int []
  (let [cs (g/cases)]
    (loop [i 0 bad 0]
      (if (>= i (count cs)) bad
        (let [want: Str (nth cs i)
              fs (str/split want "\t")
              got (str/join "\t" [(nth fs 0) (nth fs 1) (one (nth fs 0) (nth fs 1))])
              ok (= got want)]
          (if (and (not ok) (< bad 100)) (println (str "  want " want "\n  got  " got)) 0)
          (recur (+ i 1) (if ok bad (+ bad 1))))))))

(deftest golden-parse
  (is (> (count (g/cases)) 1000))
  (is (= (run) 0)))
