(ns golden-fmt-test
  (:require [golden-fmt-data :as g]
            [mulay.lib.time.types :as t]
            [mulay.lib.time.iso :as iso]
            [mulay.lib.time.fmt :as fmt]
            [clay.string :as str]))

;; DateTimeFormatter.ofPattern(p, Locale.US).format(v) の golden (tools/gen-time-golden.java)。

(defn- res Str [s: Str e: &Str] (if (= e "") s (str "ERR:" e)))

(defn- check-line Str [fs: &Vec(Str)]
  (let [k: Str (nth fs 0) v: Str (nth fs 1) p: Str (nth fs 2)
        [f ce] (fmt/compile p)
        out (if (not= ce "") (str "ERR:" ce)
              (case k
                "Z" (let [[z e] (iso/parse-zdt v) [s e2] (fmt/format-zdt f z)] (res s e2))
                "D" (let [[d e] (iso/parse-date v) [s e2] (fmt/format-date f d)] (res s e2))
                "T" (let [[x e] (iso/parse-time v) [s e2] (fmt/format-time f x)] (res s e2))
                "L" (let [[x e] (iso/parse-ldt v) [s e2] (fmt/format-ldt f x)] (res s e2))
                (let [[o e] (iso/parse-ot v) [s e2] (fmt/format-ot f o)] (res s e2))))]
    (str/join "\t" [k v p out])))

(defn- run Int []
  (let [cs (g/cases)]
    (loop [i 0 bad 0]
      (if (>= i (count cs)) bad
        (let [want: Str (nth cs i)
              got (check-line (str/split want "\t"))
              ok (= got want)]
          (if (and (not ok) (< bad 80)) (println (str "  want " want "\n  got  " got)) 0)
          (recur (+ i 1) (if ok bad (+ bad 1))))))))

(deftest golden-format
  (is (> (count (g/cases)) 2000))
  (is (= (run) 0)))
