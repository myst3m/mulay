(ns civil-test (:require [mulay.lib.time.civil :as cv] [mulay.lib.time.num :as n]))

(deftest epoch-day-roundtrip
  (let [[y m d] (cv/from-epoch-day -365243219162)]
    (is (= (cv/epoch-day 1970 1 1) 0))
    (is (= (cv/epoch-day 2000 3 1) 11017))
    (is (= (cv/epoch-day -999999999 1 1) -365243219162))
    (is (= (cv/epoch-day 999999999 12 31) 365241780471))
    (is (= y -999999999)) (is (= m 1)) (is (= d 1))))

(deftest leap-and-dow
  (is (cv/leap? 2000))
  (is-refuted (cv/leap? 1900))
  (is (cv/leap? -4))
  (is (= (cv/day-of-week 0) 4))
  (is (= (cv/fdiv -7 2) -4)))

(deftest num-helpers
  (let [[v e o] (n/scan-digits "12345x" 0 3)]
    (is (= (n/pad-num 5 3) "005"))
    (is (= (n/pad-num -5 3) "-005"))
    (is (= v 123)) (is (= e 3)) (is-refuted o)))
