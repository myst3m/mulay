(ns locale-test (:require [mulay.lib.time.fmt :as fm] [mulay.lib.time.types :as t]))

;; 期待値は JDK 17 の DateTimeFormatter.ofPattern(p, Locale.forLanguageTag(tag)).format(..)

(defn- fmt-date Str [p: &Str tag: &Str y: Int m: Int d: Int]
  (let [[f e] (fm/compile-locale p tag false)
        [s e2] (fm/format-date f (t/->LocalDate y m d))]
    (if (not= e "") e (if (not= e2 "") e2 s))))

(defn- parse-date Str [p: &Str tag: &Str ci: Bool text: &Str]
  (let [[f e] (fm/compile-locale p tag ci)
        [d e2] (fm/parse-date f text)]
    (if (not= e2 "") e2 (str (:year d) "-" (:month d) "-" (:day d)))))

(deftest format-names
  (is (= (fmt-date "dd-MMM-yy" "es" 2020 12 31) "31-dic-20"))
  (is (= (fmt-date "dd-MMM-yy" "fr" 2020 12 31) "31-déc.-20"))
  (is (= (fmt-date "EEEE dd MMMM yy" "de" 2020 12 31) "Donnerstag 31 Dezember 20"))
  (is (= (fmt-date "EEEE dd MMMM yy" "ja" 2020 12 31) "木曜日 31 12月 20"))
  (is (= (fmt-date "LLLL" "ru" 2020 1 1) "январь"))
  (is (= (fmt-date "MMMM" "ru" 2020 1 1) "января"))
  (is (= (fmt-date "QQQ" "es" 2020 5 1) "T2"))
  ;; 地域の無いもの・知らない地域は言語へ、知らない言語は en-US へ
  (is (= (fmt-date "MMM" "ES" 2020 8 1) "ago"))
  (is (= (fmt-date "MMM" "es_AR" 2020 8 1) "ago"))
  (is (= (fmt-date "MMM" "xx" 2020 8 1) "Aug")))

(deftest parse-names
  (is (= (parse-date "d-MMM-yy" "en" true "26-JUL-16") "2016-7-26"))
  (is (= (parse-date "d-MMM-yy" "es" false "31-dic-20") "2020-12-31"))
  (is (= (parse-date "d-MMM-yy" "en" false "26-JUL-16") "Text '26-JUL-16' could not be parsed at index 3")))
