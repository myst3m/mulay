(ns golden-cal-test
  (:require [golden-cal-data :as g]
            [mulay.lib.time.types :as t]
            [mulay.lib.time.civil :as cv]
            [mulay.lib.time.local :as l]
            [mulay.lib.time.iso :as iso]
            [clay.string :as str]))

;; java.time で作った暦の golden (tools/gen-time-golden.java)。
(defn- line Str [d: &t/LocalDate]
  (let [y (:year d) m (:month d) dd (:day d)]
    (str/join "\t" [(iso/date-str d) (str (l/date-epoch-day d)) (str (l/date-dow d)) (str (l/date-doy d))
                    (str (cv/week-based-year y m dd 1 4)) (str (cv/week-of-wby y m dd 1 4)) (str (cv/week-of-month y m dd 1 4)) (str (cv/week-of-year y m dd 1 4))
                    (str (cv/week-based-year y m dd 7 1)) (str (cv/week-of-wby y m dd 7 1)) (str (cv/week-of-month y m dd 7 1)) (str (cv/week-of-year y m dd 7 1))
                    (str (cv/localized-dow (l/date-epoch-day d) 7)) (str (l/date-length-of-month d)) (if (l/date-leap? d) "true" "false")])))

(defn- run Int []
  (let [cs (g/cases)]
    (loop [i 0 bad 0]
      (if (>= i (count cs)) bad
        (let [want: Str (nth cs i)
              ds: Str (nth (str/split want "\t") 0)
              [d e] (iso/parse-date ds)
              got (if (= e "") (line d) (str "parse error " e))
              ok (= got want)]
          (if (not ok) (println (str "  want " want "\n  got  " got)) 0)
          (recur (+ i 1) (if ok bad (+ bad 1))))))))

(deftest golden-calendar
  (is (> (count (g/cases)) 1000))
  (is (= (run) 0)))
