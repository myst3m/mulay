(defn cases Vec(Str) []
  (let [acc: Vec(Str) []]
    (-> acc
        (concat (part0))
        (concat (part1))
        (concat (part2))
        (concat (part3))
        (concat (part4))
        (concat (part5))
        (concat (part6))
        (concat (part7))
        (concat (part8)))))
