(ns iso-test (:require [mulay.lib.time.types :as t] [mulay.lib.time.iso :as iso] [mulay.lib.time.zoned :as zd] [mulay.lib.time.amount :as am]))

(deftest iso-roundtrip
  (let [[z e] (iso/parse-zdt "2020-03-08T01:30:00-05:00[America/New_York]")
        [z2 e2] (zd/zdt-plus-duration z (am/duration-of-hours 1))
        [z3 e3] (iso/parse-zdt "2020-03-08T02:30:00[America/New_York]")
        [d e4] (iso/parse-date "2021-02-30")
        [tm e5] (iso/parse-time "10:00:00.120")]
    (is (= e ""))
    (is (= (iso/zdt-str z) "2020-03-08T01:30-05:00[America/New_York]"))
    (is (= (iso/zdt-str z2) "2020-03-08T03:30-04:00[America/New_York]"))
    (is (= (iso/zdt-str z3) "2020-03-08T03:30-04:00[America/New_York]"))
    (is (= e4 "Text '2021-02-30' could not be parsed: Invalid date 'FEBRUARY 30'"))
    (is (= (iso/time-str tm) "10:00:00.120"))
    (is (= (iso/dw-time-str tm) "10:00:00.12"))))
