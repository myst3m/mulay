(ns local-test (:require [mulay.lib.time.types :as t] [mulay.lib.time.local :as l] [mulay.lib.time.amount :as am]))

(deftest plus-months-clamps
  (let [[d e] (l/of-date 2020 1 31)
        [d2 e2] (l/date-plus-months d 1)
        [d3 e3] (l/date-plus-period d (am/period 1 1 0))
        [x e4] (l/of-date 2021 2 29)]
    (is (= e ""))
    (is (= d2 (t/->LocalDate 2020 2 29)))
    (is (= d3 (t/->LocalDate 2021 2 28)))
    (is (= e4 "Invalid date 'February 29' as '2021' is not a leap year"))))

(deftest amounts
  (let [[p e] (am/parse-period "P1Y2M3W4D")
        [d e2] (am/parse-duration "PT-1.5S")
        [d3 e3] (am/parse-duration "P1DT2H")]
    (is (= (am/period-str p) "P1Y2M25D"))
    (is (= (am/duration-str d) "PT-1.5S"))
    (is (= (am/duration-str d3) "PT26H"))))
