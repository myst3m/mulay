(ns tz-test (:require [mulay.lib.time.types :as t] [mulay.lib.time.tz :as tz]))

(deftest tokyo-rules
  (let [[r ok] (tz/rules-for-id "Asia/Tokyo")
        [ny ok2] (tz/rules-for-id "America/New_York")]
    (is ok)
    (is (= (tz/offset-at r 1600000000) 32400))
    (is (= (tz/abbr-at r 1600000000) "JST"))
    (is (= (tz/offset-at ny 1600000000) -14400))
    (is (= (tz/offset-at ny 4102444800) -18000))
    (is (= (tz/offset-at ny 4118083200) -14400))
    (is (tz/dst-at? ny 4118083200))))

(deftest zone-ids
  (let [[z e] (tz/zone-of-id "GMT+9")
        [z2 e2] (tz/zone-of-id "Nowhere/City")
        [z3 e3] (tz/zone-of-id "+05:30")]
    (is (= (t/zone-id z) "GMT+09:00"))
    (is (= e2 "Unknown time-zone ID: Nowhere/City"))
    (is (= (t/zone-id z3) "+05:30"))))
