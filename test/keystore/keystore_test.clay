(ns keystore-test (:require [mulay.lib.keystore :as ks] [mulay.lib.hash :as hash]))

;; 証明書一式は test/fixtures/apps/https-test/certs (keytool / openssl で作ったもの)
(def DIR "test/fixtures/apps/https-test/certs/")

(defn- file Str [name: &Str] (let [[s e] (read-file (str DIR name))] s))

(deftest server-jks
  (let [[k e] (ks/read-jks (file "server.jks") "changeit" "keypass1")
        key (nth (:keys k) 0)]
    (is (= e ""))
    (is (= (count (:keys k)) 1))
    (is (= (:alias key) "server"))
    (is (= (:key-pem key) (file "server-key.pem")))
    (is (= (nth (:chain-pem key) 0) (file "server.pem")))
    (is (= (nth (:chain-pem key) 1) (file "ca.pem")))))

(deftest trust-jks
  (let [[k e] (ks/read-jks (file "truststore.jks") "changeit" "")]
    (is (= e ""))
    (is (= (count (:certs k)) 1))
    (is (= (:alias (nth (:certs k) 0)) "ca"))
    (is (= (:pem (nth (:certs k) 0)) (file "ca.pem")))))

(deftest errors
  (let [[k1 e1] (ks/read-jks (file "server.jks") "wrong" "keypass1")
        [k2 e2] (ks/read-jks (file "server.jks") "changeit" "wrong")
        [k3 e3] (ks/read-jks (file "server.p12") "changeit" "")]
    (is (= e1 "Keystore was tampered with, or password was incorrect"))
    (is (= e2 "Cannot recover key"))
    (is (= e3 "Invalid keystore format"))
    (is (ks/jks? (file "server.jks")))
    (is-refuted (ks/jks? (file "server.p12")))))

(defn- jks-digest Str [body: &Str pw: &Str]
  (let [pw16 (loop [i 0 out ""] (if (>= i (count pw)) out (recur (+ i 1) (str out (chr 0) (chr (nth pw i))))))]
    (hash/sha1 (str pw16 "Mighty Aphrodite" body))))

;; 検査値を正しく付け直した壊れた JKS (パスワードを知る者が細工したのと同じ) でも、止まらずに誤りを返す
(deftest corrupt-jks-with-valid-digest
  (let [b0 (file "server.jks")
        body (subs b0 0 (- (count b0) 20))
        n (loop [pos 12 bad 0]
            (if (>= pos (count body)) bad
              (let [v (if (= (nth body pos) 255) 0 255)
                    b2 (str (subs body 0 pos) (chr v) (subs body (+ pos 1) (count body)))
                    full (str b2 (jks-digest b2 "changeit"))
                    [k e] (ks/read-jks full "changeit" "keypass1")]
                (recur (+ pos 7) (if (= e "") bad (+ bad 1))))))]
    (is (> n 0))))

;; 信頼する証明書だけを読む (MySQL の trustCertificateKeyStore)。Java の KeyStore.load(in, null) と同じく、
;; パスワードが空なら完全性の検査を飛ばす。鍵の項目は読まない
(deftest jks-certs-only
  (let [[k1 e1] (ks/read-jks-certs (file "truststore.jks") "")
        [k2 e2] (ks/read-jks-certs (file "truststore.jks") "changeit")
        [k3 e3] (ks/read-jks-certs (file "truststore.jks") "wrong")
        [k4 e4] (ks/read-jks-certs (file "server.jks") "changeit")]
    (is (= e1 ""))
    (is (= (:pem (nth (:certs k1) 0)) (file "ca.pem")))
    (is (= e2 ""))
    (is (= (count (:certs k2)) 1))
    (is (= e3 "Keystore was tampered with, or password was incorrect"))
    (is (= e4 ""))
    (is (= (count (:keys k4)) 0))))
