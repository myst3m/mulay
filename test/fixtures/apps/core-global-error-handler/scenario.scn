%%% note
大域エラーハンドラ: <configuration defaultErrorHandler-ref> で、ハンドラを持たないフローが
使うこと (continue なら 200、propagate なら既定のエラー応答)、<error-handler ref> での共有、
自分のハンドラが当たらないとき大域に行くか、ハンドラ無しの try、flow-ref で呼ばれた
ハンドラ無しのフローで大域ハンドラが動いて呼び出し元が続くか。
%%% port 18123
%%% request GET /global/recoverable
%%% response 200
content-type: application/json; charset=UTF-8

{
  "handledBy": "global-continue",
  "errorType": "RECOVERABLE",
  "description": "recover me"
}
%%% request GET /global/fatal
%%% response 500
content-type: text/plain; charset=UTF-8

fatal failure
%%% request GET /ref
%%% response 200
content-type: application/json; charset=UTF-8

{
  "handledBy": "shared-by-ref",
  "errorType": "FATAL"
}
%%% request GET /own-no-match
%%% response 500
content-type: text/plain; charset=UTF-8

own handler does not match
%%% request GET /try-inside
%%% response 200

after try (not reached?)
%%% request GET /caller
%%% response 200
content-type: application/json; charset=UTF-8

{
  "callerContinued": true,
  "payload": {
    "handledBy": "global-continue",
    "errorType": "RECOVERABLE",
    "description": "callee failed"
  }
}
