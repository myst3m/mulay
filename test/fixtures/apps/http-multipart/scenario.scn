%%% note
multipart: listener が multipart/form-data を受けて parts を読む、DW の multipart を http:request で送る (form-data、mixed)、生の本文。
%%% port 18404
%%% mask
boundary=([-_A-Za-z0-9]+)
^--([-_A-Za-z0-9]{8,})(--)?$
%%% request POST /recv
Content-Type: multipart/form-data; boundary=XyZ123

--XyZ123
Content-Disposition: form-data; name="a"

alpha
--XyZ123
Content-Disposition: form-data; name="f"; filename="t.txt"
Content-Type: text/plain

file text
--XyZ123--
%%% response 200
content-type: application/json; charset=UTF-8

{
  "contentType": "multipart/form-data",
  "parts": [
    {
      "name": "a",
      "filename": {
        "name": "a",
        "subtype": "form-data"
      },
      "contentType": null,
      "content": "alpha"
    },
    {
      "name": "f",
      "filename": {
        "name": "f",
        "filename": "t.txt",
        "subtype": "form-data"
      },
      "contentType": "text/plain",
      "content": "file text"
    }
  ]
}
%%% request POST /send-form
%%% response 200
content-type: application/json; charset=UTF-8

{
  "contentType": "multipart/form-data",
  "parts": [
    {
      "name": "field1",
      "filename": {
        "name": "field1",
        "subtype": "form-data"
      },
      "contentType": "text/plain",
      "content": "hello"
    },
    {
      "name": "file1",
      "filename": {
        "name": "file1",
        "filename": "a.json",
        "subtype": "form-data"
      },
      "contentType": "application/json",
      "content": {
        "a": 1
      }
    }
  ]
}
%%% request POST /send-mixed
%%% response 200
content-type: application/json; charset=UTF-8

{
  "contentType": "multipart/mixed",
  "parts": [
    {
      "name": "part0",
      "filename": null,
      "contentType": "text/plain",
      "content": "x"
    },
    {
      "name": "part1",
      "filename": null,
      "contentType": "text/plain",
      "content": "y"
    }
  ]
}
%%% request POST /send-raw
%%% response 500
content-type: text/plain; charset=UTF-8

HTTP POST on resource 'http://localhost:18404/raw' failed: internal server error (500).
%%% request POST /parse-part
Content-Type: multipart/form-data; boundary=XyZ123

--XyZ123
Content-Disposition: form-data; name="x"
Content-Type: application/csv; separator=|

a|b
1|2
--XyZ123--
%%% response 200
content-type: application/json; charset=UTF-8

[
  {
    "a": "1",
    "b": "2"
  }
]
