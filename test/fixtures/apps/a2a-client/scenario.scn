%%% note
A2A コネクタ 1.1.1 のクライアントの接続: <a2a:authentication> (http:basic-authentication) と <a2a:default-headers>、
操作の <a2a:additional-properties>。サーバーの認可のフローは Basic の Authorization だけを通す。
%%% port 18167
%%% request GET /t/send?cfg=basic
%%% response 200
content-type: application/json; charset=UTF-8

{
  "result": {
    "role": "agent",
    "parts": [
      {
        "text": "ok",
        "kind": "text"
      }
    ],
    "messageId": "m-1",
    "kind": "message"
  },
  "hdrs": {
    "authorization": "Basic YWdlbnQ6czNjcmV0",
    "xDefault": "d1",
    "xExtra": "e1",
    "ctype": "application/json"
  }
}
%%% request GET /t/send?cfg=none
%%% response 200
content-type: application/json; charset=UTF-8

{
  "result": {
    "role": "agent",
    "parts": [
      {
        "text": "ok",
        "kind": "text"
      }
    ],
    "messageId": "m-1",
    "kind": "message"
  },
  "hdrs": {
    "authorization": null,
    "xDefault": null,
    "xExtra": null,
    "ctype": "application/json"
  }
}
%%% request GET /t/get?cfg=basic
%%% response 200
content-type: application/json; charset=UTF-8

{
  "error": "A2A:TASK_NOT_FOUND",
  "description": "Error -32001: Task not found"
}
%%% request GET /t/get?cfg=none
%%% response 200
content-type: application/json; charset=UTF-8

{
  "error": "A2A:UNAUTHORIZED",
  "description": "Error -32005: Unauthorized"
}
