#%RAML 0.8
title: Legacy
mediaType: application/json
schemas:
  - note: |
      {
        "$schema": "http://json-schema.org/draft-04/schema#",
        "type": "object",
        "required": ["text"],
        "properties": {"text": {"type": "string", "maxLength": 3}}
      }
/notes:
  get:
    queryParameters:
      page:
        type: integer
        minimum: 1
      mode:
        enum: [a, b]
        required: true
  post:
    body:
      application/json:
        schema: note
  /{noteId}:
    uriParameters:
      noteId:
        type: integer
    get:
/forms:
  post:
    body:
      application/x-www-form-urlencoded:
        formParameters:
          a:
            type: string
            required: true
          n:
            type: integer
