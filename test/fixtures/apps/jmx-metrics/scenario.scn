%%% note
jmx の collect-* (JVM のメトリクス): 値は揺れるので型だけ。キーの構造 (入れ子、並び) が実モジュールと同じか。
%%% port 18406
%%% request GET /metrics
%%% response 200
content-type: application/json; charset=UTF-8

{
  "timestamp": "number",
  "os": {
    "name": "string",
    "arch": "string",
    "version": "string",
    "availableProcessors": "number",
    "systemLoadAverage": "number",
    "totalPhysicalMemorySize": "number",
    "freePhysicalMemorySize": "number",
    "committedVirtualMemorySize": "number",
    "totalSwapSpaceSize": "number",
    "freeSwapSpaceSize": "number"
  },
  "cpu": {
    "processCpuLoad": "number",
    "processCpuTime": "number",
    "systemCpuLoad": "number",
    "availableProcessors": "number",
    "systemLoadAverage": "number"
  },
  "memory": {
    "heap": {
      "init": "number",
      "used": "number",
      "committed": "number",
      "max": "number"
    },
    "nonHeap": {
      "init": "number",
      "used": "number",
      "committed": "number",
      "max": "number"
    },
    "objectPendingFinalizationCount": "number"
  },
  "memoryPools": "array",
  "gc": "array",
  "threads": {
    "threadCount": "number",
    "peakThreadCount": "number",
    "totalStartedThreadCount": "number",
    "daemonThreadCount": "number",
    "states": "object"
  },
  "classLoading": {
    "loadedClassCount": "number",
    "totalLoadedClassCount": "number",
    "unloadedClassCount": "number"
  },
  "runtime": {
    "vmName": "string",
    "vmVendor": "string",
    "vmVersion": "string",
    "specVersion": "string",
    "uptime": "number",
    "startTime": "number",
    "inputArguments": "array",
    "pid": "number"
  },
  "bufferPools": "array"
}
%%% request GET /cpu
%%% response 200
content-type: application/json; charset=UTF-8

{
  "processCpuLoad": "number",
  "processCpuTime": "number",
  "systemCpuLoad": "number",
  "availableProcessors": "number",
  "systemLoadAverage": "number"
}
%%% request GET /memory
%%% response 200
content-type: application/json; charset=UTF-8

{
  "memory": {
    "heap": {
      "init": "number",
      "used": "number",
      "committed": "number",
      "max": "number"
    },
    "nonHeap": {
      "init": "number",
      "used": "number",
      "committed": "number",
      "max": "number"
    },
    "objectPendingFinalizationCount": "number"
  },
  "memoryPools": "array"
}
%%% request GET /gc
%%% response 200
content-type: application/json; charset=UTF-8

"array"
%%% request GET /threads
%%% response 200
content-type: application/json; charset=UTF-8

{
  "threadCount": "number",
  "peakThreadCount": "number",
  "totalStartedThreadCount": "number",
  "daemonThreadCount": "number",
  "states": "object"
}
