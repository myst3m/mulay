%%% note
listener で大きな要求の本文 (2 MB、20 MB) を受ける。HTTP/1.1 (平文と TLS)、HTTP/2 (http2-support を有効にした平文の h2c と、TLS の ALPN の h2)。
大きな本文は 2 回読めて、file:write で書いた後も読める。実 Mule は本文を流して読むので、大きさの上限が無い (200 MB も受けることを 2026-10-25 に手で確かめた)。
mulay は 512 KB を超える本文を流して受け、ファイルに逃がす (ADR 104)。
%%% port 18571
%%% tls 18572
%%% startdir /tmp/mulay-oracle-http-request-body
%%% request POST /size
Content-Type: text/plain

0123456789
%%% response 200
content-type: application/json; charset=UTF-8

{
  "size": 10,
  "head": "0123456789",
  "version": "HTTP/1.1"
}
%%% request POST /size h2=1
Content-Type: text/plain

0123456789
%%% response 200
content-type: application/json; charset=UTF-8

{
  "size": 10,
  "head": "0123456789",
  "version": "HTTP/2"
}
%%% request POST /size h2=1 repeat=200000
Content-Type: text/plain

0123456789
%%% response 200
content-type: application/json; charset=UTF-8

{
  "size": 2000000,
  "head": "0123456789",
  "version": "HTTP/2"
}
%%% request POST /size h2=1 repeat=2000000
Content-Type: text/plain

0123456789
%%% response 200
content-type: application/json; charset=UTF-8

{
  "size": 20000000,
  "head": "0123456789",
  "version": "HTTP/2"
}
%%% request GET /size h2=1
%%% response 200
content-type: application/json; charset=UTF-8

{
  "size": 0,
  "head": null,
  "version": "HTTP/2"
}
%%% request POST :18572/size h2=1 repeat=2000000
Content-Type: text/plain

0123456789
%%% response 200
content-type: application/json; charset=UTF-8

{
  "size": 20000000,
  "head": "0123456789",
  "version": "HTTP/2"
}
%%% request POST /twice h2=1 repeat=2000000
Content-Type: text/plain

0123456789
%%% response 200
content-type: application/json; charset=UTF-8

{
  "first": 20000000,
  "second": 20000000,
  "tail": "0123456789"
}
%%% request POST /write h2=1 repeat=2000000
Content-Type: text/plain

0123456789
%%% response 200
content-type: application/json; charset=UTF-8

{
  "written": 20000000,
  "payloadAfter": 20000000,
  "tail": "0123456789"
}
%%% request POST /write h2=1 repeat=10000
Content-Type: text/plain

0123456789
%%% response 200
content-type: application/json; charset=UTF-8

{
  "written": 100000,
  "payloadAfter": 100000,
  "tail": "0123456789"
}
%%% request POST /size repeat=2000000
Content-Type: text/plain

0123456789
%%% response 200
content-type: application/json; charset=UTF-8

{
  "size": 20000000,
  "head": "0123456789",
  "version": "HTTP/1.1"
}
%%% request POST :18572/size repeat=2000000
Content-Type: text/plain

0123456789
%%% response 200
content-type: application/json; charset=UTF-8

{
  "size": 20000000,
  "head": "0123456789",
  "version": "HTTP/1.1"
}
%%% request POST /twice repeat=2000000
Content-Type: text/plain

0123456789
%%% response 200
content-type: application/json; charset=UTF-8

{
  "first": 20000000,
  "second": 20000000,
  "tail": "0123456789"
}
%%% request POST /write repeat=2000000
Content-Type: text/plain

0123456789
%%% response 200
content-type: application/json; charset=UTF-8

{
  "written": 20000000,
  "payloadAfter": 20000000,
  "tail": "0123456789"
}
