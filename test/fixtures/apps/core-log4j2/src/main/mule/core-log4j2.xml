<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
    <http:listener-config name="L"><http:listener-connection host="0.0.0.0" port="18567"/></http:listener-config>
    <flow name="levels">
        <http:listener config-ref="L" path="/levels"/>
        <logger level="DEBUG" message="mule debug"/>
        <logger level="INFO" message="mule info"/>
        <logger level="INFO" category="orders" message="orders info"/>
        <logger level="DEBUG" category="orders" message="orders debug"/>
        <logger level="DEBUG" category="com.example" message="example debug"/>
        <logger level="TRACE" category="com.example.child" message="child trace"/>
        <logger level="DEBUG" category="com.example.child" message="child debug"/>
        <logger level="WARN" category="com.example.quiet" message="quiet warn"/>
        <logger level="ERROR" category="com.example.quiet.inner" message="quiet inner error"/>
        <logger level="ERROR" category="com.example.off" message="off error"/>
        <logger level="INFO" category="com.examplex" message="examplex info"/>
        <set-payload value="logged"/>
    </flow>
</mule>
