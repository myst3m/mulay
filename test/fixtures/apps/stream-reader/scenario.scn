%%% note
リーダーの streaming=true (JSON の配列、CSV) を foreach で回すとき、値として読むとき、2 回読むとき、配列でないとき、途中で壊れているとき。
%%% port 18194
%%% startdir /tmp/mulay-oracle-stream-reader
%%% request GET /seed
%%% response 200

ok
%%% request GET /foreach
%%% response 200
content-type: application/json; charset=UTF-8

[
  {
    "counter": 1,
    "n": 3,
    "first": "{\"id\": 1,\"v\": \"a\"}",
    "cls": "java.util.ArrayList",
    "mime": "*/*"
  },
  {
    "counter": 2,
    "n": 3,
    "first": "{\"id\": 4,\"v\": \"d\"}",
    "cls": "java.util.ArrayList",
    "mime": "*/*"
  },
  {
    "counter": 3,
    "n": 1,
    "first": "{\"id\": 7,\"v\": \"g\"}",
    "cls": "java.util.ArrayList",
    "mime": "*/*"
  }
]
%%% request GET /foreach?path=nested.json
%%% response 200
content-type: application/json; charset=UTF-8

[
  {
    "counter": 1,
    "n": 3,
    "first": "[1,2]",
    "cls": "java.util.ArrayList",
    "mime": "*/*"
  },
  {
    "counter": 2,
    "n": 2,
    "first": "1.5E+2",
    "cls": "java.util.ArrayList",
    "mime": "*/*"
  }
]
%%% request GET /foreach?path=obj.json
%%% response 200
content-type: application/json; charset=UTF-8

[
  {
    "counter": 1,
    "n": 2,
    "first": "{\"a\": 1}",
    "cls": "java.util.ArrayList",
    "mime": "*/*"
  }
]
%%% request GET /foreach?path=bad.json
%%% response 200
content-type: application/json; charset=UTF-8

[
  {
    "counter": 1,
    "n": 3,
    "first": "{\"id\": 1}",
    "cls": "java.util.ArrayList",
    "mime": "*/*"
  },
  {
    "counter": 2,
    "n": 2,
    "first": "{\"id\": 4}",
    "cls": "java.util.ArrayList",
    "mime": "*/*"
  }
]
%%% request GET /foreach?path=arr.json&mime=application/json
%%% response 200
content-type: application/json; charset=UTF-8

[
  {
    "counter": 1,
    "n": 3,
    "first": "{\"id\": 1,\"v\": \"a\"}",
    "cls": "java.util.ArrayList",
    "mime": "*/*"
  },
  {
    "counter": 2,
    "n": 3,
    "first": "{\"id\": 4,\"v\": \"d\"}",
    "cls": "java.util.ArrayList",
    "mime": "*/*"
  },
  {
    "counter": 3,
    "n": 1,
    "first": "{\"id\": 7,\"v\": \"g\"}",
    "cls": "java.util.ArrayList",
    "mime": "*/*"
  }
]
%%% request GET /foreach?path=rows.csv&mime=application/csv;%20streaming=true
%%% response 200
content-type: application/json; charset=UTF-8

[
  {
    "counter": 1,
    "n": 3,
    "first": "[{\"id\": \"1\",\"v\": \"a\"}]",
    "cls": "java.util.ArrayList",
    "mime": "*/*"
  },
  {
    "counter": 2,
    "n": 2,
    "first": "[{\"id\": \"4\",\"v\": \"d\"}]",
    "cls": "java.util.ArrayList",
    "mime": "*/*"
  }
]
%%% request GET /foreach?path=rows.csv&mime=application/csv
%%% response 200
content-type: application/json; charset=UTF-8

[
  {
    "counter": 1,
    "n": 3,
    "first": "[{\"id\": \"1\",\"v\": \"a\"}]",
    "cls": "java.util.ArrayList",
    "mime": "*/*"
  },
  {
    "counter": 2,
    "n": 2,
    "first": "[{\"id\": \"4\",\"v\": \"d\"}]",
    "cls": "java.util.ArrayList",
    "mime": "*/*"
  }
]
%%% request GET /foreach-one
%%% response 200
content-type: application/json; charset=UTF-8

[
  "{\"id\": 1,\"v\": \"a\"}",
  "{\"id\": 2,\"v\": \"b\"}",
  "{\"id\": 3,\"v\": \"c\"}",
  "{\"id\": 4,\"v\": \"d\"}",
  "{\"id\": 5,\"v\": \"e\"}",
  "{\"id\": 6,\"v\": \"f\"}",
  "{\"id\": 7,\"v\": \"g\"}"
]
%%% request GET /foreach-one?path=bad.json
%%% response 200
content-type: application/json; charset=UTF-8

[
  "{\"id\": 1}",
  "{\"id\": 2}",
  "{\"id\": 3}",
  "{\"id\": 4}",
  "{\"id\": 5}"
]
%%% request GET /value
%%% response 200
content-type: application/json; charset=UTF-8

{
  "size": 7,
  "third": 3,
  "ids": [
    1,
    2,
    3,
    4,
    5,
    6,
    7
  ]
}
%%% request GET /map
%%% response 200
content-type: application/json; charset=UTF-8

[
  10,
  20,
  30,
  40,
  50,
  60,
  70
]
%%% request GET /twice
%%% response 200
content-type: application/json; charset=UTF-8

{
  "before": 7,
  "seen": 7,
  "after": 7
}
%%% request GET /twice-foreach
%%% response 200
content-type: application/json; charset=UTF-8

{
  "a": 7,
  "b": 7
}
