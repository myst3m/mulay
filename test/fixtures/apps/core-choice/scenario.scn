%%% note
choice ルーター: 最初に真の when だけが動く、otherwise の有無、入れ子、when の式が
Boolean でない ("true" という文字列、null、数値) とき、when の式の評価エラー (MULE:EXPRESSION)
がフローのエラーハンドラに届くこと。set-payload の value が文字列のときの応答の content-type。
%%% port 18111
%%% request GET /choice?n=-5
%%% response 200

negative
%%% request GET /choice?n=0
%%% response 200

zero
%%% request GET /choice
%%% response 200

zero
%%% request GET /choice?n=9
%%% response 200

small
%%% request GET /choice?n=10
%%% response 200

medium
%%% request GET /choice?n=99.5
%%% response 200

medium
%%% request GET /choice?n=1000
%%% response 200

large
%%% request GET /choice?n=abc
%%% response 500
content-type: text/plain; charset=UTF-8

"Cannot coerce String (abc) to Number

1| (attributes.queryParams.n default '0') as Number
   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
Trace:
  at anonymous::main (line: 1, column: 1)" evaluating expression: "(attributes.queryParams.n default '0') as Number".
%%% request GET /no-otherwise
%%% response 200
content-type: text/plain

untouched
%%% request GET /no-otherwise?hit=yes
%%% response 200
content-type: text/plain

hit
%%% request GET /nested?a=1&b=1
%%% response 200
content-type: application/json; charset=UTF-8

[
  "a",
  "b"
]
%%% request GET /nested?a=1
%%% response 200
content-type: application/json; charset=UTF-8

[
  "a",
  "not-b"
]
%%% request GET /nested
%%% response 200
content-type: application/json; charset=UTF-8

[
  "not-a"
]
%%% request GET /non-boolean?v=true
%%% response 200

when-taken
%%% request GET /non-boolean?v=false
%%% response 200

otherwise-taken
%%% request GET /non-boolean?v=TRUE
%%% response 200

when-taken
%%% request GET /non-boolean?v=1
%%% response 500
content-type: text/plain; charset=UTF-8

"Unable to convert '1' with class 'java.lang.String' to class 'Boolean', while writing Java at queryParams.v." evaluating expression: "attributes.queryParams.v".
%%% request GET /non-boolean
%%% response 200

otherwise-taken
%%% request GET /expr-error?v=5
%%% response 200

big
%%% request GET /expr-error?v=x
%%% response 200
content-type: application/json; charset=UTF-8

{
  "errorType": "MULE:EXPRESSION",
  "description": "\"Cannot coerce String (x) to Number\n\n1| (attributes.queryParams.v as Number) > 1\n    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\nTrace:\n  at main (line: 1, column: 2)\" evaluating expression: \"(attributes.queryParams.v as Number) > 1\"."
}
