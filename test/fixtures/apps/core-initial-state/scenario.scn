%%% note
flow の initialState: stopped の flow のソース (listener、scheduler) は始まらない。値はプロパティ (${..}) でもよい。
止まった flow を flow-ref で呼んだとき。同じ path を止まった flow と動いている flow が持つとき。
%%% port 18440
%%% request GET /on
%%% response 200

on
%%% request GET /off
%%% response 404
content-type: text/plain

No listener for endpoint: /off
%%% request GET /off-prop
%%% response 404
content-type: text/plain

No listener for endpoint: /off-prop
%%% request GET /dup
%%% response 200

dup-on
%%% request GET /call/stopped-target
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "MULE:UNKNOWN",
  "description": "Cannot process event as \"stopped-target\" is stopped"
}
%%% request GET /call/stopped-target-src
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "MULE:UNKNOWN",
  "description": "Cannot process event as \"stopped-target-src\" is stopped"
}
%%% request GET /ticked
%%% response 200
content-type: application/java; charset=UTF-8

no
