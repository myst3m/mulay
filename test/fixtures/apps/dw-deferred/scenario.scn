%%% note
DW の出力の deferred=true: 応答、型と 2 回読むこと、途中の要素のエラー (変換では出ず、読む側に途中までか空の出力が届く)、ファイルへの書き込み、CSV、変数、Object、streaming=true の入力。
%%% port 18195
%%% startdir /tmp/mulay-oracle-dw-deferred
%%% request GET /seed
%%% response 200

ok
%%% request GET /basic
%%% response 200
content-type: application/json; charset=UTF-8

[
  {
    "id": 1,
    "x": "a!"
  },
  {
    "id": 2,
    "x": "b!"
  },
  {
    "id": 3,
    "x": "c!"
  }
]
%%% request GET /meta
%%% response 200
content-type: application/json; charset=UTF-8

{
  "first": {
    "type": "Array",
    "mime": "application/json",
    "cls": "none",
    "n": 3
  }
}
%%% request GET /error-read
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "MULE:EXPRESSION",
  "step": "read",
  "json": true
}
%%% request GET /error-eager
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "MULE:EXPRESSION",
  "description": "\"Division by zero\n\n4| payload map (10 / $)\n                ^^^^^^\nTrace:\n  at anonymous::main (line: 4, column: 14)\" evaluating expression: \"%dw 2.0\noutput application/json\n---\npayload map (10 / $)\".",
  "step": "transform"
}
%%% request GET /file
%%% response 200
content-type: application/json; charset=UTF-8

{
  "text": "[{\"id\": 1,\"x\": \"A\"},{\"id\": 2,\"x\": \"B\"},{\"id\": 3,\"x\": \"C\"},{\"id\": 4,\"x\": \"D\"}]",
  "prefix": false
}
%%% request GET /file?bad=3
%%% response 200
content-type: application/json; charset=UTF-8

{
  "text": "n/a",
  "prefix": true
}
%%% request GET /file?mime=application/json;%20streaming=true&bad=3
%%% response 200
content-type: application/json; charset=UTF-8

{
  "text": "n/a",
  "prefix": true
}
%%% request GET /csv
%%% response 200
content-type: application/csv; charset=UTF-8

id,v
1,A
2,B

%%% request GET /var
%%% response 200
content-type: application/json; charset=UTF-8

{
  "d": [
    2,
    4,
    6
  ],
  "mime": "application/json",
  "t": "Array"
}
%%% request GET /object
%%% response 200
content-type: application/json; charset=UTF-8

{
  "b": 2,
  "list": [
    1,
    2
  ]
}
%%% request GET /stream
%%% response 200
content-type: text/json; charset=UTF-8

[
  {
    "id": 10
  },
  {
    "id": 20
  },
  {
    "id": 30
  },
  {
    "id": 40
  }
]
%%% request GET /twice
%%% response 200
content-type: application/json; charset=UTF-8

{
  "a": 3,
  "step": "second",
  "type": "MULE:EXPRESSION",
  "pipe": true
}
%%% request GET /after-logger
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "MULE:EXPRESSION",
  "pipe": true
}
%%% request GET /empty
%%% response 200
content-type: application/json; charset=UTF-8

[
  
]
%%% request GET /skipnull
