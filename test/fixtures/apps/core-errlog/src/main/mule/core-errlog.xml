<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <http:listener-config name="L">
        <http:listener-connection host="0.0.0.0" port="18152"/>
    </http:listener-config>

    <!-- 既定のハンドラ: ERROR のログは何回、FlowStack は何段か -->
    <flow name="direct">
        <http:listener config-ref="L" path="/direct"/>
        <raise-error type="APP:BOOM" description="direct boom"/>
    </flow>

    <flow name="via-ref">
        <http:listener config-ref="L" path="/via-ref"/>
        <flow-ref name="failing"/>
    </flow>

    <flow name="failing">
        <set-payload value="x"/>
        <raise-error type="APP:BOOM" description="boom in called flow"/>
    </flow>

    <flow name="via-sub">
        <http:listener config-ref="L" path="/via-sub"/>
        <flow-ref name="failing-sub"/>
    </flow>

    <sub-flow name="failing-sub">
        <raise-error type="APP:BOOM" description="boom in sub-flow"/>
    </sub-flow>

    <flow name="via-ref-handled">
        <http:listener config-ref="L" path="/via-ref-handled"/>
        <flow-ref name="failing"/>
        <error-handler>
            <on-error-continue><set-payload value="handled"/></on-error-continue>
        </error-handler>
    </flow>

    <flow name="via-ref-propagate">
        <http:listener config-ref="L" path="/via-ref-propagate"/>
        <flow-ref name="failing-propagate"/>
    </flow>

    <flow name="failing-propagate">
        <raise-error type="APP:BOOM" description="boom with explicit propagate"/>
        <error-handler>
            <on-error-propagate/>
        </error-handler>
    </flow>

    <flow name="deep">
        <http:listener config-ref="L" path="/deep"/>
        <flow-ref name="level1"/>
    </flow>
    <flow name="level1"><flow-ref name="level2"/></flow>
    <sub-flow name="level2"><flow-ref name="failing"/></sub-flow>
    <flow name="own-propagate">
        <http:listener config-ref="L" path="/own-propagate"/>
        <raise-error type="APP:BOOM" description="own propagate"/>
        <error-handler><on-error-propagate/></error-handler>
    </flow>

    <flow name="own-continue">
        <http:listener config-ref="L" path="/own-continue"/>
        <raise-error type="APP:BOOM" description="own continue"/>
        <error-handler><on-error-continue><set-payload value="ok"/></on-error-continue></error-handler>
    </flow>

    <flow name="try-propagate">
        <http:listener config-ref="L" path="/try-propagate"/>
        <try>
            <raise-error type="APP:BOOM" description="try propagate"/>
            <error-handler><on-error-propagate/></error-handler>
        </try>
    </flow>

    <flow name="try-continue">
        <http:listener config-ref="L" path="/try-continue"/>
        <try>
            <raise-error type="APP:BOOM" description="try continue"/>
            <error-handler><on-error-continue><set-payload value="ok"/></on-error-continue></error-handler>
        </try>
    </flow>

    <flow name="nolog">
        <http:listener config-ref="L" path="/nolog"/>
        <raise-error type="APP:BOOM" description="no log"/>
        <error-handler><on-error-propagate logException="false"/></error-handler>
    </flow>

    <flow name="nolog-continue">
        <http:listener config-ref="L" path="/nolog-continue"/>
        <raise-error type="APP:BOOM" description="no log continue"/>
        <error-handler><on-error-continue logException="false"><set-payload value="ok"/></on-error-continue></error-handler>
    </flow>
    <flow name="handler-fails">
        <http:listener config-ref="L" path="/handler-fails"/>
        <raise-error type="APP:BOOM" description="first"/>
        <error-handler>
            <on-error-propagate>
                <raise-error type="APP:AGAIN" description="second in handler"/>
            </on-error-propagate>
        </error-handler>
    </flow>

    <flow name="handler-fails-continue">
        <http:listener config-ref="L" path="/handler-fails-continue"/>
        <raise-error type="APP:BOOM" description="first"/>
        <error-handler>
            <on-error-continue>
                <set-variable variableName="m" value="#[output application/java --- {'APP:BOOM': 409}]"/>
                <set-variable variableName="k" value="#[output text/plain --- 'APP:BOOM']"/>
                <set-variable variableName="s" value="#[vars.m[vars.k] default 500]"/>
                <set-payload value="ok"/>
            </on-error-continue>
        </error-handler>
    </flow>

</mule>
