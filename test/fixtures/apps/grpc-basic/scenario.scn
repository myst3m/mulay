{"name": "Ann", "count": 2, "tags": ["a", "b"]}
%%% response 200
content-type: application/grpc
grpc-encoding: identity
grpc-accept-encoding: identity,deflate,gzip
grpc-status (trailer): 0

{"message": "Ann", "n": 2, "tags": ["a", "b"]}
%%% log
INFO org.mule.runtime.core.internal.processor.LoggerMessageProcessor: "hello Ann"
