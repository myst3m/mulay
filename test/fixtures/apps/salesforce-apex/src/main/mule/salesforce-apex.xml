<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:salesforce="http://www.mulesoft.org/schema/mule/salesforce"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/salesforce http://www.mulesoft.org/schema/mule/salesforce/current/mule-salesforce.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <configuration-properties file="config.yaml"/>
    <configuration-properties file="sf-secret.yaml"/>

    <http:listener-config name="HTTP">
        <http:listener-connection host="0.0.0.0" port="${http.port}"/>
    </http:listener-config>

    <salesforce:sfdc-config name="SF">
        <salesforce:oauth-client-credentials-connection>
            <salesforce:oauth-client-credentials clientId="${sf.clientId}" clientSecret="${sf.clientSecret}" tokenUrl="${sf.tokenUrl}"/>
        </salesforce:oauth-client-credentials-connection>
    </salesforce:sfdc-config>

    <error-handler name="report">
        <on-error-continue>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{"type": error.errorType.namespace ++ ":" ++ error.errorType.identifier, description: error.description}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        </on-error-continue>
    </error-handler>

        <flow name="rest-get">
        <http:listener config-ref="HTTP" path="/rest-get"/>
        <salesforce:invoke-apex-rest-method config-ref="SF" className="MulayRest" methodName="doGet^/mulay/*^HttpGet^String^">
            <salesforce:request>#[{queryParams: {name: "mule"}, URLParameters: {Parameter1: "abc"}}]</salesforce:request>
        </salesforce:invoke-apex-rest-method>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{payload: payload, class: payload.^class, outClass: payload[keysOf(payload)[0] as String].^class}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="rest-post">
        <http:listener config-ref="HTTP" path="/rest-post"/>
        <salesforce:invoke-apex-rest-method config-ref="SF" className="MulayRest" methodName="doPost^/mulay/*^HttpPost^Result^name=String,n=Integer">
            <salesforce:request>#[{body: {name: "mule", n: 21}}]</salesforce:request>
        </salesforce:invoke-apex-rest-method>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{payload: payload, class: payload.^class, outClass: payload[keysOf(payload)[0] as String].^class}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="rest-put">
        <http:listener config-ref="HTTP" path="/rest-put"/>
        <salesforce:invoke-apex-rest-method config-ref="SF" className="MulayRest" methodName="doPut^/mulay/*^HttpPut^List&lt;String&gt;^xs=List&lt;String&gt;">
            <salesforce:request>#[{body: {xs: ["a", "b", "c"]}}]</salesforce:request>
        </salesforce:invoke-apex-rest-method>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{payload: payload, class: payload.^class, outClass: payload[keysOf(payload)[0] as String].^class}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="rest-delete">
        <http:listener config-ref="HTTP" path="/rest-delete"/>
        <salesforce:invoke-apex-rest-method config-ref="SF" className="MulayRest" methodName="doDelete^/mulay/*^HttpDelete^Long^">
            <salesforce:request>#[{}]</salesforce:request>
        </salesforce:invoke-apex-rest-method>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{payload: payload, class: payload.^class, outClass: payload[keysOf(payload)[0] as String].^class}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="rest-patch">
        <http:listener config-ref="HTTP" path="/rest-patch"/>
        <salesforce:invoke-apex-rest-method config-ref="SF" className="MulayRest" methodName="doPatch^/mulay/*^HttpPatch^Date^d=Date">
            <salesforce:request>#[{body: {d: "2020-01-31"}}]</salesforce:request>
        </salesforce:invoke-apex-rest-method>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{payload: payload, class: payload.^class, outClass: payload[keysOf(payload)[0] as String].^class}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="rest-error">
        <http:listener config-ref="HTTP" path="/rest-error"/>
        <salesforce:invoke-apex-rest-method config-ref="SF" className="MulayRest" methodName="doPost^/mulay/*^HttpPost^Result^name=String,n=Integer">
            <salesforce:request>#[{body: {name: "mule", n: "x"}}]</salesforce:request>
        </salesforce:invoke-apex-rest-method>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{payload: payload, class: payload.^class, outClass: payload[keysOf(payload)[0] as String].^class}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="rest-bad-key">
        <http:listener config-ref="HTTP" path="/rest-bad-key"/>
        <salesforce:invoke-apex-rest-method config-ref="SF" className="MulayRest" methodName="doGet">
            <salesforce:request>#[{}]</salesforce:request>
        </salesforce:invoke-apex-rest-method>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{payload: payload, class: payload.^class, outClass: payload[keysOf(payload)[0] as String].^class}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="soap-hello">
        <http:listener config-ref="HTTP" path="/soap-hello"/>
        <salesforce:invoke-apex-soap-method config-ref="SF" className="MulaySoap" methodName="hello">
            <salesforce:input><![CDATA[#[%dw 2.0
output application/xml
ns ns0 http://soap.sforce.com/schemas/class/MulaySoap
---
{ns0#hello: {ns0#name: "mule"}}]]]></salesforce:input>
        </salesforce:invoke-apex-soap-method>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{mime: payload.^mimeType, xml: write(payload, "application/xml", {indent: false}), value: payload}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="soap-add">
        <http:listener config-ref="HTTP" path="/soap-add"/>
        <salesforce:invoke-apex-soap-method config-ref="SF" className="MulaySoap" methodName="add">
            <salesforce:input><![CDATA[#[%dw 2.0
output application/xml
ns ns0 http://soap.sforce.com/schemas/class/MulaySoap
---
{ns0#add: {ns0#a: 2, ns0#b: 40}}]]]></salesforce:input>
        </salesforce:invoke-apex-soap-method>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{mime: payload.^mimeType, xml: write(payload, "application/xml", {indent: false}), value: payload}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="soap-split">
        <http:listener config-ref="HTTP" path="/soap-split"/>
        <salesforce:invoke-apex-soap-method config-ref="SF" className="MulaySoap" methodName="split">
            <salesforce:input><![CDATA[#[%dw 2.0
output application/xml
ns ns0 http://soap.sforce.com/schemas/class/MulaySoap
---
{ns0#split: {ns0#s: "a,b,c"}}]]]></salesforce:input>
        </salesforce:invoke-apex-soap-method>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{mime: payload.^mimeType, xml: write(payload, "application/xml", {indent: false}), value: payload}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="soap-bad">
        <http:listener config-ref="HTTP" path="/soap-bad"/>
        <salesforce:invoke-apex-soap-method config-ref="SF" className="MulaySoap" methodName="nope">
            <salesforce:input><![CDATA[#[%dw 2.0
output application/xml
ns ns0 http://soap.sforce.com/schemas/class/MulaySoap
---
{ns0#nope: {}}]]]></salesforce:input>
        </salesforce:invoke-apex-soap-method>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{mime: payload.^mimeType, xml: write(payload, "application/xml", {indent: false}), value: payload}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

</mule>
