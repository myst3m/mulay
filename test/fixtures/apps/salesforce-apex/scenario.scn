%%% note
Salesforce の Apex (d30 の org。sfdx/ の MulayRest と MulaySoap を deploy しておく):
invoke-apex-rest-method (GET / POST / PUT / DELETE / PATCH、methodName の書き方の誤り、Apex の失敗) と
invoke-apex-soap-method (結果の XML、無い method)。
%%% requires src/main/resources/sf-secret.yaml
%%% port 18157
%%% request GET /rest-get
%%% response 200
content-type: application/json; charset=UTF-8

{
  "payload": {
    "doGetOutput": "hello mule abc"
  },
  "class": "java.util.HashMap",
  "outClass": "java.lang.String"
}
%%% request GET /rest-post
%%% response 200
content-type: application/json; charset=UTF-8

{
  "payload": {
    "doPostOutput": {
      "twice": 42,
      "name": "mule",
      "none": null,
      "ok": true,
      "items": [
        1,
        2,
        3
      ]
    }
  },
  "class": "java.util.HashMap",
  "outClass": "java.util.HashMap"
}
%%% request GET /rest-put
%%% response 200
content-type: application/json; charset=UTF-8

{
  "payload": {
    "doPutOutput": [
      "c",
      "b",
      "a"
    ]
  },
  "class": "java.util.HashMap",
  "outClass": "java.util.ArrayList"
}
%%% request GET /rest-delete
%%% response 200
content-type: application/json; charset=UTF-8

{
  "payload": {
    "doDeleteOutput": 1234567890123
  },
  "class": "java.util.HashMap",
  "outClass": "java.lang.Long"
}
%%% request GET /rest-patch
%%% response 200
content-type: application/json; charset=UTF-8

{
  "payload": {
    "doPatchOutput": "2020-02-01T00:00:00"
  },
  "class": "java.util.HashMap",
  "outClass": "java.util.Date"
}
%%% request GET /rest-error
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "SALESFORCE:CONNECTIVITY",
  "description": "Invalid status code: 400, response body: [{\"message\":\"Value does not match expected type at [line:3, column:11]\",\"errorCode\":\"JSON_PARSER_ERROR\"}]"
}
%%% request GET /rest-bad-key
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "SALESFORCE:INVALID_INPUT",
  "description": "restMethodName parameter does not have the proper format (ClassName||MethodName\\^RestResourceURL\\^HttpMethod\\^OutputType\\^InputParameterName1=ParameterType1,InputParameterName2=ParameterType2): MulayRest||doGet"
}
%%% request GET /soap-hello
%%% response 200
content-type: application/json; charset=UTF-8

{
  "mime": "application/xml",
  "xml": "<?xml version='1.0' encoding='UTF-8'?><helloResponse xmlns=\"http://soap.sforce.com/schemas/class/MulaySoap\"><result>hello mule</result></helloResponse>",
  "value": {
    "helloResponse": {
      "result": "hello mule"
    }
  }
}
%%% request GET /soap-add
%%% response 200
content-type: application/json; charset=UTF-8

{
  "mime": "application/xml",
  "xml": "<?xml version='1.0' encoding='UTF-8'?><addResponse xmlns=\"http://soap.sforce.com/schemas/class/MulaySoap\"><result>42</result></addResponse>",
  "value": {
    "addResponse": {
      "result": "42"
    }
  }
}
%%% request GET /soap-split
%%% response 200
content-type: application/json; charset=UTF-8

{
  "mime": "application/xml",
  "xml": "<?xml version='1.0' encoding='UTF-8'?><splitResponse xmlns=\"http://soap.sforce.com/schemas/class/MulaySoap\"><result>a</result><result>b</result><result>c</result></splitResponse>",
  "value": {
    "splitResponse": {
      "result": "a",
      "result": "b",
      "result": "c"
    }
  }
}
%%% request GET /soap-bad
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "SALESFORCE:NOT_FOUND",
  "description": "Client received SOAP Fault from server: No operation available for request {http://soap.sforce.com/schemas/class/MulaySoap}nope, please check the WSDL for the service. Please see the server log to find more detail regarding exact cause of the failure."
}
