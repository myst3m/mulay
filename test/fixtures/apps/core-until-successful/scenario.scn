%%% note
until-successful: 試行ごとに event (変数) が元に戻ること (/vars-reset は変数で数えるので毎回 1)、
n 回目で成功すること (回数は ObjectStore で数える)、maxRetries を使い果たすと
MULE:RETRY_EXHAUSTED になること、その parentErrorType と description (元のエラーの
description のまま)、元のエラー型 (APP:ALWAYS) のハンドラでも捕まえられるか、ハンドラ無しの
既定応答、maxRetries=0 の試行回数。
%%% port 18115
%%% request GET /vars-reset
%%% response 500
content-type: text/plain; charset=UTF-8

attempt 1 failed
%%% request GET /vars-reset?on=1
%%% response 200
content-type: application/json; charset=UTF-8

{
  "attempts": 1
}
%%% request GET /eventually?key=a
%%% response 200
content-type: application/json; charset=UTF-8

{
  "attempts": 3
}
%%% request GET /eventually?key=b&on=1
%%% response 200
content-type: application/json; charset=UTF-8

{
  "attempts": 1
}
%%% request GET /eventually?key=c&on=5
%%% response 200
content-type: application/json; charset=UTF-8

{
  "attempts": 5
}
%%% request GET /eventually?key=d&on=6
%%% response 500
content-type: text/plain; charset=UTF-8

attempt 5 failed
%%% request GET /exhausted
%%% response 200
content-type: application/json; charset=UTF-8

{
  "attempts": 1,
  "errorType": "MULE:RETRY_EXHAUSTED",
  "parent": "MULE:CONNECTIVITY",
  "description": "always fails"
}
%%% request GET /exhausted-unhandled
%%% response 500
content-type: text/plain; charset=UTF-8

always fails
%%% request GET /catch-original
%%% response 200

caught as APP:ALWAYS
%%% request GET /zero
%%% response 200
content-type: application/json; charset=UTF-8

{
  "attempts": 1,
  "errorType": "RETRY_EXHAUSTED"
}
