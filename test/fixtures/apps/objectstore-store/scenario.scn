%%% note
ObjectStore の store の failIfPresent (既定 false) と failOnNullValue (既定 true)。
%%% port 18217
%%% mask
\$ByteBuddy\$withAnnotations@([0-9a-f]+)
%%% request GET /put?key=a&v=1
%%% response 200
content-type: application/json; charset=UTF-8

{
  "ok": true
}
%%% request GET /put?key=a&v=2
%%% response 200
content-type: application/json; charset=UTF-8

{
  "ok": true
}
%%% request GET /get?key=a
%%% response 200
content-type: application/json; charset=UTF-8

{
  "value": "2"
}
%%% request GET /put-fip?key=a&v=3
%%% response 200
content-type: application/json; charset=UTF-8

{
  "ok": false,
  "ns": "OS",
  "id": "KEY_ALREADY_EXISTS",
  "desc": "ObjectStore already contains an object for key 'a'"
}
%%% request GET /get?key=a
%%% response 200
content-type: application/json; charset=UTF-8

{
  "value": "2"
}
%%% request GET /put-fip?key=b&v=1
%%% response 200
content-type: application/json; charset=UTF-8

{
  "ok": true
}
%%% request GET /put-null?key=n
%%% response 200
content-type: application/json; charset=UTF-8

{
  "ok": false,
  "ns": "OS",
  "id": "NULL_VALUE",
  "desc": "A null value was provided. Please provide a non-null value or set the 'failOnNullValue' parameter to 'false'"
}
%%% request GET /get?key=n
%%% response 200
content-type: application/json; charset=UTF-8

{
  "ok": false,
  "ns": "OS",
  "id": "KEY_NOT_FOUND",
  "desc": "ObjectStore 'org.mule.extension.objectstore.api.TopLevelObjectStore$ByteBuddy$withAnnotations@***; location: st' doesn't contain any value for key 'n' and default value was not provided or resolved to a null value."
}
%%% request GET /put-null-ok?key=n
%%% response 200
content-type: application/json; charset=UTF-8

{
  "ok": true
}
%%% request GET /get?key=n
%%% response 200
content-type: application/json; charset=UTF-8

{
  "ok": false,
  "ns": "OS",
  "id": "KEY_NOT_FOUND",
  "desc": "ObjectStore 'org.mule.extension.objectstore.api.TopLevelObjectStore$ByteBuddy$withAnnotations@***; location: st' doesn't contain any value for key 'n' and default value was not provided or resolved to a null value."
}
%%% request GET /put-null-ok?key=a
%%% response 200
content-type: application/json; charset=UTF-8

{
  "ok": true
}
%%% request GET /get?key=a
%%% response 200
content-type: application/json; charset=UTF-8

{
  "value": "2"
}
