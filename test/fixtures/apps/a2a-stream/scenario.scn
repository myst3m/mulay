%%% note
A2A コネクタ 1.1.1 のストリーム (SSE)。message/stream は task-stream-listener のフローを流し、update-task-status /
update-task-artifact の操作がイベントを送る。final の status-update で閉じる。フローの失敗は failed の final を送る。
クライアントの send-stream-message は on-task-status-update / on-task-artifact-update の経路をイベントごとに流し、
payload は {events: [...]}。UUID と時刻は伏せる。
%%% port 18170
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":1,"method":"message/stream","params":{"message":{"kind":"message","role":"user","messageId":"u","parts":[{"kind":"text","text":"go"}]}}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "ctype": "text/event-stream",
  "body": "event: task\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"1\",\"result\":{\"id\":\"<uuid>\",\"contextId\":\"<uuid>\",\"status\":{\"state\":\"submitted\",\"timestamp\":\"<ts>\"},\"artifacts\":[],\"history\":[],\"kind\":\"task\"}}\n\nevent: status-update\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"1\",\"result\":{\"taskId\":\"<uuid>\",\"status\":{\"state\":\"working\",\"message\":{\"role\":\"agent\",\"parts\":[{\"text\":\"working\",\"kind\":\"text\"}],\"messageId\":\"m-w\",\"kind\":\"message\"},\"timestamp\":\"<ts>\"},\"contextId\":\"<uuid>\",\"final\":false,\"kind\":\"status-update\"}}\n\nevent: artifact-update\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"1\",\"result\":{\"taskId\":\"<uuid>\",\"artifact\":{\"artifactId\":\"a1\",\"parts\":[{\"text\":\"chunk go\",\"kind\":\"text\"}]},\"contextId\":\"<uuid>\",\"lastChunk\":true,\"kind\":\"artifact-update\"}}\n\nevent: status-update\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"1\",\"result\":{\"taskId\":\"<uuid>\",\"status\":{\"state\":\"completed\",\"timestamp\":\"<ts>\"},\"contextId\":\"<uuid>\",\"final\":true,\"kind\":\"status-update\"}}\n\n"
}
%%% request GET /t/stream-in
%%% response 200
content-type: application/json; charset=UTF-8

{
  "payload": "{\n  \"message\": {\n    \"role\": \"user\",\n    \"parts\": [\n      {\n        \"text\": \"go\",\n        \"kind\": \"text\"\n      }\n    ],\n    \"messageId\": \"u\",\n    \"kind\": \"message\"\n  }\n}",
  "mime": "application/json",
  "rpc": "message/stream",
  "taskIdIsUuid": true
}
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":2,"method":"message/stream","params":{"message":{"kind":"message","role":"user","messageId":"u","parts":[{"kind":"text","text":"fail"}]}}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "ctype": "text/event-stream",
  "body": "event: task\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"2\",\"result\":{\"id\":\"<uuid>\",\"contextId\":\"<uuid>\",\"status\":{\"state\":\"submitted\",\"timestamp\":\"<ts>\"},\"artifacts\":[],\"history\":[],\"kind\":\"task\"}}\n\nevent: status-update\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"2\",\"result\":{\"taskId\":\"<uuid>\",\"status\":{\"state\":\"failed\",\"timestamp\":\"<ts>\"},\"contextId\":\"<uuid>\",\"final\":true,\"kind\":\"status-update\"}}\n\n"
}
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":3,"method":"message/send","params":{"message":{"kind":"message","role":"user","messageId":"u","parts":[{"kind":"text","text":"plain"}]}}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "ctype": "application/json",
  "body": "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"role\":\"agent\",\"parts\":[{\"text\":\"plain\",\"kind\":\"text\"}],\"messageId\":\"m-1\",\"kind\":\"message\"}}"
}
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":4,"method":"message/stream","params":{"message":{"kind":"message","role":"user","messageId":"u","parts":[{"kind":"text","text":"x"}],"taskId":"nope"}}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 404,
  "ctype": "application/json",
  "body": "{\"jsonrpc\":\"2.0\",\"id\":4,\"error\":{\"code\":-32001,\"message\":\"task not found!\"}}"
}
%%% request GET /t/client-stream
%%% response 200
content-type: application/json; charset=UTF-8

{
  "payloadType": "Object",
  "mime": "application/json",
  "attrClass": "com.mulesoft.connectors.a2a.api.model.transport.StreamingResponseAttributes",
  "attrs": "{\n  \"finalEventFound\": true,\n  \"reasonPhrase\": \"OK\",\n  \"statusCode\": 200\n}",
  "body": "{\n  \"events\": [\n    {\n      \"taskId\": \"<uuid>\",\n      \"status\": {\n        \"state\": \"working\",\n        \"message\": {\n          \"role\": \"agent\",\n          \"parts\": [\n            {\n              \"text\": \"working\",\n              \"kind\": \"text\"\n            }\n          ],\n          \"messageId\": \"m-w\",\n          \"kind\": \"message\"\n        },\n        \"timestamp\": \"<ts>\"\n      },\n      \"contextId\": \"<uuid>\",\n      \"final\": false,\n      \"kind\": \"status-update\"\n    },\n    {\n      \"taskId\": \"<uuid>\",\n      \"artifact\": {\n        \"artifactId\": \"a1\",\n        \"parts\": [\n          {\n            \"text\": \"chunk go\",\n            \"kind\": \"text\"\n          }\n        ]\n      },\n      \"contextId\": \"<uuid>\",\n      \"lastChunk\": true,\n      \"kind\": \"artifact-update\"\n    },\n    {\n      \"taskId\": \"<uuid>\",\n      \"status\": {\n        \"state\": \"completed\",\n        \"timestamp\": \"<ts>\"\n      },\n      \"contextId\": \"<uuid>\",\n      \"final\": true,\n      \"kind\": \"status-update\"\n    }\n  ]\n}",
  "routes": [
    {
      "key": "artifact",
      "value": {
        "type": "String",
        "mime": "*/*",
        "event": "{\"jsonrpc\":\"2.0\",\"id\":\"1\",\"result\":{\"taskId\":\"<uuid>\",\"artifact\":{\"artifactId\":\"a1\",\"parts\":[{\"text\":\"chunk go\",\"kind\":\"text\"}]},\"contextId\":\"<uuid>\",\"lastChunk\":true,\"kind\":\"artifact-update\"}}"
      }
    },
    {
      "key": "status-completed",
      "value": {
        "type": "String",
        "mime": "*/*",
        "attrClass": "java.util.Optional",
        "statusCode": 200,
        "event": "{\"jsonrpc\":\"2.0\",\"id\":\"1\",\"result\":{\"taskId\":\"<uuid>\",\"status\":{\"state\":\"completed\",\"timestamp\":\"<ts>\"},\"contextId\":\"<uuid>\",\"final\":true,\"kind\":\"status-update\"}}"
      }
    },
    {
      "key": "status-working",
      "value": {
        "type": "String",
        "mime": "*/*",
        "attrClass": "java.util.Optional",
        "statusCode": 200,
        "event": "{\"jsonrpc\":\"2.0\",\"id\":\"1\",\"result\":{\"taskId\":\"<uuid>\",\"status\":{\"state\":\"working\",\"message\":{\"role\":\"agent\",\"parts\":[{\"text\":\"working\",\"kind\":\"text\"}],\"messageId\":\"m-w\",\"kind\":\"message\"},\"timestamp\":\"<ts>\"},\"contextId\":\"<uuid>\",\"final\":false,\"kind\":\"status-update\"}}"
      }
    }
  ]
}
%%% request GET /t/client-stream?text=fail
%%% response 200
content-type: application/json; charset=UTF-8

{
  "payloadType": "Object",
  "mime": "application/json",
  "attrClass": "com.mulesoft.connectors.a2a.api.model.transport.StreamingResponseAttributes",
  "attrs": "{\n  \"finalEventFound\": true,\n  \"reasonPhrase\": \"OK\",\n  \"statusCode\": 200\n}",
  "body": "{\n  \"events\": [\n    {\n      \"taskId\": \"<uuid>\",\n      \"status\": {\n        \"state\": \"failed\",\n        \"timestamp\": \"<ts>\"\n      },\n      \"contextId\": \"<uuid>\",\n      \"final\": true,\n      \"kind\": \"status-update\"\n    }\n  ]\n}",
  "routes": [
    {
      "key": "status-failed",
      "value": {
        "type": "String",
        "mime": "*/*",
        "attrClass": "java.util.Optional",
        "statusCode": 200,
        "event": "{\"jsonrpc\":\"2.0\",\"id\":\"2\",\"result\":{\"taskId\":\"<uuid>\",\"status\":{\"state\":\"failed\",\"timestamp\":\"<ts>\"},\"contextId\":\"<uuid>\",\"final\":true,\"kind\":\"status-update\"}}"
      }
    }
  ]
}
