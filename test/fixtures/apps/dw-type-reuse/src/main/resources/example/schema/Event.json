{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "kind": {"enum": ["APPLIED", "APPROVED"]},
    "money": {"type": "object", "properties": {"amount": {"type": "number"}, "currency": {"type": "string"}}, "required": ["amount"], "additionalProperties": false}
  },
  "type": "object",
  "properties": {
    "specversion": {"const": "1.0"},
    "id": {"type": "string", "format": "uuid"},
    "type": {"$ref": "#/$defs/kind"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "amount": {"$ref": "#/$defs/money"},
    "note": {"type": ["string", "null"]},
    "ref": {"anyOf": [{"type": "string"}, {"type": "integer"}]},
    "both": {"allOf": [{"type": "object", "properties": {"a": {"type": "string"}}, "required": ["a"]}, {"type": "object", "properties": {"b": {"type": "string"}}, "required": ["b"]}]},
    "flag": {"type": "boolean"}
  },
  "required": ["specversion", "id", "type"],
  "additionalProperties": false
}
