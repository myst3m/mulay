{
 "$schema": "http://json-schema.org/draft-04/schema#",
 "definitions": {
   "address": {
     "type": "object",
     "properties": {"street_address": {"type": "string"}, "city": {"type": "string"}, "state": {"type": "string"}},
     "required": ["street_address", "city", "state"]
   },
   "person": {
     "type": "object",
     "properties": {"firstName": {"type": "string"}, "lastName": {"type": "string"}, "age": {"type": "integer", "minimum": 0}},
     "required": ["firstName", "lastName"]
   }
 },
 "type": "object",
 "properties": {"person": {"$ref": "#/definitions/person"}, "address": {"$ref": "#/definitions/address"}}
}
