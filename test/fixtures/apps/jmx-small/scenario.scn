%%% note
jmx:get-recent-logs: バッファが小さい (logBufferSize=3) ときの循環。古いものから捨てる。
%%% port 18220
%%% mask
"timestamp":"([^"]*)"
"epochMillis":(\d+)
"thread":"([^"]*)"
%%% request GET /mark?m=1
%%% response 200

marked
%%% request GET /recent?pattern=MARK
%%% response 200
content-type: application/json; charset=UTF-8

{"bufferCapacity":3,"bufferSize":1,"count":1,"entries":[{"timestamp":"***","epochMillis":***,"level":"WARN","logger":"app.jmx","message":"MARK 1","thread":"***"}]}
%%% request GET /mark?m=2
%%% response 200

marked
%%% request GET /mark?m=3
%%% response 200

marked
%%% request GET /mark?m=4
%%% response 200

marked
%%% request GET /mark?m=5
%%% response 200

marked
%%% request GET /recent?pattern=MARK
%%% response 200
content-type: application/json; charset=UTF-8

{"bufferCapacity":3,"bufferSize":3,"count":3,"entries":[{"timestamp":"***","epochMillis":***,"level":"WARN","logger":"app.jmx","message":"MARK 3","thread":"***"},{"timestamp":"***","epochMillis":***,"level":"WARN","logger":"app.jmx","message":"MARK 4","thread":"***"},{"timestamp":"***","epochMillis":***,"level":"WARN","logger":"app.jmx","message":"MARK 5","thread":"***"}]}
%%% request GET /recent?pattern=MARK&lines=2
%%% response 200
content-type: application/json; charset=UTF-8

{"bufferCapacity":3,"bufferSize":3,"count":2,"entries":[{"timestamp":"***","epochMillis":***,"level":"WARN","logger":"app.jmx","message":"MARK 4","thread":"***"},{"timestamp":"***","epochMillis":***,"level":"WARN","logger":"app.jmx","message":"MARK 5","thread":"***"}]}
%%% request GET /recent
%%% response 200
content-type: application/json; charset=UTF-8

{"bufferCapacity":3,"bufferSize":3,"count":3,"entries":[{"timestamp":"***","epochMillis":***,"level":"WARN","logger":"app.jmx","message":"MARK 3","thread":"***"},{"timestamp":"***","epochMillis":***,"level":"WARN","logger":"app.jmx","message":"MARK 4","thread":"***"},{"timestamp":"***","epochMillis":***,"level":"WARN","logger":"app.jmx","message":"MARK 5","thread":"***"}]}
