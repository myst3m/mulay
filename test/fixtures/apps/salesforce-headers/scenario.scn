%%% note
Salesforce コネクタの操作の headers (SOAP ヘッダ。値は Map の中の Map)。d30 の org の Account (名前は "mulay hdr ..."、最初と最後に消す)。
AllOrNoneHeader (create / update / delete で成功する行と失敗する行を混ぜる)、AllowFieldTruncationHeader (Name が 255 字を超える)、
QueryOptions (batchSize。結果の件数は変わらない)、キーの大文字小文字、Map でない値、型の違う値、null、知らない名前、子要素の形。
%%% requires src/main/resources/sf-secret.yaml
%%% port 18564
%%% request POST /reset
%%% response 200
content-type: application/json; charset=UTF-8

{
  "ok": true
}
%%% request POST /create?mode=plain
%%% response 200
content-type: application/json; charset=UTF-8

{
  "items": [
    {
      "successful": true,
      "statusCode": null,
      "message": null
    },
    {
      "successful": false,
      "statusCode": "REQUIRED_FIELD_MISSING",
      "message": "値を入力してください: [Name]"
    }
  ],
  "saved": 1
}
%%% request POST /create?mode=aon
%%% response 200
content-type: application/json; charset=UTF-8

{
  "items": [
    {
      "successful": false,
      "statusCode": "ALL_OR_NONE_OPERATION_ROLLED_BACK",
      "message": "Record rolled back because not all records were valid and the request was using AllOrNone header"
    },
    {
      "successful": false,
      "statusCode": "REQUIRED_FIELD_MISSING",
      "message": "値を入力してください: [Name]"
    }
  ],
  "saved": 0
}
