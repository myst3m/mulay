%%% note
HTTP の attributes (HttpRequestAttributes、HttpResponseAttributes) のキーの並び。keysOf、write (JSON / Java。Java は toString の形)、mapObject。
理由句 (http:response の statusCode / reasonPhrase、エラーの応答)。ポート番号は <port> にする。localAddress は実 Mule でも実行ごとに relativePath との前後が変わるので外して見る。
要求の対象が absolute-form (http://host/path) なら scheme と authority を外し、# から後ろは捨てる。
%%% port 18165
%%% request GET /a/7?x=1&y=2
X-Test: v

%%% response 200
content-type: application/json; charset=UTF-8

{
  "keys": [
    "headers",
    "clientCertificate",
    "method",
    "scheme",
    "queryParams",
    "requestUri",
    "queryString",
    "version",
    "maskedRequestPath",
    "listenerPath",
    "relativePath",
    "uriParams",
    "rawRequestUri",
    "rawRequestPath",
    "remoteAddress",
    "requestPath"
  ],
  "written": "{\n  \"headers\": {\n    \"host\": \"localhost:<port>\",\n    \"x-test\": \"v\"\n  },\n  \"clientCertificate\": null,\n  \"method\": \"GET\",\n  \"scheme\": \"http\",\n  \"queryParams\": {\n    \"x\": \"1\",\n    \"y\": \"2\"\n  },\n  \"requestUri\": \"/a/7?x=1&y=2\",\n  \"queryString\": \"x=1&y=2\",\n  \"version\": \"HTTP/1.1\",\n  \"maskedRequestPath\": null,\n  \"listenerPath\": \"/a/{id}\",\n  \"relativePath\": \"/a/7\",\n  \"uriParams\": {\n    \"id\": \"7\"\n  },\n  \"rawRequestUri\": \"/a/7?x=1&y=2\",\n  \"rawRequestPath\": \"/a/7\",\n  \"remoteAddress\": \"/127.0.0.1:<port>\",\n  \"requestPath\": \"/a/7\"\n}",
  "local": "/127.0.0.1:<port>",
  "java": "org.mule.extension.http.api.HttpRequestAttributes\n{\n   Request path=/a/7\n   Raw request path=/a/7\n   Method=GET\n   Listener path=/a/{id}\n   Local Address=/127.0.0.1:<port>\n   Query String=x=1&y=2\n   Relative Path=/a/7\n   Masked Request Path=null\n   Remote Address=/127.0.0.1:<port>\n   Request Uri=/a/7?x=1&y=2\n   Raw request Uri=/a/7?x=1&y=2\n   Scheme=http\n   Version=HTTP/1.1\n   Headers=[\n      host=localhost:<port>\n      x-test=v\n   ]\n   Query Parameters=[\n      x=1\n      y=2\n   ]\n   URI Parameters=[\n      id=7\n   ]\n}",
  "mapped": {
    "headers": "Object",
    "clientCertificate": "Null",
    "method": "String",
    "scheme": "String",
    "queryParams": "Object",
    "requestUri": "String",
    "queryString": "String",
    "version": "String",
    "maskedRequestPath": "Null",
    "listenerPath": "String",
    "relativePath": "String",
    "uriParams": "Object",
    "rawRequestUri": "String",
    "rawRequestPath": "String",
    "remoteAddress": "String",
    "requestPath": "String"
  }
}
