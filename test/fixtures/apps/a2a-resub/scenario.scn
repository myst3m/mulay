%%% note
tasks/resubscribe (サーバー側)。stream で作ったタスクにつなぐと、今のタスクを task のイベントで送り、これまでに送ったイベントを
送り直す (JSON-RPC の id は元の message/stream のもの)。final を送った後なら閉じる。途中でつなぐと続きも届く。
message/send のタスクと知らない ID は 404 "Task not found: <id>"。UUID と時刻は伏せる。
%%% port 18197
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":101,"method":"message/stream","params":{"message":{"kind":"message","role":"user","messageId":"u","parts":[{"kind":"text","text":"go"}]}}}
%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "ctype": "text/event-stream",
  "body": "event: task\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"101\",\"result\":{\"id\":\"<uuid>\",\"contextId\":\"<uuid>\",\"status\":{\"state\":\"submitted\",\"timestamp\":\"<ts>\"},\"artifacts\":[],\"history\":[],\"kind\":\"task\"}}\n\nevent: status-update\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"101\",\"result\":{\"taskId\":\"<uuid>\",\"status\":{\"state\":\"working\",\"message\":{\"role\":\"agent\",\"parts\":[{\"text\":\"working\",\"kind\":\"text\"}],\"messageId\":\"m-w\",\"kind\":\"message\"},\"timestamp\":\"<ts>\"},\"contextId\":\"<uuid>\",\"final\":false,\"kind\":\"status-update\"}}\n\nevent: artifact-update\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"101\",\"result\":{\"taskId\":\"<uuid>\",\"artifact\":{\"artifactId\":\"a1\",\"parts\":[{\"text\":\"chunk go\",\"kind\":\"text\"}]},\"contextId\":\"<uuid>\",\"lastChunk\":true,\"kind\":\"artifact-update\"}}\n\nevent: status-update\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"101\",\"result\":{\"taskId\":\"<uuid>\",\"status\":{\"state\":\"completed\",\"timestamp\":\"<ts>\"},\"contextId\":\"<uuid>\",\"final\":true,\"kind\":\"status-update\"}}\n\n"
}
%%% request GET /t/resub?text=go
%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "ctype": "text/event-stream",
  "body": "event: task\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"101\",\"result\":{\"id\":\"<uuid>\",\"contextId\":\"<uuid>\",\"status\":{\"state\":\"completed\",\"timestamp\":\"<ts>\"},\"artifacts\":[{\"artifactId\":\"a1\",\"parts\":[{\"text\":\"chunk go\",\"kind\":\"text\"}]}],\"history\":[],\"kind\":\"task\"}}\n\nevent: status-update\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"101\",\"result\":{\"taskId\":\"<uuid>\",\"status\":{\"state\":\"working\",\"message\":{\"role\":\"agent\",\"parts\":[{\"text\":\"working\",\"kind\":\"text\"}],\"messageId\":\"m-w\",\"kind\":\"message\"},\"timestamp\":\"<ts>\"},\"contextId\":\"<uuid>\",\"final\":false,\"kind\":\"status-update\"}}\n\nevent: artifact-update\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"101\",\"result\":{\"taskId\":\"<uuid>\",\"artifact\":{\"artifactId\":\"a1\",\"parts\":[{\"text\":\"chunk go\",\"kind\":\"text\"}]},\"contextId\":\"<uuid>\",\"lastChunk\":true,\"kind\":\"artifact-update\"}}\n\nevent: status-update\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"101\",\"result\":{\"taskId\":\"<uuid>\",\"status\":{\"state\":\"completed\",\"timestamp\":\"<ts>\"},\"contextId\":\"<uuid>\",\"final\":true,\"kind\":\"status-update\"}}\n\n"
}
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":102,"method":"message/stream","params":{"message":{"kind":"message","role":"user","messageId":"u","parts":[{"kind":"text","text":"fail"}]}}}
%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "ctype": "text/event-stream",
  "body": "event: task\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"102\",\"result\":{\"id\":\"<uuid>\",\"contextId\":\"<uuid>\",\"status\":{\"state\":\"submitted\",\"timestamp\":\"<ts>\"},\"artifacts\":[],\"history\":[],\"kind\":\"task\"}}\n\nevent: status-update\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"102\",\"result\":{\"taskId\":\"<uuid>\",\"status\":{\"state\":\"failed\",\"timestamp\":\"<ts>\"},\"contextId\":\"<uuid>\",\"final\":true,\"kind\":\"status-update\"}}\n\n"
}
%%% request GET /t/resub-fail
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "HTTP:TIMEOUT"
}
%%% request GET /t/resub-live
%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "ctype": "text/event-stream",
  "body": "event: task\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"7\",\"result\":{\"id\":\"<uuid>\",\"contextId\":\"<uuid>\",\"status\":{\"state\":\"working\",\"message\":{\"role\":\"agent\",\"parts\":[{\"text\":\"working\",\"kind\":\"text\"}],\"messageId\":\"m-w\",\"kind\":\"message\"},\"timestamp\":\"<ts>\"},\"artifacts\":[],\"history\":[],\"kind\":\"task\"}}\n\nevent: status-update\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"7\",\"result\":{\"taskId\":\"<uuid>\",\"status\":{\"state\":\"working\",\"message\":{\"role\":\"agent\",\"parts\":[{\"text\":\"working\",\"kind\":\"text\"}],\"messageId\":\"m-w\",\"kind\":\"message\"},\"timestamp\":\"<ts>\"},\"contextId\":\"<uuid>\",\"final\":false,\"kind\":\"status-update\"}}\n\nevent: artifact-update\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"7\",\"result\":{\"taskId\":\"<uuid>\",\"artifact\":{\"artifactId\":\"a1\",\"parts\":[{\"text\":\"chunk slow\",\"kind\":\"text\"}]},\"contextId\":\"<uuid>\",\"lastChunk\":true,\"kind\":\"artifact-update\"}}\n\nevent: status-update\ndata: {\"jsonrpc\":\"2.0\",\"id\":\"7\",\"result\":{\"taskId\":\"<uuid>\",\"status\":{\"state\":\"completed\",\"timestamp\":\"<ts>\"},\"contextId\":\"<uuid>\",\"final\":true,\"kind\":\"status-update\"}}\n\n"
}
