%%% note
VM のトランザクション: try の ALWAYS_BEGIN の中の publish は commit で入り、rollback で捨てる。consume は rollback で戻る。
NOT_SUPPORTED はトランザクションの外。ALWAYS_JOIN はトランザクションの外では失敗する。
%%% port 18155
%%% request GET /commit
%%% response 200
content-type: application/json; charset=UTF-8

{
  "got": "c1"
}
%%% request GET /rollback
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "VM:EMPTY_QUEUE",
  "description": "Tried to consume messages from VM queue 'rollbackQ' but it was empty after timeout of 300 MILLISECONDS"
}
%%% request GET /continue
%%% response 200
content-type: application/json; charset=UTF-8

{
  "got": "k1"
}
%%% request GET /inside
%%% response 200
content-type: application/json; charset=UTF-8

{
  "inner": {
    "type": "VM:EMPTY_QUEUE",
    "description": "Tried to consume messages from VM queue 'insideQ' but it was empty after timeout of 300 MILLISECONDS"
  },
  "after": {
    "got": "i1"
  }
}
%%% request GET /consume-back
%%% response 200
content-type: application/json; charset=UTF-8

{
  "inner": "b1",
  "after": {
    "got": "b1"
  }
}
%%% request GET /not-supported
%%% response 200
content-type: application/json; charset=UTF-8

{
  "got": "n1"
}
%%% request GET /always-join
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "MULE:TRANSACTION",
  "description": "A transaction is not available for this session, but transaction action is \"Always Join\""
}
