%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "MULE:COMPOSITE_ROUTING",
  "description": "Error(s) were found for route(s):\n\tRoute 1: java.util.concurrent.TimeoutException: Timeout while processing route/part: '1'",
  "failed": [
    "1"
  ],
  "results": {
    "0": "fast"
  },
  "failTypes": {
    "1": "MULE:TIMEOUT"
  }
}
