%%% note
http:request (同じアプリ内の別 listener 18122 を呼ぶ): basePath、uri-params (空白の
エンコード)、query-params、headers、本文と Content-Type の転送、応答の attributes (statusCode、
reasonPhrase、headers) と payload の mime、target、既定の応答検証 (4xx/5xx → HTTP:BAD_REQUEST、
NOT_FOUND、INTERNAL_SERVER_ERROR など。その parentErrorType と description と
error.errorMessage)、ハンドラ無し、success-status-code-validator、接続不可 (HTTP:CONNECTIVITY)、
responseTimeout (HTTP:TIMEOUT)、error-mapping、text 応答の中継。
%%% port 18121
%%% request POST /call
Content-Type: application/json

{"hello": "back"}
%%% response 200
content-type: application/json; charset=UTF-8

{
  "statusCode": 200,
  "reasonPhrase": "OK",
  "xBack": "yes",
  "responseContentType": "application/json; charset=UTF-8",
  "payloadMime": "application/json",
  "body": {
    "method": "POST",
    "id": "abc 1",
    "query": {
      "q": "x&y",
      "n": "1"
    },
    "contentType": "application/json; charset=UTF-8",
    "xFront": "from-front",
    "body": {
      "hello": "back"
    }
  }
}
%%% request POST /call
Content-Type: text/plain

plain to back
%%% response 200
content-type: application/json; charset=UTF-8

{
  "statusCode": 200,
  "reasonPhrase": "OK",
  "xBack": "yes",
  "responseContentType": "application/json; charset=UTF-8",
  "payloadMime": "application/json",
  "body": {
    "method": "POST",
    "id": "abc 1",
    "query": {
      "q": "x&y",
      "n": "1"
    },
    "contentType": "text/plain; charset=UTF-8",
    "xFront": "from-front",
    "body": "plain to back"
  }
}
