%%% request GET /cookie headers=set-cookie
Cookie: a=1; b=2

%%% response 200
content-type: application/json; charset=UTF-8
set-cookie: a=1; Path=/
set-cookie: b=2; Path=/; HttpOnly; SameSite=Lax

{
  "cookie": "a=1; b=2",
  "all": [
    "a=1; b=2"
  ]
}
%%% request GET /cookie headers=set-cookie
Cookie: a=1
Cookie: b=2

%%% response 200
content-type: application/json; charset=UTF-8
set-cookie: a=1; Path=/
set-cookie: b=2; Path=/; HttpOnly; SameSite=Lax

{
  "cookie": "a=1",
  "all": [
    "a=1",
    "b=2"
  ]
}
