content-type: application/json

{"dn": null}
%%% response 201
content-type: application/json; charset=UTF-8

{
  "route": "dates",
  "body": {
    "dn": null
  }
}
%%% request POST /api/v1/dates
content-type: application/json

{"dn": "2026-13-45"}
%%% response 400
content-type: application/json; charset=UTF-8

{
