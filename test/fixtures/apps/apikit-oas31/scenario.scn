%%% note
APIkit に OpenAPI 3.1.0 の仕様を読ませる: requestBody の schema を外の JSON Schema のファイル ($ref: ../schemas/DepositRequest.json) にしたもの、
3.1 の型の並び (type: [string, "null"])、format の date・date-time (1.12.6 は OAS 3.1 でも検査して 400。型の並びでは枝ごとの文)、object の anyOf (中に required と enum)。別のプロジェクトからの依頼 (2026-11-02)。
%%% port 18586
%%% request POST /api/v1/deposits
content-type: application/json

{"accountNumber": "001", "amount": 100, "kind": "CASH"}
%%% response 201
content-type: application/json; charset=UTF-8

{
  "route": "deposits",
  "body": {
    "accountNumber": "001",
    "amount": 100,
    "kind": "CASH"
  }
}
%%% request POST /api/v1/deposits
content-type: application/json

{"accountNumber": "001", "amount": 100, "kind": "GOLD"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/kind GOLD is not a valid enum value",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/deposits
content-type: application/json

{"accountNumber": "001", "amount": 0}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/amount 0 is not greater or equal to 1",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/deposits
content-type: application/json

{"amount": 5}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "required key [accountNumber] not found",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/deposits
content-type: application/json

{"accountNumber": "001", "amount": 5, "extra": 1}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "extraneous key [extra] is not permitted",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/channels
content-type: application/json

{"channel": "Atm", "note": null, "count": 1}
%%% response 201
content-type: application/json; charset=UTF-8

{
  "route": "channels",
  "body": {
    "channel": "Atm",
    "note": null,
    "count": 1
  }
}
%%% request POST /api/v1/channels
content-type: application/json

{"channel": "Branch"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/channel Branch is not a valid enum value",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/channels
content-type: application/json

{"channel": "Atm", "note": 5}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/note expected: null, found: Integer\n/note expected type: String, found: Integer",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/channels
content-type: application/json

{"channel": "Atm", "count": -1}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/count -1 is not greater or equal to 0",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/channels
content-type: application/json

{"channel": "Atm", "a": true}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/a expected type: String, found: Boolean\n/a expected type: Integer, found: Boolean",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/channels
content-type: application/json

{"channel": "Atm", "b": "x"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/b expected type: Integer, found: String\n/b expected: null, found: String\n/b expected type: Boolean, found: String",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/channels
content-type: application/json

{"channel": "Atm", "c": 1}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/c expected type: String, found: Integer\n/c expected: null, found: Integer",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/channels
content-type: application/json

{"channel": "Atm", "a": 1.5}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/a expected type: String, found: Double\n/a expected type: Integer, found: Double",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/dates
content-type: application/json

{"d": "2026-11-02"}
%%% response 201
content-type: application/json; charset=UTF-8

{
  "route": "dates",
  "body": {
    "d": "2026-11-02"
  }
}
%%% request POST /api/v1/dates
content-type: application/json

{"d": "2026-13-45"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/d [2026-13-45] is not a valid date. Expected [yyyy-MM-dd]",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/dates
content-type: application/json

{"d": "2024-02-30"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/d [2024-02-30] is not a valid date. Expected [yyyy-MM-dd]",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/dates
content-type: application/json

{"d": "20261102"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/d [20261102] is not a valid date. Expected [yyyy-MM-dd]",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/dates
content-type: application/json

{"dt": "2026-11-02T10:00:00Z"}
%%% response 201
content-type: application/json; charset=UTF-8

{
  "route": "dates",
  "body": {
    "dt": "2026-11-02T10:00:00Z"
  }
}
%%% request POST /api/v1/dates
content-type: application/json

{"dt": "2026-13-45T00:00:00Z"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/dt [2026-13-45T00:00:00Z] is not a valid date-time. Expected [yyyy-MM-dd'T'HH:mm:ssZ, yyyy-MM-dd'T'HH:mm:ss.[0-9]{1,9}Z, yyyy-MM-dd'T'HH:mm:ss[+-]HH:mm, yyyy-MM-dd'T'HH:mm:ss.[0-9]{1,9}[+-]HH:mm]",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/dates
content-type: application/json

{"dt": "2026-11-02T10:00:00"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/dt [2026-11-02T10:00:00] is not a valid date-time. Expected [yyyy-MM-dd'T'HH:mm:ssZ, yyyy-MM-dd'T'HH:mm:ss.[0-9]{1,9}Z, yyyy-MM-dd'T'HH:mm:ss[+-]HH:mm, yyyy-MM-dd'T'HH:mm:ss.[0-9]{1,9}[+-]HH:mm]",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/dates
content-type: application/json

{"dt": "2026-11-02T10:00:00+09:00"}
%%% response 201
content-type: application/json; charset=UTF-8

{
  "route": "dates",
  "body": {
    "dt": "2026-11-02T10:00:00+09:00"
  }
}
%%% request POST /api/v1/dates
content-type: application/json

{"dt": "2026-11-02 10:00:00Z"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/dt [2026-11-02 10:00:00Z] is not a valid date-time. Expected [yyyy-MM-dd'T'HH:mm:ssZ, yyyy-MM-dd'T'HH:mm:ss.[0-9]{1,9}Z, yyyy-MM-dd'T'HH:mm:ss[+-]HH:mm, yyyy-MM-dd'T'HH:mm:ss.[0-9]{1,9}[+-]HH:mm]",
  "payloadMime": "application/json"
}
