%%% note
idempotent-message-validator: idExpression の値が初めてなら通し、2 回目は MULE:DUPLICATE_MESSAGE。
validator ごとに別のストア (既定の private のストア)、correlationId の既定 (X-Correlation-ID)、
objectStore を指したときのキーと valueExpression の値、数の id、null の id、foreach の中の重複、
try の外での既定の応答。
%%% port 18530
%%% request GET /idem?id=a
%%% response 200
content-type: application/java; charset=UTF-8

accepted a
%%% request GET /idem?id=a
%%% response 200
content-type: application/java; charset=UTF-8

MULE:DUPLICATE_MESSAGE|unknown description|unknown description
%%% request GET /idem?id=b
%%% response 200
content-type: application/java; charset=UTF-8

accepted b
%%% request GET /other?id=a
%%% response 200
content-type: application/java; charset=UTF-8

accepted a
%%% request GET /other?id=a
%%% response 200
content-type: application/java; charset=UTF-8

DUPLICATE_MESSAGE
%%% request GET /raw?id=x
%%% response 200

ok
%%% request GET /raw?id=x
%%% response 500
content-type: text/plain; charset=UTF-8

unknown description
%%% request GET /default
X-Correlation-ID: c-1

%%% response 200
content-type: application/java; charset=UTF-8

accepted c-1
%%% request GET /default
X-Correlation-ID: c-1

%%% response 200
content-type: application/java; charset=UTF-8

DUPLICATE_MESSAGE
%%% request GET /default
X-Correlation-ID: c-2

%%% response 200
content-type: application/java; charset=UTF-8

accepted c-2
%%% request GET /store?id=k1
%%% response 200
content-type: application/java; charset=UTF-8

stored v-k1
%%% request GET /store?id=k1
%%% response 200
content-type: application/java; charset=UTF-8

DUPLICATE_MESSAGE
%%% request GET /num?id=abc
%%% response 200

accepted
%%% request GET /num?id=xyz
%%% response 200
content-type: application/java; charset=UTF-8

DUPLICATE_MESSAGE
%%% request GET /keys
%%% response 200
content-type: application/java; charset=UTF-8

["3","k1"]
%%% request GET /null
%%% response 200
content-type: application/java; charset=UTF-8

MULE:UNKNOWN|key cannot be null or blank
%%% request GET /null
%%% response 200
content-type: application/java; charset=UTF-8

MULE:UNKNOWN|key cannot be null or blank
%%% request GET /idem?id=
%%% response 200
content-type: application/java; charset=UTF-8

MULE:UNKNOWN|key cannot be null or blank|key cannot be null or blank
%%% request GET /idem?id=%20
%%% response 200
content-type: application/java; charset=UTF-8

MULE:UNKNOWN|key cannot be null or blank|key cannot be null or blank
%%% request GET /each
%%% response 200
content-type: application/java; charset=UTF-8

a,b,dup a,c,dup b
%%% request GET /val?id=v
%%% response 200

accepted
%%% request GET /val?id=v
%%% response 200

caught as VALIDATION
