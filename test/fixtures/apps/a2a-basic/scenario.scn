%%% note
A2A コネクタ 1.1.1 (サーバーとクライアントの基本)。エージェントカード (GET <agentPath>/.well-known/agent-card.json)、
message/send (task-listener のフローの結果を Message か Task にして返す)、JSON-RPC の失敗 (不正な JSON、知らない
メソッド、知らないタスク、認可のリスナーが無い tasks/get、ストリーム・プッシュ通知の未対応)。クライアントの get-card と
send-message は同じアプリのエージェントを呼ぶ。ID は実行ごとに変わるので UUID の形の文字列は <uuid> にする。
%%% port 18162
%%% request GET /t/card-raw
%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "contentType": "application/json",
  "body": "{\"name\":\"Mulay Echo Agent\",\"description\":\"Echoes the text it receives.\",\"url\":\"http://localhost:18162/agent\",\"provider\":{\"organization\":\"mulay\",\"url\":\"https://example.com\"},\"version\":\"1.0.0\",\"capabilities\":{\"streaming\":false,\"pushNotifications\":false,\"stateTransitionHistory\":false},\"defaultInputModes\":[\"text/plain\"],\"defaultOutputModes\":[\"text/plain\"],\"skills\":[{\"id\":\"echo\",\"name\":\"Echo\",\"description\":\"Echoes text\",\"tags\":[\"echo\"]}],\"supportsAuthenticatedExtendedCard\":false,\"preferredTransport\":\"JSONRPC\",\"protocolVersion\":\"0.3.0\"}"
}
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":1,"method":"message/send","params":{"message":{"kind":"message","role":"user","messageId":"u-1","parts":[{"kind":"text","text":"hi"}]}}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "contentType": "application/json",
  "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"role\":\"agent\",\"parts\":[{\"text\":\"echo: hi\",\"kind\":\"text\"}],\"messageId\":\"m-echo\",\"kind\":\"message\"}}"
}
%%% request GET /t/last
%%% response 200
content-type: application/json; charset=UTF-8

{
  "payload": {
    "message": {
      "role": "user",
      "parts": [
        {
          "text": "hi",
          "kind": "text"
        }
      ],
      "messageId": "u-1",
      "kind": "message"
    }
  },
  "payloadType": "Object",
  "mime": "text/json",
  "attrClass": "com.mulesoft.connectors.a2a.api.listener.RequestAttributes",
  "attrKeys": [
    "clientCertificate",
    "contextId",
    "headers",
    "jsonRpcMethod",
    "localAddress",
    "method",
    "queryParams",
    "remoteAddress",
    "scheme",
    "taskId",
    "version"
  ],
  "method": "POST",
  "taskIdIsUuid": true,
  "contextIdIsUuid": true,
  "headerKeys": [
    "accept",
    "connection",
    "content-length",
    "content-type",
    "host",
    "user-agent",
    "x-correlation-id"
  ],
  "attrs": "{\n  \"clientCertificate\": null,\n  \"contextId\": \"<uuid>\",\n  \"jsonRpcMethod\": \"message/send\",\n  \"localAddress\": \"/127.0.0.1:<port>\",\n  \"method\": \"POST\",\n  \"queryParams\": {\n    \n  },\n  \"remoteAddress\": \"/127.0.0.1:<port>\",\n  \"scheme\": \"http\",\n  \"taskId\": \"<uuid>\",\n  \"version\": \"HTTP/1.1\"\n}",
  "ctype": "application/json"
}
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":"req-7","method":"message/send","params":{"message":{"kind":"message","role":"user","messageId":"u-1","parts":[{"kind":"text","text":"task"}]}}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "contentType": "application/json",
  "body": "{\"jsonrpc\":\"2.0\",\"id\":\"req-7\",\"result\":{\"id\":\"<uuid>\",\"contextId\":\"<uuid>\",\"status\":{\"state\":\"completed\",\"message\":{\"role\":\"agent\",\"parts\":[{\"text\":\"done\",\"kind\":\"text\"}],\"messageId\":\"m-reply\",\"kind\":\"message\"},\"timestamp\":\"<ts>\"},\"artifacts\":[{\"artifactId\":\"a1\",\"name\":\"result\",\"parts\":[{\"text\":\"artifact text\",\"kind\":\"text\"}]}],\"history\":[],\"kind\":\"task\"}}"
}
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":3,"method":"message/send","params":{"message":{"kind":"message","role":"user","messageId":"u-1","parts":[{"kind":"text","text":"fail"}]}}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 500,
  "contentType": "application/json",
  "body": "{\"jsonrpc\":\"2.0\",\"id\":3,\"error\":{\"code\":-32603,\"message\":\"the agent failed\"}}"
}
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":4,"method":"message/send","params":{"message":{"kind":"message","role":"user","messageId":"u-1","parts":[{"kind":"text","text":"badid"}]}}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 500,
  "contentType": "application/json",
  "body": "{\"jsonrpc\":\"2.0\",\"id\":4,\"error\":{\"code\":-32603,\"message\":\"Server error occured! Kindly check with the administrator.\"}}"
}
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":5,"method":"message/send","params":{"message":{"kind":"message","role":"user","messageId":"u-1","parts":[{"kind":"text","text":"notjson"}]}}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 500,
  "contentType": "application/json",
  "body": "{\"jsonrpc\":\"2.0\",\"id\":5,\"error\":{\"code\":-32603,\"message\":\"Error unmarshalling input stream json payload into type io.a2a.spec.EventKind. Cause: Unrecognized token 'plain': was expecting (JSON String, Number, Array, Object or token 'null', 'true' or 'false')\\n at [Source: REDACTED (`StreamReadFeature.INCLUDE_SOURCE_IN_LOCATION` disabled); line: 1, column: 7]\"}}"
}
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":6,"method":"message/send","params":{"message":{"kind":"message","role":"user","messageId":"u-2","taskId":"no-such-task","parts":[{"kind":"text","text":"x"}]}}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 404,
  "contentType": "application/json",
  "body": "{\"jsonrpc\":\"2.0\",\"id\":6,\"error\":{\"code\":-32001,\"message\":\"task not found!\"}}"
}
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":7,"method":"tasks/get","params":{"id":"no-such-task"}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 403,
  "contentType": "application/json",
  "body": "{\"jsonrpc\":\"2.0\",\"id\":7,\"error\":{\"code\":-32005,\"message\":\"Authorization listener required for tasks/get\"}}"
}
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":8,"method":"no/such","params":{}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 400,
  "contentType": "application/json",
  "body": "{\"jsonrpc\":\"2.0\",\"id\":8,\"error\":{\"code\":-32601,\"message\":\"Method not found or unsupported - no/such\"}}"
}
%%% request POST /t/rpc
Content-Type: text/plain

{not json

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 400,
  "contentType": "application/json",
  "body": "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32700,\"message\":\"Invalid JSON payload\"}}"
}
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":9,"method":"message/send","params":{}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 400,
  "contentType": "application/json",
  "body": "{\"jsonrpc\":\"2.0\",\"id\":9,\"error\":{\"code\":-32600,\"message\":\"Error unmarshalling string json payload into type io.a2a.spec.SendMessageRequest. Cause: Invalid params\\n at [Source: UNKNOWN; byte offset: #UNKNOWN]\"}}"
}
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":10,"method":"message/stream","params":{"message":{"kind":"message","role":"user","messageId":"u-3","parts":[{"kind":"text","text":"s"}]}}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 400,
  "contentType": "application/json",
  "body": "{\"jsonrpc\":\"2.0\",\"id\":10,\"error\":{\"code\":-32004,\"message\":\"Streaming not supported for this agent!\"}}"
}
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":11,"method":"message/send","params":{"message":{"kind":"message","role":"user","messageId":"u-4","parts":[{"kind":"text","text":"p"}]},"configuration":{"pushNotificationConfig":{"url":"http://localhost:1/x"}}}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 400,
  "contentType": "application/json",
  "body": "{\"jsonrpc\":\"2.0\",\"id\":11,\"error\":{\"code\":-32003,\"message\":\"Push notification not supported for this agent!\"}}"
}
%%% request GET /t/client-card
%%% response 200
content-type: application/json; charset=UTF-8

{
  "payload": {
    "name": "Mulay Echo Agent",
    "description": "Echoes the text it receives.",
    "url": "http://localhost:18162/agent",
    "provider": {
      "organization": "mulay",
      "url": "https://example.com"
    },
    "version": "1.0.0",
    "capabilities": {
      "streaming": false,
      "pushNotifications": false,
      "stateTransitionHistory": false
    },
    "defaultInputModes": [
      "text/plain"
    ],
    "defaultOutputModes": [
      "text/plain"
    ],
    "skills": [
      {
        "id": "echo",
        "name": "Echo",
        "description": "Echoes text",
        "tags": [
          "echo"
        ]
      }
    ],
    "supportsAuthenticatedExtendedCard": false,
    "preferredTransport": "JSONRPC",
    "protocolVersion": "0.3.0"
  },
  "type": "Object",
  "mime": "application/json",
  "attrClass": "com.mulesoft.connectors.a2a.api.model.transport.ResponseAttributes",
  "attrs": {
    "headers": {
      "content-type": "application/json",
      "content-length": "536"
    },
    "reasonPhrase": "",
    "statusCode": 200
  }
}
%%% request GET /t/client-send?text=yo
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "Object",
  "mime": "application/json",
  "attrClass": "com.mulesoft.connectors.a2a.api.model.transport.ResponseAttributes",
  "body": "{\n  \"role\": \"agent\",\n  \"parts\": [\n    {\n      \"text\": \"echo: yo\",\n      \"kind\": \"text\"\n    }\n  ],\n  \"messageId\": \"m-echo\",\n  \"kind\": \"message\"\n}",
  "attrs": "{\n  \"headers\": {\n    \"content-type\": \"application/json\",\n    \"content-length\": \"<n>\"\n  },\n  \"reasonPhrase\": \"\",\n  \"statusCode\": 200\n}"
}
%%% request GET /t/client-send?text=task
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "Object",
  "mime": "application/json",
  "attrClass": "com.mulesoft.connectors.a2a.api.model.transport.ResponseAttributes",
  "body": "{\n  \"id\": \"<uuid>\",\n  \"contextId\": \"<uuid>\",\n  \"status\": {\n    \"state\": \"completed\",\n    \"message\": {\n      \"role\": \"agent\",\n      \"parts\": [\n        {\n          \"text\": \"done\",\n          \"kind\": \"text\"\n        }\n      ],\n      \"messageId\": \"m-reply\",\n      \"kind\": \"message\"\n    },\n    \"timestamp\": \"<ts>\"\n  },\n  \"artifacts\": [\n    {\n      \"artifactId\": \"a1\",\n      \"name\": \"result\",\n      \"parts\": [\n        {\n          \"text\": \"artifact text\",\n          \"kind\": \"text\"\n        }\n      ]\n    }\n  ],\n  \"history\": [\n    \n  ],\n  \"kind\": \"task\"\n}",
  "attrs": "{\n  \"headers\": {\n    \"content-type\": \"application/json\",\n    \"content-length\": \"<n>\"\n  },\n  \"reasonPhrase\": \"\",\n  \"statusCode\": 200\n}"
}
