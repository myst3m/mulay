%%% note
HTTPS: listener (大域の tls:context と JKS の鍵のパスワード、その場の PKCS12、クライアント証明書を求める mTLS)、
http:request (trust-store で信頼、insecure、既定の信頼 (失敗)、信頼しない証明書 (失敗)、クライアント証明書、
証明書なしで mTLS へ (失敗)、HTTPS のポートへ平文 (失敗))。証明書は certs/ (テスト専用の CA、100 年)。
%%% port 18143
%%% tls 18140
%%% tls 18141
%%% tls 18142 certs/client.pem certs/client-key.pem
%%% tls 18144
%%% tls 18147
%%% tls 18148
%%% tls 18149
%%% request GET :18140/hello
%%% response 200
content-type: application/json; charset=UTF-8

{
  "scheme": "https",
  "path": "/hello",
  "hasClientCert": false,
  "certType": "Null"
}
%%% request GET :18141/hello
%%% response 200
content-type: application/json; charset=UTF-8

{
  "scheme": "https",
  "path": "/hello",
  "hasClientCert": false,
  "certType": "Null"
}
%%% request GET :18142/hello
%%% response 200
content-type: application/json; charset=UTF-8

{
  "scheme": "https",
  "path": "/hello",
  "hasClientCert": true,
  "certType": "Object"
}
%%% request GET :18142/cert
%%% response 200
content-type: application/json; charset=UTF-8

{
  "keys": [
    "basicConstraints",
    "criticalExtensionOIDs",
    "encoded",
    "extendedKeyUsage",
    "extensions",
    "issuerAlternativeNames",
    "issuerDN",
    "issuerUniqueID",
    "issuerX500Principal",
    "keyUsage",
    "name",
    "nonCriticalExtensionOIDs",
    "notAfter",
    "notBefore",
    "publicKey",
    "serialNumber",
    "serialNumberObject",
    "sigAlgName",
    "sigAlgOID",
    "sigAlgParams",
    "signature",
    "subjectAlternativeNames",
    "subjectDN",
    "subjectX500Principal",
    "type",
    "version"
  ],
  "subject": "O=mulay, CN=mulay client",
  "issuer": "CN=mulay test CA",
  "serial": "Number",
  "notAfter": "2126-09-05T12:22:48",
  "certKind": "X.509",
  "version": 3,
  "sigAlg": "SHA256withRSA",
  "subjectX500": "O=mulay, CN=mulay client"
}
%%% request GET :18144/hello
%%% response 200
content-type: text/plain

rogue
