%%% request POST /chat
Content-Type: application/json

{"message":"ask: what is 2 + 3?","sessionId":"a1"}
%%% response 200
content-type: application/json; charset=UTF-8

{
  "sessionId": "a1",
  "answer": "The other agent says: 2 + 3 = 5",
  "steps": [
    {
      "tool": "ask_agent",
      "arguments": {
        "text": "what is 2 + 3?"
      },
      "result": "2 + 3 = 5"
    }
  ]
}
%%% request POST /chat
Content-Type: application/json

{"message":"ask: ask: hello","sessionId":"a2"}
%%% response 200
content-type: application/json; charset=UTF-8

{
  "sessionId": "a2",
  "answer": "The other agent says: The other agent says: Sorry, I could not find an answer.",
  "steps": [
    {
      "tool": "ask_agent",
      "arguments": {
        "text": "ask: hello"
      },
      "result": "The other agent says: Sorry, I could not find an answer."
    }
  ]
}
%%% request POST /agent
Content-Type: application/json

{"jsonrpc":"2.0","id":1,"method":"message/send","params":{"message":{"kind":"message","role":"user","messageId":"u-1","parts":[{"kind":"text","text":"where is order B200?"}]}}}
%%% response 200
content-type: application/json

{"jsonrpc":"2.0","id":1,"result":{"id":"***","contextId":"***","status":{"state":"completed","message":{"role":"agent","parts":[{"text":"Order B200 is packing.","kind":"text"}],"messageId":"***","kind":"message"},"timestamp":"***"},"artifacts":[{"artifactId":"***","name":"answer","parts":[{"text":"Order B200 is packing.","kind":"text"}]}],"history":[],"kind":"task"}}
