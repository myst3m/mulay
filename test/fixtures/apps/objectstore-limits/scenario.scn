%%% note
ObjectStore の entryTtl (期限で消える)、maxEntries (件数の上限。超えた分は期限の確かめのときに古いものから消える)、
persistent の店。期限の確かめは 300 ms ごと。
%%% port 18151
%%% mask
\$withAnnotations@([0-9a-f]+);
%%% request GET /ttl/put
%%% response 200
content-type: application/json; charset=UTF-8

[
  "a",
  "b"
]
%%% request GET /ttl/keys
%%% response 200
content-type: application/json; charset=UTF-8

[
  "a",
  "b"
]
%%% wait 1800
%%% request GET /ttl/keys
%%% response 200
content-type: application/json; charset=UTF-8

[
  
]
%%% request GET /ttl/get
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "OS:KEY_NOT_FOUND",
  "description": "ObjectStore 'org.mule.extension.objectstore.api.TopLevelObjectStore$ByteBuddy$withAnnotations@***; location: ttlStore' doesn't contain any value for key 'a' and default value was not provided or resolved to a null value."
}
%%% request GET /ttl/contains
%%% response 200
content-type: application/json; charset=UTF-8

{
  "contains": false
}
%%% request GET /max/put
%%% response 200
content-type: application/json; charset=UTF-8

[
  "k1",
  "k2",
  "k3",
  "k4",
  "k5"
]
%%% wait 1000
%%% request GET /max/keys
%%% response 200
content-type: application/json; charset=UTF-8

[
  "k3",
  "k4",
  "k5"
]
%%% request POST /durable/put?k=x
Content-Type: application/json

{"v": 1}
%%% response 200
content-type: application/json; charset=UTF-8

{
  "x": "{\"v\": 1}"
}
%%% request GET /durable/get
%%% response 200
content-type: application/json; charset=UTF-8

{
  "v": {
    "v": 1
  },
  "t": "Object",
  "mime": "application/json",
  "cls": null
}
%%% request POST /mem/put?k=x
Content-Type: application/json

{"v": 1}
%%% response 200
content-type: application/json; charset=UTF-8

{
  "x": "{\"v\": 1}"
}
%%% request GET /mem/get
%%% response 200
content-type: application/json; charset=UTF-8

{
  "v": {
    "v": 1
  },
  "t": "Object",
  "mime": "application/json",
  "cls": null
}
