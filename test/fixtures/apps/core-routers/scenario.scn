%%% note
async / first-successful / round-robin: async の中の変数・payload の変更が呼び出し側に
見えないこと (ログには出る)、async の中のエラーが呼び出し側に伝わらないこと、first-successful
が最初に成功したルートを返すこと、全ルート失敗時のエラー型と description、round-robin が
起動からの通し順でルートを選ぶこと。
%%% port 18125
%%% request GET /async log
%%% response 200
content-type: application/json; charset=UTF-8

{
  "v": "before",
  "payload": ""
}
%%% log
INFO org.mule.runtime.core.internal.processor.LoggerMessageProcessor: in async: changed in async
%%% request GET /async-error
%%% response 200

caller unaffected
%%% request GET /first-successful
%%% response 200

route 1
%%% request GET /first-successful?failUntil=1
%%% response 200

route 2
%%% request GET /first-successful?failUntil=2
%%% response 200

route 3
%%% request GET /first-successful?failUntil=3
%%% response 200
content-type: application/json; charset=UTF-8

{
  "errorType": "APP:R3",
  "description": "route 3 failed"
}
%%% request GET /round-robin
%%% response 200

rr-0
%%% request GET /round-robin
%%% response 200

rr-1
%%% request GET /round-robin
%%% response 200

rr-2
%%% request GET /round-robin
%%% response 200

rr-0
