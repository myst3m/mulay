content-type: application/json; charset=UTF-8

{
  "mime": "application/json",
  "payload": [
    "\"Mule is an integration runtime.",
    "Agents call tools.",
    "Orders ship in two days.",
    "Refunds take a week.\""
  ],
  "attributes": null
}
