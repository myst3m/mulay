  "mime": "application/json",
  "payload": {
    "embeddings": [
      [
        1,
        0,
        0,
        0,
        0,
        0,
        0.5
      ],
      [
        0,
        0,
        0,
        0,
        0,
        1,
        0.5
      ]
    ],
    "text-segments": [
      {
        "metadata": {
          "index": 0
        },
        "text": "where is my order?"
      },
      {
        "metadata": {
          "index": 1
        },
        "text": "the weather is nice"
      }
    ],
    "dimension": 7
  },
  "attributes": {
    "otherAttributes": {
      
    },
    "embeddingModelDimension": 7,
    "tokenUsage": null,
    "embeddingModelName": "mock-embed"
  }
}
%%% request GET /ollama-last
%%% response 200
content-type: application/json; charset=UTF-8

{
  "method": "POST",
  "path": "/ollama/api/embeddings",
  "contentType": "application/json",
  "body": {
    "model": "mock-embed",
    "prompt": "the weather is nice"
  }
}
%%% request POST /chunk?max=40&overlap=10
content-type: application/json

{"text":"Mule is an integration runtime. Agents call tools. Orders ship in two days. Refunds take a week."}
