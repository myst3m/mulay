%%% note
APIkit に OpenAPI 3.1.0 の仕様を読ませる: requestBody の schema を外の JSON Schema のファイル ($ref: ../schemas/DepositRequest.json) にしたもの、
APIkit 1.13.4 (OpenAPI 3.1 の検証器が 1.12 と違う): 3.1 の const、型の並び (type: [string, "null"])。別のプロジェクトからの依頼 (2026-11-02)。
%%% port 18587
%%% request POST /api/v1/deposits
content-type: application/json

{"accountNumber": "001", "amount": 100, "kind": "CASH"}
%%% response 201
content-type: application/json; charset=UTF-8

{
  "route": "deposits",
  "body": {
    "accountNumber": "001",
    "amount": 100,
    "kind": "CASH"
  }
}
%%% request POST /api/v1/deposits
content-type: application/json

{"accountNumber": "001", "amount": 100, "kind": "GOLD"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/kind the instance is not equal to any enum values",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/deposits
content-type: application/json

{"accountNumber": "001", "amount": 0}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/amount 0 is lower than minimum 1",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/deposits
content-type: application/json

{"amount": 5}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "required properties are missing: accountNumber",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/deposits
content-type: application/json

{"accountNumber": "001", "amount": 5, "extra": 1}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/extra false schema always fails",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/channels
content-type: application/json

{"channel": "Atm", "note": null, "count": 1}
%%% response 201
content-type: application/json; charset=UTF-8

{
  "route": "channels",
  "body": {
    "channel": "Atm",
    "note": null,
    "count": 1
  }
}
%%% request POST /api/v1/channels
content-type: application/json

{"channel": "Branch"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/channel the instance is not equal to any enum values",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/channels
content-type: application/json

{"channel": "Atm", "note": 5}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/note expected type: string, actual: integer\n/note expected type: null, actual: integer",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/channels
content-type: application/json

{"channel": "Atm", "count": -1}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/count -1 is lower than minimum 0",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/channels
content-type: application/json

{"channel": "Atm", "a": true}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/a expected type: integer, actual: boolean\n/a expected type: string, actual: boolean",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/channels
content-type: application/json

{"channel": "Atm", "b": "x"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/b expected type: boolean, actual: string\n/b expected type: null, actual: string\n/b expected type: integer, actual: string",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/channels
content-type: application/json

{"channel": "Atm", "c": 1}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/c expected type: null, actual: integer\n/c expected type: string, actual: integer",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/channels
content-type: application/json

{"channel": "Atm", "a": 1.5}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/a expected type: integer, actual: number\n/a expected type: string, actual: number",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "ab"}
%%% response 201
content-type: application/json; charset=UTF-8

{
  "route": "checks",
  "body": {
    "id": 1,
    "name": "ab"
  }
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 0, "name": "ab"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/id 0 is lower than or equal to minimum 0",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 11, "name": "ab"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/id 11 is greater than maximum 10",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1.5, "name": "ab"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/id expected type: integer, actual: number",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "a"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/name actual string length 1 is lower than minLength 2",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "abcde"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/name actual string length 5 exceeds maxLength 4",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "AB"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/name instance value did not match pattern ^[a-z]+$",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "required properties are missing: name",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"name": 5}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "required properties are missing: id\n/name expected type: string, actual: integer",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "ab", "zz": 1, "yy": 2}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/zz false schema always fails\n/yy false schema always fails",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "ab", "tags": []}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/tags expected minimum items: 1, found only 0",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "ab", "tags": ["x", "y", "z"]}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/tags expected maximum items: 2, found 3",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "ab", "tags": ["x", "x"]}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/tags the same array element occurs at positions 0, 1",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "ab", "tags": ["x", 2]}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/tags/1 expected type: string, actual: integer",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "ab", "ratio": 0.7}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/ratio 0.7 is not a multiple of 0.5",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "ab", "ratio": 2}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/ratio 2 is greater than or equal to maximum 2.0",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "ab", "mail": "nope"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/mail instance does not match format 'email'",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "ab", "when": "2020-13-01"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/when instance does not match format 'date'",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "ab", "pick": true}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/pick expected type: string, actual: boolean\n/pick expected type: integer, actual: boolean",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "ab", "any": "long"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/any actual string length 4 exceeds maxLength 1\n/any expected type: boolean, actual: string",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "ab", "all": 3}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/all 3 is lower than minimum 5.0",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "ab", "nope": "s"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/nope negated subschema did not fail",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "ab", "inner": {"deep": {}}}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/inner/deep required properties are missing: x",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": 1, "name": "ab", "inner": {"deep": {"x": 3}}}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/inner/deep/x the instance is not equal to any enum values",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

{"id": "x", "name": 1, "extra": true}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/extra false schema always fails\n/id expected type: integer, actual: string\n/name expected type: string, actual: integer",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

[1]
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "expected type: object, actual: array",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/checks
content-type: application/json

not json
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "Invalid json value was provided",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/nums
content-type: application/json

{"n1": 0}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/n1 0 is lower than minimum 1.0",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/nums
content-type: application/json

{"n2": 0}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/n2 0 is lower than minimum 1.0",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/nums
content-type: application/json

{"n3": 3}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/n3 3 is not a multiple of 2",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/nums
content-type: application/json

{"n4": 2}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/n4 2 is lower than minimum 3\n/n4 expected type: null, actual: integer",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/nums
content-type: application/json

{"n5": 2}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/n5 2 is greater than maximum 1.5",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/nums
content-type: application/json

{"n6": 2}
%%% response 201
content-type: application/json; charset=UTF-8

{
  "route": "nums",
  "body": {
    "n6": 2
  }
}
%%% request POST /api/v1/nums
content-type: application/json

{"n7": 0}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/n7 0 is lower than or equal to minimum 0.0",
  "payloadMime": "application/json"
}
%%% request POST /api/v1/nums
content-type: application/json

{"n1": 0.5, "n2": -1}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/n1 0.5 is lower than minimum 1.0\n/n2 -1 is lower than minimum 1.0",
  "payloadMime": "application/json"
}
%%% request GET /api/v1/items/AB?sort=asc&limit=5
%%% response 200
content-type: application/json; charset=UTF-8

{
  "route": "items",
  "q": {
    "sort": "asc",
    "limit": "5"
  },
  "u": {
    "code": "AB"
  }
}
%%% request GET /api/v1/items/ab?sort=asc
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "Invalid value 'ab' for uri parameter code. instance value did not match pattern ^[A-Z]{2}$",
  "payloadMime": "*/*"
}
%%% request GET /api/v1/items/AB?sort=up
%%% response 200
content-type: application/json; charset=UTF-8

{
  "route": "items",
  "q": {
    "sort": "up"
  },
  "u": {
    "code": "AB"
  }
}
%%% request GET /api/v1/items/AB?limit=5
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "Required query parameter sort not specified",
  "payloadMime": "*/*"
}
%%% request GET /api/v1/items/AB?sort=asc&limit=99
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "Invalid value '99' for query parameter limit. 99 is greater than maximum 50",
  "payloadMime": "*/*"
}
%%% request GET /api/v1/items/AB?sort=asc&limit=x
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "Invalid value 'x' for query parameter limit. expected type: Integer, found: String",
  "payloadMime": "*/*"
}
%%% request GET /api/v1/items/AB?sort=asc
x-tenant: ab

%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "Invalid value 'ab' for header 'x-tenant'",
  "payloadMime": "*/*"
}
