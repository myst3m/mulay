%%% note
Salesforce コネクタ (mule-salesforce-connector 11.3、OAuth client credentials) の Bulk API v2: ingest のジョブ
(CSV で Account を 3 件、うち 1 件は失敗)、get-job-state で終わるまで待つ、成功・失敗・未処理の結果、ジョブの一覧
(形だけ)、query のジョブ、get-query-job-info、結果 (maxRecordsPerPage で 1 ページ 1 件)、終わったジョブの abort
(失敗)、delete、query のジョブの一覧 (自分のジョブを ID で探す)。ジョブの値 (HashMap) はキーの順に並べて比べる
(同じ桶の中の並びは実 Mule でも実行ごとに変わる)。未処理の結果は安定して作れないので、手で叩く /probe/unprocessed。組織は d30。レコードの名前は "mulay bulk2 ..." で、最初と最後に消す。
ジョブの ID は ObjectStore で要求をまたいで引き継ぐ。ID・時刻・処理時間は伏せる。
認証情報は src/main/resources/sf-secret.yaml (リポジトリに入れない。sf.clientId、sf.clientSecret、sf.tokenUrl)。
%%% requires src/main/resources/sf-secret.yaml
%%% port 18171
%%% mask
"(?:id|Id|sf__Id|createdById|jobId)": "([A-Za-z0-9]{15,18})"
"(?:createdDate|systemModstamp|CreatedDate)": "([^"]*)"
"(?:totalProcessingTime|apiActiveProcessingTime|apexProcessingTime|retries)": ([0-9.]+)
(750[A-Za-z0-9]{12,15})
%%% request POST /setup
%%% response 200

clean
%%% request POST /ingest
Content-Type: text/csv

Name,NumberOfEmployees
mulay bulk2 A,10
mulay bulk2 B,abc
mulay bulk2 C,30
%%% response 200
content-type: application/json; charset=UTF-8

{
  "class": "org.mule.extension.salesforce.api.bulk.BulkJobState",
  "mime": "application/java",
  "type": "Object",
  "itemClass": null,
  "keys": 21,
  "value": {
    "apexProcessingTime": ***,
    "apiActiveProcessingTime": ***,
    "apiVersion": "65.0",
    "columnDelimiter": "COMMA",
    "concurrencyMode": "Parallel",
    "contentType": "CSV",
    "createdById": "***",
    "createdDate": "***",
    "errorMessage": null,
    "externalIdFieldName": null,
    "id": "***",
    "jobType": "V2Ingest",
    "lineEnding": "LF",
    "numberRecordsFailed": 0,
    "numberRecordsProcessed": 0,
    "object": "Account",
    "operation": "insert",
    "retries": ***,
    "state": "UploadComplete",
    "systemModstamp": "***",
    "totalProcessingTime": ***
  }
}
