%%% note
Salesforce のストリーミング (d30 の org): publish-topic、publish-streaming-channel、push-generic-event、
publish-platform-event-message と、replay-topic-listener / replay-channel-listener (Platform Event を含む) が受けたもの。
listener が受けたものは Object Store に置き、/got/{key} で待って取り出す。ID や日時は型だけ比べる。
汎用のチャネル (/u/MulayChannel) への push は実 Mule でも listener に届かなかった (fanoutCount -1) ので、結果の形だけ比べる。
PushTopic MulayAccounts と StreamingChannel /u/MulayChannel は無ければ作り、あれば更新する。
Platform Event MulayEvent__e は salesforce-apex/sfdx で deploy しておく。
%%% requires src/main/resources/sf-secret.yaml
%%% port 18158
%%% request POST /reset
%%% response 200
content-type: application/json; charset=UTF-8

{
  "ok": true
}
%%% request POST /topic
%%% response 200
content-type: application/json; charset=UTF-8

{
  "class": "org.mule.extension.salesforce.api.core.Result",
  "keys": [
    "success",
    "id",
    "errors"
  ],
  "result": {
    "errors": [
      
    ],
    "id": "String",
    "success": true
  }
}
%%% request POST /channel
%%% response 200
content-type: application/json; charset=UTF-8

{
  "class": "org.mule.extension.salesforce.api.core.Result",
  "keys": [
    "success",
    "id",
    "errors"
  ],
  "result": {
    "errors": [
      
    ],
    "id": "String",
    "success": true
  }
}
%%% request POST /trigger/topic
%%% response 200
content-type: application/json; charset=UTF-8

{
  "successful": true
}
%%% request GET /got/topic
%%% response 200
content-type: application/json; charset=UTF-8

{
  "payloadClass": "java.util.LinkedHashMap",
  "payloadMime": "*/*",
  "payloadShape": {
    "Id": "String",
    "Name": "String"
  },
  "attributesClass": "java.util.HashMap",
  "attributesShape": {
    "createdDate": "String",
    "channel": "String",
    "replayId": "Number",
    "type": "String"
  },
  "channel": "/topic/MulayAccounts",
  "name": "mulayst one",
  "message": null,
  "eventType": "created",
  "eventApiName": null
}
%%% request POST /push
%%% response 200
content-type: application/json; charset=UTF-8

{
  "class": "java.util.ArrayList",
  "itemClass": "org.mule.extension.salesforce.api.stream.PushEventResult",
  "result": [
    {
      "userOnlineStatus": {
        
      },
      "fanoutCount": -1
    }
  ]
}
%%% request POST /publish/event
%%% response 200
content-type: application/json; charset=UTF-8

{
  "class": "java.util.ArrayList",
  "keys": [
    "success",
    "id",
    "errors"
  ],
  "result": [
    {
      "errors": [
        {
          "duplicateResult": null,
          "fields": [
            
          ],
          "message": "String",
          "statusCode": "OPERATION_ENQUEUED"
        }
      ],
      "id": "String",
      "success": true
    }
  ]
}
%%% request GET /got/event
%%% response 200
content-type: application/json; charset=UTF-8

{
  "payloadClass": "org.cometd.common.HashMapMessage",
  "payloadMime": "*/*",
  "payloadShape": {
    "data": {
      "schema": "String",
      "payload": {
        "CreatedById": "String",
        "Message__c": "String",
        "CreatedDate": "String"
      },
      "event": {
        "EventUuid": "String",
        "replayId": "Number",
        "EventApiName": "String"
      }
    },
    "channel": "String"
  },
  "attributesClass": "java.util.HashMap",
  "attributesShape": {
    "EventUuid": "String",
    "channel": "String",
    "replayId": "Number",
    "EventApiName": "String"
  },
  "channel": "/event/MulayEvent__e",
  "name": null,
  "message": "hello event",
  "eventType": null,
  "eventApiName": "MulayEvent__e"
}
%%% request POST /cleanup
%%% response 200
content-type: application/json; charset=UTF-8

{
  "deleted": 1
}
