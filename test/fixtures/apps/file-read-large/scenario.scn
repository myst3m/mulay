%%% note
512 KB を超えるファイルの file:read。payload は何度でも読め、file:write で写した後も読める (実 Mule の repeatable なストリーム)。
mulay はファイルをコピーせず、読むたびにファイルから読む (ADR 104)。
%%% port 18576
%%% startdir /tmp/mulay-oracle-file-read-large
%%% request GET /seed
%%% response 200

seeded
%%% request GET /twice
%%% response 200
content-type: application/json; charset=UTF-8

{
  "first": 758893,
  "second": 758893,
  "head": "line-1",
  "tail": "line-70000",
  "mimeType": "text/plain"
}
%%% request GET /copy
%%% response 200
content-type: application/json; charset=UTF-8

{
  "size": 758893,
  "same": true
}
%%% request GET /lines
%%% response 200
content-type: application/json; charset=UTF-8

{
  "count": 70000,
  "last": "line-70000"
}
