%%% note
プッシュ通知の設定のオプション。実コネクタ 1.1.1 は on-config-accepted の authentication と proxy-config を使わない
(通知の POST に Authorization は付かず、proxy にも向かわない。additional-headers と同じ)。requestTimeout の時間切れは
通知の届き方には出ない (再送もしない)。通知を受ける側が 2.5 秒かけても届く。
%%% jvm -Dmulay.a2a.allowPrivatePushUrls=true
%%% port 18198
%%% request POST /t/rpc?path=/auth
Content-Type: text/plain

{"jsonrpc":"2.0","id":1,"method":"message/send","params":{"message":{"kind":"message","role":"user","messageId":"u","parts":[{"kind":"text","text":"work"}]},"configuration":{"pushNotificationConfig":{"url":"http://localhost:18198/hook/auth","token":"tk"}}}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 202,
  "body": "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"id\":\"<uuid>\",\"contextId\":\"<uuid>\",\"status\":{\"state\":\"submitted\",\"timestamp\":\"<ts>\"},\"artifacts\":[],\"history\":[],\"kind\":\"task\"}}"
}
%%% request GET /t/hooks?n=1
%%% response 200
content-type: application/json; charset=UTF-8

[
  {
    "hook": "auth",
    "method": "POST",
    "ctype": "application/json",
    "token": "tk",
    "extra": null,
    "auth": null,
    "host": "localhost:18198",
    "path": "/hook/auth",
    "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"result\": {\n    \"id\": \"<uuid>\",\n    \"contextId\": \"<uuid>\",\n    \"status\": {\n      \"state\": \"working\",\n      \"timestamp\": \"<ts>\"\n    },\n    \"artifacts\": [\n      \n    ],\n    \"history\": [\n      \n    ],\n    \"kind\": \"task\"\n  }\n}"
  }
]
%%% request POST /t/rpc?path=/proxy
Content-Type: text/plain

{"jsonrpc":"2.0","id":2,"method":"message/send","params":{"message":{"kind":"message","role":"user","messageId":"u","parts":[{"kind":"text","text":"work"}]},"configuration":{"pushNotificationConfig":{"url":"http://target.invalid/hook/proxy","token":"tk"}}}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 202,
  "body": "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"id\":\"<uuid>\",\"contextId\":\"<uuid>\",\"status\":{\"state\":\"submitted\",\"timestamp\":\"<ts>\"},\"artifacts\":[],\"history\":[],\"kind\":\"task\"}}"
}
%%% request GET /t/hooks?n=1
%%% response 200
content-type: application/json; charset=UTF-8

[
  
]
%%% request POST /t/rpc?path=/slow
Content-Type: text/plain

{"jsonrpc":"2.0","id":3,"method":"message/send","params":{"message":{"kind":"message","role":"user","messageId":"u","parts":[{"kind":"text","text":"work"}]},"configuration":{"pushNotificationConfig":{"url":"http://localhost:18198/hook/slow","token":"tk"}}}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 202,
  "body": "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"id\":\"<uuid>\",\"contextId\":\"<uuid>\",\"status\":{\"state\":\"submitted\",\"timestamp\":\"<ts>\"},\"artifacts\":[],\"history\":[],\"kind\":\"task\"}}"
}
%%% request GET /t/hooks?n=1
%%% response 200
content-type: application/json; charset=UTF-8

[
  {
    "hook": "slow",
    "method": "POST",
    "ctype": "application/json",
    "token": "tk",
    "extra": null,
    "auth": null,
    "host": "localhost:18198",
    "path": "/hook/slow",
    "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 3,\n  \"result\": {\n    \"id\": \"<uuid>\",\n    \"contextId\": \"<uuid>\",\n    \"status\": {\n      \"state\": \"working\",\n      \"timestamp\": \"<ts>\"\n    },\n    \"artifacts\": [\n      \n    ],\n    \"history\": [\n      \n    ],\n    \"kind\": \"task\"\n  }\n}"
  }
]
