%%% note
Salesforce コネクタの続き: merge、convert-lead、find-duplicates (条件と ID)、SOAP ヘッダ (AllOrNoneHeader)、
Bulk API v1 のジョブ (create-job、create-batch、batch-info-list、close-job、job-info、abort-job)、
query-xml-stream、search の parameters。Bulk API v1 の query ジョブと結果 (batch-info、batch-result、
query-result-list、query-result-stream-by-id)、CSV の create-batch-stream。レコードの名前は "mulay2 ..."。POJO のキーは並べ替えて比べる
(実 Mule では並びが実行ごとに変わる)。
%%% requires src/main/resources/sf-secret.yaml
%%% port 18136
%%% mask
"(?:id|Id|jobId|accountId|contactId|leadId|opportunityId)": "([A-Za-z0-9]{15,18})"
"(?:createdDate|systemModstamp|CreatedDate)": "([^"]*)"
%%% request POST /setup
%%% response 200

clean
%%% request POST /merge
%%% response 200
content-type: application/json; charset=UTF-8

{
  "payloadClass": "org.mule.extension.salesforce.api.core.MergeResult",
  "result": {
    "errors": 0,
    "id": "***",
    "mergedRecordIds": 2,
    "success": true,
    "updatedRelatedIds": 0
  }
}
