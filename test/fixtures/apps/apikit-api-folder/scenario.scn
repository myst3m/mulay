%%% note
apikit:config の api 属性に api/ を付けない名前 (Studio の雛形の書き方) を書き、仕様を
src/main/resources/api/ に置く。実 Mule は api/ の下から仕様を見つけて振り分ける。
%%% port 18568
%%% request GET /api/shipments/S-1
%%% response 200
content-type: application/json; charset=UTF-8

{
  "shipmentId": "S-1",
  "status": "preparing"
}
%%% request POST /api/shipments
Content-Type: application/json

{}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "message": "required key [orderId] not found"
}
%%% request GET /api/nope
%%% response 404
content-type: application/json; charset=UTF-8

{
  "message": "Resource not found"
}
