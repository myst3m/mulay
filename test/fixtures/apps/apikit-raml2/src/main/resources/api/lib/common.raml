#%RAML 1.0 Library
types:
  Base:
    type: object
    properties:
      id: integer
  Pet:
    type: Base
    properties:
      name:
        type: string
        maxLength: 4
      tags: string[]
      size?:
        enum: [small, large]
      owner?: Owner | nil
  Owner:
    properties:
      first: string
traits:
  searchable:
    queryParameters:
      <<paramName>>:
        type: string
        minLength: <<min>>
        required: false
resourceTypes:
  collection:
    description: <<resourcePathName>> collection
    get:
      responses:
        200:
          body:
            application/json:
              type: <<item>>[]
    post?:
      body:
        application/json:
          type: <<item>>
