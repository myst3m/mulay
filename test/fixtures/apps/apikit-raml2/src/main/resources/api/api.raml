#%RAML 1.0
title: Pets
mediaType: application/json
uses:
  c: lib/common.raml
/pets:
  type: { c.collection: { item: c.Pet } }
  get:
    is: [ c.searchable: { paramName: q, min: 2 } ]
  post:
  /{petId}:
    uriParameters:
      petId:
        type: integer
        minimum: 1
    get:
      headers:
        X-Version?:
          type: integer
    /toys/{toyId}:
      get:
/owners:
  type: { c.collection: { item: c.Owner } }
  get:
/orders:
  post:
    body:
      type: !include schemas/order.json
/notes:
  post:
    body:
      properties:
        text: string
        pri?:
          type: integer
          maximum: 5
