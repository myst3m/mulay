<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <!-- 認証情報はリポジトリに入れない (scenario.scn の requires) -->
    <configuration-properties file="oracle-secret.yaml"/>

    <http:listener-config name="L">
        <http:listener-connection host="0.0.0.0" port="18150"/>
    </http:listener-config>

    <db:config name="Ora">
        <db:oracle-connection host="${ora.host}" port="${ora.port}" user="${ora.user}" password="${ora.password}" serviceName="${ora.service}"/>
    </db:config>

    <db:config name="OraOne">
        <db:oracle-connection host="${ora.host}" port="${ora.port}" user="${ora.user}" password="${ora.password}" serviceName="${ora.service}">
            <db:pooling-profile maxPoolSize="1" minPoolSize="0" maxWait="500" maxWaitUnit="MILLISECONDS"/>
        </db:oracle-connection>
    </db:config>

    <db:config name="OraUrl">
        <db:generic-connection url="jdbc:oracle:thin:@//${ora.host}:${ora.port}/${ora.service}" driverClassName="oracle.jdbc.OracleDriver" user="${ora.user}" password="${ora.password}"/>
    </db:config>

    <error-handler name="report">
        <on-error-continue>
            <ee:transform>
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{"type": error.errorType.namespace ++ ":" ++ error.errorType.identifier, description: error.description}]]></ee:set-payload>
                </ee:message>
            </ee:transform>
        </on-error-continue>
    </error-handler>
    <!-- 表を作り直す (シナリオの最初に呼ぶ) -->
    <flow name="reset">
        <http:listener config-ref="L" path="/reset"/>
        <db:execute-script config-ref="Ora">
            <db:sql><![CDATA[DROP TABLE IF EXISTS person PURGE;
CREATE TABLE person (id NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, name VARCHAR2(50) NOT NULL, age NUMBER(3), score NUMBER(8,2), active BOOLEAN, born DATE, seen TIMESTAMP(3), seen_tz TIMESTAMP WITH TIME ZONE, big NUMBER(19), dbl BINARY_DOUBLE, fl BINARY_FLOAT, raw_v RAW(16), note CLOB, fixed CHAR(4), nname NVARCHAR2(20));
INSERT INTO person (name, age, score, active, born, seen, seen_tz, big, dbl, fl, raw_v, note, fixed, nname) VALUES
 ('Ann', 30, 12.50, TRUE, DATE '1996-01-02', TIMESTAMP '2026-09-30 10:11:12.345', TIMESTAMP '2026-09-30 10:11:12 +09:00', 9007199254740993, 0.1, 1.5, HEXTORAW('0102FF'), 'long text', 'ab', 'にほんご'),
 ('Bob', NULL, NULL, FALSE, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL),
 ('Cid', 41, 100, TRUE, DATE '1985-12-31', TIMESTAMP '2026-01-01 00:00:00', TIMESTAMP '2026-01-01 00:00:00 +00:00', -5, -1e300d, 3, HEXTORAW(''), EMPTY_CLOB(), 'wxyz', 'é')]]></db:sql>
        </db:execute-script>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <!-- select: 行の値とその型 (Oracle の列名は大文字) -->
    <!-- select の maxRows -->
    <flow name="select-max">
        <http:listener config-ref="L" path="/select-max"/>
        <db:select config-ref="Ora" maxRows="#[attributes.queryParams.n as Number]">
            <db:sql>SELECT id, name FROM person ORDER BY id</db:sql>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="select">
        <http:listener config-ref="L" path="/select"/>
        <db:select config-ref="Ora">
            <db:sql>SELECT * FROM person ORDER BY id</db:sql>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="select-types">
        <http:listener config-ref="L" path="/select-types"/>
        <db:select config-ref="Ora">
            <db:sql>SELECT * FROM person ORDER BY id</db:sql>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload map ((row) -> row mapObject ((v, k) -> {(k): {t: typeOf(v) as String, c: v.^class default null}}))]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <!-- 式の値: 数値の型、空文字列 (Oracle では NULL)、引用符付きの列名 -->
    <flow name="select-exprs">
        <http:listener config-ref="L" path="/select-exprs"/>
        <db:select config-ref="Ora">
            <db:sql>SELECT 1 AS one, 1.5 AS half, -0.001 AS small, 12345678901234567890123 AS huge, 'x' AS s, '' AS empty_s, NULL AS nothing, "Mixed" FROM (SELECT 7 AS "Mixed" FROM dual)</db:sql>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload map ((row) -> row mapObject ((v, k) -> {(k): {t: typeOf(v) as String, c: v.^class default null}}))]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <!-- 地域名の時間帯の TIMESTAMP WITH TIME ZONE -->
    <flow name="select-tz-region">
        <http:listener config-ref="L" path="/select-tz-region"/>
        <db:select config-ref="Ora">
            <db:sql>SELECT TIMESTAMP '2026-09-30 10:11:12 Asia/Tokyo' AS tokyo, TIMESTAMP '2026-01-15 08:00:00 America/New_York' AS ny, TIMESTAMP '2026-07-15 08:00:00 America/New_York' AS ny_dst, TIMESTAMP '2026-03-01 00:00:00 UTC' AS utc, TIMESTAMP '2026-03-01 00:00:00 Europe/London' AS london FROM dual</db:sql>
        </db:select>
        <set-payload value="#[output application/json --- payload]"/>
    </flow>

    <flow name="select-exprs-values">
        <http:listener config-ref="L" path="/select-exprs-values"/>
        <db:select config-ref="Ora">
            <db:sql>SELECT 1 AS one, 1.5 AS half, -0.001 AS small, 12345678901234567890123 AS huge, 1e-130 AS tiny, 'x' AS s, '' AS empty_s, NULL AS nothing, "Mixed" FROM (SELECT 7 AS "Mixed" FROM dual)</db:sql>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="select-param">
        <http:listener config-ref="L" path="/select-param"/>
        <db:select config-ref="Ora">
            <db:sql>SELECT id, name FROM person WHERE age &gt; :min AND name &lt;&gt; :skip ORDER BY id</db:sql>
            <db:input-parameters><![CDATA[#[{min: attributes.queryParams.min as Number, skip: 'nobody'}]]]></db:input-parameters>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="select-param-types">
        <http:listener config-ref="L" path="/select-param-types"/>
        <db:select config-ref="Ora">
            <db:sql>SELECT :i AS i, :d AS d, :s AS s, :b AS b, :dt AS dt, :n AS n FROM dual</db:sql>
            <db:input-parameters><![CDATA[#[{i: 42, d: 2.25, s: 'hé', b: true, dt: |2026-09-30T01:02:03|, n: null}]]]></db:input-parameters>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload map ((row) -> row mapObject ((v, k) -> {(k): {t: typeOf(v) as String, c: v.^class default null}}))]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <!-- 複数回の fetch にまたがる行 -->
    <flow name="select-many">
        <http:listener config-ref="L" path="/select-many"/>
        <db:select config-ref="Ora">
            <db:sql>SELECT level AS n FROM dual CONNECT BY level &lt;= 25</db:sql>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{count: sizeOf(payload), sum: sum(payload.N)}]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <!-- insert: 生成されたキーは ROWID (値は毎回変わるので型と長さだけ) -->
    <flow name="insert">
        <http:listener config-ref="L" path="/insert"/>
        <db:insert config-ref="Ora" autoGenerateKeys="true">
            <db:sql>INSERT INTO person (name, age) VALUES (:name, :age)</db:sql>
            <db:input-parameters><![CDATA[#[{name: 'Dee', age: 22}]]]></db:input-parameters>
        </db:insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{affectedRows: payload.affectedRows, keys: payload.generatedKeys mapObject ((v, k) -> {(k): {t: typeOf(v) as String, c: v.^class default null}})}]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <!-- ROWID の中身: 生成されたキーと、SELECT ROWID。値は行ごとに変わるので形と長さだけ見る -->
    <flow name="rowid-bean">
        <http:listener config-ref="L" path="/rowid-bean"/>
        <db:insert config-ref="Ora" autoGenerateKeys="true">
            <db:sql>INSERT INTO person (name, age) VALUES ('Rid', 1)</db:sql>
        </db:insert>
        <set-variable variableName="k" value="#[payload.generatedKeys.ROWID]"/>
        <db:select config-ref="Ora"><db:sql>SELECT ROWID AS r, ROWIDTOCHAR(ROWID) AS s FROM person WHERE name = 'Rid'</db:sql></db:select>
        <set-variable variableName="row" value="#[payload[0]]"/>
        <db:delete config-ref="Ora"><db:sql>DELETE FROM person WHERE name = 'Rid'</db:sql></db:delete>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
fun shape(v) = v match {
  case o is Object -> o mapObject ((x, k) -> {(k): {t: typeOf(x) as String, len: if (x is String or x is Binary) sizeOf(x as String {encoding: "ISO-8859-1"}) else null, isNum: x is Number}})
  else -> typeOf(v) as String
}
---
{key: shape(vars.k), keyClass: vars.k.^class, sel: shape(vars.row.R), selClass: vars.row.R.^class, str: sizeOf(vars.row.S),
 selBytes: (vars.row.R.bytes as String) == vars.row.S, keyBytes: (vars.k.bytes as String) == vars.row.S, length: vars.row.R.length, isNull: vars.row.R."null", ac: vars.row.R.ACProxy}]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="insert-cols">
        <http:listener config-ref="L" path="/insert-cols"/>
        <db:insert config-ref="Ora" autoGenerateKeys="true">
            <db:sql>INSERT INTO person (name, age) VALUES (:name, :age)</db:sql>
            <db:input-parameters><![CDATA[#[{name: 'Eve', age: 23}]]]></db:input-parameters>
            <db:auto-generated-keys-column-names><db:auto-generated-keys-column-name value="ID"/></db:auto-generated-keys-column-names>
        </db:insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload.generatedKeys mapObject ((v, k) -> {(k): {v: v, t: typeOf(v) as String, c: v.^class default null}})]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="update">
        <http:listener config-ref="L" path="/update"/>
        <db:update config-ref="Ora">
            <db:sql>UPDATE person SET age = age + 1 WHERE age IS NOT NULL</db:sql>
        </db:update>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="delete">
        <http:listener config-ref="L" path="/delete"/>
        <db:delete config-ref="Ora">
            <db:sql>DELETE FROM person WHERE name IN (:a, :b)</db:sql>
            <db:input-parameters><![CDATA[#[{a: 'Dee', b: 'Eve'}]]]></db:input-parameters>
        </db:delete>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="bulk-insert">
        <http:listener config-ref="L" path="/bulk-insert"/>
        <db:bulk-insert config-ref="Ora">
            <db:bulk-input-parameters><![CDATA[#[[{name: 'E1', age: 1}, {name: 'E2', age: 2}]]]]></db:bulk-input-parameters>
            <db:sql>INSERT INTO person (name, age) VALUES (:name, :age)</db:sql>
        </db:bulk-insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="query-single">
        <http:listener config-ref="L" path="/query-single"/>
        <db:query-single config-ref="Ora">
            <db:sql>SELECT count(*) AS n, max(age) AS oldest FROM person</db:sql>
        </db:query-single>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <!-- generic-connection の jdbc:oracle:thin: の URL -->
    <flow name="url-config">
        <http:listener config-ref="L" path="/url-config"/>
        <db:select config-ref="OraUrl">
            <db:sql>SELECT name FROM person WHERE id = 1</db:sql>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <!-- PL/SQL の無名ブロック -->
    <flow name="plsql">
        <http:listener config-ref="L" path="/plsql"/>
        <db:execute-script config-ref="Ora">
            <db:sql><![CDATA[BEGIN UPDATE person SET age = 99 WHERE name = 'Bob'; END;]]></db:sql>
        </db:execute-script>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <!-- 失敗: SQL の誤り、無い表、制約違反、値の大きすぎ、0 除算 -->
    <flow name="err-syntax">
        <http:listener config-ref="L" path="/err-syntax"/>
        <db:select config-ref="Ora"><db:sql>SELEC 1 FROM dual</db:sql></db:select>
        <error-handler ref="report"/>
    </flow>

    <flow name="err-table">
        <http:listener config-ref="L" path="/err-table"/>
        <db:select config-ref="Ora"><db:sql>SELECT * FROM nothing_here</db:sql></db:select>
        <error-handler ref="report"/>
    </flow>

    <flow name="err-constraint">
        <http:listener config-ref="L" path="/err-constraint"/>
        <db:insert config-ref="Ora"><db:sql>INSERT INTO person (name) VALUES (NULL)</db:sql></db:insert>
        <error-handler ref="report"/>
    </flow>

    <flow name="err-toolarge">
        <http:listener config-ref="L" path="/err-toolarge"/>
        <db:insert config-ref="Ora"><db:sql>INSERT INTO person (name, age) VALUES ('Big', 12345)</db:sql></db:insert>
        <error-handler ref="report"/>
    </flow>

    <flow name="err-divide">
        <http:listener config-ref="L" path="/err-divide"/>
        <db:select config-ref="Ora"><db:sql>SELECT 1/0 AS x FROM dual</db:sql></db:select>
        <error-handler ref="report"/>
    </flow>
    <!-- ストアドプロシージャ: 作る -->
    <flow name="sp-setup">
        <http:listener config-ref="L" path="/sp-setup"/>
        <db:execute-ddl config-ref="Ora"><db:sql><![CDATA[CREATE OR REPLACE PROCEDURE add_one(a IN NUMBER, b OUT NUMBER) AS BEGIN b := a + 1; END;]]></db:sql></db:execute-ddl>
        <db:execute-ddl config-ref="Ora"><db:sql><![CDATA[CREATE OR REPLACE PROCEDURE greet(n IN OUT VARCHAR2) AS BEGIN n := 'Hi ' || n; END;]]></db:sql></db:execute-ddl>
        <db:execute-ddl config-ref="Ora"><db:sql><![CDATA[CREATE OR REPLACE PROCEDURE touch_bob AS BEGIN UPDATE person SET age = 7 WHERE name = 'Bob'; END;]]></db:sql></db:execute-ddl>
        <db:execute-ddl config-ref="Ora"><db:sql><![CDATA[CREATE OR REPLACE PROCEDURE list_people(c OUT SYS_REFCURSOR) AS BEGIN OPEN c FOR SELECT id, name FROM person ORDER BY id; END;]]></db:sql></db:execute-ddl>
        <db:execute-ddl config-ref="Ora"><db:sql><![CDATA[CREATE OR REPLACE PROCEDURE info(n IN VARCHAR2, len OUT NUMBER, up OUT VARCHAR2, d OUT DATE, ok OUT BOOLEAN) AS BEGIN len := LENGTH(n); up := UPPER(n); d := DATE '2026-01-02'; ok := TRUE; END;]]></db:sql></db:execute-ddl>
        <db:execute-ddl config-ref="Ora"><db:sql><![CDATA[CREATE OR REPLACE FUNCTION twice(x IN NUMBER) RETURN NUMBER AS BEGIN RETURN x * 2; END;]]></db:sql></db:execute-ddl>
        <set-payload value="#['ok']"/>
    </flow>

    <!-- IN と OUT -->
    <flow name="sp-out">
        <http:listener config-ref="L" path="/sp-out"/>
        <db:stored-procedure config-ref="Ora">
            <db:sql><![CDATA[{call add_one(:a, :b)}]]></db:sql>
            <db:input-parameters><![CDATA[#[{a: 41}]]]></db:input-parameters>
            <db:output-parameters>
                <db:output-parameter key="b" type="NUMERIC"/>
            </db:output-parameters>
        </db:stored-procedure>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload mapObject ((v, k) -> {(k): {v: v, t: typeOf(v) as String, c: v.^class default null}})]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="sp-inout">
        <http:listener config-ref="L" path="/sp-inout"/>
        <db:stored-procedure config-ref="Ora">
            <db:sql><![CDATA[{call greet(:n)}]]></db:sql>
            <db:in-out-parameters>
                <db:in-out-parameter key="n" value="#['Ann']"/>
            </db:in-out-parameters>
        </db:stored-procedure>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload mapObject ((v, k) -> {(k): {v: v, t: typeOf(v) as String, c: v.^class default null}})]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="sp-none">
        <http:listener config-ref="L" path="/sp-none"/>
        <db:stored-procedure config-ref="Ora">
            <db:sql><![CDATA[{call touch_bob()}]]></db:sql>
        </db:stored-procedure>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload mapObject ((v, k) -> {(k): {v: v, t: typeOf(v) as String, c: v.^class default null}})]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="sp-cursor">
        <http:listener config-ref="L" path="/sp-cursor"/>
        <db:stored-procedure config-ref="Ora">
            <db:sql><![CDATA[{call list_people(:c)}]]></db:sql>
            <db:output-parameters>
                <db:output-parameter key="c" type="REF_CURSOR"/>
            </db:output-parameters>
        </db:stored-procedure>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="sp-multi">
        <http:listener config-ref="L" path="/sp-multi"/>
        <db:stored-procedure config-ref="Ora">
            <db:sql><![CDATA[{call info(:n, :len, :up, :d, :ok)}]]></db:sql>
            <db:input-parameters><![CDATA[#[{n: 'abc'}]]]></db:input-parameters>
            <db:output-parameters>
                <db:output-parameter key="len" type="INTEGER"/>
                <db:output-parameter key="up" type="VARCHAR"/>
                <db:output-parameter key="d" type="DATE"/>
                <db:output-parameter key="ok" type="BOOLEAN"/>
            </db:output-parameters>
        </db:stored-procedure>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload mapObject ((v, k) -> {(k): {v: v, t: typeOf(v) as String, c: v.^class default null}})]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="sp-func">
        <http:listener config-ref="L" path="/sp-func"/>
        <db:stored-procedure config-ref="Ora">
            <db:sql><![CDATA[{:r = call twice(:x)}]]></db:sql>
            <db:input-parameters><![CDATA[#[{x: 21}]]]></db:input-parameters>
            <db:output-parameters>
                <db:output-parameter key="r" type="NUMERIC"/>
            </db:output-parameters>
        </db:stored-procedure>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload mapObject ((v, k) -> {(k): {v: v, t: typeOf(v) as String, c: v.^class default null}})]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="sp-missing">
        <http:listener config-ref="L" path="/sp-missing"/>
        <db:stored-procedure config-ref="Ora">
            <db:sql><![CDATA[{call nothing_here(:a)}]]></db:sql>
            <db:input-parameters><![CDATA[#[{a: 1}]]]></db:input-parameters>
        </db:stored-procedure>
        <error-handler ref="report"/>
    </flow>
    <!-- execute-script の途中の文の失敗 -->
    <flow name="err-script">
        <http:listener config-ref="L" path="/err-script"/>
        <db:execute-script config-ref="Ora">
            <db:sql><![CDATA[UPDATE person SET age = age WHERE 1 = 0;
SELECT * FROM nothing_here;
UPDATE person SET age = age WHERE 1 = 0]]></db:sql>
        </db:execute-script>
        <error-handler ref="report"/>
    </flow>
    <flow name="err-script2">
        <http:listener config-ref="L" path="/err-script2"/>
        <db:execute-script config-ref="Ora">
            <db:sql><![CDATA[UPDATE person SET age = age WHERE 1 = 0;
INSERT INTO person (name) VALUES (NULL);
UPDATE person SET age = age WHERE 1 = 0]]></db:sql>
        </db:execute-script>
        <error-handler ref="report"/>
    </flow>
    <flow name="script-select">
        <http:listener config-ref="L" path="/script-select"/>
        <db:execute-script config-ref="Ora">
            <db:sql><![CDATA[UPDATE person SET age = age WHERE 1 = 0;
SELECT name FROM person WHERE 1 = 0]]></db:sql>
        </db:execute-script>
        <error-handler ref="report"/>
    </flow>
    <!-- トランザクション: try の transactionalAction -->
    <flow name="tx-ok">
        <http:listener config-ref="L" path="/tx-ok"/>
        <try transactionalAction="ALWAYS_BEGIN">
            <db:insert config-ref="Ora"><db:sql>INSERT INTO person (name) VALUES ('T1')</db:sql></db:insert>
            <db:insert config-ref="Ora"><db:sql>INSERT INTO person (name) VALUES ('T2')</db:sql></db:insert>
        </try>
        <db:select config-ref="Ora"><db:sql>SELECT name AS "name" FROM person WHERE name LIKE 'T%' ORDER BY name</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="tx-rollback">
        <http:listener config-ref="L" path="/tx-rollback"/>
        <try>
            <try transactionalAction="ALWAYS_BEGIN">
                <db:insert config-ref="Ora"><db:sql>INSERT INTO person (name) VALUES ('R1')</db:sql></db:insert>
                <raise-error type="APP:FAIL" description="fail in tx"/>
            </try>
            <error-handler><on-error-continue><set-payload value="#['caught']"/></on-error-continue></error-handler>
        </try>
        <db:select config-ref="Ora"><db:sql>SELECT name AS "name" FROM person WHERE name LIKE 'R%' ORDER BY name</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="tx-continue">
        <http:listener config-ref="L" path="/tx-continue"/>
        <try transactionalAction="ALWAYS_BEGIN">
            <db:insert config-ref="Ora"><db:sql>INSERT INTO person (name) VALUES ('C1')</db:sql></db:insert>
            <raise-error type="APP:FAIL" description="fail in tx"/>
            <error-handler><on-error-continue><set-payload value="#['continued']"/></on-error-continue></error-handler>
        </try>
        <db:select config-ref="Ora"><db:sql>SELECT name AS "name" FROM person WHERE name LIKE 'C%' ORDER BY name</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="tx-notsupported">
        <http:listener config-ref="L" path="/tx-notsupported"/>
        <try>
            <try transactionalAction="ALWAYS_BEGIN">
                <db:insert config-ref="Ora" transactionalAction="NOT_SUPPORTED"><db:sql>INSERT INTO person (name) VALUES ('N1')</db:sql></db:insert>
                <db:insert config-ref="Ora"><db:sql>INSERT INTO person (name) VALUES ('N2')</db:sql></db:insert>
                <raise-error type="APP:FAIL" description="fail in tx"/>
            </try>
            <error-handler><on-error-continue><set-payload value="#['caught']"/></on-error-continue></error-handler>
        </try>
        <db:select config-ref="Ora"><db:sql>SELECT name AS "name" FROM person WHERE name LIKE 'N%' ORDER BY name</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="tx-sees-own">
        <http:listener config-ref="L" path="/tx-sees-own"/>
        <try transactionalAction="ALWAYS_BEGIN">
            <db:insert config-ref="Ora"><db:sql>INSERT INTO person (name) VALUES ('S1')</db:sql></db:insert>
            <db:select config-ref="Ora"><db:sql>SELECT count(*) AS "n" FROM person WHERE name = 'S1'</db:sql></db:select>
            <set-variable variableName="inside" value="#[payload[0].n]"/>
            <raise-error type="APP:FAIL" description="undo"/>
            <error-handler><on-error-propagate/></error-handler>
        </try>
        <error-handler>
            <on-error-continue>
                <db:select config-ref="Ora"><db:sql>SELECT count(*) AS "n" FROM person WHERE name = 'S1'</db:sql></db:select>
                <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{inside: vars.inside, after: payload[0].n}]]></ee:set-payload></ee:message></ee:transform>
            </on-error-continue>
        </error-handler>
    </flow>

    <!-- bulk 操作: 件数の配列、途中の行の失敗 (それまでの行が残るか)、空の入力、トランザクションの中の失敗 -->
    <flow name="bulk-setup">
        <http:listener config-ref="L" path="/bulk-setup"/>
        <db:execute-script config-ref="Ora">
            <db:sql><![CDATA[DROP TABLE IF EXISTS bulk_t PURGE;
CREATE TABLE bulk_t (id NUMBER(9) CONSTRAINT bulk_t_pk PRIMARY KEY, name VARCHAR2(20) NOT NULL, n NUMBER(9) DEFAULT 0)]]></db:sql>
        </db:execute-script>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="bulk-rows">
        <http:listener config-ref="L" path="/bulk-rows"/>
        <db:select config-ref="Ora"><db:sql>SELECT id, name, n FROM bulk_t ORDER BY id</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload map {id: $.id default $.ID, name: $.name default $.NAME, n: $.n default $.N}]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="bulk-ok">
        <http:listener config-ref="L" path="/bulk-ok"/>
        <db:bulk-insert config-ref="Ora">
            <db:bulk-input-parameters><![CDATA[#[[{id: 1, name: 'a'}, {id: 2, name: 'b'}, {id: 3, name: 'c'}, {id: 4, name: 'd'}]]]]></db:bulk-input-parameters>
            <db:sql>INSERT INTO bulk_t (id, name) VALUES (:id, :name)</db:sql>
        </db:bulk-insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>
    <flow name="bulk-upd">
        <http:listener config-ref="L" path="/bulk-upd"/>
        <db:bulk-update config-ref="Ora">
            <db:bulk-input-parameters><![CDATA[#[[{min: 1}, {min: 3}, {min: 99}]]]]></db:bulk-input-parameters>
            <db:sql>UPDATE bulk_t SET n = n + 1 WHERE id &gt;= :min</db:sql>
        </db:bulk-update>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>
    <flow name="bulk-null">
        <http:listener config-ref="L" path="/bulk-null"/>
        <db:bulk-insert config-ref="Ora">
            <db:bulk-input-parameters><![CDATA[#[[{id: 10, name: 'x'}, {id: 11, name: null}, {id: 12, name: 'z'}]]]]></db:bulk-input-parameters>
            <db:sql>INSERT INTO bulk_t (id, name) VALUES (:id, :name)</db:sql>
        </db:bulk-insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>
    <flow name="bulk-dup">
        <http:listener config-ref="L" path="/bulk-dup"/>
        <db:bulk-insert config-ref="Ora">
            <db:bulk-input-parameters><![CDATA[#[[{id: 20, name: 'p'}, {id: 1, name: 'dup'}, {id: 21, name: 'q'}]]]]></db:bulk-input-parameters>
            <db:sql>INSERT INTO bulk_t (id, name) VALUES (:id, :name)</db:sql>
        </db:bulk-insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>
    <flow name="bulk-empty">
        <http:listener config-ref="L" path="/bulk-empty"/>
        <db:bulk-insert config-ref="Ora">
            <db:bulk-input-parameters><![CDATA[#[[]]]]></db:bulk-input-parameters>
            <db:sql>INSERT INTO bulk_t (id, name) VALUES (:id, :name)</db:sql>
        </db:bulk-insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>
    <flow name="bulk-del">
        <http:listener config-ref="L" path="/bulk-del"/>
        <db:bulk-delete config-ref="Ora">
            <db:bulk-input-parameters><![CDATA[#[[{id: 2}, {id: 99}, {id: 3}]]]]></db:bulk-input-parameters>
            <db:sql>DELETE FROM bulk_t WHERE id = :id</db:sql>
        </db:bulk-delete>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>
    <flow name="bulk-tx">
        <http:listener config-ref="L" path="/bulk-tx"/>
        <try>
            <try transactionalAction="ALWAYS_BEGIN">
                <db:bulk-insert config-ref="Ora">
                    <db:bulk-input-parameters><![CDATA[#[[{id: 30, name: 't1'}, {id: 31, name: 't2'}]]]]></db:bulk-input-parameters>
                    <db:sql>INSERT INTO bulk_t (id, name) VALUES (:id, :name)</db:sql>
                </db:bulk-insert>
                <db:bulk-insert config-ref="Ora">
                    <db:bulk-input-parameters><![CDATA[#[[{id: 32, name: 't3'}, {id: 30, name: 'dup'}]]]]></db:bulk-input-parameters>
                    <db:sql>INSERT INTO bulk_t (id, name) VALUES (:id, :name)</db:sql>
                </db:bulk-insert>
            </try>
            <error-handler><on-error-continue><set-payload value="#['caught']"/></on-error-continue></error-handler>
        </try>
        <db:select config-ref="Ora"><db:sql>SELECT COUNT(*) AS c FROM bulk_t WHERE id &gt;= 30</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload[0].c default payload[0].C]]></ee:set-payload></ee:message></ee:transform>
    </flow>
    <flow name="bulk-notable">
        <http:listener config-ref="L" path="/bulk-notable"/>
        <db:bulk-insert config-ref="Ora">
            <db:bulk-input-parameters><![CDATA[#[[{id: 1}, {id: 2}]]]]></db:bulk-input-parameters>
            <db:sql>INSERT INTO no_such_table (id) VALUES (:id)</db:sql>
        </db:bulk-insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>
    <!-- direct-path の配列 insert (APPEND_VALUES)。自動コミットで表のロックが残らないこと (続けてもう一度入れられる) -->
    <flow name="bulk-append">
        <http:listener config-ref="L" path="/bulk-append"/>
        <db:bulk-insert config-ref="Ora">
            <db:bulk-input-parameters><![CDATA[#[[{id: 40, name: 'v1'}, {id: 41, name: 'v2'}, {id: 42, name: 'v3'}]]]]></db:bulk-input-parameters>
            <db:sql>INSERT /*+ APPEND_VALUES */ INTO bulk_t (id, name) VALUES (:id, :name)</db:sql>
        </db:bulk-insert>
        <db:bulk-insert config-ref="Ora">
            <db:bulk-input-parameters><![CDATA[#[[{id: 43, name: 'v4'}]]]]></db:bulk-input-parameters>
            <db:sql>INSERT /*+ APPEND_VALUES */ INTO bulk_t (id, name) VALUES (:id, :name)</db:sql>
        </db:bulk-insert>
        <set-variable variableName="second" value="#[payload]"/>
        <db:select config-ref="Ora"><db:sql>SELECT COUNT(*) AS c FROM bulk_t WHERE id BETWEEN 40 AND 49</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{second: vars.second, count: payload[0].C}]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>
    <!-- select の結果 (ストリーム): 接続 1 本の設定で、読まないまま次の select をすると接続を待って失敗する -->
    <flow name="stream-unread">
        <http:listener config-ref="L" path="/stream-unread"/>
        <db:select config-ref="OraOne"><db:sql>SELECT 1 AS a FROM dual</db:sql></db:select>
        <db:select config-ref="OraOne" target="second"><db:sql>SELECT 2 AS a FROM dual</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{first: payload, second: vars.second}]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>

    <!-- 読み切ってからなら次の select ができる (前の要求の接続も返っている) -->
    <flow name="stream-read">
        <http:listener config-ref="L" path="/stream-read"/>
        <db:select config-ref="OraOne"><db:sql>SELECT 1 AS a FROM dual</db:sql></db:select>
        <set-variable variableName="first" value="#[output application/json --- payload]"/>
        <db:select config-ref="OraOne"><db:sql>SELECT 2 AS a FROM dual</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{first: vars.first, second: payload}]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>

    <!-- foreach の batchSize で select の行を分ける。中で同じ設定の select をすると接続を待って失敗する (外の select がまだ持つ) -->
    <flow name="stream-foreach">
        <http:listener config-ref="L" path="/stream-foreach"/>
        <db:select config-ref="OraOne" fetchSize="3"><db:sql>SELECT LEVEL AS n FROM dual CONNECT BY LEVEL &lt;= 10</db:sql></db:select>
        <set-variable variableName="sizes" value="#[[]]"/>
        <foreach batchSize="4">
            <set-variable variableName="sizes" value="#[vars.sizes + {size: sizeOf(payload), first: payload[0].N, cls: payload[0].^class default 'none'}]"/>
        </foreach>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
vars.sizes]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="stream-foreach-inner">
        <http:listener config-ref="L" path="/stream-foreach-inner"/>
        <db:select config-ref="OraOne"><db:sql>SELECT LEVEL AS n FROM dual CONNECT BY LEVEL &lt;= 3</db:sql></db:select>
        <foreach>
            <db:select config-ref="OraOne"><db:sql>SELECT 9 AS a FROM dual</db:sql></db:select>
        </foreach>
        <set-payload value='#[output application/json --- "done"]'/>
        <error-handler ref="report"/>
    </flow>

    <flow name="stream-after">
        <http:listener config-ref="L" path="/stream-after"/>
        <db:select config-ref="OraOne"><db:sql>SELECT 3 AS a FROM dual</db:sql></db:select>
        <set-payload value="#[output application/json --- payload]"/>
        <error-handler ref="report"/>
    </flow>

    <!-- queryTimeout / queryTimeoutUnit: かかった時間は 1.5 秒より速いか (fast / slow) だけを返す -->
    <error-handler name="qt-report">
        <on-error-continue>
            <set-payload value="#[output application/json --- {'type': error.errorType.namespace ++ ':' ++ error.errorType.identifier, description: error.description, speed: if (((now() as Number {unit: 'milliseconds'}) - (vars.t0 as Number {unit: 'milliseconds'})) &lt; 1500) 'fast' else 'slow'}]"/>
        </on-error-continue>
    </error-handler>
    <flow name="qt-select-ok">
        <http:listener config-ref="L" path="/qt/select-ok"/>
        <set-variable variableName="t0" value="#[now()]"/>
        <db:execute-ddl config-ref="Ora"><db:sql>CREATE OR REPLACE FUNCTION qt_sleep(s NUMBER) RETURN NUMBER IS BEGIN DBMS_SESSION.SLEEP(s); RETURN 1; END;</db:sql></db:execute-ddl>
        <db:select config-ref="Ora" queryTimeout="5"><db:sql>SELECT qt_sleep(0.2) AS x FROM dual</db:sql></db:select>
        <set-payload value="#[output application/json --- {result: payload, speed: if (((now() as Number {unit: 'milliseconds'}) - (vars.t0 as Number {unit: 'milliseconds'})) &lt; 1500) 'fast' else 'slow'}]"/>
        <error-handler ref="qt-report"/>
    </flow>

    <!-- Oracle の中断 (ojdbc は TCP の緊急データと marker パケットで合図する)。テストの DB は port-forward 越しで緊急データが届かず、サーバーは文を終えてから合図を読む (insert は約 3 秒後に ORA-01013 で、行は入る)。stored-procedure の中断は経路の時機で結果が変わる (直接は成功、中継を挟むと ORA-01013) ので記録しない -->
    <!-- 中断の失敗は、時機によって ORA-06512 の行が付くので、最初の行だけを返す -->
    <error-handler name="qt-report-first">
        <on-error-continue>
            <set-payload value="#[output application/json --- {'type': error.errorType.namespace ++ ':' ++ error.errorType.identifier, description: (error.description splitBy '\n')[0], speed: if (((now() as Number {unit: 'milliseconds'}) - (vars.t0 as Number {unit: 'milliseconds'})) &lt; 1500) 'fast' else 'slow'}]"/>
        </on-error-continue>
    </error-handler>
    <flow name="qt-insert">
        <http:listener config-ref="L" path="/qt/insert"/>
        <db:execute-ddl config-ref="Ora"><db:sql>CREATE OR REPLACE FUNCTION qt_sleep(s NUMBER) RETURN NUMBER IS BEGIN DBMS_SESSION.SLEEP(s); RETURN 1; END;</db:sql></db:execute-ddl>
        <try>
            <db:execute-ddl config-ref="Ora"><db:sql>CREATE TABLE qtc_rows (n NUMBER)</db:sql></db:execute-ddl>
            <error-handler><on-error-continue/></error-handler>
        </try>
        <set-variable variableName="t0" value="#[now()]"/>
        <db:insert config-ref="Ora" queryTimeout="1"><db:sql>INSERT INTO qtc_rows VALUES (qt_sleep(3))</db:sql></db:insert>
        <set-payload value="#[output application/json --- {result: payload, speed: if (((now() as Number {unit: 'milliseconds'}) - (vars.t0 as Number {unit: 'milliseconds'})) &lt; 1500) 'fast' else 'slow'}]"/>
        <error-handler ref="qt-report-first"/>
    </flow>
    <flow name="qt-reuse">
        <http:listener config-ref="L" path="/qt/reuse"/>
        <db:execute-ddl config-ref="Ora"><db:sql>CREATE OR REPLACE FUNCTION qt_sleep(s NUMBER) RETURN NUMBER IS BEGIN DBMS_SESSION.SLEEP(s); RETURN 1; END;</db:sql></db:execute-ddl>
        <try>
            <db:execute-ddl config-ref="Ora"><db:sql>CREATE TABLE qtc_rows (n NUMBER)</db:sql></db:execute-ddl>
            <error-handler><on-error-continue/></error-handler>
        </try>
        <set-variable variableName="t0" value="#[now()]"/>
        <try>
            <db:insert config-ref="Ora" queryTimeout="1"><db:sql>INSERT INTO qtc_rows VALUES (qt_sleep(3))</db:sql></db:insert>
            <set-variable variableName="first" value="#['no timeout']"/>
            <error-handler>
                <on-error-continue>
                    <set-variable variableName="first" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                </on-error-continue>
            </error-handler>
        </try>
        <db:select config-ref="Ora"><db:sql>SELECT 1 AS x FROM dual</db:sql></db:select>
        <set-payload value="#[output application/json --- {first: vars.first, after: payload, speed: if (((now() as Number {unit: 'milliseconds'}) - (vars.t0 as Number {unit: 'milliseconds'})) &lt; 1500) 'fast' else 'slow'}]"/>
        <error-handler ref="qt-report-first"/>
    </flow>

    <!-- RAISE_APPLICATION_ERROR (ORA-20000 から ORA-20999) の文言にも、他の番号と同じくヘルプの URL が付く -->
    <flow name="app-error">
        <http:listener config-ref="L" path="/app-error"/>
        <db:stored-procedure config-ref="Ora"><db:sql>{call RAISE_APPLICATION_ERROR(-20001, 'boom')}</db:sql></db:stored-procedure>
        <error-handler>
            <on-error-continue>
                <set-payload value="#[output application/json --- {'type': error.errorType.namespace ++ ':' ++ error.errorType.identifier, description: error.description}]"/>
            </on-error-continue>
        </error-handler>
    </flow>

</mule>
