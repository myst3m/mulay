%%% note
http:request の oauth:client-credentials-grant-type: トークンの取得 (basic 認証、本文に入れる)、再利用、401 での取り直し、取得の失敗。
%%% port 18402
%%% mask
ReactorNettyResponseWrapper@([0-9a-f]+)
%%% request GET /call-a
%%% response 200
content-type: application/json; charset=UTF-8

{
  "ok": true,
  "auth": "Bearer tok-1"
}
%%% request GET /call-a
%%% response 200
content-type: application/json; charset=UTF-8

{
  "ok": true,
  "auth": "Bearer tok-1"
}
%%% request GET :18403/token-last
%%% response 200
content-type: application/json; charset=UTF-8

{
  "authorization": "Basic bXktaWQ6bXktc2VjcmV0",
  "contentType": "application/x-www-form-urlencoded",
  "body": {
    "grant_type": "client_credentials",
    "scope": "read write"
  }
}
%%% request GET :18403/invalidate
%%% response 200

invalidated
%%% request GET /call-a
%%% response 200
content-type: application/json; charset=UTF-8

{
  "ok": true,
  "auth": "Bearer tok-2"
}
%%% request GET :18403/token-last
%%% response 200
content-type: application/json; charset=UTF-8

{
  "authorization": "Basic bXktaWQ6bXktc2VjcmV0",
  "contentType": "application/x-www-form-urlencoded",
  "body": {
    "grant_type": "client_credentials",
    "scope": "read write"
  }
}
%%% request GET /call-b
%%% response 200
content-type: application/json; charset=UTF-8

{
  "ok": true,
  "auth": "Bearer tok-3"
}
%%% request GET :18403/token-last
%%% response 200
content-type: application/json; charset=UTF-8

{
  "authorization": null,
  "contentType": "application/x-www-form-urlencoded",
  "body": {
    "grant_type": "client_credentials",
    "scope": "s1 s2",
    "client_id": "my-id",
    "client_secret": "my-secret"
  }
}
%%% request GET /call-c
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "HTTP:SECURITY",
  "description": "Error response when calling token URL 'http://localhost:18403/token-bad'. Response was:\norg.mule.service.http.netty.impl.message.ReactorNettyResponseWrapper@***\n{\n  \"error\": \"invalid_client\"\n}"
}
%%% request GET /call-d
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "HTTP:UNAUTHORIZED",
  "description": "HTTP GET on resource 'http://localhost:18403/deny401' failed: unauthorized (401)."
}
%%% request GET :18403/token-last
%%% response 200
content-type: application/json; charset=UTF-8

{
  "authorization": "Basic bXktaWQ6bXktc2VjcmV0",
  "contentType": "application/x-www-form-urlencoded",
  "body": {
    "grant_type": "client_credentials",
    "scope": "read write"
  }
}
%%% request GET /call-e
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "HTTP:FORBIDDEN",
  "description": "HTTP GET on resource 'http://localhost:18403/deny403' failed: forbidden (403)."
}
%%% request GET /call-a
%%% response 200
content-type: application/json; charset=UTF-8

{
  "ok": true,
  "auth": "Bearer tok-5"
}
%%% request GET /call-f
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "HTTP:SECURITY",
  "description": "Exception when calling token URL 'http://localhost:18499/token'."
}
%%% request GET /call-g
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "HTTP:SECURITY",
  "description": "Could not extract access token or refresh token from token URL 'http://localhost:18403/token-empty'. Response was:\norg.mule.service.http.netty.impl.message.ReactorNettyResponseWrapper@***\n{\n  \n}"
}
