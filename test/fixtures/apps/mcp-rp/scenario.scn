%%% note
MCP サーバーの mcp:resource-listener と mcp:prompt-listener。resources/list・read、prompts/list・get、各種の content、失敗の形。
複数の resource や prompt の一覧の並びは実 Mule でも起動のたびに変わるので、一覧は 1 つだけの設定 (/r1、/p1) で確かめる。
%%% port 18211
%%% mask
[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}
%%% capture SID header:mcp-session-id
%%% request POST /mcp headers=*
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"t","version":"1"}}}
%%% response 200
content-type: application/json
mcp-session-id: ***
mcp-protocol-version: 2025-06-18

{"jsonrpc":"2.0","id":1,"result":{"protocolVersion":"2025-06-18","capabilities":{"experimental":{},"logging":{},"prompts":{"listChanged":false},"resources":{"subscribe":false,"listChanged":false},"tools":{"listChanged":false}},"serverInfo":{"name":"RP","version":"1.0.0"}}}
%%% request POST /mcp headers=*
Content-Type: application/json
Accept: application/json, text/event-stream
Mcp-Session-Id: {{SID}}

{"jsonrpc":"2.0","method":"notifications/initialized"}
%%% response 202
mcp-protocol-version: 2025-06-18


