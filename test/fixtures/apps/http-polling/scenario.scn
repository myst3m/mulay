%%% note
HTTP コネクタ (1.11.3) の http:polling-source。同じアプリの /api/* を 300ms ごとに取りに行き、受けたものを ObjectStore (Seen) に書いて /dump で見る。
p1: splitExpression で配列を 1 件ずつ、watermarkExpression と idExpression で同じものを二度読まない (後から足した、watermark より小さいもの・同じもの)。
p2: 分けない応答、outputMimeType。p3: 500 の応答 (フローは動かない)。p4: POST と本文・ヘッダ・uri の引数・クエリ。
p5: クエリの値に watermark を使う。
%%% port 18540
%%% wait 1500
%%% request GET /dump
%%% response 200
content-type: application/json; charset=UTF-8

{
  "p1": {
    "1": {
      "count": 1,
      "first": "{\n  \"type\": \"Object\",\n  \"mime\": \"application/json\",\n  \"item\": {\n    \"id\": 1,\n    \"ts\": 10,\n    \"v\": \"a\"\n  },\n  \"attrClass\": \"org.mule.extension.http.api.HttpResponseAttributes\",\n  \"status\": 200,\n  \"ct\": \"application/json; charset=UTF-8\"\n}"
    },
    "2": {
      "count": 1,
      "first": "{\n  \"type\": \"Object\",\n  \"mime\": \"application/json\",\n  \"item\": {\n    \"id\": 2,\n    \"ts\": 20,\n    \"v\": \"b\"\n  },\n  \"attrClass\": \"org.mule.extension.http.api.HttpResponseAttributes\",\n  \"status\": 200,\n  \"ct\": \"application/json; charset=UTF-8\"\n}"
    },
    "3": {
      "count": 1,
      "first": "{\n  \"type\": \"Object\",\n  \"mime\": \"application/json\",\n  \"item\": {\n    \"id\": 3,\n    \"ts\": 30,\n    \"v\": \"c\"\n  },\n  \"attrClass\": \"org.mule.extension.http.api.HttpResponseAttributes\",\n  \"status\": 200,\n  \"ct\": \"application/json; charset=UTF-8\"\n}"
    }
  },
  "p2": "{\n  \"type\": \"Object\",\n  \"mime\": \"application/json\",\n  \"a\": 1,\n  \"status\": 200,\n  \"reason\": \"\"\n}",
  "p3": null,
  "p4": "{\n  \"type\": \"Object\",\n  \"mime\": \"application/json\",\n  \"value\": {\n    \"method\": \"POST\",\n    \"name\": \"joe\",\n    \"q\": \"1\",\n    \"xk\": \"v1\",\n    \"ct\": null,\n    \"body\": \"{\\\"b\\\": 1}\"\n  }\n}",
  "p5": {
    "1": 1,
    "2": 1
  },
  "q2": [
    "q2-0",
    "q2-20"
  ]
}
