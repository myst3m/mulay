%%% note
http:request の認証 (request-connection の http:authentication)。basic-authentication (既定は preemptive で最初から
Authorization: Basic を送る。preemptive="false" は 401 の WWW-Authenticate を見てから送る。username / password の式)、
http:headers の Authorization との関係、digest-authentication (最初は realm / nonce が "null" の仮の Authorization を送り、401 の Digest の挑戦に答える。実 Mule の値は
cnonce="null で終わる形)。
%%% port 18166
%%% request GET /t/basic
%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "body": {
    "auth": "Basic dXNlcjpwOnNzIMO8"
  }
}
%%% request GET /t/basic-lazy
%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "body": {
    "auth": ""
  }
}
%%% request GET /t/basic-lazy?challenge=basic
%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "body": {
    "auth": "Basic dXNlcjpwdw=="
  }
}
%%% request GET /t/basic-expr?u=a%20b&p=x
%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "body": {
    "auth": "Basic YSBiOng="
  }
}
%%% request GET /t/basic-header
%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "body": {
    "auth": "Bearer mine"
  }
}
%%% request GET /t/digest
%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "body": {
    "auth": "Digest username=\"dig\",realm=\"r1\",nonce=\"abc123\",uri=\"/back\",response=\"48aa2eedc028b8ec5d2fcfd65d2bd682\",opaque=\"op9\",qop=\"auth\",nc=\"00000001\",cnonce=\"null"
  }
}
%%% request GET /t/digest-lazy
%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "body": {
    "auth": "Digest username=\"dig\",realm=\"r1\",nonce=\"abc123\",uri=\"/back\",response=\"a3d5be19e1162fc3b9ef139b649c4219\",opaque=\"op9\",qop=\"auth\",nc=\"00000001\",cnonce=\"null"
  }
}
