%%% note
Salesforce の jwt-connection (d30 の org。接続アプリ "mulay oracle" に sf-jwt.jks の証明書を載せ、管理者が承認した
利用者を事前に許可してある)。sf-jwt.p12 は sf-jwt.jks を keytool -importkeystore で PKCS12 にしたもの (パスワードは同じ)。
sf-jwt.jks、sf-jwt.p12 と sf-secret.yaml (sf.consumerKey、sf.jwtStorePassword、sf.principal) は
リポジトリに入れない。
%%% requires src/main/resources/sf-secret.yaml
%%% requires src/main/resources/sf-jwt.p12
%%% port 18159
%%% mask
"([^"\s@]+@[^"\s@]+)"
%%% request GET /user
%%% response 200
content-type: application/json; charset=UTF-8

{
  "userName": "***",
  "organizationName": "String"
}
%%% request GET /query
%%% response 200
content-type: application/json; charset=UTF-8

[
  "***"
]
%%% request GET /user-p12
%%% response 200
content-type: application/json; charset=UTF-8

{
  "userName": "***"
}
%%% request GET /p12-bad-password
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "SALESFORCE:CONNECTIVITY",
  "description": "Failed signing payload"
}
%%% request GET /bad
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "SALESFORCE:INVALID_INPUT",
  "description": "Invalid status code: 400, response body: {\"error\":\"invalid_grant\""
}
