}
%%% request POST /vars-only
Content-Type: application/json

[1, 2, 3]
%%% response 200
content-type: application/json; charset=UTF-8

{
  "len": 3,
  "payload": [
    1,
    2,
    3
  ]
}
%%% request POST /resource
Content-Type: application/json

[{"name": "pen", "price": 1.5}, {"name": "ink", "price": 3}]
%%% response 200
content-type: application/json; charset=UTF-8

{
  "count": 2,
  "total": 4.5,
  "names": [
    "PEN",
    "INK"
  ]
}
