%%% note
ee:transform: 出力形式ごとの本文と応答の content-type (json、indent=false、xml、csv、
header=false/separator、text、Object を text にしたとき、java (HTTP 応答でどう書かれるか)、
yaml、urlencoded、dw)。受け取った Content-Type での読み込み (json、xml、csv、urlencoded、
text、yaml、壊れた入力)。1 つの transform で payload・attributes・変数を作る、variables だけの
transform、resource= の外部 .dwl、書き出しの失敗 (Object を CSV)。
%%% port 18118
%%% request GET /format/json
%%% response 200
content-type: application/json; charset=UTF-8

[
  {
    "id": 1,
    "name": "Ann",
    "tags": [
      "a",
      "b"
    ]
  },
  {
    "id": 2,
    "name": "Bob, Jr.",
    "tags": [
      
    ]
  }
]
%%% request GET /format/json-compact
%%% response 200
content-type: application/json; charset=UTF-8; indent="false"

[{"id": 1,"name": "Ann","tags": ["a","b"]},{"id": 2,"name": "Bob, Jr.","tags": []}]
%%% request GET /format/xml
%%% response 200
content-type: application/xml; charset=UTF-8

<?xml version='1.0' encoding='UTF-8'?>
<people>
  <person id="1">
    <name>Ann</name>
    <tags>
      <tag>a</tag>
      <tag>b</tag>
    </tags>
  </person>
  <person id="2">
    <name>Bob, Jr.</name>
    <tags/>
  </person>
</people>
%%% request GET /format/csv
%%% response 200
content-type: application/csv; charset=UTF-8

id,name,tagCount
1,Ann,2
2,Bob\, Jr.,0

%%% request GET /format/csv-noheader
%%% response 200
content-type: application/csv; charset=UTF-8; header="false"; separator=";"

1;Ann
2;Bob, Jr.

%%% request GET /format/text
%%% response 200
content-type: text/plain; charset=UTF-8

Ann|Bob, Jr.
%%% request GET /format/text-object
%%% response 500
content-type: text/plain; charset=UTF-8

"Text plain writer is unable to write Object.
Reason:
Cannot coerce Object to String, while writing TextPlain at data." evaluating expression: "%dw 2.0
output text/plain
---
vars.data[0]".
%%% request GET /format/java
%%% response 200 base64
content-type: application/java; charset=UTF-8


%%% request GET /format/yaml
%%% response 200
content-type: application/yaml; charset=UTF-8

%YAML 1.2
---
-
  id: 1
  name: Ann
  tags:
    - a
    - b
-
  id: 2
  name: Bob, Jr.
  tags:
    []
%%% request GET /format/urlencoded
%%% response 200
content-type: application/x-www-form-urlencoded; charset=UTF-8

name=Bob%2C+Jr.&id=2
%%% request GET /format/dw
%%% response 200
content-type: application/dw; charset=UTF-8

{
  id: 1 as Number {class: "java.lang.Integer"},
  name: "Ann" as String {class: "java.lang.String"},
  tags: [
    "a" as String {class: "java.lang.String"}, 
    "b" as String {class: "java.lang.String"}
  ] as Array {class: "java.util.ArrayList"}
} as Object {class: "java.util.LinkedHashMap"}
%%% request POST /read
Content-Type: application/json

{"a": [1, 2.0, 3e2], "b": null}
%%% response 200
content-type: application/json; charset=UTF-8

{
  "kind": "Object",
  "value": {
    "a": [
      1,
      2,
      3E+2
    ],
    "b": null
  }
}
%%% request POST /read
Content-Type: application/xml

<?xml version="1.0"?>
<order id="7"><line qty="2">pen</line><line qty="1">ink</line></order>
%%% response 200
content-type: application/json; charset=UTF-8

{
  "kind": "Object",
  "value": {
    "order": {
      "line": "pen",
      "line": "ink"
    }
  }
}
%%% request POST /read
Content-Type: application/csv

id,name
1,Ann
2,"Bob, Jr."
%%% response 200
content-type: application/json; charset=UTF-8

{
  "kind": "Array",
  "value": [
    {
      "id": "1",
      "name": "Ann"
    },
    {
      "id": "2",
      "name": "Bob, Jr."
    }
  ]
}
%%% request POST /read
Content-Type: application/x-www-form-urlencoded

a=1&a=2&b=%E3%81%82
%%% response 200
content-type: application/json; charset=UTF-8

{
  "kind": "Object",
  "value": {
    "a": "1",
    "a": "2",
    "b": "あ"
  }
}
%%% request POST /read
Content-Type: text/plain

hello text
%%% response 200
content-type: application/json; charset=UTF-8

{
  "kind": "String",
  "value": "hello text"
}
%%% request POST /read
Content-Type: application/yaml

a: 1
b:
  - x
  - y
%%% response 200
content-type: application/json; charset=UTF-8

{
  "kind": "Object",
  "value": {
    "a": 1,
    "b": [
      "x",
      "y"
    ]
  }
}
%%% request POST /read
Content-Type: application/json; charset=UTF-8

"just a string"
%%% response 200
content-type: application/json; charset=UTF-8

{
  "kind": "String",
  "value": "just a string"
}
%%% request POST /read
Content-Type: application/xml

<broken>
