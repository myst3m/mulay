<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
  <http:listener-config name="L"><http:listener-connection host="0.0.0.0" port="18578"/></http:listener-config>
  <flow name="count">
    <http:listener config-ref="L" path="/count"/>
    <set-payload value="#[output application/json --- do { var s = payload as String --- {n: sizeOf(s), head: s[0 to 1], tail: s[-1], chars: s splitBy '', up: upper(s), rev: s[-1 to 0]} }]"/>
  </flow>
</mule>
