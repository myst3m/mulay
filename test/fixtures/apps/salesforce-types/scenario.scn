    "message": "Sync Deleting: 必須種別以外の値: true"
  },
  {
    "i": 6,
    "successful": false,
    "statusCode": "INVALID_TYPE_ON_FIELD_IN_RECORD",
    "message": "Sync Deleting: 必須種別以外の値: 1"
  },
  {
    "i": 7,
    "successful": false,
    "statusCode": "INVALID_TYPE_ON_FIELD_IN_RECORD",
    "message": "Name: 必須種別以外の値: 123"
  },
  {
    "i": 8,
    "successful": false,
    "statusCode": "INVALID_TYPE_ON_FIELD_IN_RECORD",
    "message": "Status: 必須種別以外の値: 456"
  },
  {
    "i": 9,
    "successful": false,
    "statusCode": "INVALID_TYPE_ON_FIELD_IN_RECORD",
    "message": "Status: 必須種別以外の値: false"
  },
  {
    "i": 10,
    "successful": true,
    "statusCode": null,
    "message": null
  }
]
