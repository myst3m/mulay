%%% request GET /propagate
%%% response 200
content-type: application/json; charset=UTF-8

{
  "trail": [
    "start",
    "in-try",
    "inner-propagate",
    "flow-continue"
  ],
  "payloadSeen": "payload-from-propagate",
  "errorType": "INNER",
  "description": "inner failure"
}
%%% request GET /nested
%%% response 200
content-type: application/json; charset=UTF-8

[
  "inner-propagate",
  "outer-continue:DEEP",
  "after"
]
