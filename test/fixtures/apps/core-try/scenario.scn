%%% request GET /info?kind=notfound
%%% response 200
content-type: application/json; charset=UTF-8

{
  "namespace": "APP",
  "identifier": "NOT_FOUND",
  "asString": "not-coercible",
  "parent": "MULE:ANY",
  "grandParent": null,
  "description": "no such thing",
  "detailedDescription": "no such thing",
  "hasErrorMessage": false,
  "childErrors": 0
}
%%% request GET /info?kind=expr
%%% response 200
content-type: application/json; charset=UTF-8

{
  "namespace": "MULE",
  "identifier": "EXPRESSION",
  "asString": "not-coercible",
  "parent": "MULE:ANY",
  "grandParent": null,
  "description": "\"Division by zero\n\n1| 1 / 0\n   ^^^^^\nTrace:\n  at anonymous::main (line: 1, column: 1)\" evaluating expression: \"1 / 0\".",
  "detailedDescription": "\"Division by zero\n\n1| 1 / 0\n   ^^^^^\nTrace:\n  at anonymous::main (line: 1, column: 1)\" evaluating expression: \"1 / 0\".",
  "hasErrorMessage": false,
  "childErrors": 0
}
