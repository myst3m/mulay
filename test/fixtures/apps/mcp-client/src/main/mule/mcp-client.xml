    <flow name="hdrs-twice">
        <http:listener config-ref="L2" path="/hdrs-twice"/>
        <try>
            <mcp:call-tool config-ref="CliM" toolName="hdrs" extractStructuredContent="false" target="first"><mcp:arguments>#[{}]</mcp:arguments></mcp:call-tool>
            <mcp:call-tool config-ref="CliM" toolName="hdrs" extractStructuredContent="false" target="second"><mcp:arguments>#[{}]</mcp:arguments></mcp:call-tool>
            <set-payload value="#[output application/json --- {same: (read(vars.first.contents[0].text, 'application/json').sid) == (read(vars.second.contents[0].text, 'application/json').sid)}]"/>
            <error-handler>
                <on-error-continue>
                    <set-payload value="#[output application/json --- {error: error.errorType.namespace ++ ':' ++ error.errorType.identifier, desc: error.description}]"/>
                </on-error-continue>
            </error-handler>
        </try>
    </flow>

