    <flow name="tool-j-trail">
        <mcp:tool-listener config-ref="SrvM" name="j-trail">
            <mcp:description>d</mcp:description>
            <mcp:parameters-schema><![CDATA[{"type":"object"}]]></mcp:parameters-schema>
            <mcp:responses><mcp:text-tool-response-content text="{&quot;k&quot;:1} tail"/></mcp:responses>
        </mcp:tool-listener>
        <logger level="INFO" message="j-trail"/>
    </flow>

    <flow name="tool-j-two">
        <mcp:tool-listener config-ref="SrvM" name="j-two">
            <mcp:description>d</mcp:description>
            <mcp:parameters-schema><![CDATA[{"type":"object"}]]></mcp:parameters-schema>
            <mcp:responses><mcp:text-tool-response-content text="{&quot;k&quot;:1}"/><mcp:text-tool-response-content text="second"/></mcp:responses>
        </mcp:tool-listener>
        <logger level="INFO" message="j-two"/>
    </flow>

    <flow name="tool-j-img">
        <mcp:tool-listener config-ref="SrvM" name="j-img">
            <mcp:description>d</mcp:description>
            <mcp:parameters-schema><![CDATA[{"type":"object"}]]></mcp:parameters-schema>
            <mcp:responses><mcp:image-tool-response-content data="aGk=" mimeType="image/png"/></mcp:responses>
        </mcp:tool-listener>
        <logger level="INFO" message="j-img"/>
    </flow>

    <flow name="greeting">
        <mcp:resource-listener config-ref="SrvC" name="greeting" uri="mule://greeting" resourceMimeType="text/plain">
            <mcp:description>A greeting</mcp:description>
            <mcp:resource-listener-content>
                <mcp:text-resource text="hello"/>
            </mcp:resource-listener-content>
        </mcp:resource-listener>
        <logger level="INFO" message="greeting"/>
    </flow>
    <flow name="blob">
        <mcp:resource-listener config-ref="SrvM" name="blob" uri="mule://blob" resourceMimeType="application/octet-stream">
            <mcp:description>A blob</mcp:description>
            <mcp:resource-listener-content>
                <mcp:blob-resource blob="bytes"/>
            </mcp:resource-listener-content>
        </mcp:resource-listener>
        <logger level="INFO" message="blob"/>
    </flow>
    <flow name="boom">
        <mcp:resource-listener config-ref="SrvM" name="boom" uri="mule://boom" resourceMimeType="text/plain">
            <mcp:description>Fails</mcp:description>
            <mcp:resource-listener-content>
                <mcp:text-resource text="unreachable"/>
            </mcp:resource-listener-content>
        </mcp:resource-listener>
        <raise-error type="APP:BOOM" description="resource boom"/>
    </flow>
    <flow name="rich">
        <mcp:prompt-listener config-ref="SrvM" name="rich">
            <mcp:messages>
                <mcp:text-prompt-message-content role="ASSISTANT" text="first"/>
                <mcp:image-prompt-message-content mimeType="image/png">
                    <mcp:image-data>
                        <mcp:inline-image-data imageData="#['aGk=']"/>
                    </mcp:image-data>
                </mcp:image-prompt-message-content>
                <mcp:resource-link-prompt-message-content uri="mule://greeting" name="greeting" description="d" mimeType="text/plain" size="5"/>
                <mcp:embedded-resource-prompt-message-content uri="mule://e" mimeType="text/plain">
                    <mcp:resource-content>
                        <mcp:text-embedded-resource text="emb"/>
                    </mcp:resource-content>
                </mcp:embedded-resource-prompt-message-content>
                <mcp:embedded-resource-prompt-message-content uri="mule://f" mimeType="application/octet-stream">
                    <mcp:resource-content>
                        <mcp:blob-embedded-resource blob="#['Ymxv']"/>
                    </mcp:resource-content>
                </mcp:embedded-resource-prompt-message-content>
            </mcp:messages>
        </mcp:prompt-listener>
        <logger level="INFO" message="rich"/>
    </flow>
    <flow name="review">
        <mcp:prompt-listener config-ref="SrvC" name="review" title="Code review">
            <mcp:description>Review some code</mcp:description>
            <mcp:prompt-arguments>
                <mcp:prompt-argument name="code" description="The code" required="true"/>
            </mcp:prompt-arguments>
            <mcp:messages>
                <mcp:text-prompt-message-content role="USER" text="#['Review ' ++ (payload.arguments.code default '?')]"/>
                <mcp:text-prompt-message-content role="ASSISTANT" text="ok"/>
            </mcp:messages>
        </mcp:prompt-listener>
        <logger level="INFO" message="review"/>
    </flow>

    <flow name="call-add">
        <http:listener config-ref="L2" path="/call-add"/>
        <try>
            <mcp:call-tool config-ref="Cli" toolName="add"><mcp:arguments>#[{a: 1, b: 2}]</mcp:arguments></mcp:call-tool>
            <set-payload value="#[output application/json --- {payload: payload, kind: typeOf(payload) as String, attrs: attributes}]"/>
            <error-handler>
                <on-error-continue>
                    <set-payload value="#[output application/json --- {error: error.errorType.namespace ++ ':' ++ error.errorType.identifier, desc: error.description}]"/>
                </on-error-continue>
            </error-handler>
        </try>
    </flow>

    <flow name="call-multi">
        <http:listener config-ref="L2" path="/call-multi"/>
        <try>
            <mcp:call-tool config-ref="CliM" toolName="multi"><mcp:arguments>#[{}]</mcp:arguments></mcp:call-tool>
            <set-payload value="#[output application/json --- {payload: payload, kind: typeOf(payload) as String, attrs: attributes}]"/>
            <error-handler>
