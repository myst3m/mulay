    <flow name="call-expr-name">
        <http:listener config-ref="L2" path="/call-expr-name"/>
        <try>
            <mcp:call-tool config-ref="Cli" toolName="#['ad' ++ 'd']"><mcp:arguments>#[{a: 1, b: 1}]</mcp:arguments></mcp:call-tool>
            <set-payload value="#[output application/json --- payload.contents[0].text]"/>
