    <flow name="read-unknown">
        <http:listener config-ref="L2" path="/read-unknown"/>
        <try>
            <mcp:read-resource config-ref="Cli" uri="mule://nope"/>
            <set-payload value="#[output application/json --- {payload: payload, kind: typeOf(payload) as String, attrs: attributes}]"/>
