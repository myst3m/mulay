<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:mcp="http://www.mulesoft.org/schema/mule/mcp"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/mcp http://www.mulesoft.org/schema/mule/mcp/current/mule-mcp.xsd">

    <http:listener-config name="L">
        <http:listener-connection host="0.0.0.0" port="18213"/>
    </http:listener-config>
    <http:listener-config name="L2">
        <http:listener-connection host="0.0.0.0" port="18214"/>
    </http:listener-config>

    <mcp:server-config name="SrvC" serverName="Srv" serverVersion="1.0.0">
        <mcp:streamable-http-server-connection listenerConfig="L" mcpEndpointPath="/mcp" responseContentType="JSON"/>
    </mcp:server-config>
    <mcp:server-config name="SrvM" serverName="SrvM" serverVersion="1.0.0">
        <mcp:streamable-http-server-connection listenerConfig="L" mcpEndpointPath="/m"/>
    </mcp:server-config>

    <mcp:client-config name="Cli" clientName="mulay-test" clientVersion="9.9">
        <mcp:streamable-http-client-connection serverUrl="http://localhost:18213" mcpEndpointPath="/mcp"/>
    </mcp:client-config>
    <mcp:client-config name="CliM" clientName="mulay-test" clientVersion="9.9">
        <mcp:streamable-http-client-connection serverUrl="http://localhost:18213" mcpEndpointPath="/m"/>
    </mcp:client-config>
    <mcp:client-config name="CliDown" clientName="mulay-test" clientVersion="9.9">
        <mcp:streamable-http-client-connection serverUrl="http://localhost:18299" mcpEndpointPath="/mcp"/>
    </mcp:client-config>
    <mcp:client-config name="CliBad" clientName="mulay-test" clientVersion="9.9">
        <mcp:streamable-http-client-connection serverUrl="http://localhost:18213" mcpEndpointPath="/nothere"/>
    </mcp:client-config>
    <mcp:client-config name="CliH" clientName="mulay-test" clientVersion="9.9">
        <mcp:streamable-http-client-connection serverUrl="http://localhost:18213" mcpEndpointPath="/m">
            <mcp:default-request-headers>
                <mcp:default-request-header key="X-Trace" value="abc"/>
            </mcp:default-request-headers>
        </mcp:streamable-http-client-connection>
    </mcp:client-config>

    <flow name="tool-add">
        <mcp:tool-listener config-ref="SrvC" name="add">
            <mcp:description>Adds two numbers</mcp:description>
            <mcp:parameters-schema><![CDATA[{"type":"object","properties":{"a":{"type":"number"},"b":{"type":"number"}},"required":["a","b"]}]]></mcp:parameters-schema>
            <mcp:responses><mcp:text-tool-response-content text="#[(payload.a + payload.b) as String]"/></mcp:responses>
        </mcp:tool-listener>
        <logger level="INFO" message="add"/>
    </flow>

    <flow name="tool-echo">
        <mcp:tool-listener config-ref="SrvM" name="echo">
            <mcp:description>Echo</mcp:description>
            <mcp:parameters-schema><![CDATA[{"type":"object"}]]></mcp:parameters-schema>
            <mcp:responses><mcp:text-tool-response-content text="#[write(payload, 'text/plain')]"/></mcp:responses>
        </mcp:tool-listener>
        <logger level="INFO" message="echo"/>
    </flow>

    <flow name="tool-multi">
        <mcp:tool-listener config-ref="SrvM" name="multi">
            <mcp:description>Several contents</mcp:description>
            <mcp:parameters-schema><![CDATA[{"type":"object"}]]></mcp:parameters-schema>
            <mcp:responses><mcp:text-tool-response-content text="one"/><mcp:image-tool-response-content data="aGk=" mimeType="image/png"/><mcp:text-resource-tool-response-content uri="mule://r" mimeType="text/plain" text="res"/><mcp:blob-resource-tool-response-content uri="mule://b" mimeType="application/octet-stream" blob="blobby"/></mcp:responses>
        </mcp:tool-listener>
        <logger level="INFO" message="multi"/>
    </flow>

    <flow name="tool-fail">
        <mcp:tool-listener config-ref="SrvM" name="fail">
            <mcp:description>Fails</mcp:description>
            <mcp:parameters-schema><![CDATA[{"type":"object"}]]></mcp:parameters-schema>
            <mcp:responses><mcp:text-tool-response-content text="unreachable"/></mcp:responses>
        </mcp:tool-listener>
        <raise-error type="APP:BOOM" description="tool boom"/>
        <logger level="INFO" message="fail"/>
    </flow>

    <flow name="tool-hdrs">
        <mcp:tool-listener config-ref="SrvM" name="hdrs">
            <mcp:description>Request headers</mcp:description>
            <mcp:parameters-schema><![CDATA[{"type":"object"}]]></mcp:parameters-schema>
            <mcp:responses><mcp:text-tool-response-content text="#[write({contentType: attributes.additionalProperties.'content-type', accept: attributes.additionalProperties.accept, version: attributes.additionalProperties.'mcp-protocol-version', agent: attributes.additionalProperties.'user-agent', trace: attributes.additionalProperties.'x-trace', sid: attributes.sessionId}, 'application/json')]"/></mcp:responses>
        </mcp:tool-listener>
        <logger level="INFO" message="hdrs"/>
    </flow>

    <flow name="tool-j-obj">
        <mcp:tool-listener config-ref="SrvM" name="j-obj">
            <mcp:description>d</mcp:description>
            <mcp:parameters-schema><![CDATA[{"type":"object"}]]></mcp:parameters-schema>
            <mcp:responses><mcp:text-tool-response-content text="{&quot;k&quot;:1}"/></mcp:responses>
        </mcp:tool-listener>
        <logger level="INFO" message="j-obj"/>
    </flow>

    <flow name="tool-j-arr">
        <mcp:tool-listener config-ref="SrvM" name="j-arr">
