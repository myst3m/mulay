%%% note
APIkit の console (apikit:console)。/console は vars.httpStatus=301 と vars.outboundHeaders.location (listener の応答の設定が無い /rconsole は 200)、
/console/ と index.html は HTML (expires: -1。本文は mulay の自前なので mask で隠す)、/api/<ファイル> は仕様の根と参照先のファイルそのまま、
それ以外は APIKIT:NOT_FOUND (description は相対パス)。?amf・package/build の資源・/api/ (AMF が書き直した仕様) は再現しない (docs/compat/deviations.md)。
%%% port 18566
%%% mask
(?s)(<!doctype html>.*</html>)
%%% request GET /console headers=*
%%% response 301
location: http://localhost:18566/console/


%%% request GET /console/ headers=*
%%% response 200
expires: -1
content-type: text/html

***

%%% request GET /console/index.html headers=*
%%% response 200
expires: -1
content-type: text/html

***

%%% request GET /console/?raml headers=*
%%% response 200
expires: -1
content-type: text/html

***

%%% request GET /console/api/shop.yaml headers=*
%%% response 200
content-type: application/raml+yaml

openapi: 3.0.0
info:
  title: shop
  version: "1"
paths:
  /items:
    get:
      responses:
        "200":
          description: ok
          content:
            application/json:
              example: [{name: pen}]
    post:
      requestBody:
        content:
          application/json:
            schema: {type: object}
      responses:
        "201":
          description: made
  /items/{id}:
    delete:
      parameters:
        - {name: id, in: path, required: true, schema: {type: string}}
      responses:
        "204":
          description: gone

%%% request GET /console/shop.yaml headers=*
%%% response 404

{"message": "Resource not found"}
%%% request GET /console/nothing.js headers=*
%%% response 404

{"message": "Resource not found"}
%%% request GET /console/api/types/dims.raml headers=*
%%% response 404

{"message": "Resource not found"}
%%% request GET /rconsole headers=*
%%% response 200


%%% request GET /rconsole/ headers=*
%%% response 200
content-type: text/html

***

%%% request GET /rconsole/api/shop.raml headers=*
%%% response 200
content-type: application/raml+yaml

#%RAML 1.0
title: Shop RAML
version: v1
mediaType: application/json
types:
  Dims: !include types/dims.raml
  NewItem:
    type: object
    properties:
      name:
        type: string
        minLength: 1
      price: number
      qty?:
        type: integer
        minimum: 0
      tags:
        type: array
        maxItems: 2
        items: string
        required: false
      dims?: Dims
      kind:
        enum: [a, b]
        required: false
      when?: date-only
      at?: datetime
      email?:
        type: string
        pattern: ^[^@]+@[^@]+$
traits:
  paged:
    queryParameters:
      limit:
        type: integer
        minimum: 1
        maximum: 50
        default: 10
resourceTypes:
  collection:
    get:
      responses:
        200:
          body:
            application/json:
              type: array
/items:
  type: collection
  get:
    is: [paged]
    headers:
      X-Tenant:
        type: string
    queryParameters:
      sort:
        enum: [asc, desc]
        required: false
      active:
        type: boolean
        required: false
      tag:
        type: array
        items: string
        required: false
  post:
    body:
      application/json:
        type: NewItem
      application/xml:
    responses:
      201:
        body:
          application/json:
  /{id}:
    uriParameters:
      id:
        type: integer
    get:
      responses:
        200:
          body:
            application/json:
            application/xml:
    put:
      body:
        application/json:
          type: !include schemas/put.json
      responses:
        204:
    delete:
    /tags/{tag}:
      get:
/forms:
  post:
    body:
      application/x-www-form-urlencoded:
        properties:
          a: string
          b?: integer
/plain:
  post:
    body:
      text/plain:
/nobody:
  get:
    queryParameters:
      q:
        type: string
        required: true
    responses:
      202:

%%% request GET /rconsole/api/types/dims.raml headers=*
%%% response 200
content-type: application/raml+yaml

#%RAML 1.0 DataType
type: object
properties:
  w: number
  h?: number

