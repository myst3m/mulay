content-type: application/json; charset=UTF-8

[
  {
    "id": "f1",
    "group": "grp-a",
    "body": "body of f1",
    "n": 1,
    "keys": [
      "lockId",
      "messageGroupId",
      "created",
      "messageId",
      "ttl",
      "deliveryCount"
