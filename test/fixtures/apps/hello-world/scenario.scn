%%% note
mulet samples/hello-world。listener の path 照合 (/hello と /hello/{name})、uriParams、
transform の JSON 出力 (now() は mask で伏せる)、logger。存在しない path と
allowedMethods 外ではなく未定義 path の既定応答も確かめる。
%%% port 18101
%%% mask
"timestamp": "([^"]*)"
%%% request GET /hello log
%%% response 200
content-type: application/json; charset=UTF-8

{
  "message": "Hello, World!",
  "timestamp": "***"
}
%%% log
INFO org.mule.runtime.core.internal.processor.LoggerMessageProcessor: Hello World request processed
%%% request GET /hello/Mule
%%% response 200
content-type: application/json; charset=UTF-8

{
  "message": "Hello, Mule!",
  "timestamp": "***"
}
%%% request GET /hello/%E3%83%9F%E3%83%A5%E3%83%BC%E3%83%AB
%%% response 200
content-type: application/json; charset=UTF-8

{
  "message": "Hello, ミュール!",
  "timestamp": "***"
}
%%% request GET /hello/a/b
%%% response 404
content-type: text/plain

No listener for endpoint: /hello/a/b
%%% request GET /nothing-here
%%% response 404
content-type: text/plain

No listener for endpoint: /nothing-here
%%% request POST /hello
Content-Type: application/json

{"x": 1}
%%% response 200
content-type: application/json; charset=UTF-8

{
  "message": "Hello, World!",
  "timestamp": "***"
}
