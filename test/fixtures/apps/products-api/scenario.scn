%%% note
mulet samples/products-api。APIKit (OAS 3.0) の router: GET/POST の振り分け、uriParams、
queryParams、リクエストボディの検証 (required、型) と APIKIT:BAD_REQUEST / NOT_FOUND /
METHOD_NOT_ALLOWED / NOT_ACCEPTABLE / UNSUPPORTED_MEDIA_TYPE、on-error-propagate が
ボディを作り、Studio の scaffold と同じ http:response / http:error-response (vars.httpStatus、
vars.outboundHeaders) で返す (sample に足した)。POST の id は random() なので mask で伏せる。
%%% port 18103
%%% request GET /api/products
%%% response 200
content-type: application/json; charset=UTF-8

[
  {
    "id": "P001",
    "name": "Laptop",
    "price": 1200,
    "category": "electronics",
    "stock": 50
  },
  {
    "id": "P002",
    "name": "T-Shirt",
    "price": 25,
    "category": "clothing",
    "stock": 200
  },
  {
    "id": "P003",
    "name": "Apple",
    "price": 1.5,
    "category": "food",
    "stock": 500
  }
]
%%% request GET /api/products?category=food
%%% response 200
content-type: application/json; charset=UTF-8

[
  {
    "id": "P003",
    "name": "Apple",
    "price": 1.5,
    "category": "food",
    "stock": 500
  }
]
%%% request GET /api/products?category=none
%%% response 200
content-type: application/json; charset=UTF-8

[
  
]
%%% request GET /api/products/P002
%%% response 200
content-type: application/json; charset=UTF-8

{
  "id": "P002",
  "name": "T-Shirt",
  "price": 25,
  "category": "clothing",
  "stock": 200
}
%%% request GET /api/products/P999
%%% response 200
content-type: application/json; charset=UTF-8

null
%%% request GET /api/nothing
%%% response 404
content-type: application/json; charset=UTF-8

{
  "error": "Not Found",
  "message": "/nothing"
}
%%% request DELETE /api/products
%%% response 405
content-type: application/json; charset=UTF-8

{
  "error": "Method Not Allowed",
  "message": "HTTP Method delete not allowed for : /products"
}
%%% request PUT /api/products/P001
Content-Type: application/json

{}
%%% response 405
content-type: application/json; charset=UTF-8

{
  "error": "Method Not Allowed",
  "message": "HTTP Method put not allowed for : /products/{productId}"
}
%%% request POST /api/products
Content-Type: application/json

{"name": "x"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "error": "Bad Request",
  "message": "required key [price] not found"
}
%%% request POST /api/products
Content-Type: application/json

{"name": "x", "price": "cheap"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "error": "Bad Request",
  "message": "/price expected type: Number, found: String"
}
%%% request POST /api/products
Content-Type: application/json

not json
%%% response 400
content-type: application/json; charset=UTF-8

{
  "error": "Bad Request",
  "message": "expected type: JSONObject, found: String  Location:   Position: Line 1,  Column 0"
}
%%% request POST /api/products
Content-Type: text/plain

{"name": "x", "price": 1}
%%% response 500
content-type: text/plain; charset=UTF-8

{"name": "x", "price": 1}
%%% request GET /api/products
Accept: application/xml
%%% response 500


%%% mask
"id": "(P[0-9]*)"
%%% request POST /api/products
Content-Type: application/json

{"name": "Pen", "price": 2.5}
%%% response 201
content-type: application/json; charset=UTF-8

{
  "id": "***",
  "name": "Pen",
  "price": 2.5,
  "category": "electronics",
  "stock": 0
}
%%% request POST /api/products
Content-Type: application/json

{"name": "Desk", "price": 300, "category": "furniture", "stock": 4}
%%% response 201
content-type: application/json; charset=UTF-8

{
  "id": "***",
  "name": "Desk",
  "price": 300,
  "category": "furniture",
  "stock": 4
}
