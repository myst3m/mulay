%%% note
A2A コネクタ 1.1.1 のプッシュ通知。push-notification-config-listener (設定を受けるか決め、on-config-accepted の
ヘッダを足す)、message/send の configuration.pushNotificationConfig (すぐ 202 で submitted の Task を返し、フローの結果を
通知の URL に POST する)、tasks/pushNotificationConfig/set・get・list・delete、send-push-notification。
@TID@ / @CID@ は前に Task を返した応答の ID、@PID@ は前に返した通知の設定の ID。
%%% jvm -Dmulay.a2a.allowPrivatePushUrls=true
%%% port 18164
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":101,"method":"message/send","params":{"message":{"kind":"message","role":"user","messageId":"u","parts":[{"kind":"text","text":"work"}]},"configuration":{"pushNotificationConfig":{"url":"http://localhost:18164/hook/a","token":"tk","id":"mine"}}}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 202,
  "body": "{\"jsonrpc\":\"2.0\",\"id\":101,\"result\":{\"id\":\"<tid>\",\"contextId\":\"<cid>\",\"status\":{\"state\":\"submitted\",\"timestamp\":\"<ts>\"},\"artifacts\":[],\"history\":[],\"kind\":\"task\"}}"
}
%%% request GET /t/hooks?n=1
%%% response 200
content-type: application/json; charset=UTF-8

[
  {
    "hook": "a",
    "method": "POST",
    "ctype": "application/json",
    "token": "tk",
    "extra": null,
    "body": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 101,\n  \"result\": {\n    \"id\": \"<tid>\",\n    \"contextId\": \"<cid>\",\n    \"status\": {\n      \"state\": \"working\",\n      \"timestamp\": \"<ts>\"\n    },\n    \"artifacts\": [\n      \n    ],\n    \"history\": [\n      \n    ],\n    \"kind\": \"task\"\n  }\n}"
  }
]
%%% request GET /t/last-pushcfg
%%% response 200
content-type: application/json; charset=UTF-8

{
  "payload": "{\n  \"message\": {\n    \"role\": \"user\",\n    \"parts\": [\n      {\n        \"text\": \"work\",\n        \"kind\": \"text\"\n      }\n    ],\n    \"messageId\": \"u\",\n    \"kind\": \"message\"\n  },\n  \"configuration\": {\n    \"pushNotificationConfig\": {\n      \"url\": \"http://localhost:18164/hook/a\",\n      \"token\": \"tk\",\n      \"id\": \"mine\"\n    }\n  }\n}",
  "mime": "application/json",
  "rpc": "message/send"
}
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":102,"method":"tasks/pushNotificationConfig/list","params":{"id":"@TID@"}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "body": "{\"jsonrpc\":\"2.0\",\"id\":102,\"result\":[]}"
}
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":103,"method":"tasks/pushNotificationConfig/set","params":{"taskId":"@TID@","pushNotificationConfig":{"url":"http://localhost:18164/hook/b","token":"t2"}}}

%%% response 200
content-type: application/json; charset=UTF-8

{
  "status": 200,
  "body": "{\"jsonrpc\":\"2.0\",\"id\":103,\"result\":{\"taskId\":\"<tid>\",\"pushNotificationConfig\":{\"url\":\"http://localhost:18164/hook/b\",\"token\":\"t2\",\"id\":\"<pid>\"}}}"
}
