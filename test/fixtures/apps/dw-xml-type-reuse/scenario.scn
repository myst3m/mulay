%%% note
DataWeave の型の再利用 xmlschema!: import * from xmlschema!schemas::Order は src/main/resources の schemas/Order.xsd を読み、
大域の要素 (xElementDefinition)、名前の付いた型 (XDefinition)、Root の型にする。名前空間・属性・列挙・出現の回数も確かめる。
別のプロジェクトからの依頼 (2026-11-02)。
%%% port 18589
%%% request POST /order
content-type: application/xml

<o:order xmlns:o="http://example.com/order" status="NEW"><o:id>1</o:id><o:item><o:name>a</o:name><o:qty>2</o:qty></o:item><o:item><o:name>b</o:name><o:qty>3</o:qty></o:item></o:order>
%%% response 200
content-type: application/json; charset=UTF-8

{
  "root": false,
  "element": false,
  "items": [
    false,
    false
  ],
  "typed": true
}
%%% request POST /order
content-type: application/xml

<o:order xmlns:o="http://example.com/order" status="BAD"><o:id>1</o:id><o:item><o:name>a</o:name><o:qty>2</o:qty></o:item></o:order>
%%% response 200
content-type: application/json; charset=UTF-8

{
  "root": false,
  "element": false,
  "items": [
    false
  ],
  "typed": false
}
