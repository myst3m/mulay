%%% request POST /person
content-type: application/xml

<person id="7"><name>n</name><phone>1</phone><addr zip="1"/><note>x</note><price currency="JPY">10</price><born>2020-01-01</born><at>2020-01-01T00:00:00Z</at><ok>true</ok><code>ABC</code><nums>1 2</nums><u>1</u><any><z/></any><emp><b>b</b><e>1</e></emp></person>
%%% response 200
content-type: application/json; charset=UTF-8

{
  "root": false,
  "person": false,
  "note": false
}
