<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:main" xmlns="urn:main" xmlns:c="urn:common" elementFormDefault="qualified">
  <xs:import namespace="urn:common" schemaLocation="common/Types.xsd"/>
  <xs:include schemaLocation="Part.xsd"/>
  <xs:element name="invoice">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="total" type="c:Money"/>
        <xs:element ref="c:header"/>
        <xs:element name="line" type="Line" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
