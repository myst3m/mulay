<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="person">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="name" type="xs:string"/>
        <xs:element name="age" type="xs:int" minOccurs="0"/>
        <xs:element name="tag" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="phone" type="xs:string" minOccurs="1" maxOccurs="3"/>
        <xs:element name="addr">
          <xs:complexType>
            <xs:attribute name="zip" type="xs:string" use="required"/>
            <xs:attribute name="kind" type="xs:string" fixed="home"/>
          </xs:complexType>
        </xs:element>
        <xs:element ref="note"/>
        <xs:element name="price" type="PriceType"/>
        <xs:element name="born" type="xs:date"/>
        <xs:element name="at" type="xs:dateTime"/>
        <xs:element name="ok" type="xs:boolean" nillable="true"/>
        <xs:element name="code" type="CodeType"/>
        <xs:element name="nums" type="NumList"/>
        <xs:element name="u" type="UnionType"/>
        <xs:element name="any"><xs:complexType><xs:sequence><xs:any/></xs:sequence></xs:complexType></xs:element>
        <xs:element name="emp" type="Employee"/>
      </xs:sequence>
      <xs:attribute name="id" type="xs:long"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="note" type="xs:string"/>
  <xs:complexType name="PriceType">
    <xs:simpleContent>
      <xs:extension base="xs:decimal">
        <xs:attribute name="currency" type="xs:string" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="CodeType">
    <xs:restriction base="xs:string"><xs:pattern value="[A-Z]{3}"/><xs:maxLength value="3"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="NumList"><xs:list itemType="xs:int"/></xs:simpleType>
  <xs:simpleType name="UnionType"><xs:union memberTypes="xs:int CodeType"/></xs:simpleType>
  <xs:complexType name="Base">
    <xs:sequence><xs:element name="b" type="xs:string"/></xs:sequence>
    <xs:attribute name="ba" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="Employee">
    <xs:complexContent>
      <xs:extension base="Base">
        <xs:sequence><xs:element name="e" type="xs:int"/></xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="mixedThing" mixed="true">
    <xs:all><xs:element name="x" type="xs:string"/><xs:element name="y" type="xs:string" minOccurs="0"/></xs:all>
  </xs:complexType>
  <xs:complexType name="pick">
    <xs:choice maxOccurs="unbounded"><xs:element name="p" type="xs:string"/><xs:element name="q" type="xs:int"/></xs:choice>
  </xs:complexType>
</xs:schema>
