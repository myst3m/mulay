%%% note
file:rename の to が . か .. (overwrite="true") のとき。実 Mule 4.11.3 (file 1.5.6) は to の先 (元のディレクトリかその親) を
消してから MULE:UNKNOWN になり、作業ディレクトリの中身まで消える (2026-10-25 に実 Mule で確かめた)。mulay は消す前に
FILE:ILLEGAL_PATH で拒む (docs/compat/deviations.md)。
%%% oracle mulay
%%% port 18573
%%% request POST /setup
%%% response 200

ok
%%% request POST /rename?to=..
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "FILE:ILLEGAL_PATH",
  "description": "'to' parameter of rename operation should not be '.' or '..' but '..' was received"
}
%%% request POST /rename?to=.
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "FILE:ILLEGAL_PATH",
  "description": "'to' parameter of rename operation should not be '.' or '..' but '.' was received"
}
%%% request GET /names
%%% response 200
content-type: application/json; charset=UTF-8

[
  "/tmp/mulay-oracle-file-rename-dots/important.txt",
  "/tmp/mulay-oracle-file-rename-dots/inbox",
  "/tmp/mulay-oracle-file-rename-dots/inbox/x.txt"
]
