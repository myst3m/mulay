                </on-error-continue>
            </error-handler>
        </try>
    </flow>
    <http:request-config name="RH7">
        <http:request-connection host="localhost" port="18410">
            <http:proxy-config><http:proxy host="localhost" port="18411" nonProxyHosts="*"/></http:proxy-config>
        </http:request-connection>
    </http:request-config>
    <flow name="h7">
        <http:listener config-ref="L" path="/h7"/>
