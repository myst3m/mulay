                </on-error-continue>
            </error-handler>
        </try>
    </flow>
    <http:request-config name="RH6">
        <http:request-connection host="127.0.0.1" port="18410">
            <http:proxy-config><http:proxy host="localhost" port="18411" nonProxyHosts="127.*"/></http:proxy-config>
        </http:request-connection>
    </http:request-config>
    <flow name="h6">
