        </try>
    </flow>
    <http:request-config name="RH5">
        <http:request-connection host="localhost" port="18410">
            <http:proxy-config><http:proxy host="localhost" port="18411" nonProxyHosts="LOCALHOST"/></http:proxy-config>
        </http:request-connection>
    </http:request-config>
    <flow name="h5">
        <http:listener config-ref="L" path="/h5"/>
        <try>
            <http:request config-ref="RH5" method="GET" path="/direct" responseTimeout="3000"/>
