                </on-error-continue>
            </error-handler>
        </try>
    </flow>
    <http:request-config name="RH4">
        <http:request-connection host="localhost" port="18410">
            <http:proxy-config><http:proxy host="localhost" port="18411" nonProxyHosts="*host"/></http:proxy-config>
        </http:request-connection>
    </http:request-config>
    <flow name="h4">
        <http:listener config-ref="L" path="/h4"/>
