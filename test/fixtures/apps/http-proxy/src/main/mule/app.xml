<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <http:listener-config name="L"><http:listener-connection host="0.0.0.0" port="18410"/></http:listener-config>
    <!-- 偽の proxy: 受けた要求の形をそのまま返す -->
    <http:listener-config name="P"><http:listener-connection host="0.0.0.0" port="18411"/></http:listener-config>

    <!-- 書き方 1: request-connection の中の proxy-config -->
    <http:request-config name="RA">
        <http:request-connection host="target.example" port="8080">
            <http:proxy-config><http:proxy host="localhost" port="18411"/></http:proxy-config>
        </http:request-connection>
    </http:request-config>
    <!-- 書き方 2: 名前を付けた proxy を proxyConfig で指す。利用者と合言葉つき -->
    <http:proxy name="PX" host="localhost" port="18411" username="u" password="p"/>
    <http:request-config name="RB">
        <http:request-connection host="target.example" port="8080" proxyConfig="PX"/>
    </http:request-config>
    <!-- nonProxyHosts -->
    <http:request-config name="RC">
        <http:request-connection host="localhost" port="18410">
            <http:proxy-config><http:proxy host="localhost" port="18411" nonProxyHosts="localhost"/></http:proxy-config>
        </http:request-connection>
    </http:request-config>

    <flow name="proxy">
        <http:listener config-ref="P" path="/*"/>
        <set-payload value="#[output application/json --- {method: attributes.method, requestUri: attributes.requestUri replace /^http:\/\/[^\/]+/ with '', host: attributes.headers.host default null, proxyAuth: attributes.headers.'proxy-authorization' default null, via: 'proxy'}]"/>
    </flow>
    <flow name="direct">
        <http:listener config-ref="L" path="/direct"/>
        <set-payload value="direct"/>
    </flow>

    <flow name="via-a">
        <http:listener config-ref="L" path="/via-a"/>
        <http:request config-ref="RA" method="GET" path="/a/b">
            <http:query-params>#[{q: '1'}]</http:query-params>
        </http:request>
    </flow>
    <flow name="via-b">
        <http:listener config-ref="L" path="/via-b"/>
        <http:request config-ref="RB" method="POST" path="/c"/>
    </flow>
    <flow name="bypass">
        <http:listener config-ref="L" path="/bypass"/>
        <http:request config-ref="RC" method="GET" path="/direct"/>
    </flow>
    <http:request-config name="RH1">
        <http:request-connection host="foo.example.com" port="18410">
            <http:proxy-config><http:proxy host="localhost" port="18411" nonProxyHosts="*.example.com"/></http:proxy-config>
        </http:request-connection>
    </http:request-config>
    <flow name="h1">
        <http:listener config-ref="L" path="/h1"/>
        <try>
            <http:request config-ref="RH1" method="GET" path="/direct" responseTimeout="3000"/>
            <error-handler>
                <on-error-continue>
                    <set-payload value="#[output application/json --- {'type': (error.errorType.namespace ++ ':' ++ error.errorType.identifier), description: error.description}]"/>
                </on-error-continue>
            </error-handler>
        </try>
    </flow>
    <http:request-config name="RH2">
        <http:request-connection host="foo.example.com" port="18410">
            <http:proxy-config><http:proxy host="localhost" port="18411" nonProxyHosts="foo.*"/></http:proxy-config>
        </http:request-connection>
    </http:request-config>
    <flow name="h2">
        <http:listener config-ref="L" path="/h2"/>
        <try>
            <http:request config-ref="RH2" method="GET" path="/direct" responseTimeout="3000"/>
            <error-handler>
