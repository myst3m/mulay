%%% note
SFTP コネクタ (2.7.3) の sftp:listener。サーバーは sftp-ops と同じテスト用の atmoz/sftp (127.0.0.1:2222、/upload)。
見る場所は /upload/li/in〜in5 (sftpdir で起動前に作り直す)。listener は 300ms ごと。
l1: matcher の参照 + moveToDirectory、payload と属性 (SftpFileAttributes)。l2: autoDelete + outputMimeType、下のディレクトリ。
l3: inline の matcher + moveToDirectory + renameTo、拡張子からの mime。l4: 後処理なしで watermarkEnabled (二度読まない)。
l5: recursive=false、フローが失敗しても後処理 (移動) はする。
l6: knownHostsFile (クラスパスの資源) のある接続。
l7: applyPostActionWhenFailed=false (失敗したファイルは残る)。l8・l9: matcher の timestampUntil / timestampSince。
l0: 起動の時点でディレクトリ (li/never) が無い listener は止まり、後でディレクトリができても読まない。
%%% port 18193
%%% sftpdir sftp://mulay:mulay@127.0.0.1:2222 /upload/li /upload/li/in /upload/li/in2 /upload/li/in3 /upload/li/in4 /upload/li/in5 /upload/li/in6 /upload/li/in7 /upload/li/in8 /upload/li/in9 /upload/li/seen /upload/li/seen2 /upload/li/seen3 /upload/li/seen4 /upload/li/seen5
%%% request POST /drop?path=in/a.txt
Content-Type: text/plain

alpha
%%% response 200

dropped
%%% request POST /drop?path=in/skip.csv
Content-Type: text/plain

x,y
%%% response 200

dropped
%%% request POST /drop?path=in2/one.json
Content-Type: application/json

{"n": 1}
%%% response 200

dropped
%%% request POST /drop?path=in2/sub/two.json
Content-Type: application/json

{"n": [2]}
%%% response 200

dropped
%%% request POST /drop?path=in3/r.csv
Content-Type: text/plain

h1,h2
1,2
%%% response 200

dropped
%%% request POST /drop?path=in4/w1.txt
Content-Type: text/plain

w1
%%% response 200

dropped
%%% request POST /drop?path=in5/ok.txt
Content-Type: text/plain

ok
%%% response 200

dropped
%%% request POST /drop?path=in5/bad.txt
Content-Type: text/plain

bad
%%% response 200

dropped
%%% request POST /drop?path=in5/sub/deep.txt
Content-Type: text/plain

deep
%%% response 200

dropped
%%% request POST /drop?path=in6/k.txt
Content-Type: text/plain

kh
%%% response 200

dropped
%%% request POST /drop?path=in7/ok.txt
Content-Type: text/plain

ok
%%% response 200

dropped
%%% request POST /drop?path=in7/bad.txt
Content-Type: text/plain

bad
%%% response 200

dropped
%%% request POST /drop?path=in8/t.txt
Content-Type: text/plain

t
%%% response 200

dropped
%%% request POST /drop?path=in9/t.txt
Content-Type: text/plain

t
%%% response 200

dropped
%%% request POST /drop?path=never/n.txt
Content-Type: text/plain

never
%%% response 200

dropped
%%% wait 3000
%%% request GET /names
%%% response 200
content-type: application/json; charset=UTF-8

[
  "done/",
  "done/a.txt",
  "done3/",
  "done3/moved.csv",
  "done5/",
  "done5/bad.txt",
  "done5/ok.txt",
  "done7/",
  "done7/ok.txt",
  "in/",
