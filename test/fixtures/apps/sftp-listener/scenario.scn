  "in5/",
  "in5/sub/",
  "in5/sub/deep.txt",
  "in6/",
  "in7/",
  "in7/bad.txt",
  "in8/",
  "in8/t.txt",
  "in9/",
  "never/",
  "never/n.txt",
  "seen/",
  "seen/a.txt.json",
  "seen/kh-k.txt",
  "seen/new-t.txt",
  "seen2/",
  "seen2/one.json",
  "seen2/two.json",
  "seen3/",
  "seen3/r.csv.json",
  "seen4/",
