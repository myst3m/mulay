]
%%% request GET /get?path=seen/a.txt.json
%%% response 200
content-type: text/plain; charset=UTF-8

{
  "mime": "text/plain",
  "attrClass": "org.mule.extension.sftp.api.SftpFileAttributes",
  "fileName": "a.txt",
  "name": "a.txt",
  "path": "/upload/li/in/a.txt",
  "size": 5,
  "directory": false,
  "regularFile": true,
  "tsType": "DateTime",
  "body": "alpha"
}
%%% request GET /get?path=seen2/one.json
%%% response 200
content-type: text/plain; charset=UTF-8

{
  "mime": "application/json",
  "path": "/upload/li/in2/one.json",
  "value": {
    "n": 1
  }
}
%%% request GET /get?path=seen2/two.json
%%% response 200
content-type: text/plain; charset=UTF-8

{
  "mime": "application/json",
  "path": "/upload/li/in2/sub/two.json",
  "value": {
    "n": [
      2
    ]
  }
}
%%% request GET /get?path=seen3/r.csv.json
%%% response 200
