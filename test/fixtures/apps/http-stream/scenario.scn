%%% note
http:listener の responseStreamingMode (AUTO / ALWAYS / NEVER) と http:request の streamResponse: 応答が chunked か Content-Length かを、文字列・JSON・上流の応答の中継で確かめる (framing=1)。
%%% port 18400
%%% request GET /s-auto headers=* framing=1
%%% response 200
content-length: 15

hello streaming
%%% request GET /s-always headers=* framing=1
%%% response 200
transfer-encoding: chunked

hello streaming
%%% request GET /s-never headers=* framing=1
%%% response 200
content-length: 15

hello streaming
%%% request GET /j-auto headers=* framing=1
%%% response 200
content-type: application/json; charset=UTF-8
transfer-encoding: chunked

{
  "a": 1,
  "b": [
    1,
    2,
    3
  ]
}
%%% request GET /j-always headers=* framing=1
%%% response 200
content-type: application/json; charset=UTF-8
transfer-encoding: chunked

{
  "a": 1,
  "b": [
    1,
    2,
    3
  ]
}
%%% request GET /j-never headers=* framing=1
%%% response 200
content-type: application/json; charset=UTF-8
content-length: 46

{
  "a": 1,
  "b": [
    1,
    2,
    3
  ]
}
%%% request GET /u-auto headers=* framing=1
%%% response 200
content-type: text/plain; charset=UTF-8
content-length: 2591

