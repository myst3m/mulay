    "dir": true,
    "payloadType": "String"
  },
  {
    "path": "/upload/t/sub/c.txt",
    "size": 5,
    "dir": false,
    "payloadType": "String"
  }
]
%%% request GET /list?dir=t/missing
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "SFTP:ILLEGAL_PATH",
  "description": "Path '/upload/t/missing' doesn't exist"
}
%%% request GET /list?dir=t/a.json
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "SFTP:ILLEGAL_PATH",
  "description": "Cannot list path '/upload/t/a.json' because it's a file. Only directories can be listed"
}
%%% request GET /write?path=t/w.txt&text=hello
%%% response 200
content-type: application/json; charset=UTF-8

{
  "text": "hello",
  "after": ""
}
%%% request GET /write?path=t/w.txt&text=-more&mode=APPEND
%%% response 200
content-type: application/json; charset=UTF-8

{
  "text": "hello-more",
  "after": ""
}
%%% request GET /write?path=t/w.txt&text=again&mode=CREATE_NEW
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "SFTP:FILE_ALREADY_EXISTS",
  "description": "Cannot write to path '/upload/t/w.txt' because it already exists and write mode 'CREATE_NEW' was selected. Use a different write mode or point to a path which doesn't exist"
}
%%% request GET /write?path=t/deep/x/y.txt&text=deep
%%% response 200
content-type: application/json; charset=UTF-8

{
  "text": "deep",
  "after": ""
}
%%% request GET /write?path=t/nodir/z.txt&text=z&parents=false
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "SFTP:ILLEGAL_PATH",
  "description": "Cannot write to file '/upload/t/nodir/z.txt' because path to it doesn't exist. Consider setting the 'createParentDirectories' attribute to 'true'"
}
%%% request GET /copy?src=t/a.json&dst=t/cp
%%% response 200
content-type: application/json; charset=UTF-8

[
  "/upload/t/a.json",
  "/upload/t/b.csv",
  "/upload/t/cp",
  "/upload/t/cp/a.json",
  "/upload/t/deep",
  "/upload/t/deep/x",
  "/upload/t/deep/x/y.txt",
  "/upload/t/sub",
  "/upload/t/sub/c.txt",
  "/upload/t/w.txt"
]
%%% request GET /copy?src=t/a.json&dst=t/cp
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "SFTP:FILE_ALREADY_EXISTS",
  "description": "'/upload/t/cp/a.json' already exists. Set the 'overwrite' parameter to 'true' to perform the operation anyway"
}
%%% request GET /copy?src=t/a.json&dst=t/cp&over=true
%%% response 200
content-type: application/json; charset=UTF-8

[
  "/upload/t/a.json",
  "/upload/t/b.csv",
  "/upload/t/cp",
  "/upload/t/cp/a.json",
  "/upload/t/deep",
  "/upload/t/deep/x",
  "/upload/t/deep/x/y.txt",
  "/upload/t/sub",
  "/upload/t/sub/c.txt",
  "/upload/t/w.txt"
]
