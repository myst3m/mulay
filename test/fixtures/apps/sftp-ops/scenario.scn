}
%%% request GET /bad-pass
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "SFTP:INVALID_CREDENTIALS",
  "description": "Could not establish SFTP connection with host: 'localhost' at port: '2222' - No more authentication methods available"
}
%%% request GET /no-server
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "SFTP:CANNOT_REACH",
  "description": "Could not establish SFTP connection with host: 'localhost' at port: '2299' - DefaultConnectFuture[mulay@localhost/127.0.0.1:2299]: Failed (ConnectException) to execute: Connection refused"
}
