%%% request GET /read?path=t/missing.txt
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "SFTP:ILLEGAL_PATH",
  "description": "Path '/upload/t/missing.txt' doesn't exist"
}
%%% request GET /read?path=t
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "SFTP:ILLEGAL_PATH",
  "description": "Cannot read path '/upload/t' since it's a directory"
}
%%% request GET /read-value
%%% response 200
content-type: application/json; charset=UTF-8

{
  "b": [
    true,
    null
  ],
  "a": 2
}
%%% request GET /list
%%% response 200
content-type: application/json; charset=UTF-8

[
  {
    "path": "/upload/t/a.json",
    "size": 27,
    "dir": false,
    "payloadType": "String"
  },
  {
    "path": "/upload/t/b.csv",
    "size": 9,
    "dir": false,
    "payloadType": "String"
  },
  {
    "path": "/upload/t/sub",
    "size": 4096,
    "dir": true,
    "payloadType": "String"
  }
]
%%% request GET /list?rec=true
%%% response 200
content-type: application/json; charset=UTF-8

[
  {
    "path": "/upload/t/a.json",
    "size": 27,
    "dir": false,
    "payloadType": "String"
  },
  {
    "path": "/upload/t/b.csv",
    "size": 9,
    "dir": false,
    "payloadType": "String"
  },
  {
    "path": "/upload/t/sub",
