%%% note
SFTP コネクタ (mule-sftp-connector 2.7.3)。サーバーは docker の atmoz/sftp (127.0.0.1:2222、利用者 mulay、chroot の /upload)。
read の mime と属性 (SftpFileAttributes)、list、write の mode、copy / move / rename / delete / create-directory と失敗の型・説明、
認証の失敗、つながらないとき。
%%% port 18192
%%% request GET /reset
%%% response 200

ok
%%% request GET /read?path=t/a.json
%%% response 200
content-type: application/json; charset=UTF-8

{
  "text": "{\n  \"a\": 1,\n  \"b\": [\n    true,\n    null\n  ]\n}",
  "mime": "application/json",
  "attrClass": "org.mule.extension.sftp.api.SftpFileAttributes",
  "keys": [
    "fileName",
    "symbolicLink",
    "regularFile",
    "directory",
    "path",
    "size",
    "permissions",
    "name",
    "timestamp"
  ],
  "fileName": "a.json",
  "path": "/upload/t/a.json",
  "size": 27,
  "directory": false,
  "regularFile": true,
  "symbolicLink": false,
  "permissions": 33188,
  "name": "a.json",
  "tsType": "DateTime"
}
%%% request GET /read?path=t/b.csv
%%% response 200
content-type: application/json; charset=UTF-8

{
  "text": "[\n  {\n    \"h1\": \"1\",\n    \"h2\": \"2\"\n  }\n]",
  "mime": "text/csv",
  "attrClass": "org.mule.extension.sftp.api.SftpFileAttributes",
  "keys": [
    "fileName",
    "symbolicLink",
    "regularFile",
    "directory",
    "path",
    "size",
    "permissions",
    "name",
    "timestamp"
  ],
  "fileName": "b.csv",
  "path": "/upload/t/b.csv",
  "size": 9,
  "directory": false,
  "regularFile": true,
  "symbolicLink": false,
  "permissions": 33188,
  "name": "b.csv",
  "tsType": "DateTime"
}
