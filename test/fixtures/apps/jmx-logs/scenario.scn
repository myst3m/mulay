%%% note
jmx (カスタムモジュール com.demo-group:mule-jmx-module 0.1.0、/mnt/tmp/mule-jmx-module): ログの操作
(get-recent-logs、list-log-files、tail-log-file、search-log-file)。ファイルは /tmp/mulay-jmx-logs に
file:write で作る。get-recent-logs は MARK を含む行で絞る (実 Mule のランタイムのログが混ざるため)。
%%% port 18219
%%% mask
"timestamp":"([^"]*)"
"epochMillis":(\d+)
"thread":"([^"]*)"
"lastModified":(\d+)
"bufferSize":(\d+)
%%% request POST /seed
%%% response 200

seeded
%%% request GET /files
%%% response 200
content-type: application/json; charset=UTF-8

{"logDir":"/tmp/mulay-jmx-logs","files":[{"name":"app.log","size":159,"lastModified":***},{"name":"crlf.log","size":4,"lastModified":***},{"name":"empty.log","size":0,"lastModified":***},{"name":"trail.log","size":5,"lastModified":***},{"name":"ws.log","size":9,"lastModified":***},{"name":"日本語.log","size":22,"lastModified":***}]}
%%% request GET /tail?file=app.log&lines=3
%%% response 200
content-type: application/json; charset=UTF-8

{"file":"app.log","lines":3,"content":["2026-01-01 INFO  retry ok","2026-01-01 error again","2026-01-01 INFO  done"]}
%%% request GET /tail-defaults
%%% response 200
content-type: application/json; charset=UTF-8

{"file":"app.log","lines":6,"content":["2026-01-01 INFO  start","2026-01-01 WARN  Disk Almost Full","2026-01-01 ERROR failed to open","2026-01-01 INFO  retry ok","2026-01-01 error again","2026-01-01 INFO  done"]}
%%% request GET /tail?file=app.log&lines=0
%%% response 200
content-type: application/json; charset=UTF-8

{"file":"app.log","lines":0,"content":[]}
%%% request GET /tail?file=app.log&lines=-2
%%% response 200
content-type: application/json; charset=UTF-8

{"file":"app.log","lines":0,"content":[]}
%%% request GET /tail?file=app.log&lines=100
%%% response 200
content-type: application/json; charset=UTF-8

{"file":"app.log","lines":6,"content":["2026-01-01 INFO  start","2026-01-01 WARN  Disk Almost Full","2026-01-01 ERROR failed to open","2026-01-01 INFO  retry ok","2026-01-01 error again","2026-01-01 INFO  done"]}
%%% request GET /tail?file=trail.log&lines=2
%%% response 200
content-type: application/json; charset=UTF-8

{"file":"trail.log","lines":2,"content":["b","c"]}
%%% request GET /tail?file=empty.log
%%% response 200
content-type: application/json; charset=UTF-8

{"file":"empty.log","lines":0,"content":[]}
%%% request GET /tail?file=crlf.log
%%% response 200
content-type: application/json; charset=UTF-8

{"file":"crlf.log","lines":2,"content":["x\r","y"]}
%%% request GET /tail?file=%E6%97%A5%E6%9C%AC%E8%AA%9E.log&lines=1
%%% response 200
content-type: application/json; charset=UTF-8

{"file":"日本語.log","lines":1,"content":["ä¸ç"]}
%%% request GET /tail?file=ws.log
%%% response 200
content-type: application/json; charset=UTF-8

{"file":"ws.log","lines":1,"content":["lead  mid"]}
%%% request GET /tail?file=nothere.log
%%% response 200
content-type: application/json; charset=UTF-8

{"error":"Log file not found: /tmp/mulay-jmx-logs/nothere.log"}
%%% request GET /tail?file=.&lines=1
%%% response 200
content-type: application/json; charset=UTF-8

{"error":"Log file not found: /tmp/mulay-jmx-logs/."}
%%% request GET /tail?lines=1
%%% response 200
content-type: application/java; charset=UTF-8

MULE:UNKNOWN | Required parameter 'fileName' was assigned with value '#[attributes.queryParams.file]' which resolved to null. Required parameters need to be assigned with non null values
%%% request GET /search?file=app.log&pattern=info
%%% response 200
content-type: application/json; charset=UTF-8

{"file":"app.log","pattern":"info","matches":3,"content":["2026-01-01 INFO  start","2026-01-01 INFO  retry ok","2026-01-01 INFO  done"]}
%%% request GET /search-defaults
%%% response 200
content-type: application/json; charset=UTF-8

{"file":"app.log","pattern":"info","matches":3,"content":["2026-01-01 INFO  start","2026-01-01 INFO  retry ok","2026-01-01 INFO  done"]}
%%% request GET /search?file=app.log&pattern=ERROR&lines=1
%%% response 200
content-type: application/json; charset=UTF-8

{"file":"app.log","pattern":"ERROR","matches":1,"content":["2026-01-01 error again"]}
%%% request GET /search?file=app.log&pattern=zzz
%%% response 200
content-type: application/json; charset=UTF-8

{"file":"app.log","pattern":"zzz","matches":0,"content":[]}
%%% request GET /search?file=app.log&pattern=
%%% response 200
content-type: application/json; charset=UTF-8

{"file":"app.log","pattern":"","matches":6,"content":["2026-01-01 INFO  start","2026-01-01 WARN  Disk Almost Full","2026-01-01 ERROR failed to open","2026-01-01 INFO  retry ok","2026-01-01 error again","2026-01-01 INFO  done"]}
%%% request GET /search?file=app.log&pattern=RETRY%20OK
%%% response 200
content-type: application/json; charset=UTF-8

{"file":"app.log","pattern":"RETRY OK","matches":1,"content":["2026-01-01 INFO  retry ok"]}
%%% request GET /search?file=app.log
%%% response 200
content-type: application/java; charset=UTF-8

MULE:UNKNOWN | Required parameter 'pattern' was assigned with value '#[attributes.queryParams.pattern]' which resolved to null. Required parameters need to be assigned with non null values
%%% request GET /search?file=nothere.log&pattern=x
%%% response 200
content-type: application/json; charset=UTF-8

{"error":"Log file not found: /tmp/mulay-jmx-logs/nothere.log"}
%%% request GET /search?file=app.log&pattern=info&lines=0
%%% response 200
content-type: application/json; charset=UTF-8

{"file":"app.log","pattern":"info","matches":0,"content":[]}
%%% request GET /search?file=app.log&pattern=info&lines=-1
%%% response 200
content-type: application/java; charset=UTF-8

MULE:UNKNOWN | fromIndex(2) > toIndex(1)
%%% request GET /mark?m=one
%%% response 200

marked
