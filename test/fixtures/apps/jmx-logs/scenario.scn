%%% response 200
content-type: application/json; charset=UTF-8

{"bufferCapacity":5000,"bufferSize":***,"count":3,"entries":[{"timestamp":"***","epochMillis":***,"level":"INFO","logger":"org.mule.runtime.core.internal.processor.LoggerMessageProcessor","message":"MARK info one","thread":"***"},{"timestamp":"***","epochMillis":***,"level":"WARN","logger":"app.jmx","message":"MARK warn one","thread":"***"},{"timestamp":"***","epochMillis":***,"level":"ERROR","logger":"app.jmx","message":"MARK error one","thread":"***"}]}
