%%% note
文字コード: output の encoding (Shift_JIS、EUC-JP、windows-1252) で書いたバイト列と DataType の charset、
それを読み直す (JSON は charset、XML は宣言)、http:request で送って listener が charset で読む。
%%% port 18145
%%% request GET /sjis-json
%%% response 200 base64
content-type: application/json; charset=Shift_JIS

ewogICJrIjogIoKgPz8iLAogICJlIjogIj8iCn0=
%%% request GET /roundtrip-json
%%% response 200
content-type: application/json; charset=UTF-8

{
  "k": "あい",
  "mime": "application/json",
  "enc": "Shift_JIS",
  "hex": "7B0A2020226B223A202282A082A2220A7D"
}
%%% request GET /roundtrip-xml
%%% response 200
content-type: application/json; charset=UTF-8

{
  "a": "日本語",
  "mime": "application/xml",
  "hex": "3C3F786D6C2076657273696F6E3D27312E302720656E636F64696E673D274555432D4A50273F3E0A3C613E262378363565353B262378363732633B262378386139653B3C2F613E"
}
%%% request GET /send
%%% response 200
content-type: application/json; charset=UTF-8

{
  "got": "café €",
  "ct": "text/plain; charset=windows-1252",
  "hex": "636166E92080"
}
%%% request GET /send-sjis-json
%%% response 200
content-type: application/json; charset=UTF-8

{
  "k": "漢字"
}
