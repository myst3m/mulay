%%% note
dw::Runtime::prop は JVM のシステムプロパティ (-D) を読む。mulay は run の name=value がそれにあたる。
%%% jvm -Dmy.prop=hello -Dmy.other=1
%%% port 18588
%%% request GET /props
%%% response 200
content-type: application/json; charset=UTF-8

{
  "mine": "hello",
  "other": "1",
  "missing": null,
  "enc": "UTF-8",
  "viaP": "hello"
}
