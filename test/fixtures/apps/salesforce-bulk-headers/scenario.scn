%%% request POST /meta?mode=notmap
%%% response 200
content-type: application/json; charset=UTF-8

{
  "items": [
    {
      "fullName": "MulayHdr1",
      "success": true
    },
    {
      "fullName": "MulayHdr2",
      "success": false
    }
