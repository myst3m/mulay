#%RAML 1.0
title: Shop RAML
version: v1
mediaType: application/json
types:
  Dims: !include types/dims.raml
  NewItem:
    type: object
    properties:
      name:
        type: string
        minLength: 1
      price: number
      qty?:
        type: integer
        minimum: 0
      tags:
        type: array
        maxItems: 2
        items: string
        required: false
      dims?: Dims
      kind:
        enum: [a, b]
        required: false
      when?: date-only
      at?: datetime
      email?:
        type: string
        pattern: ^[^@]+@[^@]+$
traits:
  paged:
    queryParameters:
      limit:
        type: integer
        minimum: 1
        maximum: 50
        default: 10
resourceTypes:
  collection:
    get:
      responses:
        200:
          body:
            application/json:
              type: array
/items:
  type: collection
  get:
    is: [paged]
    headers:
      X-Tenant:
        type: string
    queryParameters:
      sort:
        enum: [asc, desc]
        required: false
      active:
        type: boolean
        required: false
      tag:
        type: array
        items: string
        required: false
  post:
    body:
      application/json:
        type: NewItem
      application/xml:
    responses:
      201:
        body:
          application/json:
  /{id}:
    uriParameters:
      id:
        type: integer
    get:
      responses:
        200:
          body:
            application/json:
            application/xml:
    put:
      body:
        application/json:
          type: !include schemas/put.json
      responses:
        204:
    delete:
    /tags/{tag}:
      get:
/forms:
  post:
    body:
      application/x-www-form-urlencoded:
        properties:
          a: string
          b?: integer
/plain:
  post:
    body:
      text/plain:
/nobody:
  get:
    queryParameters:
      q:
        type: string
        required: true
    responses:
      202:
