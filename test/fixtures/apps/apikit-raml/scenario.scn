Content-Type: application/json

{"name": "pen", "price": 1, "qty": -1}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/qty -1 is not greater or equal to 0",
  "payloadMime": "application/json"
}
%%% request POST /api/items
Content-Type: application/json

{"name": "pen", "price": 1, "qty": 1.5}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/qty expected type: Integer, found: Double",
  "payloadMime": "application/json"
}
%%% request POST /api/items
Content-Type: application/json

{"name": "pen", "price": 1, "tags": ["a", "b", "c"]}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/tags expected maximum item count: 2, found: 3",
  "payloadMime": "application/json"
}
