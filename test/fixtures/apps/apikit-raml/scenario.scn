Content-Type: application/json

{"name": "pen", "price": 1, "dims": {"w": "wide"}}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/dims/w expected type: Number, found: String",
  "payloadMime": "application/json"
}
%%% request POST /api/items
Content-Type: application/json

{"name": 1, "price": "x"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/name expected type: String, found: Integer\n/price expected type: Number, found: String",
  "payloadMime": "application/json"
}
%%% request POST /api/items
Content-Type: application/json

{"name": "pen", "price": 1, "kind": "c"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/kind c is not a valid enum value",
  "payloadMime": "application/json"
}
%%% request POST /api/items
Content-Type: application/json

{"name": "pen", "price": 1, "when": "2024-02-30"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/when [2024-02-30] is not a valid date. Expected [yyyy-MM-dd]",
  "payloadMime": "application/json"
}
%%% request POST /api/items
Content-Type: application/json

{"name": "pen", "price": 1, "at": "2024-01-05 10:00"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/at [2024-01-05 10:00] is not a valid date-time. Expected [yyyy-MM-dd'T'HH:mm:ssZ, yyyy-MM-dd'T'HH:mm:ss.[0-9]{1,9}Z, yyyy-MM-dd'T'HH:mm:ss[+-]HH:mm, yyyy-MM-dd'T'HH:mm:ss.[0-9]{1,9}[+-]HH:mm]",
  "payloadMime": "application/json"
}
%%% request POST /api/items
Content-Type: application/json

{"name": "pen", "price": 1, "email": "nope"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/email string [nope] does not match pattern ^[^@]+@[^@]+$",
  "payloadMime": "application/json"
}
