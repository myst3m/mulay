Content-Type: application/json

{"name": "pen", "price": 1, "tags": [1]}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/tags/0 expected type: String, found: Integer",
  "payloadMime": "application/json"
}
