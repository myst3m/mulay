  "mime": "application/json",
  "body": {
    "name": "pen",
    "price": 1.5,
    "qty": 3,
    "tags": [
      "a"
    ],
    "dims": {
      "w": 1
    }
  },
  "statusVar": null,
  "headersVar": {
    
  },
  "attrClass": "org.mule.extension.http.api.HttpRequestAttributes"
}
%%% request POST /api/items
Content-Type: application/json

{"name": "pen"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "required key [price] not found",
  "payloadMime": "application/json"
}
%%% request POST /api/items
Content-Type: application/json

{"price": 1}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "required key [name] not found",
  "payloadMime": "application/json"
}
%%% request POST /api/items
Content-Type: application/json

{"name": "", "price": 1}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/name expected minLength: 1, actual: 0",
  "payloadMime": "application/json"
}
%%% request POST /api/items
Content-Type: application/json

{"name": "pen", "price": "x"}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/price expected type: Number, found: String",
  "payloadMime": "application/json"
}
