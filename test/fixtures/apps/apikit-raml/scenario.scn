%%% note
APIkit の RAML 1.0 (mule-apikit-module 1.12): types (!include の DataType を含む)、traits と
resourceTypes、入れ子の資源と uriParameters、queryParameters と headers (RAML では既定で必須)、
body の型 (RAML の型と !include の JSON Schema)、form の properties。apikit-oas と同じ形で、
実装フローから見える attributes と、APIKIT のエラーの説明を記録する。
%%% port 18133
%%% request GET /api/items
X-Tenant: acme
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "Required query parameter limit not specified",
  "payloadMime": "*/*"
}
%%% request GET /api/items?limit=5&sort=asc&active=true&tag=a&tag=b
X-Tenant: acme
%%% response 200
content-type: application/json; charset=UTF-8

{
  "flow": "get:\\items:raml-config",
  "method": "GET",
  "requestPath": "/api/items",
  "relativePath": "/api/items",
  "uriParams": {
    
  },
  "queryParams": {
    "limit": "5",
    "sort": "asc",
    "active": "true",
    "tag": "a",
    "tag": "b"
  },
  "tenant": "acme",
  "mime": "*/*",
  "body": "",
  "statusVar": null,
  "headersVar": {
    
  },
  "attrClass": "org.mule.extension.http.api.HttpRequestAttributes"
}
%%% request GET /api/items?limit=0
X-Tenant: acme
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "Invalid value '0' for query parameter limit. 0 is not greater or equal to 1",
  "payloadMime": "*/*"
}
