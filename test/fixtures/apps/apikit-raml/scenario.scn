Content-Type: application/json

{"name": "pen", "price": 1, "dims": {}}
%%% response 400
content-type: application/json; charset=UTF-8

{
  "type": "APIKIT:BAD_REQUEST",
  "description": "/dims required key [w] not found",
  "payloadMime": "application/json"
}
