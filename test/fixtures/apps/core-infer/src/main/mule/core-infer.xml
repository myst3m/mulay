<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <http:listener-config name="L">
        <http:listener-connection host="0.0.0.0" port="18137"/>
    </http:listener-config>

    <error-handler name="report">
        <on-error-continue>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{"type": error.errorType.namespace ++ ":" ++ error.errorType.identifier, description: error.description}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        </on-error-continue>
    </error-handler>

    <flow name="xml-meta">
        <http:listener config-ref="L" path="/xml-meta"/>
        <set-payload value="&lt;r&gt;&lt;a&gt;x&lt;/a&gt;&lt;/r&gt;" mimeType="application/xml"/>
        <set-variable variableName="v" value="#[payload.^mimeType]"/>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{t: typeOf(vars.v), m: vars.v.^mimeType, v: vars.v}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="xml-str">
        <http:listener config-ref="L" path="/xml-str"/>
        <set-payload value="&lt;r&gt;&lt;a&gt;x&lt;/a&gt;&lt;/r&gt;" mimeType="application/xml"/>
        <set-variable variableName="v" value="#[payload.r.a]"/>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{t: typeOf(vars.v), m: vars.v.^mimeType, v: vars.v}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="xml-num">
        <http:listener config-ref="L" path="/xml-num"/>
        <set-payload value="&lt;r&gt;&lt;a&gt;x&lt;/a&gt;&lt;/r&gt;" mimeType="application/xml"/>
        <set-variable variableName="v" value="#[sizeOf(payload.r)]"/>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{t: typeOf(vars.v), m: vars.v.^mimeType, v: vars.v}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="xml-obj">
        <http:listener config-ref="L" path="/xml-obj"/>
        <set-payload value="&lt;r&gt;&lt;a&gt;x&lt;/a&gt;&lt;/r&gt;" mimeType="application/xml"/>
        <set-variable variableName="v" value="#[payload.r]"/>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{t: typeOf(vars.v), m: vars.v.^mimeType, v: vars.v}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="xml-cls">
        <http:listener config-ref="L" path="/xml-cls"/>
        <set-payload value="&lt;r&gt;&lt;a&gt;x&lt;/a&gt;&lt;/r&gt;" mimeType="application/xml"/>
        <set-variable variableName="v" value="#[payload.^class]"/>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{t: typeOf(vars.v), m: vars.v.^mimeType, v: vars.v}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="json-meta">
        <http:listener config-ref="L" path="/json-meta"/>
        <set-payload value="{&quot;a&quot;: &quot;x&quot;}" mimeType="application/json"/>
        <set-variable variableName="v" value="#[(payload).^mimeType]"/>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{t: typeOf(vars.v), m: vars.v.^mimeType, v: vars.v}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>
<flow name="json-meta-cached">
        <http:listener config-ref="L" path="/json-meta-cached"/>
        <set-payload value="{&quot;a&quot;: &quot;x&quot;}" mimeType="application/json"/>
        <set-variable variableName="v" value="#[payload.^mimeType]"/>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{t: typeOf(vars.v), m: vars.v.^mimeType, v: vars.v}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="json-str">
        <http:listener config-ref="L" path="/json-str"/>
        <set-payload value="{&quot;a&quot;: &quot;x&quot;}" mimeType="application/json"/>
        <set-variable variableName="v" value="#[payload.a]"/>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{t: typeOf(vars.v), m: vars.v.^mimeType, v: vars.v}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="csv-meta">
        <http:listener config-ref="L" path="/csv-meta"/>
        <set-payload value="a&#10;x" mimeType="application/csv"/>
        <set-variable variableName="v" value="#[((payload)).^mimeType]"/>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{t: typeOf(vars.v), m: vars.v.^mimeType, v: vars.v}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="csv-str">
        <http:listener config-ref="L" path="/csv-str"/>
        <set-payload value="a&#10;x" mimeType="application/csv"/>
        <set-variable variableName="v" value="#[payload[0].a]"/>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{t: typeOf(vars.v), m: vars.v.^mimeType, v: vars.v}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>

    <!-- Java の値を DW で読むと class のメタデータが付く -->
    <flow name="java-class">
        <http:listener config-ref="L" path="/java-class"/>
        <set-variable variableName="v" value="#[output application/java --- {i: 1, l: 2147483648, b: 12345678901234567890123, d: 1.5, t: true, s: 's', dt: |2020-01-02|, dtt: |2020-01-02T10:00:00Z|, ldt: |2020-01-02T10:00:00|, lt: |10:00:00|, n: null, o: {}, a: [1], r: 1 to 3}]"/>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/dw
---
vars.v]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>
    <!-- Java の値の根のメタデータ: output application/java と推論 -->
    <flow name="java-meta">
        <http:listener config-ref="L" path="/java-meta"/>
        <set-variable variableName="e" value="#[output application/java --- {a: 1}]"/>
        <set-variable variableName="i" value="#[{a: 1}]"/>
        <set-variable variableName="s" value="#[output application/java --- 'x']"/>
        <set-payload value="#[output application/java --- {b: 2}]"/>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{e: vars.e.^, i: vars.i.^, s: vars.s.^, p: payload.^, pa: payload.b.^}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler ref="report"/>
    </flow>
</mule>
