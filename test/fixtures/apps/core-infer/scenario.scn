%%% note
出力の指示の無いインラインの式 (set-variable) の出力形式の推論。payload が XML / JSON / CSV のとき、
メタデータ (^mimeType、^class)、文字列、数値、Object を返す式。
同じ文字列の式はコンパイル結果 (推論した形式を含む) が使い回される (json-meta-cached は xml-meta の推論のまま)。
%%% port 18137
%%% request GET /xml-meta
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "MULE:EXPRESSION",
  "description": "\"Trying to output non-whitespace characters outside main element tree (in prolog or epilog), while writing Xml at .\" evaluating expression: \"payload.^mimeType\"."
}
%%% request GET /xml-str
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "MULE:EXPRESSION",
  "description": "\"Trying to output non-whitespace characters outside main element tree (in prolog or epilog), while writing Xml at .\" evaluating expression: \"payload.r.a\"."
}
%%% request GET /xml-num
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "MULE:EXPRESSION",
  "description": "\"Trying to output non-whitespace characters outside main element tree (in prolog or epilog), while writing Xml at .\" evaluating expression: \"sizeOf(payload.r)\"."
}
%%% request GET /xml-obj
%%% response 200
content-type: application/json; charset=UTF-8

{
  "t": "Object",
  "m": "application/xml",
  "v": {
    "a": "x"
  }
}
%%% request GET /xml-cls
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "MULE:EXPRESSION",
  "description": "\"Trying to write END_DOCUMENT when document has no root (ie. trying to output empty document), while writing Xml.\nTrace:\n  at main (Unknown)\" evaluating expression: \"payload.^class\"."
}
%%% request GET /json-meta
%%% response 200
content-type: application/json; charset=UTF-8

{
  "t": "String",
  "m": "application/json",
  "v": "application/json"
}
%%% request GET /json-meta-cached
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "MULE:EXPRESSION",
  "description": "\"Trying to output non-whitespace characters outside main element tree (in prolog or epilog), while writing Xml at .\" evaluating expression: \"payload.^mimeType\"."
}
%%% request GET /json-str
%%% response 200
content-type: application/json; charset=UTF-8

{
  "t": "String",
  "m": "application/json",
  "v": "x"
}
%%% request GET /csv-meta
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "MULE:EXPRESSION",
  "description": "\"CSV Structure should be either an `Array<Object>` or an `Object` but got String, while writing CSV.\nTrace:\n  at main (Unknown)\" evaluating expression: \"((payload)).^mimeType\"."
}
%%% request GET /csv-str
%%% response 200
content-type: application/json; charset=UTF-8

{
  "type": "MULE:EXPRESSION",
  "description": "\"CSV Structure should be either an `Array<Object>` or an `Object` but got String, while writing CSV.\nTrace:\n  at main (Unknown)\" evaluating expression: \"payload[0].a\"."
}
%%% request GET /java-class
%%% response 200
content-type: application/dw; charset=UTF-8

{
  i: 1 as Number {class: "java.lang.Integer"},
  l: 2147483648 as Number {class: "java.lang.Long"},
  b: 12345678901234567890123 as Number {class: "java.math.BigInteger"},
  d: 1.5 as Number {class: "java.lang.Double"},
  t: true as Boolean {class: "java.lang.Boolean"},
  s: "s" as String {class: "java.lang.String"},
  dt: |2020-01-02| as Date {class: "java.time.LocalDate"},
  dtt: |2020-01-02T10:00:00Z| as DateTime {class: "java.time.ZonedDateTime"},
  ldt: |2020-01-02T10:00:00| as LocalDateTime {class: "java.time.LocalDateTime"},
  lt: |10:00:00| as LocalTime {class: "java.time.LocalTime"},
  n: null,
  o: {} as Object {class: "java.util.LinkedHashMap"},
  a: [
    1 as Number {class: "java.lang.Integer"}
  ] as Array {class: "java.util.ArrayList"},
  r: [
    1 as Number {class: "java.lang.Integer"}, 
    2 as Number {class: "java.lang.Integer"}, 
    3 as Number {class: "java.lang.Integer"}
  ] as Array {class: "java.util.ArrayList"}
} as Object {encoding: "UTF-8", mediaType: "application/java; charset=UTF-8", mimeType: "application/java", class: "java.util.LinkedHashMap"}
%%% request GET /java-meta
%%% response 200
content-type: application/json; charset=UTF-8

{
  "e": {
    "encoding": "UTF-8",
    "mediaType": "application/java; charset=UTF-8",
    "mimeType": "application/java",
    "raw": {
      "a": 1
    },
    "class": "java.util.LinkedHashMap"
  },
  "i": {
    "encoding": "UTF-8",
    "mediaType": "application/java; charset=UTF-8",
    "mimeType": "application/java",
    "raw": {
      "a": 1
    },
    "class": "java.util.LinkedHashMap"
  },
  "s": {
    "encoding": "UTF-8",
    "mediaType": "application/java; charset=UTF-8",
    "mimeType": "application/java",
    "raw": "x",
    "class": "java.lang.String",
    "contentLength": 1
  },
  "p": {
    "encoding": "UTF-8",
    "mediaType": "application/java; charset=UTF-8",
    "mimeType": "application/java",
    "raw": {
      "b": 2
    },
    "class": "java.util.LinkedHashMap"
  },
  "pa": {
    "class": "java.lang.Integer"
  }
}
