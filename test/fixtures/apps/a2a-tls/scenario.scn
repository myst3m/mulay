%%% note
A2A コネクタ 1.1.1 の HTTPS: サーバーは HTTPS の listener-config に経路を足す (attributes.scheme は https)。クライアントは
client-connection の tls:context (その場のものと tlsContext の参照) で相手の証明書を信頼する。
%%% port 18168
%%% request GET /t/send
%%% response 200
content-type: application/json; charset=UTF-8

{
  "role": "agent",
  "parts": [
    {
      "text": "secure https",
      "kind": "text"
    }
  ],
  "messageId": "m-1",
  "kind": "message"
}
%%% request GET /t/send?cfg=ref
%%% response 200
content-type: application/json; charset=UTF-8

{
  "role": "agent",
  "parts": [
    {
      "text": "secure https",
      "kind": "text"
    }
  ],
  "messageId": "m-1",
  "kind": "message"
}
%%% request GET /t/card
%%% response 200
content-type: application/json; charset=UTF-8

"https://localhost:18169/agent"
