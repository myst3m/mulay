%%% note
set-variable / remove-variable / set-payload: 文字列そのままの値と #[...] の式、数値に見える
リテラルの型 (String のまま)、null を入れた変数、埋め込み式 "Hello #[...]!"、名前に - を含む変数、
上書きと remove (存在しない変数の remove)、mimeType 付きの変数の選択、set-payload の mimeType
と encoding、式で作った値 (java / json / xml / csv) を HTTP 応答にしたときの content-type と本文、
HTTP の attributes の各項目 (requestUri、listenerPath、relativePath、queryString ほか)。
%%% port 18117
%%% request GET /kinds
%%% response 200
content-type: application/json; charset=UTF-8

{
  "literal": "plain literal",
  "literalType": "String",
  "literalNumber": "42",
  "literalNumberType": "String",
  "exprNumber": 42,
  "exprNumberType": "Number",
  "exprBool": true,
  "exprNull": null,
  "hasExprNull": false,
  "exprObject": {
    "a": 1,
    "b": [
      true,
      "x"
    ]
  },
  "dashed": "dash",
  "missing": null
}
%%% request GET /embedded
%%% response 500
content-type: text/plain; charset=UTF-8

"Script 'Hello #[upper('world')]!' has errors: 
	Invalid input '[', expected ??? (line 1, column 8):
 at 1 : 8" evaluating expression: "Hello #[upper('world')]!".
%%% request GET /remove
%%% response 200
content-type: application/json; charset=UTF-8

{
  "a": "second",
  "b": "removed",
  "keys": [
    "a"
  ]
}
%%% request GET /var-mime
%%% response 200
content-type: application/json; charset=UTF-8

{
  "fromJson": "v",
  "textIsString": true
}
%%% request GET /payload/text
%%% response 200
content-type: text/plain

text payload
%%% request GET /payload/text-latin1
%%% response 200 base64
content-type: text/plain; charset=ISO-8859-1

Y2Fm6Q==
%%% request GET /payload/json-literal
%%% response 200
content-type: application/json

{"literal": true}
%%% request GET /payload/json-expr
%%% response 200
content-type: application/json; charset=UTF-8

{
  "expr": true
}
%%% request GET /payload/java-object
%%% response 200 base64
content-type: application/java; charset=UTF-8

rO0ABXNyABdqYXZhLnV0aWwuTGlua2VkSGFzaE1hcDTATlwQbMD7AgABWgALYWNjZXNzT3JkZXJ4cgARamF2YS51dGlsLkhhc2hNYXAFB9rBwxZg0QMAAkYACmxvYWRGYWN0b3JJAAl0aHJlc2hvbGR4cD9AAAAAAAAMdwgAAAAQAAAAAXQACmphdmFPYmplY3RzcgARamF2YS5sYW5nLkJvb2xlYW7NIHKA1Zz67gIAAVoABXZhbHVleHABeAA=
