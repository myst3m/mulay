%%% response 200 base64
content-type: application/java; charset=UTF-8

rO0ABXNyABBqYXZhLmxhbmcuRG91YmxlgLPCSilr+wQCAAFEAAV2YWx1ZXhyABBqYXZhLmxhbmcuTnVtYmVyhqyVHQuU4IsCAAB4cEApAAAAAAAA
%%% request GET /payload/null
%%% response 200
content-type: application/java; charset=UTF-8


%%% request GET /payload/xml-expr
%%% response 200
content-type: application/xml; charset=UTF-8

<?xml version='1.0' encoding='UTF-8'?>
<root>
  <child>x</child>
</root>
%%% request GET /payload/csv-expr
%%% response 200
content-type: application/csv; charset=UTF-8

a,b
1,x
2,y\,z

%%% request GET /payload/other
%%% response 200
content-type: application/java; charset=UTF-8

other
%%% request GET /attributes?x=1&y=%20a&x=2
%%% response 200
content-type: application/json; charset=UTF-8

{
  "method": "GET",
  "path": "/attributes",
  "q": {
    "x": "1",
    "x": "2",
    "y": " a"
  },
  "uri": "/attributes?x=1&y= a&x=2",
  "listenerPath": "/attributes",
  "relativePath": "/attributes",
  "rawRequestPath": "/attributes",
  "version": "HTTP/1.1",
  "scheme": "http",
  "queryString": "x=1&y= a&x=2",
  "maskedRequestPath": null
}
