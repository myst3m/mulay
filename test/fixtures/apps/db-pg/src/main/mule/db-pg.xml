<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <http:listener-config name="L">
        <http:listener-connection host="0.0.0.0" port="18173"/>
    </http:listener-config>

    <db:config name="Pg">
        <db:generic-connection url="jdbc:postgresql://localhost:15432/mulay" driverClassName="org.postgresql.Driver" user="mulay" password="mulay"/>
    </db:config>

    <!-- TLS の指定 (検査用のサーバーは ssl=off)。pgjdbc: sslmode が無ければ ssl=true で verify-full、それ以外は prefer -->
    <db:config name="PgRequire">
        <db:generic-connection url="jdbc:postgresql://localhost:15432/mulay?sslmode=require" driverClassName="org.postgresql.Driver" user="mulay" password="mulay"/>
    </db:config>
    <db:config name="PgSslTrue">
        <db:generic-connection url="jdbc:postgresql://localhost:15432/mulay?ssl=true" driverClassName="org.postgresql.Driver" user="mulay" password="mulay"/>
    </db:config>
    <db:config name="PgPrefer">
        <db:generic-connection url="jdbc:postgresql://localhost:15432/mulay?sslmode=prefer" driverClassName="org.postgresql.Driver" user="mulay" password="mulay"/>
    </db:config>
    <db:config name="PgBadMode">
        <db:generic-connection url="jdbc:postgresql://localhost:15432/mulay?sslmode=bogus" driverClassName="org.postgresql.Driver" user="mulay" password="mulay"/>
    </db:config>

    <error-handler name="report">
        <on-error-continue>
            <ee:transform>
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{"type": error.errorType.namespace ++ ":" ++ error.errorType.identifier, description: error.description}]]></ee:set-payload>
                </ee:message>
            </ee:transform>
        </on-error-continue>
    </error-handler>

    <flow name="ssl-require">
        <http:listener config-ref="L" path="/ssl-require"/>
        <db:select config-ref="PgRequire"><db:sql>SELECT 1 AS one</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="ssl-true">
        <http:listener config-ref="L" path="/ssl-true"/>
        <db:select config-ref="PgSslTrue"><db:sql>SELECT 1 AS one</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="ssl-prefer">
        <http:listener config-ref="L" path="/ssl-prefer"/>
        <db:select config-ref="PgPrefer"><db:sql>SELECT 1 AS one</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="ssl-bad">
        <http:listener config-ref="L" path="/ssl-bad"/>
        <db:select config-ref="PgBadMode"><db:sql>SELECT 1 AS one</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>

    <!-- 表を作り直す (シナリオの最初に呼ぶ) -->
    <flow name="reset">
        <http:listener config-ref="L" path="/reset"/>
        <db:execute-script config-ref="Pg">
            <db:sql><![CDATA[DROP FUNCTION IF EXISTS people();
DROP TABLE IF EXISTS person;
CREATE TABLE person (id SERIAL PRIMARY KEY, name TEXT NOT NULL, age INT, score NUMERIC(8,2), active BOOLEAN, born DATE, seen TIMESTAMP, seen_tz TIMESTAMPTZ, big BIGINT, blob BYTEA);
INSERT INTO person (name, age, score, active, born, seen, seen_tz, big, blob) VALUES
 ('Ann', 30, 12.50, true, '1996-01-02', '2026-09-30 10:11:12.345', '2026-09-30 10:11:12+09', 9007199254740993, '\x0102ff'),
 ('Bob', NULL, NULL, false, NULL, NULL, NULL, NULL, NULL),
 ('Cid', 41, 100, true, '1985-12-31', '2026-01-01 00:00:00', '2026-01-01 00:00:00Z', -5, '')]]></db:sql>
        </db:execute-script>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <!-- select: 行の値とその型 -->
    <!-- select の maxRows -->
    <flow name="select-max">
        <http:listener config-ref="L" path="/select-max"/>
        <db:select config-ref="Pg" maxRows="#[attributes.queryParams.n as Number]">
            <db:sql>SELECT id, name FROM person ORDER BY id</db:sql>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="select">
        <http:listener config-ref="L" path="/select"/>
        <db:select config-ref="Pg">
            <db:sql>SELECT * FROM person ORDER BY id</db:sql>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="select-types">
        <http:listener config-ref="L" path="/select-types"/>
        <db:select config-ref="Pg">
            <db:sql>SELECT * FROM person ORDER BY id</db:sql>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload map ((row) -> row mapObject ((v, k) -> {(k): {t: typeOf(v) as String, c: v.^class default null}}))]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="select-param">
        <http:listener config-ref="L" path="/select-param"/>
        <db:select config-ref="Pg">
            <db:sql>SELECT id, name FROM person WHERE age &gt; :min AND name &lt;&gt; :skip ORDER BY id</db:sql>
            <db:input-parameters><![CDATA[#[{min: attributes.queryParams.min as Number, skip: 'nobody'}]]]></db:input-parameters>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="insert">
        <http:listener config-ref="L" path="/insert"/>
        <db:insert config-ref="Pg" autoGenerateKeys="true">
            <db:sql>INSERT INTO person (name, age) VALUES (:name, :age)</db:sql>
            <db:input-parameters><![CDATA[#[{name: 'Dee', age: 22}]]]></db:input-parameters>
        </db:insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="update">
        <http:listener config-ref="L" path="/update"/>
        <db:update config-ref="Pg">
            <db:sql>UPDATE person SET age = age + 1 WHERE age IS NOT NULL</db:sql>
        </db:update>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="delete">
        <http:listener config-ref="L" path="/delete"/>
        <db:delete config-ref="Pg">
            <db:sql>DELETE FROM person WHERE name = :n</db:sql>
            <db:input-parameters><![CDATA[#[{n: 'Dee'}]]]></db:input-parameters>
        </db:delete>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="bulk-insert">
        <http:listener config-ref="L" path="/bulk-insert"/>
        <db:bulk-insert config-ref="Pg">
            <db:bulk-input-parameters><![CDATA[#[[{name: 'E1', age: 1}, {name: 'E2', age: 2}]]]]></db:bulk-input-parameters>
            <db:sql>INSERT INTO person (name, age) VALUES (:name, :age)</db:sql>
        </db:bulk-insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="query-single">
        <http:listener config-ref="L" path="/query-single"/>
        <db:query-single config-ref="Pg">
            <db:sql>SELECT count(*) AS n, max(age) AS oldest FROM person</db:sql>
        </db:query-single>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <!-- 失敗: SQL の誤り、無い表、制約違反 -->
    <flow name="err-syntax">
        <http:listener config-ref="L" path="/err-syntax"/>
        <db:select config-ref="Pg"><db:sql>SELEC 1</db:sql></db:select>
        <error-handler ref="report"/>
    </flow>
    <flow name="err-table">
        <http:listener config-ref="L" path="/err-table"/>
        <db:select config-ref="Pg"><db:sql>SELECT * FROM nothing_here</db:sql></db:select>
        <error-handler ref="report"/>
    </flow>
    <flow name="err-constraint">
        <http:listener config-ref="L" path="/err-constraint"/>
        <db:insert config-ref="Pg"><db:sql>INSERT INTO person (name) VALUES (NULL)</db:sql></db:insert>
        <error-handler ref="report"/>
    </flow>
    <!-- ストアドプロシージャ: 作る -->
    <flow name="sp-setup">
        <http:listener config-ref="L" path="/sp-setup"/>
        <db:execute-ddl config-ref="Pg"><db:sql><![CDATA[CREATE OR REPLACE PROCEDURE add_one(a int, INOUT b int DEFAULT NULL) LANGUAGE plpgsql AS $$ BEGIN b := a + 1; END $$]]></db:sql></db:execute-ddl>
        <db:execute-ddl config-ref="Pg"><db:sql><![CDATA[CREATE OR REPLACE PROCEDURE touch_bob() LANGUAGE sql AS $$ UPDATE person SET age = 7 WHERE name = 'Bob' $$]]></db:sql></db:execute-ddl>
        <db:execute-ddl config-ref="Pg"><db:sql><![CDATA[CREATE OR REPLACE FUNCTION info(n text, OUT len int, OUT up text) LANGUAGE sql AS $$ SELECT length(n), upper(n) $$]]></db:sql></db:execute-ddl>
        <db:execute-ddl config-ref="Pg"><db:sql><![CDATA[CREATE OR REPLACE FUNCTION bump(a int, INOUT b int) LANGUAGE sql AS $$ SELECT a + b $$]]></db:sql></db:execute-ddl>
        <db:execute-ddl config-ref="Pg"><db:sql><![CDATA[CREATE OR REPLACE FUNCTION twice(x int) RETURNS int LANGUAGE sql AS $$ SELECT x * 2 $$]]></db:sql></db:execute-ddl>
        <db:execute-ddl config-ref="Pg"><db:sql><![CDATA[CREATE OR REPLACE FUNCTION people() RETURNS SETOF person LANGUAGE sql AS $$ SELECT * FROM person ORDER BY id $$]]></db:sql></db:execute-ddl>
        <set-payload value="#['ok']"/>
    </flow>

    <!-- INOUT (プロシージャ) -->
    <flow name="sp-out">
        <http:listener config-ref="L" path="/sp-out"/>
        <db:stored-procedure config-ref="Pg">
            <db:sql><![CDATA[{call add_one(:a, :b)}]]></db:sql>
            <db:input-parameters><![CDATA[#[{a: 41}]]]></db:input-parameters>
            <db:output-parameters>
                <db:output-parameter key="b" type="INTEGER"/>
            </db:output-parameters>
        </db:stored-procedure>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload mapObject ((v, k) -> {(k): {v: v, t: typeOf(v) as String, c: v.^class default null}})]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="sp-inout">
        <http:listener config-ref="L" path="/sp-inout"/>
        <db:stored-procedure config-ref="Pg">
            <db:sql><![CDATA[{call add_one(:a, :b)}]]></db:sql>
            <db:input-parameters><![CDATA[#[{a: 1}]]]></db:input-parameters>
            <db:in-out-parameters>
                <db:in-out-parameter key="b" value="#[5]"/>
            </db:in-out-parameters>
        </db:stored-procedure>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload mapObject ((v, k) -> {(k): {v: v, t: typeOf(v) as String, c: v.^class default null}})]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <!-- 実 Mule は解決したテンプレートを db:config ごとに SQL の文面で覚え、引数の種類 (IN / OUT / IN-OUT) は最初の
         呼び出しのものを使い続ける (DbConnectionProvider の cachedTemplates)。/sp-out の後の /sp-inout は b を OUT として
         送る。ここでは別の文面 (空白が 2 つ) で、先に IN-OUT、次に OUTPUT で呼ぶ -->
    <flow name="spc-inout">
        <http:listener config-ref="L" path="/spc-inout"/>
        <db:stored-procedure config-ref="Pg">
            <db:sql><![CDATA[{call  add_one(:a, :b)}]]></db:sql>
            <db:input-parameters><![CDATA[#[{a: 1}]]]></db:input-parameters>
            <db:in-out-parameters>
                <db:in-out-parameter key="b" value="#[5]"/>
            </db:in-out-parameters>
        </db:stored-procedure>
        <error-handler ref="report"/>
    </flow>
    <flow name="spc-out">
        <http:listener config-ref="L" path="/spc-out"/>
        <db:stored-procedure config-ref="Pg">
            <db:sql><![CDATA[{call  add_one(:a, :b)}]]></db:sql>
            <db:input-parameters><![CDATA[#[{a: 41}]]]></db:input-parameters>
            <db:output-parameters>
                <db:output-parameter key="b" type="INTEGER"/>
            </db:output-parameters>
        </db:stored-procedure>
        <error-handler ref="report"/>
    </flow>

    <flow name="sp-none">
        <http:listener config-ref="L" path="/sp-none"/>
        <db:stored-procedure config-ref="Pg">
            <db:sql><![CDATA[{call touch_bob()}]]></db:sql>
        </db:stored-procedure>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload mapObject ((v, k) -> {(k): {v: v, t: typeOf(v) as String, c: v.^class default null}})]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="sp-multi">
        <http:listener config-ref="L" path="/sp-multi"/>
        <db:stored-procedure config-ref="Pg">
            <db:sql><![CDATA[{call info(:n, :len, :up)}]]></db:sql>
            <db:input-parameters><![CDATA[#[{n: 'abc'}]]]></db:input-parameters>
            <db:output-parameters>
                <db:output-parameter key="len" type="INTEGER"/>
                <db:output-parameter key="up" type="VARCHAR"/>
            </db:output-parameters>
        </db:stored-procedure>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload mapObject ((v, k) -> {(k): {v: v, t: typeOf(v) as String, c: v.^class default null}})]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="sp-func">
        <http:listener config-ref="L" path="/sp-func"/>
        <db:stored-procedure config-ref="Pg">
            <db:sql><![CDATA[{:r = call twice(:x)}]]></db:sql>
            <db:input-parameters><![CDATA[#[{x: 21}]]]></db:input-parameters>
            <db:output-parameters>
                <db:output-parameter key="r" type="INTEGER"/>
            </db:output-parameters>
        </db:stored-procedure>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload mapObject ((v, k) -> {(k): {v: v, t: typeOf(v) as String, c: v.^class default null}})]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="sp-set">
        <http:listener config-ref="L" path="/sp-set"/>
        <db:stored-procedure config-ref="Pg">
            <db:sql><![CDATA[{call people()}]]></db:sql>
        </db:stored-procedure>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="sp-missing">
        <http:listener config-ref="L" path="/sp-missing"/>
        <db:stored-procedure config-ref="Pg">
            <db:sql><![CDATA[{call nothing_here(:a)}]]></db:sql>
            <db:input-parameters><![CDATA[#[{a: 1}]]]></db:input-parameters>
        </db:stored-procedure>
        <error-handler ref="report"/>
    </flow>
    <flow name="sp-inout-func">
        <http:listener config-ref="L" path="/sp-inout-func"/>
        <db:stored-procedure config-ref="Pg">
            <db:sql><![CDATA[{call bump(:a, :b)}]]></db:sql>
            <db:input-parameters><![CDATA[#[{a: 1}]]]></db:input-parameters>
            <db:in-out-parameters>
                <db:in-out-parameter key="b" value="#[5]"/>
            </db:in-out-parameters>
        </db:stored-procedure>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload mapObject ((v, k) -> {(k): {v: v, t: typeOf(v) as String, c: v.^class default null}})]]></ee:set-payload></ee:message></ee:transform>
    </flow>
    <!-- execute-script の途中の文の失敗 -->
    <flow name="err-script">
        <http:listener config-ref="L" path="/err-script"/>
        <db:execute-script config-ref="Pg">
            <db:sql><![CDATA[UPDATE person SET age = age WHERE 1 = 0;
SELECT * FROM nothing_here;
UPDATE person SET age = age WHERE 1 = 0]]></db:sql>
        </db:execute-script>
        <error-handler ref="report"/>
    </flow>
    <flow name="err-script2">
        <http:listener config-ref="L" path="/err-script2"/>
        <db:execute-script config-ref="Pg">
            <db:sql><![CDATA[UPDATE person SET age = age WHERE 1 = 0;
INSERT INTO person (name) VALUES (NULL);
UPDATE person SET age = age WHERE 1 = 0]]></db:sql>
        </db:execute-script>
        <error-handler ref="report"/>
    </flow>
    <flow name="err-script-semi">
        <http:listener config-ref="L" path="/err-script-semi"/>
        <db:execute-script config-ref="Pg">
            <db:sql><![CDATA[UPDATE person SET age = age WHERE 1 = 0;
INSERT INTO nothing_here VALUES (1);]]></db:sql>
        </db:execute-script>
        <error-handler ref="report"/>
    </flow>
    <flow name="err-script-space-semi">
        <http:listener config-ref="L" path="/err-script-space-semi"/>
        <db:execute-script config-ref="Pg">
            <db:sql><![CDATA[UPDATE person SET age = age WHERE 1 = 0;
INSERT INTO nothing_here VALUES (1) ;  ]]></db:sql>
        </db:execute-script>
        <error-handler ref="report"/>
    </flow>
    <flow name="script-select">
        <http:listener config-ref="L" path="/script-select"/>
        <db:execute-script config-ref="Pg">
            <db:sql><![CDATA[UPDATE person SET age = age WHERE 1 = 0;
SELECT name FROM person WHERE 1 = 0]]></db:sql>
        </db:execute-script>
        <error-handler ref="report"/>
    </flow>
    <!-- トランザクション: try の transactionalAction -->
    <flow name="tx-ok">
        <http:listener config-ref="L" path="/tx-ok"/>
        <try transactionalAction="ALWAYS_BEGIN">
            <db:insert config-ref="Pg"><db:sql>INSERT INTO person (name) VALUES ('T1')</db:sql></db:insert>
            <db:insert config-ref="Pg"><db:sql>INSERT INTO person (name) VALUES ('T2')</db:sql></db:insert>
        </try>
        <db:select config-ref="Pg"><db:sql>SELECT name FROM person WHERE name LIKE 'T%' ORDER BY name</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="tx-rollback">
        <http:listener config-ref="L" path="/tx-rollback"/>
        <try>
            <try transactionalAction="ALWAYS_BEGIN">
                <db:insert config-ref="Pg"><db:sql>INSERT INTO person (name) VALUES ('R1')</db:sql></db:insert>
                <raise-error type="APP:FAIL" description="fail in tx"/>
            </try>
            <error-handler><on-error-continue><set-payload value="#['caught']"/></on-error-continue></error-handler>
        </try>
        <db:select config-ref="Pg"><db:sql>SELECT name FROM person WHERE name LIKE 'R%' ORDER BY name</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="tx-continue">
        <http:listener config-ref="L" path="/tx-continue"/>
        <try transactionalAction="ALWAYS_BEGIN">
            <db:insert config-ref="Pg"><db:sql>INSERT INTO person (name) VALUES ('C1')</db:sql></db:insert>
            <raise-error type="APP:FAIL" description="fail in tx"/>
            <error-handler><on-error-continue><set-payload value="#['continued']"/></on-error-continue></error-handler>
        </try>
        <db:select config-ref="Pg"><db:sql>SELECT name FROM person WHERE name LIKE 'C%' ORDER BY name</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="tx-notsupported">
        <http:listener config-ref="L" path="/tx-notsupported"/>
        <try>
            <try transactionalAction="ALWAYS_BEGIN">
                <db:insert config-ref="Pg" transactionalAction="NOT_SUPPORTED"><db:sql>INSERT INTO person (name) VALUES ('N1')</db:sql></db:insert>
                <db:insert config-ref="Pg"><db:sql>INSERT INTO person (name) VALUES ('N2')</db:sql></db:insert>
                <raise-error type="APP:FAIL" description="fail in tx"/>
            </try>
            <error-handler><on-error-continue><set-payload value="#['caught']"/></on-error-continue></error-handler>
        </try>
        <db:select config-ref="Pg"><db:sql>SELECT name FROM person WHERE name LIKE 'N%' ORDER BY name</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="tx-sees-own">
        <http:listener config-ref="L" path="/tx-sees-own"/>
        <try transactionalAction="ALWAYS_BEGIN">
            <db:insert config-ref="Pg"><db:sql>INSERT INTO person (name) VALUES ('S1')</db:sql></db:insert>
            <db:select config-ref="Pg"><db:sql>SELECT count(*) AS n FROM person WHERE name = 'S1'</db:sql></db:select>
            <set-variable variableName="inside" value="#[payload[0].n]"/>
            <raise-error type="APP:FAIL" description="undo"/>
            <error-handler><on-error-propagate/></error-handler>
