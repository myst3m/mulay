    <!-- 失敗した組の値を SQL に埋め込んだ形 (pgjdbc の BatchUpdateException の文言) -->
    <flow name="bulk-types">
        <http:listener config-ref="L" path="/bulk-types"/>
        <db:bulk-insert config-ref="Pg">
            <db:bulk-input-parameters><![CDATA[#[[{id: 1, s: "it's", f: 1.5, b: true, big: 9007199254740993, dbl: 0.1 as Number, neg: -7, d: |2026-10-03|, dt: |2026-10-03T10:11:12|, n: null}]]]]></db:bulk-input-parameters>
            <db:sql>INSERT INTO bulk_t (id, name) VALUES (:id, CAST(:s AS VARCHAR) || CAST(:f AS VARCHAR) || CAST(:b AS VARCHAR) || CAST(:big AS VARCHAR) || CAST(:dbl AS VARCHAR) || CAST(:neg AS VARCHAR) || CAST(:d AS VARCHAR) || CAST(:dt AS VARCHAR) || CAST(:n AS VARCHAR))</db:sql>
        </db:bulk-insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>
    <!-- pgjdbc の executeBatch (bulk-* と execute-script): 文を続けて送り、Sync は先頭の 255 文の後、その後は 256 文ごとと最後
         (Sync までが 1 つのトランザクション)。失敗すると、その区切りの中の前の文は取り消され、前の区切りまでは残る -->
    <flow name="script-tx-setup">
        <http:listener config-ref="L" path="/script-tx-setup"/>
        <db:execute-script config-ref="Pg">
            <db:sql><![CDATA[DROP TABLE IF EXISTS script_t;
CREATE TABLE script_t (id INTEGER PRIMARY KEY)]]></db:sql>
        </db:execute-script>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>
    <!-- n 文の INSERT (id は from から)。dup が 0 でなければ dup 番目 (1 から) の文の id を from にする (重複で失敗) -->
    <flow name="script-tx">
        <http:listener config-ref="L" path="/script-tx"/>
        <db:execute-script config-ref="Pg">
            <db:sql><![CDATA[#[%dw 2.0
var q = attributes.queryParams
var from = q.from as Number
---
((1 to (q.n as Number)) map ((i) -> "INSERT INTO script_t VALUES (" ++ ((if (i == (q.dup default "0") as Number) from else from + i - 1) as String) ++ ")")) joinBy ";\n"]]]></db:sql>
        </db:execute-script>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{n: sizeOf(payload), sum: sum(payload)}]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>
    <flow name="script-tx-count">
        <http:listener config-ref="L" path="/script-tx-count"/>
        <db:select config-ref="Pg">
            <db:sql>SELECT count(*) AS c, coalesce(max(id), 0) AS m FROM script_t</db:sql>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload[0]]]></ee:set-payload></ee:message></ee:transform>
    </flow>
    <!-- n 組の INSERT (id は from から)。dup が 0 でなければ dup 番目 (1 から) の組の id を from にする (重複で失敗) -->
    <flow name="bulk-tx-n">
        <http:listener config-ref="L" path="/bulk-tx-n"/>
        <db:bulk-insert config-ref="Pg">
            <db:bulk-input-parameters><![CDATA[#[%dw 2.0
var q = attributes.queryParams
var from = q.from as Number
---
(1 to (q.n as Number)) map ((i) -> {id: if (i == (q.dup default "0") as Number) from else from + i - 1})]]]></db:bulk-input-parameters>
            <db:sql>INSERT INTO script_t VALUES (:id)</db:sql>
        </db:bulk-insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{n: sizeOf(payload), sum: sum(payload)}]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>

    <!-- queryTimeout / queryTimeoutUnit: かかった時間は 1.5 秒より速いか (fast / slow) だけを返す -->
