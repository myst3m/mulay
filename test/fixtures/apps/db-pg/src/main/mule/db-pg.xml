    <error-handler name="qt-report">
        <on-error-continue>
            <set-payload value="#[output application/json --- {'type': error.errorType.namespace ++ ':' ++ error.errorType.identifier, description: error.description, speed: if (((now() as Number {unit: 'milliseconds'}) - (vars.t0 as Number {unit: 'milliseconds'})) &lt; 1500) 'fast' else 'slow'}]"/>
