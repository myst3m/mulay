%%% note
flow-ref と sub-flow: flow / sub-flow の呼び出しで payload と変数が呼び出し元に戻ること、
target と targetValue、名前を式で決める (存在しない名前のとき)、呼ばれた flow の
on-error-continue (呼び出し元は正常に続く) と on-error-propagate (呼び出し元へ伝わる。
propagate 中に書いた変数が見えるか)、sub-flow のエラーは呼び出し元のハンドラが扱う。
%%% port 18116
%%% mask
DynamicFlowRefMessageProcessor@([0-9a-f]+)
%%% request POST /chain
Content-Type: application/json

{"in": 1}
%%% response 200
content-type: application/json; charset=UTF-8

{
  "trail": [
    "main",
    "flow-b",
    "sub-a",
    "main-after"
  ],
  "setInB": "visible-after-return",
  "payload": {
    "from": "sub-a",
    "was": {
      "in": 1
    }
  }
}
%%% request GET /target
%%% response 200
content-type: application/json; charset=UTF-8

{
  "payload": "original",
  "result": {
    "from": "sub-a",
    "was": "original"
  },
  "onlyFrom": "sub-a",
  "trail": [
    
  ]
}
%%% request GET /dynamic/add-a
%%% response 200
content-type: application/json; charset=UTF-8

{
  "trail": [
    "sub-a"
  ],
  "payload": {
    "from": "sub-a",
    "was": ""
  }
}
%%% request GET /dynamic/private-b
%%% response 200
content-type: application/json; charset=UTF-8

{
  "trail": [
    "flow-b",
    "sub-a"
  ],
  "payload": {
    "from": "sub-a",
    "was": ""
  }
}
%%% request GET /dynamic/does-not-exist
%%% response 500
content-type: text/plain; charset=UTF-8

No flow/sub-flow with name 'does-not-exist' found. Failed to route event via endpoint: org.mule.runtime.config.internal.factories.FlowRefFactoryBean$DynamicFlowRefMessageProcessor@***
%%% request GET /errors/child-continues
%%% response 200
content-type: application/json; charset=UTF-8

{
  "continued": true,
  "payload": "child recovered"
}
%%% request GET /errors/child-propagates
%%% response 200
content-type: application/json; charset=UTF-8

{
  "caughtInCaller": "APP:CHILD",
  "description": "child failed",
  "childHandlerRan": true
}
%%% request GET /errors/sub-fails
%%% response 200
content-type: application/json; charset=UTF-8

{
  "caughtInCaller": "APP:SUB",
  "description": "sub-flow failed",
  "childHandlerRan": false
}
