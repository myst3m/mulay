<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:batch="http://www.mulesoft.org/schema/mule/batch"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/db http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/batch http://www.mulesoft.org/schema/mule/batch/current/mule-batch.xsd">

    <http:listener-config name="L">
        <http:listener-connection host="0.0.0.0" port="18174"/>
    </http:listener-config>

    <db:config name="Pg">
        <db:generic-connection url="jdbc:sqlite:file:mulaytest?mode=memory&amp;cache=shared" driverClassName="org.sqlite.JDBC">
            <!-- インメモリ DB は最後の接続が閉じると消えるので、接続を 1 本持ち続ける -->
            <db:pooling-profile minPoolSize="1" maxPoolSize="1"/>
        </db:generic-connection>
    </db:config>

    <!-- 接続 1 本で待ちは 500 ms (select のストリームが接続を持つことを見る。同じ共有キャッシュの DB) -->
    <db:config name="SqOne">
        <db:generic-connection url="jdbc:sqlite:file:mulaytest?mode=memory&amp;cache=shared" driverClassName="org.sqlite.JDBC">
            <db:pooling-profile minPoolSize="1" maxPoolSize="1" maxWait="500" maxWaitUnit="MILLISECONDS"/>
        </db:generic-connection>
    </db:config>

    <!-- 要求の後で読む (async、batch:job) 結果を書く -->
    <db:config name="Aw">
        <db:generic-connection url="jdbc:sqlite:file:mulaytest?mode=memory&amp;cache=shared" driverClassName="org.sqlite.JDBC">
            <db:pooling-profile minPoolSize="1" maxPoolSize="1"/>
        </db:generic-connection>
    </db:config>

    <error-handler name="report">
        <on-error-continue>
            <ee:transform>
                <ee:message>
                    <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{"type": error.errorType.namespace ++ ":" ++ error.errorType.identifier, description: error.description}]]></ee:set-payload>
                </ee:message>
            </ee:transform>
        </on-error-continue>
    </error-handler>

    <!-- 表を作り直す (シナリオの最初に呼ぶ) -->
    <flow name="reset">
        <http:listener config-ref="L" path="/reset"/>
        <db:execute-script config-ref="Pg">
            <db:sql><![CDATA[DROP TABLE IF EXISTS person;
CREATE TABLE person (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, age INTEGER, score REAL, active BOOLEAN, born DATE, seen TIMESTAMP, note NUMERIC, big INTEGER, blob BLOB);
INSERT INTO person (name, age, score, active, born, seen, note, big, blob) VALUES
 ('Ann', 30, 12.5, 1, '1996-01-02', '2026-09-30 10:11:12.345', '12.50', 9007199254740993, x'0102ff'),
 ('Bob', NULL, NULL, 0, NULL, NULL, NULL, NULL, NULL),
 ('Cid', 41, 100, 1, '1985-12-31', '2026-01-01 00:00:00', 7, -5, x'')]]></db:sql>
        </db:execute-script>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <!-- select の maxRows -->
    <flow name="select-max">
        <http:listener config-ref="L" path="/select-max"/>
        <db:select config-ref="Pg" maxRows="#[attributes.queryParams.n as Number]">
            <db:sql>SELECT id, name FROM person ORDER BY id</db:sql>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <!-- select: 行の値とその型 -->
    <flow name="select">
        <http:listener config-ref="L" path="/select"/>
        <db:select config-ref="Pg">
            <db:sql>SELECT * FROM person ORDER BY id</db:sql>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="select-types">
        <http:listener config-ref="L" path="/select-types"/>
        <db:select config-ref="Pg">
            <db:sql>SELECT * FROM person ORDER BY id</db:sql>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload map ((row) -> row mapObject ((v, k) -> {(k): {t: typeOf(v) as String, c: v.^class default null}}))]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="select-param">
        <http:listener config-ref="L" path="/select-param"/>
        <db:select config-ref="Pg">
            <db:sql>SELECT id, name FROM person WHERE age &gt; :min AND name &lt;&gt; :skip ORDER BY id</db:sql>
            <db:input-parameters><![CDATA[#[{min: attributes.queryParams.min as Number, skip: 'nobody'}]]]></db:input-parameters>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="insert">
        <http:listener config-ref="L" path="/insert"/>
        <db:insert config-ref="Pg" autoGenerateKeys="true">
            <db:sql>INSERT INTO person (name, age) VALUES (:name, :age)</db:sql>
            <db:input-parameters><![CDATA[#[{name: 'Dee', age: 22}]]]></db:input-parameters>
        </db:insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <!-- affectedRows は Integer。input-parameters に無いパラメータは MULE:UNKNOWN -->
    <flow name="update-class">
        <http:listener config-ref="L" path="/update-class"/>
        <db:update config-ref="Pg"><db:sql>UPDATE person SET age = age WHERE 1 = 0</db:sql></db:update>
        <set-payload value="#[output application/json --- {rows: payload.affectedRows, rowsClass: payload.affectedRows.^class default null}]"/>
    </flow>
    <flow name="err-unbound">
        <http:listener config-ref="L" path="/err-unbound"/>
        <db:select config-ref="Pg">
            <db:sql>SELECT * FROM person WHERE id = :x</db:sql>
            <db:input-parameters>#[{y: 1}]</db:input-parameters>
        </db:select>
        <set-payload value="#[output application/json --- payload]"/>
        <error-handler ref="report"/>
    </flow>

    <flow name="update">
        <http:listener config-ref="L" path="/update"/>
        <db:update config-ref="Pg">
            <db:sql>UPDATE person SET age = age + 1 WHERE age IS NOT NULL</db:sql>
        </db:update>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="delete">
        <http:listener config-ref="L" path="/delete"/>
        <db:delete config-ref="Pg">
            <db:sql>DELETE FROM person WHERE name = :n</db:sql>
            <db:input-parameters><![CDATA[#[{n: 'Dee'}]]]></db:input-parameters>
        </db:delete>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="bulk-insert">
        <http:listener config-ref="L" path="/bulk-insert"/>
        <db:bulk-insert config-ref="Pg">
            <db:bulk-input-parameters><![CDATA[#[[{name: 'E1', age: 1}, {name: 'E2', age: 2}]]]]></db:bulk-input-parameters>
            <db:sql>INSERT INTO person (name, age) VALUES (:name, :age)</db:sql>
        </db:bulk-insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="query-single">
        <http:listener config-ref="L" path="/query-single"/>
        <db:query-single config-ref="Pg">
            <db:sql>SELECT count(*) AS n, max(age) AS oldest FROM person</db:sql>
        </db:query-single>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <!-- 失敗: SQL の誤り、無い表、制約違反 -->
    <flow name="err-syntax">
        <http:listener config-ref="L" path="/err-syntax"/>
        <db:select config-ref="Pg"><db:sql>SELEC 1</db:sql></db:select>
        <error-handler ref="report"/>
    </flow>
    <flow name="err-table">
        <http:listener config-ref="L" path="/err-table"/>
        <db:select config-ref="Pg"><db:sql>SELECT * FROM nothing_here</db:sql></db:select>
        <error-handler ref="report"/>
    </flow>
    <flow name="err-constraint">
        <http:listener config-ref="L" path="/err-constraint"/>
        <db:insert config-ref="Pg"><db:sql>INSERT INTO person (name) VALUES (NULL)</db:sql></db:insert>
        <error-handler ref="report"/>
    </flow>
    <!-- execute-script の file (資源の SQL のファイル。UTF-8) -->
    <flow name="script-file">
        <http:listener config-ref="L" path="/script-file"/>
        <db:execute-script config-ref="Pg" file="sql/script-file.sql" target="counts"/>
        <db:select config-ref="Pg">
            <db:sql>SELECT id, name, note FROM script_file ORDER BY id</db:sql>
        </db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{counts: vars.counts, rows: payload}]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>
    <flow name="script-file-missing">
        <http:listener config-ref="L" path="/script-file-missing"/>
        <db:execute-script config-ref="Pg" file="sql/nothing-here.sql"/>
        <error-handler ref="report"/>
    </flow>

    <!-- execute-script の途中の文の失敗 -->
    <flow name="err-script">
        <http:listener config-ref="L" path="/err-script"/>
        <db:execute-script config-ref="Pg">
            <db:sql><![CDATA[UPDATE person SET age = age WHERE 1 = 0;
SELECT * FROM nothing_here;
UPDATE person SET age = age WHERE 1 = 0]]></db:sql>
        </db:execute-script>
        <error-handler ref="report"/>
    </flow>
    <flow name="err-script2">
        <http:listener config-ref="L" path="/err-script2"/>
        <db:execute-script config-ref="Pg">
            <db:sql><![CDATA[UPDATE person SET age = age WHERE 1 = 0;
INSERT INTO person (name) VALUES (NULL);
UPDATE person SET age = age WHERE 1 = 0]]></db:sql>
        </db:execute-script>
        <error-handler ref="report"/>
    </flow>
    <flow name="script-select">
        <http:listener config-ref="L" path="/script-select"/>
        <db:execute-script config-ref="Pg">
            <db:sql><![CDATA[UPDATE person SET age = age WHERE 1 = 0;
SELECT name FROM person WHERE 1 = 0]]></db:sql>
        </db:execute-script>
        <error-handler ref="report"/>
    </flow>
    <!-- トランザクション: try の transactionalAction -->
    <flow name="tx-ok">
        <http:listener config-ref="L" path="/tx-ok"/>
        <try transactionalAction="ALWAYS_BEGIN">
            <db:insert config-ref="Pg"><db:sql>INSERT INTO person (name) VALUES ('T1')</db:sql></db:insert>
            <db:insert config-ref="Pg"><db:sql>INSERT INTO person (name) VALUES ('T2')</db:sql></db:insert>
        </try>
        <db:select config-ref="Pg"><db:sql>SELECT name FROM person WHERE name LIKE 'T%' ORDER BY name</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="tx-rollback">
        <http:listener config-ref="L" path="/tx-rollback"/>
        <try>
            <try transactionalAction="ALWAYS_BEGIN">
                <db:insert config-ref="Pg"><db:sql>INSERT INTO person (name) VALUES ('R1')</db:sql></db:insert>
                <raise-error type="APP:FAIL" description="fail in tx"/>
            </try>
            <error-handler><on-error-continue><set-payload value="#['caught']"/></on-error-continue></error-handler>
        </try>
        <db:select config-ref="Pg"><db:sql>SELECT name FROM person WHERE name LIKE 'R%' ORDER BY name</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="tx-continue">
        <http:listener config-ref="L" path="/tx-continue"/>
        <try transactionalAction="ALWAYS_BEGIN">
            <db:insert config-ref="Pg"><db:sql>INSERT INTO person (name) VALUES ('C1')</db:sql></db:insert>
            <raise-error type="APP:FAIL" description="fail in tx"/>
            <error-handler><on-error-continue><set-payload value="#['continued']"/></on-error-continue></error-handler>
        </try>
        <db:select config-ref="Pg"><db:sql>SELECT name FROM person WHERE name LIKE 'C%' ORDER BY name</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="tx-notsupported">
        <http:listener config-ref="L" path="/tx-notsupported"/>
        <try>
            <try transactionalAction="ALWAYS_BEGIN">
                <db:insert config-ref="Pg" transactionalAction="NOT_SUPPORTED"><db:sql>INSERT INTO person (name) VALUES ('N1')</db:sql></db:insert>
                <db:insert config-ref="Pg"><db:sql>INSERT INTO person (name) VALUES ('N2')</db:sql></db:insert>
                <raise-error type="APP:FAIL" description="fail in tx"/>
            </try>
            <error-handler><on-error-continue><set-payload value="#['caught']"/></on-error-continue></error-handler>
        </try>
        <db:select config-ref="Pg"><db:sql>SELECT name FROM person WHERE name LIKE 'N%' ORDER BY name</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="tx-sees-own">
        <http:listener config-ref="L" path="/tx-sees-own"/>
        <try transactionalAction="ALWAYS_BEGIN">
            <db:insert config-ref="Pg"><db:sql>INSERT INTO person (name) VALUES ('S1')</db:sql></db:insert>
            <db:select config-ref="Pg"><db:sql>SELECT count(*) AS n FROM person WHERE name = 'S1'</db:sql></db:select>
            <set-variable variableName="inside" value="#[payload[0].n]"/>
            <raise-error type="APP:FAIL" description="undo"/>
            <error-handler><on-error-propagate/></error-handler>
        </try>
        <error-handler>
            <on-error-continue>
                <db:select config-ref="Pg"><db:sql>SELECT count(*) AS n FROM person WHERE name = 'S1'</db:sql></db:select>
                <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{inside: vars.inside, after: payload[0].n}]]></ee:set-payload></ee:message></ee:transform>
            </on-error-continue>
        </error-handler>
    </flow>

    <!-- bulk 操作: 件数の配列、途中の行の失敗 (それまでの行が残るか)、空の入力、トランザクションの中の失敗 -->
    <flow name="bulk-setup">
        <http:listener config-ref="L" path="/bulk-setup"/>
        <db:execute-script config-ref="Pg">
            <db:sql><![CDATA[DROP TABLE IF EXISTS bulk_t;
CREATE TABLE bulk_t (id INTEGER PRIMARY KEY, name VARCHAR(20) NOT NULL, n INTEGER DEFAULT 0)]]></db:sql>
        </db:execute-script>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="bulk-rows">
        <http:listener config-ref="L" path="/bulk-rows"/>
        <db:select config-ref="Pg"><db:sql>SELECT id, name, n FROM bulk_t ORDER BY id</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload map {id: $.id default $.ID, name: $.name default $.NAME, n: $.n default $.N}]]></ee:set-payload></ee:message></ee:transform>
    </flow>

    <flow name="bulk-ok">
        <http:listener config-ref="L" path="/bulk-ok"/>
        <db:bulk-insert config-ref="Pg">
            <db:bulk-input-parameters><![CDATA[#[[{id: 1, name: 'a'}, {id: 2, name: 'b'}, {id: 3, name: 'c'}, {id: 4, name: 'd'}]]]]></db:bulk-input-parameters>
            <db:sql>INSERT INTO bulk_t (id, name) VALUES (:id, :name)</db:sql>
        </db:bulk-insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>
    <flow name="bulk-upd">
        <http:listener config-ref="L" path="/bulk-upd"/>
        <db:bulk-update config-ref="Pg">
            <db:bulk-input-parameters><![CDATA[#[[{min: 1}, {min: 3}, {min: 99}]]]]></db:bulk-input-parameters>
            <db:sql>UPDATE bulk_t SET n = n + 1 WHERE id &gt;= :min</db:sql>
        </db:bulk-update>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>
    <flow name="bulk-null">
        <http:listener config-ref="L" path="/bulk-null"/>
        <db:bulk-insert config-ref="Pg">
            <db:bulk-input-parameters><![CDATA[#[[{id: 10, name: 'x'}, {id: 11, name: null}, {id: 12, name: 'z'}]]]]></db:bulk-input-parameters>
            <db:sql>INSERT INTO bulk_t (id, name) VALUES (:id, :name)</db:sql>
        </db:bulk-insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>
    <flow name="bulk-dup">
        <http:listener config-ref="L" path="/bulk-dup"/>
        <db:bulk-insert config-ref="Pg">
            <db:bulk-input-parameters><![CDATA[#[[{id: 20, name: 'p'}, {id: 1, name: 'dup'}, {id: 21, name: 'q'}]]]]></db:bulk-input-parameters>
            <db:sql>INSERT INTO bulk_t (id, name) VALUES (:id, :name)</db:sql>
        </db:bulk-insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>
    <flow name="bulk-empty">
        <http:listener config-ref="L" path="/bulk-empty"/>
        <db:bulk-insert config-ref="Pg">
            <db:bulk-input-parameters><![CDATA[#[[]]]]></db:bulk-input-parameters>
            <db:sql>INSERT INTO bulk_t (id, name) VALUES (:id, :name)</db:sql>
        </db:bulk-insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>
    <flow name="bulk-del">
        <http:listener config-ref="L" path="/bulk-del"/>
        <db:bulk-delete config-ref="Pg">
            <db:bulk-input-parameters><![CDATA[#[[{id: 2}, {id: 99}, {id: 3}]]]]></db:bulk-input-parameters>
            <db:sql>DELETE FROM bulk_t WHERE id = :id</db:sql>
        </db:bulk-delete>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>
    <flow name="bulk-tx">
        <http:listener config-ref="L" path="/bulk-tx"/>
        <try>
            <try transactionalAction="ALWAYS_BEGIN">
                <db:bulk-insert config-ref="Pg">
                    <db:bulk-input-parameters><![CDATA[#[[{id: 30, name: 't1'}, {id: 31, name: 't2'}]]]]></db:bulk-input-parameters>
                    <db:sql>INSERT INTO bulk_t (id, name) VALUES (:id, :name)</db:sql>
                </db:bulk-insert>
                <db:bulk-insert config-ref="Pg">
                    <db:bulk-input-parameters><![CDATA[#[[{id: 32, name: 't3'}, {id: 30, name: 'dup'}]]]]></db:bulk-input-parameters>
                    <db:sql>INSERT INTO bulk_t (id, name) VALUES (:id, :name)</db:sql>
                </db:bulk-insert>
            </try>
            <error-handler><on-error-continue><set-payload value="#['caught']"/></on-error-continue></error-handler>
        </try>
        <db:select config-ref="Pg"><db:sql>SELECT COUNT(*) AS c FROM bulk_t WHERE id &gt;= 30</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload[0].c default payload[0].C]]></ee:set-payload></ee:message></ee:transform>
    </flow>
    <flow name="bulk-notable">
        <http:listener config-ref="L" path="/bulk-notable"/>
        <db:bulk-insert config-ref="Pg">
            <db:bulk-input-parameters><![CDATA[#[[{id: 1}, {id: 2}]]]]></db:bulk-input-parameters>
            <db:sql>INSERT INTO no_such_table (id) VALUES (:id)</db:sql>
        </db:bulk-insert>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>
    <!-- select の結果は行のストリーム: 読まないまま同じ設定で select すると接続を待って失敗する -->
    <flow name="stream-unread">
        <http:listener config-ref="L" path="/stream-unread"/>
        <db:select config-ref="SqOne"><db:sql>SELECT 1 AS a</db:sql></db:select>
        <db:select config-ref="SqOne" target="second"><db:sql>SELECT 2 AS a</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{first: payload, second: vars.second}]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="stream-read">
        <http:listener config-ref="L" path="/stream-read"/>
        <db:select config-ref="SqOne"><db:sql>SELECT 1 AS a</db:sql></db:select>
        <set-variable variableName="first" value="#[output application/json --- payload]"/>
        <db:select config-ref="SqOne"><db:sql>SELECT 2 AS a</db:sql></db:select>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{first: vars.first, second: payload}]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="stream-foreach">
        <http:listener config-ref="L" path="/stream-foreach"/>
        <db:select config-ref="SqOne" fetchSize="3"><db:sql>WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n &lt; 10) SELECT n FROM c</db:sql></db:select>
        <set-variable variableName="sizes" value="#[[]]"/>
        <foreach batchSize="4">
            <set-variable variableName="sizes" value="#[vars.sizes + {size: sizeOf(payload), first: payload[0].n, cls: payload[0].^class default 'none'}]"/>
        </foreach>
        <ee:transform><ee:message><ee:set-payload><![CDATA[%dw 2.0
output application/json
---
vars.sizes]]></ee:set-payload></ee:message></ee:transform>
        <error-handler ref="report"/>
    </flow>

    <flow name="stream-foreach-inner">
        <http:listener config-ref="L" path="/stream-foreach-inner"/>
        <db:select config-ref="SqOne"><db:sql>WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n &lt; 3) SELECT n FROM c</db:sql></db:select>
        <foreach>
            <db:select config-ref="SqOne"><db:sql>SELECT 9 AS a</db:sql></db:select>
        </foreach>
        <set-payload value='#[output application/json --- "done"]'/>
        <error-handler ref="report"/>
    </flow>

    <!-- 途中まで読んだ (foreach の中で止まった) ストリームの接続も、要求の終わりに返る -->
    <flow name="stream-partial">
        <http:listener config-ref="L" path="/stream-partial"/>
        <db:select config-ref="SqOne"><db:sql>WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n &lt; 10) SELECT n FROM c</db:sql></db:select>
        <foreach>
            <raise-error type="APP:STOP" description="#['stop at ' ++ (payload.n as String)]"/>
        </foreach>
        <error-handler ref="report"/>
    </flow>

    <flow name="stream-after">
        <http:listener config-ref="L" path="/stream-after"/>
        <db:select config-ref="SqOne"><db:sql>SELECT 3 AS a</db:sql></db:select>
        <set-payload value="#[output application/json --- payload]"/>
        <error-handler ref="report"/>
    </flow>

    <!-- 要求が終わった後で select の結果を読む: async の payload と、batch:job の記録の変数 (要求の変数から) -->
    <flow name="stream-later">
        <http:listener config-ref="L" path="/stream-later"/>
        <db:execute-ddl config-ref="Aw"><db:sql>CREATE TABLE IF NOT EXISTS later_out (k TEXT, n INTEGER, d TEXT)</db:sql></db:execute-ddl>
        <db:delete config-ref="Aw"><db:sql>DELETE FROM later_out</db:sql></db:delete>
        <db:select config-ref="Pg"><db:sql>WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n &lt; 5) SELECT n FROM c</db:sql></db:select>
        <set-variable variableName="lk" value="#[payload]"/>
        <async>
            <set-variable variableName="w" value="#[dw::Runtime::wait(1, 300)]"/>
            <try>
                <db:insert config-ref="Aw">
                    <db:sql>INSERT INTO later_out VALUES ('async', :n, '')</db:sql>
                    <db:input-parameters>#[{n: sum(payload.n)}]</db:input-parameters>
                </db:insert>
                <error-handler>
                    <on-error-continue>
                        <db:insert config-ref="Aw">
                            <db:sql>INSERT INTO later_out VALUES ('async', -1, :d)</db:sql>
                            <db:input-parameters>#[{d: error.errorType.namespace ++ ":" ++ error.errorType.identifier}]</db:input-parameters>
                        </db:insert>
                    </on-error-continue>
                </error-handler>
            </try>
        </async>
        <set-payload value="#[[1, 2]]"/>
        <batch:job jobName="later-job">
            <batch:process-records>
                <batch:step name="s1">
                    <set-variable variableName="w" value="#[dw::Runtime::wait(1, 300)]"/>
                    <db:insert config-ref="Aw">
                        <db:sql>INSERT INTO later_out VALUES ('batch', :n, '')</db:sql>
                        <db:input-parameters>#[{n: payload * 100 + sum(vars.lk.n)}]</db:input-parameters>
                    </db:insert>
                </batch:step>
                <batch:step name="s2" acceptPolicy="ONLY_FAILURES">
                    <db:insert config-ref="Aw">
                        <db:sql>INSERT INTO later_out VALUES ('batch', -1, 'failed')</db:sql>
                    </db:insert>
                </batch:step>
            </batch:process-records>
        </batch:job>
        <set-payload value='#[output application/json --- "started"]'/>
        <error-handler ref="report"/>
    </flow>

    <flow name="stream-later-check">
        <http:listener config-ref="L" path="/stream-later-check"/>
        <set-variable variableName="w" value="#[dw::Runtime::wait(1, 1500)]"/>
        <db:select config-ref="Aw"><db:sql>SELECT k, n, d FROM later_out ORDER BY k, n</db:sql></db:select>
        <set-payload value="#[output application/json --- payload]"/>
        <error-handler ref="report"/>
    </flow>

    <!-- queryTimeout / queryTimeoutUnit: かかった時間は 1.5 秒より速いか (fast / slow) だけを返す -->
    <error-handler name="qt-report">
        <on-error-continue>
            <set-payload value="#[output application/json --- {'type': error.errorType.namespace ++ ':' ++ error.errorType.identifier, description: error.description, speed: if (((now() as Number {unit: 'milliseconds'}) - (vars.t0 as Number {unit: 'milliseconds'})) &lt; 1500) 'fast' else 'slow'}]"/>
        </on-error-continue>
    </error-handler>
    <flow name="qt-select-ok">
        <http:listener config-ref="L" path="/qt/select-ok"/>
        <set-variable variableName="t0" value="#[now()]"/>
        <db:select config-ref="Pg" queryTimeout="5"><db:sql>SELECT 1 AS x</db:sql></db:select>
        <set-payload value="#[output application/json --- {result: payload, speed: if (((now() as Number {unit: 'milliseconds'}) - (vars.t0 as Number {unit: 'milliseconds'})) &lt; 1500) 'fast' else 'slow'}]"/>
        <error-handler ref="qt-report"/>
    </flow>



</mule>
