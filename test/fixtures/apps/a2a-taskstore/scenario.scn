      "json": "{\n  \"historyLength\": 2,\n  \"streamingContext\": null,\n  \"contextId\": \"<uuid>\",\n  \"history\": \"[{\\\"role\\\":\\\"user\\\",\\\"parts\\\":[{\\\"text\\\":\\\"work\\\",\\\"kind\\\":\\\"text\\\"}],\\\"messageId\\\":\\\"u\\\",\\\"kind\\\":\\\"message\\\"},null]\",\n  \"taskState\": \"working\",\n  \"task\": \"{\\\"id\\\":\\\"<uuid>\\\",\\\"contextId\\\":\\\"<uuid>\\\",\\\"status\\\":{\\\"state\\\":\\\"working\\\",\\\"timestamp\\\":\\\"<ts>\\\"},\\\"artifacts\\\":[],\\\"history\\\":[],\\\"kind\\\":\\\"task\\\"}\",\n  \"pushNotificationConfigs\": [\n    {\n      \"proxyConfig\": null,\n      \"timeout\": 2000,\n      \"url\": \"http://localhost:18199/hook\",\n      \"token\": \"tk\",\n      \"additionalHeaders\": {\n        \n      },\n      \"id\": \"<uuid>\",\n      \"authentication\": null\n    }\n  ]\n}"
