%%% note
<a2a:history taskRepositoryObjectStore>: タスクの記録を Object Store にしまう。キーは task-<taskId> (TaskRepositoryItem) と
context-<contextId> (ContextRepositoryItem)。値は Java のオブジェクトで、DW で読むと ^class とフィールドが見える。
ストリームのイベントは streamingContext.bufferedEvents に入る。店が正本なので、task- を消すと tasks/get は "Task not found"。
UUID と時刻とホスト名は伏せる。
%%% port 18199
%%% request GET /t/clear
%%% response 200

cleared
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":1,"method":"message/send","params":{"message":{"kind":"message","role":"user","messageId":"u","parts":[{"kind":"text","text":"work"}]}}}

%%% response 200
content-type: text/plain; charset=UTF-8

{"jsonrpc":"2.0","id":1,"result":{"id":"<tid>","contextId":"<uuid>","status":{"state":"working","timestamp":"<ts>"},"artifacts":[],"history":[],"kind":"task"}}
%%% request GET /t/store
%%% response 200
content-type: application/json; charset=UTF-8

{
  "n": 2,
  "entries": [
    {
      "key": "context-<uuid>",
      "type": "Object",
      "cls": "com.mulesoft.connectors.a2a.internal.server.agent.repository.ContextRepositoryItem",
      "json": "{\n  \"contextId\": \"<uuid>\"\n}"
    },
    {
      "key": "task-<uuid>",
      "type": "Object",
      "cls": "com.mulesoft.connectors.a2a.internal.server.agent.repository.TaskRepositoryItem",
      "json": "{\n  \"historyLength\": 2,\n  \"streamingContext\": null,\n  \"contextId\": \"<uuid>\",\n  \"history\": \"[{\\\"role\\\":\\\"user\\\",\\\"parts\\\":[{\\\"text\\\":\\\"work\\\",\\\"kind\\\":\\\"text\\\"}],\\\"messageId\\\":\\\"u\\\",\\\"kind\\\":\\\"message\\\"},null]\",\n  \"taskState\": \"working\",\n  \"task\": \"{\\\"id\\\":\\\"<uuid>\\\",\\\"contextId\\\":\\\"<uuid>\\\",\\\"status\\\":{\\\"state\\\":\\\"working\\\",\\\"timestamp\\\":\\\"<ts>\\\"},\\\"artifacts\\\":[],\\\"history\\\":[],\\\"kind\\\":\\\"task\\\"}\",\n  \"pushNotificationConfigs\": [\n    \n  ]\n}"
    }
  ]
}
%%% request GET /t/clear
%%% response 200

cleared
%%% request POST /t/rpc
Content-Type: text/plain

{"jsonrpc":"2.0","id":2,"method":"message/stream","params":{"message":{"kind":"message","role":"user","messageId":"u","parts":[{"kind":"text","text":"s"}]}}}

%%% response 200
content-type: text/plain; charset=UTF-8

event: task
data: {"jsonrpc":"2.0","id":"2","result":{"id":"<uuid>","contextId":"<uuid>","status":{"state":"submitted","timestamp":"<ts>"},"artifacts":[],"history":[],"kind":"task"}}

event: status-update
data: {"jsonrpc":"2.0","id":"2","result":{"taskId":"<uuid>","status":{"state":"working","timestamp":"<ts>"},"contextId":"<uuid>","final":false,"kind":"status-update"}}

event: artifact-update
data: {"jsonrpc":"2.0","id":"2","result":{"taskId":"<uuid>","artifact":{"artifactId":"a1","parts":[{"text":"chunk","kind":"text"}]},"contextId":"<uuid>","lastChunk":true,"kind":"artifact-update"}}

event: status-update
data: {"jsonrpc":"2.0","id":"2","result":{"taskId":"<uuid>","status":{"state":"completed","timestamp":"<ts>"},"contextId":"<uuid>","final":true,"kind":"status-update"}}


%%% request GET /t/store
%%% response 200
content-type: application/json; charset=UTF-8

{
  "n": 2,
  "entries": [
    {
      "key": "context-<uuid>",
      "type": "Object",
      "cls": "com.mulesoft.connectors.a2a.internal.server.agent.repository.ContextRepositoryItem",
      "json": "{\n  \"contextId\": \"<uuid>\"\n}"
    },
    {
      "key": "task-<uuid>",
      "type": "Object",
      "cls": "com.mulesoft.connectors.a2a.internal.server.agent.repository.TaskRepositoryItem",
      "json": "{\n  \"historyLength\": 2,\n  \"streamingContext\": {\n    \"bufferedEvents\": [\n      {\n        \"eventId\": \"<uuid>\",\n        \"eventType\": \"status-update\",\n        \"eventData\": \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":\\\"2\\\",\\\"result\\\":{\\\"taskId\\\":\\\"<uuid>\\\",\\\"status\\\":{\\\"state\\\":\\\"working\\\",\\\"timestamp\\\":\\\"<ts>\\\"},\\\"contextId\\\":\\\"<uuid>\\\",\\\"final\\\":false,\\\"kind\\\":\\\"status-update\\\"}}\"\n      },\n      {\n        \"eventId\": \"<uuid>\",\n        \"eventType\": \"artifact-update\",\n        \"eventData\": \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":\\\"2\\\",\\\"result\\\":{\\\"taskId\\\":\\\"<uuid>\\\",\\\"artifact\\\":{\\\"artifactId\\\":\\\"a1\\\",\\\"parts\\\":[{\\\"text\\\":\\\"chunk\\\",\\\"kind\\\":\\\"text\\\"}]},\\\"contextId\\\":\\\"<uuid>\\\",\\\"lastChunk\\\":true,\\\"kind\\\":\\\"artifact-update\\\"}}\"\n      },\n      {\n        \"eventId\": \"<uuid>\",\n        \"eventType\": \"status-update\",\n        \"eventData\": \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":\\\"2\\\",\\\"result\\\":{\\\"taskId\\\":\\\"<uuid>\\\",\\\"status\\\":{\\\"state\\\":\\\"completed\\\",\\\"timestamp\\\":\\\"<ts>\\\"},\\\"contextId\\\":\\\"<uuid>\\\",\\\"final\\\":true,\\\"kind\\\":\\\"status-update\\\"}}\"\n      }\n    ],\n    \"workerInstanceId\": \"<worker>\",\n    \"requestId\": \"2\"\n  },\n  \"contextId\": \"<uuid>\",\n  \"history\": \"[null,null]\",\n  \"taskState\": \"completed\",\n  \"task\": \"{\\\"id\\\":\\\"<uuid>\\\",\\\"contextId\\\":\\\"<uuid>\\\",\\\"status\\\":{\\\"state\\\":\\\"completed\\\",\\\"timestamp\\\":\\\"<ts>\\\"},\\\"artifacts\\\":[{\\\"artifactId\\\":\\\"a1\\\",\\\"parts\\\":[{\\\"text\\\":\\\"chunk\\\",\\\"kind\\\":\\\"text\\\"}]}],\\\"history\\\":[],\\\"kind\\\":\\\"task\\\"}\",\n  \"pushNotificationConfigs\": [\n    \n  ]\n}"
    }
  ]
}
