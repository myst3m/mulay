<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http">
    <http:listener-config name="L"><http:listener-connection host="0.0.0.0" port="8081"/></http:listener-config>
    <flow name="rec">
        <http:listener config-ref="L" path="/rec"/>
        <ee:transform>
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
fun f(n) = if (n <= 0) 0 else ([n] map (f(n - 1) + $))[0]
---
f(payload.n)]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
</mule>
