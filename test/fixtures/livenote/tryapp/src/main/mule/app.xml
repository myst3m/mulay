<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:http="http://www.mulesoft.org/schema/mule/http">
  <http:listener-config name="L"><http:listener-connection host="0.0.0.0" port="8081"/></http:listener-config>
  <flow name="f">
    <http:listener config-ref="L" path="/t"/>
    <try>
      <raise-error type="APP:B"/>
      <error-handler>
        <on-error-continue type="APP:A"><logger/></on-error-continue>
        <on-error-continue type="APP:B"/>
      </error-handler>
    </try>
    <try>
      <logger/>
      <error-handler><on-error-continue/></error-handler>
    </try>
    <raise-error type="APP:C"/>
    <error-handler>
      <on-error-propagate type="APP:C"/>
    </error-handler>
  </flow>
</mule>
