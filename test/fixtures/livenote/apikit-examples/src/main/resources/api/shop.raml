#%RAML 1.0
title: shop
mediaType: application/json
types:
  Item:
    type: object
    properties:
      id: integer
    example:
      id: 3
/items:
  get:
    queryParameters:
      limit:
        type: integer
        example: 5
      sort: string
    responses:
      200:
        body:
          application/json:
            example: !include examples/items.json
  post:
    body:
      type: Item
    responses:
      201:
        body:
          type: Item
      400:
        body:
          text/plain:
            examples:
              a: bad request
/orders:
  post:
    headers:
      X-Tenant:
        type: string
    body:
      type: object
      properties:
        orderId:
          type: string
          pattern: ^ORD-[0-9]{4}$
        when: datetime-only
        tags: string[]
        note?: string
    responses:
      201:
