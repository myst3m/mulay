<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:db="http://www.mulesoft.org/schema/mule/db">
  <http:listener-config name="L"><http:listener-connection host="0.0.0.0" port="8081"/></http:listener-config>
  <db:config name="orders-db"><db:oracle-connection host="db.example.com" port="1521" serviceName="ORCL" user="shop" password="x"/></db:config>
  <db:config name="other-db"><db:my-sql-connection host="db2.example.com" port="3306" database="other" user="u" password="x"/></db:config>
  <db:config name="pg-db"><db:generic-connection url="jdbc:postgresql://pg.example.com:5432/shop" user="u" password="x"/></db:config>
  <flow name="f">
    <http:listener config-ref="L" path="/f"/>
    <db:select config-ref="orders-db"><db:sql>SELECT id, tierr FROM orders WHERE id = :id</db:sql></db:select>
    <db:insert config-ref="orders-db"><db:sql>INSERT INTO orderz (id) VALUES (:id)</db:sql></db:insert>
    <db:select config-ref="orders-db"><db:sql>#["SELECT nope FROM orders"]</db:sql></db:select>
    <db:select config-ref="orders-db"><db:sql>SELECT id, item FROM orders</db:sql></db:select>
    <db:select config-ref="other-db"><db:sql>SELECT nope FROM nowhere</db:sql></db:select>
    <db:select config-ref="pg-db"><db:sql>SELECT id, tier FROM customers WHERE id = :id</db:sql></db:select>
  </flow>
</mule>
