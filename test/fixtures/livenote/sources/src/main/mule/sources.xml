<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:vm="http://www.mulesoft.org/schema/mule/vm"
      xmlns:file="http://www.mulesoft.org/schema/mule/file" xmlns:sftp="http://www.mulesoft.org/schema/mule/sftp"
      xmlns:anypoint-mq="http://www.mulesoft.org/schema/mule/anypoint-mq">
  <vm:config name="V"><vm:queues><vm:queue queueName="orders"/></vm:queues></vm:config>
  <file:config name="F"/>
  <sftp:config name="S"><sftp:connection host="localhost" port="22" username="u" password="p"/></sftp:config>
  <anypoint-mq:config name="Q"><anypoint-mq:connection clientId="a" clientSecret="b"/></anypoint-mq:config>
  <flow name="vm-in">
    <vm:listener config-ref="V" queueName="orders"/>
    <set-payload value="#[output application/json --- {p: payload, a: attributes}]"/>
  </flow>
  <flow name="file-in">
    <file:listener config-ref="F" directory="/in">
      <scheduling-strategy><fixed-frequency frequency="1000"/></scheduling-strategy>
    </file:listener>
    <set-payload value="#[output application/json --- {p: payload, a: attributes - 'lastModifiedTime' - 'lastAccessTime' - 'creationTime', t: typeOf(attributes.lastModifiedTime)}]"/>
  </flow>
  <flow name="sftp-in">
    <sftp:listener config-ref="S" directory="/up">
      <scheduling-strategy><fixed-frequency frequency="1000"/></scheduling-strategy>
    </sftp:listener>
    <set-payload value="#[output application/json --- attributes - 'timestamp']"/>
  </flow>
  <flow name="mq-in">
    <anypoint-mq:subscriber config-ref="Q" destination="q"/>
    <set-payload value="#[output application/json --- attributes]"/>
  </flow>
</mule>
