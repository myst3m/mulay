<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:http="http://www.mulesoft.org/schema/mule/http">
  <http:listener-config name="L"><http:listener-connection host="0.0.0.0" port="8081"/></http:listener-config>
  <flow name="f">
    <http:listener config-ref="L" path="/l"/>
    <logger level="INFO" message="#['LOGMARK-' ++ payload.customer]"/>
    <logger level="INFO" category="orders" message="#['custom ' ++ payload.customer]"/>
    <logger level="WARN" category="orders" message="warned"/>
    <logger level="DEBUG" category="orders" message="#[1 / 0]"/>
    <set-payload value="done"/>
  </flow>
</mule>
