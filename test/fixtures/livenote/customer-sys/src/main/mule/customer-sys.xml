<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:http="http://www.mulesoft.org/schema/mule/http">
  <http:listener-config name="L"><http:listener-connection host="0.0.0.0" port="8082"/></http:listener-config>
  <flow name="customer">
    <http:listener config-ref="L" path="/api/customers/{id}" allowedMethods="POST">
      <http:response><http:headers>#[{'x-from': 'customer-sys'}]</http:headers></http:response>
    </http:listener>
    <set-payload value="#[output application/json --- {id: attributes.uriParams.id, order: payload.order, tenant: attributes.headers.'x-tenant', v: attributes.queryParams.v}]"/>
  </flow>
</mule>
