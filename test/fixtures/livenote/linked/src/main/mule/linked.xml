<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation">
  <http:listener-config name="L"><http:listener-connection host="0.0.0.0" port="8081"/></http:listener-config>
  <http:request-config name="customer-sys"><http:request-connection host="customer-sys" port="8082"/></http:request-config>
  <flow name="orders">
    <http:listener config-ref="L" path="/orders/{id}"/>
    <http:request config-ref="customer-sys" method="POST" path="/api/customers/{cid}" doc:id="call1">
      <http:body>#[output application/json --- {order: attributes.uriParams.id}]</http:body>
      <http:headers>#[{'X-Tenant': 'acme'}]</http:headers>
      <http:uri-params>#[{cid: 42}]</http:uri-params>
      <http:query-params>#[{v: '1 2'}]</http:query-params>
    </http:request>
    <set-payload value="#[output application/json --- {got: payload, st: attributes.statusCode, h: attributes.headers.'x-from'}]"/>
    <error-handler>
      <on-error-continue type="HTTP:NOT_FOUND">
        <set-payload value="#[error.description]"/>
      </on-error-continue>
    </error-handler>
  </flow>
  <flow name="bin">
    <http:listener config-ref="L" path="/bin"/>
    <http:request config-ref="customer-sys" method="PUT" path="/blob">
      <http:body>#[%dw 2.0 import fromBase64 from dw::core::Binaries --- fromBase64('/wBB')]</http:body>
    </http:request>
    <set-payload value="#[%dw 2.0 import toBase64 from dw::core::Binaries --- toBase64(payload as Binary)]"/>
  </flow>
</mule>
