<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:http="http://www.mulesoft.org/schema/mule/http">
  <global-property name="env" value="local"/>
  <configuration-properties file="config-${env}.yaml"/>
  <http:listener-config name="cfg"><http:listener-connection host="0.0.0.0" port="8081"/></http:listener-config>
  <flow name="main">
    <http:listener config-ref="cfg" path="/p"/>
    <set-payload value="${greeting}:${db.user}:${secure::db.password}"/>
  </flow>
  <flow name="pfn">
    <http:listener config-ref="cfg" path="/pfn"/>
    <set-payload value="#[p('greeting') ++ ':' ++ p('db.user') ++ ':' ++ (p('nope') default 'none')]"/>
  </flow>
</mule>
