# Database コネクタ (PostgreSQL、localhost:15432) の操作のスパン。レベル OVERVIEW
app otel-db
prop mule.openTelemetry.tracer.exporter.sampler.type=always_on
prop mule.openTelemetry.tracer.level=OVERVIEW
GET /reset
GET /insert?id=1
GET /select
GET /single
GET /update
GET /bulk
GET /delete
GET /dup-caught
GET /bad-sql
