# http:request の headers に traceparent を自分で書いたとき。送られるのは自分の値かランタイムの値か、受ける側の SERVER の親。
# スケジューラから始まったフロー (own-tp-tick) でも同じか
prop mule.openTelemetry.tracer.exporter.sampler.type=always_on
GET /own-tp
GET /own-tp | traceparent: 00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01
GET /plain-tp
GET /plain-tp | traceparent: 00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-00
