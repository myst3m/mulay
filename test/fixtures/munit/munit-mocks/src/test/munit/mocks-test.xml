<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
    <munit:config name="mocks-test.xml"/>
    <munit:test name="e01-mock">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request">
                <munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Get data"/></munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[output application/json --- {x: 1}]" mediaType="application/json"/>
                    <munit-tools:attributes value="#[{statusCode: 201}]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="remote"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.got.x]" is="#[MunitTools::equalTo(1)]"/>
            <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo(201)]"/>
            <munit-tools:verify-call processor="http:request" times="1"><munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Get data"/></munit-tools:with-attributes></munit-tools:verify-call>
        </munit:validation>
    </munit:test>
    <munit:test name="e02-verify-fail">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request">
                <munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Get data"/></munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[output application/json --- {x: 1}]" mediaType="application/json"/>
                    <munit-tools:attributes value="#[{statusCode: 201}]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="remote"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:verify-call processor="http:request" times="2"><munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Get data"/></munit-tools:with-attributes></munit-tools:verify-call>
        </munit:validation>
    </munit:test>
    <munit:test name="e03-mock-error" expectedErrorType="HTTP:CONNECTIVITY">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request">
                <munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Get data"/></munit-tools:with-attributes>
                <munit-tools:then-return><munit-tools:error typeId="HTTP:CONNECTIVITY"/></munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="remote"/>
        </munit:execution>
    </munit:test>
    <munit:test name="e04-unmocked">
        <munit:execution>
            <flow-ref name="remote"/>
        </munit:execution>
    </munit:test>
    <munit:test name="e05-mock-by-path">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request">
                <munit-tools:with-attributes><munit-tools:with-attribute attributeName="path" whereValue="/b"/></munit-tools:with-attributes>
                <munit-tools:then-return><munit-tools:payload value="#['B']"/></munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="http:request">
                <munit-tools:with-attributes><munit-tools:with-attribute attributeName="path" whereValue="/a"/></munit-tools:with-attributes>
                <munit-tools:then-return><munit-tools:payload value="#['A']"/></munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="remote-twice"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::equalTo('B')]"/>
            <munit-tools:verify-call processor="http:request" atLeast="2"/>
            <munit-tools:verify-call processor="http:request" atMost="1"/>
        </munit:validation>
    </munit:test>
    <munit:test name="e06-mock-setpayload">
        <munit:behavior>
            <munit-tools:mock-when processor="set-payload">
                <munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Double it"/></munit-tools:with-attributes>
                <munit-tools:then-return><munit-tools:payload value="#[99]"/></munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event><munit:payload value="#[1]"/></munit:set-event>
            <flow-ref name="double"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::equalTo(99)]"/>
            <munit-tools:verify-call processor="mule:set-payload" times="1"/>
        </munit:validation>
    </munit:test>
    <munit:test name="e07-payload-only">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request"><munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Get data"/></munit-tools:with-attributes><munit-tools:then-return><munit-tools:payload value="#['P']"/></munit-tools:then-return></munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="remote"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.got]" is="#[MunitTools::equalTo('P')]"/>
            <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::nullValue()]"/>
        </munit:validation>
    </munit:test>
    <munit:test name="e08-error-desc">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request"><munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Get data"/></munit-tools:with-attributes><munit-tools:then-return><munit-tools:error typeId="HTTP:NOT_FOUND"/></munit-tools:then-return></munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="remote"/>
        </munit:execution>
    </munit:test>
    <munit:test name="e09-eval-time">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request"><munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Get data"/></munit-tools:with-attributes><munit-tools:then-return><munit-tools:payload value="#[vars.k default 'none']"/></munit-tools:then-return></munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event><munit:payload value="#[1]"/><munit:variables><munit:variable key="k" value="#['V']"/></munit:variables></munit:set-event>
            <flow-ref name="remote"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.got]" is="#[MunitTools::equalTo('V')]"/>
        </munit:validation>
    </munit:test>
    <munit:test name="e10-verify-default" expectedErrorType="ANY">
        <munit:execution>
            <flow-ref name="double"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:verify-call processor="http:request"/>
        </munit:validation>
    </munit:test>
    <munit:test name="e10b-verify-default">
        <munit:execution>
            <munit:set-event><munit:payload value="#[1]"/></munit:set-event>
            <flow-ref name="double"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:verify-call processor="http:request"/>
        </munit:validation>
    </munit:test>
    <munit:test name="e11-verify-atleast">
        <munit:execution>
            <munit:set-event><munit:payload value="#[1]"/></munit:set-event>
            <flow-ref name="double"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:verify-call processor="set-payload" atLeast="3"/>
        </munit:validation>
    </munit:test>
    <munit:test name="e12-mock-flowref">
        <munit:behavior>
            <munit-tools:mock-when processor="flow-ref"><munit-tools:with-attributes><munit-tools:with-attribute attributeName="name" whereValue="double"/></munit-tools:with-attributes><munit-tools:then-return><munit-tools:payload value="#[7]"/></munit-tools:then-return></munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event><munit:payload value="#[1]"/></munit:set-event>
            <flow-ref name="double"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::equalTo(7)]"/>
            <munit-tools:verify-call processor="mule:set-payload" times="0"/>
        </munit:validation>
    </munit:test>
    <munit:test name="e13-mock-any">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request"><munit-tools:then-return><munit-tools:payload value="#['any']"/></munit-tools:then-return></munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="remote-twice"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload]" is="#[MunitTools::equalTo('any')]"/>
            <munit-tools:verify-call processor="http:request" times="2"/>
        </munit:validation>
    </munit:test>
    <munit:test name="e14-where-expr">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request"><munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="#['Get ' ++ 'data']"/></munit-tools:with-attributes><munit-tools:then-return><munit-tools:payload value="#['X']"/></munit-tools:then-return></munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="remote"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.got]" is="#[MunitTools::equalTo('X')]"/>
        </munit:validation>
    </munit:test>
    <munit:test name="e15-vars-return">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request"><munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Get data"/></munit-tools:with-attributes><munit-tools:then-return><munit-tools:payload value="#[1]"/><munit-tools:variables><munit-tools:variable key="mv" value="#['set']"/></munit-tools:variables></munit-tools:then-return></munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="remote"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.mv]" is="#[MunitTools::equalTo('set')]"/>
        </munit:validation>
    </munit:test>
    <munit:test name="e16-attrs-only">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request"><munit-tools:with-attributes><munit-tools:with-attribute attributeName="doc:name" whereValue="Get data"/></munit-tools:with-attributes><munit-tools:then-return><munit-tools:attributes value="#[{statusCode: 404}]"/></munit-tools:then-return></munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event><munit:payload value="#['orig']"/></munit:set-event>
            <flow-ref name="remote"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.got]" is="#[MunitTools::equalTo('orig')]"/>
            <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo(404)]"/>
        </munit:validation>
    </munit:test>
    <munit:test name="e17-verify-attr-mismatch">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request"><munit-tools:then-return><munit-tools:payload value="#[1]"/></munit-tools:then-return></munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <flow-ref name="remote"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:verify-call processor="http:request" times="1"><munit-tools:with-attributes><munit-tools:with-attribute attributeName="path" whereValue="/nope"/></munit-tools:with-attributes></munit-tools:verify-call>
        </munit:validation>
    </munit:test>
</mule>
