%dw 2.0
output application/json
var parseDate = (dateStr) -> (
  if (dateStr contains /^[A-z][A-z][A-z],/)
    dateStr as Localdatetime {format: "E, d LLL u H:m:s O"}
  else if (dateStr contains /^[A-z][A-z][A-z]\s/)
      (dateStr as Localdatetime {format: "E LLL d H:m:s u"})
    else dateStr as Localdatetime {format: "cccc, d-LLL-u H:m:s O"})
---
date: parseDate(payload.dateString)
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (var parseDate (fn (dateStr) (if (call contains dateStr (regex "^[A-z][A-z][A-z],")) (as dateStr (tmeta Localdatetime (obj (format "E, d LLL u H:m:s O")))) (if (call contains dateStr (regex "^[A-z][A-z][A-z]\\s")) (as dateStr (tmeta Localdatetime (obj (format "E LLL d H:m:s u")))) (as dateStr (tmeta Localdatetime (obj (format "cccc, d-LLL-u H:m:s O"))))))))) (obj (date (call parseDate (sel payload .dateString)))))
@@@@ ok
%dw 2.0
output application/xml
---
books: {
  (payload filter ($.properties.year > attributes.publishedAfter) map  (item)   ->  {
    book @(year: item.properties.year): {
      (vars.exchangeRate.USD map {
        price @(currency: $.currency): $.ratio * item.price
      }),
      title: item.properties.title,
      authors: { (item.properties.author map {
        author: $
      }) }
    }
  } )
}
@@@@ =
(script :version "2.0" (dirs (output "application/xml")) (obj (books (obj (spread (call map (call filter payload (> (sel (sel $ .properties) .year) (sel attributes .publishedAfter))) (fn (item) (obj (book :attrs ((year (sel (sel item .properties) .year))) (obj (spread (call map (sel (sel vars .exchangeRate) .USD) (obj (price :attrs ((currency (sel $ .currency))) (* (sel $ .ratio) (sel item .price)))))) (title (sel (sel item .properties) .title)) (authors (obj (spread (call map (sel (sel item .properties) .author) (obj (author $))))))))))))))))
@@@@ ok
