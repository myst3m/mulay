@@@@ ok
%dw 2.0
import * from dw::util::Tree
var myObject =  {
     user: [{
         name: "mariano",
         lastName: "achaval",
         friends: [
             {
                 name: "julian"
             },
             {
                 name: "tom"
             }
         ]
     },
     {
         name: "leandro",
         lastName: "shokida",
         friends: [
             {
                 name: "peter"
             },
             {
                 name: "robert"
             }
         ]

     }
     ]
 }
output application/json
---
{
    mariano : myObject nodeExists ((value, path) -> path[-1].selector == "name" and value == "mariano"),
    julian : myObject nodeExists ((value, path) -> path[-1].selector == "name" and value == "julian"),
    tom : myObject nodeExists ($$[-1].selector == "name" and $ == "tom"),
    leandro : myObject nodeExists ($$[-1].selector == "name" and $ ==  "leandro"),
    peter : myObject nodeExists ($$[-1].selector == "name" and $ == "peter"),
    wrongField: myObject nodeExists ($$[-1].selector == "wrongField"),
    teo: myObject nodeExists ($$[-1].selector == "name" and $ == "teo")
}
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (import dw::util::Tree :star) (var myObject (obj (user (arr (obj (name "mariano") (lastName "achaval") (friends (arr (obj (name "julian")) (obj (name "tom"))))) (obj (name "leandro") (lastName "shokida") (friends (arr (obj (name "peter")) (obj (name "robert")))))))))) (obj (mariano (call nodeExists myObject (fn (value path) (and (== (sel (sel path [-1]) .selector) "name") (== value "mariano"))))) (julian (call nodeExists myObject (fn (value path) (and (== (sel (sel path [-1]) .selector) "name") (== value "julian"))))) (tom (call nodeExists myObject (and (== (sel (sel $$ [-1]) .selector) "name") (== $ "tom")))) (leandro (call nodeExists myObject (and (== (sel (sel $$ [-1]) .selector) "name") (== $ "leandro")))) (peter (call nodeExists myObject (and (== (sel (sel $$ [-1]) .selector) "name") (== $ "peter")))) (wrongField (call nodeExists myObject (== (sel (sel $$ [-1]) .selector) "wrongField"))) (teo (call nodeExists myObject (and (== (sel (sel $$ [-1]) .selector) "name") (== $ "teo"))))))
@@@@ ok
