import * from dw::Runtime
var jsonValue = {
  value: '{"name": "Mariano"}' as Binary {encoding: "UTF-8"},
  encoding: "UTF-8",
  properties: {},
  mimeType: "application/json"
}

var jsonValue2 = {
  value: '{"name": "Mariano", "lastName": "achaval"}' as Binary {encoding: "UTF-8"},
  encoding: "UTF-8",
  properties: {},
  mimeType: "application/json"
}

var invalidJsonValue = {
  value: '{"name": "Mariano' as Binary {encoding: "UTF-8"},
  encoding: "UTF-8",
  properties: {},
  mimeType: "application/json"
}

var Utils = "fun sum(a,b) = a +b"
---
{
  "execute_ok" : run("main.dwl", {"main.dwl": "{a: 1}"}, {"payload": jsonValue }),
  "logs" : do {
    var execResult = run("main.dwl", {"main.dwl": "{a: log(1)}"}, {"payload": jsonValue })
    ---
    {
        m: execResult.logs.message,
        l: execResult.logs.level
    }
  },
  "grant" : run("main.dwl", {"main.dwl": "{a: readUrl(`http://google.com`)}"}, {"payload": jsonValue }, { securityManager: (grant, args) -> false }),
  "library" : run("main.dwl", {"main.dwl": "Utils::sum(1,2)", "/Utils.dwl": Utils }, {"payload": jsonValue }),
  "timeout" : run("main.dwl", {"main.dwl": "(1 to 1000000000000) map \$ + 1" }, {"payload": jsonValue }, {timeOut: 2}).success,
  "execFail" : run("main.dwl", {"main.dwl": "dw::Runtime::fail('My Bad')" }, {"payload": jsonValue }),
  "parseFail" : run("main.dwl", {"main.dwl": "(1 + " }, {"payload": jsonValue }),
  "writerFail" : run("main.dwl", {"main.dwl": "output application/xml --- 2" }, {"payload": jsonValue }),
  "readerFail" : run("main.dwl", {"main.dwl": "output application/xml --- payload" }, {"payload": invalidJsonValue }),
  "defaultOutput" : run("main.dwl", {"main.dwl": "payload" }, {"payload": jsonValue2}, {outputMimeType: "application/csv", writerProperties: {"separator": "|"}}),
}
@@@@ =
(script (decls (import dw::Runtime :star) (var jsonValue (obj (value (as "{\"name\": \"Mariano\"}" (tmeta Binary (obj (encoding "UTF-8"))))) (encoding "UTF-8") (properties (obj)) (mimeType "application/json"))) (var jsonValue2 (obj (value (as "{\"name\": \"Mariano\", \"lastName\": \"achaval\"}" (tmeta Binary (obj (encoding "UTF-8"))))) (encoding "UTF-8") (properties (obj)) (mimeType "application/json"))) (var invalidJsonValue (obj (value (as "{\"name\": \"Mariano" (tmeta Binary (obj (encoding "UTF-8"))))) (encoding "UTF-8") (properties (obj)) (mimeType "application/json"))) (var Utils "fun sum(a,b) = a +b")) (obj ("execute_ok" (call run "main.dwl" (obj ("main.dwl" "{a: 1}")) (obj ("payload" jsonValue)))) ("logs" (do ((var execResult (call run "main.dwl" (obj ("main.dwl" "{a: log(1)}")) (obj ("payload" jsonValue))))) (obj (m (sel (sel execResult .logs) .message)) (l (sel (sel execResult .logs) .level))))) ("grant" (call run "main.dwl" (obj ("main.dwl" "{a: readUrl(`http://google.com`)}")) (obj ("payload" jsonValue)) (obj (securityManager (fn (grant args) false))))) ("library" (call run "main.dwl" (obj ("main.dwl" "Utils::sum(1,2)") ("/Utils.dwl" Utils)) (obj ("payload" jsonValue)))) ("timeout" (sel (call run "main.dwl" (obj ("main.dwl" "(1 to 1000000000000) map $ + 1")) (obj ("payload" jsonValue)) (obj (timeOut 2))) .success)) ("execFail" (call run "main.dwl" (obj ("main.dwl" "dw::Runtime::fail('My Bad')")) (obj ("payload" jsonValue)))) ("parseFail" (call run "main.dwl" (obj ("main.dwl" "(1 + ")) (obj ("payload" jsonValue)))) ("writerFail" (call run "main.dwl" (obj ("main.dwl" "output application/xml --- 2")) (obj ("payload" jsonValue)))) ("readerFail" (call run "main.dwl" (obj ("main.dwl" "output application/xml --- payload")) (obj ("payload" invalidJsonValue)))) ("defaultOutput" (call run "main.dwl" (obj ("main.dwl" "payload")) (obj ("payload" jsonValue2)) (obj (outputMimeType "application/csv") (writerProperties (obj ("separator" "|"))))))))
@@@@ ok
