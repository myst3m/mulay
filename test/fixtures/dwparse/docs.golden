%dw 2.0
output application/json
var multi = '--34b21
Content-Disposition: form-data; name="text"
Content-Type: text/plain

Book
--34b21
Content-Disposition: form-data; name="file1"; filename="a.json"
Content-Type: application/json

{
"title":"Java 8 in Action",
"author":"Mario Fusco",
"year":2014
}
--34b21
Content-Disposition: form-data; name="file2"; filename="a.html"
Content-Type: text/html

<!DOCTYPE html>
<title>
Available for download!
</title>
--34b21--'
var parsed = read(multi, "multipart/form-data", {boundary:'34b21'})
---
parsed.parts mapObject ((value, key, index) -> {(index): key})
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (var multi "--34b21\nContent-Disposition: form-data; name=\"text\"\nContent-Type: text/plain\n\nBook\n--34b21\nContent-Disposition: form-data; name=\"file1\"; filename=\"a.json\"\nContent-Type: application/json\n\n{\n\"title\":\"Java 8 in Action\",\n\"author\":\"Mario Fusco\",\n\"year\":2014\n}\n--34b21\nContent-Disposition: form-data; name=\"file2\"; filename=\"a.html\"\nContent-Type: text/html\n\n<!DOCTYPE html>\n<title>\nAvailable for download!\n</title>\n--34b21--") (var parsed (call read multi "multipart/form-data" (obj (boundary "34b21"))))) (call mapObject (sel parsed .parts) (fn (value key index) (obj ((dyn index) key)))))
@@@@ ok
%dw 2.0
input payload multipart boundary='boundary1'
output multipart boundary='test2'
---
{
  parts : {
    orderAck : {
      headers : {
        "Content-Type": "text/plain"
      },
      content : "Order payload of type " ++ payload.parts.order.content.^mimeType ++ " and id " ++ (payload.parts.order.content.id as String) ++ " received. Receipt available."
    },
    partner: {
      headers : {
        "Content-Type": payload.parts.partner.content.^mediaType
      },
      content : payload.parts.partner.content
    }
  }
}
@@@@ =
(script :version "2.0" (dirs (input payload "multipart" (obj (boundary "boundary1"))) (output "multipart" (obj (boundary "test2")))) (obj (parts (obj (orderAck (obj (headers (obj ("Content-Type" "text/plain"))) (content (++ (++ (++ (++ "Order payload of type " (sel (sel (sel (sel payload .parts) .order) .content) .^mimeType)) " and id ") (as (sel (sel (sel (sel payload .parts) .order) .content) .id) String)) " received. Receipt available.")))) (partner (obj (headers (obj ("Content-Type" (sel (sel (sel (sel payload .parts) .partner) .content) .^mediaType)))) (content (sel (sel (sel payload .parts) .partner) .content))))))))
@@@@ ok
