%dw 2.0
var myArray = [1,2,3,4,5]
var myMap = myArray map not (($ mod 2) == 0)
output application/json
---
{
  "not" : [
    "notTrue" : not true,
    "notFalse" : not false,
    "myMapWithNot" : myMap
  ],
  "and" : [
    "andTrueFalse" : true and false,
    "andIsTrue" : (1 + 1 == 2) and (2 + 2 == 4),
    "andIsFalse" : (1 + 1 == 2) and (2 + 2 == 2)
  ],
  "or" : [
    "orTrueFalse" : true or false,
    "orIsTrue" : (1 + 1 == 2) or (2 + 2 == 2),
    "orIsFalse" : (1 + 1 == 1) or (2 + 2 == 2)
  ],
  "!-vs-not" : [
	  "example-!" : (! true or true),
	  "example-not" : (not true or true)
  ]
}
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (var myArray (arr 1 2 3 4 5)) (var myMap (call map myArray (not (== (call mod $ 2) 0))))) (obj ("not" (arr (obj ("notTrue" (not true))) (obj ("notFalse" (not false))) (obj ("myMapWithNot" myMap)))) ("and" (arr (obj ("andTrueFalse" (and true false))) (obj ("andIsTrue" (and (== (+ 1 1) 2) (== (+ 2 2) 4)))) (obj ("andIsFalse" (and (== (+ 1 1) 2) (== (+ 2 2) 2)))))) ("or" (arr (obj ("orTrueFalse" (or true false))) (obj ("orIsTrue" (or (== (+ 1 1) 2) (== (+ 2 2) 2)))) (obj ("orIsFalse" (or (== (+ 1 1) 1) (== (+ 2 2) 2)))))) ("!-vs-not" (arr (obj ("example-!" (or (! true) true))) (obj ("example-not" (not (or true true))))))))
@@@@ ok
%dw 2.0
var orNot = if (1 + 1 == 4 or not 1 == 2) {"answer": "orNot - Condition met"}
             else {"answer": "nope"}
var andNot = if (1 + 1 == 2 and not 1 == 2) {"answer": "andNot - Condition met"}
             else {"answer": "nope"}
var notWithAndNot = if (not (1 + 1 == 2 and not 1 == 1)) {"answer": "notWithAndNot - Condition met"}
              else {"answer": "nope"}
output application/json
---
{ "answers" :
  [
    orNot,
    andNot,
    notWithAndNot
  ]
}
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (var orNot (if (or (== (+ 1 1) 4) (not (== 1 2))) (obj ("answer" "orNot - Condition met")) (obj ("answer" "nope")))) (var andNot (if (and (== (+ 1 1) 2) (not (== 1 2))) (obj ("answer" "andNot - Condition met")) (obj ("answer" "nope")))) (var notWithAndNot (if (not (and (== (+ 1 1) 2) (not (== 1 1)))) (obj ("answer" "notWithAndNot - Condition met")) (obj ("answer" "nope"))))) (obj ("answers" (arr orNot andNot notWithAndNot))))
@@@@ ok
%dw 2.0
output application/json
---
{
  "prepend-append" : [
  	 // Array on right side when prepending.
     { "prepend" : 1 >> [2] },
     { "prepend-number" : 1 >> [1] },
     { "prepend-string" : "a" >> [1] },
     { "prepend-object" : { "a" : "b"} >> [1] },
     { "prepend-array" : [1] >> [2, 3] },
     { "prepend-binary" : (1 as Binary) >> [1] },
     { "prepend-date-time" : |23:57:59Z| >> [ |2017-10-01| ] },
  	 // Array is on left side when appending.
     { "append-number" : [1] << 2 },
     { "append-string" : [1] << "a" },
     { "append-object" : [1] << { "a" : "b"} },
     { "append-array" : [1,2] << [1, 2, 3] },
     { "append-binary" : [1] << (1 as Binary) },
     { "append-date-time" : [ |2017-10-01| ] << |23:57:59Z| },
     { "append-object-to-array" : [1,2] << {"a" : "b"} },
     { "append-array-to-array1" : ["a","b"] << ["c","d"] },
     { "append-array-to-array2" : [["a","b"],["c","d"]] << ["e","f"] },
     // + always appends within the array
     { "append-with-+" : [1] + 2 },
     { "append-with-+" : [2] + 1 },
     { "removeNumberFromArray" : ( [1,2,3] - 2 ) },
     { "removeObjectFromArray" : ( [ {a : "b"}, {c : "d"} , { e : "f"} ] - { c : "d"} ) }
  ]
}
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (obj ("prepend-append" (arr (obj ("prepend" (>> 1 (arr 2)))) (obj ("prepend-number" (>> 1 (arr 1)))) (obj ("prepend-string" (>> "a" (arr 1)))) (obj ("prepend-object" (>> (obj ("a" "b")) (arr 1)))) (obj ("prepend-array" (>> (arr 1) (arr 2 3)))) (obj ("prepend-binary" (>> (as 1 Binary) (arr 1)))) (obj ("prepend-date-time" (>> (time "23:57:59Z") (arr (date "2017-10-01"))))) (obj ("append-number" (<< (arr 1) 2))) (obj ("append-string" (<< (arr 1) "a"))) (obj ("append-object" (<< (arr 1) (obj ("a" "b"))))) (obj ("append-array" (<< (arr 1 2) (arr 1 2 3)))) (obj ("append-binary" (<< (arr 1) (as 1 Binary)))) (obj ("append-date-time" (<< (arr (date "2017-10-01")) (time "23:57:59Z")))) (obj ("append-object-to-array" (<< (arr 1 2) (obj ("a" "b"))))) (obj ("append-array-to-array1" (<< (arr "a" "b") (arr "c" "d")))) (obj ("append-array-to-array2" (<< (arr (arr "a" "b") (arr "c" "d")) (arr "e" "f")))) (obj ("append-with-+" (+ (arr 1) 2))) (obj ("append-with-+" (+ (arr 2) 1))) (obj ("removeNumberFromArray" (- (arr 1 2 3) 2))) (obj ("removeObjectFromArray" (- (arr (obj (a "b")) (obj (c "d")) (obj (e "f"))) (obj (c "d")))))))))
@@@@ ok
