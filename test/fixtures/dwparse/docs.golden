%dw 2.0
import * from dw::core::Arrays
output application/json
---
{ "results" : [
    "ok" : [
      [1,2,3] some (($ mod 2) == 0),
      [1,2,3] some ((nextNum) -> (nextNum mod 2) == 0),
      [1,2,3] some (($ mod 2) == 1),
      [1,2,3,4,5,6,7,8] some (log('should stop at 2 ==', $) == 2),
      [1,2,3] some ($ == 1),
      [1,1,1] some ($ == 1),
      [1] some ($ == 1)
    ],
    "err" : [
      [1,2,3] some ($ == 100),
      [1] some ($ == 2)
    ]
  ]
}
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (import dw::core::Arrays :star)) (obj ("results" (arr (obj ("ok" (arr (call some (arr 1 2 3) (== (call mod $ 2) 0)) (call some (arr 1 2 3) (fn (nextNum) (== (call mod nextNum 2) 0))) (call some (arr 1 2 3) (== (call mod $ 2) 1)) (call some (arr 1 2 3 4 5 6 7 8) (== (call log "should stop at 2 ==" $) 2)) (call some (arr 1 2 3) (== $ 1)) (call some (arr 1 1 1) (== $ 1)) (call some (arr 1) (== $ 1))))) (obj ("err" (arr (call some (arr 1 2 3) (== $ 100)) (call some (arr 1) (== $ 2)))))))))
@@@@ ok
