%dw 2.0

type FileData<Content> = {
    data: Content,
    name: String
}

fun read(file: FileData<String>) =  "This is a text file with data " ++ file.data
fun read(file: FileData<Binary>) =  "This is a binary file with data " ++ (file.data as String {base: "64"})

---
{
  binary: read({data: "Hello World" as Binary, name: "myFile.bin"}),
  text: read({data: "Hello World", name: "myFile.txt"})
}
@@@@ =
(script :version "2.0" (decls (type FileData :generics (Content) (tobj (data Content) (name String))) (fun read ((file :type (FileData String))) (++ "This is a text file with data " (sel file .data))) (fun read ((file :type (FileData Binary))) (++ "This is a binary file with data " (as (sel file .data) (tmeta String (obj (base "64"))))))) (obj (binary (call read (obj (data (as "Hello World" Binary)) (name "myFile.bin")))) (text (call read (obj (data "Hello World") (name "myFile.txt"))))))
@@@@ ok
