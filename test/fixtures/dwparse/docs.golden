%dw 2.0
output application/json
---
"hello world" match {
	case word matches /(hello)\s\w+/ ->  word[1] as String ++ " was matched"
	case literalMatch: "hello world" -> upper(literalMatch)
	case hasOne if( hasOne is Object and hasOne.three? ) -> hasOne.three
	else -> $
}
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (match "hello world" (case word (matches (regex "(hello)\\s\\w+")) (++ (as (sel word [1]) String) " was matched")) (case literalMatch (lit "hello world") (call upper literalMatch)) (case hasOne (guard (and (is hasOne Object) (exists (sel hasOne .three)))) (sel hasOne .three)) (case _ else $)))
@@@@ ok
%dw 2.0
output application/json
---
"hello world" match {
	case word matches  /(hello)\s\w+/ ->  word[1] ++ " was matched"
	case literalMatch: "hello world" -> upper(literalMatch)
	case last if(true) -> last
}
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (match "hello world" (case word (matches (regex "(hello)\\s\\w+")) (++ (sel word [1]) " was matched")) (case literalMatch (lit "hello world") (call upper literalMatch)) (case last (guard true) last)))
@@@@ ok
%dw 2.0
var myInput = {
  "string": "Emiliano"
}
output application/json
---
{
  a: myInput.string match {
    case "Emiliano" -> true
    case "Mariano" -> false
  },
  b: myInput.string match {
    case str: "Emiliano" -> { "matches": true, value: str }
    case str: "Mariano" -> { "matches": false, value: str }
  }
}
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (var myInput (obj ("string" "Emiliano")))) (obj (a (match (sel myInput .string) (case _ (lit "Emiliano") true) (case _ (lit "Mariano") false))) (b (match (sel myInput .string) (case str (lit "Emiliano") (obj ("matches" true) (value str))) (case str (lit "Mariano") (obj ("matches" false) (value str)))))))
@@@@ ok
%dw 2.0
var myInput = {
  "string": "Emiliano",
  "number": 3.14
}
output application/json
---
{
  a: myInput.string match {
    case str if str == "Mariano" -> str ++ " de Achaval"
    case str if str == "Emiliano" -> str ++ " Lesende"
  },
  b: myInput.number match {
    case num if num == 3 -> "equal"
    case num if num > 3 -> "greater than"
    case num if num < 3 -> "less than"
  }
}
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (var myInput (obj ("string" "Emiliano") ("number" 3.14)))) (obj (a (match (sel myInput .string) (case str (guard (== str "Mariano")) (++ str " de Achaval")) (case str (guard (== str "Emiliano")) (++ str " Lesende")))) (b (match (sel myInput .number) (case num (guard (== num 3)) "equal") (case num (guard (> num 3)) "greater than") (case num (guard (< num 3)) "less than")))))
@@@@ ok
%dw 2.0
var myInput =
{
  "a": "Emiliano",
  "b": 3.14
}
output application/json
---
{
  a: myInput.a match {
    case is Object -> 'OBJECT'
    case is String -> 'STRING'
    case is Number -> 'NUMBER'
    case is Boolean -> 'BOOLEAN'
    case is Array -> 'ARRAY'
    case is Null -> 'NULL'
    else -> 'ANOTHER TYPE'
  },
  b: myInput.b match {
    case y is Object -> { 'Type': { 'OBJECT' : y} }
    case y is String -> { 'Type': { 'STRING' : y} }
    case y is Number -> { 'Type': { 'NUMBER' : y} }
    case y is Boolean -> { 'Type': { 'BOOLEAN' : y} }
    case y is Array -> { 'Type': { 'ARRAY' : y} }
    case y is Null -> { 'Type': { 'NULL' : y} }
    else -> { 'Type': { 'ANOTHER TYPE' : myInput.b} }
  }
}
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (var myInput (obj ("a" "Emiliano") ("b" 3.14)))) (obj (a (match (sel myInput .a) (case _ (is Object) "OBJECT") (case _ (is String) "STRING") (case _ (is Number) "NUMBER") (case _ (is Boolean) "BOOLEAN") (case _ (is Array) "ARRAY") (case _ (is Null) "NULL") (case _ else "ANOTHER TYPE"))) (b (match (sel myInput .b) (case y (is Object) (obj ("Type" (obj ("OBJECT" y))))) (case y (is String) (obj ("Type" (obj ("STRING" y))))) (case y (is Number) (obj ("Type" (obj ("NUMBER" y))))) (case y (is Boolean) (obj ("Type" (obj ("BOOLEAN" y))))) (case y (is Array) (obj ("Type" (obj ("ARRAY" y))))) (case y (is Null) (obj ("Type" (obj ("NULL" y))))) (case _ else (obj ("Type" (obj ("ANOTHER TYPE" (sel myInput .b))))))))))
@@@@ ok
%dw 2.0
var myInput = {
  "phones": [
    "+1 (415) 229-2009",
    "(647) 456-7008"
  ]
}
output application/json
---
{
  a: myInput.phones map ($ match {
     case phone matches /\+(\d+)\s\((\d+)\)\s(\d+\-\d+)/ -> { country: phone[1]}
     case phone matches /\((\d+)\)\s(\d+\-\d+)/ -> { area: phone[1], number: phone[2] }
   }),
 b: myInput.phones map ($ match {
   case phone matches /\+(\d+)\s\((\d+)\)\s(\d+\-\d+)/ -> { country: phone[1], area: phone[2], number: phone[3] }
   case phone matches /\((\d+)\)\s(\d+\-\d+)/ -> { area: phone[1], number: phone[2] }
 })
}
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (var myInput (obj ("phones" (arr "+1 (415) 229-2009" "(647) 456-7008"))))) (obj (a (call map (sel myInput .phones) (match $ (case phone (matches (regex "\\+(\\d+)\\s\\((\\d+)\\)\\s(\\d+\\-\\d+)")) (obj (country (sel phone [1])))) (case phone (matches (regex "\\((\\d+)\\)\\s(\\d+\\-\\d+)")) (obj (area (sel phone [1])) (number (sel phone [2]))))))) (b (call map (sel myInput .phones) (match $ (case phone (matches (regex "\\+(\\d+)\\s\\((\\d+)\\)\\s(\\d+\\-\\d+)")) (obj (country (sel phone [1])) (area (sel phone [2])) (number (sel phone [3])))) (case phone (matches (regex "\\((\\d+)\\)\\s(\\d+\\-\\d+)")) (obj (area (sel phone [1])) (number (sel phone [2])))))))))
@@@@ ok
[1,2,3,4] match {
	case [head ~ tail] -> head
	case [] -> null
}
@@@@ =
(script (match (arr 1 2 3 4) (case _ (arr head tail) head) (case _ (lit (arr)) null)))
@@@@ ok
{hello: "world", test: true} match {
    case {headKey: headValue ~ tail} -> headValue
    case {} -> null
}
@@@@ =
(script (match (obj (hello "world") (test true)) (case _ (obj headKey headValue tail) headValue) (case _ (lit (obj)) null)))
@@@@ ok
