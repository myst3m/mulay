output application/json
var myVar =
{
  "a": [0, 1, 2, 3, 4, 5],
  "b": ["a", "b", "c", "d", "e"],
  "c": [{ "letter": "a" }, { "letter": "b" }, { "letter": "c" }],
  "d": [true, false, false, true, true]
}
---
{
  "a" : [0, 1, 2, 3, 4, 5] reduce $$,
  "b": ["a", "b", "c", "d", "e"] reduce $$,
  "c": [{ "letter": "a" }, { "letter": "b" }, { "letter": "c" }] reduce ((item, acc = "z") -> acc ++ item.letter),
  "d": [{ letter: "a" }, { letter: "b" }, { letter: "c" }] reduce $$,
  "e": [true, false, false, true, true] reduce ($$ and $),
  "f": [true, false, false, true, true] reduce ((item, acc) -> acc and item),
  "g": [true, false, false, true, true] reduce ((item, acc = false) -> acc and item),
  "h": [true, false, false, true, true] reduce $$,
  "i": myVar.a reduce ($$ + $),
  "j": myVar.a reduce ((item, acc) -> acc + item),
  "k": myVar.a reduce ((item, acc = 3) -> acc + item),
  "l": myVar.a reduce $$,
  "m": myVar.b reduce ($$ ++ $),
  "n": myVar.b reduce ((item, acc) -> acc ++ item),
  "o": myVar.b reduce ((item, acc = "z") -> acc ++ item),
  "p": myVar.b reduce $$,
  "q": myVar.c reduce ((item, acc = "z") -> acc ++ item.letter),
  "r": myVar.c reduce $$,
  "s": myVar.d reduce ($$ and $),
  "t": myVar.d reduce ((item, acc) -> acc and item),
  "u": myVar.d reduce ((item, acc = false) -> acc and item),
  "v": myVar.d reduce $$,
  "w": ([0, 1, 2, 3, 4] reduce ((item, acc = {}) -> acc ++ { a: item })) pluck $,
  "x": [] reduce $$,
  "y": [] reduce ((item,acc = 0) -> acc + item)
}
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (var myVar (obj ("a" (arr 0 1 2 3 4 5)) ("b" (arr "a" "b" "c" "d" "e")) ("c" (arr (obj ("letter" "a")) (obj ("letter" "b")) (obj ("letter" "c")))) ("d" (arr true false false true true))))) (obj ("a" (call reduce (arr 0 1 2 3 4 5) $$)) ("b" (call reduce (arr "a" "b" "c" "d" "e") $$)) ("c" (call reduce (arr (obj ("letter" "a")) (obj ("letter" "b")) (obj ("letter" "c"))) (fn (item (acc :default "z")) (++ acc (sel item .letter))))) ("d" (call reduce (arr (obj (letter "a")) (obj (letter "b")) (obj (letter "c"))) $$)) ("e" (call reduce (arr true false false true true) (and $$ $))) ("f" (call reduce (arr true false false true true) (fn (item acc) (and acc item)))) ("g" (call reduce (arr true false false true true) (fn (item (acc :default false)) (and acc item)))) ("h" (call reduce (arr true false false true true) $$)) ("i" (call reduce (sel myVar .a) (+ $$ $))) ("j" (call reduce (sel myVar .a) (fn (item acc) (+ acc item)))) ("k" (call reduce (sel myVar .a) (fn (item (acc :default 3)) (+ acc item)))) ("l" (call reduce (sel myVar .a) $$)) ("m" (call reduce (sel myVar .b) (++ $$ $))) ("n" (call reduce (sel myVar .b) (fn (item acc) (++ acc item)))) ("o" (call reduce (sel myVar .b) (fn (item (acc :default "z")) (++ acc item)))) ("p" (call reduce (sel myVar .b) $$)) ("q" (call reduce (sel myVar .c) (fn (item (acc :default "z")) (++ acc (sel item .letter))))) ("r" (call reduce (sel myVar .c) $$)) ("s" (call reduce (sel myVar .d) (and $$ $))) ("t" (call reduce (sel myVar .d) (fn (item acc) (and acc item)))) ("u" (call reduce (sel myVar .d) (fn (item (acc :default false)) (and acc item)))) ("v" (call reduce (sel myVar .d) $$)) ("w" (call pluck (call reduce (arr 0 1 2 3 4) (fn (item (acc :default (obj))) (++ acc (obj (a item))))) $)) ("x" (call reduce (arr) $$)) ("y" (call reduce (arr) (fn (item (acc :default 0)) (+ acc item))))))
@@@@ ok
