%dw 2.0
var aRecord =
 [
    "bookId":"101",
    "title":"world history",
    "price":"19.99"
 ]
output application/xml
---
{ examples:
	{
	   ex1 : if (1 + 1 == 55) true
	         else false,
	   ex2 : if ([1,2,3,4][1] == 1) 1
	         else "value of index 1 is not 1",
	   ex3 : if (isEmpty(aRecord.bookId)) "ID is empty"
	  	 else "ID is not empty",
	   ex4 : aRecord.bookId map (idValue) ->
	   	 if (idValue as Number == 101) idValue as Number
		 else "not 101"
	}
}
@@@@ =
(script :version "2.0" (dirs (output "application/xml")) (decls (var aRecord (arr (obj ("bookId" "101")) (obj ("title" "world history")) (obj ("price" "19.99"))))) (obj (examples (obj (ex1 (if (== (+ 1 1) 55) true false)) (ex2 (if (== (sel (arr 1 2 3 4) [1]) 1) 1 "value of index 1 is not 1")) (ex3 (if (call isEmpty (sel aRecord .bookId)) "ID is empty" "ID is not empty")) (ex4 (call map (sel aRecord .bookId) (fn (idValue) (if (== (as idValue Number) 101) (as idValue Number) "not 101"))))))))
@@@@ ok
