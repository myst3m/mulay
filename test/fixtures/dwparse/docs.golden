output multipart/form-data boundary="----myboundary----"
---
{
  parts: {
    filePart: {
      headers: {
        "Content-Disposition": {
          "name": "<NAME>",
          "filename": "<FILE_NAME>.<FILE_EXTENSION>"
        },
        "Content-Type": "<FILE_CONTENT-TYPE>"
      },
      content: payload
    },
    otherJsonPart: {
      content: '{"name": "sampleFile.xml", "sampleFile": {"type": "sample"} }'
    }
  }
}
@@@@ =
(script :version "2.0" (dirs (input payload "application/xml") (output "multipart/form-data" (obj (boundary "----myboundary----")))) (obj (parts (obj (filePart (obj (headers (obj ("Content-Disposition" (obj ("name" "<NAME>") ("filename" "<FILE_NAME>.<FILE_EXTENSION>"))) ("Content-Type" "<FILE_CONTENT-TYPE>"))) (content payload))) (otherJsonPart (obj (content "{\"name\": \"sampleFile.xml\", \"sampleFile\": {\"type\": \"sample\"} }")))))))
@@@@ ok
