    Blaze: {role: "user", id: "04"}
}
---
collaborators pluck ((value,key,index)->  {
        "Name": key,
        "Role": upper(value.role),
        "ID": value.id
    })
    filter ((item, index) -> item.Role == "ADMIN")
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (var collaborators (obj (Max (obj (role "admin") (id "01"))) (Einstein (obj (role "dev") (id "02"))) (Astro (obj (role "admin") (id "03"))) (Blaze (obj (role "user") (id "04")))))) (call filter (call pluck collaborators (fn (value key index) (obj ("Name" key) ("Role" (call upper (sel value .role))) ("ID" (sel value .id))))) (fn (item index) (== (sel item .Role) "ADMIN"))))
@@@@ ok
%dw 2.0
output application/json
