var myDateTime1 = |2017-10-01T22:57:59-03:00|
var myDateTime2 = |2018-10-01T23:57:59-03:00|
output application/json
---
{
  myMaxBy: {
    byDateTime: [ myDateTime1, myDateTime2 ] maxBy ((item) -> item),
    byDate: [ myDateTime1 as Date, myDateTime2 as Date ] maxBy ((item) -> item),
    byTime: [ myDateTime1 as Time, myDateTime2 as Time ] maxBy ((item) -> item),
    emptyArray: [] maxBy ((item) -> item)
  }
}
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (var myDateTime1 (datetime "2017-10-01T22:57:59-03:00")) (var myDateTime2 (datetime "2018-10-01T23:57:59-03:00"))) (obj (myMaxBy (obj (byDateTime (call maxBy (arr myDateTime1 myDateTime2) (fn (item) item))) (byDate (call maxBy (arr (as myDateTime1 Date) (as myDateTime2 Date)) (fn (item) item))) (byTime (call maxBy (arr (as myDateTime1 Time) (as myDateTime2 Time)) (fn (item) item))) (emptyArray (call maxBy (arr) (fn (item) item)))))))
@@@@ ok
