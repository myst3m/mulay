(script :version "2.0" (dirs (output "application/json")) (decls (import dw::core::Objects :star) (var myVar (call read "<users xmlns=\"http://test.com\">\n                     <user name=\"Mariano\" lastName=\"Achaval\"/>\n                     <user name=\"Stacey\" lastName=\"Duke\"/>\n                  </users>" "application/xml"))) (++ (obj (keySetExample (call flatten (arr (call map (call keySet (sel myVar .users)) (sel $ .#)) (call map (call keySet (sel myVar .users)) (sel $ .@)))))) (obj (nameSet (call flatten (arr (call map (call nameSet (sel myVar .users)) (sel $ .#)) (call map (call nameSet (sel myVar .users)) (sel $ .@))))))))
@@@@ ok
