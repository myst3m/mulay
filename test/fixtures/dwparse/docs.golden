%dw 2.0
import * from dw::module::Mime
output application/json

var JSON = {'type': "application", subtype: "json", parameters: {}}
var MULTIPART = {'type': "multipart", subtype: "form-data", parameters: {boundary: "my-boundary"}}
var ALL = {'type': "*", subtype: "*", parameters: {}}
---
{
  a: isHandledBy(JSON, JSON),
  b: isHandledBy({'type': "*", subtype: "json", parameters: {}}, JSON),
  c: isHandledBy({'type': "application", subtype: "*", parameters: {}}, JSON),
  d: isHandledBy(ALL, MULTIPART),
  e: isHandledBy(MULTIPART, ALL),
  f: isHandledBy(JSON, MULTIPART),
  g: isHandledBy(
    {'type': "application", subtype: "*+xml", parameters: {}},
    {'type': "application", subtype: "soap+xml", parameters: {}})
}
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (import dw::module::Mime :star) (var JSON (obj ("type" "application") (subtype "json") (parameters (obj)))) (var MULTIPART (obj ("type" "multipart") (subtype "form-data") (parameters (obj (boundary "my-boundary"))))) (var ALL (obj ("type" "*") (subtype "*") (parameters (obj))))) (obj (a (call isHandledBy JSON JSON)) (b (call isHandledBy (obj ("type" "*") (subtype "json") (parameters (obj))) JSON)) (c (call isHandledBy (obj ("type" "application") (subtype "*") (parameters (obj))) JSON)) (d (call isHandledBy ALL MULTIPART)) (e (call isHandledBy MULTIPART ALL)) (f (call isHandledBy JSON MULTIPART)) (g (call isHandledBy (obj ("type" "application") (subtype "*+xml") (parameters (obj))) (obj ("type" "application") (subtype "soap+xml") (parameters (obj)))))))
@@@@ ok
