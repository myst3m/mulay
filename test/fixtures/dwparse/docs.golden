%dw 2.0
output application/json
---
{
    "chainResult": ["mariano", "de Achaval"]
            reduce ((item, accumulator) -> item ++ accumulator)
            then ((result) -> sizeOf(result)),
    "referenceResult" : ["mariano", "de Achaval"]
                         map ((item, index) -> upper(item))
                         then {
                            name: $[0],
                            lastName: $[1],
                            length: sizeOf($)
                        },
    "onNullReturnNull": []
                reduce ((item, accumulator) -> item ++ accumulator)
                then ((result) -> sizeOf(result))
}
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (obj ("chainResult" (call then (call reduce (arr "mariano" "de Achaval") (fn (item accumulator) (++ item accumulator))) (fn (result) (call sizeOf result)))) ("referenceResult" (call then (call map (arr "mariano" "de Achaval") (fn (item index) (call upper item))) (obj (name (sel $ [0])) (lastName (sel $ [1])) (length (call sizeOf $))))) ("onNullReturnNull" (call then (call reduce (arr) (fn (item accumulator) (++ item accumulator))) (fn (result) (call sizeOf result))))))
@@@@ ok
