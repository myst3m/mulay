(script :version "2.0" (dirs (output "application/json")) (decls (fun toUpper ((a :type String)) (call upper a)) (fun toUpper ((a :type Any)) null) (fun toUpper ((a :type String) (b :type Number)) (++ (call upper a) (as b String)))) (call toUpper "hi!"))
