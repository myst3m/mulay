%dw 2.0
output application/json

fun lookupCountryCode(phoneNumber: String): String = do {
    var callingCode = (phoneNumber splitBy("-"))[0]
    ---
    (vars.country_code filter ((item, index) -> item.CALLING_CODE == callingCode) map ((item, index) -> item.COUNTRY_CODE))[0]
}
---
payload map ((item, index) -> { phone: item, countryCode: lookupCountryCode(item)})
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (fun lookupCountryCode ((phoneNumber :type String)) :ret String (do ((var callingCode (sel (call splitBy phoneNumber "-") [0]))) (sel (call map (call filter (sel vars .country_code) (fn (item index) (== (sel item .CALLING_CODE) callingCode))) (fn (item index) (sel item .COUNTRY_CODE))) [0])))) (call map payload (fn (item index) (obj (phone item) (countryCode (call lookupCountryCode item))))))
@@@@ ok
