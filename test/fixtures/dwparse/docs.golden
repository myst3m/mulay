          name : "",
          lastName @(foo: ""): "Achaval",
          friends @(id: 123): [{id: "", test: true}, {age: 123}, ""]
        } filterTree ((value, path) ->
            value match  {
                            case s is String -> !isEmpty(s)
                            else -> true
                          }
    ),
    b: null filterTree ((value, path) -> value is String),
    c: [
            {name: "Mariano", friends: []},
            {test: [1,2,3]},
            {dw: ""}
        ] filterTree ((value, path) ->
            value match  {
                            case a is Array ->  !isEmpty(a as Array)
                            else -> true
                        })
}
@@@@ =
(script :version "2.0" (dirs (output "application/dw")) (decls (import dw::util::Tree :star)) (obj (a (call filterTree (obj (name "") (lastName :attrs ((foo "")) "Achaval") (friends :attrs ((id 123)) (arr (obj (id "") (test true)) (obj (age 123)) ""))) (fn (value path) (match value (case s (is String) (! (call isEmpty s))) (case _ else true))))) (b (call filterTree null (fn (value path) (is value String)))) (c (call filterTree (arr (obj (name "Mariano") (friends (arr))) (obj (test (arr 1 2 3))) (obj (dw ""))) (fn (value path) (match value (case a (is Array) (! (call isEmpty (as a Array)))) (case _ else true)))))))
@@@@ ok
{
  a: {
    lastName: "Achaval",
    friends @(id: 123): [
      {
        test: true
      },
      {
        age: 123
      }
    ]
  },
  b: null,
  c: [
    {
      name: "Mariano"
    },
    {
      test: [
        1,
        2,
        3
      ]
    },
    {
      dw: ""
    }
  ]
}
@@@@ =
(script (obj (a (obj (lastName "Achaval") (friends :attrs ((id 123)) (arr (obj (test true)) (obj (age 123)))))) (b null) (c (arr (obj (name "Mariano")) (obj (test (arr 1 2 3))) (obj (dw ""))))))
@@@@ ok
