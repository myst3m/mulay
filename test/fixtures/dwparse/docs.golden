import diff from dw::util::Diff
ns ns0 http://locahost.com
ns ns1 http://acme.com
output application/dw
---
{
  "a": diff({a: 1}, {b:1}),
  "b": diff({ns0#a: 1}, {ns1#a:1}),
  "c": diff([1,2,3], []),
  "d": diff([], [1,2,3]),
  "e": diff([1,2,3], [1,2,3, 4]),
  "f": diff([{a: 1}], [{a: 2}]),
  "g": diff({a @(c: 2): 1}, {a @(c: 3): 1}),
  "h": diff(true, false),
  "i": diff(1, 2),
  "j": diff("test", "other test"),
  "k": diff({a: 1}, {a:1}),
  "l": diff({ns0#a: 1}, {ns0#a:1}),
  "m": diff([1,2,3], [1,2,3]),
  "n": diff([], []),
  "o": diff([{a: 1}], [{a: 1}]),
  "p": diff({a @(c: 2): 1}, {a @(c:2): 1}),
  "q": diff(true, true),
  "r": diff(1, 1),
  "s": diff("other test", "other test"),
  "t": diff({a:1 ,b: 2},{b: 2, a:1}, {unordered: true}),
  "u": [{format: "ssn",data: "ABC"}] diff [{ format: "ssn",data: "ABC"}]
}
@@@@ =
(script (dirs (output "application/dw")) (decls (import dw::util::Diff :names (diff)) (ns ns0 "http://locahost.com") (ns ns1 "http://acme.com")) (obj ("a" (call diff (obj (a 1)) (obj (b 1)))) ("b" (call diff (obj (ns0#a 1)) (obj (ns1#a 1)))) ("c" (call diff (arr 1 2 3) (arr))) ("d" (call diff (arr) (arr 1 2 3))) ("e" (call diff (arr 1 2 3) (arr 1 2 3 4))) ("f" (call diff (arr (obj (a 1))) (arr (obj (a 2))))) ("g" (call diff (obj (a :attrs ((c 2)) 1)) (obj (a :attrs ((c 3)) 1)))) ("h" (call diff true false)) ("i" (call diff 1 2)) ("j" (call diff "test" "other test")) ("k" (call diff (obj (a 1)) (obj (a 1)))) ("l" (call diff (obj (ns0#a 1)) (obj (ns0#a 1)))) ("m" (call diff (arr 1 2 3) (arr 1 2 3))) ("n" (call diff (arr) (arr))) ("o" (call diff (arr (obj (a 1))) (arr (obj (a 1))))) ("p" (call diff (obj (a :attrs ((c 2)) 1)) (obj (a :attrs ((c 2)) 1)))) ("q" (call diff true true)) ("r" (call diff 1 1)) ("s" (call diff "other test" "other test")) ("t" (call diff (obj (a 1) (b 2)) (obj (b 2) (a 1)) (obj (unordered true)))) ("u" (call diff (arr (obj (format "ssn") (data "ABC"))) (arr (obj (format "ssn") (data "ABC")))))))
@@@@ ok
