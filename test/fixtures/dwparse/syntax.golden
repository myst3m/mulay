x match {
  case y if y is String -> 1
  case is Array | Null -> 2
  case z is Object -> z match { case {} -> 3 else -> 4 }
  case "a" -> 5
  case -1.5 -> 6
  case false -> 7
  case |10:00| -> 8
}
@@@@ =
(script (match x (case y (guard (is y String)) 1) (case _ (is (| Array Null)) 2) (case z (is Object) (match z (case _ (lit (obj)) 3) (case _ else 4))) (case _ (lit "a") 5) (case _ (lit -1.5) 6) (case _ (lit false) 7) (case _ (lit (localtime "10:00")) 8)))
@@@@ ok
