@@@@ ok
%dw 2.0
fun resolve(params) = params match {
  case obj is Object -> obj mapObject ((v, k) -> {(k): resolve(v)})
  case arr is Array -> arr map resolve($)
  else -> params
}
---
resolve({a: 1, b: {c: 2}, d: [3, 4]})
@@@@ =
(script :version "2.0" (decls (fun resolve (params) (match params (case obj (is Object) (call mapObject obj (fn (v k) (obj ((dyn k) (call resolve v)))))) (case arr (is Array) (call map arr (call resolve $))) (case _ else params)))) (call resolve (obj (a 1) (b (obj (c 2))) (d (arr 3 4)))))
@@@@ ok
