%dw 2.0
output application/json
var products = [
    {id: "P001", name: "Laptop", price: 1200.00, category: "electronics", stock: 50},
    {id: "P002", name: "T-Shirt", price: 25.00, category: "clothing", stock: 200},
    {id: "P003", name: "Apple", price: 1.50, category: "food", stock: 500}
]
var category = attributes.queryParams.category
---
if (category != null)
    products filter ((item) -> item.category == category)
else
    products
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (var products (arr (obj (id "P001") (name "Laptop") (price 1200.00) (category "electronics") (stock 50)) (obj (id "P002") (name "T-Shirt") (price 25.00) (category "clothing") (stock 200)) (obj (id "P003") (name "Apple") (price 1.50) (category "food") (stock 500)))) (var category (sel (sel attributes .queryParams) .category))) (if (!= category null) (call filter products (fn (item) (== (sel item .category) category))) products))
@@@@ ok
%dw 2.0
output application/json
var products = [
    {id: "P001", name: "Laptop", price: 1200.00, category: "electronics", stock: 50},
    {id: "P002", name: "T-Shirt", price: 25.00, category: "clothing", stock: 200},
    {id: "P003", name: "Apple", price: 1.50, category: "food", stock: 500}
]
var productId = attributes.uriParams.productId
var product = products filter ((item) -> item.id == productId)
---
if (sizeOf(product) > 0) product[0] else null
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (var products (arr (obj (id "P001") (name "Laptop") (price 1200.00) (category "electronics") (stock 50)) (obj (id "P002") (name "T-Shirt") (price 25.00) (category "clothing") (stock 200)) (obj (id "P003") (name "Apple") (price 1.50) (category "food") (stock 500)))) (var productId (sel (sel attributes .uriParams) .productId)) (var product (call filter products (fn (item) (== (sel item .id) productId))))) (if (> (call sizeOf product) 0) (sel product [0]) null))
@@@@ ok
%dw 2.0
output application/json
---
{
    id: "P" ++ (random() * 1000) as String {format: "000"},
    name: payload.name,
    price: payload.price,
    category: payload.category default "electronics",
    stock: payload.stock default 0
}
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (obj (id (++ "P" (as (* (call random) 1000) (tmeta String (obj (format "000")))))) (name (sel payload .name)) (price (sel payload .price)) (category (default (sel payload .category) "electronics")) (stock (default (sel payload .stock) 0))))
@@@@ ok
