%dw 2.0
output application/json
var data = (1 to 2000) map {
  id: $,
  val: $ * $ * 0.37,
  cat: if (($ mod 7) == 0) "x" else if (($ mod 5) == 0) "y" else "z"
}
var filtered = data filter $.cat != "z"
var totals = filtered reduce ((item, acc = {sum: 0, count: 0}) -> {
  sum: acc.sum + item.val,
  count: acc.count + 1
})
var sorted = filtered orderBy $.val
---
{
  avg: totals.sum / totals.count,
  count: totals.count,
  min: sorted[0].val,
  max: sorted[-1].val
}
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (var data (call map (call to 1 2000) (obj (id $) (val (* (* $ $) 0.37)) (cat (if (== (call mod $ 7) 0) "x" (if (== (call mod $ 5) 0) "y" "z")))))) (var filtered (call filter data (!= (sel $ .cat) "z"))) (var totals (call reduce filtered (fn (item (acc :default (obj (sum 0) (count 0)))) (obj (sum (+ (sel acc .sum) (sel item .val))) (count (+ (sel acc .count) 1)))))) (var sorted (call orderBy filtered (sel $ .val)))) (obj (avg (/ (sel totals .sum) (sel totals .count))) (count (sel totals .count)) (min (sel (sel sorted [0]) .val)) (max (sel (sel sorted [-1]) .val))))
@@@@ ok
%dw 2.0
output application/json
var s1 = (1 to 5000) reduce ((item, acc = 0) -> acc + item * item)
var s2 = (1 to 5000) reduce ((item, acc = 0) -> acc + item * 3)
var s3 = (1 to 5000) reduce ((item, acc = 0) -> acc + (if ((item mod 3) == 0) item else 0))
var s4 = sizeOf((1 to 5000) filter (($ mod 7) == 0))
var s5 = sizeOf((1 to 5000) filter (($ mod 11) == 0))
var s6 = (1 to 3000) map ($ * $ + $ * 3 + 7)
var s7 = s6 reduce ((item, acc = 0) -> acc + item)
---
{
  sum1: s1,
  sum2: s2,
  sum3: s3,
  count4: s4,
  count5: s5,
  sum7: s7
}
@@@@ =
(script :version "2.0" (dirs (output "application/json")) (decls (var s1 (call reduce (call to 1 5000) (fn (item (acc :default 0)) (+ acc (* item item))))) (var s2 (call reduce (call to 1 5000) (fn (item (acc :default 0)) (+ acc (* item 3))))) (var s3 (call reduce (call to 1 5000) (fn (item (acc :default 0)) (+ acc (if (== (call mod item 3) 0) item 0))))) (var s4 (call sizeOf (call filter (call to 1 5000) (== (call mod $ 7) 0)))) (var s5 (call sizeOf (call filter (call to 1 5000) (== (call mod $ 11) 0)))) (var s6 (call map (call to 1 3000) (+ (+ (* $ $) (* $ 3)) 7))) (var s7 (call reduce s6 (fn (item (acc :default 0)) (+ acc item))))) (obj (sum1 s1) (sum2 s2) (sum3 s3) (count4 s4) (count5 s5) (sum7 s7)))
@@@@ ok
