@@@@ ok
%dw 2.0
output application/xml
var data = {employees: {employee: [{name: "John", addresses: {address: ["123 Main", "456 Oak"]}}, {name: "Jane", addresses: {address: ["789 Elm"]}}]}}
---
employees: {
  (data.employees.employee map {
    employee: {
      name: $.name,
      addresses: {
        ($.addresses.address map {
          address: $
        })
      }
    }
  })
}
@@@@ =
(script :version "2.0" (dirs (output "application/xml")) (decls (var data (obj (employees (obj (employee (arr (obj (name "John") (addresses (obj (address (arr "123 Main" "456 Oak"))))) (obj (name "Jane") (addresses (obj (address (arr "789 Elm")))))))))))) (obj (employees (obj (spread (call map (sel (sel data .employees) .employee) (obj (employee (obj (name (sel $ .name)) (addresses (obj (spread (call map (sel (sel $ .addresses) .address) (obj (address $)))))))))))))))
