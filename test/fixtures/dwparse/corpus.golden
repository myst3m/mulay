fun fact(n) = if (n <= 1) 1 else n * fact(n - 1)
---
fact(5)
@@@@ =
(script :version "2.0" (decls (fun fact (n) (if (<= n 1) 1 (* n (call fact (- n 1)))))) (call fact 5))
@@@@ ok
