%dw 2.0
fun frequencies(values) = do {
  var uniques = values distinctBy $
  ---
  uniques map {
    value: $,
    occurrences: sizeOf(values find $)
  }
}
---
frequencies([1, 2, 11, 1, 1, 2])
@@@@ =
(script :version "2.0" (decls (fun frequencies (values) (do ((var uniques (call distinctBy values $))) (call map uniques (obj (value $) (occurrences (call sizeOf (call find values $)))))))) (call frequencies (arr 1 2 11 1 1 2)))
@@@@ ok
%dw 2.0
fun mean(v) = if (isEmpty(v)) null else sum(v) / sizeOf(v)
fun variance(v) = do {
  var m = mean(v) default 0
  var devs = v map pow($ - m, 2)
  ---
  mean(devs)
}
---
{v: variance([1,2,3,2]), s: sqrt(variance([1,2,3,2]))}
@@@@ =
(script :version "2.0" (decls (fun mean (v) (if (call isEmpty v) null (/ (call sum v) (call sizeOf v)))) (fun variance (v) (do ((var m (default (call mean v) 0)) (var devs (call map v (call pow (- $ m) 2)))) (call mean devs)))) (obj (v (call variance (arr 1 2 3 2))) (s (call sqrt (call variance (arr 1 2 3 2))))))
@@@@ ok
%dw 2.0
fun frequencies(values) = do {
  var uniques = values distinctBy $
  ---
  uniques map {
    value: $,
    occurrences: sizeOf(values find $)
  }
}
fun modes(values) = do {
  var freq = frequencies(values)
  var maxOcc = freq map $.occurrences maxBy $
  ---
  freq filter ($.occurrences == maxOcc) map $.value
}
---
modes(["a","b","c","a","b"])
@@@@ =
(script :version "2.0" (decls (fun frequencies (values) (do ((var uniques (call distinctBy values $))) (call map uniques (obj (value $) (occurrences (call sizeOf (call find values $))))))) (fun modes (values) (do ((var freq (call frequencies values)) (var maxOcc (call maxBy (call map freq (sel $ .occurrences)) $))) (call map (call filter freq (== (sel $ .occurrences) maxOcc)) (sel $ .value))))) (call modes (arr "a" "b" "c" "a" "b")))
@@@@ ok
