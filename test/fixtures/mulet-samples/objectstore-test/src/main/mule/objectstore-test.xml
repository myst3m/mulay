<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/os http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <configuration-properties file="config.yaml"/>

    <http:listener-config name="HTTP_Listener">
        <http:listener-connection host="0.0.0.0" port="${http.port}"/>
    </http:listener-config>

    <os:object-store name="testStore" doc:name="Test Object Store" persistent="false"/>

    <!-- 1. POST /os/store - Store a key-value pair -->
    <flow name="os-store-flow">
        <http:listener config-ref="HTTP_Listener" path="/os/store" allowedMethods="POST" doc:name="POST /os/store"/>
        <set-variable variableName="key" value="#[attributes.queryParams.key]" doc:name="Save key"/>
        <os:store key="#[attributes.queryParams.key]" objectStore="testStore" doc:name="Store value">
            <os:value>#[payload]</os:value>
        </os:store>
        <ee:transform doc:name="Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    status: "stored",
    key: vars.key
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>

    <!-- 2. GET /os/retrieve - Retrieve value by key -->
    <flow name="os-retrieve-flow">
        <http:listener config-ref="HTTP_Listener" path="/os/retrieve" allowedMethods="GET" doc:name="GET /os/retrieve"/>
        <os:retrieve key="#[attributes.queryParams.key]" objectStore="testStore" target="result" doc:name="Retrieve value"/>
        <ee:transform doc:name="Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
vars.result]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>

    <!-- 3. GET /os/retrieve/default - Retrieve with default value -->
    <flow name="os-retrieve-default-flow">
        <http:listener config-ref="HTTP_Listener" path="/os/retrieve/default" allowedMethods="GET" doc:name="GET /os/retrieve/default"/>
        <os:retrieve key="#[attributes.queryParams.key]" objectStore="testStore" target="result" doc:name="Retrieve with default">
            <os:default-value><![CDATA[#["default-value"]]]></os:default-value>
        </os:retrieve>
        <ee:transform doc:name="Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
vars.result]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>

    <!-- 4. DELETE /os/remove - Remove a key -->
    <flow name="os-remove-flow">
        <http:listener config-ref="HTTP_Listener" path="/os/remove" allowedMethods="DELETE" doc:name="DELETE /os/remove"/>
        <os:remove key="#[attributes.queryParams.key]" objectStore="testStore" doc:name="Remove key"/>
        <ee:transform doc:name="Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    status: "removed"
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>

    <!-- 5. GET /os/contains - Check if key exists -->
    <flow name="os-contains-flow">
        <http:listener config-ref="HTTP_Listener" path="/os/contains" allowedMethods="GET" doc:name="GET /os/contains"/>
        <os:contains key="#[attributes.queryParams.key]" objectStore="testStore" target="exists" doc:name="Check contains"/>
        <ee:transform doc:name="Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    key: attributes.queryParams.key,
    exists: vars.exists
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>

    <!-- 6. GET /os/retrieve-all - Retrieve all entries -->
    <flow name="os-retrieve-all-flow">
        <http:listener config-ref="HTTP_Listener" path="/os/retrieve-all" allowedMethods="GET" doc:name="GET /os/retrieve-all"/>
        <os:retrieve-all objectStore="testStore" target="allData" doc:name="Retrieve all"/>
        <ee:transform doc:name="Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
vars.allData]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>

    <!-- 7. GET /os/retrieve-all-keys - Get all keys -->
    <flow name="os-retrieve-all-keys-flow">
        <http:listener config-ref="HTTP_Listener" path="/os/retrieve-all-keys" allowedMethods="GET" doc:name="GET /os/retrieve-all-keys"/>
        <os:retrieve-all-keys objectStore="testStore" target="allKeys" doc:name="Retrieve all keys"/>
        <ee:transform doc:name="Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
vars.allKeys]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>

    <!-- 8. POST /os/clear - Clear all entries -->
    <flow name="os-clear-flow">
        <http:listener config-ref="HTTP_Listener" path="/os/clear" allowedMethods="POST" doc:name="POST /os/clear"/>
        <os:clear objectStore="testStore" doc:name="Clear store"/>
        <ee:transform doc:name="Response">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
    status: "cleared"
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>


</mule>
