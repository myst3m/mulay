    <!-- ============================================================ -->
    <!-- Bulk API v2 - 一括取込ジョブ (Ingest)                           -->
    <!-- ============================================================ -->

    <flow name="bulkCreateJobFlow" doc:name="一括取込ジョブ作成 (CSV→Account INSERT)">
        <http:listener config-ref="HTTP_Listener" path="/sf/bulk/ingest/create" allowedMethods="POST" doc:name="POST /sf/bulk/ingest/create">
            <http:response>
                <http:body><![CDATA[#[payload]]]></http:body>
            </http:response>
            <non-repeatable-streaming-strategy/>
        </http:listener>
        <salesforce:create-job-bulk-api-v2 config-ref="Salesforce_Config" object="Account" bulkOperation="insert" doc:name="Bulk Ingest ジョブ作成 + CSVアップロード"/>
        <ee:transform doc:name="JSON変換">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>

