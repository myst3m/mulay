        <http:listener config-ref="HTTP_Listener" path="/sf/describe/{sobject}" allowedMethods="GET" doc:name="GET /sf/describe/{sobject}"/>
        <salesforce:describe-sobject config-ref="Salesforce_Config" type="#[attributes.uriParams.sobject]" doc:name="オブジェクト定義取得"/>
        <ee:transform doc:name="JSON変換">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
