<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="urn:e" xmlns:e="urn:e" attributeFormDefault="qualified">
  <xs:element name="root">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="first-name" type="xs:string"/>
        <xs:element name="_x" type="xs:string"/>
        <xs:element name="class" type="xs:string"/>
        <xs:element name="if" type="xs:string"/>
        <xs:element name="default" type="xs:string"/>
        <xs:element name="match" type="xs:string"/>
        <xs:element name="untyped"/>
        <xs:element name="level" type="e:Level"/>
        <xs:element name="inner" type="e:Inner"/>
        <xs:element ref="e:other"/>
        <xs:element name="f" type="xs:float"/>
        <xs:element name="b64" type="xs:base64Binary"/>
        <xs:element name="t" type="xs:time"/>
        <xs:element name="anyuri" type="xs:anyURI"/>
        <xs:element name="dur" type="xs:duration"/>
        <xs:element name="qn" type="xs:QName"/>
        <xs:element name="tok" type="xs:token"/>
        <xs:element name="gy" type="xs:gYear"/>
      </xs:sequence>
      <xs:attribute name="type" type="xs:string"/>
      <xs:attribute name="n" type="xs:int" use="required"/>
      <xs:attribute name="lv" type="e:Level" default="1"/>
    </xs:complexType>
  </xs:element>
  <xs:element name="other" type="xs:int"/>
  <xs:simpleType name="Level"><xs:restriction base="xs:int"><xs:enumeration value="1"/><xs:enumeration value="2"/></xs:restriction></xs:simpleType>
  <xs:complexType name="Inner">
    <xs:sequence>
      <xs:element name="deep">
        <xs:complexType><xs:sequence><xs:element name="v" type="xs:string"/></xs:sequence><xs:attribute name="w" type="xs:string"/></xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
