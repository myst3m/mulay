%%% note
dw::Runtime::eval の失敗の Location の text は、行の前後の空白を除く (locationString の行はそのまま)。実行時の失敗
%%% script
%dw 2.0
output application/json
import * from dw::Runtime
---
eval("main.dwl", {"main.dwl": "do {\n    var a = b   \n    var b = 1\n    ---\n    a\n}"}).error.location
%%% output application/json
{
  "start": {
    "index": 17,
    "line": 2,
    "column": 13
  },
  "end": {
    "index": 18,
    "line": 2,
    "column": 14
  },
  "locationString": "\n2|     var a = b   \n               ^",
  "text": "var a = b",
  "sourceIdentifier": "main"
}
