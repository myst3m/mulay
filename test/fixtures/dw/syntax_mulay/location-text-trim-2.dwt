%%% note
dw::Runtime::eval の失敗の Location の text は、行の前後の空白を除く。オブジェクトの中の解決できない参照
%%% script
%dw 2.0
output application/json
import * from dw::Runtime
---
eval("main.dwl", {"main.dwl": "{\n  a: 1,\n    b: c   \n}"}).error.location
%%% output application/json
{
  "start": {
    "index": 17,
    "line": 3,
    "column": 8
  },
  "end": {
    "index": 18,
    "line": 3,
    "column": 9
  },
  "locationString": "\n3|     b: c   \n          ^",
  "text": "b: c",
  "sourceIdentifier": "main"
}
