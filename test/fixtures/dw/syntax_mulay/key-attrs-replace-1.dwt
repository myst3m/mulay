%%% note
(key) @(..): 書いた属性 (空でも) がキーの値の属性を置き換える
%%% script
%dw 2.0
output application/xml
var k = (payload.r mapObject (v, k) -> {x: k}).x
---
{r: {(k) @(b: 2): 1, (k) @(): 2, (k): 3, (k) @(a: 9): 4, (k) @((null)): 5}}
%%% input payload application/xml
<r><e a="1">z</e></r>
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<r>
  <e b="2">1</e>
  <e>2</e>
  <e a="1">3</e>
  <e a="9">4</e>
  <e>5</e>
</r>
