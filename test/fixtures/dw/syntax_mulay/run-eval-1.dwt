          "line": 50,
          "column": 71
        },
        "locationString": "\n50| fun fail (message: String = 'Error'): Nothing = native(\"system::fail\")\n                                                    ^^^^^^^^^^^^^^^^^^^^^^",
        "text": "fun fail (message: String = 'Error'): Nothing = native(\"system::fail\")",
        "sourceIdentifier": "dw::Runtime"
      },
      "stack": [
        "fail (dw::Runtime:50:49)",
        "main (main:1:1)"
      ],
