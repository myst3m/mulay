%%% note
run / eval: fs のモジュール (/a/b.dwl)、readerInputs と inputValues、コンパイルの失敗と実行時の失敗の形、run の出力。
%%% script
%dw 2.0
import * from dw::Runtime
output application/json
---
{a: run("main.dwl", {"main.dwl": "Utils::sum(1,2)", "/Utils.dwl": "fun sum(a,b) = a + b"}), c: eval("main.dwl", {"main.dwl": "dw::Runtime::fail(\"boom\")"}), e: eval("main.dwl", {"main.dwl": "payload.a"}, {payload: {value: "{\"a\": 5}" as Binary, mimeType: "application/json"}}), f: eval("main.dwl", {"main.dwl": "import mod::U\n---\nU::k", "/mod/U.dwl": "var k = 7"}), h: run("main.dwl", {"main.dwl": "%dw 2.0\noutput application/csv\n---\n[{a: 1}]"}), i: eval("main.dwl", {"main.dwl": "x + 1"}, {}, {x: 4})}
%%% output application/json
{
  "a": {
    "success": true,
    "result": {
      "value": "3",
      "mimeType": "application/dw",
      "encoding": "UTF-8",
      "logs": [
        
      ]
    }
  },
  "c": {
    "success": false,
    "error": {
      "kind": "UserException",
      "message": "boom\n\n50| fun fail (message: String = 'Error'): Nothing = native(\"system::fail\")\n                                                    ^^^^^^^^^^^^^^^^^^^^^^\nTrace:\n  at dw::Runtime::fail (line: 50, column: 49)\n  at main::main (line: 1, column: 1)",
      "location": {
        "start": {
          "index": 1155,
