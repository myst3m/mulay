%%% note
case "a" -> は Key にも一致する (== は偽のまま)
%%% script
%dw 2.0
output application/json
---
{a: payload.r.*image map $.@'type', c: payload.r.image.@'type', d: (payload.r.*image)[0].@x, e: payload.r mapObject (v, k) -> {x: k match { case "image" -> 1 else -> 2 }}, f: ((keysOf({a: 1}))[0] == "a")}
%%% input payload application/xml
<r><image type="S" x="1">u</image><image type="T">v</image></r>
%%% output application/json
{
  "a": [
    "S",
    "T"
  ],
  "c": "S",
  "d": "1",
  "e": {
    "x": 1,
    "x": 1
  },
  "f": false
}
