%%% note
@Metadata(key=..) の付いた annotation を式に付けるとメタデータになる (式全体に付く)
%%% script
%dw 2.8
output application/json
@Metadata(key="k1")
annotation A(value: String)
annotation C(value: String)
var x = @A(value = "v") "s"
var z = @C(value = "c") 4
var w = @A(value = "v") "s" ++ "t"
---
{x: x.^, z: z.^, w: w.^, w2: w}
%%% output application/json
{
  "x": {
    "k1": "v"
  },
  "z": {
    
  },
  "w": {
    "k1": "v"
  },
  "w2": "st"
}
