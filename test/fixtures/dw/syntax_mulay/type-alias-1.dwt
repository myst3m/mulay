%%% note
宣言した型の値は宣言の名前で書く。is / as は別名の中身で判定する (配列の要素の型は見ない)
%%% script
%dw 2.0
output application/json
type A = Array<String>
type S = String
type F = (String) -> Number
type FD = Date {format: "yyyy-MM-dd"}
---
{a: A, b: S, c: F, d: typeOf([1]), e: [1] is A, f: ["x"] is A, g: "x" as S, h: "2020-01-02" as FD, i: FD, j: typeOf("x" as S), k: String}
%%% output application/json
{
  "a": "A",
  "b": "S",
  "c": "F",
  "d": "Array",
  "e": true,
  "f": true,
  "g": "x",
  "h": "2020-01-02",
  "i": "FD",
  "j": "String",
  "k": "String"
}
