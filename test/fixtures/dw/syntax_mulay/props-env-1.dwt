%%% note
props() の値の出どころ: 環境変数 (HOME、USER、TMPDIR) を変えても user.home・user.name は passwd、java.io.tmpdir は /tmp。
user.language / user.country は LANG。user.dir は作業ディレクトリ (絶対パス)。
機械ごとに違う値 (ホームディレクトリ、利用者名、カーネルの版、作業ディレクトリ) は値そのものではなく、
環境変数の値になっていないこと・空でないこと・絶対パスであることを確かめる。
%%% script
%dw 2.0
import * from dw::Runtime
output application/json
var p = props()
var keys = ["file.encoding","file.separator","line.separator","path.separator","java.io.tmpdir","os.name","user.language","user.country"]
fun set(k) = sizeOf(p[k] default "") > 0
fun abs(k) = (p[k] default "") startsWith "/"
---
(keys map {($): p[$]}) ++ [
  {"os.arch is set": set("os.arch")},
  {"os.version is set": set("os.version")},
  {"user.dir is absolute": abs("user.dir")},
  {"user.home is absolute": abs("user.home")},
  {"user.home differs from HOME": p["user.home"] != "/nowhere"},
  {"user.name is set": set("user.name")},
  {"user.name differs from USER": p["user.name"] != "nobodyx"}
]
%%% env
HOME=/nowhere
USER=nobodyx
TMPDIR=/var/tmpx
LANG=ja_JP.UTF-8
%%% output application/json
[
  {
    "file.encoding": "UTF-8"
  },
  {
    "file.separator": "/"
  },
  {
    "line.separator": "\n"
  },
  {
    "path.separator": ":"
  },
  {
    "java.io.tmpdir": "/tmp"
  },
  {
    "os.name": "Linux"
  },
  {
    "user.language": "ja"
  },
  {
    "user.country": "JP"
  },
  {
    "os.arch is set": true
  },
  {
    "os.version is set": true
  },
  {
    "user.dir is absolute": true
  },
  {
    "user.home is absolute": true
  },
  {
    "user.home differs from HOME": true
  },
  {
    "user.name is set": true
  },
  {
    "user.name differs from USER": true
  }
]
