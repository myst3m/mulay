%%% note
名前空間付きのキー選択 ns#name / .* / .. / ..* は URI の一致するキーだけ選ぶ
%%% script
%dw 2.0
output application/json
ns h http://h
ns f http://f
---
{a: payload.r.h#t, b: payload.r.f#t, c: payload.r.*h#t, d: payload..f#t, e: payload..*h#t, g: payload.r.t, i: [payload.r].f#t, j: payload.r.h#x}
%%% input payload application/xml
<r><h:t xmlns:h="http://h">1</h:t><f:t xmlns:f="http://f">2</f:t><h:t xmlns:h="http://h">3</h:t><t>4</t></r>
%%% output application/json
{
  "a": "1",
  "b": "2",
  "c": [
    "1",
    "3"
  ],
  "d": [
    "2"
  ],
  "e": [
    "1",
    "3"
  ],
  "g": "1",
  "i": [
    "2"
  ],
  "j": null
}
