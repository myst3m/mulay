%%% note
Number as Binary は下位 8 ビットの 1 バイト
%%% script
%dw 2.0
output application/dw
---
[0 as Binary, 1 as Binary, 255 as Binary, 256 as Binary, -1 as Binary, 128 as Binary, 65535 as Binary, 12345678901234567890 as Binary]
%%% output application/dw
[
  "AA==" as Binary {base: "64"}, 
  "AQ==" as Binary {base: "64"}, 
  "/w==" as Binary {base: "64"}, 
  "AA==" as Binary {base: "64"}, 
  "/w==" as Binary {base: "64"}, 
  "gA==" as Binary {base: "64"}, 
  "/w==" as Binary {base: "64"}, 
  "0g==" as Binary {base: "64"}
]
