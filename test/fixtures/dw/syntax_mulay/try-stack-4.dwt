%%% note
try の失敗: native の組み込み関数の中の失敗は、標準ライブラリの .dwl の位置と枠が付く。
%%% script
%dw 2.0
import * from dw::Runtime
output application/json
---
{a: try(() -> fail("x")).error, b: try(() -> sqrt("a" as Number)).error.stack}
%%% output application/json
{
  "a": {
    "kind": "UserException",
    "message": "x",
    "location": "\n50| fun fail (message: String = 'Error'): Nothing = native(\"system::fail\")\n                                                    ^^^^^^^^^^^^^^^^^^^^^^",
    "stack": [
      "fail (dw::Runtime:50:49)",
      "main (anonymous:5:15)"
    ]
  },
  "b": [
    "main (anonymous:5:51)"
  ]
}
