%%% note
属性として書いた xmlns / xmlns:p は名前空間の束縛にならない (接頭辞は子で宣言し直し、既定の名前空間は xmlns="" で戻さない)。WSC の wsc:headers で見つけた
%%% script
%dw 2.0
output application/xml indent=false
ns p urn:p
ns d urn:d
---
{a @(xmlns: "urn:d"): {d#b: 1, c: {e: 2}}}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?><a xmlns="urn:d"><d:b xmlns:d="urn:d">1</d:b><c><e>2</e></c></a>
