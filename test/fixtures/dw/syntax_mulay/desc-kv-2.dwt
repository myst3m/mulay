%%% note
..&name: 同じ名前が複数あれば 1 つの Object にまとめ、前順にたどる
%%% script
%dw 2.0
output application/json
---
{
 a: {name: 1, name: 2, x: {name: 3}, y: [{name: 4}]}..&name,
 b: [{name: 1}, {q: {name: 2}}]..&name,
 c: {a: 1}..&name,
 e: {x: {name: {name: 5}}}..&name
}
%%% output application/json
{
  "a": [
    {
      "name": 1,
      "name": 2
    },
    {
      "name": 3
    },
    {
      "name": 4
    }
  ],
  "b": [
    {
      "name": 1
    },
    {
      "name": 2
    }
  ],
  "c": null,
  "e": [
    {
      "name": {
        "name": 5
      }
    },
    {
      "name": 5
    }
  ]
}
