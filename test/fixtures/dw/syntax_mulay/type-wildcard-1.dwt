%%% note
Object 型のキー _ は名前で宣言していない残りのフィールド (1 つ以上要る)
%%% script
%dw 2.0
output application/json
type D = {_: String}
type D2 = {a: Number, _: String}
type C = {|_: String|}
---
{a: {x: "s"} is D, b: {} is D, c: {x: 1} is D, d: {a: 1, b: "s"} is D2, e: {a: 1, b: 2} is D2, f: {a: 1} is D2, g: {x: "s", y: "t"} is C, h: {x: 1} is C}
%%% output application/json
{
  "a": true,
  "b": false,
  "c": false,
  "d": true,
  "e": false,
  "f": false,
  "g": true,
  "h": false
}
