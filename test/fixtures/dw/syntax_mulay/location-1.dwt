%%% note
location / locationString: 値を作った式の位置 (var は初期化の式、x.k はリテラルの中の値、fun は本体、組み込みは .dwl の native、オーバーロードのある関数は分からない)。
%%% script
%dw 2.0
import * from dw::Runtime
var a = 123
var b = {x: [1,
  2]}
fun f(x) = x + 1
output application/json
---
{a: location(a), b: location(b), bx: location(b.x), f: location(f), lam: location((x) -> x), lit: location("s"), up: location(upper), rt: location(fail), sum: location(1 + 2), ls: locationString(b), d: do { var q = [true] --- location(q[0]) }, c: locationString(a)}
