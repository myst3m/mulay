%%% note
.* / .. / 配列の .key の結果もキーの属性を運ぶ (.@x で読める)
%%% script
%dw 2.0
output application/json
---
{a: payload.r.*image map $.@x, b: payload..image map $.@x, c: payload.r.g.*h map $.@x, d: [payload.r.g, payload.r.g].h map $.@x, e: payload..*image map $.@x, f: payload.r.*image.@x}
%%% input payload application/xml
<r><image x="1">u</image><image x="2">v</image><g><h x="3">w</h></g></r>
%%% output application/json
{
  "a": [
    "1",
    "2"
  ],
  "b": [
    "1"
  ],
  "c": [
    "3"
  ],
  "d": [
    "3",
    "3"
  ],
  "e": [
    "1",
    "2"
  ],
  "f": [
    "1",
    "2"
  ]
}
