%%% note
try の失敗の location と stack: 名前付きの関数の枠 (末尾呼び出しも枠になる)、ラムダは枠にならない。
%%% script
%dw 2.0
import * from dw::Runtime
output application/json
fun f(x) = x.a!
fun g(y) = f(y)
---
try(() -> g({}))
%%% output application/json
{
  "success": false,
  "error": {
    "kind": "KeyNotFoundException",
    "message": "There is no key named 'a'",
    "location": "\n4| fun f(x) = x.a!\n              ^^^",
    "stack": [
      "f (anonymous:4:12)",
      "g (anonymous:5:12)",
      "main (anonymous:7:11)"
    ]
  }
}
