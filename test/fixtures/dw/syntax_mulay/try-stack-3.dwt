%%% note
try の失敗の stack: 末尾でない呼び出しの入れ子。
%%% script
%dw 2.0
import * from dw::Runtime
output application/json
fun h(n) = if (n == 0) (1 / n) else h(n - 1) + 1
---
try(() -> h(2)).error.stack
%%% output application/json
[
  "h (anonymous:4:25)",
  "h (anonymous:4:37)",
  "h (anonymous:4:37)",
  "main (anonymous:6:11)"
]
