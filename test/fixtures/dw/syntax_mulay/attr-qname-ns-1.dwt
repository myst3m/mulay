%%% note
属性の値の QName (nsPrefix / nsUri のメタデータ) は属性より先に宣言する
%%% script
%dw 2.0
output application/xml
---
{r: {a: "x:y" as String {nsPrefix: "x", nsUri: "http://u"}, b @(c: "p:q" as String {nsPrefix: "p", nsUri: "http://p"}, d: 1): "z", e: {f: "x:w" as String {nsPrefix: "x", nsUri: "http://u"}}}}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<r>
  <a>x:y</a>
  <b xmlns:p="http://p" c="p:q" d="1">z</b>
  <e>
    <f>x:w</f>
  </e>
</r>
