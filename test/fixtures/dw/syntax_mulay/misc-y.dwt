%%% note
Binary as String {base / encoding}
%%% script
%dw 2.0
output application/json
var b = "Hé" as Binary
---
{a: b as String {base: "64"}, b: b as String {base: "16"}, c: b as String {encoding: "ISO-8859-1"}, d: b as String, e: ("SGk=" as Binary {base: "64"}) as String}
