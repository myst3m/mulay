%%% note
try の失敗の location と stack: 本体の式の失敗。
%%% script
%dw 2.0
import * from dw::Runtime
output application/json
---
{a: try(() -> 1 / 0).error, b: try(() -> [1, 2] reduce ((x, acc) -> acc ++ x)).error}
%%% output application/json
{
  "a": {
    "kind": "DivisionByZeroException",
    "message": "Division by zero",
    "location": "\n5| {a: try(() -> 1 / 0).error, b: try(() -> [1, 2] reduce ((x, acc) -> acc ++ x)).error}\n                 ^^^^^",
    "stack": [
      "main (anonymous:5:15)"
    ]
  },
  "b": null
}
