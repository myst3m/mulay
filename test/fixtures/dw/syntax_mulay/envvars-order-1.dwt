%%% note
envVars() の並びは Java の System.getenv() と同じ (ProcessEnvironment が new HashMap<>(件数 + 3) に入れた反復順。
件数が増えて表が大きくなる場合)。
%%% script
%dw 2.0
import envVars from dw::System
output application/json
---
keysOf(envVars())
%%% env
PATH=/usr/bin
HOME=/home/test
SHELL=/bin/bash
LANG=C.UTF-8
USER=someone
TERM=xterm
EDITOR=vi
TZ=UTC
A=1
BB=2
CCC=3
DDDD=4
MULE_ENV=dev
JAVA_HOME=/opt/java
%%% output application/json
[
  "SHELL",
  "PATH",
  "TERM",
  "JAVA_HOME",
  "HOME",
  "A",
  "BB",
  "TZ",
  "EDITOR",
  "USER",
  "MULE_ENV",
  "DDDD",
  "LANG",
  "CCC"
]
