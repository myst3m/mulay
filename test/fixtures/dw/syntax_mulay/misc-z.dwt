%%% note
is は型のメタデータ (format、schema) も値のメタデータと照合する
%%% script
%dw 2.0
output application/json
type FD = Date {format: "dd-MMM-yy"}
type S = String {schema: "v"}
---
{a: |2020-01-01| is FD, b: ("01-Jan-20" as Date {format: "dd-MMM-yy"}) is FD, c: ("01-01-2020" as Date {format: "dd-MM-yyyy"}) is FD,
 d: "x" is S, e: ("x" as String {schema: "v"}) is S, f: ("x" as String {schema: "w"}) is S, g: ("x" as String {schema: "v", other: 1}) is S,
 h: ("x" as String {other: 1}) is S, i: "x" is String {schema: "v"}}
%%% output application/json
{
  "a": false,
  "b": true,
  "c": false,
  "d": false,
  "e": true,
  "f": false,
  "g": true,
  "h": false,
  "i": false
}
