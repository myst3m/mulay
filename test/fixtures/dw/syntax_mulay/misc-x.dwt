%%% note
最上位の fun のオーバーロードは引数の型で選ぶ。型引数のある型 F<T>
%%% script
%dw 2.0
output application/json
type F<C> = {data: C}
fun g(x: String) = "s"
fun g(x: Number) = "n"
fun h(f: F<String>) = "fs"
fun h(f: F<Binary>) = "fb"
---
{a: g(3), b: g("x"), c: h({data: "x"}), d: h({data: "x" as Binary}), e: {data: "x" as Binary} is F<Binary>, f: {data: "x" as Binary} is F<String>}
%%% output application/json
{
  "a": "n",
  "b": "s",
  "c": "fs",
  "d": "fb",
  "e": true,
  "f": false
}
