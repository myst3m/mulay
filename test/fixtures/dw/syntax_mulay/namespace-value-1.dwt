%%% note
{uri, prefix} as Namespace、Namespace の選択 (.uri .prefix)、writer は URI を書く
%%% script
%dw 2.0
output application/json
ns a http://a
var n = {uri: "http://x", prefix: "p"} as Namespace
---
{a: a, n: n, t: typeOf(n), p: n.prefix, u: n.uri, s: n as String, arr: [a]}
%%% output application/json
{
  "a": "http://a",
  "n": "http://x",
  "t": "Namespace",
  "p": "p",
  "u": "http://x",
  "s": "http://x",
  "arr": [
    "http://a"
  ]
}
