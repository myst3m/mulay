%%% note
配列への .@x / .@: 属性のある要素だけ集める (無ければ null)
%%% script
%dw 2.0
output application/json
---
{f: payload.r.*image.@x, g: payload.r.*image.@, h: [1, "a"].@x, i: [].@x, j: payload.r.*image.@x.@y}
%%% input payload application/xml
<r><image x="1">u</image><image>v</image><image x="3">v</image></r>
%%% output application/json
{
  "f": [
    "1",
    "3"
  ],
  "g": [
    {
      "x": "1"
    },
    {
      "x": "3"
    }
  ],
  "h": null,
  "i": null,
  "j": null
}
