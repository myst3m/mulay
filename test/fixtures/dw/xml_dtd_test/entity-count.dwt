%%% note
maxEntityCount (既定 1) を超える展開は失敗する。属性の既定値の中の参照も数える (文言の位置の部分は実 DW でも形が揺れるので本文だけ)。
%%% script
%dw 2.0
import try from dw::Runtime
output application/json
var t = try(() -> read("<!DOCTYPE r [<!ENTITY e \"x\">]><r>&e;&e;</r>", "application/xml", {supportDtd: true}))
var a = try(() -> read("<!DOCTYPE r [<!ENTITY e \"x\"><!ATTLIST b a CDATA \"&e;\"><!ATTLIST c a CDATA \"&e;\">]><r><b/></r>", "application/xml", {supportDtd: true}))
---
{text: (t.error.message default "") contains "Maximum entity expansion count limit (1) exceeded",
 attr: (a.error.message default "") contains "Maximum entity expansion count limit (1) exceeded"}
%%% output application/json
{
  "text": true,
  "attr": true
}
