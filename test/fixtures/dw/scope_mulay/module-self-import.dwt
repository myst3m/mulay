%%% note
初期化の式が初期化中の var 自身を参照する (実 DW: ForwardReferenceValidationPhase のコンパイルエラー)。モジュールの fun の中 (dw::Runtime::eval の fs のモジュールを import)。実 DW の文言はモジュールのエラーと、それを import した名前の解決のエラーの 2 つで、1 行目と種類と位置を比べる
%%% script
%dw 2.0
output application/json
import * from dw::Runtime
var r = eval("main.dwl", {"main.dwl": "import token from max::jwt\n---\ntoken()", "/max/jwt.dwl": "fun token() = do {\n  var now = now() as Number {unit: \"seconds\"}\n  ---\n  now\n}"})
---
{kind: r.error.kind, message: (r.error.message splitBy "\n")[0], location: r.error.location}
%%% output application/json
{
  "kind": "CompilationException",
  "message": "Variable: `now` is not yet initialized.",
  "location": {
    "start": {
      "index": 31,
      "line": 2,
      "column": 13
    },
    "end": {
      "index": 34,
      "line": 2,
      "column": 16
    },
    "locationString": "\n2|   var now = now() as Number {unit: \"seconds\"}\n               ^^^",
    "text": "var now = now() as Number {unit: \"seconds\"}",
    "sourceIdentifier": "max::jwt"
  }
}
