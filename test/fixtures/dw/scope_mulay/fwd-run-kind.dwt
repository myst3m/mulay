%%% note
まだ初期化していない var の参照 (実 DW: 実行時に "There is no variable named")。dw::Runtime::eval で見る失敗の種類 (InvalidVariableNameException) と位置
%%% script
%dw 2.0
output application/json
import * from dw::Runtime
---
eval("main.dwl", {"main.dwl": "do { var a = b var b = 1 --- a }"})
%%% output application/json
{
  "success": false,
  "error": {
    "kind": "InvalidVariableNameException",
    "message": "There is no variable named 'b'\n\n1| do { var a = b var b = 1 --- a }\n                ^\nTrace:\n  at main::main (line: 1, column: 14)",
    "location": {
      "start": {
        "index": 13,
        "line": 1,
        "column": 14
      },
      "end": {
        "index": 14,
        "line": 1,
        "column": 15
      },
      "locationString": "\n1| do { var a = b var b = 1 --- a }\n                ^",
      "text": "do { var a = b var b = 1 --- a }",
      "sourceIdentifier": "main"
    },
    "stack": [
      "main (main:1:14)"
    ],
    "logs": [
      
    ]
  }
}
