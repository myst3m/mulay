%%% note
dw::Runtime::eval の結果の関数と、入力の値に渡した関数を、別にコンパイルしたスクリプトの間で呼ぶ (ADR 108)。
返した関数、閉包、関数を返す関数、入力に渡した関数、入力に渡した関数を返させて呼ぶ。
%%% script
%dw 2.0
import eval from dw::Runtime
output application/json
---
{
  returned: eval("main.dwl", {"main.dwl": "(x) -> x + 1"}).result.value(41),
  closure: eval("main.dwl", {"main.dwl": "do { var k = 5 --- (x) -> x + k }"}).result.value(1),
  curried: eval("main.dwl", {"main.dwl": "(n) -> (x) -> x + n"}).result.value(1)(41),
  passedIn: eval("main.dwl", {"main.dwl": "f(20) + 1"}, {}, {f: (x) -> x * 2}).result.value,
  roundTrip: eval("main.dwl", {"main.dwl": "f"}, {}, {f: (x) -> x * 3}).result.value(5),
  lambdaArg: eval("main.dwl", {"main.dwl": "(g) -> g(2)"}).result.value((y) -> y * 10)
}
%%% output application/json
{
  "returned": 42,
  "closure": 6,
  "curried": 42,
  "passedIn": 41,
  "roundTrip": 15,
  "lambdaArg": 20
}
