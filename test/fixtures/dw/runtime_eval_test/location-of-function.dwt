%%% note
dw::Runtime の location と locationString に関数の値を渡すと、その関数を定義した場所 (中置で包んだ暗黙のラムダは右辺の式、ラムダは
ラムダ、名前付きの関数は宣言) を返す。引数の名前を通しても同じ (dw::test の must がこれを使う)。
%%% script
%dw 2.0
import * from dw::Runtime
output application/json
fun at(x, f: (Number) -> Any) = {s: locationString(f), l: location(f).start}
fun named(n) = n
fun pass(g) = location(g).start
---
{
  implicit: 1 at ($ + 1),
  lambda: pass((x) -> x * 2),
  named: pass(named),
  literal: locationString("lit")
}
%%% output application/json
{
  "implicit": {
    "s": "implicit: 1 at ($ + 1),",
    "l": {
      "index": 208,
      "line": 9,
      "column": 19
    }
  },
  "lambda": {
    "index": 231,
    "line": 10,
    "column": 16
  },
  "named": {
    "index": 150,
    "line": 5,
    "column": 16
  },
  "literal": "literal: locationString(\"lit\")"
}
