%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-core-functions-mapobject (関数ページ)
%%% script
%dw 2.0
output application/json
---
{"a":"b","c":"d"} mapObject (value,key,index) -> { (index) : { (value):key} }
%%% output application/json
{
  "0": {
    "b": "a"
  },
  "1": {
    "d": "c"
  }
}
