%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-core-functions-plusplus (関数ページ)
%%% script
%dw 2.0
output application/xml
---
{ concat : {aa: "a", bb: "b"} ++ {cc: "c"} }
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<concat>
  <aa>a</aa>
  <bb>b</bb>
  <cc>c</cc>
</concat>
