%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-core-functions-then (関数ページ)
%%% script
%dw 2.0
output application/json
---
{
    "chainResult": ["mariano", "de Achaval"]
            reduce ((item, accumulator) -> item ++ accumulator)
            then ((result) -> sizeOf(result)),
    "referenceResult" : ["mariano", "de Achaval"]
                         map ((item, index) -> upper(item))
                         then {
                            name: $[0],
                            lastName: $[1],
                            length: sizeOf($)
                        },
    "onNullReturnNull": []
                reduce ((item, accumulator) -> item ++ accumulator)
                then ((result) -> sizeOf(result))
}
%%% output application/json
{
  "chainResult": 17,
  "referenceResult": {
    "name": "MARIANO",
    "lastName": "DE ACHAVAL",
    "length": 2
  },
  "onNullReturnNull": null
}
