%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-core-functions-splitby (関数ページ)
doc と相違 (表記のみ: 引用符・括弧・書式の違いで、値は同じ)
doc の Output:
  {
    splitters: {
      split1: [ "a", "c" ],
      split2: [ "hello", "world" ],
      split3: [ "no match" ],
      split4: [ "", "match" ],
      split5: [ "a", "b", "c", "d" ]
    }
  }
%%% script
%dw 2.0
output application/json
---
{ "splitters" : {
   "split1" : "a-b-c" splitBy(/.b./),
   "split2" : "hello world" splitBy(/\s/),
   "split3" : "no match" splitBy(/^s/),
   "split4" : "no match" splitBy(/^n../),
   "split5" : "a1b2c3d4A1B2C3D" splitBy(/[0-9A-Z]/)
  }
}
%%% output application/json
{
  "splitters": {
    "split1": [
      "a",
      "c"
    ],
    "split2": [
      "hello",
      "world"
    ],
    "split3": [
      "no match"
    ],
    "split4": [
      "",
      "match"
    ],
    "split5": [
      "a",
      "b",
      "c",
      "d"
    ]
  }
}
