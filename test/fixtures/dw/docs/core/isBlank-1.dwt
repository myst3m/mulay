%%% note
由来: 自作 (doc に実行できる例が無いため補った)
%%% script
%dw 2.0
output application/json
---
{
  "empty": isBlank(""),
  "spaces": isBlank("   "),
  "tabs": isBlank("\t\n"),
  "text": isBlank(" a "),
  "null": isBlank(null),
  "missing": isBlank(payload.nonExistingValue)
}
%%% input payload application/json
{"a": 1}
%%% output application/json
{
  "empty": true,
  "spaces": true,
  "tabs": true,
  "text": false,
  "null": true,
  "missing": true
}
