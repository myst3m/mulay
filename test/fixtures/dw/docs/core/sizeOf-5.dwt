%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-core-functions-sizeof (関数ページ)
%%% script
%dw 2.0
output application/json
---
{

BinarySizeOf: sizeOf("'my word'" as Binary) ++ " " ++ sizeOf("'my word'" as Binary),

StringSizeOf: sizeOf("'my word'") ++ " " ++ sizeOf("'my word'")

}
%%% output application/json
{
  "BinarySizeOf": "9 9",
  "StringSizeOf": "9 9"
}
