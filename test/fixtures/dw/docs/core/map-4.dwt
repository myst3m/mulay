%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-core-functions-map (関数ページ)
%%% script
%dw 2.0
output application/csv
---
[{
 "age": 14 ,
 "name": "Claire"
}, {
 "age": 56,
 "name": "Max"
}, {
 "age": 89,
 "name": "John"
}] map {
   age: $.age,
   name: $.name
}
%%% output application/csv
age,name
14,Claire
56,Max
89,John

