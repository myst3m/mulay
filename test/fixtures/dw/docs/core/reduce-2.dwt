%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-core-functions-reduce (関数ページ)
%%% script
%dw 2.0
var myNums = [1,2,3,4]
var myEmptyList = []
output application/json
---
{
   "sum" : myNums reduce ($$ + $),
   "concat" : myNums reduce ($$ ++ $),
   "emptyList" : myEmptyList reduce ($$ ++ $)
}
%%% output application/json
{
  "sum": 10,
  "concat": "1234",
  "emptyList": null
}
