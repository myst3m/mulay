%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-core-functions-sizeof (関数ページ)
%%% script
%dw 2.0
output application/json
---
{
  "arraySizes": {
     size3: sizeOf([1,2,3]),
     size2: sizeOf([[1,2,3],[4]]),
     size0: sizeOf([])
   }
}
%%% output application/json
{
  "arraySizes": {
    "size3": 3,
    "size2": 2,
    "size0": 0
  }
}
