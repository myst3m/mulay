%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-core-functions-plusplus (関数ページ)
%%% script
%dw 2.0
output application/json
---
{ "a" : [0, 1, true, "my string"] ++ [2, [3,4,5], {"a": 6}] }
%%% output application/json
{
  "a": [
    0,
    1,
    true,
    "my string",
    2,
    [
      3,
      4,
      5
    ],
    {
      "a": 6
    }
  ]
}
