%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-core-functions-zip (関数ページ)
%%% script
%dw 2.0
output application/json
---
{
  "a" : [0, 1, 2, 3] zip ["a", "b", "c", "d"],
  "b" : [0, 1, 2, 3] zip ["a"],
  "c" : [0, 1, 2, 3] zip ["a", "b"],
  "d" : [0, 1, 2] zip ["a", "b", "c", "d"]
}
%%% output application/json
{
  "a": [
    [
      0,
      "a"
    ],
    [
      1,
      "b"
    ],
    [
      2,
      "c"
    ],
    [
      3,
      "d"
    ]
  ],
  "b": [
    [
      0,
      "a"
    ]
  ],
  "c": [
    [
      0,
      "a"
    ],
    [
      1,
      "b"
    ]
  ],
  "d": [
    [
      0,
      "a"
    ],
    [
      1,
      "b"
    ],
    [
      2,
      "c"
    ]
  ]
}
