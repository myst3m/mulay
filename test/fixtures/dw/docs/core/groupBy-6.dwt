%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-core-functions-groupby (関数ページ)
%%% script
%dw 2.0
var myRead =
read("<prices><price>9.99</price><price>10.99</price></prices>","application/xml")
output application/json
---
myRead.prices groupBy "costs"
%%% output application/json
{
  "costs": {
    "price": "9.99",
    "price": "10.99"
  }
}
