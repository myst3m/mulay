%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-core-functions-groupby (関数ページ)
%%% script
%dw 2.0
var myArray = [
   { "name": "Foo", "language": "Java" },
   { "name": "Bar", "language": "Scala" },
   { "name": "FooBar", "language": "Java" }
]
output application/json
---
myArray groupBy (item) -> item.language
%%% output application/json
{
  "Java": [
    {
      "name": "Foo",
      "language": "Java"
    },
    {
      "name": "FooBar",
      "language": "Java"
    }
  ],
  "Scala": [
    {
      "name": "Bar",
      "language": "Scala"
    }
  ]
}
