%%% script
%dw 2.0
output application/json
---
unzip([ [0,"a","W"], [1,"b","X"], [2,"c","Y"], [3,"d","Z"] ])
%%% output application/json
[
  [
    0,
    1,
    2,
    3
  ],
  [
    "a",
    "b",
    "c",
    "d"
  ],
  [
    "W",
    "X",
    "Y",
    "Z"
  ]
]
