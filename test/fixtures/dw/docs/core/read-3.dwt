%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-core-functions-read (関数ページ)
%%% script
%dw 2.0
output application/xml
---
{
   "XML" : read("<prices><basic>9.99</basic></prices>",
                "application/xml",
                { indexedReader: "false" })."prices"
}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<XML>
  <basic>9.99</basic>
</XML>
