%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-core-functions-filterobject (関数ページ)
%%% script
%dw 2.0
output application/json
var myObject = {
    str1 : "String 1",
    str2 : "String 2",
    str3 : null,
    str4 : "String 4",
}
---
myObject filterObject $ != null
%%% output application/json
{
  "str1": "String 1",
  "str2": "String 2",
  "str4": "String 4"
}
