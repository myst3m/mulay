%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-core-functions-splitby (関数ページ)
%%% script
%dw 2.0
output application/json
---
'root.sources.data.`test.branch.BranchSource`.source.traits' splitBy(/[.](?=(?:[^`]*`[^`]*`)*[^`]*$)/)
%%% output application/json
[
  "root",
  "sources",
  "data",
  "`test.branch.BranchSource`",
  "source",
  "traits"
]
