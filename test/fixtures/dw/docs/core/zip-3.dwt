%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-core-functions-zip (関数ページ)
%%% script
%dw 2.0
output application/json
var myvar = {
   "list1": ["a", "b"],
   "list2": [1, 2, 3],
   "list3": ["aa", "bb"],
   "list4": [["A", "B", "C"], [11, 12], ["aA", "bB"]]
}
---
((myvar.list1 zip myvar.list2) zip myvar.list3) zip myvar.list4
%%% output application/json
[
  [
    [
      [
        "a",
        1
      ],
      "aa"
    ],
    [
      "A",
      "B",
      "C"
    ]
  ],
  [
    [
      [
        "b",
        2
      ],
      "bb"
    ],
    [
      11,
      12
    ]
  ]
]
