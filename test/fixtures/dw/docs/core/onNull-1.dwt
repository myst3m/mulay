%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-core-functions-onnull (関数ページ)
%%% script
%dw 2.0
output application/json
---
{
     "onNull": []
             reduce ((item, accumulator) -> item ++ accumulator)
             then ((result) -> sizeOf(result))
             onNull "Empty Text"
 }
%%% output application/json
{
  "onNull": "Empty Text"
}
