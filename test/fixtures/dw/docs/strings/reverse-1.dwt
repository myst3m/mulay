%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-strings-functions-reverse (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Strings
output application/json
---
 {
     a: reverse("Mariano"),
     b: reverse(null),
     c: reverse("")
 }
%%% output application/json
{
  "a": "onairaM",
  "b": null,
  "c": ""
}
