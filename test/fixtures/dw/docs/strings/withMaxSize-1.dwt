%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-strings-functions-withmaxsize (関数ページ)
%%% script
%dw 2.0
import withMaxSize from dw::core::Strings
output application/json
---
{
   a: "123" withMaxSize 10,
   b: "123" withMaxSize 3,
   c: "123" withMaxSize 2,
   d: "123" withMaxSize 0,
   e: null withMaxSize 23,
}
%%% output application/json
{
  "a": "123",
  "b": "123",
  "c": "12",
  "d": "123",
  "e": null
}
