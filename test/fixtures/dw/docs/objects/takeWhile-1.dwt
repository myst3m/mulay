%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-objects-functions-takewhile (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Objects
output application/json
var obj = {
  "a": 1,
  "b": 2,
  "c": 5,
  "d": 1
}
---
obj takeWhile ((value, key) ->  value < 3)
%%% output application/json
{
  "a": 1,
  "b": 2
}
