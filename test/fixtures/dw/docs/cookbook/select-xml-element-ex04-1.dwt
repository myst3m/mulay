%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-select-xml-elements (cookbook partial select-xml-element-ex04)
%%% script
%dw 2.0
output application/xml
---
{ mysubelement : payload.root[0].subelement1 }
%%% input payload application/xml
<root>
    <element>
        <subelement1>SE1</subelement1>
    </element>
    <element>E2</element>
</root>
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<mysubelement>SE1</mysubelement>
