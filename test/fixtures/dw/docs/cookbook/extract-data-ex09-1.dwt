%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-extract-data (cookbook partial extract-data-ex09)
%%% script
%dw 2.0
output application/json
---
{ names: payload.people..name }
%%% input payload application/json
{
  "people": {
    "person": {
      "name": "Nial",
      "address": {
        "street": {
          "name": "Italia",
          "number": 2164
        },
        "area": {
          "zone": "San Isidro",
          "name": "Martinez"
        }
      }
    }
  }
}
%%% output application/json
{
  "names": [
    "Nial",
    "Italia",
    "Martinez"
  ]
}
