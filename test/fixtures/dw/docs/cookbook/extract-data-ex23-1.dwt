%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-extract-data (cookbook partial extract-data-ex23)
%%% script
%dw 2.0
output application/json
---
{ users: payload.users.*name[?( 1 == 1)] }
%%% input payload application/xml
<users>
  <name>Mariano</name>
  <name>Luis</name>
  <name>Mariano</name>
</users>
%%% output application/json
{
  "users": [
    "Mariano",
    "Luis",
    "Mariano"
  ]
}
