%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-output-a-field-when-present (cookbook partial output-a-field-when-present)
%%% script
%dw 2.0
output application/xml
---
users: { (payload map
        user: {
          name: $.name,
          (insurance: $.insurance) if($.insurance?)
        } )
}
%%% input payload application/json
[
  {
    "name" : "Julian",
    "gender" : "Male",
    "age" : 41,
    "insurance": "Osde"
  },
  {
    "name" : "Mariano",
    "gender" : "Male",
    "age" : 33
  }
]
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<users>
  <user>
    <name>Julian</name>
    <insurance>Osde</insurance>
  </user>
  <user>
    <name>Mariano</name>
  </user>
</users>
