%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-map-an-object-key (cookbook partial map-an-object-key)
%%% script
%dw 2.0
output application/json

var append =
    {
    "Id": "2",
    "Access": "4444",
    "Subteam": "1",
    }

fun extractNumber(pageName: Key) =
     (pageName as String match  /\(sheet\)([0-9]+)/)[1]
---
payload mapObject ((value, key, index) -> do {
        if(extractNumber(key) == append.Id)
            {(key): value << append}
         else
            {(key): value}
})
%%% input payload application/json
{
"(sheet)1": [
{
  "Id": 1.0,
  "Team": "Mule",
  "timestamp": "2019-09-26T16:37:54",
  "Access": 12431
}
],
"(sheet)2": [
{
  "Id": 2.0,
  "Team": "Max",
  "timestamp": "2019-09-26T16:37:54",
  "Access": 81243
},
{
  "Id": 2.0,
  "Team": "Max Mule",
  "timestamp": "2019-09-26T18:00:54",
  "Access": 67676
}
]
}
%%% output application/json
{
  "(sheet)1": [
    {
      "Id": 1,
      "Team": "Mule",
      "timestamp": "2019-09-26T16:37:54",
      "Access": 12431
    }
  ],
  "(sheet)2": [
    {
      "Id": 2,
      "Team": "Max",
      "timestamp": "2019-09-26T16:37:54",
      "Access": 81243
    },
    {
      "Id": 2,
      "Team": "Max Mule",
      "timestamp": "2019-09-26T18:00:54",
      "Access": 67676
    },
    {
      "Id": "2",
      "Access": "4444",
      "Subteam": "1"
    }
  ]
}
