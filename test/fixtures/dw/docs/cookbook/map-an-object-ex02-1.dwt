%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-map-an-object (cookbook partial map-an-object-ex02)
%%% script
%dw 2.0
output application/csv
---
valuesOf(
    payload
        groupBy ((item, index) -> (
            item.FirstName ++ item.LastName ++ item.Age))
        mapObject ((value, key, index) ->
            (index): {
                "Sr.No.": value."Sr.No." joinBy ":",
                "FirstName": value.FirstName[0],
                "LastName": value.LastName[0],
                "Age": value.Age[0],
                "Team Name": value."Team Name" joinBy ":",
                "Role": value.Role joinBy ":"
            })
)
%%% input payload application/json
[
