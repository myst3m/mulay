%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-map-and-flatten (cookbook partial map-and-flatten)
%%% script
%dw 2.0
output application/json
var myData = [{name:1},{name:2},{name:3}]
fun myExternalFunction(data): Array =
    if(data.name == 1)
        []
    else if(data.name == 2)
        [{name: 3}, {name:5}]
    else
        [data]
---
//flatten(myData map ((item, index) -> myExternalFunction(item)))
myData flatMap ((item, index) -> myExternalFunction(item))
%%% output application/json
[
  {
    "name": 3
  },
  {
    "name": 5
  },
  {
    "name": 3
  }
]
