%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-select-xml-elements (cookbook partial select-xml-element-ex02)
%%% script
%dw 2.0
output application/xml
---
{ newname : payload.language.name }
%%% input payload application/xml
<language>
    <name>DataWeave</name>
    <version>2.0</version>
</language>
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<newname>DataWeave</newname>
