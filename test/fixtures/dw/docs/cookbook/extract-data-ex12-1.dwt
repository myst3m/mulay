%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-extract-data (cookbook partial extract-data-ex12)
%%% script
%dw 2.0
output application/json
---
payload.people[1]
%%% input payload application/json
{
  "people": [
        {
          "nameFirst": "Nial",
          "nameLast": "Martinez"
        },
        {
          "nameFirst": "Coty",
          "nameLast": "Belgrano"
        }
    ]
}
%%% output application/json
{
  "nameFirst": "Coty",
  "nameLast": "Belgrano"
}
