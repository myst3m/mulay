%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-pluck (cookbook partial pluck)
%%% script
%dw 2.0
output application/json
---
payload pluck (value,key)  -> {
  Test: {
    Key: key,
    Value: value
  }
}
%%% input payload application/json
{
  "firstName": "jason", "job": "engineer", "dept":"support"
}
%%% output application/json
[
  {
    "Test": {
      "Key": "firstName",
      "Value": "jason"
    }
  },
  {
    "Test": {
      "Key": "job",
      "Value": "engineer"
    }
  },
  {
    "Test": {
      "Key": "dept",
      "Value": "support"
    }
  }
]
