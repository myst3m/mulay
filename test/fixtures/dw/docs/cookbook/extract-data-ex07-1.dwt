%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-extract-data (cookbook partial extract-data-ex07)
%%% script
%dw 2.0
output application/json
---
payload.users.*user
%%% input payload application/xml
<users>
  <user>Mariano</user>
  <user>Martin</user>
  <user>Leandro</user>
</users>
%%% output application/json
[
  "Mariano",
  "Martin",
  "Leandro"
]
