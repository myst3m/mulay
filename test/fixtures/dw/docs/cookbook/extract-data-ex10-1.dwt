%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-extract-data (cookbook partial extract-data-ex10)
%%% script
%dw 2.0
output application/xml
---
{
  users: payload.users.&user
}
%%% input payload application/xml
<?xml version='1.0' encoding='US-ASCII'?>
<users>
  <user>Mariano</user>
  <user>Martin</user>
  <user>Leandro</user>
  <admin>Admin</admin>
  <admin>org_owner</admin>
</users>
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<users>
  <user>Mariano</user>
  <user>Martin</user>
  <user>Leandro</user>
</users>
