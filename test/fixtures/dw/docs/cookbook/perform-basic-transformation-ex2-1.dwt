%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-perform-basic-transformation (cookbook partial perform-basic-transformation-ex2)
%%% script
%dw 2.0
output application/json duplicateKeyAsArray=true
---
payload
%%% input payload application/xml
<order>
  <product-lineitems>
	<product-lineitem>
	   <net-price>100.0</net-price>
	</product-lineitem>
	<product-lineitem>
	     <net-price>498.00</net-price>
	</product-lineitem>
  </product-lineitems>
</order>
%%% output application/json
{
  "order": {
    "product-lineitems": {
      "product-lineitem": [
      {
        "net-price": "100.0"
      },
      {
        "net-price": "498.00"
      }
      ]
    }
  }
}
