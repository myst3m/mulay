%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-set-reader-writer-props (cookbook partial set-reader-writer-props-ex01)
%%% script
%dw 2.0
output application/json indent = false
---
{
	hello : "world",
	bello : "world",
	mello : "world"
}
%%% output application/json
{"hello": "world","bello": "world","mello": "world"}
