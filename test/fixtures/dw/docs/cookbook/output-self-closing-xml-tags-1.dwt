%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-output-self-closing-xml-tags (cookbook partial output-self-closing-xml-tags)
%%% script
%dw 2.0
output application/xml inlineCloseOn="empty"
---
payload
%%% input payload application/json
{
  "customer":{
    "userName": "John Doe",
    "password":{},
    "status":"active",
    "lastLogin":{}
  }
}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<customer>
  <userName>John Doe</userName>
  <password/>
  <status>active</status>
  <lastLogin/>
</customer>
