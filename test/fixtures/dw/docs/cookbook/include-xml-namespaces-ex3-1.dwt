%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-include-xml-namespaces (cookbook partial include-xml-namespaces-ex3)
%%% script
%dw 2.0
output application/xml
var myNS = {uri: "http://www.abc.com", prefix: "ns-0"} as Namespace
---
{myNS#bla : "dw"}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<ns-0:bla xmlns:ns-0="http://www.abc.com">dw</ns-0:bla>
