%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-flatten-arrays (cookbook partial flatten-arrays-ex2)
%%% script
%dw 2.0
var arrayOne = [
                  [
                     "fruit" : "orange",
                     "fruit" : "apple"
                  ],
                  [
                     "fruit" : "grape",
                     "notfruit" : "something else"
                  ]
               ]
var arrayTwo = [
                  [
                  	{  "fruit" : "kiwi" }
                  ],
                  "fruit" : "strawberry",
                  "fruit" : "plum",
                  { "fruit" : "banana" },
                  "notfruit" : "something else"
               ]
output application/json
---
flatten(arrayOne ++ arrayTwo)
%%% output application/json
[
  {
    "fruit": "orange"
  },
  {
    "fruit": "apple"
  },
  {
    "fruit": "grape"
  },
  {
    "notfruit": "something else"
  },
  {
    "fruit": "kiwi"
  },
  {
    "fruit": "strawberry"
  },
  {
    "fruit": "plum"
  },
  {
    "fruit": "banana"
  },
  {
    "notfruit": "something else"
  }
]
