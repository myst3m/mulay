%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-defaults (cookbook partial defaults-ex5)
%%% script
%dw 2.0
var myVar = "someString"
output application/json
---
myVar match {
    case myVarOne if (myVar == "some") -> ("some" ++ "is myVar")
    case myVarOne if (myVar == "strings") -> ("strings" ++ "is myVar")
    else -> myVar ++ " is myVar"
}
%%% output application/json
"someString is myVar"
