%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-defaults (cookbook partial defaults-ex2)
%%% script
%dw 2.0
output application/json
---
{
  "userId": payload.id default "0000",
  "userName": payload.name default "Undefined"
}
%%% input payload application/json
{
  "id": null
}
%%% output application/json
{
  "userId": "0000",
  "userName": "Undefined"
}
