%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-cookbook-extract-data (cookbook partial extract-data-ex24)
%%% script
%dw 2.0
output application/json
---
payload mapObject { ($$) : $[?($=="Mariano")] }
%%% input payload application/xml
<users>
  <name>Mariano</name>
  <name>Luis</name>
  <name>Mariano</name>
</users>
%%% output application/json
{
  "users": {
    "name": "Mariano",
    "name": "Mariano"
  }
}
