%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-system-functions-envvar (関数ページ)
実行ごとに変わる部分は %%% mask / %%% env / %%% variants で扱う (docs/fixtures.md)
%%% script
%dw 2.0
import * from dw::System
output application/json
---
{
    "envVars" : [
       "real" : envVar("SHELL"),
       "fake" : envVar("FAKE_ENV_VAR")
    ]
}
%%% env
SHELL=/bin/bash
HOME=/home/test
%%% output application/json
{
  "envVars": [
    {
      "real": "/bin/bash"
    },
    {
      "fake": null
    }
  ]
}
