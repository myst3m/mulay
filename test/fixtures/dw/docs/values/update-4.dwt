%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-values-functions-update (関数ページ)
%%% script
%dw 2.0
import * from dw::util::Values
output application/json
---
[{role: "a", name: "spiderman"}, {role: "b", name: "batman"}] update "role" with "Super Hero"
%%% output application/json
[
  {
    "role": "Super Hero",
    "name": "spiderman"
  },
  {
    "role": "Super Hero",
    "name": "batman"
  }
]
