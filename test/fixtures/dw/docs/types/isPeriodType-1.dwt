由来: https://docs.mulesoft.com/dataweave/2.11/dw-types-functions-isperiodtype (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Types
type APeriod = Period
output application/json
---
{
   a: isPeriodType(APeriod),
   b: isPeriodType(Period),
   c: isPeriodType(String),
}
%%% output application/json
{
  "a": true,
  "b": true,
  "c": false
}
