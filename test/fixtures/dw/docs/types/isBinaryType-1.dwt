%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-types-functions-isbinarytype (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Types
type ABinary = Binary
output application/json
---
{
   a: isBinaryType(ABinary),
   b: isBinaryType(Binary),
   c: isBinaryType(String),
}
%%% output application/json
{
  "a": true,
  "b": true,
  "c": false
}
