%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-types-functions-isuniontype (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Types
type AType = String | Number
output application/json
---
{
   a: isUnionType(AType),
   b: isUnionType(Boolean),
}
%%% output application/json
{
  "a": true,
  "b": false
}
