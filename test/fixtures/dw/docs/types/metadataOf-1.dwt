%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-types-functions-metadataof (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Types
type AType = String {format: "YYYY-MM-dd"}
output application/json
---
{
   a: metadataOf(AType)
}
%%% output application/json
{
  "a": {
    "format": "YYYY-MM-dd"
  }
}
