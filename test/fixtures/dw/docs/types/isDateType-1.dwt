%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-types-functions-isdatetype (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Types
type ADate = Date
output application/json
---
{
   a: isDateType(ADate),
   b: isDateType(Date),
   c: isDateType(String),
}
%%% output application/json
{
  "a": true,
  "b": true,
  "c": false
}
