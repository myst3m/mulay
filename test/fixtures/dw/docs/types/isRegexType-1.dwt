%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-types-functions-isregextype (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Types
type ARegex = Regex
output application/json
---
{
   a: isRegexType(ARegex),
   b: isRegexType(Regex),
   c: isRegexType(Boolean),
}
%%% output application/json
{
  "a": true,
  "b": true,
  "c": false
}
