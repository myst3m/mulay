%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-types-functions-isanytype (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Types
type AAny = Any
output application/json
---
{
   a: isAnyType(AAny),
   b: isAnyType(Any),
   c: isAnyType(String),
}
%%% output application/json
{
  "a": true,
  "b": true,
  "c": false
}
