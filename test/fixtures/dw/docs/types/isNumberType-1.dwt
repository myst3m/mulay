%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-types-functions-isnumbertype (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Types
type ANumber = Number
output application/json
---
{
   a: isNumberType(ANumber),
   b: isNumberType(Number),
   c: isNumberType(String),
}
%%% output application/json
{
  "a": true,
  "b": true,
  "c": false
}
