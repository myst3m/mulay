%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-types-functions-intersectionitems (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Types
type AType = {name: String} & {age: Number}
output application/json
---
{
   a: intersectionItems(AType)
}
%%% output application/json
{
  "a": [
    "Object",
    "Object"
  ]
}
