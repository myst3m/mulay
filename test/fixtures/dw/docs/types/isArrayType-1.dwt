%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-types-functions-isarraytype (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Types
type AType = Array<String>
output application/json
---
{
   a: isArrayType(AType),
   b: isArrayType(Boolean),
}
%%% output application/json
{
  "a": true,
  "b": false
}
