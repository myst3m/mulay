%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-types-functions-isstringtype (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Types
type AString = String
output application/json
---
{
   a: isStringType(AString),
   b: isStringType(String),
   c: isStringType(Boolean),
}
%%% output application/json
{
  "a": true,
  "b": true,
  "c": false
}
