%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-types-functions-isnulltype (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Types
type ANull = Null
output application/json
---
{
   a: isNullType(ANull),
   b: isNullType(Null),
   c: isNullType(String),
}
%%% output application/json
{
  "a": true,
  "b": true,
  "c": false
}
