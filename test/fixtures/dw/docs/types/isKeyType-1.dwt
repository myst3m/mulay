%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-types-functions-iskeytype (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Types
type AKey = Key
output application/json
---
{
   a: isKeyType(AKey),
   b: isKeyType(Key),
   c: isKeyType(Boolean),
}
%%% output application/json
{
  "a": true,
  "b": true,
  "c": false
}
