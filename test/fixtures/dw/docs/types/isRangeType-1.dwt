%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-types-functions-israngetype (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Types
type ARange = Range
output application/json
---
{
   a: isRangeType(ARange),
   b: isRangeType(Range),
   c: isRangeType(String),
}
%%% output application/json
{
  "a": true,
  "b": true,
  "c": false
}
