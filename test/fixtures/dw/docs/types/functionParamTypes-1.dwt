%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-types-functions-functionparamtypes (関数ページ)
doc と相違 (doc の Output と実 DW の出力の値が一致しない)
doc の Output:
  {
     "a": [
       {
         "paramType": "String",
         "optional": false
       },
       {
         "paramType": "Number",
         "optional": false
       }
     ],
     "b": [
  
     ]
   }
%%% script
%dw 2.0
output application/json
import * from dw::core::Types
type AFunction = (String, Number) -> Number
type AFunction2 = () -> Number
---
{
    a: functionParamTypes(AFunction),
    b: functionParamTypes(AFunction2)
}
%%% output application/json
{
  "a": [
    {
      "paramType": "String",
      "name": "param_0",
      "optional": false
    },
    {
      "paramType": "Number",
      "name": "param_1",
      "optional": false
    }
  ],
  "b": [
    
  ]
}
