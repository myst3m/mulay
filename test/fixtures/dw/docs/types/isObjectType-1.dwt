%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-types-functions-isobjecttype (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Types
type AType = {name: String}
output application/json
---
{
   a: isObjectType(AType),
   b: isObjectType(Boolean),
}
%%% output application/json
{
  "a": true,
  "b": false
}
