%%% note
由来: 自作 (doc に実行できる例が無いため補った)
%%% script
%dw 2.0
import generateBoundary from dw::module::Multipart
output application/json
---
{ dflt: sizeOf(generateBoundary()), ten: sizeOf(generateBoundary(10)), chars: generateBoundary(40) matches /[0-9A-Za-z_'()+,.\/:=?-]+/ }
%%% output application/json
{
  "dflt": 70,
  "ten": 10,
  "chars": true
}
