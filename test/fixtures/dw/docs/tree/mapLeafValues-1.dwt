%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-tree-functions-mapleafvalues (関数ページ)
%%% script
%dw 2.0
import * from dw::util::Tree
output application/json
---
 {
     user: [{
         name: "mariano",
         lastName: "achaval"
     }],
     group: "data-weave"
 } mapLeafValues (value, path) -> upper(value)
%%% output application/json
{
  "user": [
    {
      "name": "MARIANO",
      "lastName": "ACHAVAL"
    }
  ],
  "group": "DATA-WEAVE"
}
