%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-formats-java (言語ガイド)
doc に Output の記載なし
%%% script
%dw 2.0
output application/json
---
[{
    name: "Tomo",
    lastName: "Chibana"
},
{
    name: "Ana",
    lastName: "Felissati"
},
{
    name: "Leandro",
    lastName: "Shokida"
}
] as Array {class: "java.util.ArrayList<User>"}
%%% output application/json
[
  {
    "name": "Tomo",
    "lastName": "Chibana"
  },
  {
    "name": "Ana",
    "lastName": "Felissati"
  },
  {
    "name": "Leandro",
    "lastName": "Shokida"
  }
]
