%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-formats-multipart (言語ガイド)
doc に Output の記載なし
%%% script
%dw 2.0
output application/dw
---
payload
%%% input payload multipart/form-data boundary=34b21
--34b21
Content-Disposition: form-data; name="text"
Content-Type: text/plain
Book
--34b21
Content-Disposition: form-data; name="file1"; filename="a.json"
Content-Type: application/json
{
"title": "Java 8 in Action",
"author": "Mario Fusco",
"year": 2014
}
--34b21
Content-Disposition: form-data; name="file2"; filename="a.html"
Content-Type: text/html

<title> Available for download! </title>
--34b21--
%%% output application/dw
{
  parts: {
    text: {
      headers: {
        "Content-Disposition": {
          name: "text",
          subtype: "form-data"
        },
        "Content-Type": "text/plain",
        Book: "Book",
        "--34b21": "--34b21",
        "Content-Disposition": {
          name: "file1",
          filename: "a.json",
          subtype: "form-data"
        },
        "Content-Type": "application/json",
        "{": "{",
        "\"title\"": "\"Java 8 in Action\",",
        "\"author\"": "\"Mario Fusco\",",
        "\"year\"": "2014",
        "}": "}",
        "--34b21": "--34b21",
        "Content-Disposition": {
          name: "file2",
          filename: "a.html",
          subtype: "form-data"
        },
        "Content-Type": "text/html"
      },
      content: "<title> Available for download! </title>" as String {raw: "PHRpdGxlPiBBdmFpbGFibGUgZm9yIGRvd25sb2FkISA8L3RpdGxlPg==" as Binary {base: "64"}, mediaType: "text/plain", mimeType: "text/plain"}
    }
  }
} as Object {encoding: "UTF-8", mediaType: "multipart/form-data"}
