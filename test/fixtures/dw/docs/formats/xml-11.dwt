%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-formats-xml (言語ガイド)
%%% script
%dw 2.0
output application/xml
---
friends: {
    (payload.friends)
}
%%% input payload application/json
{
  "friends": [
    {"name": "Mariano"},
    {"name": "Shoki"},
    {"name": "Tomo"},
    {"name": "Ana"}
  ]
}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<friends>
  <name>Mariano</name>
  <name>Shoki</name>
  <name>Tomo</name>
  <name>Ana</name>
</friends>
