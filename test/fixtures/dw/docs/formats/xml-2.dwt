%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-formats-xml (言語ガイド)
%%% script
%dw 2.0
output application/json
---
payload
%%% input payload application/xml
<book xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <author xsi:nil="true"/>
</book>
%%% output application/json
{
  "book": {
    "author": null
  }
}
