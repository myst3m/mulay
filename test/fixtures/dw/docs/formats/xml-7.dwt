%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-formats-xml (言語ガイド)
doc に Output の記載なし
%%% script
%dw 2.0
output application/json
ns h http://www.w3.org/TR/html4/
ns f https://www.w3schools.com/furniture
---
{
  root: {
      h#table: {
        h#tr: {
          h#td: "Apples",
          h#td: "Bananas"
        }
      },
      f#table: {
        f#name: "African Coffee Table",
        f#width: "80",
        f#length: "120"
      }
  }
}
%%% output application/json
{
  "root": {
    "table": {
      "tr": {
        "td": "Apples",
        "td": "Bananas"
      }
    },
    "table": {
      "name": "African Coffee Table",
      "width": "80",
      "length": "120"
    }
  }
}
