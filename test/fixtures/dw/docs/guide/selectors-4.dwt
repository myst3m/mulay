%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-selectors (言語ガイド)
%%% script
%dw 2.0
output application/xml
---
root: { a: payload.root.table }
%%% input payload application/xml
<root>
  <h:table xmlns:h="http://www.w3.org/TR/html4/">
    <h:tr>
      <h:td>Apples</h:td>
      <h:td>Bananas</h:td>
    </h:tr>
  </h:table>
</root>
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<root>
  <a>
    <h:tr xmlns:h="http://www.w3.org/TR/html4/">
      <h:td>Apples</h:td>
      <h:td>Bananas</h:td>
    </h:tr>
  </a>
</root>
