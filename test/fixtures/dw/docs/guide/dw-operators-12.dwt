%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-operators (言語ガイド)
%%% script
%dw 2.0
var theFieldName = "name"
output application/json
---
payload update {
    case s at ."$(theFieldName)" -> "Shoki"
}
%%% input payload application/json
{
    "name": "Ken",
    "lastName":"Shokida"
}
%%% output application/json
{
  "name": "Shoki",
  "lastName": "Shokida"
}
