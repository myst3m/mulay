由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-language-introduction (言語ガイド)
%%% script
%dw 2.0
output application/xml
---
payload
%%% input payload application/json
{
    "message": "Hello world!"
}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<message>Hello world!</message>
