%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-selectors (言語ガイド)
%%% script
%dw 2.0
output application/json
---
payload..name
%%% input payload application/xml
<users>
  <user>
    <name>Weave</name>
    <user>
      <name>BAT</name>
      <name>Munit</name>
      <user>
        <name>BDD</name>
      </user>
    </user>
  </user>
</users>
%%% output application/json
[
  "Weave",
  "BAT",
  "BDD"
]
