%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-functions-lambdas (言語ガイド)
doc に Output の記載なし
%%% script
%dw 2.0
output application/json
var names = ["john", "peter", "matt"]
---
users: names map((name) -> upper(name))
%%% output application/json
{
  "users": [
    "JOHN",
    "PETER",
    "MATT"
  ]
}
