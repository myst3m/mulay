%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-variables (言語ガイド)
doc に Output の記載なし
%%% script
%dw 2.0
fun test(param1: String) = do {
    var suffix = "123"
    fun innerTest(str: String) = lower(str)
   ---
   innerTest(param1 ++ suffix)
}
output application/json
---
test("HELLO")
%%% output application/json
"hello123"
