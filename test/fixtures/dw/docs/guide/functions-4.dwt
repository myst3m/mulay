%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-functions (言語ガイド)
doc に Output の記載なし
%%% script
%dw 2.0
output application/json
fun toPhoneFormat(str: String) =
    "(" ++ str[0 to 2] ++ ") " ++ str[3 to 5] ++ "-" ++ str[6 to 9]
---
toPhoneFormat("1234567890")
%%% output application/json
"(123) 456-7890"
