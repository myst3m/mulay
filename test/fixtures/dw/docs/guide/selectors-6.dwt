%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-selectors (言語ガイド)
%%% script
%dw 2.0
output application/json
---
payload.users.*user
%%% input payload application/xml
<users>
  <user>Weave</user>
  <user>BAT</user>
  <user>TF</user>
</users>
%%% output application/json
[
  "Weave",
  "BAT",
  "TF"
]
