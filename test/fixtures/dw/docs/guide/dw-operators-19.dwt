%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-operators (言語ガイド)
%%% script
%dw 2.8
output application/xml

@Metadata(key="cdata")
annotation CData(value: true)
---
root: {
 test: @CData(value = true) "testCData"
}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<root>
  <test><![CDATA[testCData]]></test>
</root>
