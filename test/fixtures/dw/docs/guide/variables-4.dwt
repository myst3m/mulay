%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-variables (言語ガイド)
%%% script
%dw 2.0
output application/xml
var myVar = do {
    var language = "Español"
    ---
    language
}
---
{
  document: {
    language: myVar,
    text: "Hola mundo"
  }
}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<document>
  <language>Español</language>
  <text>Hola mundo</text>
</document>
