%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-functions (言語ガイド)
doc に Output の記載なし
%%% script
%dw 2.0
output application/json

fun toUpper(a: String) = upper(a)
fun toUpper(a: Any) = null
fun toUpper(a: String, b: Number) = upper(a) ++ b as String
---
toUpper("hi!")
%%% output application/json
"HI!"
