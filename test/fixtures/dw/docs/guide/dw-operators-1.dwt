%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-operators (言語ガイド)
%%% script
%dw 2.0
output application/json
---
{ "mathOperators" : [
    { "2 + 2" : (2 + 2) },
    { "2 - 2" : (2 - 2) },
    { "2 * 2" : (2 * 2) },
    { "2 / 2" : (2 / 2) },
    { "[1,2,3] - 1 + 4" : [1,2,3] - 1 + 4},
    { "{a:1, b:2, c:3} - 'a' " : {a:1, b:2, c:3} - "a"},
    { "|2021-03-02T10:39:59| - |P1D| + |PT3H|" : |2021-03-02T10:39:59| - |P1D| + |PT3H|}
  ]
}
%%% output application/json
{
  "mathOperators": [
    {
      "2 + 2": 4
    },
    {
      "2 - 2": 0
    },
    {
      "2 * 2": 4
    },
    {
      "2 / 2": 1
    },
    {
      "[1,2,3] - 1 + 4": [
        2,
        3,
        4
      ]
    },
    {
      "{a:1, b:2, c:3} - 'a' ": {
        "b": 2,
        "c": 3
      }
    },
    {
      "|2021-03-02T10:39:59| - |P1D| + |PT3H|": "2021-03-01T13:39:59"
    }
  ]
}
