%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-types (言語ガイド)
%%% script
%dw 2.0
output application/xml encoding="UTF-8"
---
{
  users:
  {
    user : "Mariano" as CData,
    age : 31 as CData
  }
}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<users>
  <user><![CDATA[Mariano]]></user>
  <age><![CDATA[31]]></age>
</users>
