%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-language-guide (言語ガイド)
doc に Output の記載なし
%%% script
%dw 2.0
var myVar = { country : "FRANCE" }
output application/json
---
if (myVar.country == "USA")
  { currency: "USD" }
else { currency: "EUR" }
%%% output application/json
{
  "currency": "EUR"
}
