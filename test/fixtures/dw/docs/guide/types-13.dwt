%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-types (言語ガイド)
%%% script
%dw 2.0
output application/json
var x = [
  {b: "b"},
  {c: "c", d: "d"}
]
var y = {e: "e"}
---
{
  a: "a",
  (x),
  (y)
}
%%% output application/json
{
  "a": "a",
  "b": "b",
  "c": "c",
  "d": "d",
  "e": "e"
}
