%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-quickstart (言語ガイド)
%%% script
%dw 2.0
var myInput = read("<root>
    <order>
      <items>1</items>
      <items>3</items>
    </order>
    <order>
      <items>2</items>
    </order>
</root>",
"application/xml")
output application/json
---
ContainsRequestedItem: myInput.root.*order.*items contains "3"
%%% output application/json
{
  "ContainsRequestedItem": true
}
