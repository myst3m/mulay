%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-flow-control (言語ガイド)
doc に Output の記載なし
%%% script
%dw 2.0
var myVar = { country : "UK" }
output application/json
---
if (myVar.country =="USA")
	{ currency: "USD" }
else if (myVar.country =="UK")
	{ currency: "GBP" }
else { currency: "EUR" }
%%% output application/json
{
  "currency": "GBP"
}
