%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-language-introduction (言語ガイド)
doc に Output の記載なし
%%% script
%dw 2.0
output application/xml

ns ns0 http://www.abc.com
ns ns1 http://www.123.com
---
{
    ns0#myroot: {
         ns1#secondroot: "hello world"
    }
}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<ns0:myroot xmlns:ns0="http://www.abc.com">
  <ns1:secondroot xmlns:ns1="http://www.123.com">hello world</ns1:secondroot>
</ns0:myroot>
