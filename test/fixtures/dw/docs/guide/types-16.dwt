%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-types (言語ガイド)
%%% script
%dw 2.0
output application/json
var name = "Shoki"
---
{
    Greeting: "Hi, my name is $name",
    Sum: "1 + 1 = $(1 + 1)"
}
%%% output application/json
{
  "Greeting": "Hi, my name is Shoki",
  "Sum": "1 + 1 = 2"
}
