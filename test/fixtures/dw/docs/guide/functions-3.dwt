%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-functions (言語ガイド)
doc に Output の記載なし
%%% script
%dw 2.0
output application/json
fun toUpper(aString)
= aString match {
  case is String -> upper(aString)
  else -> null
}
---
toUpper("h" ++ "el" ++ lower("LO") )
%%% output application/json
"HELLO"
