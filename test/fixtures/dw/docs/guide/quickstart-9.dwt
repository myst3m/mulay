%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-quickstart (言語ガイド)
doc と相違 (表記のみ: 引用符・括弧・書式の違いで、値は同じ)
doc の Output:
  [
    {
      "id": "101",
      "topic": "world history",
      "cost": 19.99,
      "author": "john doe"
    },
    {
      "id": "202",
      "topic": "the great outdoors",
      "cost": 15.99,
      "author": "jane doe"
    }
  ]
%%% script
%dw 2.0
var myVar = [
  { bookId: 101,
    title: "world history",
    price: "19.99"
  },
  {
    bookId: 202,
    title: 'the great outdoors',
    price: "15.99"
  }
]
var myVar2 = [
  {
    bookId: 101,
    author: "john doe"
  },
  {
    bookId: 202,
    author: "jane doe"
  }
]
output application/json
---
myVar map (item, index) -> using (id = item.bookId) {
	"id" : id,
	"topic" : item.title,
	"cost" : item.price as Number,
	(myVar2 filter ($.*bookId contains id) map (item) -> {
		author : item.author
	})
}
%%% output application/json
[
  {
    "id": 101,
    "topic": "world history",
    "cost": 19.99,
    "author": "john doe"
  },
  {
    "id": 202,
    "topic": "the great outdoors",
    "cost": 15.99,
    "author": "jane doe"
  }
]
