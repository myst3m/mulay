%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-pattern-matching (言語ガイド)
%%% script
%dw 2.0
var myInput = {
  "string": "Emiliano"
}
output application/json
---
{
  a: myInput.string match {
    case "Emiliano" -> true
    case "Mariano" -> false
  },
  b: myInput.string match {
    case str: "Emiliano" -> { "matches": true, value: str }
    case str: "Mariano" -> { "matches": false, value: str }
  }
}
%%% output application/json
{
  "a": true,
  "b": {
    "matches": true,
    "value": "Emiliano"
  }
}
