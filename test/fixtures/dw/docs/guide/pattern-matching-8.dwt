%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-pattern-matching (言語ガイド)
doc に Output の記載なし
%%% script
%dw 2.0
output application/json
---
{hello: "world", test: true} match {
    case {headKey: headValue ~ tail} -> headValue
    case {} -> null
}
%%% output application/json
"world"
