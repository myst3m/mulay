%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-operators (言語ガイド)
%%% script
%dw 2.0
output application/xml
---
payload update {
    case name at .user.@name -> upper(name)
}
%%% input payload application/xml
<user name="leandro"/>
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<user name="LEANDRO"/>
