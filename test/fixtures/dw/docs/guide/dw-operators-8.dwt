%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-operators (言語ガイド)
%%% script
%dw 2.0
var myInput = {
    "name": "Ken",
    "lastName":"Shokida",
    "age": 30
}
output application/json
---
myInput update {
    case age at .age -> age + 1
}
%%% output application/json
{
  "name": "Ken",
  "lastName": "Shokida",
  "age": 31
}
