%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-variables (言語ガイド)
doc に Output の記載なし
%%% script
%dw 2.0
var myVar = 1234
var myDo =  do {
    var fn = "Annie"
    var ln = "Point"
    var fromDoScope = "Platform"
    ---
    {
      id : myVar,
      firstname : fn,
      lastname : ln
    }
}
output application/xml
---
{
    person : myDo ++ { "outsideDoScope" : fromDoScope }
}
%%% error
Unable to resolve reference of: `fromDoScope`.
