%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-functions-lambdas (言語ガイド)
%%% script
%dw 2.0
output application/json
var toUser = (user) -> {
  firstName: user.field1,
  lastName: user.field2
}
---
{
  "user" : toUser(payload)
}
%%% input payload application/json
{
  "field1": "Annie",
  "field2": "Point",
  "field3": "Stuff"
}
%%% output application/json
{
  "user": {
    "firstName": "Annie",
    "lastName": "Point"
  }
}
