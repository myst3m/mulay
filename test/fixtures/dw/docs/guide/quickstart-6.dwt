%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dataweave-quickstart (言語ガイド)
%%% script
%dw 2.0
var myRead = read("<car><color>red</color></car>",
                "application/xml")
output application/json
---
{
  mySelection : myRead.car
}
%%% output application/json
{
  "mySelection": {
    "color": "red"
  }
}
