%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-math-functions-sin (関数ページ)
%%% script
%dw 2.0
import * from dw::util::Math
output application/json
---
{
  "sin0": sin(0),
  "sin13": sin(0.13),
  "sin-1": sin(-1)
}
%%% output application/json
{
  "sin0": 0,
  "sin13": 0.12963414261969486,
  "sin-1": -0.8414709848078965
}
