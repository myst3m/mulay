%%% note
由来: 自作 (doc に実行できる例が無いため補った)
%%% script
%dw 2.0
import * from dw::util::Math
output application/json
---
{ a: decimalDivide(1, 3), b: decimalDivide(10, 4, {precision: 0}), c: decimalDivide(2, 3, {precision: 5, roundingMode: "UP"}) }
%%% output application/json
{
  "a": 0.3333333333333333333333333333333333,
  "b": 2.5,
  "c": 0.66667
}
