%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-math-functions-acos (関数ページ)
%%% script
%dw 2.0
import * from dw::util::Math
output application/json
---
{
  "acos0": acos(0),
  "acos13": acos(0.13),
  "acos-1": acos(-1),
  "acos1": acos(1),
  "acos1.1": acos(1.1)
}
%%% output application/json
{
  "acos0": 1.5707963267948966,
  "acos13": 1.440427347091751,
  "acos-1": 3.141592653589793,
  "acos1": 0,
  "acos1.1": null
}
