%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-math-functions-cos (関数ページ)
%%% script
%dw 2.0
import * from dw::util::Math
output application/json
---
{
  "cos0": cos(0),
  "cos13": cos(0.13),
  "cos-1": cos(-1)
}
%%% output application/json
{
  "cos0": 1,
  "cos13": 0.9915618937147881,
  "cos-1": 0.5403023058681398
}
