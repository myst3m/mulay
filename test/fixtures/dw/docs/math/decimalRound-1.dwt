%%% script
%dw 2.0
import * from dw::util::Math
output application/json
---
{ a: decimalRound(2.5, {precision: 1, roundingMode: "HALF_EVEN"}), b: decimalRound(3.14159, {precision: 3, roundingMode: "HALF_UP"}), c: decimalRound(1.23456789) }
%%% output application/json
{
  "a": 2,
  "b": 3.14,
  "c": 1.23456789
}
