%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-math-functions-atan (関数ページ)
%%% script
%dw 2.0
import * from dw::util::Math
output application/json
---
{
  "atan0":  atan(0),
  "atan13": atan(0.13),
  "atan-1": atan(-1)
}
%%% output application/json
{
  "atan0": 0,
  "atan13": 0.12927500404814307,
  "atan-1": -0.7853981633974483
}
