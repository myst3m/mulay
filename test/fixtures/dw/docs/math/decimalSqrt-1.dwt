%%% script
%dw 2.0
import * from dw::util::Math
output application/json
---
{ a: decimalSqrt(2), b: decimalSqrt(16), c: decimalSqrt(2, {precision: 5, roundingMode: "DOWN"}) }
%%% output application/json
{
  "a": 1.414213562373095048801688724209698,
  "b": 4,
  "c": 1.4142
}
