%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-math-functions-logn (関数ページ)
%%% script
%dw 2.0
import * from dw::util::Math
output application/json
---
{
   "logn10":  logn(10),
   "logn13": logn(0.13),
   "logn-20": logn(-20)
}
%%% output application/json
{
  "logn10": 2.302585092994046,
  "logn13": -2.0402208285265546,
  "logn-20": null
}
