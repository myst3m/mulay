%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-math-functions-toradians (関数ページ)
%%% script
%dw 2.0
import * from dw::util::Math
output application/json
---
{
  "toRadians10":  toRadians(10),
  "toRadians013": toRadians(0.13),
  "toRadians-20": toRadians(-20)
}
%%% output application/json
{
  "toRadians10": 0.1745329251994329576922222222222222361848562381768588376,
  "toRadians013": 0.002268928027592628449998888888888888819075718809115705812,
  "toRadians-20": -0.349065850398865915384444444444444409537859404557852906
}
