%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-math-functions-tan (関数ページ)
%%% script
%dw 2.0
import * from dw::util::Math
output application/json
---
{
   "tan0": tan(0),
   "tan13": tan(0.13),
   "tan-1": tan(-1)
}
%%% output application/json
{
  "tan0": 0,
  "tan13": 0.13073731800446006,
  "tan-1": -1.5574077246549023
}
