%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-arrays-functions-splitat (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Arrays
output application/json
var users = ["Mariano", "Leandro", "Julian"]
---
users splitAt 1
%%% output application/json
{
  "l": [
    "Mariano"
  ],
  "r": [
    "Leandro",
    "Julian"
  ]
}
