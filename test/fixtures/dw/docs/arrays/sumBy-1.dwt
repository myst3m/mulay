%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-arrays-functions-sumby (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Arrays
output application/json
---
{
  "sumBy" : [
    [ { a: 1 }, { a: 2 }, { a: 3 } ] sumBy $.a,
    sumBy([ { a: 1 }, { a: 2 }, { a: 3 } ], (item) -> item.a)
  ]
}
%%% output application/json
{
  "sumBy": [
    6,
    6
  ]
}
