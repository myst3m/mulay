%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-arrays-functions-partition (関数ページ)
%%% script
%dw 2.0
import * from dw::core::Arrays
output application/json
var arr = [0,1,2,3,4,5]
---
arr partition (item) -> isEven(item)
%%% output application/json
{
  "success": [
    0,
    2,
    4
  ],
  "failure": [
    1,
    3,
    5
  ]
}
