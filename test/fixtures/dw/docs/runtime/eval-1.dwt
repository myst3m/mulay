%%% note
由来: 自作 (doc に実行できる例が無いため補った)
%%% script
%dw 2.0
import eval from dw::Runtime
output application/json
---
{
  ok: eval("main.dwl", {"main.dwl": "{a: 1 + 2}"}),
  withInput: eval("main.dwl", {"main.dwl": "payload.x * 2"}, {}, {"payload": {x: 21}}),
  fail: eval("main.dwl", {"main.dwl": "dw::Runtime::fail('boom')"}).success
}
%%% output application/json
{
  "ok": {
    "success": true,
    "result": {
      "value": {
        "a": 3
      },
      "logs": [
        
      ]
    }
  },
  "withInput": {
    "success": true,
    "result": {
      "value": 42,
      "logs": [
        
      ]
    }
  },
  "fail": false
}
