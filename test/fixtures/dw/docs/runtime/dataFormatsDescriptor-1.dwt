        "possibleValues": [
          true,
          false
        ]
      },
      {
        "name": "encoding",
        "optional": true,
        "defaultValue": "UTF-8",
        "description": "The encoding to use for the output, such as UTF-8.\n",
        "possibleValues": [
          
        ]
      },
      {
        "name": "bufferSize",
        "optional": true,
        "defaultValue": 8192,
        "description": "Size of the buffer writer, in bytes. The value must be greater than `8`.\n",
        "possibleValues": [
          
        ]
      },
      {
        "name": "skipNullOn",
        "optional": true,
        "defaultValue": "None",
        "description": "Skips `null` values in the specified data structure. By default, DataWeave does not skip the values.\n\n* `arrays` + Ignore and omit `null` values inside arrays from the JSON output, for example, with `output application/json skipNullOn=\"arrays\"`.\n* `objects` + Ignore key-value pairs that have `null` as the value, for example, with `output application/json skipNullOn=\"objects\"`.\n* `everywhere` + Apply `skipNullOn` to arrays and objects, for example, `output application/json skipNullOn=\"everywhere\"`.",
        "possibleValues": [
          "arrays",
          "objects",
          "everywhere"
        ]
      },
      {
        "name": "deferred",
        "optional": true,
        "defaultValue": false,
        "description": "Generates the output as a data stream when set to `true`, and defers the script's execution until the generated content is consumed.\n",
        "possibleValues": [
          true,
          false
        ]
      },
      {
        "name": "duplicateKeyAsArray",
        "optional": true,
        "defaultValue": false,
        "description": "Converts the values of duplicate keys in an object to a single array of values to the duplicated key.",
        "possibleValues": [
          true,
          false
        ]
      }
    ]
