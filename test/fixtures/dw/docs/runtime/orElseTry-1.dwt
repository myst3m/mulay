%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-runtime-functions-orelsetry (関数ページ)
doc と相違 (doc の Output と実 DW の出力の値が一致しない)
doc の Output:
  {
    "a": {
      "success": false,
      "error": {
        "kind": "KeyNotFoundException",
        "message": "There is no key named 'name'",
        "location": "\n9|     a: try(() -> user.name!) orElseTry otherUser.name!,\n                                          ^^^^^^^^^^^^^^",
        "stack": [
          "main (org::mule::weave::v2::engine::transform:9:40)"
        ]
      }
    },
    "b": {
      "success": true,
      "result": "No User Name"
    }
  }
%%% script
%dw 2.0
import * from dw::Runtime
var user = {}
var otherUser = {}
output application/json
---
{
    a: try(() -> user.name!) orElseTry otherUser.name!,
    b: try(() -> user.name!) orElseTry "No User Name"
}
%%% output application/json
{
  "a": {
    "success": false,
    "error": {
      "kind": "KeyNotFoundException",
      "message": "There is no key named 'name'",
      "location": "\n8|     a: try(() -> user.name!) orElseTry otherUser.name!,\n                                          ^^^^^^^^^^^^^^",
      "stack": [
        "main (anonymous:8:40)"
      ]
    }
  },
  "b": {
    "success": true,
    "result": "No User Name"
  }
}
