%%% note
由来: 自作 (doc に実行できる例が無いため補った)
%%% script
%dw 2.0
import run from dw::Runtime
output application/json
---
{
  ok: run("main.dwl", {"main.dwl": "output application/json --- {a: 1}"}),
  library: run("main.dwl", {"main.dwl": "Utils::sum(1,2)", "/Utils.dwl": "fun sum(a,b) = a + b"}).result.value,
  parseFail: run("main.dwl", {"main.dwl": "(1 + "}).success
}
%%% output application/json
{
  "ok": {
    "success": true,
    "result": {
      "value": "{\n  \"a\": 1\n}",
      "mimeType": "application/json",
      "encoding": "UTF-8",
      "logs": [
        
      ]
    }
  },
  "library": "3",
  "parseFail": false
}
