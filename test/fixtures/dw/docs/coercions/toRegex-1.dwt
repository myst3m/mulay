%%% note
由来: https://docs.mulesoft.com/dataweave/2.11/dw-coercions-functions-toregex (関数ページ)
%%% script
%dw 2.0
import * from dw::util::Coercions
output application/dw
---
{
  toRegexEx1: toRegex("a-Z"),
  toRegexEx2: toRegex("0-9+")
}
%%% output application/dw
{
  toRegexEx1: /a-Z/,
  toRegexEx2: /0-9+/
}
