%%% note
由来: 自作 (doc に実行できる例が無いため補った)
%%% script
%dw 2.0
import fromBase64 from dw::core::Binaries
output application/json
---
{ a: fromBase64(payload.s) as String {encoding: "UTF-8"}, b: sizeOf(fromBase64("")) }
%%% input payload application/json
{"s": "TXVsZVNvZnQ="}
%%% output application/json
{
  "a": "MuleSoft",
  "b": 0
}
