%%% script
%dw 2.0
import fromBase64 from dw::core::Binaries
output application/json
var x = read(fromBase64(payload), "application/x-protobuf", {descriptorUrl: "test/fixtures/dw/protobuf_test/types.desc", messageType: "t.Outer"})
---
{nums: x.*nums, first: x.nums, items: x.*items.name, counts: x.counts}
%%% input payload text/plain
CgYKAmluEAMSBQoBYRABEgMKAWIaBAECrAIgBCAFKgF4KgF5MgUKAWEQATIFCgFiEAI6CwgHEgcKBXNldmVuQAJKAwEAAlICaGloAHIQAAAAAAAA+D8AAAAAAAAAwHoCAQA=
%%% output application/json
{
  "nums": [
    1,
    2,
    300
  ],
  "first": 1,
  "items": [
    "a",
    "b"
  ],
  "counts": {
    "a": 1,
    "b": 2
  }
}
