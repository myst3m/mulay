%%% script
%dw 2.0
import fromBase64 from dw::core::Binaries
output application/json
var x = read(fromBase64(payload), "application/x-protobuf", {descriptorUrl: "test/fixtures/dw/protobuf_test/types.desc", messageType: "t.Outer"})
---
{c: x.color, cm: x.color.^, keys: keysOf(x), byid: x.by_id, t: typeOf(x.by_id) as String}
%%% input payload text/plain
OgYIARICEAFAAQ==
%%% output application/json
{
  "c": "GREEN",
  "cm": {
    "protobufEnumIndex": 1
  },
  "keys": [
    "inner",
    "counts",
    "by_id",
    "color"
  ],
  "byid": {
    "1": {
      "name": "",
      "v": 1
    }
  },
  "t": "Object"
}
