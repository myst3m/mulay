%%% note
由来: mulet test/mulet/url_test.clj:196 (complex-url-parsing-test)
testing: Parse complex URL with all components
元の形: url/parseURI の直接呼び出しを DW に書き換え
mulet: 成功
%%% script
%dw 2.0
import parseURI from dw::core::URL
output application/json
---
parseURI("https://user:pass@api.example.com:8443/v1/users?limit=10&offset=20#section")
%%% output application/json
{
  "isValid": true,
  "raw": "https://user:pass@api.example.com:8443/v1/users?limit=10&offset=20#section",
  "host": "api.example.com",
  "authority": "user:pass@api.example.com:8443",
  "fragment": "section",
  "path": "/v1/users",
  "port": 8443,
  "query": "limit=10&offset=20",
  "scheme": "https",
  "user": "user:pass",
  "isAbsolute": true,
  "isOpaque": false
}
