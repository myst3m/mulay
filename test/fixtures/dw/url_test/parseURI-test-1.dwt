%%% note
由来: mulet test/mulet/url_test.clj:20 (parseURI-test)
testing: Parse complete URI
元の形: url/parseURI の直接呼び出しを DW に書き換え
mulet: 成功
%%% script
%dw 2.0
import parseURI from dw::core::URL
output application/json
---
parseURI("https://user:pass@example.com:8080/path/to/resource?query=value#fragment")
%%% output application/json
{
  "isValid": true,
  "raw": "https://user:pass@example.com:8080/path/to/resource?query=value#fragment",
  "host": "example.com",
  "authority": "user:pass@example.com:8080",
  "fragment": "fragment",
  "path": "/path/to/resource",
  "port": 8080,
  "query": "query=value",
  "scheme": "https",
  "user": "user:pass",
  "isAbsolute": true,
  "isOpaque": false
}
