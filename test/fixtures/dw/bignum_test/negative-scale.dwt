%%% note
演算の結果の scale が負なら BigDecimal のまま (展開しない、末尾の 0 も削らない)。0 は 0。
%%% script
%dw 2.0
output application/json
---
[
  {"e": "1e19 * 1", "r": (1e19 * 1) as String},
  {"e": "1.5e19 * 1", "r": (1.5e19 * 1) as String},
  {"e": "25e18 * 1", "r": (25e18 * 1) as String},
  {"e": "1e19 * 0.1", "r": (1e19 * 0.1) as String},
  {"e": "1e19 * 10", "r": (1e19 * 10) as String},
  {"e": "12e40 * 1", "r": (12e40 * 1) as String},
  {"e": "1.5e40 * 2", "r": (1.5e40 * 2) as String},
  {"e": "-1e19 * 1", "r": (-1e19 * 1) as String},
  {"e": "1e40 * 1e40", "r": (1e40 * 1e40) as String},
  {"e": "1e400 * 1e400", "r": (1e400 * 1e400) as String},
  {"e": "1e19 / 10", "r": (1e19 / 10) as String},
  {"e": "1e20 / 1e1", "r": (1e20 / 1e1) as String},
  {"e": "1e40 / 3", "r": (1e40 / 3) as String},
  {"e": "1e40 / 1", "r": (1e40 / 1) as String},
  {"e": "1e19 + 1e19", "r": (1e19 + 1e19) as String},
  {"e": "1e19 * 0", "r": (1e19 * 0) as String},
  {"e": "0 * 1e19", "r": (0 * 1e19) as String},
  {"e": "1e19 - 1e19", "r": (1e19 - 1e19) as String},
  {"e": "1e40 mod 1e39", "r": (1e40 mod 1e39) as String},
  {"e": "1e19 mod 3", "r": (1e19 mod 3) as String},
  {"e": "avg([1e19, 1e19])", "r": (avg([1e19, 1e19])) as String},
  {"e": "1e19 * 1 * 1", "r": (1e19 * 1 * 1) as String}
]
%%% output application/json
[
  {
    "e": "1e19 * 1",
    "r": "1E+19"
  },
  {
    "e": "1.5e19 * 1",
    "r": "1.5E+19"
  },
  {
    "e": "25e18 * 1",
    "r": "2.5E+19"
  },
  {
    "e": "1e19 * 0.1",
    "r": "1E+18"
  },
  {
    "e": "1e19 * 10",
    "r": "1.0E+20"
  },
  {
    "e": "12e40 * 1",
    "r": "1.2E+41"
  },
  {
    "e": "1.5e40 * 2",
    "r": "3.0E+40"
  },
  {
    "e": "-1e19 * 1",
    "r": "-1E+19"
  },
  {
    "e": "1e40 * 1e40",
    "r": "1E+80"
  },
  {
    "e": "1e400 * 1e400",
    "r": "1E+800"
  },
  {
    "e": "1e19 / 10",
    "r": "1E+18"
  },
  {
    "e": "1e20 / 1e1",
    "r": "1E+19"
  },
  {
    "e": "1e40 / 3",
    "r": "3.333333333333333333333333333333333E+39"
  },
  {
    "e": "1e40 / 1",
    "r": "1E+40"
  },
  {
    "e": "1e19 + 1e19",
    "r": "2E+19"
  },
  {
    "e": "1e19 * 0",
    "r": "0"
  },
  {
    "e": "0 * 1e19",
    "r": "0"
  },
  {
    "e": "1e19 - 1e19",
    "r": "0"
  },
  {
    "e": "1e40 mod 1e39",
    "r": "0"
  },
  {
    "e": "1e19 mod 3",
    "r": "1"
  },
  {
    "e": "avg([1e19, 1e19])",
    "r": "1E+19"
  },
  {
    "e": "1e19 * 1 * 1",
    "r": "1E+19"
  }
]
