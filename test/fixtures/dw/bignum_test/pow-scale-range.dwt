%%% note
pow と decimalPow の結果の scale は Java の int の範囲。超えると Underflow (scale が大きすぎる、小さい数) か Overflow。値が 0 なら端に丸めて失敗しない。
%%% script
%dw 2.0
import try from dw::Runtime
import decimalPow from dw::util::Math
output application/json
---
[
  {"e": "1e-2147483647 pow 2", "r": try(() -> (1e-2147483647 pow 2) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "1e2147483647 pow 2", "r": try(() -> (1e2147483647 pow 2) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "1e-1073741824 pow 2", "r": try(() -> (1e-1073741824 pow 2) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "1e-1073741823 pow 2", "r": try(() -> (1e-1073741823 pow 2) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "1e1073741824 pow 2", "r": try(() -> (1e1073741824 pow 2) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "1e-1073741824 pow 0", "r": try(() -> (1e-1073741824 pow 0) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "0e-2147483647 pow 2", "r": try(() -> (0e-2147483647 pow 2) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "0e2147483647 pow 3", "r": try(() -> (0e2147483647 pow 3) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "1e-2147483647 pow 2.5", "r": try(() -> (1e-2147483647 pow 2.5) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "1e-2 pow 99999999", "r": try(() -> (1e-2 pow 99999999) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "1e-30 pow 99999999", "r": try(() -> (1e-30 pow 99999999) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "decimalPow(1e-2147483647, 2)", "r": try(() -> (decimalPow(1e-2147483647, 2)) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "decimalPow(1e-2147483647, 2, {precision: 10})", "r": try(() -> (decimalPow(1e-2147483647, 2, {precision: 10})) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "decimalPow(1e2147483647, 2, {precision: 10})", "r": try(() -> (decimalPow(1e2147483647, 2, {precision: 10})) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "decimalPow(1e-2147483647, -2, {precision: 10})", "r": try(() -> (decimalPow(1e-2147483647, -2, {precision: 10})) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "decimalPow(1e-1073741823, 2, {precision: 10})", "r": try(() -> (decimalPow(1e-1073741823, 2, {precision: 10})) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "decimalPow(1e-2147483647, 2.5, {precision: 10})", "r": try(() -> (decimalPow(1e-2147483647, 2.5, {precision: 10})) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "decimalPow(0e-2147483647, 2, {precision: 10})", "r": try(() -> (decimalPow(0e-2147483647, 2, {precision: 10})) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "decimalPow(1.5e-1073741823, 2, {precision: 3})", "r": try(() -> (decimalPow(1.5e-1073741823, 2, {precision: 3})) as String) then (if ($.success) $.result else $.error.message)}
]
%%% output application/json
[
  {
    "e": "1e-2147483647 pow 2",
    "r": "Unable to resolve 1E-2147483647 ^ 2. Reason: Underflow."
  },
  {
    "e": "1e2147483647 pow 2",
    "r": "Unable to resolve 1E+2147483647 ^ 2. Reason: Overflow."
  },
  {
    "e": "1e-1073741824 pow 2",
    "r": "Unable to resolve 1E-1073741824 ^ 2. Reason: Underflow."
  },
  {
    "e": "1e-1073741823 pow 2",
    "r": "1E-2147483646"
  },
  {
    "e": "1e1073741824 pow 2",
    "r": "1E+2147483648"
  },
  {
    "e": "1e-1073741824 pow 0",
    "r": "1"
  },
  {
    "e": "0e-2147483647 pow 2",
    "r": "0"
  },
  {
    "e": "0e2147483647 pow 3",
    "r": "0"
  },
  {
    "e": "1e-2147483647 pow 2.5",
    "r": "Unable to resolve 1E-2147483647 ^ 2.5. Reason: Underflow."
  },
  {
    "e": "1e-2 pow 99999999",
    "r": "1E-199999998"
  },
  {
    "e": "1e-30 pow 99999999",
    "r": "Unable to resolve 1E-30 ^ 99999999. Reason: Underflow."
  },
  {
    "e": "decimalPow(1e-2147483647, 2)",
    "r": "java.lang.ArithmeticException Underflow"
  },
  {
    "e": "decimalPow(1e-2147483647, 2, {precision: 10})",
    "r": "java.lang.ArithmeticException Underflow"
  },
  {
    "e": "decimalPow(1e2147483647, 2, {precision: 10})",
    "r": "java.lang.ArithmeticException Overflow"
  },
  {
    "e": "decimalPow(1e-2147483647, -2, {precision: 10})",
    "r": "java.lang.ArithmeticException Underflow"
  },
  {
    "e": "decimalPow(1e-1073741823, 2, {precision: 10})",
    "r": "1E-2147483646"
  },
  {
    "e": "decimalPow(1e-2147483647, 2.5, {precision: 10})",
    "r": "java.lang.ArithmeticException Underflow"
  },
  {
    "e": "decimalPow(0e-2147483647, 2, {precision: 10})",
    "r": "0"
  },
  {
    "e": "decimalPow(1.5e-1073741823, 2, {precision: 3})",
    "r": "java.lang.ArithmeticException Underflow"
  }
]
