%%% note
両方の値が 64 ビットの整数に収まれば (scale によらず) 整数で計算する。溢れれば正確な整数。
%%% script
%dw 2.0
output application/json
---
[
  {"e": "1e18 * 1", "r": (1e18 * 1) as String},
  {"e": "1.0 * 1e18", "r": (1.0 * 1e18) as String},
  {"e": "1e18 * 1.0", "r": (1e18 * 1.0) as String},
  {"e": "1e2 * 1", "r": (1e2 * 1) as String},
  {"e": "1e2 + 0", "r": (1e2 + 0) as String},
  {"e": "1e2 - 1", "r": (1e2 - 1) as String},
  {"e": "1e3 / 1e1", "r": (1e3 / 1e1) as String},
  {"e": "1e3 / 10", "r": (1e3 / 10) as String},
  {"e": "3.0 / 1", "r": (3.0 / 1) as String},
  {"e": "0.5 * 2", "r": (0.5 * 2) as String},
  {"e": "1e18 * 10", "r": (1e18 * 10) as String},
  {"e": "1e17 * 100", "r": (1e17 * 100) as String},
  {"e": "9223372036854775807 + 1", "r": (9223372036854775807 + 1) as String},
  {"e": "9223372036854775807 * 2", "r": (9223372036854775807 * 2) as String},
  {"e": "2e18 + 2e18 + 2e18 + 2e18 + 2e18", "r": (2e18 + 2e18 + 2e18 + 2e18 + 2e18) as String},
  {"e": "-1e18 * 1", "r": (-1e18 * 1) as String},
  {"e": "1e19 / 1e19", "r": (1e19 / 1e19) as String},
  {"e": "10 mod 3.0", "r": (10 mod 3.0) as String},
  {"e": "1e2 mod 7", "r": (1e2 mod 7) as String}
]
%%% output application/json
[
  {
    "e": "1e18 * 1",
    "r": "1000000000000000000"
  },
  {
    "e": "1.0 * 1e18",
    "r": "1000000000000000000"
  },
  {
    "e": "1e18 * 1.0",
    "r": "1000000000000000000"
  },
  {
    "e": "1e2 * 1",
    "r": "100"
  },
  {
    "e": "1e2 + 0",
    "r": "100"
  },
  {
    "e": "1e2 - 1",
    "r": "99"
  },
  {
    "e": "1e3 / 1e1",
    "r": "100"
  },
  {
    "e": "1e3 / 10",
    "r": "100"
  },
  {
    "e": "3.0 / 1",
    "r": "3"
  },
  {
    "e": "0.5 * 2",
    "r": "1"
  },
  {
    "e": "1e18 * 10",
    "r": "10000000000000000000"
  },
  {
    "e": "1e17 * 100",
    "r": "10000000000000000000"
  },
  {
    "e": "9223372036854775807 + 1",
    "r": "9223372036854775808"
  },
  {
    "e": "9223372036854775807 * 2",
    "r": "18446744073709551614"
  },
  {
    "e": "2e18 + 2e18 + 2e18 + 2e18 + 2e18",
