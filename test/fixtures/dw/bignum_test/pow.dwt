%%% note
pow の結果も演算と同じ正規化 (負の scale は展開しない)。64 ビットの整数の経路は無い (1e2 pow 2 → 1E+4)。
%%% script
%dw 2.0
output application/json
---
[
  {"e": "1e19 pow 2", "r": (1e19 pow 2) as String},
  {"e": "10 pow 19", "r": (10 pow 19) as String},
  {"e": "1e2 pow 2", "r": (1e2 pow 2) as String},
  {"e": "2.5 pow 2", "r": (2.5 pow 2) as String},
  {"e": "1.50 pow 2", "r": (1.50 pow 2) as String},
  {"e": "1e999999999 pow 2", "r": (1e999999999 pow 2) as String},
  {"e": "1e10 pow 2", "r": (1e10 pow 2) as String},
  {"e": "100 pow 10", "r": (100 pow 10) as String},
  {"e": "1.0 pow 3", "r": (1.0 pow 3) as String},
  {"e": "0.1 pow 3", "r": (0.1 pow 3) as String},
  {"e": "1e-5 pow 2", "r": (1e-5 pow 2) as String},
  {"e": "1e19 pow 0", "r": (1e19 pow 0) as String},
  {"e": "1e19 pow 1", "r": (1e19 pow 1) as String}
]
%%% output application/json
[
  {
    "e": "1e19 pow 2",
    "r": "1E+38"
  },
  {
    "e": "10 pow 19",
    "r": "10000000000000000000"
  },
  {
    "e": "1e2 pow 2",
    "r": "1E+4"
  },
  {
    "e": "2.5 pow 2",
    "r": "6.25"
  },
  {
    "e": "1.50 pow 2",
    "r": "2.25"
  },
  {
    "e": "1e999999999 pow 2",
    "r": "1E+1999999998"
  },
  {
    "e": "1e10 pow 2",
    "r": "1E+20"
  },
  {
    "e": "100 pow 10",
    "r": "100000000000000000000"
  },
  {
    "e": "1.0 pow 3",
    "r": "1"
  },
  {
    "e": "0.1 pow 3",
    "r": "0.001"
  },
  {
    "e": "1e-5 pow 2",
    "r": "1E-10"
  },
  {
    "e": "1e19 pow 0",
    "r": "1"
  },
  {
    "e": "1e19 pow 1",
    "r": "1E+19"
  }
]
