%%% note
scale が正の結果は末尾の 0 を削る。scale 0 の加減算は桁を展開する (Java の BigDecimal と同じ)。
%%% script
%dw 2.0
output application/json
---
[
  {"e": "1.25 * 2", "r": (1.25 * 2) as String},
  {"e": "0.1 * 3", "r": (0.1 * 3) as String},
  {"e": "1.10 + 1.20", "r": (1.10 + 1.20) as String},
  {"e": "2.50 * 1", "r": (2.50 * 1) as String},
  {"e": "1.5 * 2", "r": (1.5 * 2) as String},
  {"e": "1.5 + 1.5", "r": (1.5 + 1.5) as String},
  {"e": "0.1 + 0.2", "r": (0.1 + 0.2) as String},
  {"e": "7.5 mod 2", "r": (7.5 mod 2) as String},
  {"e": "123456789012345678901.50 * 1", "r": (123456789012345678901.50 * 1) as String},
  {"e": "1e-5 * 1", "r": (1e-5 * 1) as String},
  {"e": "1e-7 * 1", "r": (1e-7 * 1) as String},
  {"e": "1e-3 + 0", "r": (1e-3 + 0) as String},
  {"e": "1e19 + 0", "r": (1e19 + 0) as String},
  {"e": "1e40 + 1", "r": (1e40 + 1) as String},
  {"e": "1e40 - 1", "r": (1e40 - 1) as String},
  {"e": "(1e19 * 1) + 1", "r": ((1e19 * 1) + 1) as String},
  {"e": "sum([1e19, 1])", "r": (sum([1e19, 1])) as String},
  {"e": "floor(1e19)", "r": (floor(1e19)) as String},
  {"e": "ceil(1.5e19)", "r": (ceil(1.5e19)) as String},
  {"e": "round(1e40)", "r": (round(1e40)) as String}
]
%%% output application/json
[
  {
    "e": "1.25 * 2",
    "r": "2.5"
  },
  {
    "e": "0.1 * 3",
    "r": "0.3"
  },
  {
    "e": "1.10 + 1.20",
    "r": "2.3"
  },
  {
    "e": "2.50 * 1",
    "r": "2.5"
  },
  {
    "e": "1.5 * 2",
    "r": "3"
  },
  {
    "e": "1.5 + 1.5",
    "r": "3"
  },
  {
    "e": "0.1 + 0.2",
    "r": "0.3"
  },
  {
    "e": "7.5 mod 2",
    "r": "1.5"
  },
  {
    "e": "123456789012345678901.50 * 1",
    "r": "123456789012345678901.5"
  },
  {
    "e": "1e-5 * 1",
    "r": "0.00001"
  },
  {
    "e": "1e-7 * 1",
    "r": "1E-7"
  },
  {
    "e": "1e-3 + 0",
    "r": "0.001"
  },
  {
    "e": "1e19 + 0",
    "r": "10000000000000000000"
  },
  {
    "e": "1e40 + 1",
    "r": "10000000000000000000000000000000000000001"
  },
  {
    "e": "1e40 - 1",
    "r": "9999999999999999999999999999999999999999"
  },
  {
    "e": "(1e19 * 1) + 1",
    "r": "10000000000000000001"
  },
  {
    "e": "sum([1e19, 1])",
    "r": "10000000000000000001"
  },
  {
    "e": "floor(1e19)",
    "r": "10000000000000000000"
  },
  {
    "e": "ceil(1.5e19)",
    "r": "15000000000000000000"
  },
  {
    "e": "round(1e40)",
    "r": "10000000000000000000000000000000000000000"
  }
]
