%%% note
指数の大きい数の乗除算と比較は桁を展開しない (要求の本文の 1e999999999 で時間と記憶を使い切らない)。
%%% script
%dw 2.0
output application/json
---
[
  {"e": "payload.n * 1", "r": (payload.n * 1) as String},
  {"e": "payload.n / 3", "r": (payload.n / 3) as String},
  {"e": "payload.n * payload.n", "r": (payload.n * payload.n) as String},
  {"e": "payload.n > 1", "r": (payload.n > 1) as String},
  {"e": "payload.n == payload.n", "r": (payload.n == payload.n) as String},
  {"e": "1e999999999 * 2.5", "r": (1e999999999 * 2.5) as String},
  {"e": "-payload.n * 1", "r": (-payload.n * 1) as String},
  {"e": "payload.n * 1e-999999999", "r": (payload.n * 1e-999999999) as String}
]
%%% input payload application/json
{"n": 1e999999999}
%%% output application/json
[
  {
    "e": "payload.n * 1",
    "r": "1E+999999999"
  },
  {
    "e": "payload.n / 3",
    "r": "3.333333333333333333333333333333333E+999999998"
  },
  {
    "e": "payload.n * payload.n",
    "r": "1E+1999999998"
  },
  {
    "e": "payload.n > 1",
    "r": "true"
  },
  {
    "e": "payload.n == payload.n",
    "r": "true"
  },
  {
    "e": "1e999999999 * 2.5",
    "r": "2.5E+999999999"
  },
  {
    "e": "-payload.n * 1",
    "r": "-1E+999999999"
  },
  {
    "e": "payload.n * 1e-999999999",
    "r": "1"
  }
]
