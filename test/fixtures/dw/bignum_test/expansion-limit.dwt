%%% note
桁を展開する演算は上限を超えると失敗する (メモリを使い切らない)。乗算の scale は Java の int の範囲 (Overflow / Underflow)。
mulay の上限は 1 千万桁 (Java は約 6.5 億桁だが、1 千万桁の加算も 300 秒で終わらない) なので、ここは両方が失敗する大きさで確かめる。
%%% script
%dw 2.0
import try from dw::Runtime
output application/json
---
[
  {"e": "payload.big + 1", "r": try(() -> (payload.big + 1) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "1 + payload.big", "r": try(() -> (1 + payload.big) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "payload.big - 1", "r": try(() -> (payload.big - 1) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "1 - payload.big", "r": try(() -> (1 - payload.big) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "payload.huge * payload.huge", "r": try(() -> (payload.huge * payload.huge) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "payload.tiny * payload.tiny", "r": try(() -> (payload.tiny * payload.tiny) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "payload.huge / payload.tiny", "r": try(() -> (payload.huge / payload.tiny) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "floor(payload.big)", "r": try(() -> (floor(payload.big)) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "ceil(payload.big)", "r": try(() -> (ceil(payload.big)) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "round(payload.big)", "r": try(() -> (round(payload.big)) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "sum([payload.big, 1])", "r": try(() -> (sum([payload.big, 1])) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "payload.big as String", "r": try(() -> (payload.big as String) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "payload.big > 1", "r": try(() -> (payload.big > 1) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "abs(payload.big)", "r": try(() -> (abs(payload.big)) as String) then (if ($.success) $.result else $.error.message)},
  {"e": "payload.big * 0", "r": try(() -> (payload.big * 0) as String) then (if ($.success) $.result else $.error.message)}
]
%%% input payload application/json
{"big": 1e700000000, "huge": 1e2000000000, "tiny": 1e-2000000000}
%%% output application/json
[
  {
    "e": "payload.big + 1",
    "r": "Unable to resolve addition operation: `1E+700000000 + 1`. Reason: java.lang.ArithmeticException: BigInteger would overflow supported range"
  },
  {
    "e": "1 + payload.big",
    "r": "Unable to resolve addition operation: `1 + 1E+700000000`. Reason: java.lang.ArithmeticException: BigInteger would overflow supported range"
  },
  {
    "e": "payload.big - 1",
    "r": "Unable to resolve subtraction operation: `1E+700000000 - 1`. Reason: BigInteger would overflow supported range"
  },
  {
    "e": "1 - payload.big",
    "r": "Unable to resolve subtraction operation: `1 - 1E+700000000`. Reason: BigInteger would overflow supported range"
  },
  {
    "e": "payload.huge * payload.huge",
    "r": "Unable to resolve multiplication operation: `1E+2000000000 * 1E+2000000000`. Reason: Overflow"
  },
  {
    "e": "payload.tiny * payload.tiny",
    "r": "Unable to resolve multiplication operation: `1E-2000000000 * 1E-2000000000`. Reason: Underflow"
  },
  {
    "e": "payload.huge / payload.tiny",
    "r": "Division by zero"
  },
  {
    "e": "floor(payload.big)",
    "r": "java.lang.ArithmeticException BigInteger would overflow supported range"
  },
  {
    "e": "ceil(payload.big)",
    "r": "java.lang.ArithmeticException BigInteger would overflow supported range"
  },
  {
    "e": "round(payload.big)",
    "r": "java.lang.ArithmeticException BigInteger would overflow supported range"
  },
  {
    "e": "sum([payload.big, 1])",
    "r": "Unable to resolve addition operation: `1 + 1E+700000000`. Reason: java.lang.ArithmeticException: BigInteger would overflow supported range"
  },
  {
    "e": "payload.big as String",
    "r": "1E+700000000"
  },
  {
    "e": "payload.big > 1",
    "r": "true"
  },
  {
    "e": "abs(payload.big)",
    "r": "1E+700000000"
  },
  {
    "e": "payload.big * 0",
    "r": "0"
  }
]
