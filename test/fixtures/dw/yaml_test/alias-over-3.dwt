%%% note
maxEntityCount を超えるエイリアスは失敗する (誤りの位置の書き方は mulay の YAML の誤りの形なので、本文だけを確かめる)。
%%% script
%dw 2.0
import try from dw::Runtime
output application/json
var r = try(() -> read("a: &x 1\nb: *x\nc: *x\nd: *x\ne: *x", "application/yaml", {maxEntityCount: 3}))
---
{success: r.success, result: r.result default null, limited: (r.error.message default "") contains "Max number of anchor expansion `maxEntityCount=3` has been exceeded"}
%%% output application/json
{
  "success": false,
  "result": null,
  "limited": true
}
