%%% note
XML reader streaming=true indexedReader=true (出力に影響しない)
%%% script
%dw 2.0
output application/json
---
payload
%%% input payload application/xml streaming=true indexedReader=true
<root><item>1</item><item>2</item><x>y</x></root>
%%% output application/json
{
  "root": {
    "item": "1",
    "item": "2",
    "x": "y"
  }
}
