%%% note
XML writer control char onInvalidChar=base64
%%% script
%dw 2.0
output application/xml onInvalidChar="base64"
---
{r: "a" ++ ("\u0001") ++ "b"}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<r xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="xsd:base64Binary">YQFi</r>
