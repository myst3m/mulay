%%% note
writeDeclaredNamespaces="regex:http"
%%% script
%dw 2.0
ns n http://n
ns m http://m
ns u http://u
output application/xml writeDeclaredNamespaces="regex:http"
---
{u#r: {m#c: 1}}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<u:r xmlns:u="http://u">
  <m:c xmlns:m="http://m">1</m:c>
</u:r>
