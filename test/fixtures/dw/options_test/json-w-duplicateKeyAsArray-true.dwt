%%% note
JSON writer duplicateKeyAsArray=true
%%% script
%dw 2.0
output application/json duplicateKeyAsArray=true
---
{a: 1, a: 2, b: {c: 1, c: 2}}
%%% input payload application/json
{"a":1,"b":null,"c":[1,null,{"d":null,"e":"é"}],"f":{"g":null}}
%%% output application/json
{
  "a": [
  1,
  2
  ],
  "b": {
    "c": [
    1,
    2
    ]
  }
}
