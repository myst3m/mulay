%%% note
XML writer escapeCR=false
%%% script
%dw 2.0
output application/xml escapeCR=false
---
{root @(a: "x>y", b: "1"): {n1: null, n2: "", n3: "a>b&c<d", n4: "line1\r\nline2", n5: {inner: 1}, n6: [1,2], n7 @(z: null): "t"}}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<root a="x>y" b="1">
  <n1/>
  <n2/>
  <n3>a>b&amp;c&lt;d</n3>
  <n4>line1
line2</n4>
  <n5>
    <inner>1</inner>
  </n5>
  <n6>1</n6>
  <n6>2</n6>
  <n7 z="null">t</n7>
</root>
