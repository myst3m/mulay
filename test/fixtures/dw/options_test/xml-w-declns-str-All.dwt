%%% note
XML writer writeDeclaredNamespaces="All"
%%% script
%dw 2.0
ns n http://n
ns m http://m
ns u http://u
output application/xml writeDeclaredNamespaces="All"
---
{n#r: {m#c: 1}}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<n:r xmlns:n="http://n" xmlns:m="http://m" xmlns:u="http://u">
  <m:c>1</m:c>
</n:r>
