%%% note
XML reader nullValueOn="all"
%%% script
%dw 2.0
output application/json
---
payload
%%% input payload application/xml nullValueOn=all
<?xml version="1.0"?><root a="12345"><item>1</item><item>2</item><e/><blank> </blank><empty></empty><t x="y">z</t></root>
%%% output application/json
{
  "root": {
    "item": "1",
    "item": "2",
    "e": "",
    "blank": " ",
    "empty": "",
    "t": "z"
  }
}
