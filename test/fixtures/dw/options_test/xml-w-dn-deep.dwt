%%% note
defaultNamespace nested + prefixed
%%% script
%dw 2.0
ns n http://n
output application/xml defaultNamespace="http://d"
---
{n#r: {c: {e: 1}, n#f: {g: 2}, h: 3}}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<n:r xmlns:n="http://n">
  <c xmlns="http://d">
    <e>1</e>
  </c>
  <n:f>
    <g xmlns="http://d">2</g>
  </n:f>
  <h xmlns="http://d">3</h>
</n:r>
