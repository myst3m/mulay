%%% note
JSON writer writeAttributes=true
%%% script
%dw 2.0
output application/json writeAttributes=true
---
{a @(x: 1, y: "z"): 2, b: {c @(k: 3): 4}}
%%% input payload application/json
{"a":1,"b":null,"c":[1,null,{"d":null,"e":"é"}],"f":{"g":null}}
%%% output application/json
{
  "a": {
    "@x": 1,
    "@y": "z",
    "__text": 2
  },
  "b": {
    "c": {
      "@k": 3,
      "__text": 4
    }
  }
}
