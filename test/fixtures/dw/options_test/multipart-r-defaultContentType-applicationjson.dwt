%%% note
multipart reader defaultContentType=application/json
%%% script
%dw 2.0
output application/json
---
{n: sizeOf(payload.parts), a: payload.parts.a.headers, b: payload.parts.b.content}
%%% input payload multipart/form-data defaultContentType=application/json
--BB
Content-Disposition: form-data; name="a"

x
--BB
Content-Disposition: form-data; name="b"
Content-Type: application/json

{"k":1}
--BB--

%%% output application/json
{
  "n": 2,
  "a": {
    "Content-Disposition": {
      "name": "a",
      "subtype": "form-data"
    }
  },
  "b": {
    "k": 1
  }
}
