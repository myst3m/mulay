%%% note
writeDeclaredNamespaces with ns attribute
%%% script
%dw 2.0
ns n http://n
ns m http://m
ns u http://u
output application/xml writeDeclaredNamespaces="All"
---
{r @(m#a: 1): 1}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<r xmlns:n="http://n" xmlns:m="http://m" xmlns:u="http://u" m:a="1">1</r>
