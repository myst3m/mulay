%%% note
flatten と flatMap は範囲 (1 to 2) を開かない (実 DW 4.11.3)
%%% script
%dw 2.0
output application/json
---
{ a: flatten([[1], (1 to 2), 3]), b: [1,2] flatMap (1 to $), c: (1 to 2) flatMap [$, $], d: [[1,2]] flatMap $ }
%%% output application/json
{
  "a": [
    1,
    [
      1,
      2
    ],
    3
  ],
  "b": [
    [
      1
    ],
    [
      1,
      2
    ]
  ],
  "c": [
    1,
    1,
    2,
    2
  ],
  "d": [
    1,
    2
  ]
}
