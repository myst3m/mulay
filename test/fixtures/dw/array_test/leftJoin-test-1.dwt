[
  {
    "l": {
      "id": 1,
      "name": "A"
    },
    "r": {
      "id": 1,
      "val": 10
    }
  },
  {
    "l": {
      "id": 2,
      "name": "B"
    },
    "r": {
      "id": 2,
      "val": 20
    }
  },
  {
    "l": {
      "id": 3,
      "name": "C"
    }
  }
]
