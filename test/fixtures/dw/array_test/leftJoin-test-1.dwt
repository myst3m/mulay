%%% script
%dw 2.0
import leftJoin from dw::core::Arrays
output application/json
---
leftJoin([{"id": 1, "name": "A"}, {"id": 2, "name": "B"}, {"id": 3, "name": "C"}], [{"id": 1, "val": 10}, {"id": 2, "val": 20}], (x) -> x."id", (x) -> x."id")
