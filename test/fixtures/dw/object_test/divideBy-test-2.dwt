mulet: 成功
%%% script
%dw 2.0
import divideBy from dw::core::Objects
output application/json
---
divideBy({"a": 1, "b": 2, "c": 3, "d": 4}, 2)
%%% output application/json
[
  {
    "a": 1,
    "b": 2
  },
  {
    "c": 3,
    "d": 4
  }
]
