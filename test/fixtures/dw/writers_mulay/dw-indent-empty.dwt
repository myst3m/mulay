%%% note
application/dw の indent: "" は改行も書かず 1 行になる (名前空間の do、Namespace、メタデータも)。タブの字下げは改行あり
%%% script
%dw 2.0
output application/json
ns p http://x
---
[write({p#a @(q: 1): 1}, "application/dw", {indent: ""}), write([[1],[]], "application/dw", {indent: ""}), write({a: [1]}, "application/dw", {indent: "\t"}), write(p, "application/dw", {indent: ""}), write({a: 1 as Number {x: [1,2]}}, "application/dw", {indent: ""})]
%%% output application/json
[
  "do {ns p http://x---{p#a @(q: 1): 1}}",
  "[[1], []]",
  "{\n\ta: [\n\t\t1\n\t]\n}",
  "{uri: \"http://x\",prefix: \"p\"}as Namespace",
  "{a: 1 as Number {x: [1, 2]}}"
]
