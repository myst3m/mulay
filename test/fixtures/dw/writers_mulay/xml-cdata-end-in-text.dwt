%%% note
本文の `]]>` は `]]&gt;` と書く (そのままだと整形式の XML にならない)。`]]` の後でない `>` と属性はそのまま
%%% script
%dw 2.0
output application/xml
---
{r: {a: "x]]>y", b: "a>b", c: "]]]>", d: "]>", e @(k: "]]>"): "z"}}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<r>
  <a>x]]&gt;y</a>
  <b>a>b</b>
  <c>]]]&gt;</c>
  <d>]&gt;</d>
  <e k="]]>">z</e>
</r>
