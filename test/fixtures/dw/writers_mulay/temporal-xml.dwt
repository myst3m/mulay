%%% note
XML の要素と属性の日時、format / locale、Number の format
%%% script
%dw 2.0
output application/xml
---
{r @(a: |2020-01-02|, b: "2020/01/02" as Date {format: "yyyy/MM/dd"}, c: "1.50" as Number {format: "#.00"}): {d: |2020-01-02|, dt: |2020-01-02T10:11:12.5+09:00|, ldt: |2020-01-02T10:11:12|, t: |10:11:12Z|, lt: |10:11:12.123|, tz: |+09:00|, p: |P1Y2M|, du: |PT1H|, df: "2020/01/02" as Date {format: "yyyy/MM/dd"}, dl: |2020-12-31| as Date {format: "dd-MMM-yy", locale: "es"}, nf: "1.50" as Number {format: "#.00"}, nl: 1234.5 as Number {format: "#,##0.00", locale: "de"}}}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<r a="2020-01-02" b="2020-01-02" c="1.5">
  <d>2020-01-02</d>
  <dt>2020-01-02T10:11:12.5+09:00</dt>
  <ldt>2020-01-02T10:11:12</ldt>
  <t>10:11:12Z</t>
  <lt>10:11:12.123</lt>
  <tz>+09:00</tz>
  <p>P1Y2M</p>
  <du>PT1H</du>
  <df>2020-01-02</df>
  <dl>2020-12-31</dl>
  <nf>1.50</nf>
  <nl>1.234,50</nl>
</r>
