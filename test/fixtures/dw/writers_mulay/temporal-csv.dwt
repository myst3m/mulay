%%% note
CSV の日時と format / locale、Number の format
%%% script
%dw 2.0
output application/csv
---
[{d: |2020-01-02|, dt: |2020-01-02T10:11:12.5+09:00|, ldt: |2020-01-02T10:11:12|, t: |10:11:12Z|, lt: |10:11:12.123|, tz: |+09:00|, p: |P1Y2M|, du: |PT1H|, df: "2020/01/02" as Date {format: "yyyy/MM/dd"}, dl: |2020-12-31| as Date {format: "dd-MMM-yy", locale: "es"}, nf: "1.50" as Number {format: "#.00"}, nl: 1234.5 as Number {format: "#,##0.00", locale: "de"}}]
%%% output application/csv
d,dt,ldt,t,lt,tz,p,du,df,dl,nf,nl
2020-01-02,2020-01-02T10:11:12.5+09:00,2020-01-02T10:11:12,10:11:12Z,10:11:12.123,+09:00,P1Y2M,PT1H,2020/01/02,31-dic-20,1.50,1.234\,50

