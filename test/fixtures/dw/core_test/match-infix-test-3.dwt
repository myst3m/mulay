%%% note
由来: mulet test/mulet/core_test.clj:783 (match-infix-test)
testing: match combined with mapObject (resolveDeep pattern)
元の形: DW スクリプト
mulet: 成功
%%% script
%dw 2.0
output application/json
fun resolve(params) = params match {
  case obj is Object -> obj mapObject ((v, k) -> {(k): resolve(v)})
  case arr is Array -> arr map resolve($)
  else -> params
}
---
resolve({a: 1, b: {c: 2}, d: [3, 4]})
%%% output application/json
{
  "a": 1,
  "b": {
    "c": 2
  },
  "d": [
    3,
    4
  ]
}
