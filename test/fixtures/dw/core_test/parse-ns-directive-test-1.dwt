%%% note
由来: mulet test/mulet/core_test.clj:476 (parse-ns-directive-test)
testing: Parse ns directive
元の形: DW スクリプト
元テストは parse だけで評価していない
%%% script
%dw 2.0
ns orders http://example.com/orders
output application/xml
---
{orders#order: {orders#id: "123"}}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<orders:order xmlns:orders="http://example.com/orders">
  <orders:id>123</orders:id>
</orders:order>
