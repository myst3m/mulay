%%% note
由来: mulet test/mulet/core_test.clj:489 (parse-ns-directive-test)
testing: Parse multiple ns directives
元の形: DW スクリプト
元テストは parse だけで評価していない
%%% script
%dw 2.0
ns orders http://example.com/orders
ns items http://example.com/items
output application/xml
---
{orders#order: {items#item: "test"}}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<orders:order xmlns:orders="http://example.com/orders">
  <items:item xmlns:items="http://example.com/items">test</items:item>
</orders:order>
