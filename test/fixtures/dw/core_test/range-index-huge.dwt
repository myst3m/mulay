%%% note
範囲の添字と切り出しは、要素の数が 64 ビットに収まらない範囲でも、負でない添字なら実 DW はすぐ答える (2026-10-25、敵対的レビュー)
%%% script
%dw 2.0
output application/json
---
{
  idx: (0 to 9223372036854775807)[3],
  slice: (0 to 9223372036854775807)[1 to 3],
  down: (9223372036854775807 to -9223372036854775808)[2],
  downSlice: (9223372036854775807 to -9223372036854775808)[0 to 2],
  minUp: (-9223372036854775808 to 9223372036854775807)[5],
  negDown: (10 to 1)[-2],
  negUp: (1 to 10)[-2],
  rev: (1 to 10)[3 to 1],
  tail: (1 to 10)[-3 to -1],
  past: (1 to 10)[10],
  before: (1 to 10)[-11],
  one: (5 to 5)[-1],
  size: sizeOf(1 to 10) + sizeOf(10 to 1)
}
%%% output application/json
{
  "idx": 3,
  "slice": [
    1,
    2,
    3
  ],
  "down": 9223372036854775805,
  "downSlice": [
    9223372036854775807,
    9223372036854775806,
    9223372036854775805
  ],
  "minUp": -9223372036854775803,
  "negDown": 2,
  "negUp": 9,
  "rev": [
    4,
    3,
    2
  ],
  "tail": [
    8,
    9,
    10
  ],
  "past": null,
  "before": null,
  "one": 5,
  "size": 20
}
