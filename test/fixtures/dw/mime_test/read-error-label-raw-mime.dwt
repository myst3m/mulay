%%% note
read() の失敗の文言は、渡された mime の文字列をそのまま出す (別名も引数も直さない)
%%% script
%dw 2.0
import try from dw::Runtime
output application/json
---
{
  alias: try(() -> read("{", "json")).error.message,
  params: try(() -> read("{", "application/json; charset=UTF-16")).error.message
}
%%% output application/json
{
  "alias": "Exception while reading '{' as 'json' cause by:\nUnexpected end-of-input at root@[1:2] (line:column), expected '\"', while reading `root` as Json.\n \n1| {\n    ^",
  "params": "Exception while reading '{' as 'application/json; charset=UTF-16' cause by:\nUnexpected end-of-input at root@[1:2] (line:column), expected '\"', while reading `root` as Json.\n \n1| {\n    ^"
}
