%%% note
read() の失敗の文言の入力は、25 文字までそのまま、超えると先頭の 23 文字に ... を付ける
%%% script
%dw 2.0
import try from dw::Runtime
output application/json
---
{
  l25: try(() -> read("{012345678901234567890123", "application/json")).error.message,
  l26: try(() -> read("{0123456789012345678901234", "application/json")).error.message
}
%%% output application/json
{
  "l25": "Exception while reading '{012345678901234567890123' as 'application/json' cause by:\nUnexpected character '0' at root@[1:2] (line:column), expected '\"', while reading `root` as Json.\n \n1| {012345678901234567890123\n    ^",
  "l26": "Exception while reading '{0123456789012345678901...' as 'application/json' cause by:\nUnexpected character '0' at root@[1:2] (line:column), expected '\"', while reading `root` as Json.\n \n1| {0123456789012345678901234\n    ^"
}
