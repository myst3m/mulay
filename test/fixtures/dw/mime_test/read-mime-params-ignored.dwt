%%% note
read() は mime の文字列の引数 (separator、header、quote) を reader のプロパティにしない (第 3 引数だけを使う)
%%% script
%dw 2.0
output application/json
---
{
  sepInMime: read("a;b\n1;2", "application/csv; separator=;"),
  sepInProps: read("a;b\n1;2", "application/csv", {separator: ";"}),
  headerInMime: read("a,b\n1,2", "application/csv; header=false"),
  quoteInMime: read("a,b\n'1,2',3", "application/csv; quote='")
}
%%% output application/json
{
  "sepInMime": [
    {
      "a;b": "1;2"
    }
  ],
  "sepInProps": [
    {
      "a": "1",
      "b": "2"
    }
  ],
  "headerInMime": [
    {
      "a": "1",
      "b": "2"
    }
  ],
  "quoteInMime": [
    {
      "a": "'1",
      "b": "2'",
      "column_2": "3"
    }
  ]
}
