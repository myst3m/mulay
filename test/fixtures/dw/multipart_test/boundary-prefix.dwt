%%% note
境界の行は "--境界" の後ろが "--" か空白と改行だけ (RFC 2046)。"--b1" で始まる別の行 ("--b10 ..") は中身。
%%% script
%dw 2.0
output application/json
var m = read("--b1\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nline\r\n--b10 not a delimiter\r\n--b1x\r\n--b1  \r\nContent-Disposition: form-data; name=\"b\"\r\n\r\ny\r\n--b1--\r\n", "multipart/form-data", {boundary: "b1"})
---
{a: m.parts.a.content, b: m.parts.b.content, names: keysOf(m.parts)}
%%% output application/json
{
  "a": "line\r\n--b10 not a delimiter\r\n--b1x",
  "b": "y",
  "names": [
    "a",
    "b"
  ]
}
