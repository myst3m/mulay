%%% note
multipart/mixed の writer は Content-Disposition を付けない (form-data だけが付ける)。http-multipart の send-mixed で実 Mule と照合
%%% script
%dw 2.0
output multipart/mixed boundary="BB"
---
{parts: {one: {headers: {"Content-Type": "text/plain"}, content: "x"}, two: {headers: {"Content-Type": "text/plain"}, content: "y"}}}
%%% output multipart/form-data
--BB
Content-Type: text/plain

x
--BB
Content-Type: text/plain

y
--BB--

