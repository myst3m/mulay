%%% note
改行が LF だけで、頭の後ろに空行の無い部分。
%%% script
%dw 2.0
output application/json
var m = read("--B\nContent-Disposition: form-data; name=\"a\"\n--B\nContent-Disposition: form-data; name=\"b\"\n\ny\n--B\nContent-Disposition: form-data; name=\"c\"\n\nz\n--B--\n", "multipart/form-data", {boundary: "B"})
---
{names: keysOf(m.parts), parts: m.parts}
%%% output application/json
{
  "names": [
    "a",
    "c"
  ],
  "parts": {
    "a": {
      "headers": {
        "Content-Disposition": {
          "name": "a",
          "subtype": "form-data"
        },
        "--B": "--B",
        "Content-Disposition": {
          "name": "b",
          "subtype": "form-data"
        }
      },
      "content": "y"
    },
    "c": {
      "headers": {
        "Content-Disposition": {
          "name": "c",
          "subtype": "form-data"
        }
      },
      "content": "z"
    }
  }
}
