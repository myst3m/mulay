%%% note
頭の後ろに空行の無い部分。空行は次の境界の後ろにあり、頭の終わりを次の境界までで探しても読み方が変わらないことを見る。
%%% script
%dw 2.0
output application/json
var m = read("--B\r\nContent-Disposition: form-data; name=\"a\"\r\n--B\r\nContent-Disposition: form-data; name=\"b\"\r\n\r\ny\r\n--B\r\nContent-Disposition: form-data; name=\"c\"\r\n\r\nz\r\n--B--\r\n", "multipart/form-data", {boundary: "B"})
---
{names: keysOf(m.parts), parts: m.parts}
%%% output application/json
{
  "names": [
    "a",
    "c"
  ],
  "parts": {
    "a": {
      "headers": {
        "Content-Disposition": {
          "name": "a",
          "subtype": "form-data"
        },
        "--B": "--B",
        "Content-Disposition": {
          "name": "b",
          "subtype": "form-data"
        }
      },
      "content": "y"
    },
    "c": {
      "headers": {
        "Content-Disposition": {
          "name": "c",
          "subtype": "form-data"
        }
      },
      "content": "z"
    }
  }
}
