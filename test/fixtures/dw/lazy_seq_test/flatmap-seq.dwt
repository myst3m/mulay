%%% note
flatMap で関数が配列・範囲・単独の値を返すとき (ADR 105)
%%% script
%dw 2.0
output application/json
---
payload flatMap (if ($ == 1) [$, $] else if ($ == 2) (1 to 2) else if ($ == 3) [] else $)
%%% input payload application/json
[1, 2, 3, 4]
%%% output application/json
[
  1,
  1,
  [
    1,
    2
  ],
  4
]
