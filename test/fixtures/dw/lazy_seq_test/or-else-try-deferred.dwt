%%% note
orElseTry の後ろ側の関数の誤りも、並びをまとめて読んでから判定する (ADR 105)
%%% script
%dw 2.0
import * from dw::Runtime
output application/json
---
(try(() -> dw::Runtime::fail("a")) orElseTry (() -> payload map (if ($ == 3) dw::Runtime::fail("b") else $))).success
%%% input payload application/json
[1, 2, 3]
%%% output application/json
false
