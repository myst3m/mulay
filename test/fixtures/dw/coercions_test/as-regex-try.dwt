%%% note
String を Regex に変換するときに正規表現として読み、読めなければ PatternSyntaxException で失敗する (2026-10-17)
%%% script
%dw 2.0
import try from dw::Runtime
output application/json
---
do { var r = try(() -> "(" as Regex) --- {kind: r.error.kind, message: r.error.message} }
%%% output application/json
{
  "kind": "PatternSyntaxException",
  "message": "Unclosed group near index 1\n("
}
