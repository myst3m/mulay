%%% note
null を String にする失敗の文 (実 DW で記録)。as は "Cannot coerce Null to String" (値の "(null)" は付けない)。
文字列の中の $(..) が null なら、その補間を Append の呼び出しとして "You called the function 'Append' .." にする。
別のプロジェクトからの質問 (validation の message が null の変数を埋めた時の文) から。
%%% input payload application/json
{}
%%% input vars application/json
{"credit": null, "o": {"x": 1}}
%%% script
%dw 2.0
import try from dw::Runtime
output application/json
var lit = null
---
[
  (try(() -> vars.credit as String)).error.message,
  (try(() -> vars.nope as String)).error.message,
  (try(() -> lit as String)).error.message,
  (try(() -> payload.zz as String)).error.message,
  (try(() -> {a: null}.a as String)).error.message,
  (try(() -> "a $(vars.credit) b")).error.message,
  (try(() -> "a " ++ vars.credit)).error.message,
  (try(() -> "a $(vars.nope)")).error.message,
  (try(() -> "a $(vars.o) b")).error.message,
  (try(() -> "$(vars.credit)")).error.message,
  (try(() -> "a $(1) $(vars.credit)")).error.message,
  (try(() -> "$(vars.credit) b")).error.message,
  (try(() -> "$(vars.o)")).error.message,
  (try(() -> "$(1)$(vars.credit)")).error.message,
  "a $(1) b $(true) c $(|2020-01-01|)"
]
%%% output application/json
[
  "Cannot coerce Null to String",
  "Cannot coerce Null to String",
  "Cannot coerce Null to String",
  "Cannot coerce Null to String",
  "Cannot coerce Null to String",
  "You called the function 'Append' with these arguments: \n  1: String (\"a \")\n  2: Null (null)\n\nBut it expects arguments of these types:\n  1: String\n  2: String\n",
  "You called the function '++' with these arguments: \n  1: String (\"a \")\n  2: Null (null)\n\nBut it expects one of these combinations:\n  (Array, Array)\n  (Date, Time)\n  (Date, LocalTime)\n  (Date, TimeZone)\n  (LocalDateTime, TimeZone)\n  (LocalTime, Date)\n  (LocalTime, TimeZone)\n  (Object, Object)\n  (String, String)\n  (Time, Date)\n  (TimeZone, LocalDateTime)\n  (TimeZone, Date)\n  (TimeZone, LocalTime)",
  "You called the function 'Append' with these arguments: \n  1: String (\"a \")\n  2: Null (null)\n\nBut it expects arguments of these types:\n  1: String\n  2: String\n",
  "You called the function 'Append' with these arguments: \n  1: String (\"a \")\n  2: Object ({x: 1})\n\nBut it expects arguments of these types:\n  1: String\n  2: String\n",
  "Cannot coerce Null to String",
  "You called the function 'Append' with these arguments: \n  1: String (\"a 1 \")\n  2: Null (null)\n\nBut it expects arguments of these types:\n  1: String\n  2: String\n",
  "You called the function 'Append' with these arguments: \n  1: Null (null)\n  2: String (\" b\")\n\nBut it expects arguments of these types:\n  1: String\n  2: String\n",
  "Cannot coerce Object to String",
  "You called the function 'Append' with these arguments: \n  1: Number (1)\n  2: Null (null)\n\nBut it expects arguments of these types:\n  1: String\n  2: String\n",
  "a 1 b true c 2020-01-01"
]
