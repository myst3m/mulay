%%% script
%dw 2.0
import envVar from dw::System
output application/json
---
envVar("PATH")
%%% env
PATH=/usr/local/bin:/usr/bin:/bin
HOME=/home/test
%%% output application/json
"/usr/local/bin:/usr/bin:/bin"
