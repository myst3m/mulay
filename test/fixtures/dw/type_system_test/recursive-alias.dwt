%%% note
自分を指す型の別名: 配列の要素 (kids?: Array<T>)、入れ子のフィールド (next?: Node)、型を書いた引数、match の case is (実 DW で記録)。
%%% script
%dw 2.0
output application/json
type Tree = { name: String, kids?: Array<Tree> }
type Node = { v: Number, next?: Node }
fun depth(n: Node): Number = if (n.next?) 1 + depth(n.next as Node) else 1
fun kind(x) = x match {
  case is Node -> "node"
  else -> "other"
}
---
{
  tree: [{name: "a", kids: [{name: "b"}]} is Tree, {name: 1} is Tree, {name: "a"} is Tree],
  node: [{v: 1, next: {v: 2}} is Node, {v: 1, next: {v: "x"}} is Node, {v: 1, next: {v: 2, next: {w: 3}}} is Node, {v: 1, next: 5} is Node],
  depth: depth({v: 1, next: {v: 2, next: {v: 3}}}),
  kinds: [kind({v: 1}), kind({v: 1, next: {}})]
}
%%% output application/json
{
  "tree": [
    true,
    false,
    true
  ],
  "node": [
    true,
    false,
    false,
    false
  ],
  "depth": 3,
  "kinds": [
    "node",
    "other"
  ]
}
