%%% note
型の宣言は後ろで宣言した型を指せる (type A = {b: B} の後に type B)。型の選び出し (A.b)、総称の型、互いに指す型 (実 DW で記録)。
%%% script
%dw 2.0
output application/json
type A = {b: B}
type S = A.b
type B = {- c: Number -}
type W = Box<Number>
type Box<T> = {v: T}
type P = {q?: Q}
type Q = {p?: P, n: Number}
---
{
  a: [{b: {c: 1}} is A, {b: {c: "x"}} is A, {c: 2} is S],
  w: [{v: 1} is W, {v: "x"} is W],
  pq: [{q: {n: 1, p: {}}} is P, {q: {n: "x"}} is P]
}
%%% output application/json
{
  "a": [
    true,
    false,
    true
  ],
  "w": [
    true,
    false
  ],
  "pq": [
    true,
    false
  ]
}
