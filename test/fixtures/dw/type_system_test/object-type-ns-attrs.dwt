%%% note
オブジェクトの型のキーの名前空間と属性: 型のキーに名前空間があれば値のキーも同じ URI が要る、属性の型 (@(x: T)) と必須・省略可、
繰り返し (k*)、順序の付いた型 ({- -}) の is (実 DW で記録)。xmlschema! が作る型がこれを使う。
%%% script
%dw 2.0
ns o http://example.com/o
ns p http://example.com/p
output application/json
type NsKey = { o#a: Number }
type Plain = { a: Number }
type Attr = { a @(x: "A" | "B", y?: Number): String }
type Rep = { item*: Number, one: String }
type Ord = {- a: Number, b: Number -}
type Closed = {| o#a: Number |}
---
{
  nskey: [{o#a: 1} is NsKey, {a: 1} is NsKey, {p#a: 1} is NsKey],
  plain: [{a: 1} is Plain, {o#a: 1} is Plain],
  attr: [{a @(x: "A"): "s"} is Attr, {a @(x: "C"): "s"} is Attr, {a: "s"} is Attr, {a @(x: "B", y: 2): "s"} is Attr, {a @(x: "B", y: "z"): "s"} is Attr, {a @(x: "A", z: 1): "s"} is Attr],
  rep: [{item: 1, item: 2, one: "x"} is Rep, {one: "x"} is Rep, {item: "n", one: "x"} is Rep],
  ord: [{a: 1, b: 2} is Ord, {b: 2, a: 1} is Ord, {a: 1, b: 2, c: 3} is Ord],
  closed: [{o#a: 1} is Closed, {o#a: 1, o#b: 2} is Closed, {a: 1} is Closed]
}
%%% output application/json
{
  "nskey": [
    true,
    false,
    false
  ],
  "plain": [
    true,
    true
  ],
  "attr": [
    true,
    false,
    false,
    true,
    true,
    true
  ],
  "rep": [
    true,
    false,
    false
  ],
  "ord": [
    true,
    true,
    true
  ],
  "closed": [
    true,
    false,
    false
  ]
}
