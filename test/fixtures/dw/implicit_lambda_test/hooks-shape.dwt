%%% note
a2a-push の hooks の式 (valuesOf の後の map と orderBy、その結果を括弧でくくって map し、- と ++ でキーを差し替える)。
%%% script
%dw 2.0
output application/json
var hooks = {b: '{\n  "hook": "b",\n  "body": {"a": 1}\n}', a: '{\n  "hook": "a",\n  "body": {"a": 2}\n}'}
---
(valuesOf(hooks) map read($ as String, "application/json") orderBy $.hook) map ($ - "body" ++ {body: write($.body, "application/json") replace "x" with "<tid>"})
%%% output application/json
[
  {
    "hook": "a",
    "body": "{\n  \"a\": 2\n}"
  },
  {
    "hook": "b",
    "body": "{\n  \"a\": 1\n}"
  }
]
