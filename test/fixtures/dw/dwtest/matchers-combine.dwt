%%% note
dw::test::Asserts の組み合わせ: notBe・anyOf・eachItem・haveItem、配列の must (最初に失敗したもの)、式の must ($ を使う条件) (実 DW で記録)。
%%% script
%dw 2.0
import * from dw::test::Asserts
output application/json
---
{
  notBe: [1 must notBe(equalTo(1)), 1 must notBe(equalTo(2))],
  anyOf: [1 must anyOf([equalTo(2), beString()]), 1 must anyOf([equalTo(1), beString()])],
  each: [[1, "a", "b"] must eachItem(beNumber()), [1, 2] must eachItem(beNumber()), [] must eachItem(beNumber())],
  have: [[1, 2] must haveItem(beString()), [1, "a"] must haveItem(beString())],
  list: [{a: 1} must [beObject(), $.a must equalTo(2)], {a: 1} must [beObject(), haveKey("a")], 1 must [beString(), beNull()]],
  cond: [[] must sizeOf($) > 2, [1, 2, 3] must sizeOf($) > 2],
  condList: [1 must [$ > 5], 9 must [$ > 5, $ < 10]]
}
%%% output application/json
{
  "notBe": [
    {
      "matches": false,
      "description": "Expected not `Expected 1 but was 1..` From `notBe: [1 must notBe(equalTo(1)), 1 must notBe(equalTo(2))],` at line 6 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected not `Expected 2 but was 1..` From `notBe: [1 must notBe(equalTo(1)), 1 must notBe(equalTo(2))],` at line 6 of anonymous.dwl."
    }
  ],
  "anyOf": [
    {
      "matches": false,
      "description": "Expected any of Expected 2 but was 1. or Expected value to be String type but was Number. but was 1. From `anyOf: [1 must anyOf([equalTo(2), beString()]), 1 must anyOf([equalTo(1), beString()])],` at line 7 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected any of Expected 1 but was 1. or Expected value to be String type but was Number. but was 1. From `anyOf: [1 must anyOf([equalTo(2), beString()]), 1 must anyOf([equalTo(1), beString()])],` at line 7 of anonymous.dwl."
    }
  ],
  "each": [
    {
      "matches": false,
      "description": "Expected all items of the array to match but [\n  1, \n  2\n] didn't match. From `each: [[1, \"a\", \"b\"] must eachItem(beNumber()), [1, 2] must eachItem(beNumber()), [] must eachItem(beNumber())],` at line 8 of anonymous.dwl.",
      "reasons": [
        "Item 1 Expected value to be Number type but was String.. From `each: [[1, \"a\", \"b\"] must eachItem(beNumber()), [1, 2] must eachItem(beNumber()), [] must eachItem(beNumber())],` at line 8 of anonymous.dwl.",
        "Item 2 Expected value to be Number type but was String.. From `each: [[1, \"a\", \"b\"] must eachItem(beNumber()), [1, 2] must eachItem(beNumber()), [] must eachItem(beNumber())],` at line 8 of anonymous.dwl."
      ]
    },
    {
      "matches": true,
      "description": "Expected all items of the array to match but [] didn't match. From `each: [[1, \"a\", \"b\"] must eachItem(beNumber()), [1, 2] must eachItem(beNumber()), [] must eachItem(beNumber())],` at line 8 of anonymous.dwl.",
      "reasons": [
        
      ]
    },
    {
      "matches": true,
      "description": "Expected all items of the array to match but [] didn't match. From `each: [[1, \"a\", \"b\"] must eachItem(beNumber()), [1, 2] must eachItem(beNumber()), [] must eachItem(beNumber())],` at line 8 of anonymous.dwl.",
      "reasons": [
        
      ]
    }
  ],
  "have": [
    {
      "matches": false,
      "description": "Expected any item of the array to match but none did. From `have: [[1, 2] must haveItem(beString()), [1, \"a\"] must haveItem(beString())],` at line 9 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected any item of the array to match but none did. From `have: [[1, 2] must haveItem(beString()), [1, \"a\"] must haveItem(beString())],` at line 9 of anonymous.dwl."
    }
  ],
  "list": [
    {
      "matches": false,
      "description": "Expected 2 but was 1. From `list: [{a: 1} must [beObject(), $.a must equalTo(2)], {a: 1} must [beObject(), haveKey(\"a\")], 1 must [beString(), beNull()]],` at line 10 of anonymous.dwl.",
      "reasons": [
        "Expected value to be 2 but was 1 at (root). From `list: [{a: 1} must [beObject(), $.a must equalTo(2)], {a: 1} must [beObject(), haveKey(\"a\")], 1 must [beString(), beNull()]],` at line 10 of anonymous.dwl."
      ]
    },
    {
      "matches": true,
      "description": "Expected {\n  a: 1\n} to contain key a."
    },
    {
      "matches": false,
      "description": "Expected value to be String type but was Number."
    }
  ],
  "cond": [
    {
      "matches": false,
      "description": "Assertion `cond: [[] must sizeOf($) > 2, [1, 2, 3] must sizeOf($) > 2],` failed with value []. From `cond: [[] must sizeOf($) > 2, [1, 2, 3] must sizeOf($) > 2],` at line 11 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Assertion `cond: [[] must sizeOf($) > 2, [1, 2, 3] must sizeOf($) > 2],` failed with value [\n  1, \n  2, \n  3\n]. From `cond: [[] must sizeOf($) > 2, [1, 2, 3] must sizeOf($) > 2],` at line 11 of anonymous.dwl."
    }
  ],
  "condList": [
    {
      "matches": false,
      "description": "`condList: [1 must [$ > 5], 9 must [$ > 5, $ < 10]]` was 1."
    },
    {
      "matches": true,
      "description": "`condList: [1 must [$ > 5], 9 must [$ > 5, $ < 10]]` was 9."
    }
  ]
}
