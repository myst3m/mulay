%%% note
dw::test::Asserts の equalTo: 違いの種類ごとの理由 (値・型・配列の長さ・無いキー・余計なキー・XML の属性)、unordered、入れ子の道筋 (実 DW で記録)。
%%% script
%dw 2.0
import * from dw::test::Asserts
output application/json
---
{
  same: 1 must equalTo(1),
  value: {a: 1, b: [1, 2]} must equalTo({a: 1, b: [1, 3]}),
  unorderedArr: [1, 2] must equalTo([2, 1], {unordered: true}),
  unorderedObj: {b: 1, a: 2} must equalTo({a: 2, b: 1}, {unordered: true}),
  orderedObj: {b: 1, a: 2} must equalTo({a: 2, b: 1}),
  missing: {a: 1} must equalTo({a: 1, b: 2}),
  extra: {a: 1, c: "x"} must equalTo({a: 1}),
  both: {a: 1, c: true} must equalTo({a: 1, b: [1]}),
  typeObj: [1] must equalTo({a: 1}),
  typeArr: "x" must equalTo([1]),
  scalar: "x" must equalTo(1),
  length: [1, 2, 3] must equalTo([1, 2]),
  nested: {a: {b: [{c: 1}, {c: 2}]}} must equalTo({a: {b: [{c: 1}, {c: "2"}]}}),
  attrs: {a @(x: 1, y: 2): "v"} must equalTo({a @(x: 1, z: 3): "v"}),
  strs: "line1\nline2" must equalTo("line1"),
  nulls: null must equalTo({a: 1}),
  dates: |2020-01-01| must equalTo(|2020-01-02|)
}
%%% output application/json
{
  "same": {
