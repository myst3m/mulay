%%% note
dw::test::Asserts の文字列・集まりの matcher (contain・beOneOf・endWith・startWith・beEmpty・beBlank・haveKey・haveValue・beGreaterThan・beLowerThan)。成功と失敗の文言 (実 DW で記録)。
%%% script
%dw 2.0
import * from dw::test::Asserts
output application/json
---
{
  contain: ["hello" must contain("x"), "hello" must contain("ell"), [1, 2] must contain(3), [{a: 1}] must contain({a: 1})],
  oneOf: [1 must beOneOf([2, 3]), "b" must beOneOf(["a", "b"])],
  ends: ["abc" must endWith("x"), "abc" must endWith("bc")],
  starts: ["abc" must startWith("x"), "abc" must startWith("ab")],
  empty: [[1] must beEmpty(), "" must beEmpty(), {} must beEmpty(), null must beEmpty(), {a: "x"} must beEmpty()],
  blank: ["a" must beBlank(), "  " must beBlank(), null must beBlank()],
  key: [{a: 1} must haveKey("b"), {a: 1} must haveKey("a")],
  value: [{a: 1} must haveValue(2), {a: [1]} must haveValue([1])],
  greater: [1 must beGreaterThan(2), 1 must beGreaterThan(1, true), 1 must beGreaterThan(1), "b" must beGreaterThan("a"), |2020-01-02| must beGreaterThan(|2020-01-01|)],
  lower: [3 must beLowerThan(2), 2 must beLowerThan(2, true), 1.5 must beLowerThan(2)]
}
%%% output application/json
{
  "contain": [
    {
      "matches": false,
      "description": "Expected hello to contain x. From `contain: [\"hello\" must contain(\"x\"), \"hello\" must contain(\"ell\"), [1, 2] must contain(3), [{a: 1}] must contain({a: 1})],` at line 6 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected hello to contain ell. From `contain: [\"hello\" must contain(\"x\"), \"hello\" must contain(\"ell\"), [1, 2] must contain(3), [{a: 1}] must contain({a: 1})],` at line 6 of anonymous.dwl."
    },
    {
      "matches": false,
      "description": "Expected [\n  1, \n  2\n] to contain 3. From `contain: [\"hello\" must contain(\"x\"), \"hello\" must contain(\"ell\"), [1, 2] must contain(3), [{a: 1}] must contain({a: 1})],` at line 6 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected [\n  {\n    a: 1\n  }\n] to contain {\n  a: 1\n}. From `contain: [\"hello\" must contain(\"x\"), \"hello\" must contain(\"ell\"), [1, 2] must contain(3), [{a: 1}] must contain({a: 1})],` at line 6 of anonymous.dwl."
    }
  ],
  "oneOf": [
    {
      "matches": false,
      "description": "Expected value to be one of [\n  2, \n  3\n] but was 1. From `oneOf: [1 must beOneOf([2, 3]), \"b\" must beOneOf([\"a\", \"b\"])],` at line 7 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected value to be one of [\n  \"a\", \n  \"b\"\n] but was \"b\". From `oneOf: [1 must beOneOf([2, 3]), \"b\" must beOneOf([\"a\", \"b\"])],` at line 7 of anonymous.dwl."
    }
  ],
  "ends": [
    {
      "matches": false,
      "description": "Expected abc to end with x. From `ends: [\"abc\" must endWith(\"x\"), \"abc\" must endWith(\"bc\")],` at line 8 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected abc to end with bc. From `ends: [\"abc\" must endWith(\"x\"), \"abc\" must endWith(\"bc\")],` at line 8 of anonymous.dwl."
    }
  ],
  "starts": [
    {
      "matches": false,
      "description": "Expected abc to start with x. From `starts: [\"abc\" must startWith(\"x\"), \"abc\" must startWith(\"ab\")],` at line 9 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected abc to start with ab. From `starts: [\"abc\" must startWith(\"x\"), \"abc\" must startWith(\"ab\")],` at line 9 of anonymous.dwl."
    }
  ],
  "empty": [
    {
      "matches": false,
      "description": "Expected [\n  1\n] to be empty. From `empty: [[1] must beEmpty(), \"\" must beEmpty(), {} must beEmpty(), null must beEmpty(), {a: \"x\"} must beEmpty()],` at line 10 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected \"\" to be empty. From `empty: [[1] must beEmpty(), \"\" must beEmpty(), {} must beEmpty(), null must beEmpty(), {a: \"x\"} must beEmpty()],` at line 10 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected {} to be empty. From `empty: [[1] must beEmpty(), \"\" must beEmpty(), {} must beEmpty(), null must beEmpty(), {a: \"x\"} must beEmpty()],` at line 10 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected null to be empty. From `empty: [[1] must beEmpty(), \"\" must beEmpty(), {} must beEmpty(), null must beEmpty(), {a: \"x\"} must beEmpty()],` at line 10 of anonymous.dwl."
    },
    {
      "matches": false,
      "description": "Expected {\n  a: \"x\"\n} to be empty. From `empty: [[1] must beEmpty(), \"\" must beEmpty(), {} must beEmpty(), null must beEmpty(), {a: \"x\"} must beEmpty()],` at line 10 of anonymous.dwl."
    }
  ],
  "blank": [
    {
      "matches": false,
      "description": "Expected a to be blank. From `blank: [\"a\" must beBlank(), \"  \" must beBlank(), null must beBlank()],` at line 11 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected    to be blank. From `blank: [\"a\" must beBlank(), \"  \" must beBlank(), null must beBlank()],` at line 11 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected null to be blank. From `blank: [\"a\" must beBlank(), \"  \" must beBlank(), null must beBlank()],` at line 11 of anonymous.dwl."
    }
  ],
  "key": [
    {
      "matches": false,
      "description": "Expected {\n  a: 1\n} to contain key b. From `key: [{a: 1} must haveKey(\"b\"), {a: 1} must haveKey(\"a\")],` at line 12 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected {\n  a: 1\n} to contain key a. From `key: [{a: 1} must haveKey(\"b\"), {a: 1} must haveKey(\"a\")],` at line 12 of anonymous.dwl."
    }
  ],
  "value": [
    {
      "matches": false,
      "description": "Expected {\n  a: 1\n} to contain value 2. From `value: [{a: 1} must haveValue(2), {a: [1]} must haveValue([1])],` at line 13 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected {\n  a: [\n    1\n  ]\n} to contain value [\n  1\n]. From `value: [{a: 1} must haveValue(2), {a: [1]} must haveValue([1])],` at line 13 of anonymous.dwl."
    }
  ],
  "greater": [
    {
      "matches": false,
      "description": "Expected value 1 to be greater than 2. From `greater: [1 must beGreaterThan(2), 1 must beGreaterThan(1, true), 1 must beGreaterThan(1), \"b\" must beGreaterThan(\"a\"), |2020-01-02| must beGreaterThan(|2020-01-01|)],` at line 14 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected value 1 to be greater than 1. From `greater: [1 must beGreaterThan(2), 1 must beGreaterThan(1, true), 1 must beGreaterThan(1), \"b\" must beGreaterThan(\"a\"), |2020-01-02| must beGreaterThan(|2020-01-01|)],` at line 14 of anonymous.dwl."
    },
    {
      "matches": false,
      "description": "Expected value 1 to be greater than 1. From `greater: [1 must beGreaterThan(2), 1 must beGreaterThan(1, true), 1 must beGreaterThan(1), \"b\" must beGreaterThan(\"a\"), |2020-01-02| must beGreaterThan(|2020-01-01|)],` at line 14 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected value \"b\" to be greater than a. From `greater: [1 must beGreaterThan(2), 1 must beGreaterThan(1, true), 1 must beGreaterThan(1), \"b\" must beGreaterThan(\"a\"), |2020-01-02| must beGreaterThan(|2020-01-01|)],` at line 14 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected value |2020-01-02| to be greater than 2020-01-01. From `greater: [1 must beGreaterThan(2), 1 must beGreaterThan(1, true), 1 must beGreaterThan(1), \"b\" must beGreaterThan(\"a\"), |2020-01-02| must beGreaterThan(|2020-01-01|)],` at line 14 of anonymous.dwl."
    }
  ],
  "lower": [
    {
      "matches": false,
      "description": "Expected value 3 to be lower than 2. From `lower: [3 must beLowerThan(2), 2 must beLowerThan(2, true), 1.5 must beLowerThan(2)]` at line 15 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected value 2 to be lower than 2. From `lower: [3 must beLowerThan(2), 2 must beLowerThan(2, true), 1.5 must beLowerThan(2)]` at line 15 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected value 1.5 to be lower than 2. From `lower: [3 must beLowerThan(2), 2 must beLowerThan(2, true), 1.5 must beLowerThan(2)]` at line 15 of anonymous.dwl."
    }
  ]
}
