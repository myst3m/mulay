%%% note
全部通る suite と、テストの無い suite (実 DW で記録)。
%%% mask
"time": ([0-9]+)
%%% script
%dw 2.0
import * from dw::test::Tests
import * from dw::test::Asserts
output application/json
fun clean(r) = r mapObject (v, k) -> if (k as String == "location") {} else if (k as String == "tests") {(k): (v as Array) map clean($)} else {(k): v}
---
([
  "All" describedBy [
    "a" in do { "abc" must startWith("a") },
    "b" in do { {x: 1} must haveKey("x") }
  ],
  "Empty" describedBy []
] map clean($))
%%% output application/json
[
  {
    "name": "All",
    "time": 34,
    "status": "OK",
    "tests": [
      {
        "name": "a",
        "time": 11,
        "status": "OK",
        "errorMessage": "Expected abc to start with a. From `\"a\" in do { \"abc\" must startWith(\"a\") },` at line 9 of anonymous.dwl."
      },
      {
        "name": "b",
        "time": 2,
        "status": "OK",
        "errorMessage": "Expected {\n  x: 1\n} to contain key x. From `\"b\" in do { {x: 1} must haveKey(\"x\") }` at line 10 of anonymous.dwl."
      }
    ]
  },
  {
    "name": "Empty",
    "time": 0,
    "status": "OK",
    "tests": [
      
    ]
  }
]
