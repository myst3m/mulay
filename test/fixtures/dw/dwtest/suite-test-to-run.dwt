%%% note
dw::test の testToRun (システムプロパティ。カンマで区切った語のどれかを名前に含むテストだけを回し、ほかは SKIP)。location は伏せる (実 DW で記録)。
%%% mask
"time": ([0-9]+)
%%% sysprops
testToRun=alpha,zzz
%%% script
%dw 2.0
import * from dw::test::Tests
import * from dw::test::Asserts
output application/json
fun clean(r) = r mapObject (v, k) -> if (k as String == "location") {} else if (k as String == "tests") {(k): (v as Array) map clean($)} else {(k): v}
---
clean("S" describedBy [
  "alpha one" in do { 1 must equalTo(1) },
  "beta" in do { 1 must equalTo(2) },
  ("gamma alpha" <~ {skip: {reason: "r"}}) in do { 1 must equalTo(1) }
])
%%% output application/json
{
  "name": "S",
  "time": 42,
  "status": "OK",
  "tests": [
    {
      "name": "alpha one",
      "time": 13,
      "status": "OK",
      "errorMessage": ""
    },
    {
      "name": "beta",
      "time": 0,
      "status": "SKIP"
    },
    {
      "name": "gamma alpha",
      "time": 0,
      "status": "SKIP",
      "skipReason": "r"
    }
  ]
}
