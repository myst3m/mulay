%%% note
dw::test::Tests の errorMessage: 理由が複数ある equalTo、配列で複数が失敗した時、成功した matcher の文言、匿名の (名前の無い) 変数の suite、Mule の式での誤り (実 DW で記録)。
%%% mask
"time": ([0-9]+)
%%% script
%dw 2.0
import * from dw::test::Tests
import * from dw::test::Asserts
output application/json
fun clean(r) = r mapObject (v, k) -> if (k as String == "location") {} else if (k as String == "tests") {(k): (v as Array) map clean($)} else {(k): v}
var expected = {a: 1, b: 2, c: [1]}
---
clean(
"Messages" describedBy [
  "two reasons" in do {
    {a: 2, b: 3, c: [1]} must equalTo(expected)
  },
  "two failing" in [
    1 must beString(),
    2 must beNull(),
    3 must beNumber()
  ],
  "all ok list" in [
    1 must beNumber(),
    "a" must startWith("a")
  ],
  "lambda" in do {
    5 must [$ > 3, $ < 4]
  },
  "missing field" in do {
    ({a: 1}.b.c) must equalTo(1)
  },
  "bad call" in do {
    sizeOf(1 as Any as String) must equalTo(1)
  }
]
)
%%% output application/json
{
  "name": "Messages",
  "time": 73,
  "status": "OK",
  "tests": [
    {
      "name": "two reasons",
      "time": 29,
      "status": "FAIL",
      "errorMessage": "Expected value to be 2 but was 3 at (root).b. From `{a: 2, b: 3, c: [1]} must equalTo(expected)` at line 11 of anonymous.dwl.\nExpected value to be 1 but was 2 at (root).a. From `{a: 2, b: 3, c: [1]} must equalTo(expected)` at line 11 of anonymous.dwl."
    },
    {
      "name": "two failing",
      "time": 1,
      "status": "FAIL",
      "errorMessage": "Expected value to be String type but was Number. From `1 must beString(),` at line 14 of anonymous.dwl."
    },
    {
      "name": "all ok list",
      "time": 1,
      "status": "OK",
      "errorMessage": "Expected a to start with a. From `\"a\" must startWith(\"a\")` at line 20 of anonymous.dwl."
    },
    {
      "name": "lambda",
      "time": 2,
      "status": "FAIL",
      "errorMessage": "`5 must [$ > 3, $ < 4]` was 5."
    },
    {
      "name": "missing field",
      "time": 2,
      "status": "FAIL",
      "errorMessage": "Expected value to be 1 but was null at (root). From `({a: 1}.b.c) must equalTo(1)` at line 26 of anonymous.dwl."
    },
    {
      "name": "bad call",
      "time": 1,
      "status": "OK",
      "errorMessage": ""
    }
  ]
}
