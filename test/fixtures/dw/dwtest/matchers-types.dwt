%%% note
dw::test::Asserts の型と大きさの matcher (beArray・beString・beNumber・beBoolean・beObject・beNull・notBeNull・haveSize)。結果の MatcherResult をそのまま出す (実 DW で記録)。
%%% script
%dw 2.0
import * from dw::test::Asserts
output application/json
---
{
  arr: [1 must beArray(), [] must beArray()],
  str: [1 must beString(), "a" must beString()],
  num: ["1" must beNumber(), 1.5 must beNumber()],
  bool: [1 must beBoolean(), false must beBoolean()],
  obj: [1 must beObject(), {} must beObject()],
  nul: [1 must beNull(), null must beNull()],
  notNull: [null must notBeNull(), 0 must notBeNull()],
  matched: MATCHED,
  size: [[1] must haveSize(2), "abc" must haveSize(3), {a: 1} must haveSize(1), null must haveSize(0)]
}
%%% output application/json
{
  "arr": [
    {
      "matches": false,
      "description": "Expected value to be Array type but was Number. From `arr: [1 must beArray(), [] must beArray()],` at line 6 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected value to be Array type but was Array. From `arr: [1 must beArray(), [] must beArray()],` at line 6 of anonymous.dwl."
    }
  ],
  "str": [
    {
      "matches": false,
      "description": "Expected value to be String type but was Number. From `str: [1 must beString(), \"a\" must beString()],` at line 7 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected value to be String type but was String. From `str: [1 must beString(), \"a\" must beString()],` at line 7 of anonymous.dwl."
    }
  ],
  "num": [
    {
      "matches": false,
      "description": "Expected value to be Number type but was String. From `num: [\"1\" must beNumber(), 1.5 must beNumber()],` at line 8 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected value to be Number type but was Number. From `num: [\"1\" must beNumber(), 1.5 must beNumber()],` at line 8 of anonymous.dwl."
    }
  ],
  "bool": [
    {
      "matches": false,
      "description": "Expected value to be Boolean type but was Number. From `bool: [1 must beBoolean(), false must beBoolean()],` at line 9 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected value to be Boolean type but was Boolean. From `bool: [1 must beBoolean(), false must beBoolean()],` at line 9 of anonymous.dwl."
    }
  ],
  "obj": [
    {
      "matches": false,
      "description": "Expected value to be Object type but was Number. From `obj: [1 must beObject(), {} must beObject()],` at line 10 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected value to be Object type but was Object. From `obj: [1 must beObject(), {} must beObject()],` at line 10 of anonymous.dwl."
    }
  ],
  "nul": [
    {
      "matches": false,
      "description": "Expected value to be Null type but was Number. From `nul: [1 must beNull(), null must beNull()],` at line 11 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected value to be Null type but was Null. From `nul: [1 must beNull(), null must beNull()],` at line 11 of anonymous.dwl."
    }
  ],
  "notNull": [
    {
      "matches": false,
      "description": "Expected value not to be Null type. From `notNull: [null must notBeNull(), 0 must notBeNull()],` at line 12 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected value not to be Null type. From `notNull: [null must notBeNull(), 0 must notBeNull()],` at line 12 of anonymous.dwl."
    }
  ],
  "matched": {
    "matches": true,
    "description": ""
  },
  "size": [
    {
      "matches": false,
      "description": "Expected size 2 but was 1. From `size: [[1] must haveSize(2), \"abc\" must haveSize(3), {a: 1} must haveSize(1), null must haveSize(0)]` at line 14 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected size 3 but was 3. From `size: [[1] must haveSize(2), \"abc\" must haveSize(3), {a: 1} must haveSize(1), null must haveSize(0)]` at line 14 of anonymous.dwl."
    },
    {
      "matches": true,
      "description": "Expected size 1 but was 1. From `size: [[1] must haveSize(2), \"abc\" must haveSize(3), {a: 1} must haveSize(1), null must haveSize(0)]` at line 14 of anonymous.dwl."
    },
    {
      "matches": false,
      "description": "Expected size 0 but was null. From `size: [[1] must haveSize(2), \"abc\" must haveSize(3), {a: 1} must haveSize(1), null must haveSize(0)]` at line 14 of anonymous.dwl."
    }
  ]
}
