%%% note
dw::test の inputsFrom (資源のディレクトリ dwtestResources の <dir>/inputs のファイルを、拡張子の形式で読み、名前から拡張子を除いたキーに。
ディレクトリは入れ子のオブジェクト、.properties は飛ばす) と outputFrom (<dir>/out.*)。キーの順はファイルの一覧の順なので並べ替えて比べる (実 DW で記録)。
%%% sysprops
dwtestResources=test/fixtures/dw/dwtest/res
%%% script
%dw 2.0
import * from dw::test::Tests
output application/json
var ins = inputsFrom("case1")
---
{
  keys: keysOf(ins) map ($ as String) orderBy $,
  payload: ins.payload,
  doc: ins.doc,
  rows: ins.rows,
  semi: ins.semi,
  vars: ins.vars,
  out: outputFrom("case1")
}
%%% output application/json
{
  "keys": [
    "doc",
    "payload",
    "rows",
    "semi",
    "vars"
  ],
  "payload": {
    "a": 1,
    "b": [
      1,
      2
    ]
  },
  "doc": {
    "r": {
      "x": "1"
    }
  },
  "rows": [
    {
      "k": "1",
      "v": "2"
    }
  ],
  "semi": [
    {
      "a;b": "1;2"
    }
  ],
  "vars": {
    "greet": "hello\n"
  },
  "out": {
    "sum": 3
  }
}
