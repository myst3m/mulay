%%% note
dw::test::Tests の describedBy と in: OK・FAIL・ERROR (fail と 0 での割り算)・SKIP (.^skip と @Skip の理由)、入れ子の suite、テストの location。time は伏せる (実 DW で記録)。
%%% mask
"time": ([0-9]+)
%%% script
%dw 2.0
import * from dw::test::Tests
import * from dw::test::Asserts
import fail from dw::Runtime
output application/json
fun clean(r) = r mapObject (v, k) -> if (k as String == "location") {} else if (k as String == "tests") {(k): (v as Array) map clean($)} else {(k): v}
---
clean(
"Calc" describedBy [
  "adds" in do {
    (1 + 1) must equalTo(2)
  },
  "fails" in do {
    1 must equalTo(2)
  },
  "many" in [
    1 must beNumber(),
    "x" must beNumber()
  ],
  "errors" in do {
    fail("boom") must equalTo(1)
  },
  "divides" in do {
    (1 / 0) must equalTo(1)
  },
  "Inner" describedBy [
    "inner ok" in do { [1] must haveSize(1) }
  ],
  @Skip(reason = "not yet") "skipped" in do { 1 must equalTo(1) },
  @Skip() "skipped plain" in do { 1 must equalTo(1) }
]
)
%%% output application/json
{
  "name": "Calc",
  "time": 66,
  "status": "OK",
  "tests": [
    {
      "name": "adds",
      "time": 14,
      "status": "OK",
      "errorMessage": ""
    },
    {
      "name": "fails",
      "time": 3,
      "status": "FAIL",
      "errorMessage": "Expected value to be 2 but was 1 at (root). From `1 must equalTo(2)` at line 14 of anonymous.dwl."
    },
    {
      "name": "many",
      "time": 0,
      "status": "FAIL",
      "errorMessage": "Expected value to be Number type but was String. From `\"x\" must beNumber()` at line 18 of anonymous.dwl."
    },
    {
      "name": "errors",
      "status": "ERROR",
      "time": 2,
      "errorMessage": "UserException:boom at:\n\n50| fun fail (message: String = 'Error'): Nothing = native(\"system::fail\")\n                                                    ^^^^^^^^^^^^^^^^^^^^^^"
    },
    {
      "name": "divides",
      "status": "ERROR",
      "time": 0,
      "errorMessage": "DivisionByZeroException:Division by zero at:\n\n24|     (1 / 0) must equalTo(1)\n         ^^^^^"
    },
    {
      "name": "Inner",
      "time": 3,
      "status": "OK",
      "tests": [
        {
          "name": "inner ok",
          "time": 1,
          "status": "OK",
          "errorMessage": "Expected size 1 but was 1. From `\"inner ok\" in do { [1] must haveSize(1) }` at line 27 of anonymous.dwl."
        }
      ]
    },
    {
      "name": "skipped",
      "time": 1,
      "status": "OK",
      "errorMessage": ""
    },
    {
      "name": "skipped plain",
      "time": 1,
      "status": "OK",
      "errorMessage": ""
    }
  ]
}
