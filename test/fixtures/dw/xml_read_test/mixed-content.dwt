%%% note
要素の間のテキストは __text になる。注釈をまたぐテキストもつなぐ。CDATA の印
%%% script
%dw 2.0
output application/dw
---
payload
%%% input payload application/xml
<r>a<!--x-->b<k>1</k> <![CDATA[c]]>d<k>2</k>  </r>
%%% output application/dw
{
  r: {
    "__text": "ab",
    k: "1",
    "__text": "cd" as String {cdata: true},
    k: "2"
  }
} as Object {encoding: "UTF-8", mediaType: "application/xml"}
