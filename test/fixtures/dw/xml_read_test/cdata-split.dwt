%%% note
CDATA とテキストが混ざった葉
%%% script
%dw 2.0
output application/dw
---
payload
%%% input payload application/xml
<r><a>x<![CDATA[<y>]]>z</a><b><![CDATA[]]></b></r>
%%% output application/dw
{
  r: {
    a: "x<y>z" as String {cdata: true},
    b: null
  }
} as Object {encoding: "UTF-8", mediaType: "application/xml"}
