%%% note
由来: mulet test/mulet/exchange_patterns_test.clj:69 (analytics-modes-test)
testing: modes via frequencies + maxBy + filter
元の形: DW スクリプト
mulet: 成功
%%% script
%dw 2.0
output application/json
fun frequencies(values) = do {
  var uniques = values distinctBy $
---
  uniques map {
    value: $,
    occurrences: sizeOf(values find $)
  }
}
fun modes(values) = do {
  var freq = frequencies(values)
  var maxOcc = freq map $.occurrences maxBy $
  ---
  freq filter ($.occurrences == maxOcc) map $.value
}
---
modes(["a","b","c","a","b"])
%%% output application/json
[
  "a",
  "b"
]
