%%% note
由来: mulet test/mulet/exchange_patterns_test.clj:94 (json-to-xml-nested-map-test)
testing: Nested map with spread for XML generation
元の形: DW スクリプト
mulet: 成功
%%% script
%dw 2.0
output application/xml
---
employees: {
  ([{name: "John", lastName: "Doe"}, {name: "Jane", lastName: "Smith"}] map {
    employee: {
      name: $.name,
      lastName: $.lastName
    }
  })
}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<employees>
  <employee>
    <name>John</name>
    <lastName>Doe</lastName>
  </employee>
  <employee>
    <name>Jane</name>
    <lastName>Smith</lastName>
  </employee>
</employees>
