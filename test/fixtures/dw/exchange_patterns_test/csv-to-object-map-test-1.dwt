%%% script
%dw 2.0
output application/json
---
payload map {
  FirstName: $.firstname,
  LastName: $.surname,
  Email: $.email
}
%%% input payload application/json
[{"firstname": "John", "surname": "Doe", "email": "john@test.com"}, {"firstname": "Jane", "surname": "Smith", "email": "jane@test.com"}]
%%% output application/json
[
  {
    "FirstName": "John",
    "LastName": "Doe",
    "Email": "john@test.com"
  },
  {
    "FirstName": "Jane",
    "LastName": "Smith",
    "Email": "jane@test.com"
  }
]
