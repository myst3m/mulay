%%% note
由来: mulet test/mulet/exchange_patterns_test.clj:113 (json-to-xml-nested-addresses-test)
testing: Deeply nested spread (addresses within employees)
元の形: DW スクリプト
mulet: 成功
%%% script
%dw 2.0
output application/xml
var data = {employees: {employee: [{name: "John", addresses: {address: ["123 Main", "456 Oak"]}}, {name: "Jane", addresses: {address: ["789 Elm"]}}]}}
---
employees: {
  (data.employees.employee map {
    employee: {
      name: $.name,
      addresses: {
        ($.addresses.address map {
          address: $
        })
      }
    }
  })
}
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<employees>
  <employee>
    <name>John</name>
    <addresses>
      <address>123 Main</address>
      <address>456 Oak</address>
    </addresses>
  </employee>
  <employee>
    <name>Jane</name>
    <addresses>
      <address>789 Elm</address>
    </addresses>
  </employee>
</employees>
