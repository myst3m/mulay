%%% note
由来: mulet test/mulet/exchange_patterns_test.clj:36 (analytics-frequencies-test)
testing: frequencies using distinctBy + find
元の形: DW スクリプト
mulet: 成功
%%% script
%dw 2.0
output application/json
fun frequencies(values) = do {
  var uniques = values distinctBy $
---
  uniques map {
    value: $,
    occurrences: sizeOf(values find $)
  }
}
---
frequencies([1, 2, 11, 1, 1, 2])
%%% output application/json
[
  {
    "value": 1,
    "occurrences": 3
  },
  {
    "value": 2,
    "occurrences": 2
  },
  {
    "value": 11,
    "occurrences": 1
  }
]
