%%% note
由来: mulet test/mulet/exchange_patterns_test.clj:632 (dynamic-xml-with-map-test)
testing: Dynamic XML generation with parenthesized map
元の形: DW スクリプト
mulet: 成功
%%% script
%dw 2.0
output application/xml
---
employees: {
  (payload map {
    employee: {
      name: $.name
    }
  })
}
%%% input payload application/json
[{"name": "Alice"}, {"name": "Bob"}]
%%% output application/xml
<?xml version='1.0' encoding='UTF-8'?>
<employees>
  <employee>
    <name>Alice</name>
  </employee>
  <employee>
    <name>Bob</name>
  </employee>
</employees>
