%%% script
%dw 2.0
output application/json
---
{
  payment: (round(1.17 * (payload.amount as Number) / (payload.term as Number) * 100)) / 100,
  currency: "EUR"
}
%%% input payload application/json
{"amount": "10000", "term": "12"}
%%% output application/json
{
  "payment": 975,
  "currency": "EUR"
}
