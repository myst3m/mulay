%%% note
ordinalize は負の数でも mod (割られる数の符号) で末尾を決める
%%% script
%dw 2.0
import ordinalize from dw::core::Strings
output application/json
---
[-1, -2, -3, -4, -9, -11, -12, -13, -21, -22, -101, -111, -112] map ordinalize($)
%%% output application/json
[
  "-1th",
  "-2th",
  "-3th",
  "-4th",
  "-9th",
  "-11th",
  "-12th",
  "-13th",
  "-21th",
  "-22th",
  "-101th",
  "-111th",
  "-112th"
]
