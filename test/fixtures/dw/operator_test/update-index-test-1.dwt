%%% note
由来: mulet test/mulet/operator_test.clj:255 (update-index-test)
testing: Update array element by index
元の形: DW スクリプト
mulet: 成功
%%% script
%dw 2.0
output application/json
---
payload update {
  case .addresses[0] -> {street: "Second Street", zipCode: "ZZ123"}
}
%%% input payload application/json
{"name": "Ken", "addresses": [{"street": "Amenabar", "zipCode": "AB1234"}]}
%%% output application/json
{
  "name": "Ken",
  "addresses": [
    {
      "street": "Second Street",
      "zipCode": "ZZ123"
    }
  ]
}
