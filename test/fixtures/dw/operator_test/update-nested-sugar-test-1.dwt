%%% note
由来: mulet test/mulet/operator_test.clj:240 (update-nested-sugar-test)
testing: Update nested field with sugar syntax
元の形: DW スクリプト
mulet: 成功
%%% script
%dw 2.0
output application/json
---
{name: "Ken", age: 30, address: {street: "Amenabar", zipCode: "AB1234"}} update {
  case .age -> $ + 1
  case .address.street -> "First Street"
}
%%% output application/json
{
  "name": "Ken",
  "age": 31,
  "address": {
    "street": "First Street",
    "zipCode": "AB1234"
  }
}
