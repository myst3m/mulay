%%% note
mod は割られる数の符号を持つ (Java の剰余)。Int の速い道と、Long に収まらない数の道の両方
%%% script
%dw 2.0
output application/json
---
{
  ints: [-7 mod 3, 7 mod -3, -7 mod -3, -6 mod 3, 0 mod -5, -1 mod 1000000007],
  big: [-92233720368547758071 mod 7, 92233720368547758071 mod -7],
  dec: [-7.5 mod 2, 7.5 mod -2],
  odd: [-3, -2, 3] map (($ mod 2) == 1)
}
%%% output application/json
{
  "ints": [
    -1,
    1,
    -1,
    0,
    0,
    -1
  ],
  "big": [
    -1,
    1
  ],
  "dec": [
    -1.5,
    1.5
  ],
  "odd": [
    false,
    false,
    true
  ]
}
