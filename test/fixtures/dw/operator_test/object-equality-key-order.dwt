%%% note
Object の == はキーの順も比べる ({a: 1, b: 2} == {b: 2, a: 1} は false)。同じ名前のキーの数と順、入れ子も同じ (実 DW で記録)。
%%% script
%dw 2.0
output application/json
---
{
  reorder: {a: 1, b: 2} == {b: 2, a: 1},
  nested: {x: {a: 1, b: [1, {c: 1, d: 2}]}} == {x: {b: [1, {d: 2, c: 1}], a: 1}},
  dupSame: {a: 1, a: 2} == {a: 1, a: 2},
  dupSwap: {a: 1, a: 2} == {a: 2, a: 1},
  dupCount: {a: 1, a: 1} == {a: 1},
  extra: {a: 1} == {a: 1, b: 2},
  neq: {a: 1, b: 2} != {b: 2, a: 1},
  arr: [1, 2] == [2, 1],
  mixed: {a: 1, b: 2} == {b: 2, a: 1.0}
}
%%% output application/json
{
  "reorder": false,
  "nested": false,
  "dupSame": true,
  "dupSwap": false,
  "dupCount": false,
  "extra": false,
  "neq": true,
  "arr": false,
  "mixed": false
}
