%%% note
由来: mulet test/mulet/operator_test.clj:268 (update-upsert-test)
testing: Upsert with ! — insert if missing
元の形: DW スクリプト
mulet: 成功
%%% script
%dw 2.0
output application/json
var myInput = [{lastName: "Doe"}, {lastName: "Parker", name: "Peter"}]
---
myInput map ((value) ->
  value update {
    case name at .name! -> if(name == null) "JOHN" else (upper(name))
  }
)
%%% output application/json
[
  {
    "lastName": "Doe",
    "name": "JOHN"
  },
  {
    "lastName": "Parker",
    "name": "PETER"
  }
]
