%%% note
由来: mulet test/mulet/operator_test.clj:262 (update-conditional-test)
testing: Conditional update based on value
元の形: DW スクリプト
mulet: 成功
%%% script
%dw 2.0
output application/json
---
payload map ((user) ->
  user update {
    case name at .name if(name == "Ken") -> name ++ " (Leandro)"
    case name at .name if(name == "Tomo") -> name ++ " (Christian)"
  }
)
%%% input payload application/json
[{"name": "Ken", "age": 30}, {"name": "Tomo", "age": 70}, {"name": "Kajika", "age": 10}]
%%% output application/json
[
  {
    "name": "Ken (Leandro)",
    "age": 30
  },
  {
    "name": "Tomo (Christian)",
    "age": 70
  },
  {
    "name": "Kajika",
    "age": 10
  }
]
