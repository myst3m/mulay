%%% note
repeat / leftPad / rightPad の回数が大きすぎれば失敗する (実 DW は Java の配列の上限で "Requested array size exceeds VM limit")。
mulay は 128MB で同じ文言にする (確保に失敗するとプロセスごと終わるため。docs/compat/deviations.md)。
%%% script
%dw 2.0
import * from dw::core::Strings
import try from dw::Runtime
output application/json
var msg = "Requested array size exceeds VM limit"
fun failed(f) = try(f) then ((not $.success) and (($.error.message default "") contains msg))
---
{
  repeat: failed(() -> sizeOf(repeat("ab", 3000000000))),
  left: failed(() -> sizeOf(leftPad("x", 3000000000))),
  right: failed(() -> sizeOf(rightPad("x", 3000000000, "yz"))),
  small: repeat("ab", 2.7) ++ "|" ++ leftPad("x", 3) ++ "|" ++ rightPad("x", 3, "-")
}
%%% output application/json
{
  "repeat": true,
  "left": true,
  "right": true,
  "small": "abab|  x|x--"
}
