(ns commons-order-test (:require [mulay.lib.jhash :as jh]))

;; 期待値は tools/gen-commons-order.java (commons-collections4 4.4 の CaseInsensitiveMap)

(deftest commons-order
  (is (= (jh/commons-order ["content-type" "soapaction"]) ["content-type" "soapaction"]))
  (is (= (jh/commons-order ["content-type" "soapaction" "x-static" "soapaction"]) ["x-static" "content-type" "soapaction"]))
  (is (= (jh/commons-order ["content-type" "soapaction" "x-expr" "content-type"]) ["content-type" "x-expr" "soapaction"]))
  (is (= (jh/commons-order ["Content-Type" "SOAPAction" "X-Static"]) ["x-static" "content-type" "soapaction"]))
  (is (= (jh/commons-order ["a" "b" "c" "d" "e" "f" "g" "h" "i" "j" "k" "l" "m" "n" "o" "p" "q" "r"]) ["o" "d" "k" "r" "c" "h" "p" "g" "l" "q" "b" "i" "m" "a" "f" "j" "n" "e"]))
  (is (= (jh/commons-order ["authorization" "x-correlation-id" "accept-language" "cache-control" "x-api-key" "cookie" "if-none-match" "user-agent" "x-forwarded-for" "origin" "referer" "content-length" "x-request-id" "pragma"]) ["x-forwarded-for" "if-none-match" "referer" "pragma" "x-api-key" "cookie" "origin" "authorization" "content-length" "cache-control" "x-correlation-id" "accept-language" "user-agent" "x-request-id"])))
