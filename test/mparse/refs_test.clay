(ns refs-test (:require [mulay.mule.parse :as ps]))

;; 式が参照する入力 (output の推論と payload の遅延 parse に使う)
(deftest input-refs
  (is (= (ps/refs "payload") ["payload"]))
  (is (= (ps/refs "vars.acc + payload") ["vars" "vars.acc" "payload"]))
  (is (= (ps/refs "'name=' ++ payload.name") ["payload"]))
  (is (= (ps/refs "{payload: 1, x: attributes.method}") ["attributes"]))
  (is (= (ps/refs "\"a $(vars.x) b $payload\"") ["vars" "vars.x" "payload"]))
  (is (= (ps/refs "// payload\n1 /* vars */") []))
  (is (= (ps/refs "$.payload") []))
  (is (= (ps/refs "p.^mimeType ++ x.@payload") []))
  ;; 変数の名前は "vars.名前" でも数える。p(..) の呼び出しは "p()" (実 Mule は Java の入力として扱う)
  (is (= (ps/refs "vars.a ++ vars.b ++ vars.a") ["vars" "vars.a" "vars.b"]))
  (is (= (ps/refs "vars[\"a\"]") ["vars"]))
  (is (= (ps/refs "p('x') ++ payload.id") ["p()" "payload"]))
  (is (= (ps/refs "p ('x')") ["p()"]))
  (is (= (ps/refs "p.a ++ \"p(1)\"") [])))
