(ns xmllines-test (:require [mulay.lib.xml :as xml]))
(deftest lines
  (let [[d ls err] (xml/parse-with-lines "<?xml version=\"1.0\"?>\n<!-- c -->\n<a>\n  <b x=\"1\"\n     y=\"2\"/>\n  <c><d/>\n<e/></c>text<f/></a>" (xml/default-opts))]
    (is (= err ""))
    (is (= (:line ls) 3))
    (is (= (count (:kids ls)) 3))
    (is (= (:line (nth (:kids ls) 0)) 4))
    (is (= (:line (nth (:kids ls) 1)) 6))
    (is (= (:line (nth (:kids (nth (:kids ls) 1)) 0)) 6))
    (is (= (:line (nth (:kids (nth (:kids ls) 1)) 1)) 7))
    (is (= (:line (nth (:kids ls) 2)) 7))
    (is (= (count (xml/child-elems (xml/doc-root d))) 3))))
(deftest lines-first-line
  (let [[d ls err] (xml/parse-with-lines "<a><b/></a>" (xml/default-opts))]
    (is (= (:line ls) 1))
    (is (= (:line (nth (:kids ls) 0)) 1))))
