(ns glob-test (:require [mulay.lib.glob :as g]))

(deftest literal-and-wildcards
  (is (g/glob-match "abc" "abc"))
  (is (not (g/glob-match "abc" "abcd")))
  (is (g/glob-match "*.txt" "d.txt"))
  (is (g/glob-match "*.txt" ".txt"))
  (is (not (g/glob-match "*.txt" "d.txt.bak")))
  (is (not (g/glob-match "*.txt" "a/d.txt")))
  (is (g/glob-match "**.txt" "a/d.txt"))
  (is (g/glob-match "*" ""))
  (is (g/glob-match "t*" "tree"))
  (is (g/glob-match "?.csv" "c.csv"))
  (is (not (g/glob-match "?.csv" "cc.csv")))
  (is (g/glob-match "?" "é"))
  (is (not (g/glob-match "?" "/"))))

(deftest classes-and-braces
  (is (g/glob-match "[abc].txt" "b.txt"))
  (is (not (g/glob-match "[abc].txt" "d.txt")))
  (is (g/glob-match "[a-c]x" "cx"))
  (is (g/glob-match "[!a-c]x" "dx"))
  (is (not (g/glob-match "[!a-c]x" "ax")))
  (is (g/glob-match "*.{json,xml}" "a.json"))
  (is (g/glob-match "*.{json,xml}" "b.xml"))
  (is (not (g/glob-match "*.{json,xml}" "c.csv")))
  (is (g/glob-match "{a*,b?}.x" "bq.x"))
  (is (g/glob-match "\\*" "*"))
  (is (not (g/glob-match "\\*" "a")))
  (is (not (g/glob-match "[ab" "a")))
  (is (not (g/glob-match "{a,b" "a"))))

(defn- rep Str [s: Str n: Int] (loop [i 0 out ""] (if (>= i n) out (recur (+ i 1) (str out s)))))

(deftest many-stars-stay-linear
  (let [pat (str (rep "*a" 30) "b")
        s (rep "a" 4000)]
    (is (not (g/glob-match pat s)))
    (is (g/glob-match pat (str s "b")))
    (is (not (g/glob-match (str (rep "{a,a*}" 25) "b") (rep "a" 3000))))
    (is (g/glob-match (str (rep "**/" 20) "x") (str (rep "d/" 500) "x")))))

(deftest braces-edge-cases
  (is (g/glob-match "{,a}x" "x"))
  (is (g/glob-match "{,a}x" "ax"))
  (is (g/glob-match "{a}" "a"))
  (is (g/glob-match "{a\\,b,c}" "a,b"))
  (is (g/glob-match "x{[ab],c?}y" "xby"))
  (is (g/glob-match "x{[ab],c?}y" "xcdy"))
  (is (not (g/glob-match "{a,{b}}" "b")))
  (is (not (g/glob-match "a\\" "a")))
  (is (g/glob-match "[é]" "é"))
  (is (not (g/glob-match "[/]" "/"))))
