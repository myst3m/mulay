(ns help-test (:require [mulay.cli.help :as h] [clay.string :as str]))

;; mulay の help の文面: 概要はすべてのコマンドを説明付きで並べ、コマンドごとの help は使い方・説明・例を持つ。

(deftest overview-lists-every-command
  (let [o (h/overview "0.1.0-dev")]
    (is (str/starts-with? o "mulay 0.1.0-dev - a lightweight Mule 4 runtime\n"))
    (is (str/includes? o "\nUsage: mulay <command> [arguments]\n"))
    (is (str/includes? o "\n  run       Run a Mule application"))
    (is (str/includes? o "\n  validate  "))
    (is (str/includes? o "\n  inspect   "))
    (is (str/includes? o "\n  dw        "))
    (is (str/includes? o "\n  build     "))
    (is (str/includes? o "\n  version   "))
    (is (str/includes? o "\n  help      "))
    ;; <app> の意味と共通オプション
    (is (str/includes? o "<app> is a project directory, a deployable .jar, or a single .xml file"))
    (is (str/includes? o "\n  -l LEVEL "))
    (is (str/includes? o "\n  key=value "))
    (is (str/includes? o "mulay help <command>"))
    ;; 内部用の dw-gen は出さない
    (is (not (str/includes? o "dw-gen")))))

(deftest command-help-has-usage-and-examples
  (let [r (h/command-help "run")
        b (h/command-help "build")
        d (h/command-help "dw")]
    (is (str/starts-with? r "Usage: mulay run [<app>] [key=value ...] [-l LEVEL]\n"))
    (is (str/includes? r "\nExamples:\n"))
    (is (str/includes? r "mulay run ./my-project http.port=8081"))
    (is (str/includes? r "current\ndirectory"))
    (is (str/starts-with? b "Usage: mulay build [<app>] -o <out> [key=value ...] [--encrypt -k <key>]\n"))
    (is (str/includes? b "clay and clang"))
    (is (str/includes? b "--encrypt"))
    (is (str/starts-with? d "Usage: mulay dw [--path <dir>]... <script.dwl> [name=mime:file ...]\n"))
    (is (str/includes? d "payload=application/json:in.json"))
    (is (not= (h/command-help "validate") ""))
    (is (not= (h/command-help "inspect") ""))
    (is (= (h/usage-line "inspect") "Usage: mulay inspect [<app>] [key=value ...] [--props | --json]"))
    (is (str/includes? (h/command-help "inspect") "--json"))
    (is (not= (h/command-help "version") ""))
    (is (not= (h/command-help "help") ""))
    (is (= (h/command-help "nope") ""))))

(deftest usage-line-is-the-first-line
  (let [u (h/usage-line "run") n (h/usage-line "nope")]
    (is (= u "Usage: mulay run [<app>] [key=value ...] [-l LEVEL]"))
    (is (= n "Usage: mulay <command> [arguments]"))))

(deftest embedded-help-names-the-executable
  (let [e (h/embedded-help "./my-app")]
    (is (str/starts-with? e "Usage: ./my-app [key=value ...] [-k <key>] [-l LEVEL]\n"))
    (is (str/includes? e "built with mulay build"))
    (is (str/includes? e "MULAY_KEY"))))
