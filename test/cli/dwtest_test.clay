(ns dwtest-test (:require [mulay.cli.dwtest :as dt] [mulay.dw.lib.runtime :as l-runtime] [mulay.dw.val :as v] [mulay.lib.fs :as fs] [clay.string :as str]))
(c-include "<unistd.h>")
(defextern getpid getpid)

(def SUITE "%dw 2.0\nimport * from dw::test::Tests\nimport * from dw::test::Asserts\n---\n\"S\" describedBy [\n  \"ok\" in do { 1 must equalTo(1) },\n  \"bad\" in do { 1 must equalTo(2) },\n  (\"skip\" <~ {skip: {reason: \"r\"}}) in do { 1 must equalTo(1) },\n  \"In\" describedBy [ \"deep\" in do { 2 must beNumber() } ]\n]\n")

(deftest runs-suites-and-reports
  (let [d (str "/tmp/mulay-dwtest-" (unsafe (getpid)))
        z0 (fs/remove-tree d)
        z1 (fs/mkdirs (str d "/sub"))
        w1 (write-file (str d "/STest.dwl") SUITE)
        w2 (write-file (str d "/sub/Mod.dwl") "%dw 2.0\nfun f() = 1\n")
        w3 (write-file (str d "/sub/NotATest.dwl") "%dw 2.0\n---\n{a: 1}\n")
        files (dt/test-files d)
        o (dt/run-file (str d "/STest.dwl") [] d)
        m (dt/run-file (str d "/sub/Mod.dwl") [] d)
        n (dt/run-file (str d "/sub/NotATest.dwl") [] d)
        [out green] (dt/report [o n] 1234 false)
        z2 (fs/remove-tree d)
        p (str d "/STest.dwl")
        q (str d "/sub/NotATest.dwl")
        ls (dt/leaves o)]
    (is (= (count files) 3))
    (is (= (:error o) ""))
    (is (= (count ls) 4))
    (is (= (:path (nth ls 3)) "S › In › deep"))
    (is (= (:status (nth ls 1)) "FAIL"))
    (is (str/starts-with? (:message (nth ls 1)) "Expected value to be 2 but was 1 at (root)."))
    (is (str/includes? (:message (nth ls 1)) (str " of " d "/STest.dwl.")))
    (is (= (:status (nth ls 2)) "SKIP"))
    (is (and (= (:error m) "") (= (count (dt/leaves m)) 0)))
    (is (str/includes? (:error n) "not a dw::test TestResult"))
    (is (not green))
    (is (str/starts-with? out (str p "\n  S\n    ✓ ok\n    ✗ bad\n    ○ skip (skipped: r)\n    In\n      ✓ deep\n" q "  ✗ error\n\nFailures\n\n✗ S › bad  (" p ")\n  Expected value to be 2 but was 1 at (root).")))
    (is (str/includes? out (str "\n\n✗ " q "\n  the script's result is not a dw::test TestResult")))
    (is (str/ends-with? out "\nFAILED  2 passed, 1 failed, 1 error, 1 skipped  (4 tests in 2 files, 1.234s)\n"))))

(deftest a-skipped-suite-is-one-row-and-a-green-run-says-ok
  (let [d (str "/tmp/mulay-dwtest-skip-" (unsafe (getpid)))
        z0 (fs/remove-tree d)
        z1 (fs/mkdirs d)
        w1 (write-file (str d "/T.dwl") "%dw 2.0\nimport * from dw::test::Tests\nimport * from dw::test::Asserts\n---\n\"A\" describedBy [\n  (\"B\" <~ {skip: {reason: \"later\"}}) describedBy [\"x\" in do { 1 must equalTo(1) }, \"y\" in do { 1 must equalTo(1) }],\n  \"z\" in do { 1 must equalTo(1) }\n]\n")
        o (dt/run-file (str d "/T.dwl") [] d)
        [out green] (dt/report [o] 5 false)
        z2 (fs/remove-tree d)]
    (is green)
    (is (= out (str d "/T.dwl\n  A\n    ○ B (skipped: later, 2 tests)\n    ✓ z\n\nok  1 passed, 0 failed, 0 errors, 2 skipped  (3 tests in 1 file, 0.005s)\n")))))

(deftest a-compile-error-names-the-file-and-the-line
  (let [d (str "/tmp/mulay-dwtest-bad-" (unsafe (getpid)))
        z0 (fs/remove-tree d)
        z1 (fs/mkdirs d)
        w1 (write-file (str d "/T.dwl") "%dw 2.0\nimport * from dw::test::Tests\n---\n\"A\" describedBy [\n  \"x\" in do { nope(1) }\n]\n")
        o (dt/run-file (str d "/T.dwl") [] d)
        z2 (fs/remove-tree d)]
    (is (str/includes? (:error o) (str d "/T.dwl:5:")))
    (is (str/includes? (:error o) "nope"))))

(deftest eval-path-reads-the-script-from-the-module-roots
  (let [d (str "/tmp/mulay-dwtest-eval-" (unsafe (getpid)))
        z0 (fs/remove-tree d)
        z1 (fs/mkdirs (str d "/src"))
        z2 (fs/mkdirs (str d "/res/c1/inputs"))
        w1 (write-file (str d "/src/Sum.dwl") "%dw 2.0\noutput application/json\n---\n{sum: payload.a + 1}\n")
        w2 (write-file (str d "/res/c1/inputs/payload.json") "{\"a\": 2}")
        w3 (write-file (str d "/res/c1/out.json") "{\"sum\": 3}")
        w4 (write-file (str d "/T.dwl") "%dw 2.0\nimport * from dw::test::Tests\nimport * from dw::test::Asserts\n---\n\"S\" describedBy [\"sum\" in do { evalPath(\"Sum.dwl\", inputsFrom(\"c1\"), \"application/json\") must equalTo(outputFrom(\"c1\")) }]\n")
        zp (l-runtime/set-sys-props! [(v/field "dwtestResources" (v/->VStr (str d "/res")))])
        o (dt/run-file (str d "/T.dwl") [(str d "/src")] d)
        zq (l-runtime/set-sys-props! [])
        z3 (fs/remove-tree d)]
    (is (= (:error o) ""))
    (is (= (count (dt/leaves o)) 1))
    (is (= (:status (nth (dt/leaves o) 0)) "OK"))))
