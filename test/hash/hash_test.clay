;; 100 万バイト ("a" の繰り返し、FIPS 180 の例)。ブロックを何度も回す
(defn- million Str [] (loop [i 0 out ""] (if (>= i 1000000) out (recur (+ i 1) (str out "a")))))
(deftest million-a
  (is (= (d "SHA1" (million)) "34aa973cd4c4daa4f61eeb2bdbad27316534016f"))
  (is (= (d "SHA256" (million)) "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0"))
  (is (= (d "SHA512" (million)) "e718483d0ce769644e2e42c7bc15b4638e1f98b13b2044285632a803afa973ebde0ff244877ea60a4cb0432ce577c31beb009c5c2c49aa2e4eadb217ad8cc09b"))
  (is (= (d "SHA3-256" (million)) "5c8875ae474a3634ba4fd55ec85bffd661f32aca75c6d699d0cdcb6c115891c1"))
  (is (= (d "MD5" (million)) "7707d6ae4e027c70eea2a935c2296f21")))

(deftest names
  (is (= (d "SHA999" "x") "FAIL"))
  (is (= (d "" "x") "FAIL"))
  (is (= (d "sha256" "x") "FAIL"))
  (is (= (h/block-size "MD5") 64))
  (is (= (h/block-size "SHA1") 64))
  (is (= (h/block-size "SHA224") 64))
  (is (= (h/block-size "SHA256") 64))
  (is (= (h/block-size "SHA384") 128))
  (is (= (h/block-size "SHA512") 128))
  (is (= (h/block-size "SHA512-224") 128))
  (is (= (h/block-size "SHA512-256") 128))
  (is (= (h/block-size "SHA3-224") 144))
  (is (= (h/block-size "SHA3-256") 136))
  (is (= (h/block-size "SHA3-384") 104))
  (is (= (h/block-size "SHA3-512") 72))
  (is (= (h/block-size "SHA999") 0)))

;; 途中の状態から続ける入口 (start / feed / finish) は、一度に計算した値と同じになる。
;; 長さ 300 の入力を cuts の位置で切って、順に feed する
(defn- in-pieces Str [name: Str data: Str cuts: Vec(Int)]
  (let [[s0 ok] (h/start name)
        n (count cuts)
        s (loop [i 0 prev 0 st: h/State s0]
            (if (> i n) st
              (let [end (if (= i n) (count data) (nth cuts i))] (recur (+ i 1) end (h/feed st (subs data prev end))))))]
    (if ok (hex (h/finish s)) "FAIL")))

(defn- same-in-pieces Bool [name: Str]
  (let [data (pat 300)
        whole (d name data)
        cutss: Vec(Vec(Int)) [[] [0] [1] [63 64] [64 128 192] [100 136 137 271] [127 128 129] [5 6 7 8 9 10] [72 144 216 288] [299] [300]]]
    (loop [i 0] (if (>= i (count cutss)) true (if (= (in-pieces name data (nth cutss i)) whole) (recur (+ i 1)) false)))))

(deftest streaming
  (is (same-in-pieces "MD5"))
  (is (same-in-pieces "SHA1"))
  (is (same-in-pieces "SHA224"))
  (is (same-in-pieces "SHA256"))
  (is (same-in-pieces "SHA384"))
  (is (same-in-pieces "SHA512"))
  (is (same-in-pieces "SHA512-224"))
  (is (same-in-pieces "SHA512-256"))
  (is (same-in-pieces "SHA3-224"))
  (is (same-in-pieces "SHA3-256"))
  (is (same-in-pieces "SHA3-384"))
  (is (same-in-pieces "SHA3-512"))
  (is (= (in-pieces "SHA999" "x" []) "FAIL")))

;; HMAC (RFC 2104)。期待値は Python の hmac。鍵は短いもの、空、ブロック長ちょうど、ブロック長 ± 1、131 バイト (RFC 4231 の
;; 「ブロックより長い鍵」と同じ長さ)。鍵の列は (11i + 5) mod 256、入力の列は pat
(defn- pat2 Str [n: Int] (loop [i 0 out ""] (if (>= i n) out (recur (+ i 1) (str out (chr (mod (+ (* i 11) 5) 256)))))))
(defn- mac Str [name: Str key: Str data: Str] (let [[x ok] (h/hmac name key data)] (if ok (hex x) "FAIL")))

(deftest hmac-md5
  (is (= (mac "MD5" "key" "The quick brown fox jumps over the lazy dog") "80070713463e7749b90c2dc24911e275"))
  (is (= (mac "MD5" "" "") "74e6f7298a9c2d168935f58c001bad88"))
  (is (= (mac "MD5" (pat2 63) (pat 0)) "fb90af1f4c9fca8dc93d0aeeb17f4dea"))
  (is (= (mac "MD5" (pat2 63) (pat 50)) "3e8335a5e3e8861bf6f2c045df8affca"))
  (is (= (mac "MD5" (pat2 63) (pat 200)) "78255d57d5f3bfd55e36d217d6d2e2a5"))
  (is (= (mac "MD5" (pat2 64) (pat 0)) "fb7dff29118497efb6eb24ee9782e9ec"))
  (is (= (mac "MD5" (pat2 64) (pat 50)) "bba5ded6ec6c34506d02ccdd5ff6639a"))
