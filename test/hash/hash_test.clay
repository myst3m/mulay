(ns hash-test (:require [mulay.lib.hash :as h]))

;; 期待値は Python 3 の hashlib (OpenSSL)。入力は "" と "abc" と FIPS 180 の 2 つの例文、それに長さ n の
;; 決まった列 (i 番目のバイトが (7i + 3) mod 256)。n はブロックの境目 (詰め物が 1 ブロックに収まるかどうか、
;; SHA-3 は rate の前後) を選んだ

(defn- hex Str [raw: &Str]
  (let [d "0123456789abcdef"]
    (loop [i 0 out ""] (if (>= i (count raw)) out
      (let [b (nth raw i)] (recur (+ i 1) (str out (subs d (bit-shift-right b 4) (+ (bit-shift-right b 4) 1)) (subs d (bit-and b 15) (+ (bit-and b 15) 1)))))))))

(defn- pat Str [n: Int] (loop [i 0 out ""] (if (>= i n) out (recur (+ i 1) (str out (chr (mod (+ (* i 7) 3) 256)))))))

(defn- d Str [name: Str data: Str] (let [[x ok] (h/digest name data)] (if ok (hex x) "FAIL")))
(defn- dp Str [name: Str n: Int] (d name (pat n)))

(deftest t-md5
  (is (= (d "MD5" "") "d41d8cd98f00b204e9800998ecf8427e"))
  (is (= (d "MD5" "abc") "900150983cd24fb0d6963f7d28e17f72"))
  (is (= (d "MD5" "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq") "8215ef0796a20bcaaae116d3876c664a"))
  (is (= (d "MD5" "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu") "03dd8807a93175fb062dfb55dc7d359c"))
  (is (= (dp "MD5" 1) "8666683506aacd900bbd5a74ac4edf68"))
  (is (= (dp "MD5" 55) "52c0e574e1198de5fe3f8f11440dcb1b"))
  (is (= (dp "MD5" 56) "46c9907fc908ee68b1e7b8e71286a518"))
  (is (= (dp "MD5" 63) "a62f6d59e837867693f042f5b8f5a236"))
  (is (= (dp "MD5" 64) "7160b8fb5e9e4023d549c3971fbaeead"))
  (is (= (dp "MD5" 65) "70bd662e7aefbda85a0f7244167b7897"))
  (is (= (dp "MD5" 71) "26e7e113db273c68b0fc3ce4660fc5e2"))
  (is (= (dp "MD5" 72) "f9019e69c0b288ca2b635cfa0de38932"))
  (is (= (dp "MD5" 103) "a196bddcad45f15e5b5ecc17715a38fd"))
  (is (= (dp "MD5" 104) "a55daca3482d9d27a7ad621b73060dd4"))
  (is (= (dp "MD5" 111) "13f00cb15f0c3fe588d1c17cde14b38f"))
  (is (= (dp "MD5" 112) "5fe6a9f76b541ec645559589da9a088a"))
  (is (= (dp "MD5" 119) "e84905d4214f4d1ca56c2cdcc152b143"))
  (is (= (dp "MD5" 120) "e3eb5a6c8669ea01a8c185b8abc8a5dc"))
  (is (= (dp "MD5" 127) "acce2474d6cc8302120d09c818d17ef7"))
  (is (= (dp "MD5" 128) "10b2da1a82f16d99a81a7203fe9f02cb"))
  (is (= (dp "MD5" 129) "03fefbbcebe2959cf2270241aafe0250"))
  (is (= (dp "MD5" 135) "3f60e7e290ce1e941cfa3fd7fc031695"))
  (is (= (dp "MD5" 136) "cd62db9573f2e9e2dc335b7b91f4ccfa"))
  (is (= (dp "MD5" 143) "2f7b531ae2a3ff58936c601d0b5a3cd2"))
  (is (= (dp "MD5" 144) "00a6351f7b12333eacdd669528b87221"))
  (is (= (dp "MD5" 145) "d1dedaaf7588d23f338f0802a1a3dba2"))
