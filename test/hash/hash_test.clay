(deftest hmac-names (is (= (mac "SHA999" "k" "x") "FAIL")))

;; PBKDF2 (RFC 8018)。RFC 6070 の SHA-1 の例 (16777216 回のものは除く) と、hashlib.pbkdf2_hmac の値。
;; 出力が要約の長さを超える (ブロックを 2 つ以上つなぐ) もの、要約が状態より短いもの (SHA-224、SHA-384、
;; SHA-512/224 は語の途中で切れる、SHA-512/256、SHA3-224)。回数や長さが 0 以下のものは失敗
(defn- pbk Str [name: Str pwd: Str salt: Str it: Int n: Int] (let [[x ok] (h/pbkdf2 name pwd salt it n)] (if ok (hex x) "FAIL")))
(deftest pbkdf2
  (is (= (pbk "SHA1" "password" "salt" 1 20) "0c60c80f961f0e71f3a9b524af6012062fe037a6"))
  (is (= (pbk "SHA1" "password" "salt" 2 20) "ea6c014dc72d6f8ccd1ed92ace1d41f0d8de8957"))
  (is (= (pbk "SHA1" "password" "salt" 4096 20) "4b007901b765489abead49d926f721d065a429c1"))
  (is (= (pbk "SHA1" "passwordPASSWORDpassword" "saltSALTsaltSALTsaltSALTsaltSALTsalt" 4096 25) "3d2eec4fe41c849b80c8d83662c0e44a8b291a964cf2f07038"))
  (is (= (pbk "SHA256" "password" "salt" 1 32) "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b"))
  (is (= (pbk "SHA256" "password" "salt" 4096 32) "c5e478d59288c841aa530db6845c4c8d962893a001ce4e11a4963873aa98134a"))
  (is (= (pbk "SHA256" "password" "salt" 3 100) "ad35240ac683febfaf3cd49d845473fbbbaa2437f5f82d5a415ae00ac76c6bfccf9a9b8d6d2fe4a1e700c4460b040dbed692c1cb85a747f35588c08930fcfc41ac48082086069b111a9c752f1856237f3af8adc86757f26c60870d3eb52a7c2060c3749b"))
  (is (= (pbk "SHA512" "password" "salt" 1 64) "867f70cf1ade02cff3752599a3a53dc4af34c7a669815ae5d513554e1c8cf252c02d470a285a0501bad999bfe943c08f050235d7d68b1da55e63f73b60a57fce"))
  (is (= (pbk "SHA512" "password" "salt" 4096 32) "d197b1b33db0143e018b12f3d1d1479e6cdebdcc97c5c0f87f6902e072f457b5"))
  (is (= (pbk "SHA512" "" "salt" 2 16) "cc5eacbb057f2a5982fce67bf70f79fc"))
  (is (= (pbk "MD5" "pw" "s" 10 40) "79a9efe5e382260384552b665fd51414188c90224fb16396ed2a22dd1827edf18c20469b0355c755"))
  (is (= (pbk "SHA3-256" "pw" "s" 10 40) "705c5b3482b6d564b1a11b072e1ade4fafbff756809b3d5d46989ce560eff7d700394c3666800284"))
  (is (= (pbk "SHA224" "pw" "salt" 7 100) "db00c3f2c0aed61d6a27b4ca8b9a32d0e64bb26837f978f0cd52f91ad8d540be4c2bc10def99545dd7a39c00f4b55b1736646b169f9ff2d5286c3ac7eebd0a15074d1399f82623be2ba2b2568a936866e4d8f89ec58aadeabd4be97a52c58f2815c3ca79"))
  (is (= (pbk "SHA384" "pw" "salt" 7 100) "559e4ff98d417da2c6d759130b998a2f63ffc967c2b8aeec1a9d4eac7efe38065a450d63ac20f5f3215e91cc4197d68434c40bc3ad5a3eee1c9c78fafaddde6fd161c9e4b081374b87df56553f869273dccf2507849a9714223e81f9909b8b521dfdd459"))
  (is (= (pbk "SHA512-224" "pw" "salt" 7 100) "f9cedeee0ed5a5199fad6a4cccef4c1377fe105c1d16c0cc4a88ca477903b789c4c57b04928c6fafbf131267f1562ae4b0aa086d67c8f3961a1c8de1da33fbd983d4cf8a0e96897c583f7b447c52b429189cb7d90f34454d4e983c03010fa6f02cea0f1f"))
  (is (= (pbk "SHA512-256" "pw" "salt" 7 100) "b6e8c21e185c9c5e2428fd16352ff774a223dcea49939d832620010d74d0aa0c5724072b549a8a4e50867ba6a1e21aee1de11acb29c2d4e835bbd2e93719d31356cceb300b807ab482cb9931715926118120e2695bb58dbc5dfd897f0b063c89abf52e70"))
  (is (= (pbk "SHA3-224" "pw" "salt" 7 100) "ccc14e44359c8b38754060dbfcb61c50501068ed8a4c889255efab14833a8932a3cd7a2c98a7da45180769d0bf045afb8ce4254d37d255a542c33664c6ec685c3059c094e517003e6d40f89481c8988169494097b7a4687c9817d770c6367692b22d8514"))
  (is (= (pbk "SHA1" "password" "salt" 0 20) "FAIL"))
  (is (= (pbk "SHA1" "password" "salt" 1 0) "FAIL"))
  (is (= (pbk "SHA999" "password" "salt" 1 20) "FAIL")))
