(ns jmx-test (:require [mulay.conn.jmx :as jmx]))

;; jmx のログの操作の部品。操作そのものは test/fixtures/apps/jmx-logs (実モジュールの記録) で確かめる。

(deftest log-dir-is-normalized-like-paths-get
  (is (= (jmx/norm-path "/tmp//logs/") "/tmp/logs"))
  (is (= (jmx/norm-path "/") "/"))
  (is (= (jmx/norm-path "logs") "logs"))
  (is (= (jmx/norm-path "a///b//c") "a/b/c")))

(deftest file-names-that-leave-the-log-dir-are-refused
  (is (jmx/escapes? "/etc/passwd"))
  (is (jmx/escapes? "../secret.log"))
  (is (jmx/escapes? "a/../../b"))
  (is (jmx/escapes? ".."))
  (is (not (jmx/escapes? "app.log")))
  (is (not (jmx/escapes? "sub/app.log")))
  (is (not (jmx/escapes? "a..b.log"))))

(deftest json-strings-are-escaped-like-the-module
  (is (= (jmx/esc "a\"b\\c\nd\te") "a\\\"b\\\\c\\nd\\te"))
  (is (= (jmx/esc (chr 1)) "\\u0001"))
  (is (= (jmx/esc "日本") "日本")))
