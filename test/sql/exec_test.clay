    (is (= (str "12 " (nth r 12)) "12 C:1:2"))
    (is (= (str "13 " (nth r 13)) "13 E:1:no such index: ix_a"))
    (is (= (str "14 " (nth r 14)) "14 C:1:2"))
    (is (= (str "15 " (nth r 15)) "15 Q:name|;T:6978;T:69785f62;T:69785f75"))
    (is (= (str "16 " (nth r 16)) "16 Q:b|;T:48656c6c6f;T:6f74686572"))
    (is (= (str "17 " (nth r 17)) "17 Q:b = 'hello'|;I:1;I:0"))
    (is (= (str "18 " (nth r 18)) "18 Q:b|;T:48656c6c6f;T:6f74686572"))
    (is (= (str "19 " (nth r 19)) "19 C:1:2"))
    (is (= (str "20 " (nth r 20)) "20 E:1:index associated with UNIQUE or PRIMARY KEY constraint cannot be dropped"))
