(deftest script-6
  (let [r (run ["CREATE TABLE ix (a INTEGER, b TEXT COLLATE NOCASE)"
                 "CREATE INDEX ix_a ON ix (a)"
                 "CREATE UNIQUE INDEX ix_b ON ix (b)"
                 "INSERT INTO ix VALUES (1, 'Hello')"
                 "INSERT INTO ix VALUES (2, 'HELLO')"
                 "INSERT INTO ix VALUES (2, 'other')"
                 "SELECT * FROM ix WHERE a = 2"
                 "CREATE INDEX ix_a ON ix (b)"
                 "CREATE INDEX IF NOT EXISTS ix_a ON ix (b)"
                 "CREATE INDEX ix_c ON ix (nope)"
                 "CREATE INDEX ix_d ON nope (a)"
                 "CREATE UNIQUE INDEX ix_u ON ix (a)"
                 "DROP INDEX ix_a"
                 "DROP INDEX ix_a"
                 "DROP INDEX IF EXISTS ix_a"
                 "SELECT name FROM sqlite_schema ORDER BY name"
                 "SELECT b FROM ix ORDER BY b"
                 "SELECT b = 'hello' FROM ix ORDER BY a"
                 "SELECT DISTINCT b FROM ix"
                 "CREATE TABLE q (a TEXT UNIQUE)"
                 "DROP INDEX sqlite_autoindex_q_1"])]
    (is (= (str "0 " (nth r 0)) "0 C:0:0"))
    (is (= (str "1 " (nth r 1)) "1 C:0:0"))
    (is (= (str "2 " (nth r 2)) "2 C:0:0"))
