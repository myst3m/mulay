(deftest script-11
  (let [r (run ["CREATE TABLE z (a INTEGER PRIMARY KEY, b, c)"
                 "INSERT INTO z VALUES (-1, 'd', 1), (2, 'd', 2), (-2, 'e', 3)"
                 "CREATE UNIQUE INDEX zb ON z (b)"
                 "SELECT name FROM sqlite_schema WHERE type = 'index'"
                 "CREATE UNIQUE INDEX zc ON z (c)"
                 "INSERT INTO z VALUES (3, 'f', 1)"
                 "INSERT OR IGNORE INTO z VALUES (4, 'g', 3)"
                 "UPDATE z SET c = 3 WHERE a = 2"
                 "UPDATE z SET c = 3 WHERE a = -2"
                 "UPDATE z SET a = -3 WHERE a = -1"
                 "SELECT * FROM z ORDER BY a"])]
    (is (= (str "0 " (nth r 0)) "0 C:0:0"))
    (is (= (str "1 " (nth r 1)) "1 C:3:-2"))
    (is (= (str "2 " (nth r 2)) "2 E:2067:UNIQUE constraint failed: z.b"))
    (is (= (str "3 " (nth r 3)) "3 Q:name|"))
    (is (= (str "4 " (nth r 4)) "4 C:3:-2"))
    (is (= (str "5 " (nth r 5)) "5 E:2067:UNIQUE constraint failed: z.c"))
    (is (= (str "6 " (nth r 6)) "6 C:0:-2"))
    (is (= (str "7 " (nth r 7)) "7 E:2067:UNIQUE constraint failed: z.c"))
    (is (= (str "8 " (nth r 8)) "8 C:1:-2"))
    (is (= (str "9 " (nth r 9)) "9 C:1:-2"))
    (is (= (str "10 " (nth r 10)) "10 Q:a|b|c|;I:-3 T:64 I:1;I:-2 T:65 I:3;I:2 T:64 I:2"))
    ))
