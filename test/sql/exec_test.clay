(deftest script-8
  (let [r (run ["CREATE TABLE tx (a)"
                 "BEGIN"
                 "INSERT INTO tx VALUES (1)"
                 "INSERT INTO tx VALUES (2)"
                 "SELECT * FROM tx"
                 "ROLLBACK"
                 "SELECT * FROM tx"
                 "BEGIN TRANSACTION"
                 "INSERT INTO tx VALUES (3)"
                 "BEGIN"
                 "COMMIT"
                 "SELECT * FROM tx"
                 "COMMIT"
                 "ROLLBACK"
                 "END"
                 "BEGIN"
                 "CREATE TABLE tx2 (b)"
                 "ROLLBACK"
                 "SELECT * FROM tx2"
                 "INSERT INTO tx SELECT a + 10 FROM tx"
                 "SELECT * FROM tx"
                 "INSERT INTO tx (a) SELECT 1, 2"
                 "SELECT changes(), total_changes(), last_insert_rowid()"])]
    (is (= (str "0 " (nth r 0)) "0 C:0:0"))
    (is (= (str "1 " (nth r 1)) "1 C:0:0"))
    (is (= (str "2 " (nth r 2)) "2 C:1:1"))
    (is (= (str "3 " (nth r 3)) "3 C:1:2"))
    (is (= (str "4 " (nth r 4)) "4 Q:a|;I:1;I:2"))
    (is (= (str "5 " (nth r 5)) "5 C:1:2"))
    (is (= (str "6 " (nth r 6)) "6 Q:a|"))
    (is (= (str "7 " (nth r 7)) "7 C:1:2"))
    (is (= (str "8 " (nth r 8)) "8 C:1:1"))
    (is (= (str "9 " (nth r 9)) "9 E:1:cannot start a transaction within a transaction"))
    (is (= (str "10 " (nth r 10)) "10 C:1:1"))
    (is (= (str "11 " (nth r 11)) "11 Q:a|;I:3"))
    (is (= (str "12 " (nth r 12)) "12 E:1:cannot commit - no transaction is active"))
    (is (= (str "13 " (nth r 13)) "13 E:1:cannot rollback - no transaction is active"))
    (is (= (str "14 " (nth r 14)) "14 E:1:cannot commit - no transaction is active"))
    (is (= (str "15 " (nth r 15)) "15 C:1:1"))
    (is (= (str "16 " (nth r 16)) "16 C:1:1"))
    (is (= (str "17 " (nth r 17)) "17 C:1:1"))
    (is (= (str "18 " (nth r 18)) "18 E:1:no such table: tx2"))
    (is (= (str "19 " (nth r 19)) "19 C:1:2"))
    (is (= (str "20 " (nth r 20)) "20 Q:a|;I:3;I:13"))
    (is (= (str "21 " (nth r 21)) "21 E:1:2 values for 1 columns"))
    (is (= (str "22 " (nth r 22)) "22 Q:changes()|total_changes()|last_insert_rowid()|;I:1 I:4 I:2"))
    ))
(deftest script-9
  (let [r (run ["CREATE TABLE s (i INTEGER, r REAL)"
                 "INSERT INTO s VALUES (9223372036854775807, 0.1), (1, 0.2), (NULL, 0.3)"
                 "SELECT sum(i) FROM s"
                 "SELECT total(i), avg(i) FROM s"
                 "SELECT sum(r), avg(r), total(r) FROM s"
                 "INSERT INTO s VALUES (-9223372036854775807, 1e308), (-3, 1e308)"
                 "SELECT sum(i), sum(r) FROM s"
                 "SELECT sum(i) FROM s WHERE i > 0"
                 "SELECT sum(i) FROM s WHERE i < 9223372036854775807"
                 "SELECT sum('3'), sum('x'), sum(x'31') FROM s WHERE i = 1"
                 "SELECT max(i), min(i), max(r), min(r) FROM s"
                 "SELECT r FROM s ORDER BY r"
                 "SELECT i, r FROM s ORDER BY i DESC NULLS FIRST"])]
    (is (= (str "0 " (nth r 0)) "0 C:0:0"))
    (is (= (str "1 " (nth r 1)) "1 C:3:3"))
    (is (= (str "2 " (nth r 2)) "2 E:1:integer overflow"))
    (is (= (str "3 " (nth r 3)) "3 Q:total(i)|avg(i)|;R:43e0000000000000 R:43d0000000000000"))
    (is (= (str "4 " (nth r 4)) "4 Q:sum(r)|avg(r)|total(r)|;R:3fe3333333333333 R:3fc9999999999999 R:3fe3333333333333"))
    (is (= (str "5 " (nth r 5)) "5 C:2:5"))
    (is (= (str "6 " (nth r 6)) "6 E:1:integer overflow"))
    (is (= (str "7 " (nth r 7)) "7 E:1:integer overflow"))
    (is (= (str "8 " (nth r 8)) "8 E:1:integer overflow"))
