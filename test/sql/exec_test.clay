                 "CREATE TABLE u (k INTEGER, label TEXT)"
                 "INSERT INTO u VALUES (1, 'one'), (2, 'two'), (2, 'deux'), (4, 'four')"
                 "SELECT t.name, u.label FROM t JOIN u ON t.k = u.k ORDER BY t.id, u.label"
                 "SELECT t.name, u.label FROM t LEFT JOIN u ON t.k = u.k ORDER BY t.id, u.label"
                 "SELECT * FROM t JOIN u USING (k) ORDER BY id, label"
                 "SELECT * FROM t NATURAL JOIN u ORDER BY id, label"
                 "SELECT k FROM t JOIN u ON t.k = u.k"
                 "SELECT count(*) FROM t, u"
                 "SELECT count(*) FROM t CROSS JOIN u WHERE t.k = u.k"
                 "SELECT t.k, u.* FROM t LEFT OUTER JOIN u ON u.k = t.k AND u.label <> 'two' ORDER BY t.id, u.label"
                 "SELECT u.label, count(t.id) FROM u LEFT JOIN t ON t.k = u.k GROUP BY u.label ORDER BY u.label"
                 "SELECT * FROM t JOIN nope ON 1"
