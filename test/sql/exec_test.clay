                 "INSERT INTO lk (k, s, r, u) VALUES (3, 'Abc', 1.0, 'X'), (1, 'abc', 2.5, 'x'), (3, 'b', 1, 'y'), (NULL, NULL, NULL, NULL), ('3', 'ABC', '1', 'X'), (2, 'c', 3, 'Y')"
                 "SELECT id FROM lk WHERE k = 3"
                 "SELECT id FROM lk WHERE k = '3'"
                 "SELECT id FROM lk WHERE 3 = k"
                 "SELECT id FROM lk WHERE k = 3.0"
                 "SELECT id FROM lk WHERE k = NULL"
                 "SELECT id FROM lk WHERE k = 3 AND s = 'b'"
                 "SELECT id FROM lk WHERE s = 'abc'"
                 "SELECT id FROM lk WHERE s = 'ABC' COLLATE BINARY"
                 "SELECT id FROM lk WHERE r = 1"
                 "SELECT id FROM lk WHERE r = '1'"
                 "SELECT id FROM lk WHERE u = 'x'"
                 "SELECT id FROM lk WHERE u = 'X' AND k = 3"
                 "SELECT id, k FROM lk WHERE id = 3"
                 "SELECT id FROM lk WHERE id = '3'"
