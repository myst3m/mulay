;; tools/gen-sqlparse-golden.py で作った (手で直さない)。期待値は sqlite-jdbc 3.50.3.0 の prepare:
;; 構文の誤りならその errmsg (E:..)、構文として通れば OK
(ns parse-test (:require [mulay.lib.sqlparse :as sp]))

(defn- pr Str [sql: Str] (let [[st e] (sp/parse sql)] (if (= e "") "OK" (str "E:" e))))

(deftest stmts-0
  (is (= (pr "DROP TABLE IF EXISTS person") "OK"))
  (is (= (pr "CREATE TABLE person (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, age INTEGER, score REAL, active BOOLEAN, born DATE, seen TIMESTAMP, note NUMERIC, big INTEGER, blob BLOB)") "OK"))
  (is (= (pr "INSERT INTO person (name, age, score, active, born, seen, note, big, blob) VALUES ('Ann', 30, 12.5, 1, '1996-01-02', '2026-09-30 10:11:12.345', '12.50', 9007199254740993, x'0102ff'), ('Bob', NULL, NULL, 0, NULL, NULL, NULL, NULL, NULL), ('Cid', 41, 100, 1, '1985-12-31', '2026-01-01 00:00:00', 7, -5, x'')") "OK"))
  (is (= (pr "SELECT id, name FROM person ORDER BY id") "OK"))
  (is (= (pr "SELECT * FROM person ORDER BY id") "OK"))
  (is (= (pr "SELECT * FROM person ORDER BY id") "OK"))
  (is (= (pr "SELECT id, name FROM person WHERE age > :min AND name <> :skip ORDER BY id") "OK"))
  (is (= (pr "INSERT INTO person (name, age) VALUES (:name, :age)") "OK"))
  (is (= (pr "UPDATE person SET age = age WHERE 1 = 0") "OK"))
  (is (= (pr "SELECT * FROM person WHERE id = :x") "OK"))
  (is (= (pr "UPDATE person SET age = age + 1 WHERE age IS NOT NULL") "OK"))
  (is (= (pr "DELETE FROM person WHERE name = :n") "OK"))
  (is (= (pr "INSERT INTO person (name, age) VALUES (:name, :age)") "OK"))
  (is (= (pr "SELECT count(*) AS n, max(age) AS oldest FROM person") "OK"))
  (is (= (pr "SELEC 1") "E:near \"SELEC\": syntax error"))
  (is (= (pr "SELECT * FROM nothing_here") "OK"))
  (is (= (pr "INSERT INTO person (name) VALUES (NULL)") "OK"))
  (is (= (pr "UPDATE person SET age = age WHERE 1 = 0") "OK"))
  (is (= (pr "SELECT * FROM nothing_here") "OK"))
  (is (= (pr "UPDATE person SET age = age WHERE 1 = 0") "OK"))
  (is (= (pr "UPDATE person SET age = age WHERE 1 = 0") "OK"))
  (is (= (pr "INSERT INTO person (name) VALUES (NULL)") "OK"))
  (is (= (pr "UPDATE person SET age = age WHERE 1 = 0") "OK"))
  (is (= (pr "UPDATE person SET age = age WHERE 1 = 0") "OK"))
  (is (= (pr "SELECT name FROM person WHERE 1 = 0") "OK"))
  (is (= (pr "INSERT INTO person (name) VALUES ('T1')") "OK"))
  (is (= (pr "INSERT INTO person (name) VALUES ('T2')") "OK"))
  (is (= (pr "SELECT name FROM person WHERE name LIKE 'T%' ORDER BY name") "OK"))
  (is (= (pr "INSERT INTO person (name) VALUES ('R1')") "OK"))
  (is (= (pr "SELECT name FROM person WHERE name LIKE 'R%' ORDER BY name") "OK"))
  (is (= (pr "INSERT INTO person (name) VALUES ('C1')") "OK"))
  (is (= (pr "SELECT name FROM person WHERE name LIKE 'C%' ORDER BY name") "OK"))
  (is (= (pr "INSERT INTO person (name) VALUES ('N1')") "OK"))
  (is (= (pr "INSERT INTO person (name) VALUES ('N2')") "OK"))
  (is (= (pr "SELECT name FROM person WHERE name LIKE 'N%' ORDER BY name") "OK"))
  (is (= (pr "INSERT INTO person (name) VALUES ('S1')") "OK"))
  (is (= (pr "SELECT count(*) AS n FROM person WHERE name = 'S1'") "OK"))
  (is (= (pr "SELECT count(*) AS n FROM person WHERE name = 'S1'") "OK"))
  (is (= (pr "DROP TABLE IF EXISTS bulk_t") "OK"))
  (is (= (pr "CREATE TABLE bulk_t (id INTEGER PRIMARY KEY, name VARCHAR(20) NOT NULL, n INTEGER DEFAULT 0)") "OK"))
  (is (= (pr "SELECT id, name, n FROM bulk_t ORDER BY id") "OK"))
  (is (= (pr "INSERT INTO bulk_t (id, name) VALUES (:id, :name)") "OK"))
  (is (= (pr "UPDATE bulk_t SET n = n + 1 WHERE id >= :min") "OK"))
  (is (= (pr "INSERT INTO bulk_t (id, name) VALUES (:id, :name)") "OK"))
  (is (= (pr "INSERT INTO bulk_t (id, name) VALUES (:id, :name)") "OK"))
  (is (= (pr "INSERT INTO bulk_t (id, name) VALUES (:id, :name)") "OK"))
  (is (= (pr "DELETE FROM bulk_t WHERE id = :id") "OK"))
  (is (= (pr "INSERT INTO bulk_t (id, name) VALUES (:id, :name)") "OK"))
  (is (= (pr "INSERT INTO bulk_t (id, name) VALUES (:id, :name)") "OK"))
  (is (= (pr "SELECT COUNT(*) AS c FROM bulk_t WHERE id >= 30") "OK"))
  (is (= (pr "INSERT INTO no_such_table (id) VALUES (:id)") "OK"))
  (is (= (pr "SELECT 1 AS a") "OK"))
  (is (= (pr "SELECT 2 AS a") "OK"))
  (is (= (pr "SELECT 1 AS a") "OK"))
  (is (= (pr "SELECT 2 AS a") "OK"))
  (is (= (pr "WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < 10) SELECT n FROM c") "OK"))
  (is (= (pr "WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < 3) SELECT n FROM c") "OK"))
  (is (= (pr "SELECT 9 AS a") "OK"))
  (is (= (pr "WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < 10) SELECT n FROM c") "OK"))
  (is (= (pr "SELECT 3 AS a") "OK"))
  )
(deftest stmts-1
  (is (= (pr "CREATE TABLE IF NOT EXISTS later_out (k TEXT, n INTEGER, d TEXT)") "OK"))
  (is (= (pr "DELETE FROM later_out") "OK"))
  (is (= (pr "WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < 5) SELECT n FROM c") "OK"))
  (is (= (pr "INSERT INTO later_out VALUES ('async', :n, '')") "OK"))
  (is (= (pr "INSERT INTO later_out VALUES ('async', -1, :d)") "OK"))
  (is (= (pr "INSERT INTO later_out VALUES ('batch', :n, '')") "OK"))
  (is (= (pr "INSERT INTO later_out VALUES ('batch', -1, 'failed')") "OK"))
  (is (= (pr "SELECT k, n, d FROM later_out ORDER BY k, n") "OK"))
  (is (= (pr "SELECT 1") "OK"))
  (is (= (pr "SELECT") "E:incomplete input"))
  (is (= (pr "SELECT 1,") "E:incomplete input"))
  (is (= (pr "SELECT 1 AS") "E:incomplete input"))
  (is (= (pr "SELECT a b FROM t") "OK"))
  (is (= (pr "SELECT a AS b, c d FROM t x") "OK"))
  (is (= (pr "SELECT * FROM t AS x WHERE x.a = 1") "OK"))
  (is (= (pr "SELECT t.* , 1 FROM t") "OK"))
  (is (= (pr "SELECT DISTINCT a FROM t") "OK"))
  (is (= (pr "SELECT ALL a FROM t") "OK"))
  (is (= (pr "SELECT a FROM t GROUP BY a HAVING count(*) > 1") "OK"))
  (is (= (pr "SELECT a FROM t ORDER BY a DESC, b ASC NULLS LAST, c COLLATE NOCASE") "OK"))
  (is (= (pr "SELECT a FROM t LIMIT 10") "OK"))
  (is (= (pr "SELECT a FROM t LIMIT 10 OFFSET 5") "OK"))
  (is (= (pr "SELECT a FROM t LIMIT 5, 10") "OK"))
  (is (= (pr "SELECT a FROM t LIMIT") "E:incomplete input"))
  (is (= (pr "SELECT a FROM t ORDER") "E:incomplete input"))
  (is (= (pr "SELECT a FROM t ORDER BY") "E:incomplete input"))
  (is (= (pr "SELECT a FROM t GROUP a") "E:near \"a\": syntax error"))
  (is (= (pr "SELECT 1 UNION SELECT 2") "OK"))
  (is (= (pr "SELECT 1 UNION ALL SELECT 2 UNION SELECT 3 ORDER BY 1") "OK"))
  (is (= (pr "SELECT 1 INTERSECT SELECT 1 EXCEPT SELECT 2") "OK"))
  (is (= (pr "SELECT 1 UNION") "E:incomplete input"))
  (is (= (pr "VALUES (1, 2), (3, 4)") "OK"))
  (is (= (pr "VALUES (1") "E:incomplete input"))
  (is (= (pr "VALUES ()") "E:near \")\": syntax error"))
  (is (= (pr "SELECT * FROM (SELECT 1 AS x) AS s") "OK"))
  (is (= (pr "SELECT * FROM (SELECT 1)") "OK"))
  (is (= (pr "SELECT * FROM t JOIN u ON t.a = u.a") "OK"))
  (is (= (pr "SELECT * FROM t LEFT JOIN u USING (a, b)") "OK"))
  (is (= (pr "SELECT * FROM t LEFT OUTER JOIN u ON 1") "OK"))
  (is (= (pr "SELECT * FROM t, u, v WHERE 1") "OK"))
  (is (= (pr "SELECT * FROM t CROSS JOIN u") "OK"))
  (is (= (pr "SELECT * FROM t NATURAL JOIN u") "OK"))
  (is (= (pr "SELECT * FROM t INNER JOIN u ON") "E:incomplete input"))
  (is (= (pr "SELECT * FROM t JOIN") "E:incomplete input"))
  (is (= (pr "SELECT (SELECT 1)") "OK"))
  (is (= (pr "SELECT EXISTS (SELECT 1)") "OK"))
  (is (= (pr "SELECT 1 IN (SELECT 1)") "OK"))
  (is (= (pr "SELECT 1 NOT IN (SELECT 2 UNION SELECT 3)") "OK"))
  (is (= (pr "SELECT (SELECT 1") "E:incomplete input"))
  (is (= (pr "WITH c AS (SELECT 1) SELECT * FROM c") "OK"))
  (is (= (pr "WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM c WHERE n<3) SELECT n FROM c") "OK"))
  (is (= (pr "WITH c AS SELECT 1") "E:near \"SELECT\": syntax error"))
  (is (= (pr "WITH c(a, b) AS NOT MATERIALIZED (SELECT 1, 2) SELECT * FROM c") "OK"))
  (is (= (pr "WITH") "E:incomplete input"))
  (is (= (pr "SELECT * FROM main.t") "OK"))
  (is (= (pr "SELECT * FROM t INDEXED BY i") "OK"))
  (is (= (pr "SELECT * FROM t NOT INDEXED") "OK"))
  (is (= (pr "INSERT INTO t VALUES (1)") "OK"))
  (is (= (pr "INSERT INTO t (a, b) VALUES (1, 2), (3, 4)") "OK"))
  (is (= (pr "INSERT INTO t SELECT * FROM u") "OK"))
  )
(deftest stmts-2
  (is (= (pr "INSERT INTO t DEFAULT VALUES") "OK"))
  (is (= (pr "INSERT OR REPLACE INTO t VALUES (1)") "OK"))
  (is (= (pr "REPLACE INTO t VALUES (1)") "OK"))
  (is (= (pr "INSERT OR IGNORE INTO t VALUES (1)") "OK"))
  (is (= (pr "INSERT INTO t") "E:incomplete input"))
  (is (= (pr "INSERT INTO t (a VALUES (1)") "E:near \"VALUES\": syntax error"))
  (is (= (pr "INSERT t VALUES (1)") "E:near \"t\": syntax error"))
  (is (= (pr "INSERT INTO t VALUES") "E:incomplete input"))
  (is (= (pr "UPDATE t SET a = 1") "OK"))
  (is (= (pr "UPDATE t SET a = 1, b = b + 1 WHERE c") "OK"))
  (is (= (pr "UPDATE OR IGNORE t SET a = 1") "OK"))
  (is (= (pr "UPDATE t SET") "E:incomplete input"))
  (is (= (pr "UPDATE t a = 1") "E:near \"a\": syntax error"))
  (is (= (pr "UPDATE t SET a = 1 WHERE") "E:incomplete input"))
  (is (= (pr "DELETE FROM t") "OK"))
  (is (= (pr "DELETE FROM t WHERE a = 1") "OK"))
  (is (= (pr "DELETE t") "E:near \"t\": syntax error"))
  (is (= (pr "DELETE FROM") "E:incomplete input"))
  (is (= (pr "CREATE TABLE t (a)") "OK"))
  (is (= (pr "CREATE TABLE t (a INTEGER PRIMARY KEY AUTOINCREMENT, b TEXT NOT NULL DEFAULT 'x', c REAL UNIQUE CHECK (c > 0))") "OK"))
  (is (= (pr "CREATE TABLE IF NOT EXISTS t (a, b, PRIMARY KEY (a, b))") "OK"))
  (is (= (pr "CREATE TABLE t (a, b, UNIQUE (a), CHECK (a > b), FOREIGN KEY (a) REFERENCES u (x) ON DELETE CASCADE)") "OK"))
  (is (= (pr "CREATE TABLE t (a INT DEFAULT -1, b DEFAULT (1 + 2), c VARCHAR(10) COLLATE NOCASE, d DECIMAL(10, 2))") "OK"))
  (is (= (pr "CREATE TABLE t (a) WITHOUT ROWID") "OK"))
  (is (= (pr "CREATE TABLE t (a) STRICT") "OK"))
  (is (= (pr "CREATE TABLE t") "E:incomplete input"))
  (is (= (pr "CREATE TABLE t ()") "E:near \")\": syntax error"))
  (is (= (pr "CREATE TABLE t (a,)") "E:near \")\": syntax error"))
  (is (= (pr "CREATE TABLE (a)") "E:near \"(\": syntax error"))
  (is (= (pr "CREATE TABLE t (a PRIMARY KEY DESC)") "OK"))
  (is (= (pr "CREATE TABLE t (a CONSTRAINT pk PRIMARY KEY, b CONSTRAINT nn NOT NULL)") "OK"))
  (is (= (pr "CREATE TABLE t (a REFERENCES u)") "OK"))
  (is (= (pr "CREATE INDEX i ON t (a)") "OK"))
  (is (= (pr "CREATE UNIQUE INDEX IF NOT EXISTS i ON t (a DESC, b COLLATE NOCASE)") "OK"))
  (is (= (pr "CREATE INDEX i ON t (a) WHERE a > 0") "OK"))
  (is (= (pr "CREATE INDEX i ON t") "E:incomplete input"))
  (is (= (pr "CREATE INDEX ON t (a)") "E:near \"ON\": syntax error"))
  (is (= (pr "DROP TABLE t") "OK"))
  (is (= (pr "DROP TABLE IF EXISTS t") "OK"))
  (is (= (pr "DROP INDEX i") "OK"))
  (is (= (pr "DROP TABLE") "E:incomplete input"))
  (is (= (pr "DROP t") "E:near \"t\": syntax error"))
  (is (= (pr "BEGIN") "OK"))
  (is (= (pr "BEGIN TRANSACTION") "OK"))
  (is (= (pr "BEGIN IMMEDIATE") "OK"))
  (is (= (pr "COMMIT") "OK"))
  (is (= (pr "END") "OK"))
  (is (= (pr "END TRANSACTION") "OK"))
  (is (= (pr "ROLLBACK") "OK"))
  (is (= (pr "ROLLBACK TRANSACTION") "OK"))
  (is (= (pr "SELECT 1; SELECT 2") "OK"))
  (is (= (pr ";SELECT 1") "OK"))
  (is (= (pr "SELECT 1 FROM t WHERE a = 1 b") "E:near \"b\": syntax error"))
  (is (= (pr "SELECT a, FROM t") "E:near \"FROM\": syntax error"))
  (is (= (pr "SELECT count(*) FROM t") "OK"))
  (is (= (pr "SELECT count(DISTINCT a) FROM t") "OK"))
  (is (= (pr "SELECT a FROM t WHERE a IN (1, 2) AND b LIKE 'x%'") "OK"))
  (is (= (pr "SELECT CASE WHEN a THEN 1 END FROM t") "OK"))
  (is (= (pr "SELECT a FROM t WHERE NOT EXISTS (SELECT 1 FROM u WHERE u.a = t.a)") "OK"))
  (is (= (pr "SELECT * FROM t AS") "E:incomplete input"))
  )
(deftest stmts-3
  (is (= (pr "SELECT a FROM t t2") "OK"))
  (is (= (pr "SELECT end FROM t") "OK"))
  (is (= (pr "SELECT a FROM t WHERE end = 1") "OK"))
  (is (= (pr "SELECT \"a\" FROM \"t\"") "OK"))
  (is (= (pr "SELECT [a] FROM [t]") "OK"))
  (is (= (pr "SELECT a FROM t ORDER BY 1 DESC LIMIT 1") "OK"))
  (is (= (pr "SELECT * FROM t WHERE a = ?") "OK"))
  (is (= (pr "SELECT * FROM t WHERE a = :name") "OK"))
  (is (= (pr "SELECT 1 FROM t GROUP BY 1 ORDER BY 1") "OK"))
  )
