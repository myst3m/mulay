;; tools/gen-sqleval-golden.py で作った (手で直さない)。期待値は sqlite-jdbc 3.50.3.0 (SQLite 3.50.3)。
;; 値は N / I:10 進 / R:double のビット / T:16 進 / B:16 進、失敗は E:errmsg
(ns eval-test (:require [mulay.lib.sqlparse :as sp] [mulay.lib.sqlexec :as ev] [mulay.lib.sqlfile :as sf] [mulay.lib.ieee :as ieee]
                         [mulay.dw.lib.binaries :as bin]))

(defn- hex64 Str [x: Int] (loop [i 0 out ""] (if (>= i 8) out (recur (+ i 1) (str out (chr (bit-and (unsigned-bit-shift-right x (* 8 (- 7 i))) 255)))))))
(defn- enc Str [v: &sf/Val]
  (match v
    (sf/VNull) "N"
    (sf/VInt n) (str "I:" n)
    (sf/VReal x) (str "R:" (bin/hex-lower (hex64 (ieee/double->bits x))))
    (sf/VText s) (str "T:" (bin/hex-lower s))
    (sf/VBlob s) (str "B:" (bin/hex-lower s))))
(defn- ev Str [sql: Str]
  (let [[n e] (sp/parse-expr sql)]
    (if (not= e "") (str "E:" e)
      (let [[v e2] (ev/eval-expr n (ev/empty-env))] (if (not= e2 "") (str "E:" e2) (enc v))))))

(deftest exprs-0
  (is (= (ev "-NULL") "N"))
  (is (= (ev "+NULL") "N"))
  (is (= (ev "~NULL") "N"))
  (is (= (ev "NOT NULL") "N"))
  (is (= (ev "CAST(NULL AS INTEGER)") "N"))
  (is (= (ev "CAST(NULL AS INT)") "N"))
  (is (= (ev "CAST(NULL AS REAL)") "N"))
  (is (= (ev "CAST(NULL AS TEXT)") "N"))
  (is (= (ev "CAST(NULL AS BLOB)") "N"))
  (is (= (ev "CAST(NULL AS NUMERIC)") "N"))
  (is (= (ev "CAST(NULL AS VARCHAR(10))") "N"))
  (is (= (ev "CAST(NULL AS FLOAT)") "N"))
  (is (= (ev "CAST(NULL AS BOOLEAN)") "N"))
