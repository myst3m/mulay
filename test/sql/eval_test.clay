  (is (= (ev "CAST('1.0' AS REAL) = '1.0'") "I:1"))
  (is (= (ev "'' = 0") "I:0"))
  (is (= (ev "x'' = ''") "I:0"))
  (is (= (ev "x'' < ''") "I:0"))
  (is (= (ev "'' < x''") "I:1"))
  (is (= (ev "1 < x''") "I:1"))
  (is (= (ev "'z' < x'00'") "I:1"))
  )
