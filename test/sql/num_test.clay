;; tools/gen-sqlnum-golden.py で作った (手で直さない)。期待値は sqlite-jdbc 3.50.3.0 (SQLite 3.50.3)
(ns num-test (:require [mulay.lib.sqlnum :as n] [mulay.lib.ieee :as ieee] [mulay.dw.lib.binaries :as bin]))

(defn- hex64 Str [x: Int] (loop [i 0 out ""] (if (>= i 8) out (recur (+ i 1) (str out (chr (bit-and (unsigned-bit-shift-right x (* 8 (- 7 i))) 255)))))))
(defn- bits Str [s: Str] (let [[x k] (n/atof s)] (str "R:" (bin/hex-lower (hex64 (ieee/double->bits x))))))
(defn- text Str [s: Str] (let [[x k] (n/atof s)] (n/real->text x)))

(deftest conv-0
  (is (= (bits "0") "R:0000000000000000"))
  (is (= (text "0") "0.0"))
  (is (= (bits "1") "R:3ff0000000000000"))
  (is (= (text "1") "1.0"))
  (is (= (bits "-1") "R:bff0000000000000"))
  (is (= (text "-1") "-1.0"))
  (is (= (bits "1.5") "R:3ff8000000000000"))
  (is (= (text "1.5") "1.5"))
