(ns wasm-unpack-test (:require [mulay.wasm.main :as w] [clay.string :as str]))

(deftest unpack-files
  (let [[ps bs err] (w/unpack (str "a.xml\n4\n<a/>" "dir/b.txt\n3\n日" "empty\n0\n"))
        [ps2 bs2 err2] (w/unpack "x\n10\nshort")
        [ps3 bs3 err3] (w/unpack "x\nzz\nabc")]
    (is (= err ""))
    (is (= (str/join "," ps) "/app/a.xml,/app/dir/b.txt,/app/empty"))
    (is (= (nth bs 0) "<a/>"))
    (is (= (nth bs 1) "日"))
    (is (= (nth bs 2) ""))
    (is (= err2 "bad length at byte 2"))
    (is (= err3 "bad length at byte 2"))))

(deftest split-properties
  (let [[ps bs err] (w/unpack (str "a.xml\n4\n<a/>" "@properties\n9\n{\"e\":\"d\"}" "@links\n2\n[]"))
        [fs ts pj lj] (w/split-props ps bs)
        [fs2 ts2 pj2 lj2] (w/split-props ["/app/a.xml"] ["<a/>"])]
    (is (= (str/join "," fs) "/app/a.xml"))
    (is (= (count ts) 1))
    (is (= pj "{\"e\":\"d\"}"))
    (is (= lj "[]"))
    (is (= pj2 ""))
    (is (= lj2 ""))))
