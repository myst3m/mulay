(ns wsdl-golden-test (:require [wsdl-golden-helper :as h]))
;; GENERATED by tools/gen-wsdl-golden.java on Java 17.0.21-ea (mule-wsdl-parser 1.4.11) -- do not edit.
;; 失敗は "!<例外の単純名>: <文言>" (文言の中の data の絶対パスは <DIR>、カレントディレクトリは <CWD> に置き換える)。
;; service、port、操作は名前の順 (実物の並びは HashMap の順で、WSC の振る舞いには出ない)。
(deftest golden-wsdl
  (is (= (h/show "echo.wsdl") "style=DOC_LITERAL\nservice EchoService\n port EchoPort address=http://localhost:18470/soap/11/echo binding=SOAP11/DOC_LITERAL\n  op echo type=REQUEST_RESPONSE action=[urn:mulay:echo/echo]\n  op echoTraced type=REQUEST_RESPONSE action=[]\n  op notify type=ONE_WAY action=[urn:mulay:echo/notify]\n port EchoPort12 address=http://localhost:18470/soap/12/echo binding=SOAP12/DOC_LITERAL\n  op echo type=REQUEST_RESPONSE action=[urn:mulay:echo/echo]\n  op echoTraced type=REQUEST_RESPONSE action=[]\n  op notify type=ONE_WAY action=[urn:mulay:echo/notify]\n"))
  (is (= (h/show "calc-rpc.wsdl") "style=RPC\nservice CalcService\n port CalcPort address=http://localhost:18470/soap/11/rpc binding=SOAP11/RPC\n  op add type=REQUEST_RESPONSE action=[urn:mulay:calc/add]\n"))
  (is (= (h/show "imp/service.wsdl") "style=DOC_LITERAL\nservice PingService\n port PingPort address=http://localhost:18470/soap/11/ping binding=SOAP11/DOC_LITERAL\n  op ping type=REQUEST_RESPONSE action=[ping]\n"))
  (is (= (h/show "multi.wsdl") "style=DOC_LITERAL\nservice S1\n port P11 address=http://example.com:8080/s1/p11 binding=SOAP11/DOC_LITERAL\n  op first type=REQUEST_RESPONSE action=[act:first]\n  op second type=ONE_WAY action=null\n  op third type=REQUEST_RESPONSE action=null\n port P12 address=https://example.com/s1/p12?x=1 binding=SOAP12/DOC_LITERAL\n  op first type=REQUEST_RESPONSE action=[act12:first]\n  op second type=ONE_WAY action=[]\n  op third type=REQUEST_RESPONSE action=null\nservice S2\n port PNoAddr address=null binding=SOAP11/DOC_LITERAL\n  op first type=REQUEST_RESPONSE action=[act:first]\n  op second type=ONE_WAY action=null\n  op third type=REQUEST_RESPONSE action=null\n"))
  (is (= (h/show "rpc-op.wsdl") "style=DOC_LITERAL\nservice S\n port P address=http://localhost/mix binding=SOAP11/DOC_LITERAL\n  op docOp type=REQUEST_RESPONSE action=[d]\n  op rpcOp type=REQUEST_RESPONSE action=[r]\n"))
  (is (= (h/show "broken.wsdl") "!WsdlParsingException: Error processing WSDL file [file:<DIR>/broken.wsdl]: faultCode=PARSER_ERROR: Problem parsing 'file:<DIR>/broken.wsdl'.: org.xml.sax.SAXParseException: The element type \"wsdl:service\" must be terminated by the matching end-tag \"</wsdl:service>\"."))
  (is (= (h/show "empty.wsdl") "!WsdlParsingException: Error processing WSDL file [file:<DIR>/empty.wsdl]: faultCode=PARSER_ERROR: Problem parsing 'file:<DIR>/empty.wsdl'.: org.xml.sax.SAXParseException: Premature end of file."))
  (is (= (h/show "notxml.wsdl") "!WsdlParsingException: Error processing WSDL file [file:<DIR>/notxml.wsdl]: faultCode=PARSER_ERROR: Problem parsing 'file:<DIR>/notxml.wsdl'.: org.xml.sax.SAXParseException: Content is not allowed in prolog."))
  (is (= (h/show "notwsdl.wsdl") "!WsdlParsingException: Error processing WSDL file [file:<DIR>/notwsdl.wsdl]: WSDLException (at /foo): faultCode=INVALID_WSDL: Expected element '{http://schemas.xmlsoap.org/wsdl/}definitions'."))
  (is (= (h/show "badimport.wsdl") "!NullPointerException: Cannot invoke \"java.net.URI.toURL()\" because the return value of \"org.apache.cxf.resource.URIResolver.getURI()\" is null"))
  (is (= (h/show "noports.wsdl") "style=DOC_LITERAL\nservice Lonely\n"))
  (is (= (h/show "badref.wsdl") "!WsdlParsingException: Error processing WSDL file [file:<DIR>/badref.wsdl]: WSDLException (at /wsdl:definitions/wsdl:service/wsdl:port): faultCode=UNBOUND_PREFIX: Unable to determine namespace of 'tns:Nope'."))
  (is (= (h/show "nostyle.wsdl") "style=DOC_LITERAL\nservice S\n port P address=http://h/p binding=SOAP11/DOC_LITERAL\n  op extra type=REQUEST_RESPONSE action=[x]\n  op op type=REQUEST_RESPONSE action=[a]\n"))
  (is (= (h/show "missing.wsdl") "!WsdlGettingException: Error Getting the resource [file:<DIR>/missing.wsdl]: <DIR>/missing.wsdl (No such file or directory)"))
)
