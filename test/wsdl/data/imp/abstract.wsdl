<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                  xmlns:tns="urn:mulay:imp"
                  targetNamespace="urn:mulay:imp">
    <wsdl:types>
        <xsd:schema><xsd:import namespace="urn:mulay:imp" schemaLocation="types.xsd"/></xsd:schema>
    </wsdl:types>
    <wsdl:message name="pingRequest"><wsdl:part name="parameters" element="tns:ping"/></wsdl:message>
    <wsdl:message name="pingResponse"><wsdl:part name="parameters" element="tns:pong"/></wsdl:message>
    <wsdl:portType name="PingPortType">
        <wsdl:operation name="ping"><wsdl:input message="tns:pingRequest"/><wsdl:output message="tns:pingResponse"/></wsdl:operation>
    </wsdl:portType>
</wsdl:definitions>
