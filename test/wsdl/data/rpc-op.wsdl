<?xml version="1.0" encoding="UTF-8"?>
<!-- binding は document で、操作の 1 つだけ rpc -->
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="urn:mix" targetNamespace="urn:mix">
    <wsdl:types><xsd:schema targetNamespace="urn:mix"><xsd:element name="d" type="xsd:string"/></xsd:schema></wsdl:types>
    <wsdl:message name="doc"><wsdl:part name="p" element="tns:d"/></wsdl:message>
    <wsdl:message name="rpc"><wsdl:part name="x" type="xsd:int"/></wsdl:message>
    <wsdl:portType name="PT">
        <wsdl:operation name="docOp"><wsdl:input message="tns:doc"/><wsdl:output message="tns:doc"/></wsdl:operation>
        <wsdl:operation name="rpcOp"><wsdl:input message="tns:rpc"/><wsdl:output message="tns:rpc"/></wsdl:operation>
    </wsdl:portType>
    <wsdl:binding name="B" type="tns:PT">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="docOp"><soap:operation soapAction="d"/><wsdl:input><soap:body use="literal"/></wsdl:input><wsdl:output><soap:body use="literal"/></wsdl:output></wsdl:operation>
        <wsdl:operation name="rpcOp"><soap:operation soapAction="r" style="rpc"/><wsdl:input><soap:body use="literal" namespace="urn:mix"/></wsdl:input><wsdl:output><soap:body use="literal" namespace="urn:mix"/></wsdl:output></wsdl:operation>
    </wsdl:binding>
    <wsdl:service name="S"><wsdl:port name="P" binding="tns:B"><soap:address location="http://localhost/mix"/></wsdl:port></wsdl:service>
</wsdl:definitions>
