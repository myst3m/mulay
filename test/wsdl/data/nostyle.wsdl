<?xml version="1.0" encoding="UTF-8"?>
<!-- style の無い SOAP 1.1 の binding、定義の無い binding を指す port、portType に無い操作 -->
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:t="urn:ns" targetNamespace="urn:ns">
    <message name="m"/>
    <portType name="PT"><operation name="op"><input message="t:m"/><output message="t:m"/></operation></portType>
    <binding name="B" type="t:PT">
        <soap:binding transport="http://schemas.xmlsoap.org/soap/http"/>
        <operation name="op"><soap:operation soapAction="a"/><input><soap:body use="literal"/></input><output><soap:body use="literal"/></output></operation>
        <operation name="extra"><soap:operation soapAction="x"/><input><soap:body use="literal"/></input></operation>
    </binding>
    <service name="S">
        <port name="P" binding="t:B"><soap:address location="http://h/p"/></port>
        <port name="Undef" binding="t:Missing"><soap:address location="http://h/u"/></port>
    </service>
</definitions>
