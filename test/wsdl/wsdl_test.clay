(ns wsdl-test (:require [mulay.lib.wsdl :as w]))

(deftest resolve-url-relative
  (is (= (w/resolve-url "file:/a/b/c.wsdl" "d.wsdl") "file:/a/b/d.wsdl"))
  (is (= (w/resolve-url "file:/a/b/c.wsdl" "../x/d.xsd") "file:/a/x/d.xsd"))
  (is (= (w/resolve-url "file:/a/b/c.wsdl" "./d.wsdl") "file:/a/b/d.wsdl"))
  (is (= (w/resolve-url "file:/a/b/c.wsdl" "/abs.wsdl") "file:/abs.wsdl"))
  (is (= (w/resolve-url "http://h:8080/svc/x?wsdl" "types.xsd") "http://h:8080/svc/types.xsd"))
  (is (= (w/resolve-url "http://h/svc?wsdl" "http://other/t.xsd") "http://other/t.xsd"))
  (is (= (w/resolve-url "classpath:wsdl/imp/service.wsdl" "abstract.wsdl") "classpath:wsdl/imp/abstract.wsdl")))

;; soapAction の属性を書いたか (空の値も書いたうち)
(deftest action-presence
  (let [[w e] (w/parse "file:test/wsdl/data/multi.wsdl" read-loc)
        p11 (nth (w/find-port (nth (w/find-service w "S1") 0) "P11") 0)
        p12 (nth (w/find-port (nth (w/find-service w "S1") 0) "P12") 0)]
    (is (= e ""))
    (is (has-act p11 "first"))
    (is (not (has-act p11 "second")))
    (is (not (has-act p11 "third")))
    (is (has-act p12 "first"))
    (is (has-act p12 "second"))
    (is (not (has-act p12 "third")))))

(defn- read-loc Values(Str Str) [url: Str]
  (let [[t e] (read-file (subs url 5 (count url)))] (values t e)))

(defn- has-act Bool [p: &w/Port n: &Str] (:has-action (nth (w/find-op p n) 0)))
