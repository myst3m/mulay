(ns ring-test (:require [mulay.rt.log :as log]))

;; jmx:get-recent-logs が読む、最近のログの循環バッファ (グローバルなので deftest は 1 つ)。

(deftest the-ring-keeps-the-last-app-logs
  (let [a (log/emit log/WARN log/INFO "w" "app.before" "before install")
        i (log/ring-install! 3)
        b (log/emit log/WARN log/INFO "[app].f" "app.jmx" "m1")
        c (log/emit log/INFO log/INFO "[app].f" "mulay.app" "internal")
        d (log/emit log/DEBUG log/INFO "[app].f" "app.jmx" "not enabled")
        e (log/emit log/WARN log/INFO "[app].f" "app.jmx" "m2")
        f (log/emit log/ERROR log/INFO "[app].g" "app.jmx" "m3")
        g (log/emit log/WARN log/INFO "[app].f" "app.jmx" "m4")
        rs (log/ring-snapshot)]
    (is (= (log/ring-capacity) 3))
    (is (= (count rs) 3))
    (is (= (:msg (nth rs 0)) "m2"))
    (is (= (:msg (nth rs 2)) "m4"))
    (is (= (:level (nth rs 1)) log/ERROR))
    (is (= (:logger (nth rs 1)) "app.jmx"))
    (is (= (:thread (nth rs 1)) "[app].g"))
    (is (= (count (:ts (nth rs 0))) 23))
    (is (> (:ms (nth rs 0)) 1700000000000))))
