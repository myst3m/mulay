(ns cron-test (:require [mulay.rt.cron :as cr] [mulay.lib.time.zoned :as tz] [mulay.lib.time.iso :as ti] [mulay.lib.time.tz :as tzr]))

;; 2026-09-28T10:15:30Z = 1790590530000
(defn- nxt Str [expr: Str now: Int zone: Str]
  (let [[c e] (cr/parse expr)]
    (if (not= e "") (str "ERR " e)
      (let [ms (cr/next-fire-ms c now zone)
            [z ze] (tzr/zone-of-id (if (= zone "") "UTC" zone))]
        (if (< ms 0) "none" (ti/zdt-str (tz/zdt-of-epoch-milli ms z)))))))

(deftest cron-next
  (is (= (nxt "0 * * * * ?" 1790590530000 "UTC") "2026-09-28T10:16Z[UTC]"))
  (is (= (nxt "*/10 * * * * ?" 1790590530000 "UTC") "2026-09-28T10:15:40Z[UTC]"))
  (is (= (nxt "0 0 12 * * ?" 1790590530000 "UTC") "2026-09-28T12:00Z[UTC]"))
  (is (= (nxt "0 0 9 ? * MON-FRI" 1790590530000 "Asia/Tokyo") "2026-09-29T09:00+09:00[Asia/Tokyo]"))
  (is (= (nxt "0 30 2 1 JAN ? 2027" 1790590530000 "UTC") "2027-01-01T02:30Z[UTC]"))
  (is (= (nxt "0 0 0 31 FEB ?" 1790590530000 "UTC") "none"))
  (is (= (nxt "0 0 0 L * ?" 1790590530000 "UTC") "ERR Unsupported cron expression '0 0 0 L * ?': L, W and # are not supported"))
  (is (= (nxt "0 0" 1790590530000 "UTC") "ERR Invalid cron expression '0 0': expected 6 or 7 fields")))
