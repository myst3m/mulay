(ns log4j2-test (:require [mulay.rt.log :as log] [clay.string :as str]))

(def XML (str "<Configuration><Loggers>"
              "<AsyncLogger name=\"org.mule.service.http\" level=\"WARN\"/>"
              "<Logger name=\"com.example\" level=\"debug\"/>"
              "<AsyncLogger name=\"com.example.quiet\" level=\"ERROR\"/>"
              "<Logger name=\"com.example.off\" level=\"OFF\"/>"
              "<Logger name=\"com.example.prop\" level=\"${sys:lvl}\"/>"
              "<AsyncRoot level=\"INFO\"><AppenderRef ref=\"file\"/></AsyncRoot>"
              "</Loggers></Configuration>"))

(defn- on Bool [l: Int cat: Str] (log/enabled? l log/INFO cat))

(deftest app-log4j2-levels
  (let [z (log/use-config! XML)]
    (is (on log/INFO "orders"))
    (is (not (on log/DEBUG "orders")))
    (is (on log/DEBUG "com.example"))
    (is (on log/DEBUG "com.example.child"))
    (is (not (on log/TRACE "com.example.child")))
    (is (not (on log/WARN "com.example.quiet")))
    (is (on log/ERROR "com.example.quiet.inner"))
    (is (not (on log/ERROR "com.example.off")))
    (is (on log/INFO "com.examplex"))
    (is (not (on log/INFO "org.mule.service.http.x")))
    (is (on log/INFO "com.example.prop"))
    (is (not (log/enabled? log/INFO log/WARN "orders")))
    (is (log/enabled? log/TRACE log/TRACE "orders"))))

(deftest no-root-means-error-and-reset
  (let [z (log/use-config! "<Configuration><Loggers><Logger name=\"a\" level=\"INFO\"/></Loggers></Configuration>")
        a (on log/WARN "b")
        b (on log/ERROR "b")
        c (on log/INFO "a.x")
        z2 (log/use-config! "")
        d (on log/INFO "orders")
        e (on log/WARN "orders")
        f (on log/INFO "org.mule.x")]
    (is (not a)) (is b) (is c)
    (is (not d)) (is e) (is f)))
