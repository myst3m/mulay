(ns csv-fuzz-test (:require [mulay.lib.csv :as csv]))
(def DOC "h1,\"h 2\",h3\r\n1,\"a,b\",\"say \"\"x\"\"\"\n\"multi\nline\",\\\"e,\n\n\"q\\\"\",x,y\n")
(defn- lcg Int [x: Int] (bit-and (+ (* x 1103515245) 12345) 2147483647))
(deftest mutations
  (is (loop [k 0 seed 3 n 0]
        (if (>= k 3000) (> n 0)
          (let [s1 (lcg seed) s2 (lcg s1) s3 (lcg s2)
                pos (mod s1 (count DOC))
                chars ",\"\\\n\r x"
                b (nth chars (mod s2 (count chars)))
                doc (if (= (mod s3 2) 0) (str (subs DOC 0 pos) (chr b) (subs DOC (+ pos 1) (count DOC)))
                      (str (subs DOC 0 pos) (subs DOC (+ pos 1) (count DOC))))
                [h rows err] (csv/read-all doc (csv/default-opts))]
            (recur (+ k 1) s3 (+ n (count rows))))))))
