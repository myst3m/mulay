(ns yaml-cases-test (:require [mulay.lib.yaml :as y] [clay.string :as str]))
;; canonical text of a value, matching the Python generator's canon()
(defn jstr Str [s: &Str]
  (loop [i 0 out "\""]
    (if (>= i (count s)) (str out "\"")
      (let [c (nth s i)]
        (recur (+ i 1)
               (cond (= c 34) (str out "\\\"") (= c 92) (str out "\\\\") (= c 10) (str out "\\n")
                     (= c 9) (str out "\\t") (= c 13) (str out "\\r") (= c 8) (str out "\\b") (= c 12) (str out "\\f")
                     (< c 32) (str out (if (< c 16) "\\u000" "\\u001") (subs "0123456789abcdef" (mod c 16) (+ (mod c 16) 1)))
                     :else (str out (chr c))))))))
(defn canon Str [v: &y/YVal]
  (match v
    (y/YNull) "~"
    (y/YBool b) (if b "true" "false")
    (y/YInt t) (let [[i ok] (y/int-value v)] (str "i:" i))
    (y/YFloat t) (let [[f ok] (y/float-value v)]
                   (cond (not (= f f)) "f:nan" (= f (exp 1000.0)) "f:inf" (= f (- 0.0 (exp 1000.0))) "f:-inf" :else (str "f:" (fmt-fixed f 6))))
    (y/YStr s) (jstr s)
    (y/YSeq xs) (loop [i 0 out "["] (if (>= i (count xs)) (str out "]") (recur (+ i 1) (str out (if (= i 0) "" ",") (canon (nth xs i))))))
    (y/YMap ks vs) (loop [i 0 out "{"] (if (>= i (count ks)) (str out "}") (recur (+ i 1) (str out (if (= i 0) "" ",") (canon (nth ks i)) ":" (canon (nth vs i))))))
    (y/YTagged t x) (str t " " (canon x))))
(defn canon-doc Str [src: Str] (let [[v err] (y/parse src)] (if (= err "") (canon v) (str "ERR " err))))
(defn canon-docs Str [src: Str]
  (let [[ds err] (y/parse-all src)]
    (if (not (= err "")) (str "ERR " err)
      (loop [i 0 out ""] (if (>= i (count ds)) out (recur (+ i 1) (str out (if (= i 0) "" "|") (canon (nth ds i)))))))))

(deftest pyyaml-cases
  (is (= (canon-doc "a: 1\nb: two\nc: 3.5\n") "{\"a\":i:1,\"b\":\"two\",\"c\":f:3.500000}"))
  (is (= (canon-doc "top:\n  mid:\n    leaf: x\n  other: y\nlast: z\n") "{\"top\":{\"mid\":{\"leaf\":\"x\"},\"other\":\"y\"},\"last\":\"z\"}"))
  (is (= (canon-doc "- a\n- b\n- - c\n  - d\n- e: 1\n  f: 2\n") "[\"a\",\"b\",[\"c\",\"d\"],{\"e\":i:1,\"f\":i:2}]"))
  (is (= (canon-doc "key:\n- x\n- y\nk2: v\n") "{\"key\":[\"x\",\"y\"],\"k2\":\"v\"}"))
  (is (= (canon-doc "key:\n  - x\n  -   y\nk2:\n") "{\"key\":[\"x\",\"y\"],\"k2\":~}"))
  (is (= (canon-doc "seq: [1, 2, [3, 4], {a: b}]\nmap: {x: 1, y: [a, b], 'q': \"r\"}\nempty: []\nem: {}\n") "{\"seq\":[i:1,i:2,[i:3,i:4],{\"a\":\"b\"}],\"map\":{\"x\":i:1,\"y\":[\"a\",\"b\"],\"q\":\"r\"},\"empty\":[],\"em\":{}}"))
  (is (= (canon-doc "[a, b: c, {d: e}]\n") "[\"a\",{\"b\":\"c\"},{\"d\":\"e\"}]"))
  (is (= (canon-doc "s1: 'it''s'\ns2: \"tab\\there\\nnl \\\"q\\\" \\\\ \\x41\\u00e9\\U0001F600\"\ns3: \"a\\\n  b\"\n") "{\"s1\":\"it's\",\"s2\":\"tab\\there\\nnl \\\"q\\\" \\\\ Aé😀\",\"s3\":\"ab\"}"))
  (is (= (canon-doc "plain: this is\n  a multi line\n\n  plain scalar\nnext: v\n") "{\"plain\":\"this is a multi line\\nplain scalar\",\"next\":\"v\"}"))
  (is (= (canon-doc "q: \"folded\n  quoted\n\n  text\"\nr: 'single\n  folded'\n") "{\"q\":\"folded quoted\\ntext\",\"r\":\"single folded\"}"))
  (is (= (canon-doc "lit: |\n  line1\n    indented\n  line3\nfold: >\n  a\n  b\n\n  c\n    more\n  d\nend: x\n") "{\"lit\":\"line1\\n  indented\\nline3\\n\",\"fold\":\"a b\\nc\\n  more\\nd\\n\",\"end\":\"x\"}"))
  (is (= (canon-doc "strip: |-\n  text\n\n\nkeep: |+\n  text\n\n\nclip: |\n  text\n\n\nlast: 1\n") "{\"strip\":\"text\",\"keep\":\"text\\n\\n\\n\",\"clip\":\"text\\n\",\"last\":i:1}"))
  (is (= (canon-doc "fs: >-\n  one\n  two\nfk: >+\n  one\n\nz: 0\n") "{\"fs\":\"one two\",\"fk\":\"one\\n\\n\",\"z\":i:0}"))
  (is (= (canon-doc "ind: |2\n    two extra\n   one extra\nx: 1\n") "{\"ind\":\"  two extra\\n one extra\\n\",\"x\":i:1}"))
  (is (= (canon-doc "a: &anc\n  x: 1\n  y: [1, 2]\nb: *anc\nc: &s scalar\nd: *s\n") "{\"a\":{\"x\":i:1,\"y\":[i:1,i:2]},\"b\":{\"x\":i:1,\"y\":[i:1,i:2]},\"c\":\"scalar\",\"d\":\"scalar\"}"))
  (is (= (canon-doc "# comment\na: 1 # trailing\n# middle\nb: [1, # in flow\n  2]\nc: 'x' # after quoted\n") "{\"a\":i:1,\"b\":[i:1,i:2],\"c\":\"x\"}"))
  (is (= (canon-doc "? complex key\n: complex value\n? [a, b]\n: seq key\n") "{\"complex key\":\"complex value\",[\"a\",\"b\"]:\"seq key\"}"))
  (is (= (canon-doc "n1: ~\nn2: null\nn3:\nn4: Null\nb1: true\nb2: False\ni1: -17\ni2: 0x1F\ni3: +5\nf1: 1.5\nf2: -.inf\nf3: .NaN\nf4: 6.02e+23\ns: 12abc\n") "{\"n1\":~,\"n2\":~,\"n3\":~,\"n4\":~,\"b1\":true,\"b2\":false,\"i1\":i:-17,\"i2\":i:31,\"i3\":i:5,\"f1\":f:1.500000,\"f2\":f:-inf,\"f3\":f:nan,\"f4\":f:601999999999999995805696.000000,\"s\":\"12abc\"}"))
  (is (= (canon-doc "t1: !!str 123\nt2: !!int \"42\"\nt3: !!float 1\nt4: !custom value\nt5: !!bool true\n") "{\"t1\":\"123\",\"t2\":i:42,\"t3\":f:1.000000,\"t4\":\"value\",\"t5\":true}"))
  (is (= (canon-doc "url: http://example.com:8080/path\ncolon: a:b\nhash: a#b\ndash: -x\nq: what?\nsp: a b  c\n") "{\"url\":\"http://example.com:8080/path\",\"colon\":\"a:b\",\"hash\":\"a#b\",\"dash\":\"-x\",\"q\":\"what?\",\"sp\":\"a b  c\"}"))
  (is (= (canon-doc "\"quoted key\": 1\n'single key': 2\n? plain\n: 3\n") "{\"quoted key\":i:1,\"single key\":i:2,\"plain\":i:3}"))
  (is (= (canon-doc "- &a [1, 2]\n- *a\n- !!str 5\n") "[[i:1,i:2],[i:1,i:2],\"5\"]"))
  (is (= (canon-doc "k: \"\"\nk2: ''\nk3: \" lead\"\n") "{\"k\":\"\",\"k2\":\"\",\"k3\":\" lead\"}"))
  (is (= (canon-doc "---\na: 1\n...\n") "{\"a\":i:1}"))
  (is (= (canon-doc "--- |\n  literal doc\n") "\"literal doc\\n\""))
  (is (= (canon-doc "list:\n- name: a\n  vals:\n  - 1\n  - 2\n- name: b\n  vals: []\n") "{\"list\":[{\"name\":\"a\",\"vals\":[i:1,i:2]},{\"name\":\"b\",\"vals\":[]}]}"))
  (is (= (canon-doc "unicode: \"\\u3042\"\njp: こんにちは\nemoji: 😀\n") "{\"unicode\":\"あ\",\"jp\":\"こんにちは\",\"emoji\":\"😀\"}"))
  (is (= (canon-doc "a:\n  b:\n    c:\n      d: deep\n  e: 1\n") "{\"a\":{\"b\":{\"c\":{\"d\":\"deep\"}},\"e\":i:1}}"))
  (is (= (canon-doc "- - - x\n    - y\n  - z\n") "[[[\"x\",\"y\"],\"z\"]]"))
  (is (= (canon-doc "{a: 1, b: [x, y], c: {d: e}}\n") "{\"a\":i:1,\"b\":[\"x\",\"y\"],\"c\":{\"d\":\"e\"}}"))
  (is (= (canon-doc "a: 'multi word string'\nb: \"with: colon\"\nc: [\"x, y\", 'z]']\n") "{\"a\":\"multi word string\",\"b\":\"with: colon\",\"c\":[\"x, y\",\"z]\"]}"))
  (is (= (canon-doc "folded_more: >\n  para one\n  continues\n\n    code block\n    code 2\n\n  para two\n") "{\"folded_more\":\"para one continues\\n\\n  code block\\n  code 2\\n\\npara two\\n\"}"))
  (is (= (canon-doc "flow_multiline: [a,\n  b,\n  c]\nfm: {a: 1,\n  b: 2}\n") "{\"flow_multiline\":[\"a\",\"b\",\"c\"],\"fm\":{\"a\":i:1,\"b\":i:2}}"))
  (is (= (canon-doc "empty_flow_vals: {a: , b: 2}\n") "{\"empty_flow_vals\":{\"a\":~,\"b\":i:2}}"))
  (is (= (canon-doc "a: 1\n\n\nb: 2\n") "{\"a\":i:1,\"b\":i:2}"))
  (is (= (canon-doc "%YAML 1.2\n---\nx: 1\n") "{\"x\":i:1}"))
  (is (= (canon-doc "anchors:\n  base: &base {x: 1}\n  use: *base\n") "{\"anchors\":{\"base\":{\"x\":i:1},\"use\":{\"x\":i:1}}}"))
  (is (= (canon-doc "- a\n-\n- c\n") "[\"a\",~,\"c\"]"))
  (is (= (canon-doc "a:\n  - b\n  -\n    c: d\n") "{\"a\":[\"b\",{\"c\":\"d\"}]}"))
  (is (= (canon-doc "nested: {a: [1, {b: [2, 3]}]}\n") "{\"nested\":{\"a\":[i:1,{\"b\":[i:2,i:3]}]}}"))
  (is (= (canon-doc "key with spaces: value with spaces\n") "{\"key with spaces\":\"value with spaces\"}"))
  (is (= (canon-doc "'a''b': \"c\\\"d\"\n") "{\"a'b\":\"c\\\"d\"}"))
  (is (= (canon-doc "tab_in_value: \"a\\tb\"\n") "{\"tab_in_value\":\"a\\tb\"}"))
  (is (= (canon-doc "block_in_seq:\n- |\n  lit\n  text\n- >\n  fold\n  text\n- x\n") "{\"block_in_seq\":[\"lit\\ntext\\n\",\"fold text\\n\",\"x\"]}"))
  (is (= (canon-doc "trailing_block: |\n  a\n") "{\"trailing_block\":\"a\\n\"}"))
  (is (= (canon-doc "keep_end: |+\n  a\n\n") "{\"keep_end\":\"a\\n\\n\"}"))
  (is (= (canon-doc "strip_empty: |-\n\nx: 1\n") "{\"strip_empty\":\"\",\"x\":i:1}"))
  (is (= (canon-doc "- key: value\n  key2:\n  - a\n  - b\n- k: v\n") "[{\"key\":\"value\",\"key2\":[\"a\",\"b\"]},{\"k\":\"v\"}]"))
  (is (= (canon-doc "a: 'x' # c\nb: \"y\" #c2\n") "{\"a\":\"x\",\"b\":\"y\"}"))
  (is (= (canon-doc "hello\n") "\"hello\""))
  (is (= (canon-doc "--- >\n  folded\n  text\n") "\"folded text\\n\""))
  (is (= (canon-doc "a:\n  # comment\n  b: 1\n  # another\n  c: 2\n") "{\"a\":{\"b\":i:1,\"c\":i:2}}"))
  (is (= (canon-doc "a: |\n\n  text after blank\n") "{\"a\":\"\\ntext after blank\\n\"}"))
  (is (= (canon-doc "a: >\n\n\n  x\n") "{\"a\":\"\\n\\nx\\n\"}"))
  (is (= (canon-doc "s: '  spaced  '\n") "{\"s\":\"  spaced  \"}"))
  (is (= (canon-doc "k: v\n...\n# trailing\n") "{\"k\":\"v\"}"))
  (is (= (canon-doc "? - a\n  - b\n: v\n") "{[\"a\",\"b\"]:\"v\"}"))
  (is (= (canon-doc "[a, b, ]\n") "[\"a\",\"b\"]"))
  (is (= (canon-doc "{\"a\":1, \"b\":[2]}\n") "{\"a\":i:1,\"b\":[i:2]}"))
  (is (= (canon-doc "{a, b: c}\n") "{\"a\":~,\"b\":\"c\"}"))
  (is (= (canon-doc "- &x item\n- *x\n") "[\"item\",\"item\"]"))
  (is (= (canon-doc "a: -1\nd: 1.\n") "{\"a\":i:-1,\"d\":f:1.000000}"))
  (is (= (canon-doc "k: v  \nk2: v2  \n") "{\"k\":\"v\",\"k2\":\"v2\"}"))
  (is (= (canon-doc (str "a: b" (chr 13) "\nc: d" (chr 13) "\n")) "{\"a\":\"b\",\"c\":\"d\"}"))
  (is (= (canon-doc "﻿a: 1\n") "{\"a\":i:1}"))
  (is (= (canon-doc "- - - \n") "[[[~]]]"))
  (is (= (canon-doc "seq:\n  - a\n  # comment between\n  - b\n") "{\"seq\":[\"a\",\"b\"]}"))
  (is (= (canon-doc "long: >-\n  one\n   two\n  three\n") "{\"long\":\"one\\n two\\nthree\"}"))
  (is (= (canon-doc "lit: |1\n  x\n y\n") "{\"lit\":\" x\\ny\\n\"}"))
  (is (= (canon-doc "x: \"\\u00e9\\t\\\\\"\n") "{\"x\":\"é\\t\\\\\"}"))
  (is (= (canon-doc "k1: [a,\n  b]\nk2: after\n") "{\"k1\":[\"a\",\"b\"],\"k2\":\"after\"}"))
  (is (= (canon-doc "nested:\n  - [1, 2]\n  - {a: b}\n  -\n    - deep\n") "{\"nested\":[[i:1,i:2],{\"a\":\"b\"},[\"deep\"]]}"))
  (is (= (canon-doc "q: \"line1\\nline2\"\n") "{\"q\":\"line1\\nline2\"}"))
  (is (= (canon-doc "'k': v\n\"k2\": v2\n") "{\"k\":\"v\",\"k2\":\"v2\"}"))
  (is (= (canon-doc "a: 1 # c\n# c2\n\nb:\n  c: 2\n") "{\"a\":i:1,\"b\":{\"c\":i:2}}"))
  (is (= (canon-doc "empty_seq_items:\n-\n-\n") "{\"empty_seq_items\":[~,~]}"))
  (is (= (canon-doc "k: &a !!str 5\nj: *a\n") "{\"k\":\"5\",\"j\":\"5\"}"))
  (is (= (canon-doc "plain_multi:\n  first\n  second\n\n  third\n") "{\"plain_multi\":\"first second\\nthird\"}"))
  (is (= (canon-doc "- a\n  b\n- c\n") "[\"a b\",\"c\"]"))
  (is (= (canon-doc "a: x\n  y\n") "{\"a\":\"x y\"}"))
  (is (= (canon-doc "? a\n? b\n: c\n") "{\"a\":~,\"b\":\"c\"}"))
  (is (= (canon-doc "top: {a: 1}\nbottom: [1]\n") "{\"top\":{\"a\":i:1},\"bottom\":[i:1]}"))
  (is (= (canon-doc "a:\n    deep: 1\n    deeper:\n        x: y\nb: 2\n") "{\"a\":{\"deep\":i:1,\"deeper\":{\"x\":\"y\"}},\"b\":i:2}"))
  (is (= (canon-doc "key: \"quoted: colon\"\n") "{\"key\":\"quoted: colon\"}"))
  (is (= (canon-doc "k: 'multi\n\n  para'\n") "{\"k\":\"multi\\npara\"}"))
  (is (= (canon-doc "block_keep_last: |+\n  a\n") "{\"block_keep_last\":\"a\\n\"}"))
  (is (= (canon-doc "- |-\n  x\n- >+\n  y\n\n- z\n") "[\"x\",\"y\\n\\n\",\"z\"]"))
  (is (= (canon-docs "a: 1\n---\nb: 2\n---\n- x\n") "{\"a\":i:1}|{\"b\":i:2}|[\"x\"]"))
  (is (= (canon-docs "--- 1\n--- two\n...\n--- [3]\n") "i:1|\"two\"|[i:3]"))
  (is (= (canon-docs "") ""))
  (is (= (canon-docs "# only comment\n") ""))
  (is (= (canon-docs "---\n---\n") "~|~"))
  (is (= (canon-docs "a: 1\n---\n...\n---\nb: 2\n") "{\"a\":i:1}|~|{\"b\":i:2}"))
  (is (= (canon-docs "--- # comment\nx\n--- |\n  y\n") "\"x\"|\"y\\n\""))
  (is (= (canon-docs "%YAML 1.2\n%TAG ! tag:example.com,2000:\n---\na: 1\n") "{\"a\":i:1}")))

(deftest keep-local-tags
  (let [o (y/->YOpts 400 1000000 true -1)
        [docs e] (y/parse-all-with "a: !include types/x.raml\nb: !!str 1\nc: !foo 2\n" o)
        [d2 e2] (y/parse "a: !include x.raml\n")]
    (is (= e ""))
    (is (match (let [[v f] (y/get-key (nth docs 0) "a")] v) (y/YTagged t x) (and (= t "!include") (= (y/scalar-text x) "types/x.raml")) _ false))
    (is (match (let [[v f] (y/get-key (nth docs 0) "b")] v) (y/YStr s) (= s "1") _ false))
    (is (match (let [[v f] (y/get-key (nth docs 0) "c")] v) (y/YTagged t x) (and (= t "!foo") (match x (y/YInt i) true _ false)) _ false))
    ;; 既定ではタグを捨てる
    (is (match (let [[v f] (y/get-key d2 "a")] v) (y/YStr s) (= s "x.raml") _ false))))
