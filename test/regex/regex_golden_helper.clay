(ns regex-golden-helper (:require [mulay.lib.numparse :as npz] [mulay.lib.regex :as re]))

;; Runs one golden case (see tools/gen-regex-golden.java for the encodings).

(defn- hexd Int [c: Int] (if (<= c 57) (- c 48) (- c 87)))

(defn unhex Str [h: &Str]
  (loop [i 0 out ""]
    (if (>= i (count h)) out
      (recur (+ i 2) (str out (chr (+ (* 16 (hexd (nth h i))) (hexd (nth h (+ i 1))))))))))

(defn- hx Str [b: Int] (let [d "0123456789abcdef"] (str (subs d (quot b 16) (+ (quot b 16) 1)) (subs d (mod b 16) (+ (mod b 16) 1)))))

(defn tohex Str [s: &Str]
  (loop [i 0 out ""] (if (>= i (count s)) out (recur (+ i 1) (str out (hx (nth s i)))))))

(defn- groups-str Str [m: &re/Match]
  (loop [g 0 out ""]
    (if (> g (re/groups m)) out
      (recur (+ g 1) (str out (if (> g 0) "|" "") (re/start m g) "," (re/end m g))))))

(defn- one Str [ms: &Vec(re/Match) e: &Str]
  (if (not= e "") (str "!" e)
    (if (= (count ms) 0) "F" (str "T:" (groups-str (nth ms 0))))))

(defn run-case Str [op: Str hp: Str fl: Int hin: Str hx: Str]
  (let [p (unhex hp)
        s (unhex hin)
        extra (unhex hx)
        [pat err] (re/compile p fl)]
    (if (not= err "")
      ;; "desc near index N\n..." -> "!desc@N"
      (let [nl (loop [i 0] (if (or (>= i (count err)) (= (nth err i) 10)) i (recur (+ i 1))))
            head (subs err 0 nl)
            k (loop [i (- (count head) 1)] (if (< i 0) -1 (if (and (<= (+ i 12) (count head)) (= (subs head i (+ i 12)) " near index ")) i (recur (- i 1)))))]
        (if (< k 0) (str "!" head "@-1")
          (str "!" (subs head 0 k) "@" (subs head (+ k 12) (count head)))))
      (case op
        "find" (let [[ms e] (re/find-all pat s)]
                 (if (not= e "") (str "!" e)
                   (loop [i 0 out ""]
                     (if (>= i (count ms)) out
                       (recur (+ i 1) (str out (if (> i 0) ";" "") (groups-str (nth ms i))))))))
        "matches" (let [[ms e] (re/match-full pat s)] (one ms e))
        "lookingAt" (let [[ms e] (re/looking-at pat s)] (one ms e))
        "replaceAll" (let [[r e] (re/replace-all pat s extra)] (if (not= e "") (str "!" e) (tohex r)))
        "replaceFirst" (let [[r e] (re/replace-first pat s extra)] (if (not= e "") (str "!" e) (tohex r)))
        "split" (let [[v e] (re/split pat s (npz/int-or extra 0))]
                  (if (not= e "") (str "!" e)
                    (loop [i 0 out (str (count v) ":")]
                      (if (>= i (count v)) out
                        (recur (+ i 1) (str out (if (> i 0) "," "") (tohex (nth v i))))))))
        (str "?op " op)))))
