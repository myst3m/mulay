(deftest golden-int-format
  (is (= (h/int-format 0) "0"))
  (is (= (h/int-format 1) "1"))
  (is (= (h/int-format 5) "5"))
  (is (= (h/int-format 999) "999"))
  (is (= (h/int-format 1000) "1,000"))
  (is (= (h/int-format 1234567) "1,234,567"))
  (is (= (h/int-format 150) "150"))
