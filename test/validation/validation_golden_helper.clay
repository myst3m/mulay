(ns validation-golden-helper (:require [mulay.dw.lib.validation :as vl]))

;; golden の 1 件 (tools/gen-validation-dw-golden.java)。文字列は UTF-8 の 16 進。

(defn- hexd Int [c: Int] (if (<= c 57) (- c 48) (- c 87)))

(defn unhex Str [h: &Str]
  (loop [i 0 out ""]
    (if (>= i (count h)) out
      (recur (+ i 2) (str out (chr (+ (* 16 (hexd (nth h i))) (hexd (nth h (+ i 1))))))))))

;; "N" か "型:文言の形"
(defn number Str [type: Str hv: Str hp: Str locale: Str]
  (let [[ns e] (vl/parse-number (unhex hv) (unhex hp) locale type)]
    (cond (not= e "") (str "err:" e)
          (= (count ns) 0) "N"
          :else (let [n (nth ns 0)] (str (:kind n) ":" (vl/format-num n))))))

(defn time Str [ht: Str hp: Str locale: Str]
  (let [[ok e] (vl/time-check (unhex ht) (unhex hp) locale)]
    (cond (not= e "") (str "err:" e) ok "ok" :else "fail")))

(defn int-format Str [n: Int] (vl/format-num (vl/->JNum "Integer" n 0.0)))
