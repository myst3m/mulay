(ns xml-expat-test (:require [mulay.lib.xml :as xml] [clay.string :as str]))
;; canonical event text matching the Python/expat generator: adjacent text and
;; CDATA merged, names as {uri}local, errors collapsed to ERR
(defn- qn Str [q: &xml/QName] (if (= (:uri q) "") (str (:local q)) (str "{" (:uri q) "}" (:local q))))
(defn canon Str [src: Str]
  (let [[r0 e0] (xml/reader src (xml/default-opts))]
    (if (not (= e0 "")) "ERR"
      (loop [r r0 out "" buf ""]
        (let [[r2 ev err] (xml/next-event r)
              fl (if (= buf "") out (str out "T(" buf ")"))]
          (if (not (= err "")) "ERR"
            (match ev
              (xml/XeText t) (recur r2 out (str buf t))
              (xml/XeCData t) (recur r2 out (str buf t))
              (xml/XeStart n as ns) (recur r2 (str fl "S(" (qn n)
                                                  (loop [i 0 o ""] (if (>= i (count as)) o (recur (+ i 1) (str o " " (qn (:name (nth as i))) "=" (:value (nth as i))))))
                                                  ")") "")
              (xml/XeEnd n) (recur r2 (str fl "E(" (qn n) ")") "")
              (xml/XeComment t) (recur r2 (str fl "!(" t ")") "")
              (xml/XePI t d) (recur r2 (str fl "?(" t "," d ")") "")
              (xml/XeEndDoc) fl
              _ (recur r2 fl ""))))))))

(deftest expat-agreement
  (is (= (canon (str "<a/>")) (str "S(a)E(a)")))
  (is (= (canon (str "<a></a>")) (str "S(a)E(a)")))
  (is (= (canon (str "<a>text</a>")) (str "S(a)T(text)E(a)")))
  (is (= (canon (str "<a b='1' c=\"2\"/>")) (str "S(a b=1 c=2)E(a)")))
  (is (= (canon (str "<a><b/><c>t</c></a>")) (str "S(a)S(b)E(b)S(c)T(t)E(c)E(a)")))
  (is (= (canon (str "<a>&lt;&gt;&amp;&apos;&quot;</a>")) (str "S(a)T(<>&'\")E(a)")))
  (is (= (canon (str "<a>&#65;&#x42;&#x10FFFF;</a>")) (str "S(a)T(AB􏿿)E(a)")))
  (is (= (canon (str "<a>&#0;</a>")) (str "ERR")))
  (is (= (canon (str "<a>&#xD800;</a>")) (str "ERR")))
  (is (= (canon (str "<a>éあ</a>")) (str "S(a)T(éあ)E(a)")))
  (is (= (canon (str "<a x='&lt;'/>")) (str "S(a x=<)E(a)")))
  (is (= (canon (str "<a x='<'/>")) (str "ERR")))
  (is (= (canon (str "<a x='\"'/>")) (str "S(a x=\")E(a)")))
  (is (= (canon (str "<a x=\"'\"/>")) (str "S(a x=')E(a)")))
  (is (= (canon (str "<a>]]></a>")) (str "ERR")))
  (is (= (canon (str "<a>]]</a>")) (str "S(a)T(]])E(a)")))
  (is (= (canon (str "<a><![CDATA[x]]y]]></a>")) (str "S(a)T(x]]y)E(a)")))
  (is (= (canon (str "<a><![CDATA[]]></a>")) (str "S(a)E(a)")))
  (is (= (canon (str "<a><!-- ok - comment --></a>")) (str "S(a)!( ok - comment )E(a)")))
  (is (= (canon (str "<a><!-- bad -- comment --></a>")) (str "ERR")))
  (is (= (canon (str "<a><!---></a>")) (str "ERR")))
  (is (= (canon (str "<a><!----></a>")) (str "S(a)!()E(a)")))
  (is (= (canon (str "<a><?pi?></a>")) (str "S(a)?(pi,)E(a)")))
  (is (= (canon (str "<a><?pi  data here ?></a>")) (str "S(a)?(pi,data here )E(a)")))
  (is (= (canon (str "<a><?xml bad?></a>")) (str "ERR")))
  (is (= (canon (str "<a><?XmL bad?></a>")) (str "ERR")))
  (is (= (canon (str "<?xml version='1.0'?><a/>")) (str "S(a)E(a)")))
  (is (= (canon (str "<?xml version='1.0' encoding='UTF-8' standalone='yes'?><a/>")) (str "S(a)E(a)")))
  (is (= (canon (str "<?xml version='1.0' standalone='maybe'?><a/>")) (str "ERR")))
  (is (= (canon (str "<?xml encoding='UTF-8'?><a/>")) (str "ERR")))
  (is (= (canon (str "<?xml version='1.0' encoding='UTF-8' version='1.0'?><a/>")) (str "ERR")))
  (is (= (canon (str "<a></b>")) (str "ERR")))
  (is (= (canon (str "<a>")) (str "ERR")))
  (is (= (canon (str "</a>")) (str "ERR")))
  (is (= (canon (str "<a/><b/>")) (str "ERR")))
  (is (= (canon (str "text")) (str "ERR")))
  (is (= (canon (str "<a/>text")) (str "ERR")))
  (is (= (canon (str " <a/> ")) (str "S(a)E(a)")))
  (is (= (canon (str "<a/><!--c--><?p?>")) (str "S(a)E(a)!(c)?(p,)")))
  (is (= (canon (str "<a b='1' b='2'/>")) (str "ERR")))
  (is (= (canon (str "<a b='1'b='2'/>")) (str "ERR")))
  (is (= (canon (str "<a b=1/>")) (str "ERR")))
  (is (= (canon (str "<a b/>")) (str "ERR")))
  (is (= (canon (str "<1a/>")) (str "ERR")))
  (is (= (canon (str "<a:b:c/>")) (str "ERR")))
  (is (= (canon (str "<:a/>")) (str "ERR")))
  (is (= (canon (str "<a:/>")) (str "ERR")))
  (is (= (canon (str "<p:a xmlns:p='u'/>")) (str "S({u}a)E({u}a)")))
  (is (= (canon (str "<p:a/>")) (str "ERR")))
  (is (= (canon (str "<a xmlns:p='u'><p:b p:x='1' x='2'/></a>")) (str "S(a)S({u}b {u}x=1 x=2)E({u}b)E(a)")))
  (is (= (canon (str "<a xmlns='u'><b xmlns=''/></a>")) (str "S({u}a)S(b)E(b)E({u}a)")))
  (is (= (canon (str "<a xmlns:p='u' xmlns:q='u' p:x='1' q:x='2'/>")) (str "ERR")))
  (is (= (canon (str "<a xmlns:p=''/>")) (str "ERR")))
  (is (= (canon (str "<a xmlns:xml='http://www.w3.org/XML/1998/namespace'/>")) (str "S(a)E(a)")))
  (is (= (canon (str "<a xmlns:xml='u'/>")) (str "ERR")))
  (is (= (canon (str "<a xmlns:xmlns='u'/>")) (str "ERR")))
  (is (= (canon (str "<a xml:lang='en'/>")) (str "S(a {http://www.w3.org/XML/1998/namespace}lang=en)E(a)")))
  (is (= (canon (str "<a xmlns:p='http://www.w3.org/XML/1998/namespace'/>")) (str "ERR")))
  (is (= (canon (str "<!DOCTYPE a><a/>")) (str "S(a)E(a)")))
  (is (= (canon (str "<!DOCTYPE a SYSTEM 'x.dtd'><a/>")) (str "S(a)E(a)")))
  (is (= (canon (str "<!DOCTYPE a PUBLIC '-//X//Y' 'x.dtd'><a/>")) (str "S(a)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ENTITY e 'v'>]><a>&e;</a>")) (str "S(a)T(v)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ENTITY e 'v'>]><a x='&e;'/>")) (str "S(a x=v)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ENTITY e '<b>x</b>'>]><a>&e;</a>")) (str "S(a)S(b)T(x)E(b)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ENTITY e '&#60;b/>'>]><a>&e;</a>")) (str "S(a)S(b)E(b)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ENTITY e '&#38;#60;'>]><a>&e;</a>")) (str "S(a)T(<)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ENTITY e 'x&f;'><!ENTITY f 'y'>]><a>&e;</a>")) (str "S(a)T(xy)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ENTITY e '&e;'>]><a>&e;</a>")) (str "ERR")))
  (is (= (canon (str "<!DOCTYPE a [<!ENTITY e 'v'><!ENTITY e 'w'>]><a>&e;</a>")) (str "S(a)T(v)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ELEMENT a (#PCDATA)><!ATTLIST a x CDATA 'd'><!-- c --><?p x?>]><a/>")) (str "S(a x=d)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ENTITY % p 'x'>]><a/>")) (str "S(a)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!NOTATION n SYSTEM 'x'>]><a/>")) (str "S(a)E(a)")))
  (is (= (canon (str "<a>&undef;</a>")) (str "ERR")))
  (is (= (canon (str "<a>&amp</a>")) (str "ERR")))
  (is (= (canon (str "<a>& b</a>")) (str "ERR")))
  (is (= (canon (str "<a>&#x;</a>")) (str "ERR")))
  (is (= (canon (str "<a>&#12a;</a>")) (str "ERR")))
  (is (= (canon (str "<a>\n  <b>  sp  </b>\n</a>")) (str "S(a)T(\n  )S(b)T(  sp  )E(b)T(\n)E(a)")))
  (is (= (canon (str "<a\n  x = '1'\n  y\t=\t\"2\"\n/>")) (str "S(a x=1 y=2)E(a)")))
  (is (= (canon (str "<a x='a\tb\nc'/>")) (str "S(a x=a b c)E(a)")))
  (is (= (canon (str "<a x='a&#9;b&#10;c'/>")) (str "S(a x=a\tb\nc)E(a)")))
  (is (= (canon (str "<a></a >")) (str "S(a)E(a)")))
  (is (= (canon (str "<a></ a>")) (str "ERR")))
  (is (= (canon (str "< a/>")) (str "ERR")))
  (is (= (canon (str "<a/ >")) (str "ERR")))
  (is (= (canon (str "<a b='1'/ >")) (str "ERR")))
  (is (= (canon (str "<!DOCTYPE a><!DOCTYPE a><a/>")) (str "ERR")))
  (is (= (canon (str "<a/><!DOCTYPE a>")) (str "ERR")))
  (is (= (canon (str "<!-- c --><!DOCTYPE a><a/>")) (str "!( c )S(a)E(a)")))
  (is (= (canon (str "<a>" (chr 1) "</a>")) (str "ERR")))
  (is (= (canon (str "<a x='" (chr 1) "'/>")) (str "ERR")))
  (is (= (canon (str "<a>￾</a>")) (str "ERR")))
  (is (= (canon (str "<a>\t" (chr 13) "\n</a>")) (str "S(a)T(\t\n)E(a)")))
  (is (= (canon (str "<a><b><c><d><e/></d></c></b></a>")) (str "S(a)S(b)S(c)S(d)S(e)E(e)E(d)E(c)E(b)E(a)")))
  (is (= (canon (str "<é/>")) (str "S(é)E(é)")))
  (is (= (canon (str "<a é='1'/>")) (str "S(a é=1)E(a)")))
  (is (= (canon (str "<a>x<![CDATA[y]]>z</a>")) (str "S(a)T(xyz)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ENTITY e SYSTEM 'x'>]><a/>")) (str "S(a)E(a)")))
  ;; expat は外部実体への参照を読み飛ばすが、mulay は Woodstox (実 DW) と同じく誤りにする
  (is (= (canon (str "<!DOCTYPE a [<!ENTITY e SYSTEM 'x'>]><a>&e;</a>")) (str "ERR")))
  (is (= (canon (str "<!DOCTYPE a [ <!ENTITY e 'v' > ]><a>&e;</a>")) (str "S(a)T(v)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ATTLIST a x CDATA 'd' y CDATA #IMPLIED z CDATA #FIXED 'f'>]><a y='1'/>")) (str "S(a y=1 x=d z=f)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ATTLIST a x NMTOKENS 'd'>]><a x='  p   q  '/>")) (str "S(a x=p q)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ATTLIST a x CDATA 'd'>]><a x='  p   q  '/>")) (str "S(a x=  p   q  )E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ATTLIST a xmlns:p CDATA 'urn:p'>]><a><p:b/></a>")) (str "S(a)S({urn:p}b)E({urn:p}b)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ATTLIST a x (u|v) 'u'>]><a/>")) (str "S(a x=u)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ENTITY e 'ev'><!ATTLIST a x CDATA '&e;!'>]><a/>")) (str "S(a x=ev!)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ATTLIST a x CDATA 'd'><!ATTLIST a x CDATA 'e'>]><a/>")) (str "S(a x=d)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ATTLIST b x CDATA 'd'>]><a><b/><c/></a>")) (str "S(a)S(b x=d)E(b)S(c)E(c)E(a)")))
  (is (= (canon (str "<!DOCTYPE a [<!ENTITY e \"it's\">]><a>&e;</a>")) (str "S(a)T(it's)E(a)")))
  (is true))
