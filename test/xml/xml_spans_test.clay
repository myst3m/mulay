(ns xml-spans-test (:require [mulay.lib.xml :as xml]))
(defn sopts xml/XmlOpts [] (assoc (xml/default-opts) :spans true))
(defn sp Str [ls: &xml/XLines]
  (let [s (:span ls)] (str (:open s) "," (:open-end s) "," (:close s) "," (:close-end s))))
(defn asp Str [ls: &xml/XLines i: Int]
  (let [a (nth (:attrs (:span ls)) i)]
    (str (:name a) "=" (:raw a) " " (:start a) "," (:end a) " " (:vstart a) "," (:vend a) " " (:quote a))))
(defn kid xml/XLines [ls: &xml/XLines i: Int] (nth (:kids ls) i))
(deftest spans-basic
  (let [[d ls err] (xml/parse-with-lines "<a x=\"1\" y='2'><b/></a>" (sopts))]
    (is (= err ""))
    (is (= (sp ls) "0,15,19,23"))
    (is (= (sp (kid ls 0)) "15,19,-1,-1"))
    (is (= (count (:attrs (:span ls))) 2))
    (is (= (asp ls 0) "x=1 3,8 6,7 34"))
    (is (= (asp ls 1) "y=2 9,14 12,13 39"))
    (is (= (count (:attrs (:span (kid ls 0)))) 0))))
(deftest spans-raw-value
  (let [[d ls err] (xml/parse-with-lines "<a x = \"&lt;&#65;\" xmlns:p=\"u\" />" (sopts))]
    (is (= err ""))
    (is (= (sp ls) "0,33,-1,-1"))
    (is (= (asp ls 0) "x=&lt;&#65; 3,18 8,17 34"))
    (is (= (asp ls 1) "xmlns:p=u 19,30 28,29 34"))))
(deftest spans-utf8-bytes
  (let [[d ls err] (xml/parse-with-lines "<a x=\"日本\"><b/></a>" (sopts))]
    (is (= (sp ls) "0,14,18,22"))
    (is (= (asp ls 0) "x=日本 3,13 6,12 34"))
    (is (= (sp (kid ls 0)) "14,18,-1,-1"))))
(deftest spans-bom-crlf
  (let [src (str (chr 239) (chr 187) (chr 191) "<a>" (chr 13) (chr 10) "<b\r\n y=\"1\"/>" (chr 13) (chr 10) "</a>")
        [d ls err] (xml/parse-with-lines src (sopts))]
    (is (= err ""))
    (is (= (sp ls) "3,6,22,26"))
    (is (= (sp (kid ls 0)) "8,20,-1,-1"))
    (is (= (asp (kid ls 0) 0) "y=1 13,18 16,17 34"))
    (is (= (:line (kid ls 0)) 2))))
(deftest spans-lone-cr
  (let [[d ls err] (xml/parse-with-lines (str "<a>" (chr 13) "<b/></a>") (sopts))]
    (is (= (sp (kid ls 0)) "4,8,-1,-1"))
    (is (= (sp ls) "0,3,8,12"))))
(deftest spans-entity
  (let [[d ls err] (xml/parse-with-lines "<!DOCTYPE a [<!ENTITY e \"<b/>\">]><a>&e;<c/></a>" (sopts))]
    (is (= err ""))
    (is (= (sp (kid ls 0)) "-1,-1,-1,-1"))
    (is (= (sp (kid ls 1)) "39,43,-1,-1"))
    (is (= (sp ls) "33,36,43,47"))))
(deftest spans-off
  (let [[d ls err] (xml/parse-with-lines "<a x=\"1\"><b/></a>" (xml/default-opts))]
    (is (= (sp ls) "-1,-1,-1,-1"))
    (is (= (count (:attrs (:span ls))) 0))
    (is (= (:line (kid ls 0)) 1))))
