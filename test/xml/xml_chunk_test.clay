(ns xml-chunk-test (:require [mulay.lib.xml :as xml] [clay.string :as str]))

(defn- show Str [out: Str ev: &xml/XEvent]
  (match ev
    (xml/XeStartDoc v e s) (str out "SD(" v "," e "," s ")")
    (xml/XeDoctype n p s) (str out "DT(" n ")")
    (xml/XeStart n as ns) (str out "S(" (xml/qname-str n) "{" (:uri n) "}"
                               (loop [i 0 o ""] (if (>= i (count as)) o (recur (+ i 1) (str o " " (xml/qname-str (:name (nth as i))) "=" (:value (nth as i))))))
                               ")")
    (xml/XeEnd n) (str out "E(" (xml/qname-str n) ")")
    (xml/XeText t) (str out "T(" t ")")
    (xml/XeCData t) (str out "C(" t ")")
    (xml/XeComment t) (str out "!(" t ")")
    (xml/XePI t d) (str out "?(" t "," d ")")
    (xml/XeEndDoc) (str out "ED")))

(defn- merge-text Str [s: &Str] (str/replace (str/replace s ")T(" "") "<keep>" ""))

(defn- whole Str [src: Str]
  (let [[r0 e0] (xml/reader src (xml/default-opts))]
    (if (not (= e0 "")) (str "ERR " e0)
      (loop [r r0 out ""]
        (let [[r2 ev err] (xml/next-event r)]
          (cond (not (= err "")) (str out "ERR " err)
                (match ev (xml/XeEndDoc) true _ false) (show out ev)
                :else (recur r2 (show out ev))))))))

(defn- chunked Str [src: Str size: Int]
  (let [[r0 e0] (xml/reader-chunked (xml/default-opts))]
    (loop [r r0 off 0 out ""]
      (let [[r2 ev need err] (xml/next-chunk r)]
        (cond
          need (let [end (if (> (+ off size) (count src)) (count src) (+ off size))
                     [r3 fe] (xml/feed r2 (subs src off end) (>= end (count src)))]
                 (if (not= fe "") (str out "ERR " fe) (recur r3 end out)))
          (not (= err "")) (str out "ERR " err)
          (match ev (xml/XeEndDoc) true _ false) (show out ev)
          :else (recur r2 off (show out ev)))))))

(defn- same Bool [src: Str]
  (let [w (merge-text (whole src))]
    (loop [i 0]
      (if (>= i 7) true
        (let [size (nth [1 2 3 5 7 64 1000000] i)
              c (merge-text (chunked src size))]
          (if (= c w) (recur (+ i 1)) (do (eprintln (str "DIFF size " size "\n  whole: " w "\n  chunk: " c)) false)))))))

