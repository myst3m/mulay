(deftest chunked-events-equal-whole
  (is (loop [i 0] (if (>= i (count DOCS)) true (if (same (nth DOCS i)) (recur (+ i 1)) false)))))

(deftest chunked-reader-needs-input-first
  (let [[r0 e0] (xml/reader-chunked (xml/default-opts))
        [r1 ev need err] (xml/next-chunk r0)]
    (is need)))
