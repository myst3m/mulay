(ns xml-snapshot-test (:require [mulay.dw.fmt.xml :as xmlf] [mulay.dw.fmt.registry :as reg] [mulay.dw.val :as v] [mulay.dw.err :as dwe]
                                [mulay.lib.host :as host] [clay.string :as str]))

(def DIR "test/fixtures/xml-read")

(def SIZES [1 2 3 7 64 1000000])

(defn- json Str [x: &v/Val]
  (let [[t e] (reg/write-fmt "application/json" [(v/field "indent" (v/bool-v false)) (v/field "writeAttributes" (v/bool-v true))] x)] (if (dwe/ok? e) t (str "WERR " (:msg e)))))

(defn- src xmlf/XSrc [text: Str size: Int]
  (let [pos (atom 0) t text n size]
    (xmlf/->XSrc (fn Values(Str Bool Str) [k: Int]
                   (let [p (deref pos)
                         end (if (> (+ p n) (count t)) (count t) (+ p n))
                         z (reset! pos end)]
                     (values (subs t p end) (>= end (count t)) "")))
                 (fn Int [k: Int] 0))))

(defn- whole Str [text: &Str props: &Vec(v/Field)]
  (let [[x e] (xmlf/read-named text props "application/xml" "payload")]
    (if (not= e "") (str "ERR " e) (json x))))

(defn- lazy Str [text: Str props: &Vec(v/Field) size: Int]
  (let [t text n size
        [x ok] (xmlf/lazy-read (fn xmlf/XSrc [k: Int] (src t n)) props "application/xml" "payload")]
    (if (not ok) "NOT-LAZY"
      (let [[y e] (v/whole-deep x)] (if (dwe/ok? e) (json y) (str "ERR " (:msg e)))))))

(defn- opts Vec(v/Field) [k: Int]
  (cond (= k 1) [(v/field "nullValueOn" (v/->VStr "empty"))]
        (= k 2) [(v/field "nullValueOn" (v/->VStr "none"))]
        (= k 3) [(v/field "maxAttributeSize" (v/->VStr "3"))]
        (= k 4) [(v/field "supportDtd" (v/bool-v true))]
        (= k 5) [(v/field "supportDtd" (v/bool-v true)) (v/field "maxEntityCount" (v/->VStr "2"))]
        :else []))

(defn- record Str [doc: &Str k: Int]
  (let [ps (opts k)
        w (whole doc ps)]
    (loop [i 0 out (str w "\n")]
      (if (>= i (count SIZES)) out
        (let [l (lazy (str doc) ps (nth SIZES i))
              c (cond (= l "NOT-LAZY") "N" (= l w) "L" :else (str "D:" l "\n"))]
          (recur (+ i 1) (str out c)))))))

(defn- read-lp Vec(Str) [data: &Str]
  (loop [i 0 acc: Vec(Str) []]
    (if (>= i (count data)) acc
      (let [nl (str/index-of-byte data i 10)
            [n e] (parse-long (subs data i nl))
            a (+ nl 1)]
        (recur (+ a n 1) (conj acc (subs data a (+ a n))))))))

(defn- lp Str [out: Str x: &Str] (str out (count x) "\n" x "\n"))

(defn- records Vec(Str) [docs: &Vec(Str)]
  (loop [d 0 acc: Vec(Str) []]
    (if (>= d (count docs)) acc
      (recur (+ d 1) (loop [k 0 a acc] (if (>= k 6) a (recur (+ k 1) (conj a (record (nth docs d) k)))))))))

(defn- diffs Int [got: &Vec(Str) want: &Vec(Str)]
  (loop [i 0 bad 0]
    (if (>= i (count got)) bad
      (let [w (if (< i (count want)) (nth want i) "<missing>")]
        (if (= (nth got i) w) (recur (+ i 1) bad)
          (let [z (if (< bad 5) (eprintln (str "DIFF doc " (quot i 6) " opts " (mod i 6) "\n  want: " w "\n  got:  " (nth got i))) 0)]
            (recur (+ i 1) (+ bad 1))))))))

(deftest dw-xml-reads-match-the-snapshot
  (let [[data e] (host/file-read (str DIR "/docs.lp"))
        docs (read-lp data)
        got (records docs)
        joined (loop [i 0 out ""] (if (>= i (count got)) out (recur (+ i 1) (lp out (nth got i)))))
        write (not= (getenv "MULAY_XML_SNAPSHOT_WRITE" "") "")
        w (if write (host/file-write (str DIR "/expected.lp") joined) "")
        [wdata e2] (host/file-read (str DIR "/expected.lp"))
        want (read-lp wdata)
        bad (diffs got want)]
    (is (and (= e "") (= e2 "") (> (count docs) 400) (= (count got) (count want)) (= bad 0)))))
