(ns bigint-test (:require [mulay.lib.bigint :as bi] [clay.bigint :as big]))

;; mulay.lib.bigint の境界条件 (Java BigInteger との大量照合は golden_test.clay)。

(defn- b big/BigInt [s: Str] (let [[x e] (bi/parse s)] x))
(defn- s Str [x: big/BigInt] (bi/to-string x))
(defn- perr Str [x: Str] (let [[v e] (bi/parse x)] e))
(defn- pw Str [x: Str e: Int] (let [[p err] (bi/pow-big (b x) e)] (if (= err "") (s p) "ERR")))
(defn- dm Str [x: Str y: Str]
  (let [[q r e] (bi/divmod (b x) (b y))] (if (= e "") (str (s q) " " (s r)) e)))
(defn- ti Str [x: Str] (let [[n e] (bi/to-int (b x))] (if (= e "") (str n) "ERR")))
(defn- dms Str [x: Str k: Int] (let [[q r] (bi/divmod-small (b x) k)] (str (s q) " " r)))
(defn- dp10 Str [x: Str n: Int] (let [[q r] (bi/divmod-pow10 (b x) n)] (str (s q) " " (s r))))
(defn- imin Int [] (- -9223372036854775807 1))
(defn- imax Int [] 9223372036854775807)

(deftest bi-parse-and-str
  (is (= (s (b "123456789012345678901234567890")) "123456789012345678901234567890"))
  (is (= (s (b "-0")) "0"))
  (is (= (s (b "+0007")) "7"))
  (is (= (s (b "1000000000")) "1000000000"))
  (is (= (s (b "999999999")) "999999999"))
  (is (= (s (b "-1000000000000000000")) "-1000000000000000000"))
  (is (not (= (perr "") "")))
  (is (not (= (perr "-") "")))
  (is (not (= (perr "+") "")))
  (is (not (= (perr "1.5") "")))
  (is (not (= (perr " 1") "")))
  (is (not (= (perr "1e3") "")))
  (is (= (perr "-12") "")))

(deftest bi-normal-form
  (is (= (s (b "-0")) "0"))
  (is (= (bi/sign (b "-0")) 0))
  (is (= (s (b "000000000000000000000")) "0"))
  (is (= (s (bi/sub (b "-5") (b "-5"))) "0"))
  (is (= (s (bi/neg (bi/zero))) "0"))
  (is (= (s (bi/mul (b "-5") (bi/zero))) "0"))
  (is (= (bi/num-digits (bi/sub (b "1000000000000000000") (b "999999999999999999"))) 1))
  (is (= (bi/num-digits (bi/from-int 1000000000)) 10)))

(deftest bi-int-conversion
  (is (= (s (bi/from-int 0)) "0"))
  (is (= (s (bi/from-int -1)) "-1"))
  (is (= (s (bi/from-int (imax))) "9223372036854775807"))
  (is (= (s (bi/from-int (imin))) "-9223372036854775808"))
  (is (= (ti "9223372036854775807") "9223372036854775807"))
  (is (= (ti "-9223372036854775808") "-9223372036854775808"))
  (is (= (ti "9223372036854775808") "ERR"))
  (is (= (ti "-9223372036854775809") "ERR"))
  (is (= (ti "0") "0"))
  (is (bi/fits-int? (b "-9223372036854775808")))
  (is (not (bi/fits-int? (b "9223372036854775808"))))
  (is (not (bi/fits-int? (b "1000000000000000000000000000")))))

(deftest bi-arith
  (is (= (s (bi/add (b "999999999999999999") (b "1"))) "1000000000000000000"))
  (is (= (s (bi/add (b "-5") (b "3"))) "-2"))
  (is (= (s (bi/add (b "5") (b "-8"))) "-3"))
  (is (= (s (bi/sub (b "-5") (b "-8"))) "3"))
  (is (= (s (bi/sub (b "1000000000") (b "1"))) "999999999"))
  (is (= (s (bi/mul (b "-123456789123456789") (b "987654321987654321"))) "-121932631356500531347203169112635269"))
  (is (= (s (bi/mul (b "-3") (b "-4"))) "12"))
  (is (= (s (bi/mul-int (b "123") -1000000000)) "-123000000000"))
  (is (= (s (bi/mul-int (b "-2") (imin))) "18446744073709551616"))
  (is (= (s (bi/add-int (b "999999999") 1)) "1000000000"))
  (is (= (bi/cmp (b "-10") (b "-9")) -1))
  (is (= (bi/cmp (b "10") (b "-11")) 1))
  (is (= (bi/cmp (b "0") (b "-0")) 0))
  (is (= (bi/cmp-abs (b "-10") (b "9")) 1))
  (is (= (bi/sign (b "-3")) -1))
  (is (= (bi/sign (b "0")) 0))
  (is (= (s (bi/abs-big (b "-3"))) "3"))
  (is (bi/is-zero? (b "-0")))
  (is (bi/even-big? (b "0")))
  (is (not (bi/even-big? (b "-1000000001")))))

(deftest bi-divmod
  ;; Java と同じ切り捨て: 商は 0 方向、剰余の符号は被除数
  (is (= (dm "7" "2") "3 1"))
  (is (= (dm "7" "-2") "-3 1"))
  (is (= (dm "-7" "2") "-3 -1"))
  (is (= (dm "-7" "-2") "3 -1"))
  (is (= (dm "0" "5") "0 0"))
  (is (= (dm "3" "5") "0 3"))
  (is (= (dm "-3" "5") "0 -3"))
  (is (= (dm "5" "0") "BigInteger divide by zero"))
  (is (= (dm "1000000000000000000000000000" "1000000000") "1000000000000000000 0"))
  (is (= (dm "1000000000000000000000000001" "999999999999999999") "1000000000 1000000001"))
  (is (= (dms "-1000000007" 10) "-100000000 -7"))
  (is (= (dms "1000000007" -10) "-100000000 7")))

(deftest bi-pow-gcd
  (is (= (pw "2" 100) "1267650600228229401496703205376"))
  (is (= (pw "0" 0) "1"))
  (is (= (pw "-2" 3) "-8"))
  (is (= (pw "-2" 0) "1"))
  (is (= (pw "7" -1) "ERR"))
  (is (= (s (bi/gcd (b "0") (b "0"))) "0"))
  (is (= (s (bi/gcd (b "-12") (b "18"))) "6"))
  (is (= (s (bi/gcd (b "0") (b "-7"))) "7")))

(deftest bi-pow10
  (is (= (s (bi/pow10 0)) "1"))
  (is (= (s (bi/pow10 9)) "1000000000"))
  (is (= (s (bi/pow10 20)) "100000000000000000000"))
  (is (= (s (bi/mul-pow10 (b "-12") 10)) "-120000000000"))
  (is (= (s (bi/mul-pow10 (b "0") 10)) "0"))
  (is (= (bi/num-digits (b "0")) 1))
  (is (= (bi/num-digits (b "-999999999")) 9))
  (is (= (bi/num-digits (b "1000000000")) 10))
  (is (= (bi/trailing-zeros (b "12000000000000")) 12))
  (is (= (bi/trailing-zeros (b "0")) 0))
  (is (= (dp10 "-123456789012345" 7) "-12345678 -9012345"))
  (is (= (dp10 "123000000000" 9) "123 0"))
  (is (= (dp10 "123" 20) "0 123")))

(deftest int-overflow
  (is (bi/add-ov? (imax) 1))
  (is (bi/add-ov? (imin) -1))
  (is (bi/add-ov? -1 (imin)))
  (is (not (bi/add-ov? (imax) 0)))
  (is (not (bi/add-ov? (imax) (imin))))
  (is (not (bi/add-ov? -5 7)))
  (is (bi/sub-ov? 0 (imin)))
  (is (not (bi/sub-ov? -1 (imin))))
  (is (bi/sub-ov? (imin) 1))
  (is (bi/sub-ov? (imax) -1))
  (is (not (bi/sub-ov? (imin) (imin))))
  (is (bi/mul-ov? -1 (imin)))
  (is (bi/mul-ov? (imin) -1))
  (is (not (bi/mul-ov? (imin) 1)))
  (is (not (bi/mul-ov? 0 (imin))))
  (is (not (bi/mul-ov? (imin) 0)))
  (is (bi/mul-ov? 3037000500 3037000500))
  (is (not (bi/mul-ov? 3037000499 3037000499)))
  (is (bi/mul-ov? -3037000500 3037000500))
  (is (not (bi/mul-ov? 2 (quot (imin) 2))))
  (is (bi/mul-ov? -2 (quot (imin) 2)))
  (is (not (bi/mul-ov? -2 (quot (imax) 2)))))
