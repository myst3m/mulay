(ns dtoa-long-test (:require [mulay.lib.dec :as d] [mulay.lib.ieee :as ie] [dtoa-long-data :as g]))

(deftest java17-double-tostring-large-integers
  (let [bad (loop [i 0 acc: Vec(Str) []]
              (if (>= i (count g/CASES)) acc
                (let [c (nth g/CASES i)
                      [b be] (parse-long (nth c 0))
                      got (d/float->shortest-str (ie/bits->double b))]
                  (recur (+ i 1) (if (= got (nth c 1)) acc (conj acc (str (nth c 1) " got " got)))))))]
    (is (= bad []))))
