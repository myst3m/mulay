(ns dec-test (:require [mulay.lib.numparse :as npz] [mulay.lib.dec :as d] [mulay.lib.bigint :as bi]))

;; mulay.lib.dec の境界条件 (Java BigDecimal との大量照合は golden_test.clay)。
;; 期待値は Java 21 の BigDecimal / Double で確かめたもの。

(defn- p d/Dec [s: Str] (let [[x e] (d/parse s)] x))
(defn- ts Str [s: Str] (d/to-string (p s)))
(defn- pl Str [s: Str] (d/to-plain-str (p s)))
(defn- perr Str [s: Str] (let [[x e] (d/parse s)] (if (= e "") "ok" "ERR")))
(defn- r Str [x: d/Dec e: Str] (if (= e "") (d/to-string x) e))
(defn- dv Str [a: Str b: Str] (let [[q e] (d/div (p a) (p b) d/DECIMAL128 d/HALF-EVEN)] (r q e)))
(defn- dx Str [a: Str b: Str] (let [[q e] (d/div-exact (p a) (p b))] (r q e)))
(defn- dsc Str [a: Str b: Str sc: Int m: Int] (let [[q e] (d/div-scale (p a) (p b) sc m)] (r q e)))
(defn- dmc Str [a: Str b: Str pr: Int m: Int] (let [[q e] (d/div-mc (p a) (p b) pr m)] (r q e)))
(defn- ss Str [a: Str sc: Int m: Int] (let [[q e] (d/set-scale (p a) sc m)] (r q e)))
(defn- rd Str [a: Str pr: Int m: Int] (let [[q e] (d/round-mc (p a) pr m)] (r q e)))
(defn- rm Str [a: Str b: Str] (let [[q e] (d/rem-dec (p a) (p b))] (r q e)))
(defn- pw Str [a: Str n: Int] (let [[q e] (d/pow-exact (p a) n)] (r q e)))
(defn- pwm Str [a: Str n: Int pr: Int] (let [[q e] (d/pow-mc (p a) n pr d/HALF-UP)] (r q e)))
(defn- ti Str [a: Str] (let [[n e] (d/to-int-exact (p a))] (if (= e "") (str n) e)))
(defn- ad Str [a: Str b: Str] (let [[x e] (d/add (p a) (p b))] (r x e)))
(defn- sb Str [a: Str b: Str] (let [[x e] (d/sub (p a) (p b))] (r x e)))
(defn- fl Str [a: Str] (let [[x e] (d/floor-int (p a))] (r x e)))
(defn- tb Str [a: Str] (let [[x e] (d/to-big (p a))] (if (= e "") (bi/to-string x) e)))
(defn- ff Str [x: Float] (let [[q e] (d/from-float x)] (r q e)))
(defn- fs Str [x: Str] (d/float->shortest-str (npz/flt x)))
(defn- md Int [s: Str] (let [[m e] (d/mode-of-str s)] (if (= e "") m -1)))

(deftest dec-parse
  (is (= (ts "-12.340") "-12.340"))
  (is (= (ts "1e-3") "0.001"))
  (is (= (ts ".5") "0.5"))
  (is (= (ts "-.5") "-0.5"))
  (is (= (ts "5.") "5"))
  (is (= (ts "+1.50") "1.50"))
  (is (= (ts "1E+10") "1E+10"))
  (is (= (ts "1e10") "1E+10"))
  (is (= (ts "-0") "0"))
  (is (= (ts "-0.00") "0.00"))
  (is (= (d/scale (p "1.5E+3")) -2))
  (is (= (bi/to-string (d/unscaled (p "-00012.3400"))) "-123400"))
  (is (= (perr "") "ERR"))
  (is (= (perr ".") "ERR"))
  (is (= (perr "e5") "ERR"))
  (is (= (perr "1e") "ERR"))
  (is (= (perr "1e+") "ERR"))
  (is (= (perr "1.2.3") "ERR"))
  (is (= (perr " 1") "ERR"))
  (is (= (perr "1 ") "ERR"))
  (is (= (perr "NaN") "ERR"))
  (is (= (perr "1e2147483648") "ok"))
  (is (= (perr "1e-2147483648") "ERR"))
  (is (= (perr "1E-0000000000000000000000007") "ok")))

(deftest dec-to-str-exponent-boundary
  ;; scale >= 0 かつ adjusted >= -6 なら指数なし
  (is (= (ts "0.000001") "0.000001"))
  (is (= (ts "0.0000001") "1E-7"))
  (is (= (ts "0.00000123") "0.00000123"))
  (is (= (ts "0.000000123") "1.23E-7"))
  (is (= (ts "123E-10") "1.23E-8"))
  (is (= (ts "0E-6") "0.000000"))
  (is (= (ts "0E-7") "0E-7"))
  (is (= (ts "0E+3") "0E+3"))
  (is (= (ts "-1E+3") "-1E+3"))
  (is (= (ts "1.23E+3") "1.23E+3"))
  (is (= (ts "1230E+0") "1230"))
  (is (= (d/to-string (d/of (bi/from-int 123) -1)) "1.23E+3"))
  (is (= (pl "1E+3") "1000"))
  (is (= (pl "0E+3") "0"))
  (is (= (pl "-1.23E-7") "-0.000000123"))
  (is (= (pl "0E-7") "0.0000000"))
  (is (= (pl "-12.5") "-12.5")))

(deftest dec-arith
  (is (= (ad "1.5" "2.25") "3.75"))
  (is (= (ad "1E+3" "1") "1001"))
  (is (= (ad "0.10" "-0.1") "0.00"))
  (is (= (sb "1" "3.000") "-2.000"))
  (is (= (d/to-string (d/mul (p "1.5") (p "2.00"))) "3.000"))
  (is (= (d/to-string (d/mul (p "-1.5") (p "0"))) "0.0"))
  (is (= (d/to-string (d/mul (p "1E+2") (p "1E+3"))) "1E+5"))
  (is (= (d/to-string (d/neg (p "0.0"))) "0.0"))
  (is (= (d/to-string (d/neg (p "1.20"))) "-1.20"))
  (is (= (d/to-string (d/abs-dec (p "-1.20"))) "1.20"))
  (is (= (d/signum (p "-0.001")) -1))
  (is (= (d/signum (p "0E+5")) 0))
  (is (= (d/precision (p "0")) 1))
  (is (= (d/precision (p "0.00")) 1))
  (is (= (d/precision (p "-123.45")) 5))
  (is (= (d/precision (p "1E+100")) 1)))

(deftest dec-compare
  (is (= (d/cmp (p "1.0") (p "1.00")) 0))
  (is (d/eq-numeric? (p "1.0") (p "1.00")))
  (is (not (d/equals? (p "1.0") (p "1.00"))))
  (is (d/equals? (p "1.00") (p "100E-2")))
  (is (= (d/cmp (p "-0.00") (p "0")) 0))
  (is (= (d/cmp (p "-2") (p "-10")) 1))
  (is (= (d/cmp (p "1E+3") (p "999.999")) 1))
  (is (= (d/cmp (p "0.001") (p "1E-4")) 1))
  (is (= (d/cmp (p "-1E+3") (p "-999.999")) -1))
  (is (= (d/cmp (p "5") (p "-5")) 1)))

(deftest dec-div
  (is (= (dv "1" "3") "0.3333333333333333333333333333333333"))
  (is (= (dv "2" "3") "0.6666666666666666666666666666666667"))
  (is (= (dv "-2" "3") "-0.6666666666666666666666666666666667"))
  (is (= (dv "10" "4") "2.5"))
  (is (= (dv "1.00" "4") "0.25"))
  (is (= (dv "100" "0.25") "4E+2"))
  (is (= (dv "1" "1024") "0.0009765625"))
  (is (= (dv "0" "5.00") "0E+2"))
  (is (= (dv "1" "0") "Division by zero"))
  (is (= (dv "0" "0") "Division undefined"))
  (is (= (dx "1" "3") "Non-terminating decimal expansion; no exact representable decimal result."))
  (is (= (dx "12.00" "1") "12.00"))
  (is (= (dx "1" "8") "0.125"))
  (is (= (dmc "1" "3" 5 d/HALF-EVEN) "0.33333"))
  (is (= (dmc "9.99" "1" 2 d/HALF-EVEN) "10"))
  (is (= (dmc "1.9999" "1" 2 d/HALF-EVEN) "2.0"))
  (is (= (dmc "1" "3" 5 d/UNNECESSARY) "Rounding necessary"))
  (is (= (dmc "1" "4" 5 d/UNNECESSARY) "0.25")))

(deftest dec-div-scale-modes
  ;; 7/2 = 3.5 と -7/2 = -3.5 を scale 0 で
  (is (= (dsc "7" "2" 0 d/UP) "4"))
  (is (= (dsc "7" "2" 0 d/DOWN) "3"))
  (is (= (dsc "7" "2" 0 d/CEILING) "4"))
  (is (= (dsc "7" "2" 0 d/FLOOR) "3"))
  (is (= (dsc "7" "2" 0 d/HALF-UP) "4"))
  (is (= (dsc "7" "2" 0 d/HALF-DOWN) "3"))
  (is (= (dsc "7" "2" 0 d/HALF-EVEN) "4"))
  (is (= (dsc "7" "2" 0 d/UNNECESSARY) "Rounding necessary"))
  (is (= (dsc "-7" "2" 0 d/UP) "-4"))
  (is (= (dsc "-7" "2" 0 d/DOWN) "-3"))
  (is (= (dsc "-7" "2" 0 d/CEILING) "-3"))
  (is (= (dsc "-7" "2" 0 d/FLOOR) "-4"))
  (is (= (dsc "-7" "2" 0 d/HALF-UP) "-4"))
  (is (= (dsc "-7" "2" 0 d/HALF-DOWN) "-3"))
  (is (= (dsc "-7" "2" 0 d/HALF-EVEN) "-4"))
  (is (= (dsc "5" "2" 0 d/HALF-EVEN) "2"))
  (is (= (dsc "1" "3" 3 d/HALF-UP) "0.333"))
  (is (= (dsc "2" "3" -1 d/HALF-UP) "0E+1"))
  (is (= (dsc "1" "0" 2 d/HALF-UP) "Division by zero")))

(deftest dec-rounding
  (is (= (ss "2.5" 0 d/HALF-EVEN) "2"))
  (is (= (ss "3.5" 0 d/HALF-EVEN) "4"))
  (is (= (ss "-2.5" 0 d/HALF-EVEN) "-2"))
  (is (= (ss "2.5" 0 d/HALF-DOWN) "2"))
  (is (= (ss "2.51" 0 d/HALF-DOWN) "3"))
  (is (= (ss "-2.5" 0 d/HALF-UP) "-3"))
  (is (= (ss "1.20" 1 d/UNNECESSARY) "1.2"))
  (is (= (ss "1.25" 1 d/UNNECESSARY) "Rounding necessary"))
  (is (= (ss "1.2" 4 d/UNNECESSARY) "1.2000"))
  (is (= (ss "1E+3" 0 d/UNNECESSARY) "1000"))
  (is (= (ss "123" -2 d/HALF-UP) "1E+2"))
  (is (= (ss "0.0001" 2 d/UP) "0.01"))
  (is (= (ss "-0.0001" 2 d/CEILING) "0.00"))
  (is (= (rd "999.9" 3 d/HALF-UP) "1.00E+3"))
  (is (= (rd "123.456" 4 d/HALF-EVEN) "123.5"))
  (is (= (rd "123.456" 0 d/HALF-EVEN) "123.456"))
  (is (= (rd "1.50" 5 d/HALF-EVEN) "1.50"))
  (is (= (rd "0.00" 1 d/HALF-EVEN) "0.00"))
  (is (= (d/to-string (d/strip-trailing-zeros (p "1200"))) "1.2E+3"))
  (is (= (d/to-string (d/strip-trailing-zeros (p "1.500"))) "1.5"))
  (is (= (d/to-string (d/strip-trailing-zeros (p "0.000"))) "0"))
  (is (= (fl "-1.5") "-2"))
  (is (= (let [[x e] (d/ceil-int (p "-1.5"))] (r x e)) "-1"))
  (is (= (fl "1E+3") "1000"))
  (is (= (let [[x e] (d/ceil-int (p "0.001"))] (r x e)) "1"))
  (is (= (md "HALF_EVEN") 6))
  (is (= (md "UNNECESSARY") 7))
  (is (= (md "half_even") -1)))

(deftest dec-rem-pow
  (is (= (rm "10" "3") "1"))
  (is (= (rm "-10" "3") "-1"))
  (is (= (rm "10" "-3") "1"))
  (is (= (rm "10.5" "3") "1.5"))
  (is (= (rm "1" "3") "1"))
  (is (= (rm "1" "0") "Division by zero"))
  (is (= (pw "1.1" 2) "1.21"))
  (is (= (pw "-2" 3) "-8"))
  (is (= (pw "0.0" 0) "1"))
  (is (= (pw "2" -1) "Invalid operation"))
  (is (= (pwm "3" -1 5) "0.33333"))
  (is (= (pwm "2" -1 5) "0.5"))
  (is (= (pwm "2" 10 2) "1.0E+3"))
  (is (= (pwm "2" 0 5) "1")))

(deftest dec-int-conversion
  (is (= (ti "1.0") "1"))
  (is (= (ti "1.5") "Rounding necessary"))
  (is (= (ti "9223372036854775807") "9223372036854775807"))
  (is (= (ti "-9223372036854775808") "-9223372036854775808"))
  (is (= (ti "9223372036854775808") "Overflow"))
  (is (= (ti "1E+18") "1000000000000000000"))
  (is (= (ti "1E+19") "Overflow"))
  (is (= (ti "0E+100") "0"))
  (is (= (ti "1E+1000000") "Overflow"))
  (is (d/integer? (p "1.00")))
  (is (d/integer? (p "1E+3")))
  (is (d/integer? (p "0.0")))
  (is (not (d/integer? (p "1.01"))))
  (is (= (tb "-12.99") "-12"))
  (is (= (d/to-string (d/from-int -5)) "-5")))

(deftest dec-float
  (is (= (ff 0.1) "0.1"))
  (is (= (ff 100.0) "100.0"))
  (is (= (ff 1e10) "1.0E+10"))
  (is (= (ff (npz/flt "-0.0")) "0.0"))
  (is (= (ff (npz/flt "nan")) "Infinite or NaN"))
  (is (= (ff (npz/flt "inf")) "Infinite or NaN"))
  (is (= (fs "nan") "NaN"))
  (is (= (fs "inf") "Infinity"))
  (is (= (fs "-inf") "-Infinity"))
  (is (= (fs "-0.0") "-0.0"))
  (is (= (fs "0") "0.0"))
  (is (= (fs "5e-324") "4.9E-324"))
  (is (= (fs "1e23") "1.0E23"))
  (is (= (fs "2e23") "2.0E23"))
  (is (= (fs "1e7") "1.0E7"))
  (is (= (fs "9999999") "9999999.0"))
  (is (= (fs "0.001") "0.001"))
  (is (= (fs "9.999999999999998E-4") "9.999999999999998E-4"))
  (is (= (fs "1.7976931348623157e308") "1.7976931348623157E308"))
  (is (= (d/float->shortest-str (d/to-float (p "0.1"))) "0.1"))
  (is (= (d/float->shortest-str (d/to-float (p "1E+400"))) "Infinity")))

;; 桁を作る演算の上限 (MAX-DIGITS)。指数の大きい数 (要求の本文の 1E+20000000) を加減算や切り捨てで展開すると、
;; 確保に失敗してプロセスごと終わる。上限を超えるものは Java の BigInteger の文言で失敗にする
;; (Java の上限は約 6.5 億桁だが、1 千万桁でも Java は 300 秒で終わらない)。

;; 上限の手前は作れる: 1E+9999990 + 1 は 9999991 桁の 100..001
(defn- near-limit-ok? Bool []
  (let [x (ad "1E+9999990" "1")]
    (and (= (count x) 9999991) (= (subs x 0 2) "10") (= (subs x (- (count x) 2) (count x)) "01"))))

(deftest digit-limit
  (is (near-limit-ok?))
  (is (= (ad "1E+10000000" "1") "BigInteger would overflow supported range"))
  (is (= (ad "1" "1E-10000000") "BigInteger would overflow supported range"))
  (is (= (sb "1E+20000000" "1") "BigInteger would overflow supported range"))
  ;; 同じ scale どうし、0 との加減算は展開しない
  (is (= (ad "1E+999999999" "2E+999999999") "3E+999999999"))
  (is (= (ad "1E+999999999" "0E+999999999") "1E+999999999"))
  (is (= (ss "1E+20000000" 0 d/UNNECESSARY) "BigInteger would overflow supported range"))
  (is (= (ss "1E-20000000" 0 d/HALF-UP) "0"))
  (is (= (fl "1E+20000000") "BigInteger would overflow supported range"))
  (is (= (fl "-1.5") "-2"))
  (is (= (tb "1E+20000000") "BigInteger would overflow supported range"))
  (is (= (tb "-12.99") "-12"))
  (is (= (rm "1E+20000000" "7") "BigInteger would overflow supported range"))
  (is (= (rm "1E+40" "7") "4"))
  (is (= (pw "10" 20000000) "BigInteger would overflow supported range"))
  (is (= (pw "10" 3) "1000"))
  (is (= (dsc "1" "3" 20000000 d/HALF-UP) "BigInteger would overflow supported range"))
  ;; toPlainString は桁が多すぎれば科学表記のまま
  (is (= (pl "1E+20000000") "1E+20000000"))
  (is (= (pl "1E+3") "1000")))

;; 指数の小さい数を丸めるとき、捨てる桁数ぶんの 10^k を作らない (1e-999999999 で約 1 GB を確保していた)
(deftest set-scale-of-tiny-numbers
  (is (= (ss "1e-999999999" 0 d/HALF-UP) "0"))
  (is (= (ss "1e-999999999" 0 d/UP) "1"))
  (is (= (ss "1e-999999999" 0 d/CEILING) "1"))
  (is (= (ss "-1e-999999999" 0 d/FLOOR) "-1"))
  (is (= (ss "-1e-999999999" 0 d/HALF-EVEN) "0"))
  (is (= (ss "9e-999999999" 2 d/DOWN) "0.00"))
  (is (= (ss "1e-999999999" 0 d/UNNECESSARY) "Rounding necessary"))
  (is (= (rd "1.5e-999999999" 1 d/HALF-UP) "2E-999999999")))

;; 小数点の後の 0 が 1 千万桁を超えるなら、大きい数と同じく指数表記のまま (1e-999999999 で約 1 GB の文字列を作っていた)
(deftest plain-str-of-tiny-numbers
  (is (= (pl "1e-999999999") "1E-999999999"))
  (is (= (pl "-25e-20000000") "-2.5E-19999999"))
  (is (= (pl "1e-5") "0.00001"))
  (is (= (pl "1.5e-3") "0.0015")))

;; 正確な割り算は gcd を取らない (2 と 5 を除いた残りで割り切れるかを見る)。期待値は Python の Decimal と Java の BigDecimal
(deftest div-exact-without-gcd
  (is (= (dx "1" "1099511627776") "9.094947017729282379150390625E-13"))
  (is (= (dx "21" "6") "3.5"))
  (is (= (dx "-7" "-1.25") "5.6"))
  (is (= (dx "22" "7") "Non-terminating decimal expansion; no exact representable decimal result."))
  (is (= (dx "6" "-4") "-1.5"))
  (is (= (dx "100" "20") "5")))

;; pow の桁数の見積もりは n × log10(底)。前は n × (桁数 - 1) + 0.3n で、10 pow 9999999 (1 千万桁ちょうど) を断っていた
(deftest pow-digit-estimate
  (is (= (pw "7" 20000000) d/TOO-BIG))
  (is (= (pw "99" 5100000) d/TOO-BIG))
  (is (= (pw "123456789012345678901234567890" 400000) d/TOO-BIG))
  (is (= (d/pow-digits (p "10") 9999999) 10000000))
  (is (= (d/pow-digits (p "7") 9999999) 8450980))
  (is (= (d/pow-digits (p "2") 1000) 302)))

(defn- us Str [s: Str] (let [x (p s)] (str (bi/to-string (d/unscaled x)) " " (d/scale x))))

(deftest dec-parse-around-eighteen-digits
  (is (= (us "123456789012345678") "123456789012345678 0"))
  (is (= (us "-123456789012345678") "-123456789012345678 0"))
  (is (= (us "1234567890123456789") "1234567890123456789 0"))
  (is (= (us "12345678901234567.8") "123456789012345678 1"))
  (is (= (us "-99999999999999999.9") "-999999999999999999 1"))
  (is (= (us "1234567890123456789.0") "12345678901234567890 1"))
  (is (= (us "00000000000000000001") "1 0"))
  (is (= (us "0.000000000000000001") "1 18"))
  (is (= (ts "0.000000000000000001") "1E-18"))
  (is (= (us "999999999999999999e-2") "999999999999999999 2"))
  (is (= (us "-0.000") "0 3"))
  (is (= (us "32.78") "3278 2")))

;; pow の結果の scale は Java の int の範囲 (BigDecimal.checkScale)。大きすぎれば Underflow、小さすぎれば Overflow、値が 0 なら端に丸める。
;; MathContext 付きは掛け算ごとに確かめる (丸めで scale が戻る場合も)。期待値は Java 17 の BigDecimal.pow
(deftest pow-scale-must-fit-java-int
  (is (= (pw "1E-2147483647" 2) "Underflow"))
  (is (= (pw "1E+2147483647" 2) "Overflow"))
  (is (= (pw "1E-1073741824" 2) "Underflow"))
  (is (= (pw "1E-1073741823" 2) "1E-2147483646"))
  (is (= (pw "0E-2147483647" 2) "0E-2147483647"))
  (is (= (pw "0E+2147483647" 3) "0E+2147483648"))
  (is (= (pw "-1E-2147483647" 3) "Underflow"))
  (is (= (pw "1E-30" 99999999) "Underflow"))
  (is (= (pwm "1E-2147483647" 2 10) "Underflow"))
  (is (= (pwm "1E+2147483647" 2 10) "Overflow"))
  (is (= (pwm "1E-2147483647" -2 10) "Underflow"))
  (is (= (pwm "1.5E-1073741823" 2 3) "Underflow"))
  (is (= (pwm "0E-2147483647" 2 10) "0E-2147483647"))
  (is (= (pwm "1E-1073741823" 2 10) "1E-2147483646")))
