(ns seal-test (:require [mulay.lib.seal :as sl] [clay.string :as str]))

;; mulay build --encrypt: 埋め込む値を、実行時に渡す鍵でしか開けない形に封じる (lib/seal)。

(deftest round-trip
  (let [[s e] (sl/seal "pass phrase" "hello\nworld")
        [p e2] (sl/unseal "pass phrase" s)]
    (is (= e ""))
    (is (= e2 ""))
    (is (= p "hello\nworld"))))

(deftest empty-and-block-sized-plaintexts
  (let [[s1 e1] (sl/seal "k" "")
        [p1 f1] (sl/unseal "k" s1)
        [s2 e2] (sl/seal "k" "0123456789abcdef")
        [p2 f2] (sl/unseal "k" s2)]
    (is (= f1 ""))
    (is (= p1 ""))
    (is (= f2 ""))
    (is (= p2 "0123456789abcdef"))))

(deftest the-plaintext-is-not-in-the-sealed-bytes
  (let [[s e] (sl/seal "k" "super-secret-value-123")]
    (is (not (str/includes? s "super-secret")))))

(deftest sealing-twice-gives-different-bytes
  (let [[a ea] (sl/seal "k" "same")
        [b eb] (sl/seal "k" "same")]
    (is (not= a b))))

(deftest wrong-key-is-rejected
  (let [[s e] (sl/seal "right" "v")
        [p f] (sl/unseal "wrong" s)]
    (is (= p ""))
    (is (= f sl/BAD-KEY))))

(deftest tampering-is-rejected
  (let [[s e] (sl/seal "k" "value-to-protect")
        i (- (count s) 40)
        t (str (subs s 0 i) (chr (+ (nth s i) 1)) (subs s (+ i 1) (count s)))
        [p f] (sl/unseal "k" t)]
    (is (= f sl/BAD-KEY))))

(deftest too-short-input-is-rejected
  (let [[p f] (sl/unseal "k" "abc")]
    (is (= f sl/BAD-KEY))))

(deftest empty-key-is-refused
  (let [[s e] (sl/seal "" "v")]
    (is (not= e ""))))
