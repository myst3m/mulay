(ns secure-test (:require [mulay.lib.secure :as sec]))

;; secure-properties の復号。期待値は実モジュール (mule-secure-configuration-property-module 1.2.5 と mule-encryption 1.9.3) が作った暗号文 (tools/gen-secure-golden.java)。

(defn- ok? Bool [alg: &Str mode: &Str rnd: Bool key: &Str text: &Str plain: &Str]
  (let [[p e] (sec/decrypt-value alg mode rnd key text)] (and (= e "") (= p plain))))

(deftest vec-1-aes-cbc-iv-true-k16
  (is (ok? "AES" "CBC" true "0123456789abcdef" "![LTmHGk3QfRu2aPO9KXHZDgVIREjJFHnYeKk1lP7/00s=]" "s3cret")))

(deftest vec-2-aes-cbc-iv-true-k16
  (is (ok? "AES" "CBC" true "0123456789abcdef" "![L3376DNBhIllhoM5PN2A+fTSyFiEP3SW3zUf3EVmRGs=]" "")))

(deftest vec-3-aes-cbc-iv-true-k16
  (is (ok? "AES" "CBC" true "0123456789abcdef" "![tm1BthnXqCIgbmq0AKTJ0WrFLHPMT54DPx4GNLWl3rmfhy4n3jU64R2yxPyLvUI1Z+wZbz6GyX89toz/AmqQsNjzem3VCU2WFO/CgJIH84oBbDBAhsaPM+XPK3cROD2J]" "0123456789abcdef-0123456789abcdef-long value, with: punctuation!")))

(deftest vec-4-aes-cbc-iv-false-k16
  (is (ok? "AES" "CBC" false "0123456789abcdef" "![k4aH08B0QRU78RqjIVPFhQ==]" "s3cret")))

