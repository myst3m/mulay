(deftest wrong-key-fails-with-the-modules-message
  (let [[p e] (sec/decrypt-value "AES" "CBC" true "fedcba9876543210" "![LTmHGk3QfRu2aPO9KXHZDgVIREjJFHnYeKk1lP7/00s=]")]
    (is (= e "Could not encrypt or decrypt the data."))))

(deftest bad-key-length-fails-with-the-modules-message
  (let [[p e] (sec/decrypt-value "AES" "CBC" true "short" "![LTmHGk3QfRu2aPO9KXHZDgVIREjJFHnYeKk1lP7/00s=]")]
    (is (= e "The key is invalid, please make sure it's of a supported size (actual is 5)"))))

(deftest too-short-or-empty-ciphertext-fails
  (let [[p e] (sec/decrypt-value "AES" "CBC" true "0123456789abcdef" "![YWJj]")]
    (is (= e "Could not encrypt or decrypt the data."))))

(deftest unsupported-algorithm-is-named
  (let [[p e] (sec/decrypt-value "Blowfish" "CBC" true "0123456789abcdef" "![LTmHGk3QfRu2aPO9KXHZDgVIREjJFHnYeKk1lP7/00s=]")]
    (is (= e "secure-properties: algorithm 'Blowfish' is not supported by mulay (AES only)"))))

(deftest encrypted-values-are-bracketed
  (is (sec/encrypted? "![abc]"))
  (is (not (sec/encrypted? "abc")))
  (is (not (sec/encrypted? "![abc"))))
