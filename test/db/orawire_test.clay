(ns orawire-test (:require [mulay.db.orawire :as w]))

;; 期待値は python-oracledb 26 の thin の実装 (buffer.pyx) と、実サーバとのパケットの記録

(defn- hx Str [b: &Str]
  (loop [i 0 out ""]
    (if (>= i (count b)) out
      (let [d "0123456789abcdef" x (nth b i)]
        (recur (+ i 1) (str out (if (= i 0) "" " ") (subs d (bit-shift-right x 4) (+ (bit-shift-right x 4) 1)) (subs d (bit-and x 15) (+ (bit-and x 15) 1))))))))

(defn- bytes Str [xs: Vec(Int)] (loop [i 0 out ""] (if (>= i (count xs)) out (recur (+ i 1) (str out (chr (nth xs i)))))))

(defn- u4 Str [b: Str p: Int] (let [[v q] (w/rub4 b p)] (str v "@" q)))
(defn- u2 Str [b: Str p: Int] (let [[v q] (w/rub2 b p)] (str v "@" q)))
(defn- s4 Str [b: Str p: Int] (let [[v q] (w/rsb b p 4)] (str v "@" q)))
(defn- le Str [b: Str p: Int] (let [[v q] (w/r16le b p)] (str v "@" q)))
(defn- by Str [b: Str p: Int] (let [[v q n] (w/rbytes b p)] (str v "@" q (if n "true" "false"))))
(defn- by2 Str [b: Str p: Int] (let [[v q] (w/rbytes2 b p)] (str v "@" q)))
(defn- cst Str [b: Str p: Int] (let [[v q] (w/rcstr b p)] (str v "@" q)))

(defn- rep Str [c: Str n: Int] (loop [i 0 out ""] (if (>= i n) out (recur (+ i 1) (str out c)))))

(deftest write-ints
  (is (= (hx (w/wub "" 0)) "00"))
  (is (= (hx (w/wub "" 255)) "01 ff"))
  (is (= (hx (w/wub "" 256)) "02 01 00"))
  (is (= (hx (w/wub "" 70000)) "04 00 01 11 70"))
  (is (= (hx (w/wub "" 2147483647)) "04 7f ff ff ff"))
  (is (= (hx (w/wub "" 4294967296)) "08 00 00 00 01 00 00 00 00"))
  (is (= (hx (w/wsb "" -1)) "81 01"))
  (is (= (hx (w/wsb "" -300)) "82 01 2c"))
  (is (= (hx (w/w16 "" 319)) "01 3f"))
  (is (= (hx (w/w32 "" 8192)) "00 00 20 00"))
  (is (= (hx (w/w16le "" 873)) "69 03")))

(deftest write-bytes
  (is (= (hx (w/wbytes2 "" "AUTH_SID")) "01 08 08 41 55 54 48 5f 53 49 44"))
  (is (= (hx (w/wbytes2 "" "")) "00"))
  (is (= (hx (w/wbytes "" "")) "00"))
  (is (= (hx (w/wbytes "" "ab")) "02 61 62")))

(deftest write-long-bytes
  (let [s (w/wbytes "" (rep "a" 300))]
    (is (= (count s) (+ 1 3 300 1)))
    (is (= (hx (subs s 0 4)) "fe 02 01 2c"))
    (is (= (nth s (- (count s) 1)) 0))))

(deftest read-ints
  (is (= (u4 (bytes [4 0 1 17 112]) 0) (str "70000@" 5)))
  (is (= (u4 (bytes [0]) 0) (str "0@" 1)))
  (is (= (u2 (bytes [4 0 1 17 112]) 0) (str "0@" w/BAD)))
  (is (= (u4 (bytes [2 1]) 0) (str "0@" w/SHORT)))
  (is (= (s4 (bytes [129 1]) 0) (str "-1@" 2)))
  (is (= (le (bytes [105 3]) 0) (str "873@" 2)))
  (is (= (u4 (bytes [1 1]) -1) (str "0@" -1))))

(deftest read-bytes
  (is (= (by (bytes [3 97 98 99 9]) 0) (str "abc" "@" 4 "false")))
  (is (= (by (bytes [0]) 0) (str "" "@" 1 "true")))
  (is (= (by (bytes [255]) 0) (str "" "@" 1 "true")))
  (is (= (by (bytes [254 1 2 97 98 1 1 99 0]) 0) (str "abc" "@" 9 "false")))
  (is (= (by (bytes [5 97]) 0) (str "" "@" w/SHORT "true")))
  (is (= (by2 (bytes [1 3 3 97 98 99]) 0) (str "abc" "@" 6)))
  (is (= (by2 (bytes [0 7]) 0) (str "" "@" 1)))
  (is (= (cst (bytes [65 66 0 67]) 0) "AB@3")))

(deftest read-long-bytes
  (let [s (w/wbytes "" (rep "xy" 40000))]
    (is (= (by s 0) (str (rep "xy" 40000) "@" (count s) "false")))))

(deftest packets
  ;; CONNECT の頭 (記録): 00 4a 00 00 01 00 00 00
  (is (= (hx (subs (w/packet w/T-CONNECT 0 (rep "z" 66) false) 0 8)) "00 4a 00 00 01 00 00 00"))
  (is (= (hx (subs (w/packet w/T-MARKER 0 (bytes [1 0 2]) true) 0 11)) "00 00 00 0b 0c 00 00 00 01 00 02"))
  (is (= (w/packet-len (bytes [0 0 0 11 12 32 0 0 1 0 1]) true) 11))
  (is (= (w/packet-len (bytes [0 0 0]) true) 0))
  (is (= (hx (w/data-packets "" 8192 true false)) "00 00 00 0a 06 00 00 00 00 00"))
  (is (= (hx (w/data-packets "" 8192 true true)) "00 00 00 0a 06 00 00 00 08 00")))

(deftest split-packets
  ;; 1 パケットに 10 バイト: 3 つ
  (let [ps (w/data-packets (rep "q" 25) 20 true false)
        pe (w/data-packets (rep "q" 25) 20 true true)]
    (is (= (count ps) (+ 20 20 15)))
    (is (= (w/data-payload (subs ps 0 20)) (rep "q" 10)))
    (is (= (w/data-flags (subs ps 0 20)) 0))
    (is (= (w/data-flags (subs pe 0 20)) 0))
    (is (= (w/data-flags (subs pe 20 40)) 0))
    (is (= (w/data-flags (subs pe 40 55)) 2048))))

;; 受けたバイト列からパケットを 1 つ切り出す
(defn- tp Str [b: Str] (let [[pk rest st] (w/take-packet b true)] (str (count pk) "/" (count rest) "/" st)))

(deftest take-packet
  (is (= (tp (str (bytes [0 0 0 10 6 0 0 0 0 0]) "xy")) "10/2/0"))
  (is (= (tp (bytes [0 0 0 10 6 0 0 0 0])) "0/9/1"))
  (is (= (tp (bytes [0 0 0])) "0/3/1")))

;; 長さがヘッダ (8) より短いか、SDU の上限 (2MB) を超えるパケットは壊れている (状態 2)。以前は短いものの型を
;; 読もうとして範囲外で落ち、長さ 0 のものは読み続けてメモリを使い切った
(deftest take-packet-malformed
  (is (= (tp (bytes [0 0 0 4 6 0 0 0 0 0])) "0/10/2"))
  (is (= (tp (bytes [0 0 0 0 6 0 0 0])) "0/8/2"))
  (is (= (tp (bytes [0 48 0 0 6 0 0 0])) "0/8/2"))
  (is (= (tp (bytes [0 32 0 0 6 0 0 0])) "0/8/1")))

;; marker パケット: [種類 0 値]。ojdbc の NIOMarkerPacket と同じく、種類 1 で値 2 なら reset、それ以外は break
(deftest marker-packets
  (is (= (w/marker 1 2) (str (chr 0) (chr 0) (chr 0) (chr 11) (chr 12) (chr 0) (chr 0) (chr 0) (chr 1) (chr 0) (chr 2))))
  (is (w/marker-reset? (w/marker 1 2)))
  (is (not (w/marker-reset? (w/marker 1 1))))
  (is (not (w/marker-reset? (w/marker 2 1))))
  (is (not (w/marker-reset? (w/marker 0 0)))))
