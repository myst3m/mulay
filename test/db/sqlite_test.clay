(ns sqlite-test (:require [mulay.db.sqlite :as sq] [mulay.db.sql :as sql]))

(defn- cls Str [c: &sql/Cell]
  (match c (sql/CNull) "null" (sql/CInt i) (str "I" i) (sql/CLong i) (str "L" i) (sql/CDouble f) "D" (sql/CStr s) (str "S" s)
         (sql/CBytes b) (str "B" (count b)) _ "?"))

(deftest roundtrip
  (let [[h e] (sq/open "file:sqtest?mode=memory&cache=shared")
        [o1 e1] (sq/run h "CREATE TABLE t (a INTEGER, b TEXT, c REAL, d BLOB)" [] false)
        [o2 e2] (sq/run h "INSERT INTO t VALUES (?, ?, ?, ?)" [(sql/->CInt 1) (sql/->CStr "x") (sql/->CDouble 1.5) (sql/->CBytes "ab")] true)
        [o3 e3] (sq/run h "INSERT INTO t VALUES (9007199254740993, NULL, NULL, x'')" [] false)
        [o4 e4] (sq/run h "SELECT * FROM t ORDER BY a" [] false)
        [o5 e5] (sq/run h "SELECT * FROM missing_t" [] false)
        r (:rows o4)]
    (is (sql/ok? e))
    (is (= (:count o1) 0))
    (is (= (:count o2) 1))
    (is (= (:cols (:keys o2)) ["last_insert_rowid()"]))
    (is (= (:cols r) ["a" "b" "c" "d"]))
    (is (= (cls (nth (nth (:rows r) 0) 0)) "I1"))
    (is (= (cls (nth (nth (:rows r) 0) 2)) "D"))
    (is (= (cls (nth (nth (:rows r) 0) 3)) "B2"))
    (is (= (cls (nth (nth (:rows r) 1) 0)) "L9007199254740993"))
    (is (= (cls (nth (nth (:rows r) 1) 1)) "null"))
    (is (= (cls (nth (nth (:rows r) 1) 3)) "B0"))
    (is (= (:msg e5) "[SQLITE_ERROR] SQL error or missing database (no such table: missing_t)"))
    (is (= (sq/close h) 0))))

;; bulk: 組ごとの件数。途中の組で失敗するとそこで止まり、それより前の組は残る。準備の失敗は Mule の文言 (class は空)
(deftest run-batch
  (let [[h e] (sq/open "file:sqbatch?mode=memory&cache=shared")
        [o1 e1] (sq/run h "CREATE TABLE b (id INTEGER PRIMARY KEY, name TEXT NOT NULL, n INTEGER DEFAULT 0)" [] false)
        [c2 e2] (sq/run-batch h "INSERT INTO b (id, name) VALUES (?, ?)" [[(sql/->CInt 1) (sql/->CStr "a")] [(sql/->CInt 2) (sql/->CStr "b")] [(sql/->CInt 3) (sql/->CStr "c")]])
        [c3 e3] (sq/run-batch h "UPDATE b SET n = n + 1 WHERE id >= ?" [[(sql/->CInt 1)] [(sql/->CInt 3)] [(sql/->CInt 99)]])
        [c4 e4] (sq/run-batch h "INSERT INTO b (id, name) VALUES (?, ?)" [[(sql/->CInt 10) (sql/->CStr "x")] [(sql/->CInt 11) (sql/->CNull)] [(sql/->CInt 12) (sql/->CStr "z")]])
        [o5 e5] (sq/run h "SELECT id FROM b ORDER BY id" [] false)
        [c6 e6] (sq/run-batch h "INSERT INTO missing_b (id) VALUES (?)" [[(sql/->CInt 1)]])
        [c7 e7] (sq/run-batch h "INSERT INTO b (id, name) VALUES (?, ?)" [])
        [o8a e8a] (sq/run h "UPDATE b SET n = 0" [] false)
        [o8 e8] (sq/run h "CREATE TABLE b2 (x INTEGER)" [] false)
        [o9 e9] (sq/run h "DROP TABLE b2" [] false)]
    (is (= c2 [1 1 1]))
    (is (= c3 [3 1 0]))
    (is (= c4 [1]))
    (is (= (:msg e4) "[SQLITE_CONSTRAINT_NOTNULL] A NOT NULL constraint failed (NOT NULL constraint failed: b.name)"))
    (is (= (count (:rows (:rows o5))) 4))
    (is (= (:msg e6) "A problem occurred while trying to acquire a cached PreparedStatement in a background thread."))
    (is (= (:exc e6) ""))
    (is (= c7 []))
    ;; DDL は sqlite3_changes を変えない (直前の DML の件数のまま。xerial と同じ)
    (is (= (:count o8a) 4))
    (is (= (:count o8) 4))
    (is (= (:count o9) 4))
    (is (= (sq/close h) 0))))

;; select を少しずつ読む: open-query で準備し、fetch で最大 n 行ずつ。読み終えたら done。close-query で閉じる
(deftest query-in-blocks
  (let [[h e] (sq/open "file:sqquery?mode=memory&cache=shared")
        [q e1] (sq/open-query h "WITH RECURSIVE c(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM c WHERE n < ?) SELECT n, 'x' || n AS s FROM c" [(sql/->CInt 5)])
        [r1 d1 f1] (sq/fetch q 2)
        [r2 d2 f2] (sq/fetch q 2)
        [r3 d3 f3] (sq/fetch q 2)
        z (sq/close-query q)
        [q2 e2] (sq/open-query h "SELECT * FROM missing_q" [])
        [q3 e3] (sq/open-query h "SELECT 1" [])
        z3 (sq/close-query q3)]
    (is (sql/ok? e1))
    (is (= (:names q) ["n" "s"]))
    (is (= (count r1) 2))
    (is (not d1))
    (is (= (cls (nth (nth r1 0) 0)) "I1"))
    (is (= (cls (nth (nth r2 1) 1)) "Sx4"))
    (is (= (count r3) 1))
    (is d3)
    (is (sql/ok? f3))
    (is (= (:msg e2) "[SQLITE_ERROR] SQL error or missing database (no such table: missing_q)"))
    (is (= (sq/close h) 0))))
