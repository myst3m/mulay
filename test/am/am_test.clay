(ns am-test (:require [mulay.app.ammetric :as am] [mulay.app.run :as run] [mulay.rt.engine :as en] [mulay.mule.load :as ld]
                      [mulay.lib.res :as res] [mulay.conn.registry :as creg] [clay.httpmsg :as hm] [clay.string :as str]))

;; app/ammetric: Anypoint Monitoring の app_inbound_metric (_metric.log)。期待値は実 Mule 4.12.0 を RTF で動かして
;; 書かれた行 (test/fixtures/am/*.mule-4.12.0.log、送った要求は test/fixtures/am/README.md)

(defn- ep Str [path: Str] (am/endpoint "" path))

;; パスの区切りは、文字・-・_ 以外を含むか、全部が大文字なら X にする (最初の区切りは文字だけなら大文字でも残す)
(deftest endpoint-segments
  (is (= (ep "/hello") "/hello"))
  (is (= (ep "/hello/bob") "/hello/bob"))
  (is (= (ep "/custom/") "/custom/"))
  (is (= (ep "/wild/42/detail") "/wild/X/detail"))
  (is (= (ep "/wild/a.b") "/wild/X"))
  (is (= (ep "/wild/x/42") "/wild/x/X"))
  (is (= (ep "/wild/42/43") "/wild/X/X"))
  (is (= (ep "/wild/abc123/detail") "/wild/X/detail"))
  (is (= (ep "/wild/-5/detail") "/wild/X/detail"))
  (is (= (ep "/wild/a b/detail") "/wild/X/detail"))
  (is (= (ep "/wild/user@example.com/detail") "/wild/X/detail"))
  (is (= (ep "/wild/deadbeef/detail") "/wild/deadbeef/detail"))
  (is (= (ep "/wild/DEADBEEF00/detail") "/wild/X/detail"))
  (is (= (ep "/wild/AB/detail") "/wild/X/detail"))
  (is (= (ep "/wild/Ab") "/wild/Ab"))
  (is (= (ep "/wild/b-c-d") "/wild/b-c-d"))
  (is (= (ep "/wild/foo_bar/d2") "/wild/foo_bar/X"))
  (is (= (ep "/wild/a/b/c/d/e/f/g/h/i/j/k/l/m/n") "/wild/a/b/c/d/e/f/g/h/i/j/k/l/m/n")))

;; 文字は Unicode の文字 (Java の Character.isLetter)。BMP の外は char 2 つ (サロゲート) なので文字ではない
(deftest endpoint-unicode
  (is (= (ep "/wild/été/d6") "/wild/été/X"))
  (is (= (ep "/wild/あ") "/wild/あ"))
  (is (= (ep "/wild/一/detail") "/wild/一/detail"))
  (is (= (ep "/wild/αβ/detail") "/wild/αβ/detail"))
  (is (= (ep "/wild/ａ/detail") "/wild/ａ/detail"))
  (is (= (ep "/wild/ＡＢ/detail") "/wild/X/detail"))
  (is (= (ep "/wild/１/detail") "/wild/X/detail"))
  (is (= (ep "/wild/😀/detail") "/wild/X/detail"))
  (is (= (ep (str "/wild/a" (chr 255) "/detail")) "/wild/X/detail")))

;; 最初の区切り: 文字だけなら大文字でも残す。空の区切り (//) は数えずに / を残す
(deftest endpoint-first-and-empty
  (is (= (ep "/WILD/a") "/WILD/a"))
  (is (= (ep "/v1/x") "/X/x"))
  (is (= (ep "/a//b") "/a//b"))
  (is (= (ep "//AB") "//AB"))
  (is (= (ep "/") "/"))
  (is (= (ep "") "")))

;; listener-config の basePath: そこまでは残し、後ろの区切りは最初のものから全部の規則にかける
(deftest endpoint-base-path
  (is (= (am/endpoint "/api/v1" "/api/v1/items/42") "/api/v1/items/X"))
  (is (= (am/endpoint "/api/v1" "/api/v1/items/abc") "/api/v1/items/abc"))
  (is (= (am/endpoint "/api/v1" "/api/v1/ABC/def") "/api/v1/X/def"))
  (is (= (am/endpoint "/api/v1" "/api/v1") "/api/v1"))
  (is (= (am/endpoint "/api/v1" "/api/v1/") "/api/v1/"))
  (is (= (am/endpoint "/api/v1" "/api/v1//x") "/api/v1//x"))
  (is (= (am/endpoint "/api/v1" "/api/v1/x/") "/api/v1/x/"))
  ;; 文字列の前方一致 (区切りの境目は見ない)
  (is (= (am/endpoint "/api/v1" "/api/v10/x") "/api/v1X/x"))
  (is (= (am/endpoint "/api/v1" "/other/1") "/other/X"))
  (is (= (am/endpoint "/" "/ABC/1") "/ABC/X")))

;; --- 集計と 1 行 ---------------------------------------------------------------------------

(def C (am/->Commons "11111111-1111-4111-8111-111111111111" "22222222-2222-4222-8222-222222222222" "33333333-3333-4333-8333-333333333333"
                     "rtf-worker-1" "am-probe" "am-probe-9b8fd5478-qvfsw"))

(defn- fixture-line Str [file: Str n: Int]
  (let [[t e] (read-file (str "test/fixtures/am/" file))
        ls (str/split t "\n")]
    (nth ls n)))

(defn- hello Int [path: Str ms: Int]
  (am/record! (if (= path "/hello") "hello-world-flow" "hello-name-flow") "localhost:18101" "127.0.0.1:41234" "http" "" path false ms))

;; 実 Mule の行とバイト単位で同じ (hello-world の最初の 2 つの窓。応答時間は記録の件数・合計・最小・最大・二乗和になる値)
(deftest line-matches-mule
  (let [z0 (am/enable! true)
        z1 (am/take!)
        ;; 5 件: 合計 82、最小 1、最大 75、二乗和 5638
        a (+ (hello "/hello" 75) (hello "/hello" 1) (hello "/hello" 2) (hello "/hello" 2) (hello "/hello" 2))
        l1 (am/line C 1791979020000 (am/take!))
        ;; /hello 21 件 (合計 34、最小 1、最大 2、二乗和 60)、/hello/bob 21 件 (合計 70、最小 1、最大 35、二乗和 1292)
        b (loop [i 0 acc 0] (if (>= i 21) acc (recur (+ i 1) (+ acc (hello "/hello" (if (< i 13) 2 1))))))
        c (loop [i 0 acc 0] (if (>= i 21) acc (recur (+ i 1) (+ acc (hello "/hello/bob" (cond (= i 0) 35 (= i 1) 3 (< i 15) 2 :else 1))))))
        l2 (am/line C 1791979080000 (am/take!))]
    (is (= l1 (fixture-line "hello-world.mule-4.12.0.log" 0)))
    (is (= l2 (fixture-line "hello-world.mule-4.12.0.log" 1)))))

(defn- summary Str [xs: &Vec(am/Agg)]
  (loop [i 0 out ""]
    (if (>= i (count xs)) out
      (let [a (nth xs i)]
        (recur (+ i 1) (str out (if (= i 0) "" " ") (:flow a) ":" (:endpoint a) ":" (:rtype a) ":" (:host a) ":" (:remote a)
                            "=" (:n a)))))))

(defn- wild Int [path: Str] (am/record! "wild" "localhost:18120" "127.0.0.1:5000" "http" "" path false 1))

;; 保つ次元 (フロー・種類・OK/FAILED・protocol・Host) の組ごとに、(remote_host, endpoint) の組は届いた順に 5 つまで。
;; 6 つ目からの新しい組は endpoint を other にまとめる (core-http-response の窓 1791982020000 と同じ数)
(deftest collapse-to-other
  (let [z0 (am/enable! true)
        z1 (am/take!)
        n (+ (wild "/wild/foo-bar/d1") (wild "/wild/foo_bar/d2") (wild "/wild/foo~bar/d3") (wild "/wild/foo+bar/d4")
             (wild "/wild/foo!bar/d5") (wild "/wild/été/d6") (wild "/wild/a/b/d7") (wild "/wild/一/d8") (wild "/wild/１/d9")
             (wild "/wild/a /d10") (wild "/wild/AB/d11") (wild "/wild/foo's/d12") (wild "/wild/αβ/d13") (wild "/wild/a,b/d14")
             (wild "/wild/a:b/d15") (wild "/wild/AB/d16"))
        s (summary (am/take!))]
    (is (= s (str "wild:/wild/foo-bar/X:OK:localhost:18120:127.0.0.1=1 wild:/wild/foo_bar/X:OK:localhost:18120:127.0.0.1=1 "
                  "wild:/wild/X/X:OK:localhost:18120:127.0.0.1=10 wild:/wild/été/X:OK:localhost:18120:127.0.0.1=1 "
                  "wild:/wild/a/b/X:OK:localhost:18120:127.0.0.1=1 wild:other:OK:localhost:18120:127.0.0.1=2")))))

;; エラーで終わった要求は FAILED。Host や remote_host が違えば別の行。remote_host はアドレスだけ (ポートを除く)。
;; take! で窓を空にする。数えない間 (enable! false) は何も積まない
(deftest groups
  (let [z0 (am/enable! true)
        z1 (am/take!)
        n (+ (am/record! "f" "h:1" "10.0.0.1:5000" "http" "" "/a" false 3)
             (am/record! "f" "h:1" "10.0.0.1:5001" "http" "" "/a" true 4)
             (am/record! "f" "h:2" "10.0.0.1:5002" "http" "" "/a" false 5)
             (am/record! "f" "h:1" "10.0.0.2:5003" "https" "" "/a" false 6)
             (am/record! "f" "h:1" "[::1]:5004" "http" "" "/a" false 7))
        s (summary (am/take!))
        e (summary (am/take!))
        z2 (am/enable! false)
        m (am/record! "f" "h:1" "10.0.0.1:5000" "http" "" "/a" false 3)
        off (summary (am/take!))]
    (is (= s (str "f:/a:OK:h:1:10.0.0.1=1 f:/a:FAILED:h:1:10.0.0.1=1 f:/a:OK:h:2:10.0.0.1=1 f:/a:OK:h:1:10.0.0.2=1 "
                  "f:/a:OK:h:1:::1=1")))
    (is (= e ""))
    (is (= off ""))))

;; JSON の文字列: " と \ と制御文字はエスケープし、非 ASCII は UTF-8 のまま (実 Mule の記録の /wild/あ と同じ)
(deftest json-strings
  (let [z0 (am/enable! true)
        z1 (am/take!)
        n (am/record! "f\"q" "h\\1" "1.2.3.4:5" "http" "" "/あ" false 0)
        l (am/line (am/->Commons "" "e" "o" "s" "a" "w") 60000 (am/take!))]
    (is (str/includes? l "\"flow_id\":\"f\\\"q\""))
    (is (str/includes? l "\"host_header\":\"h\\\\1\""))
    (is (str/includes? l "\"endpoint\":\"/あ\""))
    (is (str/includes? l "\"commons\":{\"deployment_type\":\"RTF\",\"env_id\":\"e\","))))

;; --- HTTP リスナーで数える ------------------------------------------------------------------
;; test/fixtures/apps/am-inbound と同じアプリ。実 Mule の記録 (am-inbound.mule-4.12.0.log) と同じ endpoint と OK/FAILED。
;; どのリスナーにも当たらない要求 (404) は数えない。メソッドの合わない POST は /* のフローに当たる

(def XML (str "<mule xmlns=\"http://www.mulesoft.org/schema/mule/core\" xmlns:http=\"http://www.mulesoft.org/schema/mule/http\">\n"
              "<http:listener-config name=\"L\" basePath=\"/api/v1\"><http:listener-connection host=\"0.0.0.0\" port=\"9001\"/></http:listener-config>\n"
              "<flow name=\"items\"><http:listener config-ref=\"L\" path=\"/items/{id}\" allowedMethods=\"GET\"/><set-payload value=\"item\"/></flow>\n"
              "<flow name=\"continued\"><http:listener config-ref=\"L\" path=\"/cont\"/><raise-error type=\"APP:CONT\"/>"
              "<error-handler><on-error-continue><set-payload value=\"continued\"/></on-error-continue></error-handler></flow>\n"
              "<flow name=\"fails\"><http:listener config-ref=\"L\" path=\"/fail\"/><raise-error type=\"APP:FAIL\"/></flow>\n"
              "<flow name=\"rest\"><http:listener config-ref=\"L\" path=\"/*\"/><set-payload value=\"rest\"/></flow>\n"
              "</mule>"))

(defn- call Int [c: &en/Ctx rs: &Vec(run/Route) method: Str path: Str]
  (let [r (run/handle c rs (hm/->Request method path [(hm/->Header "Host" "localhost:18520")] "" "127.0.0.1:5000" 9001 "" "HTTP/1.1" (hm/->NoStream)))]
    (:status r)))

(defn- ends Str [xs: &Vec(am/Agg)]
  (loop [i 0 out ""]
    (if (>= i (count xs)) out
      (let [a (nth xs i)]
        (recur (+ i 1) (str out (if (= i 0) "" " ") (:flow a) ":" (:endpoint a) ":" (:rtype a) ":" (:proto a) ":" (:host a) ":" (:remote a)
                            "=" (:n a)))))))

(deftest listener-records
  (let [a (:app (ld/load-texts "t" ["a.xml"] [XML] (res/res-none) (ld/->LoadOpts [] false (creg/hints))))
        [rs errs] (run/routes a (creg/all))
        c (en/new-ctx a (creg/all) 5)
        z0 (am/enable! true)
        z1 (am/take!)
        st (str (call c rs "GET" "/api/v1/items/42") (call c rs "GET" "/api/v1/items/42") (call c rs "GET" "/api/v1/items/abc")
                (call c rs "GET" "/api/v1/ABC/def") (call c rs "GET" "/api/v1/cont") (call c rs "GET" "/api/v1/fail")
                (call c rs "GET" "/api/v1//x") (call c rs "GET" "/api/v1/x/") (call c rs "GET" "/api/v1/") (call c rs "GET" "/api/v2/x")
                (call c rs "POST" "/api/v1/items/42") (call c rs "GET" "/api/v1/items/%34%32?q=1"))
        s (ends (am/take!))
        z2 (am/enable! false)]
    (is (= st "200200200200200500200200200404200200"))
    (is (= s (str "items:/api/v1/items/X:OK:http:localhost:18520:127.0.0.1=3 items:/api/v1/items/abc:OK:http:localhost:18520:127.0.0.1=1 "
                  "rest:/api/v1/X/def:OK:http:localhost:18520:127.0.0.1=1 continued:/api/v1/cont:OK:http:localhost:18520:127.0.0.1=1 "
                  "fails:/api/v1/fail:FAILED:http:localhost:18520:127.0.0.1=1 rest:/api/v1//x:OK:http:localhost:18520:127.0.0.1=1 "
                  "rest:/api/v1/x/:OK:http:localhost:18520:127.0.0.1=1 rest:/api/v1/:OK:http:localhost:18520:127.0.0.1=1 "
                  "rest:/api/v1/items/X:OK:http:localhost:18520:127.0.0.1=1")))))
