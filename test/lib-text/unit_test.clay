(ns lib-text-unit-test (:require [mulay.dw.lib.core_text :as ct] [mulay.dw.lib.strings :as st]))

;; 補助関数の境界条件。

(deftest find-lit-basic
  (is (= (ct/find-lit "aaaa" "aa") [0 2]))
  (is (= (ct/find-lit "aaa" "aa") [0]))
  (is (= (ct/find-lit "abc" "") [0 1 2]))
  (is (= (ct/find-lit "" "") []))
  (is (= (ct/find-lit "abc" "abcd") []))
  (is (= (ct/find-lit "é😀x" "x") [6])))

(deftest bytes-to-cps
  (is (= (ct/bytes->cps "é😀x" [0 2 6]) [0 1 2]))
  (is (= (ct/bytes->cps "abc" []) [])))

(deftest split-lit-java
  (is (= (ct/split-lit "a,b,,c,," ",") ["a" "b" "" "c"]))
  (is (= (ct/split-lit ",a" ",") ["" "a"]))
  (is (= (ct/split-lit "abab" "ab") []))
  (is (= (ct/split-lit "" ",") [""]))
  (is (= (ct/split-lit "" "") [""]))
  (is (= (ct/split-lit "a😀b" "") ["a" "😀" "b"]))
  (is (= (ct/split-lit "abc" "x") ["abc"])))

(deftest inflector-helpers
  (is (= (st/underscore-str "HTTPServer") "http_server"))
  (is (= (st/underscore-str "a-b c") "a_b_c"))
  (is (= (st/camelize-str "_customer_first_name") "customerFirstName"))
  (is (= (st/camelize-str "") ""))
  (is (= (st/capitalize-str "hELLO wORLD") "H Ello W Orld"))
  (is (= (st/capitalize-str "") "")))
