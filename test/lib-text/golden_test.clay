(ns lib-text-test (:require [mulay.dw.engine :as eng] [clay.string :as cs]))

;; dw::Core の文字列・正規表現の関数と dw::core::Strings の結果を実 DW と比べる。
;; 期待値は実 DW 2.11.2 (tools/dw-oracle) で生成した (indent=false の JSON。エラーは 1 行目)。

(defn- dw Str [expr: Str]
  (let [script (str "%dw 2.0\nimport * from dw::core::Strings\noutput application/json indent=false\n---\n" expr)
        ins: Vec(eng/Input) []
        [mime out err] (eng/run-text script ins)]
    (if (= err "") out (let [i (cs/index-of err "\n")] (str "ERROR: " (if (< i 0) err (subs err 0 i)))))))

(deftest p1-0
  (is (= (dw "\"abcb\" replace /(b)/ with ((m, i) -> \"$(m[1])$(i)\")") "\"ab0cb1\""))
  (is (= (dw "\"hello\" splitBy \"\"") "[\"h\",\"e\",\"l\",\"l\",\"o\"]"))
  (is (= (dw "\"a,b,,c,,\" splitBy \",\"") "[\"a\",\"b\",\"\",\"c\"]"))
  (is (= (dw "\"a1b2c\" splitBy /\\d/") "[\"a\",\"b\",\"c\"]"))
  (is (= (dw "\"abc\" find \"\"") "[0,1,2]"))
  (is (= (dw "\"aaa\" find \"aa\"") "[0]"))
  (is (= (dw "trim(\" x \\t\")") "\"x\""))
  (is (= (dw "isBlank(null)") "true"))
  (is (= (dw "\"\" splitBy \",\"") "[\"\"]"))
  (is (= (dw "\"abc\" match /(a)(x)?/") "[]"))
  (is (= (dw "\"a1b22\" scan /\\d+/") "[[\"1\"],[\"22\"]]"))
  (is (= (dw "\"a1b22\" find /\\d+/") "[[1],[3]]")))

(deftest p2-0
  (is (= (dw "\"abcb\" replace \"b\" with \"x\"") "\"axcx\""))
  (is (= (dw "\"abcb\" replace \"b\" with ((m, i) -> \"[$(m[0])$(i)]\")") "\"a[b0]c[b1]\""))
  (is (= (dw "\"abcb\" replace \"b\" with ((m) -> typeOf(m))") "\"aArraycArray\""))
  (is (= (dw "\"abcb\" replace /b/ with ((m) -> typeOf(m))") "\"aArraycArray\""))
  (is (= (dw "\"aaaa\" find \"aa\"") "[0,2]"))
  (is (= (dw "\"abab\" find /(a)(b)/") "[[0,0,1],[2,2,3]]"))
  (is (= (dw "\"abab\" find /x*/") "[[0],[1],[2],[3],[4]]"))
  (is (= (dw "\"abab\" scan /x*/") "[[\"\"],[\"\"],[\"\"],[\"\"],[\"\"]]"))
  (is (= (dw "\"abab\" scan /(a)(x)?/") "[[\"a\",\"a\",null],[\"a\",\"a\",null]]"))
  (is (= (dw "\"abab\" splitBy /x*/") "[\"a\",\"b\",\"a\",\"b\"]"))
  (is (= (dw "\"abab\" splitBy \"ab\"") "[]"))
  (is (= (dw "\"a.b\" splitBy \".\"") "[\"a\",\"b\"]")))

(deftest p2-1
  (is (= (dw "\"abc\" match /(a)(x)?(bc)/") "[\"abc\",\"a\",null,\"bc\"]"))
  (is (= (dw "\"abc\" matches /ab/") "false"))
  (is (= (dw "\"abc\" contains /b/") "true"))
  (is (= (dw "\"abc\" contains \"\"") "true"))
  (is (= (dw "\"abc\" startsWith \"\"") "true"))
  (is (= (dw "\"abc\" indexOf \"c\"") "2"))
  (is (= (dw "\"abc\" lastIndexOf \"z\"") "-1"))
  (is (= (dw "\"\" find \"\"") "[]"))
  (is (= (dw "isEmpty(\"\")") "true"))
  (is (= (dw "isBlank(\"  \")") "true"))
  (is (= (dw "null replace \"a\" with \"b\"") "null")))

(deftest c1-0
  (is (= (dw "\"abab\" find /(a)(x)?/") "[[0,0,-1],[2,2,-1]]"))
  (is (= (dw "\"xay\" scan /(?<first>a)/") "[[\"a\",\"a\"]]"))
  (is (= (dw "\"abc\" match /x/") "[]"))
  (is (= (dw "\"abc\" matches \"abc\"") "true"))
  (is (= (dw "\"abc\" splitBy /[/") "ERROR: Invalid Regex: Unclosed character class near index 0"))
  (is (= (dw "\"abc\" match /(/") "ERROR: Invalid Regex: Unclosed group near index 1"))
  (is (= (dw "123 splitBy \"2\"") "[\"1\",\"3\"]"))
  (is (= (dw "123 startsWith \"1\"") "true"))
  (is (= (dw "trim(\"  x  \")") "\" x \""))
  (is (= (dw "isBlank(\" \")") "false"))
  (is (= (dw "isBlank(\" \")") "false"))
  (is (= (dw "isBlank(\" \\t\\n\")") "true")))

(deftest c1-1
  (is (= (dw "isEmpty(\"  \")") "false"))
  (is (= (dw "\"abc\" contains \"bc\"") "true"))
  (is (= (dw "\"abc\" contains 1") "false"))
  (is (= (dw "\"a1\" contains /\\d/") "true"))
  (is (= (dw "\"abc\" replace /b/ with (m) -> 1") "\"a1c\""))
  (is (= (dw "\"abc\" replace /b/ with (m) -> null") "ERROR: Expecting Type: `String`, but got: `Null`."))
  (is (= (dw "\"a.b\" replace \".\" with (m, i) -> m[0] ++ \"!\"") "\"a.!b\""))
  (is (= (dw "\"aaa\" replace \"aa\" with \"b\"") "\"ba\""))
  (is (= (dw "\"abc\" replace \"\" with \"-\"") "\"-a-b-c-\""))
  (is (= (dw "\"ABC\" replace /b/ with \"x\"") "\"ABC\""))
  (is (= (dw "\"a\\nb\" scan /^./") "[[\"a\"]]"))
  (is (= (dw "\"aXbX\" splitBy \"X\"") "[\"a\",\"b\"]")))

(deftest c1-2
  (is (= (dw "\"abc\" splitBy \"\"") "[\"a\",\"b\",\"c\"]"))
  (is (= (dw "\"\" splitBy \"\"") "[\"\"]"))
  (is (= (dw "\"\" splitBy /,/") "[\"\"]"))
  (is (= (dw "null splitBy \",\"") "null"))
  (is (= (dw "splitBy(null, 1)") "null"))
  (is (= (dw "scan(null, 1)") "null"))
  (is (= (dw "match(null, 1)") "null"))
  (is (= (dw "find(null, \"a\")") "[]"))
  (is (= (dw "matches(null, 1)") "false"))
  (is (= (dw "startsWith(null, 1)") "false"))
  (is (= (dw "endsWith(null, 1)") "false"))
  (is (= (dw "contains(null, 1)") "false")))

(deftest c1-3
  (is (= (dw "isBlank(null)") "true"))
  (is (= (dw "isEmpty(null)") "true"))
  (is (= (dw "indexOf(null, \"a\")") "-1"))
  (is (= (dw "lastIndexOf(null, \"a\")") "-1"))
  (is (= (dw "\"abcabc\" indexOf \"bc\"") "1"))
  (is (= (dw "\"abcabc\" lastIndexOf \"bc\"") "4"))
  (is (= (dw "\"abc\" indexOf \"\"") "0"))
  (is (= (dw "\"abc\" lastIndexOf \"\"") "2"))
  (is (= (dw "\"aaa\" lastIndexOf \"aa\"") "0")))

(deftest s1-0
  (is (= (dw "[\"customer_first_name\",\"_customer_first_name\",\"customer-first name\",\"CustomerFirst\",\"a__b\",\"\",\"_\",\"a_\",\"customer_1st_name\",\"ÉCOLE_été\"] map camelize($)") "[\"customerFirstName\",\"customerFirstName\",\"customer-first name\",\"customerFirst\",\"aB\",\"\",\"\",\"a\",\"customer1stName\",\"éCOLEÉté\"]"))
  (is (= (dw "[\"customerFirstName\",\"CustomerFirst\",\"ABCDef\",\"a-b c\",\"a1B\",\"HTTPServer\",\"hello  world\",\"already_under\",\"A\",\"\", \"ÉtéCool\"] map underscore($)") "[\"customer_first_name\",\"customer_first\",\"abc_def\",\"a_b_c\",\"a1_b\",\"http_server\",\"hello__world\",\"already_under\",\"a\",\"\",\"étécool\"]"))
  (is (= (dw "[\"customerFirstName\",\"CustomerFirst\",\"ABCDef\",\"a_b c\",\"a1B\",\"HTTPServer\",\"\"] map dasherize($)") "[\"customer-first-name\",\"customer-first\",\"abc-def\",\"a-b-c\",\"a1-b\",\"http-server\",\"\"]"))
  (is (= (dw "[\"customer\",\"customer_first_name\",\"CUSTOMER\",\"hELLO wORLD\",\"\",\"a\",\"é\",\"1abc\",\"customer-first name\",\"customerFirstName\",\"ABCDef\"] map capitalize($)") "[\"Customer\",\"Customer First Name\",\"Customer\",\"H Ello W Orld\",\"\",\"A\",\"É\",\"1abc\",\"Customer First Name\",\"Customer First Name\",\"Abc Def\"]"))
  (is (= (dw "[0,1,2,3,4,11,12,13,21,22,23,101,111,112,1000,-1,-2,-11,2.5,1e3] map ordinalize($)") "[\"0th\",\"1st\",\"2nd\",\"3rd\",\"4th\",\"11th\",\"12th\",\"13th\",\"21st\",\"22nd\",\"23rd\",\"101st\",\"111th\",\"112th\",\"1000th\",\"-1th\",\"-2th\",\"-11th\",\"2nd\",\"1000th\"]"))
  (is (= (dw "[\"person\",\"man\",\"woman\",\"human\",\"child\",\"box\",\"quiz\",\"ox\",\"mouse\",\"index\",\"matrix\",\"vertex\",\"bus\",\"status\",\"alias\",\"octopus\",\"axis\",\"wife\",\"wolf\",\"half\",\"hive\",\"city\",\"query\",\"sheep\",\"Sheep\",\"fish\",\"news\",\"series\",\"datum\",\"analysis\",\"\",\"s\",\"cats\",\"Person\",\"PERSON\",\"tomato\",\"dog\",\"whiskey\",\"money\"] map pluralize($)") "[\"people\",\"men\",\"women\",\"humans\",\"children\",\"boxes\",\"quizzes\",\"oxen\",\"mice\",\"indices\",\"matrices\",\"vertices\",\"buses\",\"statuses\",\"aliases\",\"octopi\",\"axes\",\"wives\",\"wolves\",\"halves\",\"hives\",\"cities\",\"queries\",\"sheep\",\"Sheep\",\"fish\",\"news\",\"series\",\"data\",\"analyses\",\"\",\"s\",\"cats\",\"People\",\"People\",\"tomatoes\",\"dogs\",\"whiskies\",\"money\"]"))
  (is (= (dw "[\"people\",\"men\",\"women\",\"humans\",\"children\",\"boxes\",\"quizzes\",\"oxen\",\"mice\",\"indices\",\"matrices\",\"vertices\",\"buses\",\"statuses\",\"aliases\",\"octopi\",\"axes\",\"wives\",\"wolves\",\"halves\",\"hives\",\"cities\",\"queries\",\"sheep\",\"news\",\"series\",\"data\",\"analyses\",\"\",\"s\",\"cats\",\"People\",\"tomatoes\",\"dogs\",\"whiskies\",\"money\",\"moves\",\"shoes\",\"crises\",\"tests\",\"movies\",\"status\",\"databases\",\"bases\",\"dice\",\"kine\"] map singularize($)") "[\"person\",\"man\",\"woman\",\"human\",\"child\",\"box\",\"quiz\",\"ox\",\"mouse\",\"index\",\"matrix\",\"vertex\",\"bus\",\"status\",\"alias\",\"octopus\",\"axis\",\"wife\",\"wolf\",\"half\",\"hive\",\"city\",\"query\",\"sheep\",\"news\",\"series\",\"datum\",\"analysis\",\"\",\"s\",\"cat\",\"Person\",\"tomato\",\"dog\",\"whiskey\",\"money\",\"move\",\"shoe\",\"crisis\",\"test\",\"movie\",\"status\",\"databasis\",\"basis\",\"die\",\"kow\"]")))

(deftest s2-0
  (is (= (dw "[charCode(\"A\"), charCode(\"é\"), charCode(\"😀\"), charCodeAt(\"abc\", 1), charCodeAt(\"abc\", -1)]") "[65,233,128512,98,99]"))
  (is (= (dw "charCode(\"\")") "ERROR: Unexpected empty string."))
  (is (= (dw "charCodeAt(\"abc\", 5)") "ERROR: Index 5 is out of bounds. Boundary is defined as [0 to 3]."))
  (is (= (dw "charCodeAt(\"abc\", 1.7)") "98"))
  (is (= (dw "[fromCharCode(65), fromCharCode(233), fromCharCode(128512), fromCharCode(65.9)]") "[\"A\",\"é\",\"😀\",\"A\"]"))
  (is (= (dw "fromCharCode(-1)") "ERROR: Unable to convert to character from invalid unicode code point. Code point: `-1`."))
  (is (= (dw "[\"123\",\"12.3\",\"\",\"-1\",\"١٢٣\",\" 1\",\"+1\",\"1e3\"] map isNumeric($)") "[true,false,false,false,true,false,false,false]"))
  (is (= (dw "[\"abc\",\"ab1\",\"\",\"é\",\"a b\",\"日本\"] map isAlpha($)") "[true,false,false,true,false,true]"))
  (is (= (dw "[\"abc\",\"ab1\",\"\",\"é1\",\"a b\",\"a_1\"] map isAlphanumeric($)") "[true,true,false,true,false,false]"))
  (is (= (dw "[\"  \",\"\",\"\\t\\n\",\" a\",\" \"] map isWhitespace($)") "[true,true,true,false,true]"))
  (is (= (dw "[\"ABC\",\"AbC\",\"\",\"A1\",\"É\",\"A B\"] map isUpperCase($)") "[true,false,false,false,true,false]"))
  (is (= (dw "[\"abc\",\"aBc\",\"\",\"a1\",\"é\",\"a b\"] map isLowerCase($)") "[true,false,false,false,true,false]")))

(deftest s2-1
  (is (= (dw "[leftPad(\"ab\",5), leftPad(\"ab\",5,\"xy\"), leftPad(\"abcdef\",3), leftPad(\"ab\",-1), leftPad(\"ab\",4.5), leftPad(\"ab\",5,\"\")]") "[\"   ab\",\"xyxyxyab\",\"abcdef\",\"ab\",\"  ab\",\"ab\"]"))
  (is (= (dw "[rightPad(\"ab\",5), rightPad(\"ab\",5,\"xy\"), rightPad(\"abcdef\",3), rightPad(\"ab\",4.5,\"z\")]") "[\"ab   \",\"abxyxyxy\",\"abcdef\",\"abzz\"]"))
  (is (= (dw "[wrapWith(\"a\",\"'\"), wrapIfMissing(\"'a\",\"'\"), wrapIfMissing(\"a'\",\"'\"), wrapIfMissing(\"'a'\",\"'\"), wrapIfMissing(\"\",\"'\"), wrapIfMissing(\"'\",\"'\")]") "[\"'a'\",\"'a'\",\"'a'\",\"'a'\",\"'\",\"'\"]"))
  (is (= (dw "[substringBefore(\"abcabc\",\"b\"), substringBefore(\"abc\",\"a\"), substringBefore(\"abc\",\"z\"), substringBefore(\"abc\",\"\"), substringBeforeLast(\"abcabc\",\"b\"), substringBeforeLast(\"abc\",\"\"), substringBeforeLast(\"abc\",\"z\")]") "[\"a\",\"\",\"\",\"\",\"abca\",\"ab\",\"\"]"))
  (is (= (dw "[substringAfter(\"abcabc\",\"b\"), substringAfter(\"abc\",\"c\"), substringAfter(\"abc\",\"z\"), substringAfter(\"abc\",\"\"), substringAfterLast(\"abcabc\",\"b\"), substringAfterLast(\"abc\",\"\"), substringAfterLast(\"abc\",\"c\"), substringAfterLast(\"abc\",\"z\")]") "[\"cabc\",\"\",\"\",\"abc\",\"c\",\"\",\"\",\"\"]"))
  (is (= (dw "[repeat(\"ab\",3), repeat(\"ab\",0), repeat(\"ab\",-1), repeat(\"ab\",2.5), repeat(\"\",3)]") "[\"ababab\",\"\",\"\",\"abab\",\"\"]"))
  (is (= (dw "[unwrap(\"'a'\",\"'\"), unwrap(\"'a\",\"'\"), unwrap(\"''\",\"'\"), unwrap(\"'\",\"'\"), unwrap(\"xyax\",\"x\"), unwrap(\"xyzaxyz\",\"xyz\"), unwrap(\"\",\"x\")]") "[\"a\",\"'a\",\"\",\"'\",\"ya\",\"yzaxy\",\"\"]"))
  (is (= (dw "[prependIfMissing(\"abc\",\"ab\"), prependIfMissing(\"c\",\"ab\"), appendIfMissing(\"abc\",\"bc\"), appendIfMissing(\"a\",\"bc\"), prependIfMissing(\"\",\"x\")]") "[\"abc\",\"abc\",\"abc\",\"abc\",\"x\"]"))
  (is (= (dw "[withMaxSize(\"abcdef\",3), withMaxSize(\"ab\",3), withMaxSize(\"abc\",0), withMaxSize(\"abc\",1.5)]") "[\"abc\",\"ab\",\"abc\",\"a\"]"))
  (is (= (dw "withMaxSize(\"abc\",-1)") "ERROR: maxLength should be a positive number"))
  (is (= (dw "[substring(\"hello\",1,3), substring(\"hello\",-2,3), substring(\"hello\",3,1), substring(\"hello\",2,100), substring(\"hello\",10,12), substring(\"hello\",1.5,3)]") "[\"el\",\"hel\",\"\",\"llo\",\"\",\"el\"]"))
  (is (= (dw "[substringEvery(\"abcdefg\",3), substringEvery(\"\",2), substringEvery(\"abc\",0), substringEvery(\"abcde\",2.5)]") "[[\"abc\",\"def\",\"g\"],[],[],[\"abc\",\"de\"]]")))

(deftest s2-2
  (is (= (dw "[collapse(\"aabbbcaa\"), collapse(\"\"), collapse(\"a\")]") "[[\"aa\",\"bbb\",\"c\",\"aa\"],[\"\"],[\"a\"]]"))
  (is (= (dw "[words(\"  hello   world\\tfoo\\n\"), words(\"\"), words(\"   \")]") "[[\"hello\",\"world\",\"foo\"],[],[]]"))
  (is (= (dw "[lines(\"a\\nb\\r\\nc\\rd\"), lines(\"\"), lines(\"a\\n\\n\"), lines(\"\\na\")]") "[[\"a\",\"b\",\"c\",\"d\"],[\"\"],[\"a\"],[\"\",\"a\"]]"))
  (is (= (dw "[first(\"hello\",2), first(\"hi\",5), first(\"hi\",-1), last(\"hello\",2), last(\"hi\",5), last(\"hi\",0), last(\"hi\",-1)]") "[\"he\",\"hi\",\"\",\"lo\",\"hi\",\"\",\"\"]"))
  (is (= (dw "[countMatches(\"abcabc\",\"bc\"), countMatches(\"aaaa\",\"aa\"), countMatches(\"abc\",\"\"), countMatches(\"a1b22\",/\\d/)]") "[2,2,3,3]"))
  (is (= (dw "[countCharactersBy(\"a1b2\", (c) -> isNumeric(c)), everyCharacter(\"\", (c) -> false), someCharacter(\"\", (c) -> true), everyCharacter(\"aa\", (c) -> c == \"a\"), someCharacter(\"ab\", (c) -> c == \"b\")]") "[2,true,false,true,true]"))
  (is (= (dw "[hammingDistance(\"abc\",\"abd\"), hammingDistance(\"abc\",\"ab\"), hammingDistance(\"\",\"\"), levenshteinDistance(\"kitten\",\"sitting\"), levenshteinDistance(\"\",\"abc\"), levenshteinDistance(\"abc\",\"\")]") "[1,null,0,3,3,3]")))

(deftest s3-0
  (is (= (dw "[substringBy(\"a-b--c\", (c,i) -> c == \"-\"), substringBy(\"\", (c,i) -> true), substringBy(\"ab\", (c,i) -> i == 0)]") "[[\"a\",\"b\",\"\",\"c\"],[\"\"],[\"\",\"b\"]]"))
  (is (= (dw "[remove(\"abcabc\",\"b\"), remove(\"abc\",\"\"), mapString(\"abc\", (c,i) -> upper(c) ++ i), mapString(\"\", (c,i) -> c)]") "[\"acac\",\"abc\",\"A0B1C2\",\"\"]"))
  (is (= (dw "[repeat(\"ab\", 0.5), leftPad(\"ab\", 2.5), withMaxSize(\"abc\", 0.5), repeat(\"x\", 1.5)]") "[\"ab\",\" ab\",\"a\",\"x\"]"))
  (is (= (dw "charCodeAt(\"abc\", -5)") "ERROR: Index -5 is out of bounds. Boundary is defined as [0 to 3]."))
  (is (= (dw "charCodeAt(\"\", 0)") "ERROR: Index 0 is out of bounds. Boundary is defined as [0 to 0]."))
  (is (= (dw "[fromCharCode(55357), fromCharCode(1114111)]") "[\"?\",\"􏿿\"]"))
  (is (= (dw "fromCharCode(1114112)") "ERROR: Unable to convert to character from invalid unicode code point. Code point: `1114112`.")))

(deftest e1-0
  (is (= (dw "\"abc\" scan \"b\"") "[[\"b\"]]"))
  (is (= (dw "\"a.c\" matches \"a.c\"") "true"))
  (is (= (dw "\"abc\" match \"a(b)c\"") "[\"abc\",\"b\"]"))
  (is (= (dw "\"a1b2\" replace \"\\\\d\" with \"X\"") "\"a1b2\""))
  (is (= (dw "\"The Quick\" replace /(?i)quick/ with \"slow\"") "\"The slow\""))
  (is (= (dw "\"aaa\" replace /a*/ with \"X\"") "\"XX\""))
  (is (= (dw "\"abc\" replace /x*/ with (m, i) -> i") "\"0a1b2c3\""))
  (is (= (dw "\"a,b;c\" splitBy /[,;]/") "[\"a\",\"b\",\"c\"]"))
  (is (= (dw "\"xAyBz\" splitBy /[A-Z]/") "[\"x\",\"y\",\"z\"]"))
  (is (= (dw "\",a,,b\" splitBy \",\"") "[\"\",\"a\",\"\",\"b\"]"))
  (is (= (dw "\" a b \" splitBy \" \"") "[\"\",\"a\",\"b\"]"))
  (is (= (dw "\"a\\u0000b\" splitBy \"\\u0000\"") "[\"a\",\"b\"]")))

(deftest e1-1
  (is (= (dw "\"ÀÉÎ\" match /(?i)àéî/") "[]"))
  (is (= (dw "upper(\"ǆ\")") "\"Ǆ\""))
  (is (= (dw "lower(\"İ\")") "\"i̇\""))
  (is (= (dw "lower(\"ΑΣ\")") "\"ας\""))
  (is (= (dw "trim(\"\\u0000 a \\u0001\")") "\"a\""))
  (is (= (dw "\"abc\" contains \"abcd\"") "false"))
  (is (= (dw "\"a\" startsWith \"abc\"") "false"))
  (is (= (dw "\"日本語テキスト\" find \"テ\"") "[3]"))
  (is (= (dw "\"日本語テキスト\" splitBy \"\"") "[\"日\",\"本\",\"語\",\"テ\",\"キ\",\"ス\",\"ト\"]"))
  (is (= (dw "\"日本語\" indexOf \"語\"") "2"))
  (is (= (dw "\"x\" replace \"x\" with null") "ERROR: Expecting Type: `String`, but got: `Null`."))
  (is (= (dw "(\"abc\" splitBy \"b\") ++ (\"def\" splitBy \"e\")") "[\"a\",\"c\",\"d\",\"f\"]")))

(deftest e1-2
  (is (= (dw "{a: \"b\"} mapObject (v, k) -> {(k): k startsWith \"a\"}") "{\"a\": true}"))
  (is (= (dw "\"hello world\" groupBy (c) -> c == \"o\"") "{\"false\": \"hell wrld\",\"true\": \"oo\"}"))
  (is (= (dw "\"a b\" groupBy (c, i) -> i mod 2") "{\"0\": \"ab\",\"1\": \" \"}")))

(deftest e2-0
  (is (= (dw "leftPad(123, 5, \"0\")") "\"00123\""))
  (is (= (dw "leftPad(\"a\", \"5\")") "\"    a\""))
  (is (= (dw "pluralize(1)") "\"1s\""))
  (is (= (dw "ordinalize(\"3\")") "\"3rd\""))
  (is (= (dw "ordinalize(2147483648)") "\"-2147483648th\""))
  (is (= (dw "charCodeAt(\"abc\", \"1\")") "98"))
  (is (= (dw "substring(\"hello\", -1, -3)") "\"\""))
  (is (= (dw "substring(\"hello\", 1, 1.5)") "\"eh\""))
  (is (= (dw "substring(\"hello\", 0, 0.5)") "\"h\""))
  (is (= (dw "first(\"hello\", 1.5)") "\"h\""))
  (is (= (dw "last(\"hello\", 1.5)") "\"lo\""))
  (is (= (dw "last(\"hello\", 2.5)") "\"llo\"")))

(deftest e2-1
  (is (= (dw "withMaxSize(null, 1)") "null"))
  (is (= (dw "\"a1b2\" find /(?=\\d)/") "[[1],[3]]"))
  (is (= (dw "\"a1b2\" splitBy /(?<=\\d)/") "[\"a1\",\"b2\"]"))
  (is (= (dw "\"a1b2\" splitBy /(\\d)/") "[\"a\",\"b\"]"))
  (is (= (dw "\"aaa\" scan /a??/") "[[\"\"],[\"\"],[\"\"],[\"\"]]"))
  (is (= (dw "\"abc\" replace /(?<x>b)/ with (m) -> m[1]") "\"abc\""))
  (is (= (dw "\"hello\" splitBy /l/") "[\"he\",\"\",\"o\"]"))
  (is (= (dw "\"test\" match /t(e)(s)(t)/") "[\"test\",\"e\",\"s\",\"t\"]"))
  (is (= (dw "\"CamelCaseString\" replace /([A-Z])/ with (m) -> \"_\" ++ lower(m[1])") "\"_camel_case_string\""))
  (is (= (dw "upper(\"abc\") splitBy \"\"") "[\"A\",\"B\",\"C\"]"))
  (is (= (dw "\"a\" ++ \"b\" splitBy \"\"") "[\"a\",\"b\"]"))
  (is (= (dw "isNumeric(\"12a\")") "false")))

(deftest e2-2
  (is (= (dw "isAlpha(\"abc1\")") "false"))
  (is (= (dw "underscore(\"SSLError\")") "\"ssl_error\""))
  (is (= (dw "dasherize(\"SSLError\")") "\"ssl-error\""))
  (is (= (dw "camelize(\"customer-first\")") "\"customer-first\""))
  (is (= (dw "capitalize(\"über_straße\")") "\"Über Straße\""))
  (is (= (dw "pluralize(\"Quiz\")") "\"Quizzes\""))
  (is (= (dw "singularize(\"Mice\")") "\"Mouse\""))
  (is (= (dw "pluralize(\"salesperson\")") "\"salespeople\""))
  (is (= (dw "pluralize(\"Status\")") "\"Statuses\""))
  (is (= (dw "pluralize(\"information\")") "\"information\""))
  (is (= (dw "countMatches(\"aXbXc\", \"X\")") "2"))
  (is (= (dw "countMatches(null, \"a\")") "null")))

(deftest e2-3
  (is (= (dw "levenshteinDistance(\"ab\", \"ba\")") "2"))
  (is (= (dw "repeat(\"-\", 3.9)") "\"---\""))
  (is (= (dw "wrapWith(null, \"x\")") "null"))
  (is (= (dw "rightPad(null, 3)") "null"))
  (is (= (dw "leftPad(null, 3, \"x\")") "null")))
