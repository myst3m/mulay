(ns textsplit-golden-helper (:require [mulay.lib.textsplit :as ts]))

;; golden の 1 件 (tools/gen-textsplit-golden.java)。文字列は UTF-8 の 16 進、断片は \u0001 で区切る。

(defn- hexd Int [c: Int] (if (<= c 57) (- c 48) (- c 87)))

(defn unhex Str [h: &Str]
  (loop [i 0 out ""]
    (if (>= i (count h)) out
      (recur (+ i 2) (str out (chr (+ (* 16 (hexd (nth h i))) (hexd (nth h (+ i 1))))))))))

(defn- hx Str [b: Int] (let [d "0123456789abcdef"] (str (subs d (quot b 16) (+ (quot b 16) 1)) (subs d (mod b 16) (+ (mod b 16) 1)))))

(defn tohex Str [s: &Str] (loop [i 0 out ""] (if (>= i (count s)) out (recur (+ i 1) (str out (hx (nth s i)))))))

(defn- joined Str [xs: &Vec(Str)] (loop [i 0 out ""] (if (>= i (count xs)) out (recur (+ i 1) (str out (if (> i 0) (chr 1) "") (nth xs i))))))

(defn sentences Str [h: Str] (tohex (joined (ts/sentences (unhex h)))))

(defn recursive Str [h: Str max: Int ov: Int]
  (let [[xs e] (ts/recursive (unhex h) max ov)] (tohex (if (not= e "") (str "!" e) (joined xs)))))
