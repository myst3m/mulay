;; tools/gen-ssh-kex-golden.py で作った (手で直さない)。期待値は paramiko 5.0.0
(ns kex-test (:require [mulay.lib.sshkex :as kx] [mulay.dw.lib.binaries :as bin]))

(defn- hexd Int [c: Int] (if (<= c 57) (- c 48) (- c 87)))
(defn- unhex Str [h: &Str]
  (loop [i 0 out ""] (if (>= i (count h)) out
    (recur (+ i 2) (str out (chr (+ (* 16 (hexd (nth h i))) (hexd (nth h (+ i 1))))))))))

(defn- lists Vec(Vec(Str)) []
  [["curve25519-sha256" "curve25519-sha256@libssh.org" "kex-strict-c-v00@openssh.com"] ["ssh-ed25519" "rsa-sha2-512" "rsa-sha2-256"] ["aes128-gcm@openssh.com" "chacha20-poly1305@openssh.com" "aes256-ctr"] ["aes128-gcm@openssh.com" "chacha20-poly1305@openssh.com" "aes256-ctr"] ["hmac-sha2-256-etm@openssh.com" "hmac-sha2-256"] ["hmac-sha2-256-etm@openssh.com" "hmac-sha2-256"] ["none"] ["none"] (let [e: Vec(Str) []] e) (let [e: Vec(Str) []] e)])

;; KEXINIT の payload を作ると paramiko と同じバイト列になり、読み戻すと同じ中身になる
(deftest kexinit-build
  (is (= (bin/hex-lower (kx/kexinit-payload (kx/->Kexinit (unhex "01080f161d242b323940474e555c636a") (lists) false))) "")))

(deftest kexinit-parse
  (let [[k ok] (kx/parse-kexinit (unhex ""))]
    (is ok)
    (is (= (bin/hex-lower (:cookie k)) "090e13181d22272c31363b40454a4f54"))
    (is (= (:lists k) (lists)))
    (is (not (:first-follows k)))
    (is (= (bin/hex-lower (kx/kexinit-payload k)) ""))))

;; curve25519-sha256 の交換ハッシュ H (RFC 8731 3 節)。K の最上位のビットが立つので mpint に 0 が付く
(deftest exchange-hash
  (is (= (bin/hex-lower (kx/exchange-hash "SHA256" "SSH-2.0-mulay_1.0" "SSH-2.0-OpenSSH_9.2p1 Debian-2+deb12u10" (unhex "") (unhex "")
                                          (unhex "0205080b0e1114171a1d202326292c2f3235383b3e4144474a4d505356595c5f6265686b6e7174777a7d808386898c8f929598") (unhex "040d161f28313a434c555e677079828b949da6afb8c1cad3dce5eef70009121b") (unhex "061524334251606f7e8d9cabbac9d8e7f60514233241505f6e7d8c9baab9c8d7") (unhex "91081d32475c71869bb0c5daef04192e43586d8297acc1d6eb00152a3f54697e")))
         "888f7ec2163bf880461059feac837f51893971e0cf92cdf3c86d084c538ae159")))

;; 鍵の導出 (RFC 4253 7.2): A〜F と、ハッシュより長い鍵 (100 バイト、K1 || K2 || ..)
(deftest derive-keys
  (is (= (bin/hex-lower (kx/derive "SHA256" (unhex "91081d32475c71869bb0c5daef04192e43586d8297acc1d6eb00152a3f54697e") (unhex "888f7ec2163bf880461059feac837f51893971e0cf92cdf3c86d084c538ae159") "A" (unhex "031e39546f8aa5c0dbf6112c47627d98b3cee9041f3a55708ba6c1dcf7122d48") 16)) "92dd122a1a9338cda63fb26fd53856f4"))
  (is (= (bin/hex-lower (kx/derive "SHA256" (unhex "91081d32475c71869bb0c5daef04192e43586d8297acc1d6eb00152a3f54697e") (unhex "888f7ec2163bf880461059feac837f51893971e0cf92cdf3c86d084c538ae159") "B" (unhex "031e39546f8aa5c0dbf6112c47627d98b3cee9041f3a55708ba6c1dcf7122d48") 16)) "485b2a27157481d61f4119af1b7ba72c"))
  (is (= (bin/hex-lower (kx/derive "SHA256" (unhex "91081d32475c71869bb0c5daef04192e43586d8297acc1d6eb00152a3f54697e") (unhex "888f7ec2163bf880461059feac837f51893971e0cf92cdf3c86d084c538ae159") "C" (unhex "031e39546f8aa5c0dbf6112c47627d98b3cee9041f3a55708ba6c1dcf7122d48") 64)) "0191033b6e39d3a13dc3dfb4f01751d063fdd72292230721a0d6d2791bfa579109337c57971956fada4796f4aeb8063b2b2c2c4e0b6d0a7cd50539704946cb78"))
  (is (= (bin/hex-lower (kx/derive "SHA256" (unhex "91081d32475c71869bb0c5daef04192e43586d8297acc1d6eb00152a3f54697e") (unhex "888f7ec2163bf880461059feac837f51893971e0cf92cdf3c86d084c538ae159") "D" (unhex "031e39546f8aa5c0dbf6112c47627d98b3cee9041f3a55708ba6c1dcf7122d48") 64)) "702cf17f9a465dc8b01114161cabbcf818df5465053c322abce0e248cb7b27d367df354fe58b96bf63736f46d574f2e7bf6c179d27a4fc24156972997b2ebfb8"))
  (is (= (bin/hex-lower (kx/derive "SHA256" (unhex "91081d32475c71869bb0c5daef04192e43586d8297acc1d6eb00152a3f54697e") (unhex "888f7ec2163bf880461059feac837f51893971e0cf92cdf3c86d084c538ae159") "E" (unhex "031e39546f8aa5c0dbf6112c47627d98b3cee9041f3a55708ba6c1dcf7122d48") 32)) "7de69c5a8b76524405961de2f8f843da0c63853b28002d97bedd0318169d7f4e"))
  (is (= (bin/hex-lower (kx/derive "SHA256" (unhex "91081d32475c71869bb0c5daef04192e43586d8297acc1d6eb00152a3f54697e") (unhex "888f7ec2163bf880461059feac837f51893971e0cf92cdf3c86d084c538ae159") "F" (unhex "031e39546f8aa5c0dbf6112c47627d98b3cee9041f3a55708ba6c1dcf7122d48") 32)) "9edae691f77680677e62d8f81c7c40363276e96053d2fb174e51b23270c90792"))
  (is (= (bin/hex-lower (kx/derive "SHA256" (unhex "91081d32475c71869bb0c5daef04192e43586d8297acc1d6eb00152a3f54697e") (unhex "888f7ec2163bf880461059feac837f51893971e0cf92cdf3c86d084c538ae159") "C" (unhex "031e39546f8aa5c0dbf6112c47627d98b3cee9041f3a55708ba6c1dcf7122d48") 100)) "0191033b6e39d3a13dc3dfb4f01751d063fdd72292230721a0d6d2791bfa579109337c57971956fada4796f4aeb8063b2b2c2c4e0b6d0a7cd50539704946cb781900746d7097834ac80be4c6ac69fa83652983f96c965d62a0406668cdb2b9147781f226")))

;; DH (diffie-hellman-group14-sha256 / group16-sha512) の交換ハッシュ: e と f は mpint (RFC 4253 8 節)
(deftest exchange-hash-dh
  (is (= (bin/hex-lower (kx/exchange-hash-dh "SHA256" "SSH-2.0-mulay_1.0" "SSH-2.0-OpenSSH_9.2p1 Debian-2+deb12u10" (unhex "") (unhex "")
                                             (unhex "0205080b0e1114171a1d202326292c2f3235383b3e4144474a4d505356595c5f6265686b6e7174777a7d808386898c8f929598") (unhex "") (unhex "") (unhex "91081d32475c71869bb0c5daef04192e43586d8297acc1d6eb00152a3f54697e")))
         "1dfec07253888e1120c6fc0c32c4d79aab36e113efe19f7c73b478efd4b93e07"))
  (is (= (bin/hex-lower (kx/exchange-hash-dh "SHA512" "SSH-2.0-mulay_1.0" "SSH-2.0-OpenSSH_9.2p1 Debian-2+deb12u10" (unhex "") (unhex "")
                                             (unhex "0205080b0e1114171a1d202326292c2f3235383b3e4144474a4d505356595c5f6265686b6e7174777a7d808386898c8f929598") (unhex "") (unhex "") (unhex "91081d32475c71869bb0c5daef04192e43586d8297acc1d6eb00152a3f54697e")))
         "8d871d8055451eb1e57a126c22728aaf406c76c124377b28a73c94ecb03d83f6e691575afdb82a3897bedb3087cf19e59de576dd96f4ad2439d652e35152aed9"))
  )

;; DH の素数と生成元、要約の名前
(deftest dh-groups
  (is (= (bin/hex-lower (kx/dh-prime "diffie-hellman-group14-sha256")) ""))
  (is (= (bin/hex-lower (kx/dh-prime "diffie-hellman-group16-sha512")) ""))
  (is (= (kx/dh-prime "curve25519-sha256") ""))
  (is (= (kx/kex-hash "diffie-hellman-group16-sha512") "SHA512"))
  (is (= (kx/kex-hash "diffie-hellman-group14-sha256") "SHA256"))
  (is (= (kx/kex-hash "curve25519-sha256@libssh.org") "SHA256")))
