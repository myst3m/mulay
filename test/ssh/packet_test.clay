  (is (seal3 "none" "" "" "" ""
             "5e" "001d3a577491aecbe805" "0000000c0a5e001d3a577491aecbe805"
             "5e030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3eaf1f8" "011e3b587592" "0000002c065e030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dce3eaf1f8011e3b587592"
