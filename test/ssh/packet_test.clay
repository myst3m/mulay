;; tools/gen-ssh-packet-golden.py で作った (手で直さない)。方式ごとに 3 つのパケットを、連番 0xfffffffe から続けて封じたもの
(ns packet-test (:require [mulay.lib.sshpkt :as p] [mulay.dw.lib.binaries :as bin]))

(defn- hexd Int [c: Int] (if (<= c 57) (- c 48) (- c 87)))
(defn- unhex Str [h: &Str]
  (loop [i 0 out ""] (if (>= i (count h)) out
    (recur (+ i 2) (str out (chr (+ (* 16 (hexd (nth h i))) (hexd (nth h (+ i 1))))))))))

;; 3 つのパケットを順に封じて、golden と同じバイト列になるか
(defn- seal3 Bool [cipher: Str mac: Str key: Str iv: Str mk: Str pl0: Str pad0: Str w0: Str pl1: Str pad1: Str w1: Str pl2: Str pad2: Str w2: Str]
  (let [[d0 err] (p/new-dir cipher mac (unhex key) (unhex iv) (unhex mk))
        [x0 d1] (p/seal-padded (p/with-seq d0 4294967294) (unhex pl0) (unhex pad0))
        [x1 d2] (p/seal-padded d1 (unhex pl1) (unhex pad1))
        [x2 d3] (p/seal-padded d2 (unhex pl2) (unhex pad2))]
    (and (= err "") (= (bin/hex-lower x0) w0) (= (bin/hex-lower x1) w1) (= (bin/hex-lower x2) w2))))

;; 3 つをつないだバイト列から、順に取り出せるか (最後の 1 バイトが無ければ need-more)
(defn- open3 Bool [cipher: Str mac: Str key: Str iv: Str mk: Str pl0: Str w0: Str pl1: Str w1: Str pl2: Str w2: Str]
  (let [[d0 err] (p/new-dir cipher mac (unhex key) (unhex iv) (unhex mk))
        buf (unhex (str w0 w1 w2))
        [s0 x0 n0 d1 e0] (p/unseal (p/with-seq d0 4294967294) buf)
        rest1 (subs buf n0 (count buf))
        [s1 x1 n1 d2 e1] (p/unseal d1 rest1)
        rest2 (subs rest1 n1 (count rest1))
        [sm xm nm dm em] (p/unseal d2 (subs rest2 0 (- (count rest2) 1)))
        [s2 x2 n2 d3 e2] (p/unseal d2 rest2)]
    (and (= err "") (= s0 0) (= s1 0) (= s2 0) (= sm 1) (= n2 (count rest2))
         (= (bin/hex-lower x0) pl0) (= (bin/hex-lower x1) pl1) (= (bin/hex-lower x2) pl2))))

