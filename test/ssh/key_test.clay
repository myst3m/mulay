;; tools/gen-ssh-key-golden.py で作った (手で直さない)。鍵と署名は paramiko 5.0.0、ハッシュされた名前は HostKeys.hash_host
(ns key-test (:require [mulay.lib.sshkey :as k]))

(defn- hexd Int [c: Int] (if (<= c 57) (- c 48) (- c 87)))
(defn- unhex Str [h: &Str]
  (loop [i 0 out ""] (if (>= i (count h)) out
    (recur (+ i 2) (str out (chr (+ (* 16 (hexd (nth h i))) (hexd (nth h (+ i 1))))))))))

(def H "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dc")
(def ED-BLOB "0000000b7373682d6564323535313900000020f6a84f875abe82b613215b020778cdf64b613bbaa81e52338be1b916ae3277d0")
(def ED-SIG "0000000b7373682d65643235353139000000405ed8cf3182224282ed853910e0d4b8760d9f4c9d0fe2607d2cf69e1b479298255f1e5c3c337f2693101e742622adda96ee75f90b746eff0dacb4dd848dd46b06")
(def RSA-BLOB "")
(def RSA-SIG256 "")
(def RSA-SIG512 "")
(def RSA-SIG1 "")
(def SMALL-BLOB "")
(def SMALL-SIG "0000000c7273612d736861322d323536000000804780fcb0ba43150b4aa1f0e1d7f837ebf6637516d444f88bef959fad3e04acf9a0831d220338a8c87512b0a48f36ad1d6295330be43f0e419d21ed3140050375c0126eee56d8c51ca3dc97481d25a5c779fe96fe5ae6ef63a7ccd79fe32fb4b91ec5fda3d88b1b8af48de68e42c6793031b0788d5dc31ea59c0f8bdfc781ec9c")
(def EC-BLOB "0000001365636473612d736861322d6e69737470323536000000086e69737470323536000000410439d0bc9ac721834ee7b189685bd37422675dc0240de4c0483ce0b02621a8455995f0ac6b8bcc5b87b1112e095ef84e5d39e52e37a5775f59b0b0d7470e1c02c8")
(def EC-SIG "0000001365636473612d736861322d6e69737470323536000000490000002100a68d8babe85872fac3b186cb518238c13b666641e8b9b066651fbe01acdd78c9000000202da29a30581f4f90d2b2a9f1e2748a2cfed6f7ace337cd1307e442a00ade70d7")
(def ED-B64 "AAAAC3NzaC1lZDI1NTE5AAAAIPaoT4davoK2EyFbAgd4zfZLYTu6qB5SM4vhuRauMnfQ")
(def EC-B64 "AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAAAIbmlzdHAyNTYAAABBBDnQvJrHIYNO57GJaFvTdCJnXcAkDeTASDzgsCYhqEVZlfCsa4vMW4exES4JXvhOXTnlLjeld19ZsLDXRw4cAsg=")
(def RSA-B64 "")
(def HASH-PLAIN "|1|AQQHCg0QExYZHB8iJSgrLjE0Nzo=|ZdYYXy3KchpEhjcKEE7EImxtKCY=")
(def HASH-PORT "|1|BA0WHygxOkNMVV5ncHmCi5Sdpq8=|US02aoOmq9Jmi8zO3Z5fjjGg0XM=")

(defn- verify Str [alg: Str blob: Str sig: Str data: Str] (k/verify-signature alg (unhex blob) (unhex sig) (unhex data)))

;; 交渉した方式で、ホスト鍵が H に付けた署名を確かめる
(deftest signatures-good
  (is (= (verify "ssh-ed25519" ED-BLOB ED-SIG H) ""))
  (is (= (verify "rsa-sha2-256" RSA-BLOB RSA-SIG256 H) ""))
  (is (= (verify "rsa-sha2-512" RSA-BLOB RSA-SIG512 H) ""))
  (is (= (verify "ecdsa-sha2-nistp256" EC-BLOB EC-SIG H) "")))

;; ecdsa-sha2-nistp256 (RFC 5656 3.1): 違うデータ、壊れた署名、曲線の名前の違う鍵
(deftest signatures-ecdsa-bad
  (is (not= (verify "ecdsa-sha2-nistp256" EC-BLOB EC-SIG (str H "00")) ""))
  (is (not= (verify "ecdsa-sha2-nistp256" EC-BLOB (str (subs EC-SIG 0 (- (count EC-SIG) 2)) "00") H) ""))
  (is (not= (verify "ecdsa-sha2-nistp256" ED-BLOB ED-SIG H) ""))
  (is (not= (verify "ssh-ed25519" EC-BLOB EC-SIG H) ""))
  (is (not= (k/verify-signature "ecdsa-sha2-nistp256" (str (subs (unhex EC-BLOB) 0 27) "nistp384" (subs (unhex EC-BLOB) 35 (count (unhex EC-BLOB)))) (unhex EC-SIG) (unhex H)) "")))

;; known_hosts に行のある鍵の種類 (ホスト鍵の方式の並びで先に出す)。ssh-rsa は rsa-sha2-512 と rsa-sha2-256
(deftest known-algorithms
  (let [t (str "[127.0.0.1]:2222 ecdsa-sha2-nistp256 " EC-B64 "\nother ssh-ed25519 " ED-B64 "\n[127.0.0.1]:2222 ssh-rsa " RSA-B64 "\n@revoked [127.0.0.1]:2222 ssh-ed25519 " ED-B64 "\n")]
    (is (= (k/known-algorithms t "127.0.0.1" 2222) ["ecdsa-sha2-nistp256" "rsa-sha2-512" "rsa-sha2-256"]))
    (is (= (k/known-algorithms t "other" 22) ["ssh-ed25519"]))
    (is (= (k/known-algorithms t "nobody" 22) (let [e: Vec(Str) []] e)))))

;; 鍵の blob の名前は ssh-rsa のまま、署名の blob の名前は交渉した方式でなければならない (RFC 8332 3 節)
(deftest signatures-bad
  (is (not= (verify "rsa-sha2-256" RSA-BLOB RSA-SIG512 H) ""))
  (is (not= (verify "rsa-sha2-512" RSA-BLOB RSA-SIG256 H) ""))
  (is (not= (verify "rsa-sha2-256" RSA-BLOB RSA-SIG1 H) ""))
  (is (not= (verify "ssh-ed25519" RSA-BLOB RSA-SIG256 H) ""))
  (is (not= (verify "rsa-sha2-256" ED-BLOB ED-SIG H) ""))
  (is (not= (verify "ssh-ed25519" ED-BLOB ED-SIG (str H "00")) ""))
  (is (not= (verify "rsa-sha2-256" RSA-BLOB RSA-SIG256 (str H "00")) ""))
  (is (not= (verify "ssh-ed25519" ED-BLOB (str ED-SIG "00") H) ""))
  (is (not= (verify "ssh-ed25519" (str ED-BLOB "00") ED-SIG H) ""))
  (is (not= (verify "ssh-ed25519" ED-BLOB (subs ED-SIG 0 (- (count ED-SIG) 2)) H) ""))
  (is (not= (verify "ssh-dss" ED-BLOB ED-SIG H) ""))
;; 1024 ビットの RSA は通す (OpenSSH の RequiredRSASize の既定と同じ下限)。1023 ビット以下は断る
  (is (= (verify "rsa-sha2-256" SMALL-BLOB SMALL-SIG H) ""))
  (is (k/rsa-bits-ok? (str (chr 128) (subs (unhex H) 0 31) (unhex H) (unhex H) (unhex H))))
  (is (not (k/rsa-bits-ok? (str (chr 127) (subs (unhex H) 0 31) (unhex H) (unhex H) (unhex H))))))

;; known_hosts の照合。ポートが 22 でなければ [host]:port で引く
(deftest known-hosts-plain
  (let [blob (unhex ED-BLOB) rsab (unhex RSA-BLOB)
        t1 (str "# c\n\n[127.0.0.1]:2222 ssh-ed25519 " ED-B64 " comment\n")
        t2 (str "host1,Example.ORG,10.0.0.1 ssh-ed25519 " ED-B64 "\n")
        t3 (str "*.example.com,!bad.example.com ssh-ed25519 " ED-B64 "\n")
        t4 (str "h?st ssh-rsa " RSA-B64 "\n")]
    (is (k/known? t1 "127.0.0.1" 2222 blob))
    (is (not (k/known? t1 "127.0.0.1" 22 blob)))
    (is (not (k/known? t1 "127.0.0.1" 2222 rsab)))
    (is (k/known? t2 "example.org" 22 blob))
    (is (k/known? t2 "10.0.0.1" 22 blob))
    (is (not (k/known? t2 "10.0.0.2" 22 blob)))
    (is (not (k/known? t2 "example.org" 2222 blob)))
    (is (k/known? t3 "a.example.com" 22 blob))
    (is (not (k/known? t3 "bad.example.com" 22 blob)))
    (is (not (k/known? t3 "example.com" 22 blob)))
    (is (k/known? t4 "host" 22 rsab))
    (is (not (k/known? t4 "hoost" 22 rsab)))
    (is (not (k/known? t4 "host" 22 blob)))))

;; ハッシュされた名前 (|1|salt|hash)、@revoked (一致すれば他の行があっても断る)、@cert-authority (飛ばす)、壊れた行
(deftest known-hosts-markers
  (let [blob (unhex ED-BLOB)
        th (str HASH-PLAIN " ssh-ed25519 " ED-B64 "\n" HASH-PORT " ssh-ed25519 " ED-B64 "\n")
        tr (str "[127.0.0.1]:2222 ssh-ed25519 " ED-B64 "\n@revoked * ssh-ed25519 " ED-B64 "\n")
        tc (str "@cert-authority [127.0.0.1]:2222 ssh-ed25519 " ED-B64 "\n")
        tb (str "[127.0.0.1]:2222 ssh-ed25519 !!!notbase64\n[127.0.0.1]:2222\n@revoked\n|1|x|y ssh-ed25519 " ED-B64 "\n")]
    (is (k/known? th "example.org" 22 blob))
    (is (k/known? th "127.0.0.1" 2222 blob))
    (is (not (k/known? th "example.com" 22 blob)))
    (is (not (k/known? tr "127.0.0.1" 2222 blob)))
    (is (not (k/known? tc "127.0.0.1" 2222 blob)))
    (is (not (k/known? tb "127.0.0.1" 2222 blob)))
    (is (k/known? (str tb "[127.0.0.1]:2222 ssh-ed25519 " ED-B64) "127.0.0.1" 2222 blob))))
