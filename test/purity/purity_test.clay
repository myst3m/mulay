(ns purity-test (:require [mulay.dw.engine :as eng]))

(defn- pure-of Str [text: Str]
  (let [c (eng/compile text ["payload"])
        fns (:fns (:prog c))
        ps (:pure (:code c))]
    (loop [i 0 out ""]
      (if (>= i (count fns)) out
        (let [n (:name (nth fns i))]
          (recur (+ i 1) (str out n "=" (if (and (< i (count ps)) (nth ps i)) "p" "i") " ")))))))

(deftest purity-follows-calls-and-function-arguments
  (let [s (pure-of (str "%dw 2.0\n"
                        "fun a(x) = x + 1\n"
                        "fun b(x) = uuid() ++ x\n"
                        "fun c(x) = a(x)\n"
                        "fun d(x) = b(x)\n"
                        "fun e(xs) = xs map a($)\n"
                        "fun f(xs, g) = xs map g\n"
                        "fun r(n) = if (n <= 0) 0 else r(n - 1)\n"
                        "fun t(x) = log(x)\n"
                        "fun u(x = now()) = x\n"
                        "---\n1"))]
    (is (= s "a=p b=i c=p d=i e=p f=i r=p t=i u=i <anonymous>=p "))))
