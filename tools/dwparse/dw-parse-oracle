#!/bin/sh
# 実 DataWeave (Mule 4.11 同梱の DW 2.11.2) のパーサで DW を parse する。golden の生成と照合用。
#   echo 'a + b' | tools/dwparse/dw-parse-oracle           S 式風の表示 (\n=====\n で区切って複数可)
#   ... | dw-parse-oracle -json                             入力: 各レコード "e|m\n<src>" を \001\n で区切る
#   ... | dw-parse-oracle -files                            入力: パスの並び。"OK\tpath" / "ERR\tpath\tmsg"
# MULE_HOME で Mule のインストール先を変えられる。
set -eu
HERE=$(cd "$(dirname "$0")" && pwd)
MULE_HOME=${MULE_HOME:-$HOME/srv/mule-enterprise-standalone-4.11.3}
L=$(ls -d "$MULE_HOME"/services/mule-service-weave-ee-*/lib | head -1)
CP=""
for j in "$L"/parser-*.jar "$L"/parboiled_*.jar "$L"/scala-library-*.jar "$L"/scala-common_*.jar \
         "$L"/scala-parser-combinators_*.jar "$L"/tooling-api-*.jar; do CP="$CP:$j"; done
OUT=${XDG_CACHE_HOME:-$HOME/.cache}/mulay-dw-parse-oracle
mkdir -p "$OUT"
if [ ! -f "$OUT/DwParse.class" ] || [ "$HERE/DwParse.java" -nt "$OUT/DwParse.class" ]; then
  javac --release 17 -nowarn -cp "$CP" -d "$OUT" "$HERE/DwParse.java"
fi
exec java -cp "$CP:$OUT" DwParse "$@"
