#!/usr/bin/env bash
# 実 Mule の DataWeave で .dwt を評価する。使い方は DwOracle.java の先頭を参照。
set -eu
# DW_ORACLE_EXTRA_CP: Mule の jar の後ろに足す jar (dw::test の jar は tools/dw-oracle/fetch-testfw.sh が出す)
here="$(cd "$(dirname "$0")" && pwd)"
MULE_HOME="${MULE_HOME:-$HOME/srv/mule-enterprise-standalone-4.11.3}"
cp="$(ls "$MULE_HOME"/services/mule-service-weave-ee-*/lib/*.jar "$MULE_HOME"/lib/mule/*dwb*.jar | tr '\n' ':')"
out="$here/.classes"
if [ ! -f "$out/DwOracle.class" ] || [ "$here/DwOracle.java" -nt "$out/DwOracle.class" ]; then
  mkdir -p "$out"; javac --release 17 -nowarn -cp "$cp" -d "$out" "$here/DwOracle.java"
fi
exec java -Xshare:auto -cp "$cp:$out${DW_ORACLE_EXTRA_CP:+:$DW_ORACLE_EXTRA_CP}" DwOracle "$@"
