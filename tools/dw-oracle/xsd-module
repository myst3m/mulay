#!/usr/bin/env bash
# 実 DW が XSD から作る DataWeave のモジュールを書き出す (XsdModule.java)。使い方: xsd-module <クラスパスのディレクトリ> <a::b::C>
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
MULE_HOME="${MULE_HOME:-$HOME/srv/mule-enterprise-standalone-4.11.3}"
cp="$(ls "$MULE_HOME"/services/mule-service-weave-ee-*/lib/*.jar "$MULE_HOME"/lib/mule/*dwb*.jar | tr '\n' ':')"
out="$here/.classes"
J=/usr/lib/jvm/java-17-openjdk-amd64/bin
if [ ! -f "$out/XsdModule.class" ] || [ "$here/XsdModule.java" -nt "$out/XsdModule.class" ]; then
  mkdir -p "$out"; $J/javac --release 17 -nowarn -cp "$cp" -d "$out" "$here/XsdModule.java"
fi
exec $J/java -cp "$1:$cp:$out" XsdModule "$2"
