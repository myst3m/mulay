(ns fuzz-entry (:require [mulay.note.run :as note] [mulay.mule.amodel :as am] [mulay.mule.model :as m] [mulay.lib.host :as host] [clay.string :as str]))

(defn- out Int [s: Str] (let [z (if (= (getenv "FUZZ_PRINT" "") "") 0 (let [y (println s)] 0))] (count s)))

(defn- one Int [arg: &Str]
  (let [k (str/index-of arg ":")
        op (if (< k 0) "" (subs arg 0 k))
        [t e] (host/file-read (if (< k 0) "" (subs arg (+ k 1) (count arg))))]
    (cond (not= e "") 0
          (= op "run") (out (note/trace-json (note/run-example t)))
          (= op "call") (out (note/call-json t))
          (= op "scaffold") (out (note/scaffold-json t))
          (= op "value") (out (note/get-value t))
          (= op "components") (out (note/components-json (str/split t "\n")))
          :else 0)))

(defn main Int []
  (let [dir (argv-nth 1)
        [pt pe] (host/file-read (str dir "/@properties"))
        [props perr] (if (not= pe "") (let [z: Vec(m/Param) []] (values z "")) (note/props-json pt))
        [lt le] (host/file-read (str dir "/@links"))
        md (note/load-dir-full dir props (if (= le "") lt ""))
        n0 (count (am/to-json md))
        n (loop [i 2 acc n0] (if (>= i (argv-len)) acc (recur (+ i 1) (+ acc (one (argv-nth i))))))
        z (println (str "ok " n))]
    0))
