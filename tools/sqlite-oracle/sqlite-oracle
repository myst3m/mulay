#!/bin/sh
# 実 Mule と同じ sqlite-jdbc 3.50.3.0 (SQLite 3.50.3) で式を評価する。SqliteOracle.java を参照
here=$(cd "$(dirname "$0")" && pwd)
jar="$HOME/.m2/repository/org/xerial/sqlite-jdbc/3.50.3.0/sqlite-jdbc-3.50.3.0.jar"
exec /usr/lib/jvm/java-17-openjdk-amd64/bin/java -cp "$jar" "$here/SqliteOracle.java" "$@"
