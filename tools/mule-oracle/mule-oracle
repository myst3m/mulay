def missing_requires(app_dir):
    """requires <path>...: アプリのディレクトリからの相対パスで、無いもの (認証情報など、リポジトリに入れないファイル)"""
    try:
        text = open(os.path.join(app_dir, "scenario.scn"), encoding="utf-8").read()
    except OSError:
        return []
    out = []
    for line in text.split("\n"):
        if line.startswith(MARK + "requires "):
            for p in line[len(MARK + "requires "):].split():
                if not os.path.exists(os.path.join(app_dir, p)):
                    out.append(p)
    return out


def resolve_apps(args):
    if not args:
        apps = sorted(os.path.join(APPS_DIR, d) for d in os.listdir(APPS_DIR)
                      if os.path.exists(os.path.join(APPS_DIR, d, "scenario.scn")))
        keep = []
        for a in apps:
            miss = missing_requires(a)
            if miss:
                print(f"SKIP {os.path.basename(a)}: missing {', '.join(miss)}", file=sys.stderr)
            else:
                keep.append(a)
        return keep
    out = []
    for a in args:
        if a.endswith(".scn"):
            a = os.path.dirname(os.path.abspath(a))
        elif not os.path.isdir(a):
            a = os.path.join(APPS_DIR, a)
        out.append(os.path.abspath(a))
    return out


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__); return 2
    mode, rest = argv[0], argv[1:]
    if mode == "clean":
        shutil.rmtree(RT, ignore_errors=True); shutil.rmtree(BUILD, ignore_errors=True); return 0
    if mode == "mulay":
        verbose, record, lazy, lazy_shared, jobs, apps = False, False, False, True, 1, []
        i = 0
        while i < len(rest):
            a = rest[i]
            if a == "-v": verbose = True
            elif a == "--record": record = True
            elif a == "--lazy": lazy = True
            elif a == "--lazy-local": lazy, lazy_shared = True, False
            elif a == "-j": i += 1; jobs = int(rest[i])
            else: apps.append(a)
            i += 1
        return mulay_main(resolve_apps(apps), verbose, record, jobs, lazy, lazy_shared)
    if mode not in ("fill", "check", "run"):
        print(__doc__); return 2
    if mode == "fill" and not MULE_EE:
        print(f"fill records expectations from Mule EE only ({MULE_SRC} is CE {MULE_VER})", file=sys.stderr); return 2
    no_build, jobs, apps = False, 4, []
    i = 0
    while i < len(rest):
        a = rest[i]
        if a == "--no-build": no_build = True
        elif a == "-j": i += 1; jobs = int(rest[i])
        else: apps.append(a)
        i += 1
    apps = resolve_apps(apps)
    scs = [Scenario(a) for a in apps]
    groups = {}
    for sc in scs:
        groups.setdefault(sc.jvm, []).append(sc.app_dir)
    if len(groups) > 1:   # JVM の引数が違うアプリは、別々の Mule で順に走らせる
        rc = 0
        flags = (["--no-build"] if no_build else []) + ["-j", str(jobs)]
        for jvm, dirs in sorted(groups.items()):
            print(f"== JVM {' '.join(jvm) if jvm else '(default)'}: {len(dirs)} app(s)", file=sys.stderr)
            rc = max(rc, subprocess.call([sys.executable, os.path.abspath(__file__), mode] + flags + dirs))
        return rc
    global EXTRA_JVM
    EXTRA_JVM = list(scs[0].jvm) if scs else []
    ports = {}
    for sc in scs:
        for p in sorted({sc.port, *sc.extra_ports, *sc.raw_ports, *listener_ports(sc.app_dir)}):
            if p in ports:
                print(f"port {p} used by both {ports[p]} and {sc.name}", file=sys.stderr); return 2
            ports[p] = sc.name
    t0 = time.time()   # 直前の実行の Mule がまだポートを閉じ終えていないことがある
    while [p for p in ports if port_busy(p)] and time.time() - t0 < 10:
        time.sleep(0.2)
    busy = [p for p in ports if port_busy(p)]
    if busy:
        print(f"ports already in use: {busy} (another Mule/mulay running?)", file=sys.stderr); return 2

    t_start = time.time()
    os.makedirs(BUILD, exist_ok=True)
    jars, errors = {}, {}
    with cf.ThreadPoolExecutor(jobs) as ex:
        for name, jar, err in ex.map(lambda a: build_app(a, False) if not no_build else
                                     (os.path.basename(a), os.path.join(BUILD, os.path.basename(a) + ".jar"), None), apps):
            if err or not os.path.exists(jar):
                errors[name] = "build failed:\n" + (err or "no jar")
            else:
                jars[name] = jar
    t_built = time.time()
    print(f"built {len(jars)} app(s) in {t_built - t_start:.1f}s", file=sys.stderr)
    for sc in [x for x in scs if x.oracle == "mulay"]:   # ビルド (XSD の検査) だけ。期待は mulay で記録する
        if sc.name in jars:
            print(f"SKIP     {sc.name}: built only ('%%% oracle mulay': expectations come from mulay --record)", file=sys.stderr)
            del jars[sc.name]
    scs = [x for x in scs if x.oracle != "mulay"]

    for pid in stray_pids():   # 前回の実行が残したもの
        print(f"killing leftover Mule process {pid}", file=sys.stderr)
        os.kill(pid, signal.SIGKILL)
    prepare_runtime()
    for name, jar in jars.items():
        shutil.copy2(jar, os.path.join(RT, "apps", name + ".jar"))
    for sc in scs:
        prepare_dirs(sc)
    mule = Mule()
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda *_: (mule.stop(), sys.exit(130)))
    total = bad = 0
    out = []
    try:
        mule.start()
        failed = wait_deployed(mule, list(jars), timeout=600)
        errors.update(failed)
        t_up = time.time()
        print(f"Mule up, {len(jars) - len(failed)} app(s) deployed in {t_up - t_built:.1f}s", file=sys.stderr)
        live = [sc for sc in scs if sc.name in jars and sc.name not in failed]
        for sc in live:   # listener が開くまで待つ
            t0 = time.time()
            while not all(port_busy(p) for p in [sc.port] + sc.extra_ports) and time.time() - t0 < 120:
                time.sleep(0.2)
        if mode == "run":
            print(f"running at {RT} — Ctrl-C to stop", file=sys.stderr)
            for sc in live:
                print(f"  {sc.name}: http://localhost:{sc.port}/", file=sys.stderr)
            while mule.alive():
                time.sleep(1)
            return 0
        results, outs = {}, {sc.name: [] for sc in live}
        with cf.ThreadPoolExecutor(max(1, len(live))) as ex:
            futs = {ex.submit(run_scenario, sc, mode, outs[sc.name], OracleLog(sc.name)): sc for sc in live}
            for f, sc in futs.items():
                try:
                    results[sc.name] = f.result()
                except Exception as e:  # noqa
                    errors[sc.name] = f"scenario error: {type(e).__name__}: {e}"
        for sc in live:   # 並行に走らせた結果を、アプリ名の順に出す
            if sc.name in results:
                n, b, _ = results[sc.name]; total += n; bad += b
                for line in outs[sc.name]:
                    print(line)
                if mode == "fill":
                    sc.save()
        print(f"requests done in {time.time() - t_up:.1f}s", file=sys.stderr)
    finally:
        mule.stop()   # ログは次の起動まで target/mule-oracle-runtime/logs に残る
    for name, e in sorted(errors.items()):
        print(f"ERROR    {name}: {e}", file=sys.stderr)
        log = app_log_path(name)
        if os.path.exists(log):
            print("  (log: " + log + ")", file=sys.stderr)
    print(f"{mode}: {len(scs)} app(s), {total} request(s), {bad} diff(s), {len(errors)} error(s), "
          f"total {time.time() - t_start:.1f}s", file=sys.stderr)
    return 1 if (bad or errors) else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
