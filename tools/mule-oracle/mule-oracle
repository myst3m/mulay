class MulayProc:
    def __init__(self, app_dir, props=(), env=None):
        self.log = ProcLog()
        self.proc = subprocess.Popen([MULAY, "run", app_dir, *props], cwd=REPO, stdin=subprocess.DEVNULL, env=env,
                                     stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
        # stdout と stderr を 1 本にまとめて読む (別々のスレッドで読むと INFO と WARN/ERROR の順が入れ替わる)
        self.log.attach(self.proc.stdout)

    def alive(self):
        return self.proc.poll() is None

    def stop(self):
        if self.proc is None:
            return
        for sig, wait in ((signal.SIGTERM, 3), (signal.SIGKILL, 5)):
            try:
                os.killpg(self.proc.pid, sig)
            except ProcessLookupError:
                break
            try:
                self.proc.wait(timeout=wait); break
            except subprocess.TimeoutExpired:
                continue
        self.proc = None


def summarize(d):
    """差分の 1 行要約"""
    first = d[0]
    if first.startswith("body:"):
        return "body differs"
    if first.startswith("log:"):
        return "log differs"
    return first.split("\n")[0]


def run_mulay_app(sc, verbose, record, lazy, current, lock):
    """1 つのアプリを mulay で回す。出力の行、通った要求の数、要求の数、全部通ったかを返す"""
    lines = []
    tag = sc.name + (" [lazy]" if lazy else "")
    n_req = sum(1 for x in sc.secs if x.kind in ("request", "sfauth", "read", "send"))
    t_app = time.time()
    while port_busy(sc.port) and time.time() - t_app < 10:
        time.sleep(0.2)
    if port_busy(sc.port):
        lines.append(f"FAIL {tag}: port {sc.port} already in use"); return lines, 0, n_req, False
    prepare_dirs(sc)
    env = dict(os.environ, MULAY_DW_LAZY_ALL="1") if lazy else None
    mp = MulayProc(sc.app_dir, [x[2:] for x in sc.jvm if x.startswith("-D")], env)
    with lock:
        current.append(mp)
    try:
        t0 = time.time()
        while not all(port_busy(p) for p in [sc.port] + sc.extra_ports) and mp.alive() and time.time() - t0 < 10:
            time.sleep(0.05)
        if not port_busy(sc.port):
            why = "exited" if not mp.alive() else "port did not open in 10s"
            lines.append(f"FAIL {tag}: mulay {why}")
            lines.append("  " + "\n  ".join(mp.log.text().split("\n")[-40:]))
            return lines, 0, n_req, False
        try:
            if record:
                _n, _bad, results = run_scenario(sc, "fill", [], mp.log)
                sc.save()
                lines.append(f"RECORDED {sc.name} ({_n} request(s)) from mulay")
                return lines, _n, n_req, True
            _n, _bad, results = run_scenario(sc, "check", [], mp.log)
        except Exception as e:  # noqa
            lines.append(f"FAIL {tag}: scenario error: {type(e).__name__}: {e}"); return lines, 0, n_req, False
        ok = sum(1 for _k, _h, d in results if not d)
        if ok == len(results):
            lines.append(f"PASS {tag} ({ok}/{len(results)}) {time.time() - t_app:.1f}s")
            return lines, ok, n_req, True
        for k, head, d in results:
            if d:
                lines.append(f"FAIL {tag} request #{k}: {head[len('request '):]}: {summarize(d)}")
                if verbose:
                    lines.append("  " + "\n  ".join(x.replace("\n", "\n  ") for x in d))
        lines.append(f"     {tag} ({ok}/{len(results)}) {time.time() - t_app:.1f}s")
        return lines, ok, n_req, False
    finally:
        mp.stop()
        with lock:
            current.remove(mp)


SHARED_SERVICES = (("salesforce", r"<salesforce[a-z-]*:"), ("anypoint-mq", r"<anypoint-mq:"), ("db", r"<db:"), ("sftp", r"<sftp:"))


def shared_service(sc):
    """アプリが使う外のサービス (同じ org・キュー・表・ディレクトリを他のアプリと分け合うもの)。無ければ """""
    d = os.path.join(sc.app_dir, "src", "main", "mule")
    text = ""
    for root, _, files in os.walk(d):
        for f in files:
            if f.endswith(".xml"):
                with open(os.path.join(root, f), encoding="utf-8", errors="replace") as fh:
                    text += fh.read()
    for svc, pat in SHARED_SERVICES:
        if re.search(pat, text):
            return svc
    return ""


def mulay_main(apps, verbose, record=False, jobs=1, lazy=False, lazy_shared=True):
    global MULAY_MODE
    MULAY_MODE = True
    err = ensure_mulay()
    if err:
        print("ERROR    mulay build failed:\n" + err, file=sys.stderr); return 1
    scs = [Scenario(a) for a in apps]
    if record:
        others = [sc.name for sc in scs if sc.oracle != "mulay"]
        if others:
            print("--record is only for apps with '%%% oracle mulay': " + ", ".join(others), file=sys.stderr); return 2
        lazy = False
    current, lock = [], threading.Lock()

    def on_signal(*_):
        with lock:
            for mp in list(current):
                mp.stop()
        os._exit(130)
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, on_signal)
    modes = [False, True] if lazy else [False]
    stats = {m: [0, 0, 0, 0] for m in modes}

    def job(lane):
        ms = modes if lazy_shared or not shared_service(lane[0]) else [False]
        return [(m, *run_mulay_app(sc, verbose, record, m, current, lock)) for m in ms for sc in lane]
    groups = {}
    for sc in scs:
        groups.setdefault(tuple(sc.jvm), []).append(sc)
    t_start = time.time()
    for _jvm, group in sorted(groups.items()):   # 実 Mule の照合と同じく、JVM の引数が同じアプリだけを同時に回す
        if jobs <= 1:
            lanes = [[sc] for sc in group]
        else:   # 同じ外のサービスを使うアプリは 1 つの列で順に回す (通知やキューを取り合う)
            shared = {}
            for sc in group:
                svc = shared_service(sc)
                if svc:
                    shared.setdefault(svc, []).append(sc)
            lanes = list(shared.values()) + [[sc] for sc in group if not shared_service(sc)]
        width = 1 if jobs <= 1 else jobs + len([ln for ln in lanes if len(ln) > 1])
        with cf.ThreadPoolExecutor(width) as ex:
            futs = [ex.submit(job, ln) for ln in lanes]
            for f in (futs if jobs <= 1 else cf.as_completed(futs)):
                for m, lines, ok, n, green in f.result():
                    for line in lines:
                        print(line, flush=True)
                    stats[m][0] += ok
                    stats[m][1] += n
                    stats[m][2] += 0 if green else 1
                    stats[m][3] += 1
    rc = 0
    for m in modes:
        passed, total, failed_apps, ran = stats[m]
        print(f"{'mulay lazy' if m else 'mulay'}: {passed}/{total} request(s) passed, "
              f"{ran - failed_apps}/{ran} app(s) all green, {time.time() - t_start:.1f}s")
        if passed != total or failed_apps:
            rc = 1
    return rc

