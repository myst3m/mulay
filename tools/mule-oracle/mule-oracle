class Protoset:
    """記述子 (FileDescriptorSet) で JSON と protobuf を行き来させる (Python の protobuf)"""
    def __init__(self, path):
        from google.protobuf import descriptor_pb2, descriptor_pool, message_factory
        fds = descriptor_pb2.FileDescriptorSet()
        with open(path, "rb") as f:
            fds.ParseFromString(f.read())
        self.pool = descriptor_pool.DescriptorPool()
        for fd in fds.file:
            self.pool.Add(fd)
        self.fac = message_factory.MessageFactory(self.pool)

    def cls(self, name):
        return self.fac.GetPrototype(self.pool.FindMessageTypeByName(name))

    def encode(self, name, js):
        from google.protobuf import json_format
        m = self.cls(name)()
        json_format.Parse(js, m, descriptor_pool=self.pool)
        return m.SerializeToString()

    def decode(self, name, data):
        from google.protobuf import json_format
        m = self.cls(name)()
        m.ParseFromString(data)
        return json.dumps(json_format.MessageToDict(m, preserving_proto_field_name=True, descriptor_pool=self.pool),
                          ensure_ascii=False, sort_keys=True)


def do_grpc(port, path, headers, msgs, timeout, body=None):
    """h2c (prior knowledge) で gRPC の要求を 1 つ送る。msgs は送るメッセージのバイト列の列 (5 バイトの枠を付ける)。
    body を渡せば、枠を付けずにそのバイト列を DATA で送る (空なら DATA を送らずに HEADERS で END_STREAM)。
    戻り値 (status, [(名前, 値)], [(名前, 値)] の trailer, [受けたメッセージのバイト列], 余りのバイト列)"""
    import h2.connection, h2.config, h2.events
    s = socket.create_connection(("127.0.0.1", port), timeout=timeout)
    try:
        c = h2.connection.H2Connection(h2.config.H2Configuration(client_side=True, header_encoding="utf-8"))
        c.initiate_connection(); s.sendall(c.data_to_send())
        hs = [(":method", "POST"), (":scheme", "http"), (":path", path), (":authority", f"localhost:{port}"),
              ("content-type", "application/grpc"), ("te", "trailers")] + [(k.lower(), v) for k, v in headers]
        if body is None:
            body = b"".join(b"\x00" + len(m).to_bytes(4, "big") + m for m in msgs)
        if body:
            c.send_headers(1, hs); c.send_data(1, body, end_stream=True)
        else:
            c.send_headers(1, hs, end_stream=True)
        s.sendall(c.data_to_send())
        status, rh, tr, buf, done = 0, [], [], b"", False
        while not done:
            d = s.recv(65536)
            if not d:
                break
            for e in c.receive_data(d):
                if isinstance(e, h2.events.ResponseReceived):
                    for k, v in e.headers:
                        if k == ":status": status = int(v)
                        else: rh.append((k, v))
                elif isinstance(e, h2.events.DataReceived):
                    buf += e.data; c.acknowledge_received_data(e.flow_controlled_length, 1)
                elif isinstance(e, h2.events.TrailersReceived):
                    tr = list(e.headers)
                elif isinstance(e, (h2.events.StreamEnded, h2.events.StreamReset)):
                    done = True
            s.sendall(c.data_to_send())
        out, i = [], 0
        while i + 5 <= len(buf):
            n = int.from_bytes(buf[i + 1:i + 5], "big")
            if i + 5 + n > len(buf): break
            out.append(buf[i + 5:i + 5 + n]); i += 5 + n
        return status, rh, tr, out, buf[i:]
    finally:
        s.close()


def execute_grpc(sc, req, o, target, hs, body, masks, timeout):
    if sc.protoset is None:
        raise ValueError(f"{sc.path}: request GRPC needs '%%% protoset <file.desc>'")
    if not hasattr(sc, "pset"):
        sc.pset = Protoset(sc.protoset)
    port = sc.port
    if target.startswith(":"):
        p, _, rest = target[1:].partition("/")
        port, target = int(p), "/" + rest
    tin, tout = o.get("in"), o.get("out")
    text = body.decode("utf-8")
    if isinstance(o.get("stream"), str):
        st = GrpcStream(port, target, hs, grpc_msgs(sc, tin, text, o.get("raw")), o.get("end", "1") == "1", timeout)
        st.tin, st.tout = tin, tout
        sc.streams[o["stream"]] = st
        sec_ = grpc_take_section(sc, st, masks, opening=True)
        if st.status == 0 and st.error is not None:
            raise socket.timeout()
        return sec_
    whole = None
    if o.get("frame") == "0":
        msgs, whole = [], base64.b64decode(text.strip())
    elif o.get("raw"):
        msgs = [base64.b64decode(x) for x in text.split("\n") if x.strip()]
    else:
        msgs = [sc.pset.encode(tin, x) for x in text.split("\n") if x.strip()] if text.strip() else [sc.pset.encode(tin, "{}")]
    status, rh, tr, got, rest = do_grpc(port, target, hs, msgs, timeout, whole)
    lines = [f"{k.lower()}: {v}" for k, v in rh if k.lower() not in VOLATILE_HEADERS]
    lines += [f"{k.lower()} (trailer): {v}" for k, v in tr]
    outs = []
    for m in got:
        try:
            outs.append(sc.pset.decode(tout, m))
        except Exception:
            outs.append("base64 " + base64.b64encode(m).decode())
    if rest:
        outs.append("rest " + base64.b64encode(rest).decode())
    text = apply_masks(masks, "\n".join(outs))
    lines = [apply_masks(masks, x) for x in lines]
    return Section(f"response {status}", ("\n".join(lines) + "\n" if lines else "") + "\n" + text)

class GrpcStream:
    """request GRPC .. stream=<名前> で開く gRPC の呼び出し (h2c)。背景のスレッドが応答の DATA と trailer を貯める。
    send(msgs, end) で同じストリームにメッセージを足して送り、take() で前回から新しく届いた分を返す"""
    def __init__(self, port, path, headers, msgs, end, timeout):
        import h2.connection, h2.config
        self.sock = socket.create_connection(("127.0.0.1", port), timeout=timeout)
        self.c = h2.connection.H2Connection(h2.config.H2Configuration(client_side=True, header_encoding="utf-8"))
        self.lock, self.head_ready = threading.Lock(), threading.Event()
        self.status, self.headers, self.trailers, self.buf, self.pos = 0, [], [], b"", 0
        self.trailers_taken, self.head_taken, self.done, self.last, self.error = False, False, False, time.time(), None
        with self.lock:
            self.c.initiate_connection()
            hs = [(":method", "POST"), (":scheme", "http"), (":path", path), (":authority", f"localhost:{port}"),
                  ("content-type", "application/grpc"), ("te", "trailers")] + [(k.lower(), v) for k, v in headers]
            self.c.send_headers(1, hs, end_stream=(end and not msgs))
            self._send_locked(msgs, end)
        threading.Thread(target=self.loop, daemon=True).start()

    def _send_locked(self, msgs, end):
        body = b"".join(b"\x00" + len(m).to_bytes(4, "big") + m for m in msgs)
        if body:
            self.c.send_data(1, body, end_stream=end)
        elif end:
            self.c.end_stream(1)
        self.sock.sendall(self.c.data_to_send())

    def send(self, msgs, end):
        with self.lock:
            self._send_locked(msgs, end)

    def loop(self):
        import h2.events
        try:
            self.sock.settimeout(None)
            while True:
                d = self.sock.recv(65536)
                if not d:
                    break
                with self.lock:
                    for e in self.c.receive_data(d):
                        if isinstance(e, h2.events.ResponseReceived):
                            for k, v in e.headers:
                                if k == ":status": self.status = int(v)
                                else: self.headers.append((k, v))
                            self.head_ready.set()
                        elif isinstance(e, h2.events.DataReceived):
                            self.buf += e.data; self.c.acknowledge_received_data(e.flow_controlled_length, 1)
                        elif isinstance(e, h2.events.TrailersReceived):
                            self.trailers = list(e.headers)
                        elif isinstance(e, (h2.events.StreamEnded, h2.events.StreamReset)):
                            self.done = True
                    self.last = time.time()
                    self.sock.sendall(self.c.data_to_send())
                if self.done:
                    break
        except Exception as ex:   # noqa
            self.error = ex
        finally:
            self.done = True; self.head_ready.set()

    def take_head(self):
        """届いていれば応答の :status とヘッダー (1 度だけ)。まだなら None"""
        with self.lock:
            if self.head_taken or not self.head_ready.is_set() or self.status == 0:
                return None
            self.head_taken = True
            return self.status, list(self.headers)

    def take(self, min_wait=0.3, quiet=0.3, max_wait=5.0):
        """新しく届いたメッセージ (5 バイトの枠で切ったもの) と、届いていれば trailer (1 度だけ)"""
        t0 = time.time(); time.sleep(min_wait)
        while not self.done and time.time() - self.last < quiet and time.time() - t0 < max_wait:
            time.sleep(0.03)
        with self.lock:
            out, i = [], self.pos
            while i + 5 <= len(self.buf):
                n = int.from_bytes(self.buf[i + 1:i + 5], "big")
                if i + 5 + n > len(self.buf): break
                out.append(self.buf[i + 5:i + 5 + n]); i += 5 + n
            self.pos = i
            tr = [] if self.trailers_taken else list(self.trailers)
            if tr: self.trailers_taken = True
            rest = self.buf[i:] if self.done else b""
        return out, tr, rest

    def close(self):
        try:
            self.sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        try:
            self.sock.close()
        except OSError:
            pass


def grpc_msgs(sc, tin, text, raw):
    if raw:
        return [base64.b64decode(x) for x in text.split("\n") if x.strip()]
    return [sc.pset.encode(tin, x) for x in text.split("\n") if x.strip()]


def grpc_lines(sc, tout, got, tr, rest):
    outs = []
    for m in got:
        try:
            outs.append(sc.pset.decode(tout, m))
        except Exception:
            outs.append("base64 " + base64.b64encode(m).decode())
    if rest:
        outs.append("rest " + base64.b64encode(rest).decode())
    return outs, [f"{k.lower()} (trailer): {v}" for k, v in tr]


def execute_grpc_send(sc, sec, masks):
    """send <名前> [end=1] [raw=1]: stream=<名前> で開いた gRPC の呼び出しに、本文のメッセージ (1 行に 1 つの JSON) を送り、
    新しく届いたメッセージを記録する"""
    o = sec.opts()
    st = sc.streams.get(sec.args[0]) if sec.args else None
    if not isinstance(st, GrpcStream):
        return Section("response none", "\nno such gRPC stream: " + (sec.args[0] if sec.args else ""))
    hs, b = split_head_body(sec.body)
    try:
        st.send(grpc_msgs(sc, st.tin, b, o.get("raw")), o.get("end") == "1")
    except OSError as e:
        return Section("response none", f"\n{type(e).__name__}: {e}")
    return grpc_take_section(sc, st, masks)


def grpc_take_section(sc, st, masks, wait=0.3, opening=False):
    """新しく届いたもの。応答の頭がこの間に届いたら response <status> とヘッダーの行も (開いた時にまだなら response pending)"""
    got, tr, rest = st.take(min_wait=wait, max_wait=max(5.0, wait + 2))
    outs, trl = grpc_lines(sc, st.tout, got, tr, rest)
    hd = st.take_head()
    lines = ([f"{k.lower()}: {v}" for k, v in hd[1] if k.lower() not in VOLATILE_HEADERS] if hd else []) + trl
    lines = [apply_masks(masks, x) for x in lines]
    status = f"response {hd[0]}" if hd else ("response pending" if opening else "response 200")
    return Section(status, ("\n".join(lines) + "\n" if lines else "") + "\n" + apply_masks(masks, "\n".join(outs)))

# ---------------------------------------------------------------- シナリオの実行

def prepare_dirs(sc):
    """startdir: アプリを起動する前に、そのディレクトリを消して空で作り直す (書いた順)"""
    for s in sc.secs:
        if s.kind == "startdir":
            for d in s.args:
                shutil.rmtree(d, ignore_errors=True); os.makedirs(d)
        elif s.kind == "sftpdir":
            sftp_dirs(s.args[0], s.args[1:])
        elif s.kind == "startsql":
            r = subprocess.run(["psql", s.args[0], "-q", "-v", "ON_ERROR_STOP=1", "-f", "-"], input=s.body,
                               capture_output=True, text=True, timeout=60)
            if r.returncode != 0:
                raise RuntimeError(f"startsql: psql failed: {r.stderr.strip()}")


def wait_ssh(host, port, limit):
    """SSH のサーバーが挨拶 (SSH-) を返すまで待つ。テスト用のサーバーは、使う時に立ち上がる転送 (kubectl port-forward) の
    向こうにあり、冷えていると最初の接続が切られる"""
    t0 = time.time()
    while True:
        try:
            with socket.create_connection((host, port), timeout=5) as c:
                c.settimeout(5)
                if c.recv(64).startswith(b"SSH-"):
                    return
        except OSError:
            pass
        if time.time() - t0 > limit:
            raise RuntimeError(f"sftpdir: no SSH server at {host}:{port} after {limit}s")
        time.sleep(0.5)


def sftp_dirs(url, dirs):
    """sftpdir sftp://user:pass@host:port <path>...: SFTP サーバーの上でディレクトリを消して空で作り直す (lftp を使う)"""
    m = re.match(r"sftp://([^:@]+):([^@]*)@([^/]+)$", url)
    if not m:
        raise ValueError(f"sftpdir: bad url {url!r}")
    user, pw, hostport = m.groups()
    host, _, port = hostport.rpartition(":")
    wait_ssh(host, int(port), 30)
    cmds = ["set sftp:auto-confirm yes", "set net:max-retries 1", "set cmd:fail-exit no"]
    for d in dirs:
        cmds += [f"rm -rf {d}", f"mkdir -p {d}"]
    cmds += ["bye"]
    r = subprocess.run(["lftp", "-u", f"{user},{pw}", "-e", "; ".join(cmds), f"sftp://{hostport}"],
                       stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        raise RuntimeError(f"sftpdir: lftp failed: {r.stderr.strip()}")


def run_scenario(sc, mode, out, logsrc):
    """sc の request を順に送り、fill なら response/log を書き換え、check なら食い違いを数える。
    logsrc はログの取り出し口 (OracleLog / ProcLog)。
    戻り値: (件数, 食い違い数, [(request の通し番号, request の head, 差分の列)])"""
    new, masks = [], []
    sc.vars, sc.caps, sc.streams, sc.raws = {}, [], {}, []
    try:
        return run_sections(sc, mode, out, logsrc, new, masks)
    finally:
        for st in sc.streams.values():
            st.close()
        sc.streams = {}
        for r in sc.raws:
            r.close()
        sc.raws = []


def run_sections(sc, mode, out, logsrc, new, masks):
    n, bad, results = 0, 0, []
    secs = sc.secs
    i = 0
    while i < len(secs):
        s = secs[i]
        if s.kind in ("response", "log"):
            i += 1; continue   # request の処理で作り直す (fill) / 読む (check)
        new.append(s)
        if s.kind == "mask":
            for line in s.body.split("\n"):
                if line.strip():
                    masks.append(re.compile(line))
        elif s.kind == "capture":
            sc.caps.append((s.args[0], s.args[1]))
        elif s.kind == "wait":
            time.sleep(int(s.args[0]) / 1000.0)
        elif s.kind == "emptydir":
            for d in s.args:
                shutil.rmtree(d, ignore_errors=True); os.makedirs(d)
        elif s.kind == "mkfifo":
            for f in s.args:
                if os.path.lexists(f): os.remove(f)
                os.mkfifo(f)
        elif s.kind == "symlink":
            target, link = s.args[0], s.args[1]
            if os.path.lexists(link): os.remove(link)
            os.symlink(target, link)
        elif s.kind == "rawserver":
            sc.raws.append(RawServer(int(s.args[0]), s.args[1]))
        elif s.kind == "grpcserver":
            sc.raws.append(GrpcServer(int(s.args[0])))
        elif s.kind in ("startdir", "sftpdir", "startsql", "requires"):
            pass   # 起動の前に済ませてある (prepare_dirs、resolve_apps)
        elif s.kind == "close":
            for name in s.args:
                st = sc.streams.pop(name, None)
                if st is not None: st.close()
        elif s.kind in ("request", "sfauth", "read", "send"):
            exp_resp, exp_log = None, None
            j = i + 1
            while j < len(secs) and secs[j].kind in ("response", "log"):
                if secs[j].kind == "response": exp_resp = secs[j]
                else: exp_log = secs[j]
                j += 1
            n += 1
            resp, logsec = ((execute_read(sc, s, masks), None) if s.kind == "read" else
                            (execute_grpc_send(sc, s, masks), None) if s.kind == "send" else execute(sc, s, masks, logsrc))
            label = f"{sc.name}: {s.head}"
            if mode == "fill":
                new.append(resp)
                if logsec is not None:
                    new.append(logsec)
            else:
                if exp_resp is None:
                    out.append(f"MISSING  {label}: no expected response (run fill)"); bad += 1
                    results.append((n, s.head, ["no expected response (run fill)"]))
                else:
                    d = diff_resp(exp_resp, resp)
                    if exp_log is not None or logsec is not None:
                        eb = exp_log.body if exp_log else "(none)"
                        ab = logsec.body if logsec else "(none)"
                        if norm_log(eb) != norm_log(ab):
                            d.append(f"log:\n--- expected\n{eb}\n--- actual\n{ab}")
                    results.append((n, s.head, d))
                    if d:
                        bad += 1
                        out.append(f"DIFF     {label}\n  " + "\n  ".join(x.replace("\n", "\n  ") for x in d))
                if exp_resp is not None:
                    new.append(exp_resp)
                if exp_log is not None:
                    new.append(exp_log)
            i = j; continue
        i += 1
    if mode == "fill":
        sc.secs = new
    return n, bad, results


def do_sfauth(port, alias, path, timeout):
    """sfauth: sf CLI の org (alias) のセッションで Salesforce にログインした状態 (frontdoor.jsp の cookie) を作り、
    アプリの認可の口 (path) からリダイレクトをたどる (Salesforce の認可 → アプリのコールバック)。最後の応答を返す。
    アクセストークンは表示しない"""
    import http.cookiejar, urllib.request, urllib.parse, urllib.error
    p = subprocess.run(["sf", "org", "display", "-o", alias, "--json"], capture_output=True, text=True)
    d = json.loads(p.stdout)["result"]
    jar = http.cookiejar.CookieJar()
    op = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar))
    op.open(d["instanceUrl"] + "/secur/frontdoor.jsp?sid=" + urllib.parse.quote(d["accessToken"]), timeout=timeout).read()
    url = f"http://localhost:{port}{path}"
    # Salesforce は https から http のコールバックへ戻すとき、302 ではなく window.location.replace('...') のページを返す。
    # アプリのポートの localhost 宛てのものだけたどる
    for _ in range(3):
        try:
            r = op.open(url, timeout=timeout)
            st, hs, data = r.status, list(r.headers.items()), r.read()
        except urllib.error.HTTPError as e:
            return e.code, list(e.headers.items()), e.read()
        m = re.search(rb"window\.location\.replace\('(http://localhost:%d/[^']*)'\)" % port, data)
        if st != 200 or not m:
            return st, hs, data
        url = m.group(1).decode()
    return st, hs, data


def subst_vars(sc, text):
    """{{NAME}} を capture で取った値に置き換える"""
    for k, v in sc.vars.items():
        text = text.replace("{{" + k + "}}", v)
    return text


def take_captures(sc, rh, data):
    """capture <NAME> header:<ヘッダ名> | regex:<正規表現> (最初のグループ)。直後の request の応答 (生の値) から取る"""
    for name, how in sc.caps:
        kind, _, arg = how.partition(":")
        val = ""
        if kind == "header":
            for k, v in rh:
                if k.lower() == arg.lower():
                    val = v; break
        else:
            m = re.search(arg, data.decode("utf-8", "replace"))
            val = (m.group(1) if m.groups() else m.group(0)) if m else ""
        sc.vars[name] = val
    sc.caps = []


def execute(sc, req, masks, logsrc):
    o = req.opts()
    if len(req.args) < 2:
        raise ValueError(f"{sc.path}: bad request head: {req.head}")
    method, target = req.args[0], subst_vars(sc, req.args[1])
    hs, b = split_head_body(subst_vars(sc, req.body))
    body = decode_body(o, b) * int(o.get("repeat", 1))
    want = ["content-type"]
    if isinstance(o.get("headers"), str):
        want += [h.lower() for h in o["headers"].split(",") if h and h.lower() != "content-type"]
    mark = logsrc.mark() if o.get("log") else None
    timeout = float(o.get("timeout", 30))
    if method == "GRPC":
        try:
            resp = execute_grpc(sc, req, o, target, hs, body, masks, timeout)
            return resp, collect_log(o, mark, masks, logsrc)
        except (socket.timeout, TimeoutError):
            return Section("response none", "\ntimeout"), None
        except OSError as e:
            return Section("response none", f"\n{type(e).__name__}: {e}"), None
    try:
        if req.kind == "sfauth":
            status, rh, data = do_sfauth(sc.port, method, target, timeout)
        elif isinstance(o.get("stream"), str):
            st = StreamConn(sc.port, method, target, hs, body, timeout, sc.tls)
            sc.streams[o["stream"]] = st
            if not st.head_ready.wait(timeout) or st.status == 0:
                raise socket.timeout()
            status, rh, data = st.status, st.headers, st.take()
        elif o.get("h2"):
            status, rh, data = do_request_h2(sc.port, method, target, hs, body, timeout, sc.tls)
        else:
            status, rh, data = do_request(sc.port, method, target, hs, body, timeout, sc.tls)
    except (socket.timeout, TimeoutError):
        return Section("response none", "\ntimeout"), None
    except OSError as e:
        return Section("response none", f"\n{type(e).__name__}: {e}"), None
    take_captures(sc, rh, data)
    lines = []
    if "*" in want:
        # framing=1: 転送の形 (content-length / transfer-encoding) も残す (chunked かどうかを確かめる用)
        skip = VOLATILE_HEADERS - ({"content-length", "transfer-encoding"} if o.get("framing") else set())
        for k, v in rh:
            if k.lower() not in skip:
                lines.append(f"{k.lower()}: {v}")
    else:
        for w in want:
            for k, v in rh:
                if k.lower() == w:
                    lines.append(f"{w}: {v}")
    flag, text = encode_body(data)
    text = apply_masks(masks, text) if flag != "base64" else text
    lines = [apply_masks(masks, x) for x in lines]
    head = f"response {status}" + (f" {flag}" if flag else "")
    resp = Section(head, ("\n".join(lines) + "\n" if lines else "") + "\n" + text)
    return resp, collect_log(o, mark, masks, logsrc)


ENTRY_START = re.compile(r"^(TRACE|DEBUG|INFO|WARN|ERROR|FATAL) \S+: ?")
RUST_HEAD = re.compile(r"^(error|warning)\[([^\]]+)\]: (.*)$")
RUST_NOTE = re.compile(r"^\s*= note: (element|flow stack|DataWeave): (.*)$")
MULAY_MODE = False   # mulay を回すとき、例外の枠は書式でなく事実 (メッセージ・要素・エラーの型・FlowStack) で比べる (ADR 096)


def exc_facts(entry):
    """例外の枠 (Mule の **** の枠か、mulay の Rust 風の枠) を事実の並びにする。枠でなければそのまま"""
    head, _, body = entry.partition("\n")
    lines = body.split("\n")
    f = {}
    if any(l.startswith("Message               : ") for l in lines):
        key = None
        for l in lines:
            m = re.match(r"^(Message|Element|Error type|FlowStack)\s+: (.*)$", l)
            if m:
                key = m.group(1); f[key] = [m.group(2)]
            elif key == "FlowStack" and l.strip().startswith("at "):
                f[key].append(l.strip())
            elif l.strip() == "" or l.startswith("  (set debug") or l.startswith("****"):
                key = None if l.strip() == "" or l.startswith("****") else key
        msg = f.get("Message", [""])[0]
        return "\n".join([head.rstrip(), "message: " + (msg[1:] if msg.startswith('"') else msg),
                          "element: " + f.get("Element", [""])[0], "type: " + f.get("Error type", [""])[0],
                          "flowstack: " + " ".join(f.get("FlowStack", []))])
    hm = next((RUST_HEAD.match(l) for l in lines if RUST_HEAD.match(l)), None)
    if hm is None:
        return entry
    notes, key = {}, None
    for l in lines:
        m = RUST_NOTE.match(l)
        if m:
            key = m.group(1); notes[key] = [m.group(2)]
        elif key and re.match(r"^\s{8,}\S", l):
            notes[key].append(l.strip())
        else:
            key = None
    msg = notes.get("DataWeave", [hm.group(3)])[0]
    return "\n".join([head.rstrip(), "message: " + msg, "element: " + " ".join(notes.get("element", [""])),
                      "type: " + hm.group(2), "flowstack: " + " ".join(notes.get("flow stack", []))])


def norm_log(text):
    if not MULAY_MODE or text is None:
        return text
    entries, cur = [], None
    for l in text.split("\n"):
        if ENTRY_START.match(l):
            if cur is not None:
                entries.append(cur)
            cur = l
        else:
            cur = l if cur is None else cur + "\n" + l
    if cur is not None:
        entries.append(cur)
    return "\n".join(exc_facts(e) for e in entries)


def collect_log(o, mark, masks, logsrc):
    """log (LoggerMessageProcessor だけ) か log=<カテゴリ,..> の要求で、要求の間に出たログの行"""
    if mark is None:
        return None
    cats = o["log"].split(",") if isinstance(o["log"], str) else None
    entries = []
    for lvl, cat, msg in logsrc.entries(mark, float(o.get("logwait", "0"))):
        if cats is None and cat != "org.mule.runtime.core.internal.processor.LoggerMessageProcessor":
            continue
        if cats is not None and "*" not in cats and cat not in cats:
            continue
        entries.append(apply_masks(masks, f"{lvl} {cat}: {msg}"))
    return Section("log", "\n".join(entries))


def execute_read(sc, sec, masks):
    """read <名前>: stream=<名前> で開いた応答に、前回から新しく届いた本文 (届かなくなるまで待つ)。応答の status は 200 とする"""
    st = sc.streams.get(sec.args[0]) if sec.args else None
    if st is None:
        return Section("response none", "\nno such stream: " + (sec.args[0] if sec.args else ""))
    if isinstance(st, GrpcStream):
        return grpc_take_section(sc, st, masks, wait=float(sec.opts().get("wait", "0.3")))
    data = st.take()
    flag, text = encode_body(data)
    text = apply_masks(masks, text) if flag != "base64" else text
    return Section("response 200" + (f" {flag}" if flag else ""), "\n" + text)


def diff_resp(exp, act):
    d = []
    if exp.head != act.head:
        d.append(f"status: expected '{exp.head}', got '{act.head}'")
    eh, eb = split_head_body(exp.body)
    ah, ab = split_head_body(act.body)
    el = [(k.lower(), v) for k, v in eh]; al = [(k.lower(), v) for k, v in ah]
    if el != al:
        d.append(f"headers: expected {el}, got {al}")
    if eb != ab:
        d.append(f"body:\n--- expected\n{eb}\n--- actual\n{ab}")
    return d

