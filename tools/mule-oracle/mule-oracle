def runtime_info(home):
    """lib/mule の jar 名から (版, EE か) を読む。mule-core-ee-*.jar があれば EE"""
    d = os.path.join(home, "lib", "mule")
    names = os.listdir(d) if os.path.isdir(d) else []
    ver = next((m.group(1) for n in names for m in [re.fullmatch(r"mule-core-(\d+\.\d+\.\d+)\.jar", n)] if m), "")
    return ver, any(n.startswith("mule-core-ee-") for n in names)


