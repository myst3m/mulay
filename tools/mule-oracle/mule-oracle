def newest_mtime(d):
    # symlink のディレクトリもたどる (テンプレを指す fixture: test/fixtures/apps/agent-harness-summary/src)
    t = 0
    for root, dirs, files in os.walk(d, followlinks=True):
        dirs[:] = [x for x in dirs if x not in ("target", ".mule")]
        for f in files:
            if f != "scenario.scn":
                t = max(t, os.path.getmtime(os.path.join(root, f)))
    return t


def build_app(app_dir, force):
    name = os.path.basename(app_dir.rstrip("/"))
    bdir = os.path.join(BUILD, name)
    jar_out = os.path.join(BUILD, name + ".jar")
    if not force and os.path.exists(jar_out) and os.path.getmtime(jar_out) >= newest_mtime(app_dir):
        return name, jar_out, None
    shutil.rmtree(bdir, ignore_errors=True)
    shutil.copytree(app_dir, bdir, ignore=shutil.ignore_patterns("scenario.scn", "target", ".mule"))
    retarget(bdir, MULE_VER, MULE_EE)
    p = subprocess.run(["mvn", "-q", "-o", "package", "-DskipTests"], cwd=bdir,
                       stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    jars = [f for f in os.listdir(os.path.join(bdir, "target")) if f.endswith("-mule-application.jar")] \
        if os.path.isdir(os.path.join(bdir, "target")) else []
    if p.returncode != 0 or not jars:
        return name, None, p.stdout[-4000:]
    shutil.copy2(os.path.join(bdir, "target", jars[0]), jar_out)
    return name, jar_out, None

def ver_tuple(v):
    return tuple(int(x) for x in re.findall(r"\d+", v)[:3])


def retarget(bdir, ver, ee):
    """アプリが求める版 (minMuleVersion・app.runtime) が起動する Mule より新しければ、その版に下げる (CE の旧い版で動かすため)。
    CE では requiredProduct を MULE にする (mule-maven-plugin の既定は MULE_EE で、CE は配置を断る)"""
    if not ver:
        return
    art = os.path.join(bdir, "mule-artifact.json")
    if os.path.exists(art):
        with open(art, encoding="utf-8") as f:
            desc = json.load(f)
        if ver_tuple(desc.get("minMuleVersion", "0")) > ver_tuple(ver):
            desc["minMuleVersion"] = ver
        if not ee:
            desc["requiredProduct"] = "MULE"
        with open(art, "w", encoding="utf-8") as f:
            json.dump(desc, f, indent=2)
    pom = os.path.join(bdir, "pom.xml")
    with open(pom, encoding="utf-8") as f:
        text = f.read()
    m = re.search(r"<app\.runtime>([^<]+)</app\.runtime>", text)
    if m and ver_tuple(m.group(1)) > ver_tuple(ver):
        with open(pom, "w", encoding="utf-8") as f:
            f.write(text[:m.start(1)] + ver + text[m.end(1):])

