# ---------------------------------------------------------------- .scn の読み書き

class Section:
    def __init__(self, head, body=""):
        self.head, self.body = head, body
        parts = head.split()
        self.kind = parts[0] if parts else ""
        self.args = parts[1:]

    def opts(self):
        """head の key=value と裸のフラグ (値は True)"""
        o = {}
        for a in self.args:
            if "=" in a:
                k, v = a.split("=", 1); o[k] = v
            else:
                o[a] = True
        return o


def parse_scn(text):
    secs, cur, lines = [], None, []
    if text.endswith("\n"):
        text = text[:-1]
    for line in text.split("\n"):
        if line.startswith(MARK):
            if cur is not None:
                cur.body = "\n".join(lines)
            cur = Section(line[len(MARK):].strip()); secs.append(cur); lines = []
        elif cur is not None:
            lines.append(line)
        elif line.strip():
            raise ValueError("text before the first %%% section: " + line)
    if cur is not None:
        cur.body = "\n".join(lines)
    return secs


def render_scn(secs):
    return "".join(MARK + s.head + "\n" + (s.body + "\n" if s.body != "" else "") for s in secs)


def split_head_body(text):
    """ヘッダ行と本文を最初の空行で分ける。空行が無ければ全部ヘッダで本文は空。
    先頭が空行ならヘッダは無く、残りが本文。"""
    if text.startswith("\n"):
        h, b = "", text[1:]
    elif "\n\n" in text:
        h, b = text.split("\n\n", 1)
    elif text.endswith("\n") or text == "":
        h, b = text.rstrip("\n"), ""
    else:
        h, b = text, ""
    hs = []
    for line in h.split("\n") if h else []:
        if not line.strip():
            continue
        if ":" not in line:
            raise ValueError("bad header line: " + line)
        k, v = line.split(":", 1)
        hs.append((k.strip(), v.strip()))
    return hs, b


def encode_body(raw):
    """バイト列を .scn に書ける形へ。戻り値 (flag, text)。flag は '' / 'crlf' / 'base64'"""
    try:
        s = raw.decode("utf-8")
    except UnicodeDecodeError:
        return "base64", base64.b64encode(raw).decode()
    bad = any((ord(c) < 32 and c not in "\n\t\r") or ord(c) == 127 for c in s)
    if "\r" in s:
        if not bad and s.replace("\r\n", "").count("\r") == 0 and s.count("\n") == s.count("\r\n"):
            return "crlf", s.replace("\r\n", "\n")
        return "base64", base64.b64encode(raw).decode()
    if bad:
        return "base64", base64.b64encode(raw).decode()
    return "", s


def decode_body(flag_opts, text):
    if flag_opts.get("base64"):
        return base64.b64decode(text)
    if flag_opts.get("crlf"):
        return text.replace("\n", "\r\n").encode()
    return text.encode()


class Scenario:
    def __init__(self, app_dir):
        self.app_dir = app_dir
        self.name = os.path.basename(app_dir.rstrip("/"))
        self.path = os.path.join(app_dir, "scenario.scn")
        with open(self.path, encoding="utf-8") as f:
            self.secs = parse_scn(f.read())
        ports = [s.args[0] for s in self.secs if s.kind == "port"]
        if not ports:
            raise ValueError(f"{self.path}: missing '%%% port <n>'")
        self.port = int(ports[0])
        self.jvm = tuple(x for s in self.secs if s.kind == "jvm" for x in s.args)
        self.oracle = next((s.args[0] for s in self.secs if s.kind == "oracle" and s.args), "mule")   # %%% oracle mulay: 期待は mulay で記録する   # %%% jvm <引数>...: 実 Mule の JVM に足す引数
        self.extra_ports = [int(x) for x in ports[1:]]   # 2 つ目以降の port: 既定の宛先ではなく、起動を待つだけ (アプリが開く他のポート)
        # %%% tls <port> [client-cert client-key]: そのポートへは TLS で送る (パスはアプリのディレクトリから)
        self.tls = {}
        for s in self.secs:
            if s.kind == "tls" and s.args:
                self.tls[int(s.args[0])] = [os.path.join(app_dir, a) for a in s.args[1:]]
        self.masks = []   # (regex) を出現順に。以後の request に効く
        self.raw_ports = [int(s.args[0]) for s in self.secs if s.kind in ("rawserver", "grpcserver")]
        # %%% protoset <パス>: gRPC の要求 (request GRPC) のメッセージを JSON と protobuf で行き来させる記述子 (アプリのディレクトリから)
        self.protoset = next((os.path.join(app_dir, s.args[0]) for s in self.secs if s.kind == "protoset" and s.args), None)

    def save(self):
        with open(self.path, "w", encoding="utf-8") as f:
            f.write(render_scn(self.secs))

# ---------------------------------------------------------------- 正規化

def apply_masks(masks, text):
    for rx in masks:
        def rep(m):
            if m.re.groups:
                s, out, pos = m.group(0), [], 0
                base = m.start(0)
                for g in range(1, m.re.groups + 1):
                    if m.start(g) < 0:
                        continue
                    out.append(s[pos:m.start(g) - base]); out.append("***"); pos = m.end(g) - base
                out.append(s[pos:])
                return "".join(out)
            return "***"
        text = rx.sub(rep, text)
    return text

# ---------------------------------------------------------------- ログ

LOG_START = re.compile(r"^(TRACE|DEBUG|INFO|WARN|ERROR|FATAL)\s+\d{4}-\d\d-\d\d \d\d:\d\d:\d\d,\d+ \[.*?\] "
                       r"\[processor: ([^;]*); event: ([^\]]*)\] (\S+): ?(.*)$")


def parse_log(text):
    """Mule のアプリログ (既定パターン) を (level, category, processor, message) の列へ"""
    out = []
    for line in text.split("\n"):
        m = LOG_START.match(line)
        if m:
            out.append([m.group(1), m.group(4), m.group(2), m.group(5)])
        elif out:
            out[-1][3] += "\n" + line
    return [(l, c, p, msg.rstrip("\n")) for l, c, p, msg in out]


def app_log_path(name):
    return os.path.join(RT, "logs", f"mule-app-{name}.log")


class LogTail:
    def __init__(self, path):
        self.path = path
        self.pos = os.path.getsize(path) if os.path.exists(path) else 0

    def read_settled(self, min_wait=0.4, quiet=0.3, max_wait=3.0):
        """非同期ロガーの書き出しを待ってから、開始位置以降を読む"""
        t0 = time.time(); last = -1; last_change = t0
        time.sleep(min_wait)
        while True:
            size = os.path.getsize(self.path) if os.path.exists(self.path) else 0
            now = time.time()
            if size != last:
                last, last_change = size, now
            elif now - last_change >= quiet or now - t0 > max_wait:
                break
            time.sleep(0.05)
        if not os.path.exists(self.path):
            return ""
        with open(self.path, "rb") as f:
            f.seek(self.pos)
            return f.read().decode("utf-8", "replace")

class OracleLog:
    """実 Mule のアプリログ (logs/mule-app-<name>.log) から取り出す"""
    def __init__(self, name):
        self.path = app_log_path(name)

    def mark(self):
        return LogTail(self.path)

    def entries(self, tail, wait=0.0):
        return [(l, c, m) for l, c, _p, m in parse_log(tail.read_settled(min_wait=max(0.4, wait), max_wait=max(3.0, wait + 2)))]


# mulay のログ行: "INFO  2026-09-28 12:00:00,123 [[app].flow] <category>: <message>"
MULAY_LOG_START = re.compile(r"^(TRACE|DEBUG|INFO|WARN|ERROR|FATAL)\s+\d{4}-\d\d-\d\d \d\d:\d\d:\d\d,\d+ "
                             r"\[.*?\] (\S+): ?(.*)$")


def parse_mulay_log(text):
    out = []
    for line in text.split("\n"):
        m = MULAY_LOG_START.match(line)
        if m:
            out.append([m.group(1), m.group(2), m.group(3)])
        elif out:
            out[-1][2] += "\n" + line
    return [(l, c, msg.rstrip("\n")) for l, c, msg in out]


class ProcLog:
    """子プロセスの stdout と stderr を 1 本の行バッファに集め、その区間を取り出す。
    区間の始まり (mark) では、パイプに届いている分をその場で読み切る。mulay はログを書いて flush してから応答を返すので、
    前の要求のログは応答を受け取った時にはパイプの中にある。読むスレッドが追いつくのを当てにすると、負荷が高い時に
    前の要求のログが次の要求の区間に入る。"""
    def __init__(self):
        self.lines, self.lock = [], threading.Lock()
        self.last = time.time()
        self.fd, self.rest, self.eof = None, b"", False

    def attach(self, stream):
        self.stream = stream
        self.fd = stream.fileno()
        os.set_blocking(self.fd, False)
        threading.Thread(target=self.pump, daemon=True).start()

    def pump(self):
        while True:
            select.select([self.fd], [], [])
            with self.lock:
                self.drain()
                if self.eof:
                    self.stream.close()
                    return

    def drain(self):
        while not self.eof:
            try:
                data = os.read(self.fd, 65536)
            except BlockingIOError:
                return
            if not data:
                self.eof = True
                data = b"\n" if self.rest else b""
            parts = (self.rest + data).split(b"\n")
            self.rest = parts.pop()
            if parts:
                self.lines.extend(p.decode("utf-8", "replace") for p in parts)
                self.last = time.time()

    def text(self):
        with self.lock:
            self.drain()
            return "\n".join(self.lines)

    def mark(self):
        with self.lock:
            self.drain()
            return len(self.lines)

    def entries(self, start, wait=0.0, quiet=0.15):
        min_wait, max_wait = max(0.15, wait), max(2.0, wait + 2)
        t0 = time.time(); time.sleep(min_wait)
        while time.time() - self.last < quiet and time.time() - t0 < max_wait:
            time.sleep(0.03)
        with self.lock:
            self.drain()
            chunk = "\n".join(self.lines[start:])
        return parse_mulay_log(chunk)

# ---------------------------------------------------------------- HTTP

def tls_context(spec, alpn=("http/1.1",)):
    """%%% tls の指定 (port [client-cert.pem client-key.pem]) の SSL コンテキスト。サーバの証明書は検証しない
    (テスト用の自己署名)。既定は HTTP/1.1 だけを申し出る (h2=1 の要求は h2 を申し出る)。"""
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    ctx.set_alpn_protocols(list(alpn))
    if spec and len(spec) >= 2:
        ctx.load_cert_chain(spec[0], spec[1])
    return ctx


class RawServer:
    """%%% rawserver <port> <mode>: 127.0.0.1:<port> で要求を読み終えてから、壊れた応答を返す TCP の相手。
    コネクタの接続の失敗の文言 (相手が切った、壊れた応答、本文が途中で切れた) と、応答の頭の上限の境目
    (status-4096 / status-4097 / head-8192 / head-8193) を記録するため。シナリオの終わりに閉じる"""
    REPLIES = {
        "close": b"",
        "reset": b"",
        "garbage": b"HELLO WORLD\r\n\r\n",
        "nocolon": b"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nBadHeader\r\nContent-Length: 2\r\n\r\n{}",
        "short": b"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 100\r\n\r\n{\"a\":",
        "chunked-cut": b"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nTransfer-Encoding: chunked\r\n\r\n5\r\n{\"a\":\r\n",
    }
    # 応答の頭の上限の境目: 状態行の長さ (CRLF を除く) と、ヘッダ行の長さ (各行の CRLF を除く) の合計
    for n in (4096, 4097):
        REPLIES[f"status-{n}"] = (b"HTTP/1.1 200 " + b"O" * (n - 13) + b"\r\nContent-Type: application/json\r\nContent-Length: 2\r\n\r\n{}")
    for n in (8192, 8193):
        REPLIES[f"head-{n}"] = (b"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 2\r\nX-Pad: " + b"p" * (n - 54) + b"\r\n\r\n{}")

    def __init__(self, port, mode):
        if mode not in self.REPLIES:
            raise ValueError(f"rawserver: unknown mode {mode!r} (one of {', '.join(self.REPLIES)})")
        self.mode = mode
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self.sock.bind(("127.0.0.1", port))
        self.sock.listen(16)
        threading.Thread(target=self.loop, daemon=True).start()

    def loop(self):
        while True:
            try:
                c, _ = self.sock.accept()
            except OSError:
                return
            threading.Thread(target=self.serve, args=(c,), daemon=True).start()

    @staticmethod
    def read_request(c):
        c.settimeout(10)
        buf = b""
        while b"\r\n\r\n" not in buf:
            d = c.recv(65536)
            if not d:
                return
            buf += d
        head, _, body = buf.partition(b"\r\n\r\n")
        m = re.search(rb"(?im)^content-length:\s*(\d+)", head)
        need = int(m.group(1)) if m else 0
        while len(body) < need:
            d = c.recv(65536)
            if not d:
                return
            body += d

    def serve(self, c):
        try:
            self.read_request(c)
            if self.mode == "reset":
                c.setsockopt(socket.SOL_SOCKET, socket.SO_LINGER, struct.pack("ii", 1, 0))
            elif self.REPLIES[self.mode]:
                c.sendall(self.REPLIES[self.mode])
        except OSError:
            pass
        finally:
            c.close()

    def close(self):
        try:
            self.sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        try:
            self.sock.close()
        except OSError:
            pass


class GrpcServer:
    """%%% grpcserver <port>: 127.0.0.1:<port> で h2c (prior knowledge) を受ける gRPC の相手。gRPC のクライアント (コネクタ) の
    応答の扱いを記録するため。振る舞いはメソッド名 (パスの最後) で決まり、メッセージはバイト列のまま扱う:
      Echo         要求の最初のメッセージを返す (grpc-status 0)
      Headers      要求のヘッダを "名前: 値" の行にして、フィールド 1 (string) だけのメッセージで返す
      Fail         メッセージ無しで grpc-status 5、grpc-message は "nicht gefunden: ü 100%" (パーセント符号化)
      TrailersOnly 最初の HEADERS に grpc-status 7 と grpc-message "denied" を入れて END_STREAM (Trailers-Only)
      Garbage      gRPC の枠にならない DATA (長さ 9 に 3 バイト) の後に grpc-status 0
      BadProto     protobuf として読めないメッセージ (0xFF 0xFF 0xFF) で grpc-status 0
      Http503      :status 503、text/plain の本文、grpc-status 無し
      NoStatus     メッセージを返して END_STREAM、trailer 無し
      Empty        メッセージ無しで grpc-status 0
      Two          メッセージ 2 つ (要求の最初のメッセージと、フィールド 1 が "second" のもの) で grpc-status 0
      Bare         メッセージ無しで grpc-status 13 (grpc-message 無し)
      Odd          メッセージ無しで grpc-status 99
    ストリーミング (応答のメッセージはフィールド 1 が文字列、フィールド 2 が整数。要求の最初のメッセージの 1 と 2 は読まない):
      Ticks        要求の終わりに ("tick", 1..3) を 50 ms おきに送って grpc-status 0
      TicksSlow    ("slow", 1) の 1.2 秒後に ("slow", 2) を送って grpc-status 0
      TicksFail    ("tick", 1)、("tick", 2) の後に grpc-status 10、grpc-message "stopped"
      TicksDeny    Trailers-Only で grpc-status 7、grpc-message "denied"
      Sum          要求の終わりに ("sum", 受けたメッセージの数) を返して grpc-status 0
      SumEarly     最初のメッセージが届いた時に、メッセージ無しで grpc-status 9、grpc-message "too early" (要求の終わりを待たない)
      Chat         メッセージが届くたびに ("echo", 何番目か) を返し、要求の終わりに grpc-status 0
      ChatFail     1 つ目には ("echo", 1) を返し、2 つ目で grpc-status 10、grpc-message "chat stopped"
      Hang、HangSum 何も返さない (呼び手の打ち切りを見るため)
    呼ばれたメソッドの回数は calls に数える。シナリオの終わりに閉じる"""
    STREAMED = ("Sum", "SumEarly", "Chat", "ChatFail")
    def __init__(self, port):
        self.calls = {}
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        self.sock.bind(("127.0.0.1", port))
        self.sock.listen(16)
        threading.Thread(target=self.loop, daemon=True).start()

    def loop(self):
        while True:
            try:
                c, _ = self.sock.accept()
            except OSError:
                return
            threading.Thread(target=self.serve, args=(c,), daemon=True).start()

    @staticmethod
    def frame(m):
        return b"\x00" + len(m).to_bytes(4, "big") + m

    @staticmethod
    def varint(n):
        out = b""
        while True:
            x = n & 0x7F; n >>= 7
            if n: out += bytes([x | 0x80])
            else: return out + bytes([x])

    def rep(self, text, n):
        return self.frame(self.pb_string(1, text) + bytes([0x10]) + self.varint(n))

    @staticmethod
    def pb_string(field, text):
        b = text.encode("utf-8")
        n, ln = len(b), b""
        while True:
            x = n & 0x7F; n >>= 7
            if n: ln += bytes([x | 0x80])
            else: ln += bytes([x]); break
        return bytes([(field << 3) | 2]) + ln + b

    def respond(self, c, sid, hs, body):
        G = [(":status", "200"), ("content-type", "application/grpc")]
        path = dict(hs).get(":path", "")
        meth = path.rsplit("/", 1)[-1]
        msgs, i = [], 0
        while i + 5 <= len(body):
            n = int.from_bytes(body[i + 1:i + 5], "big"); msgs.append(body[i + 5:i + 5 + n]); i += 5 + n
        first = msgs[0] if msgs else b""
        if meth == "Echo":
            c.send_headers(sid, G); c.send_data(sid, self.frame(first)); c.send_headers(sid, [("grpc-status", "0")], end_stream=True)
        elif meth == "Headers":
            text = "\n".join(f"{k}: {v}" for k, v in sorted(hs))
            c.send_headers(sid, G); c.send_data(sid, self.frame(self.pb_string(1, text))); c.send_headers(sid, [("grpc-status", "0")], end_stream=True)
        elif meth == "Fail":
            c.send_headers(sid, G); c.send_headers(sid, [("grpc-status", "5"), ("grpc-message", "nicht gefunden: %C3%BC 100%25")], end_stream=True)
        elif meth == "TrailersOnly":
            c.send_headers(sid, G + [("grpc-status", "7"), ("grpc-message", "denied")], end_stream=True)
        elif meth == "Garbage":
            c.send_headers(sid, G); c.send_data(sid, b"\x00\x00\x00\x00\x09abc"); c.send_headers(sid, [("grpc-status", "0")], end_stream=True)
        elif meth == "BadProto":
            c.send_headers(sid, G); c.send_data(sid, self.frame(b"\xff\xff\xff")); c.send_headers(sid, [("grpc-status", "0")], end_stream=True)
        elif meth == "Http503":
            c.send_headers(sid, [(":status", "503"), ("content-type", "text/plain")]); c.send_data(sid, b"busy", end_stream=True)
        elif meth == "NoStatus":
            c.send_headers(sid, G); c.send_data(sid, self.frame(first), end_stream=True)
        elif meth == "Empty":
            c.send_headers(sid, G); c.send_headers(sid, [("grpc-status", "0")], end_stream=True)
        elif meth == "Two":
            c.send_headers(sid, G); c.send_data(sid, self.frame(first) + self.frame(self.pb_string(1, "second"))); c.send_headers(sid, [("grpc-status", "0")], end_stream=True)
        elif meth == "Bare":
            c.send_headers(sid, G); c.send_headers(sid, [("grpc-status", "13")], end_stream=True)
        elif meth == "Odd":
            c.send_headers(sid, G); c.send_headers(sid, [("grpc-status", "99")], end_stream=True)
        elif meth in ("Ticks", "TicksSlow", "TicksFail"):
            threading.Thread(target=self.ticks, args=(c, sid, meth), daemon=True).start()
        elif meth in ("Hang", "HangSum"):
            pass
        elif meth == "TicksDeny":
            c.send_headers(sid, G + [("grpc-status", "7"), ("grpc-message", "denied")], end_stream=True)
        elif meth == "Sum":
            c.send_headers(sid, G); c.send_data(sid, self.rep("sum", len(msgs))); c.send_headers(sid, [("grpc-status", "0")], end_stream=True)
        elif meth in ("Chat", "ChatFail", "SumEarly"):
            st = self.st.pop((id(c), sid), {})
            if not st.get("done"):
                c.send_headers(sid, ([] if st.get("head") else G) + [("grpc-status", "0")], end_stream=True)
        else:
            c.send_headers(sid, G + [("grpc-status", "12"), ("grpc-message", "unknown stub method " + meth)], end_stream=True)

    def ticks(self, c, sid, meth):
        G = [(":status", "200"), ("content-type", "application/grpc")]
        steps = {"Ticks": [("tick", 1, 0.05), ("tick", 2, 0.05), ("tick", 3, 0.05)],
                 "TicksSlow": [("slow", 1, 1.2), ("slow", 2, 0)],
                 "TicksFail": [("tick", 1, 0.05), ("tick", 2, 0.05)]}[meth]
        try:
            with self.lk[c]:
                c.send_headers(sid, G); self.out[c]()
            for text, n, gap in steps:
                with self.lk[c]:
                    c.send_data(sid, self.rep(text, n)); self.out[c]()
                time.sleep(gap)
            with self.lk[c]:
                tr = [("grpc-status", "10"), ("grpc-message", "stopped")] if meth == "TicksFail" else [("grpc-status", "0")]
                c.send_headers(sid, tr, end_stream=True); self.out[c]()
        except Exception:
            pass

    @staticmethod
    def trace(*xs):
        """環境変数 MULE_ORACLE_GRPC_TRACE のファイルに、スタブが受けた出来事を書く (調べる時だけ)"""
        path = os.environ.get("MULE_ORACLE_GRPC_TRACE")
        if path:
            with open(path, "a") as f:
                f.write(time.strftime("%H:%M:%S") + f".{int(time.time() * 1000) % 1000:03d} " + " ".join(str(x) for x in xs) + "\n")

    def on_message(self, c, sid, meth, k):
        """要求のメッセージが届くたび (Chat、ChatFail、SumEarly)。k は何番目か"""
        G = [(":status", "200"), ("content-type", "application/grpc")]
        st = self.st.setdefault((id(c), sid), {})
        if st.get("done"):
            return
        if meth == "SumEarly":
            c.send_headers(sid, G); c.send_headers(sid, [("grpc-status", "9"), ("grpc-message", "too early")], end_stream=True); st["done"] = True
            return
        if not st.get("head"):
            c.send_headers(sid, G); st["head"] = True
        if meth == "ChatFail" and k == 2:
            c.send_headers(sid, [("grpc-status", "10"), ("grpc-message", "chat stopped")], end_stream=True); st["done"] = True
        else:
            c.send_data(sid, self.rep("echo", k))

    def serve(self, s):
        import h2.connection, h2.config, h2.events
        c = h2.connection.H2Connection(h2.config.H2Configuration(client_side=False, header_encoding="utf-8"))
        reqs, lk = {}, threading.Lock()
        if not hasattr(self, "lk"):
            self.lk, self.out, self.st = {}, {}, {}
        self.lk[c] = lk
        self.out[c] = lambda: s.sendall(c.data_to_send())
        try:
            s.settimeout(30)
            with lk:
                c.initiate_connection(); s.sendall(c.data_to_send())
            while True:
                d = s.recv(65536)
                if not d:
                    return
                with lk:
                    for e in c.receive_data(d):
                        if isinstance(e, h2.events.RequestReceived):
                            hs = list(e.headers)
                            meth = dict(hs).get(":path", "").rsplit("/", 1)[-1]
                            self.calls[meth] = self.calls.get(meth, 0) + 1
                            self.trace("open", id(c), e.stream_id, meth)
                            reqs[e.stream_id] = [hs, b"", 0, meth]
                        elif isinstance(e, h2.events.DataReceived):
                            r = reqs.get(e.stream_id)
                            c.acknowledge_received_data(e.flow_controlled_length, e.stream_id)
                            if r is None:
                                continue
                            r[1] += e.data
                            if r[3] in self.STREAMED:
                                b = r[1]
                                while len(b) >= 5 and len(b) >= 5 + int.from_bytes(b[1:5], "big"):
                                    n = int.from_bytes(b[1:5], "big"); b = b[5 + n:]; r[2] += 1
                                    self.trace("message", id(c), e.stream_id, r[3], r[2])
                                    if r[3] != "Sum":
                                        self.on_message(c, e.stream_id, r[3], r[2])
                                if r[3] != "Sum":
                                    r[1] = b
                        elif isinstance(e, h2.events.StreamEnded):
                            hs, body, k, meth = reqs.pop(e.stream_id)
                            self.trace("end", id(c), e.stream_id, meth, len(body))
                            self.respond(c, e.stream_id, hs, body)
                        elif isinstance(e, h2.events.StreamReset):
                            self.trace("reset", id(c), e.stream_id, e.error_code)
                            reqs.pop(e.stream_id, None); self.st.pop((id(c), e.stream_id), None)
                        elif isinstance(e, h2.events.ConnectionTerminated):
                            s.sendall(c.data_to_send()); return
                    s.sendall(c.data_to_send())
        except Exception:
            pass
        finally:
            s.close()

    def close(self):
        try:
            self.sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        try:
            self.sock.close()
        except OSError:
            pass


class StreamConn:
    """request の stream=<名前> で開く、閉じない応答 (SSE)。背景のスレッドが本文を貯める。
    take() は新しく届いた分を、届かなくなるまで (quiet 秒) 待ってから返す"""
    def __init__(self, port, method, target, headers, body, timeout, tls=None):
        if target.startswith(":"):
            p, _, rest = target[1:].partition("/")
            port, target = int(p), "/" + rest
        if tls is not None and port in tls:
            self.conn = http.client.HTTPSConnection("127.0.0.1", port, timeout=timeout, context=tls_context(tls[port]))
        else:
            self.conn = http.client.HTTPConnection("127.0.0.1", port, timeout=timeout)
        self.buf, self.pos, self.last = b"", 0, time.time()
        self.lock, self.head_ready, self.done = threading.Lock(), threading.Event(), False
        self.status, self.headers, self.error = 0, [], None
        self.conn.putrequest(method, target, skip_host=True, skip_accept_encoding=True)
        self.conn.putheader("Host", f"localhost:{port}")
        for k, v in headers:
            self.conn.putheader(k, v)
        if body or method in ("POST", "PUT", "PATCH"):
            self.conn.putheader("Content-Length", str(len(body)))
        self.conn.endheaders(body if body else None)
        threading.Thread(target=self._pump, daemon=True).start()

    def _pump(self):
        try:
            r = self.conn.getresponse()
            self.status, self.headers = r.status, r.getheaders()
            self.head_ready.set()
            while True:
                chunk = r.read1(8192)
                if not chunk:
                    break
                with self.lock:
                    self.buf += chunk; self.last = time.time()
        except Exception as e:   # noqa: 閉じられた・時間切れ
            self.error = e
        finally:
            self.done = True
            self.head_ready.set()

    def take(self, min_wait=0.3, quiet=0.3, max_wait=3.0):
        t0 = time.time(); time.sleep(min_wait)
        while not self.done and time.time() - self.last < quiet and time.time() - t0 < max_wait:
            time.sleep(0.03)
        with self.lock:
            data = self.buf[self.pos:]; self.pos = len(self.buf)
        return data

    def close(self):
        try:
            if self.conn.sock is not None:
                self.conn.sock.shutdown(socket.SHUT_RDWR)   # 読んでいるスレッドがいても、相手には確かに閉じたと伝わる
        except OSError:
            pass
        try:
            self.conn.close()
        except Exception:   # noqa
            pass


def do_request(port, method, target, headers, body, timeout, tls=None):
    """tls: {port: [client-cert, client-key] or []} TLS で話すポート"""
    if target.startswith(":"):
        p, _, rest = target[1:].partition("/")
        port, target = int(p), "/" + rest
    if tls is not None and port in tls:
        conn = http.client.HTTPSConnection("127.0.0.1", port, timeout=timeout, context=tls_context(tls[port]))
    else:
        conn = http.client.HTTPConnection("127.0.0.1", port, timeout=timeout)
    try:
        conn.putrequest(method, target, skip_host=True, skip_accept_encoding=True)
        conn.putheader("Host", f"localhost:{port}")
        for k, v in headers:
            conn.putheader(k, v)
        if body or method in ("POST", "PUT", "PATCH"):
            conn.putheader("Content-Length", str(len(body)))
        t0 = time.perf_counter()
        conn.endheaders(body if body else None)
        r = conn.getresponse()
        data = r.read()
        if os.environ.get("MULE_ORACLE_TIMES"):
            # 段ごとの時間を実 Mule と mulay で比べるため (要求を送ってから応答を読み終わるまで)
            print(f"  time {(time.perf_counter() - t0) * 1000:9.1f} ms  {method} {target}", flush=True)
        return r.status, r.getheaders(), data
    finally:
        conn.close()

def do_request_h2(port, method, target, headers, body, timeout, tls=None):
    """h2=1 の要求: HTTP/2 で 1 つ送る。TLS のポートは ALPN で h2 を申し出て、選ばれなければ失敗にする。平文は h2c (prior knowledge)。
    本文は相手の流れの制御の窓に従って分けて送る (大きな本文のため)"""
    import h2.connection, h2.config, h2.events
    if target.startswith(":"):
        p, _, rest = target[1:].partition("/")
        port, target = int(p), "/" + rest
    raw = socket.create_connection(("127.0.0.1", port), timeout=timeout)
    secure = tls is not None and port in tls
    s = tls_context(tls[port], ("h2",)).wrap_socket(raw, server_hostname="localhost") if secure else raw
    try:
        if secure and s.selected_alpn_protocol() != "h2":
            raise OSError(f"ALPN chose {s.selected_alpn_protocol()!r}, not h2")
        c = h2.connection.H2Connection(h2.config.H2Configuration(client_side=True, header_encoding="utf-8"))
        c.initiate_connection(); s.sendall(c.data_to_send())
        hs = [(":method", method), (":scheme", "https" if secure else "http"), (":path", target), (":authority", f"localhost:{port}")]
        hs += [(k.lower(), v) for k, v in headers]
        if body or method in ("POST", "PUT", "PATCH"):
            hs.append(("content-length", str(len(body))))
        status, rh, buf, done, sent = 0, [], b"", False, 0
        c.send_headers(1, hs, end_stream=not body); s.sendall(c.data_to_send())

        def pump():
            nonlocal sent
            while sent < len(body):
                n = min(c.local_flow_control_window(1), c.max_outbound_frame_size, len(body) - sent)
                if n <= 0:
                    return
                c.send_data(1, body[sent:sent + n], end_stream=(sent + n == len(body)))
                sent += n
            s.sendall(c.data_to_send())
        if body:
            pump(); s.sendall(c.data_to_send())
        while not done:
            d = s.recv(65536)
            if not d:
                break
            for e in c.receive_data(d):
                if isinstance(e, h2.events.ResponseReceived):
                    for k, v in e.headers:
                        if k == ":status": status = int(v)
                        else: rh.append((k, v))
                elif isinstance(e, h2.events.DataReceived):
                    buf += e.data; c.acknowledge_received_data(e.flow_controlled_length, 1)
                elif isinstance(e, (h2.events.StreamEnded, h2.events.StreamReset)):
                    done = True
                elif isinstance(e, h2.events.WindowUpdated) and sent < len(body):
                    pump()
            s.sendall(c.data_to_send())
        if status == 0:
            raise OSError("the stream ended without a response")
        return status, rh, buf
    finally:
        s.close()

