EXTRA_JVM = []   # %%% jvm で求められた JVM の引数 (main が決める)


def write_wrapper_conf():
    """ユーザー独自の追加 (javaagent、verbose exceptions 等) を除き、素の Mule に近い設定にする"""
    src = os.path.join(MULE_SRC, "conf", "wrapper.conf")
    out, n, dropped = [], 0, False
    for line in open(src, encoding="utf-8", errors="replace"):
        m = re.match(r"wrapper\.java\.additional\.(\d+)(\.stripquotes)?=(.*)", line.strip())
        if m:   # 番号は詰めて振り直す。stripquotes は直前の本体に付く
            if m.group(2):
                if not dropped:
                    out.append(f"wrapper.java.additional.{n}.stripquotes={m.group(3)}\n")
            elif any(x in m.group(3) for x in WRAPPER_DROP):
                dropped = True
            else:
                dropped = False; n += 1
                v = m.group(3)
                if v.startswith("-XX:MaxMetaspaceSize="):   # 全アプリを 1 つの JVM に載せる。既定の 256m では 30 本ほどで OutOfMemoryError: Metaspace
                    v = "-XX:MaxMetaspaceSize=2048m"
                out.append(f"wrapper.java.additional.{n}={v}\n")
            continue
        if line.startswith("wrapper.java.initmemory="):
            line = "wrapper.java.initmemory=512\n"
        elif line.startswith("wrapper.java.maxmemory="):
            line = "wrapper.java.maxmemory=2048\n"
        out.append(line)
    for opt in EXTRA_JVM:
        n += 1
        out.append(f"wrapper.java.additional.{n}={opt}\n")
    with open(os.path.join(RT, "conf", "wrapper.conf"), "w") as f:
        f.writelines(out)


class Mule:
    def __init__(self):
        self.proc = None
        self.lock = threading.Lock()

    def start(self):
        env = dict(os.environ, MULE_HOME=RT, MULE_BASE=RT)
        env.pop("MULE_ENV", None)
        self.console = open(os.path.join(RT, "logs", "console.out"), "wb")
        self.proc = subprocess.Popen([os.path.join(RT, "bin", "mule"), "console"], cwd=RT, env=env,
                                     stdin=subprocess.DEVNULL, stdout=self.console, stderr=subprocess.STDOUT,
                                     start_new_session=True)
        atexit.register(self.stop)

    def alive(self):
        return self.proc is not None and self.proc.poll() is None

    def stop(self):
        """SIGTERM で止め、5 秒で止まらなければ SIGKILL。java は wrapper と別のプロセスグループで
        動くので、私的ランタイムから起動されたプロセスを名指しで待つ・殺す。
        (オラクルの Mule は毎回 apps/.mule を作り直すので、graceful に止める必要は無い)"""
        with self.lock:
            if self.proc is None:
                return
            pgid = self.proc.pid
            try:
                os.killpg(pgid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            t0 = time.time()
            while (self.proc.poll() is None or stray_pids()) and time.time() - t0 < 5:
                time.sleep(0.2)
            try:
                os.killpg(pgid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            for pid in stray_pids():
                try:
                    os.kill(pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
            try:
                self.proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                pass
            t0 = time.time()   # SIGKILL した java が消えてポートが空くまで待つ
            while stray_pids() and time.time() - t0 < 10:
                time.sleep(0.1)
            self.console.close()
            self.proc = None


def stray_pids():
    """私的ランタイムから起動されたプロセス (wrapper と java)"""
    p = subprocess.run(["pgrep", "-f", "--", RT + "/"], stdout=subprocess.PIPE, text=True)
    out = []
    for x in p.stdout.split():
        try:
            with open(f"/proc/{x}/cmdline", "rb") as f:
                argv0 = f.read().split(b"\0")[0].decode(errors="replace")
        except OSError:
            continue
        if int(x) != os.getpid() and ("java" in argv0 or "wrapper" in argv0):
            out.append(int(x))
    return out


def listener_ports(app_dir):
    """アプリの XML の http:listener-connection が開く (数で書いた) ポート。同じ JVM の別のアプリと重なると配備に失敗する"""
    out = set()
    mule_dir = os.path.join(app_dir, "src", "main", "mule")
    for root, _, files in os.walk(mule_dir):
        for fn in files:
            if fn.endswith(".xml"):
                with open(os.path.join(root, fn), encoding="utf-8") as f:
                    out.update(int(m) for m in re.findall(r'<http:listener-connection\b[^>]*\bport="(\d+)"', f.read()))
    return out


def port_busy(port):
    s = socket.socket()
    try:
        s.settimeout(0.3)
        return s.connect_ex(("127.0.0.1", port)) == 0
    finally:
        s.close()


def wait_deployed(mule, names, timeout):
    """apps/<name>-anchor.txt ができたら成功。ログに Failed to deploy が出たら失敗"""
    pending, failed = set(names), {}
    t0 = time.time()
    main_log = os.path.join(RT, "logs", "mule_ee.log" if MULE_EE else "mule.log")
    fail_rx = re.compile(r"\+ Failed to deploy artifact: '([^']+)', (?:\S+Exception: )?(.*?)\n(?:ERROR|WARN|INFO) ", re.S)
    box_rx = re.compile(r"\+ Failed to deploy artifact '([^']+)',([^\n]*)\n((?:\+ [^\n]*\n)*)\+*\n"
                        r"(?:(?:ERROR|WARN) [^\n]*?\] [\w.$]+: ([^\n]*))?")
    while pending and time.time() - t0 < timeout:
        for n in list(pending):
            if os.path.exists(os.path.join(RT, "apps", f"{n}-anchor.txt")):
                pending.discard(n)
        for path in (main_log, os.path.join(RT, "logs", "console.out")):
            if os.path.exists(path):
                with open(path, encoding="utf-8", errors="replace") as f:
                    text = f.read()
                    found = [(m.group(1), m.group(2)) for m in fail_rx.finditer(text)]
                    for m in box_rx.finditer(text):   # CE: 理由は枠の中の行か、枠の後の ERROR の行
                        box = " ".join(x.strip(" +") for x in (m.group(2) + "\n" + m.group(3)).split("\n")
                                       if x.strip(" +") and x.strip(" +") != "see below")
                        found.append((m.group(1), box or m.group(4) or ""))
                    for name, reason in found:
                        if name in pending:
                            reason = re.sub(r"\[[^\]]*\]: Connection is not secure. Should use `HTTPS`\n?", "", reason)
                            pending.discard(name); failed[name] = "deploy failed: " + reason.strip()[:3000]
        if not mule.alive():
            for n in pending:
                failed[n] = "Mule exited"
            return failed
        time.sleep(0.5)
    for n in pending:
        failed[n] = "deploy timeout"
    return failed

