(ns bench (:require [mulay.lib.dec :as d]))

(def N 1000000)

(defn price-str Str [i: Int] (str (+ 1 (rem i 997)) "." (+ 10 (rem i 89))))

(defn prices Vec(d/Dec) []
  (loop [i 0 v: Vec(d/Dec) []] (if (= i 1000) v (let [[x e] (d/parse (price-str i))] (recur (+ i 1) (conj v x))))))

(defn run-sum Str [ps: &Vec(d/Dec)]
  (loop [i 0 acc (d/zero)] (if (= i N) (d/to-string acc) (let [[a e] (d/add acc (nth ps (rem i 1000)))] (recur (+ i 1) a)))))

(defn run-tax Str [ps: &Vec(d/Dec)]
  (let [[t e] (d/parse "1.08")]
    (loop [i 0 acc (d/zero)]
      (if (= i N) (d/to-string acc)
        (let [[r e1] (d/set-scale (d/mul (nth ps (rem i 1000)) t) 2 d/HALF-UP) [a e2] (d/add acc r)] (recur (+ i 1) a))))))

(defn run-text Int []
  (loop [i 0 n 0] (if (= i N) n (let [[x e] (d/parse (price-str i))] (recur (+ i 1) (+ n (count (d/to-string x))))))))

(defn run-div Int [ps: &Vec(d/Dec)]
  (let [[k e] (d/parse "7")]
    (loop [i 0 n 0] (if (= i N) n (let [[q e1] (d/div (nth ps (rem i 1000)) k d/DECIMAL128 d/HALF-EVEN)] (recur (+ i 1) (+ n (d/precision q))))))))

(defn run-cmp Int [ps: &Vec(d/Dec)]
  (loop [i 0 n 0] (if (= i N) n (recur (+ i 1) (+ n (d/cmp (nth ps (rem i 1000)) (nth ps (rem (+ i 1) 1000))))))))

(defn ms Int [t0: Int] (quot (- (mono-us) t0) 1000))

(defn once Int [ps: &Vec(d/Dec) show: Bool]
  (let [t0 (mono-us) a (run-sum ps) m0 (ms t0)
        t1 (mono-us) b (run-tax ps) m1 (ms t1)
        t2 (mono-us) c (run-text) m2 (ms t2)
        t3 (mono-us) f (run-div ps) m3 (ms t3)
        t4 (mono-us) g (run-cmp ps) m4 (ms t4)]
    (if show
      (let [z0 (println "sum " m0 "ms" a) z1 (println "tax " m1 "ms" b) z2 (println "text" m2 "ms" c)
            z3 (println "div " m3 "ms" f) z4 (println "cmp " m4 "ms" g)]
        0)
      0)))

(defn main Int []
  (let [ps (prices) z0 (once ps false) z1 (once ps false)] (once ps true)))
